#!/usr/bin/env bash
# Версіонований pre-commit hook. .git/hooks/ сам по собі не версіюється
# git-ом, тому цей файл активується один раз через:
#   git config core.hooksPath githooks
# (див. scripts/install-hooks.sh -- запустити один раз на клон).
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
python3 "$repo_root/scripts/guard_ukr_lisp_keyboard.py" --staged
# Охоронець драбин D1–D10 — ПЕРЕШКОДА, а не звіт після пушу. Саме тут, у момент
# коміту, він бачить лише ДОДАНІ визначення (--staged) і не дає закомітити дубль
# наявної поверхні. Доти він біг тільки в CI (після роботи), тож агенти його
# практично не бачили — і затінення драбини накопичувались.
# Чисті нові функції реєструються як нератифіковані кандидати D11; охоронець
# не додає файл у Git index і не призначає бітову координату.
python3 "$repo_root/scripts/guard-domain-function-reuse.py" --staged --advise --register
"$repo_root/scripts/check-bilingual-docs"
