#!/usr/bin/env bash
# Українська обов'язкова в людському заголовку кожного нового коміту.
# Локальний git hook не перевіряє коміти через GitHub API.
set -euo pipefail

message_file="${1:?Потрібен шлях до повідомлення коміту}"
[[ -f "$message_file" ]] || { printf 'Немає файла повідомлення коміту.\n' >&2; exit 1; }

# Ігноруємо порожні рядки та шаблонні Git-коментарі.
subject=$(sed -n '/^[[:space:]]*#/d; /^[[:space:]]*$/d; p; q' "$message_file")
if [[ -z "$subject" ]] || ! printf '%s\n' "$subject" | grep -qP '(*UTF)[\x{0410}-\x{044F}\x{0406}\x{0456}\x{0407}\x{0457}\x{0404}\x{0454}\x{0490}\x{0491}]'; then
  printf 'Коміт відхилено: потрібен зрозумілий український заголовок.\n' >&2
  printf 'Німецька й англійська необов’язкові, порядок UK → DE → EN.\n' >&2
  exit 1
fi
