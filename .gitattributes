* text=auto eol=lf

# vendor/ holds `cargo vendor` output committed byte-for-byte, with its own
# .cargo-checksum.json per crate. The blanket eol=lf rule above silently
# rewrites any CRLF files in there on checkout, breaking cargo's checksum
# validation ("the listed checksum ... has changed") on any fresh clone
# (e.g. CI) even though the content is unmodified -- confirmed 2026-08-28:
# vendor/serde-wasm-bindgen/.cargo/config.toml matches its expected checksum
# locally (CRLF, as vendored) but not after a normalized checkout. Disable
# all text/eol handling for vendor/ so checkouts are always byte-identical.
vendor/** -text -diff

# lib/machine/xed/vendor/ holds verbatim upstream Intel XED datafiles (#175),
# vendored byte-for-byte at a pinned commit for reproducible-evidence
# purposes. Their own trailing whitespace and EOF blank lines are upstream
# formatting, not something this repo introduced or should "fix" -- doing so
# would make the vendored copy diverge from the pinned source it exists to
# match. Exempt them from the repo-wide whitespace/diff-hygiene gate.
lib/machine/xed/vendor/** -text -diff

# GitHub Linguist does not know my-lisp or WSM yet. Common Lisp is the
# temporary syntax/statistics profile for my-lisp source files; this is
# classification, not a claim of language identity.
*.wsm linguist-language=Common-Lisp linguist-detectable=true -linguist-vendored -linguist-generated -linguist-documentation
*.my linguist-language=Common-Lisp linguist-detectable=true -linguist-vendored -linguist-generated -linguist-documentation
*.lisp linguist-language=Common-Lisp linguist-detectable=true -linguist-vendored -linguist-generated -linguist-documentation
# Equal-standing Ukrainian Cyrillic extension spellings (issue #62,
# 2026-09-10 owner decision): .всм/.мій/.лісп mean exactly what
# .wsm/.my/.lisp mean, same classification.
*.всм linguist-language=Common-Lisp linguist-detectable=true -linguist-vendored -linguist-generated -linguist-documentation
*.мій linguist-language=Common-Lisp linguist-detectable=true -linguist-vendored -linguist-generated -linguist-documentation
*.лісп linguist-language=Common-Lisp linguist-detectable=true -linguist-vendored -linguist-generated -linguist-documentation
# Supported SENS aliases (owner 2026-09-25): .sens/.сенс are accepted,
# .lisp stays canonical. Same classification, not a language-identity claim.
*.sens linguist-language=Common-Lisp linguist-detectable=true -linguist-vendored -linguist-generated -linguist-documentation
*.сенс linguist-language=Common-Lisp linguist-detectable=true -linguist-vendored -linguist-generated -linguist-documentation
