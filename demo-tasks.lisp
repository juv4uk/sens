; Демонстрація обчислення підсумків завдань мовою СЕНС.
; Назви функцій і змінних записані українською.
;
; Додавання двох чисел через анонімну функцію.
; Результат першого виразу дорівнює 30.

; Точні математичні значення Д24+ утворюються зі списків СЕНС.
(визначити завдання-число-два (довжина (як-є (а б))))
(визначити завдання-число-три (довжина (як-є (а б в))))
(визначити завдання-число-чотири (довжина (як-є (а б в г))))
(визначити завдання-число-п'ять (довжина (як-є (а б в г ґ))))
(визначити завдання-число-сім (довжина (як-є (а б в г ґ д е))))
(визначити завдання-число-десять (довжина (як-є (а б в г ґ д е є ж з))))
(визначити завдання-число-двадцять (помножити завдання-число-два завдання-число-десять))
(визначити завдання-число-сто (помножити завдання-число-десять завдання-число-десять))
(визначити завдання-число-двісті-тридцять-два (додати (помножити завдання-число-два завдання-число-сто) (додати (помножити завдання-число-три завдання-число-десять) завдання-число-два)))
(визначити завдання-число-чотириста-п'ятдесят-сім (додати (помножити завдання-число-чотири завдання-число-сто) (додати (помножити завдання-число-п'ять завдання-число-десять) завдання-число-сім)))

((функція (перший другий)
   (додати перший другий))
 завдання-число-десять завдання-число-двадцять)

; Обчислення кількості невиконаних завдань.
; Усього 457, виконано 232, залишилося 225.
; Останній вираз повертає 225.

(нехай ((усього завдання-число-чотириста-п'ятдесят-сім)
        (виконано завдання-число-двісті-тридцять-два))
  (відняти усього виконано))
