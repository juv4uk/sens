; Д8: дослідні композиції зняття голови, пари, рівності та логічних функцій.
; Обчислення бітової довжини послідовно ділить число на два.
; Ратифіковані викликні голови записані українською.
; Англійські імена залишено лише як сумісні назви наявних функцій.
; Математичні операнди — десяткові, не машинні літерали.

(визначити зняти-з-початку
  (функція (список) (решта список)))
(визначити pop зняти-з-початку)

; D8:11111101 PAIR — вже Core4 `pair`
(визначити пара pair)

; D8:11110111 EQUAL — вже Core4 `equal?`
(визначити однакові? equal?)

; D8:11110101 AND / D8:11111100 OR — короткозамкнені макроси Core4
(визначити та and)
(визначити або or)

; D8:10111111 INTEGER-LENGTH — послідовна частка на 2
(визначити бітова-довжина-з
  (функція (число накопичувач)
    (за-умовою
      ((нуль? число) накопичувач)
      ((хибне? (нуль? число))
       (бітова-довжина-з
         (частка число 2)
         (додати-1 накопичувач))))))
(визначити бітова-довжина-цілого
  (функція (число)
    (за-умовою
      ((нуль? число) 0)
      ((хибне? (нуль? число))
       (бітова-довжина-з число 0)))))
(визначити integer-length бітова-довжина-цілого)
