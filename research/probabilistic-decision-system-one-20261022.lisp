; Дослідницький контракт SENS System One — аналог класу рішень Jev.
; Цей файл не є моделлю прогнозування і не видає задані ймовірності
; за результат inference. Він визначає типізований вхід/вихід, який
; надалі з'єднаємо з окремим механізмом оцінювання стану.
;
; Запит: (system-one-request/1 state (Choice/Noul/Score ...))
; Відповідь: (system-one-response/1 той-самий-запит (спостереження ...))
; Усі запитання читають один спільний state; IDs у пакеті унікальні.
; Немає відповіді, дубльованого ID, зміни питання чи неправильної
; ймовірності — увесь пакет відхиляється, не частково приймається.

(визначити унікальні-елементи-системи-один?
  (функція (елементи переглянуті)
    (за-умовою
      ((атом? елементи) (тотожне? елементи (як-є ())))
      ((рішення-містить? (перше елементи) переглянуті) ні)
      (так
       (унікальні-елементи-системи-один?
         (решта елементи)
         (сполучити (перше елементи) переглянуті))))))

(визначити варіанти-системи-один-допустимі?
  (функція (варіанти мінімум максимум)
    (за-умовою
      ((хибне? (рішення-правильний-список? варіанти)) ні)
      ((хибне? (однакові? (довжина варіанти) мінімум))
       (за-умовою
         ((менше? (довжина варіанти) мінімум) ні)
         (так (максимум-системи-один-допустимий? варіанти максимум))))
      (так
       (максимум-системи-один-допустимий? варіанти максимум)))))

(визначити максимум-системи-один-допустимий?
  (функція (варіанти максимум)
    (за-умовою
      ((менше? максимум (довжина варіанти)) ні)
      ((хибне? (унікальні-елементи-системи-один? варіанти (як-є ()))) ні)
      (так так))))

(визначити критерії-системи-один-записи-допустимі?
  (функція (критерії)
    (за-умовою
      ((атом? критерії) (тотожне? критерії (як-є ())))
      ((хибне? (рішення-правильний-список? (перше критерії))) ні)
      ((хибне? (однакові? (довжина (перше критерії)) 2)) ні)
      ((хибне? (атом? (перше (перше критерії)))) ні)
      ((хибне? (атом? (друге (перше критерії)))) ні)
      ((однакові? (друге (перше критерії)) "") ні)
      (так (критерії-системи-один-записи-допустимі? (решта критерії))))))

(визначити мітки-критеріїв-системи-один
  (функція (критерії)
    (за-умовою
      ((атом? критерії) (як-є ()))
      (так
       (сполучити
         (перше (перше критерії))
         (мітки-критеріїв-системи-один (решта критерії)))))))

(визначити критерії-системи-один-допустимі?
  (функція (критерії мінімум максимум)
    (за-умовою
      ((хибне? (рішення-правильний-список? критерії)) ні)
      ((менше? (довжина критерії) мінімум) ні)
      ((менше? максимум (довжина критерії)) ні)
      ((хибне? (критерії-системи-один-записи-допустимі? критерії)) ні)
      ((хибне? (унікальні-елементи-системи-один?
                 (мітки-критеріїв-системи-один критерії)
                 (як-є ()))) ні)
      (так так))))

(визначити інструкція-системи-один-допустима?
  (функція (інструкція)
    (за-умовою
      ((хибне? (атом? інструкція)) ні)
      ((однакові? інструкція "") ні)
      (так так))))

(визначити запитання-вибору-системи-один
  (функція (ідентифікатор інструкція критерії)
    (список (як-є choice-question/2) ідентифікатор інструкція критерії)))

(визначити запитання-так-ні-системи-один
  (функція (ідентифікатор інструкція)
    (список (як-є noul-question/2) ідентифікатор інструкція)))

(визначити запитання-шкали-системи-один
  (функція (ідентифікатор інструкція критерії)
    (список (як-є score-question/2) ідентифікатор інструкція критерії)))

(визначити запитання-системи-один-допустиме?
  (функція (запитання)
    (за-умовою
      ((хибне? (рішення-правильний-список? запитання)) ні)
      ((атом? запитання) ні)
      ((однакові? (перше запитання) (як-є choice-question/2))
       (за-умовою
         ((хибне? (однакові? (довжина запитання) 4)) ні)
         ((хибне? (атом? (друге запитання))) ні)
         ((хибне? (інструкція-системи-один-допустима? (третє запитання))) ні)
         ((критерії-системи-один-допустимі? (четверте запитання) 1 255) так)
         (так ні)))
      ((однакові? (перше запитання) (як-є noul-question/2))
       (за-умовою
         ((хибне? (атом? (друге запитання))) ні)
         ((хибне? (інструкція-системи-один-допустима? (третє запитання))) ні)
         ((однакові? (довжина запитання) 3) так)
         ((хибне? (однакові? (довжина запитання) 4)) ні)
         ((хибне? (критерії-системи-один-допустимі? (четверте запитання) 2 2)) ні)
         ((хибне? (рішення-містить? (як-є yes) (мітки-критеріїв-системи-один (четверте запитання)))) ні)
         ((хибне? (рішення-містить? (як-є no) (мітки-критеріїв-системи-один (четверте запитання)))) ні)
         (так так)))
      ((однакові? (перше запитання) (як-є score-question/2))
       (за-умовою
         ((хибне? (однакові? (довжина запитання) 4)) ні)
         ((хибне? (атом? (друге запитання))) ні)
         ((хибне? (інструкція-системи-один-допустима? (третє запитання))) ні)
         ((критерії-системи-один-допустимі? (четверте запитання) 2 10) так)
         (так ні)))
      (так ні))))

(визначити список-запитань-системи-один-допустимий?
  (функція (запитання переглянуті)
    (за-умовою
      ((атом? запитання) (тотожне? запитання (як-є ())))
      ((хибне? (запитання-системи-один-допустиме? (перше запитання))) ні)
      ((рішення-містить? (друге (перше запитання)) переглянуті) ні)
      (так
       (список-запитань-системи-один-допустимий?
         (решта запитання)
         (сполучити (друге (перше запитання)) переглянуті))))))

(визначити запит-системи-один-допустимий?
  (функція (запит)
    (за-умовою
      ((хибне? (рішення-правильний-список? запит)) ні)
      ((хибне? (однакові? (довжина запит) 3)) ні)
      ((хибне? (однакові? (перше запит) (як-є system-one-request/1))) ні)
      ((хибне? (рішення-правильний-список? (третє запит))) ні)
      ((порожній? (третє запит)) ні)
      ((список-запитань-системи-один-допустимий? (третє запит) (як-є ())) так)
      (так ні))))

(визначити запит-системи-один
  (функція (стан запитання)
    (список (як-є system-one-request/1) стан запитання)))

(визначити відповідь-системи-один
  (функція (запит спостереження)
    (список (як-є system-one-response/1) запит спостереження)))

(визначити знайти-спостереження-системи-один
  (функція (запитання спостереження)
    (за-умовою
      ((атом? спостереження) (як-є ()))
      ((однакові? запитання (друге (перше спостереження))) (перше спостереження))
      (так
       (знайти-спостереження-системи-один запитання (решта спостереження))))))

(визначити спостереження-системи-один-для-запитання-допустиме?
  (функція (запитання спостереження)
    (за-умовою
      ((хибне? (рішення-правильний-список? спостереження)) ні)
      ((хибне? (однакові? (довжина спостереження) 5)) ні)
      ((хибне? (однакові? (друге спостереження) запитання)) ні)
      ((однакові? (перше запитання) (як-є choice-question/2))
       (за-умовою
         ((хибне? (однакові? (перше спостереження) (як-є choice-observation/1))) ні)
         ((хибне? (допустимий-розподіл? (мітки-критеріїв-системи-один (четверте запитання)) (третє спостереження))) ні)
         ((хибне? (однакові? (четверте спостереження) (упевненість-розподілу (третє спостереження)))) ні)
         ((хибне? (рішення-правильний-список? (п'ятий спостереження))) ні)
         ((порожній? (п'ятий спостереження)) ні)
         (так так)))
      ((однакові? (перше запитання) (як-є noul-question/2))
       (за-умовою
         ((хибне? (однакові? (перше спостереження) (як-є noul-observation/1))) ні)
         ((хибне? (допустимий-розподіл? (як-є (yes no)) (третє спостереження))) ні)
         ((хибне? (однакові? (четверте спостереження) (упевненість-розподілу (третє спостереження)))) ні)
         ((хибне? (рішення-правильний-список? (п'ятий спостереження))) ні)
         ((порожній? (п'ятий спостереження)) ні)
         (так так)))
      ((однакові? (перше запитання) (як-є score-question/2))
       (за-умовою
         ((хибне? (однакові? (перше спостереження) (як-є score-observation/1))) ні)
         ((хибне? (допустимий-розподіл? (мітки-критеріїв-системи-один (четверте запитання)) (третє спостереження))) ні)
         ((хибне? (однакові? (четверте спостереження) (упевненість-розподілу (третє спостереження)))) ні)
         ((хибне? (рішення-правильний-список? (п'ятий спостереження))) ні)
         ((порожній? (п'ятий спостереження)) ні)
         (так так)))
      (так ні))))

(визначити спостерегти-вибір-системи-один
  (функція (запитання розподіл джерело)
    (за-умовою
      ((хибне? (запитання-системи-один-допустиме? запитання))
       (створити-некоректний (як-є malformed-choice-question) запитання))
      ((хибне? (однакові? (перше запитання) (як-є choice-question/2)))
       (створити-некоректний (як-є wrong-choice-question-type) запитання))
      ((допустимий-розподіл?
         (мітки-критеріїв-системи-один (четверте запитання))
         розподіл)
       (список (як-є choice-observation/1)
               запитання розподіл (упевненість-розподілу розподіл) джерело))
      (так (створити-некоректний
             (як-є malformed-choice-distribution)
             (список запитання розподіл))))))

(визначити спостерегти-шкалу-системи-один
  (функція (запитання розподіл джерело)
    (за-умовою
      ((хибне? (запитання-системи-один-допустиме? запитання))
       (створити-некоректний (як-є malformed-score-question) запитання))
      ((хибне? (однакові? (перше запитання) (як-є score-question/2)))
       (створити-некоректний (як-є wrong-score-question-type) запитання))
      ((допустимий-розподіл?
         (мітки-критеріїв-системи-один (четверте запитання))
         розподіл)
       (список (як-є score-observation/1)
               запитання розподіл (упевненість-розподілу розподіл) джерело))
      (так (створити-некоректний
             (як-є malformed-score-distribution)
             (список запитання розподіл))))))

(визначити список-спостережень-системи-один-допустимий?
  (функція (запитання спостереження переглянуті)
    (за-умовою
      ((атом? спостереження) (тотожне? спостереження (як-є ())))
      ((хибне? (рішення-правильний-список? (перше спостереження))) ні)
      ((хибне? (однакові? (довжина (перше спостереження)) 5)) ні)
      ((хибне? (запитання-системи-один-допустиме? (друге (перше спостереження)))) ні)
      ((хибне? (спостереження-системи-один-для-запитання-допустиме?
                 (друге (перше спостереження))
                 (перше спостереження))) ні)
      ((рішення-містить? (друге (друге (перше спостереження))) переглянуті) ні)
      ((хибне? (рішення-містить? (друге (перше спостереження)) запитання)) ні)
      (так
       (список-спостережень-системи-один-допустимий?
         запитання
         (решта спостереження)
         (сполучити (друге (друге (перше спостереження))) переглянуті))))))

(визначити усі-запитання-системи-один-відповіли?
  (функція (запитання спостереження)
    (за-умовою
      ((атом? запитання) (тотожне? запитання (як-є ())))
      ((порожній? (знайти-спостереження-системи-один (перше запитання) спостереження)) ні)
      (так
       (усі-запитання-системи-один-відповіли?
         (решта запитання) спостереження)))))

(визначити відповідь-системи-один-допустима?
  (функція (відповідь очікуваний-запит)
    (за-умовою
      ((хибне? (запит-системи-один-допустимий? очікуваний-запит)) ні)
      ((хибне? (рішення-правильний-список? відповідь)) ні)
      ((хибне? (однакові? (довжина відповідь) 3)) ні)
      ((хибне? (однакові? (перше відповідь) (як-є system-one-response/1))) ні)
      ; Відповідь мусить повертати той самий запит і state без змін.
      ((хибне? (однакові? (друге відповідь) очікуваний-запит)) ні)
      ((хибне? (рішення-правильний-список? (третє відповідь))) ні)
      ((хибне? (однакові? (довжина (третє відповідь))
                           (довжина (третє очікуваний-запит)))) ні)
      ((хибне? (список-спостережень-системи-один-допустимий?
                 (третє очікуваний-запит)
                 (третє відповідь)
                 (як-є ()))) ні)
      ((хибне? (усі-запитання-системи-один-відповіли?
                 (третє очікуваний-запит)
                 (третє відповідь))) ні)
      (так так))))

