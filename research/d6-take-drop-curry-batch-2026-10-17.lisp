; Взяття й відкидання початкових елементів списку.
; Арифметика використовує визначені функції зменшення та збільшення.
; Порожній список лишається структурними даними, не числом.

(визначити додати-1 збільшити-на-один)
(визначити відняти-1 зменшити-на-один)
(визначити взяти
  (функція (кількість список)
    (за-умовою
      ((нуль? кількість) (як-є ()))
      ((порожній? список) (як-є ()))
      ((хибне? (порожній? список))
       (сполучити
         (перше список)
         (взяти (зменшити-на-один кількість) (решта список)))))))
(визначити відкинути
  (функція (кількість список)
    (за-умовою
      ((нуль? кількість) список)
      ((порожній? список) список)
      ((хибне? (порожній? список))
       (відкинути
         (зменшити-на-один кількість)
         (решта список))))))
