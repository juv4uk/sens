; Дослідні визначення взяття та відкидання початку списку.
; Зменшення індексу здійснює ратифікована функція відняти-1.
; Результат порожнього або вичерпаного списку визначається прямо.
; Інші функції шостого домену вже мають свої окремі ратифіковані тотожності.

(визначити взяти
  (функція (кількість елементи)
    (за-умовою
      ((нуль? кількість)
       (як-є ()))
      ((порожній? елементи)
       (як-є ()))
      (так
        (сполучити
          (перше елементи)
          (взяти
            (відняти-1 кількість)
            (решта елементи)))))))

(визначити відкинути
  (функція (кількість елементи)
    (за-умовою
      ((нуль? кількість)
       елементи)
      ((порожній? елементи)
       елементи)
      (так
        (відкинути
          (відняти-1 кількість)
          (решта елементи))))))
