; Д10: дослідні композиції перевірки черги, сортування й відображення.
; Реалізація спирається на наявні механізми Core4 та ратифіковані
; назви функцій; окремих семантичних законів тут не створено.
; Локальні параметри записані українською; англійські імена
; зберігаються лише як сумісні прив’язки.
; Мета відображення не змінюється — результат утворює новий список.

(визначити черга-порожня?
  (функція (черга) (порожній? черга)))
(визначити empty-queue? черга-порожня?)

; D10:0001110011 SORTCAR — сортування за CAR через стабільне сортування списку
(визначити сортувати-за-першим
  (функція (елементи)
    (сортувати-список-за
      (функція (ліве праве) (менше? (перше ліве) (перше праве)))
      елементи)))
(визначити sortcar сортувати-за-першим)

; D10:0011001011 SORT* — псевдонім до стабільного сортування списку з предикатом виклику
(визначити сортувати-зірочка сортувати-список-за)
(визначити sort* сортувати-зірочка)

; D10:0011001001 MAP-INTO — чиста: відобразити дію над src (dest ігнорується)
(визначити відобразити-у
  (функція (дія призначення джерело)
    (відобразити дія джерело)))
(визначити map-into відобразити-у)

; D10:0000101100 VECTOR->LIST / D10:0000101111 LIST->VECTOR
(визначити вектор->список
  (функція (вектор) вектор))
(визначити vector->list вектор->список)
(визначити список->вектор
  (функція (елементи) елементи))
(визначити list->vector список->вектор)
