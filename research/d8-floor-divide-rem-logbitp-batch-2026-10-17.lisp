; Точні математичні дії над невід'ємними числами.
; Результати визначають чинні функції ратифікованих доменів.
; Джерело використовує людські десяткові математичні значення.

(визначити округлити-вниз
  (функція (число дільник)
    (частка число дільник)))

(визначити поділити
  (функція (число дільник)
    (частка число дільник)))

(визначити остача-зі-знаком модульна-остача)

; Перевірити розряд числа за його порядковим номером.
(визначити біт-встановлений?
  (функція (індекс число)
    (однакові?
      (модульна-остача
        (частка число (піднести-до-степеня 2 індекс))
        2)
      1)))
