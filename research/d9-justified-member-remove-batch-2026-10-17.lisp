; D9:010011101 JUSTIFIED-MEMBER?
(0011 обґрунтований-член? значення-у-списку?)
; D9:010011110 REMOVE-JUSTIFIED
(0011 прибрати-обґрунтоване прибрати-зі-списку)
; D9:010011111 ADD-NEW-JUSTIFIED
(0011 додати-нове-обґрунтоване додати-унікальне)
; D9:010100000 PUT-WORLD
(0011 покласти-світ покласти-асоціацію)

(список
  (обґрунтований-член? (як-є а) (список (як-є а) (як-є б)))
  (хибне? (обґрунтований-член? (як-є в) (список (як-є а) (як-є б))))
  (equal? (прибрати-обґрунтоване (як-є а) (список (як-є а) (як-є б) (як-є а)))
          (список (як-є б)))
  (equal? (додати-нове-обґрунтоване (як-є в) (список (як-є а) (як-є б)))
          (список (як-є в) (як-є а) (як-є б)))
  (equal? (додати-нове-обґрунтоване (як-є а) (список (як-є а) (як-є б)))
          (список (як-є а) (як-є б)))
  (equal? (покласти-світ (як-є ключ) (як-є знач) (список))
          (список (сполучити (як-є ключ) (як-є знач))))
  (equal? (покласти-світ (як-є ключ) (як-є нове)
                         (список (сполучити (як-є ключ) (як-є старе))))
          (список (сполучити (як-є ключ) (як-є нове))))
  (equal? (покласти-світ (як-є к2) (як-є в2)
                         (список (сполучити (як-є к1) (як-є в1))))
          (список (сполучити (як-є к2) (як-є в2))
                  (сполучити (як-є к1) (як-є в1)))))

