; Д9: дослідні композиції обґрунтованого членства та змін світового стану.
; Функції будуються зі списків і списків асоціацій.
; Слово кожного виконуваного виклику взято з колонки «укр» Д4 і Д8.
; Декларації сумісності наприкінці не визначають нових законів.
; Історичні координати Д9 залишаються позначками дослідження.
;
(визначити обґрунтований-член? значення-у-списку?)
; D9:010011110 REMOVE-JUSTIFIED
(визначити прибрати-обґрунтоване прибрати-зі-списку)
; D9:010011111 ADD-NEW-JUSTIFIED
(визначити додати-нове-обґрунтоване додати-унікальне)
; D9:010100000 PUT-WORLD
(визначити покласти-світ покласти-асоціацію)

(список
  (обґрунтований-член? (як-є а) (список (як-є а) (як-є б)))
  (хибне? (обґрунтований-член? (як-є в) (список (як-є а) (як-є б))))
  (однакові? (прибрати-обґрунтоване (як-є а) (список (як-є а) (як-є б) (як-є а)))
          (список (як-є б)))
  (однакові? (додати-нове-обґрунтоване (як-є в) (список (як-є а) (як-є б)))
          (список (як-є в) (як-є а) (як-є б)))
  (однакові? (додати-нове-обґрунтоване (як-є а) (список (як-є а) (як-є б)))
          (список (як-є а) (як-є б)))
  (однакові? (покласти-світ (як-є ключ) (як-є знач) (список))
          (список (сполучити (як-є ключ) (як-є знач))))
  (однакові? (покласти-світ (як-є ключ) (як-є нове)
                         (список (сполучити (як-є ключ) (як-є старе))))
          (список (сполучити (як-є ключ) (як-є нове))))
  (однакові? (покласти-світ (як-є к2) (як-є в2)
                         (список (сполучити (як-є к1) (як-є в1))))
          (список (сполучити (як-є к2) (як-є в2))
                  (сполучити (як-є к1) (як-є в1)))))

