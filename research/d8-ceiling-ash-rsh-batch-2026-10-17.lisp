; Дослідні визначення округлення вгору та зсувів невід'ємних чисел.
; Арифметичні аргументи записуються людськими десятковими числами.
; Числова ширина визначається математичним доменом, а не літералом.

(визначити округлити-вгору
  (функція (число дільник)
    (за-умовою
      ((нуль? (модульна-остача число дільник))
       (частка число дільник))
      (так
       (додати-1 (частка число дільник))))))

(визначити арифметичний-зсув
  (функція (число кількість)
    (за-умовою
      ((нуль? кількість)
       число)
      (так
       (помножити
         число
         (піднести-до-степеня 2 кількість))))))

(визначити зсунути-вправо
  (функція (число кількість)
    (за-умовою
      ((нуль? кількість)
       число)
      (так
       (частка
         число
         (піднести-до-степеня 2 кількість))))))

; Для невід'ємного зсуву ці механізми дають однаковий результат.
(визначити арифметично-зсунути арифметичний-зсув)
