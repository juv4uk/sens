; Дослідні визначення функцій десятого та дев'ятого доменів.
; Функції використовують ратифіковані повні українські назви.
; Спискове представлення збережено, нової машинної семантики немає.

(визначити числа-нерівні?
  (функція (ліве праве)
    (хибне? (однакові? ліве праве))))

(визначити перетворити-вектор-на-список
  (функція (вектор) вектор))

(визначити перетворити-список-на-вектор
  (функція (список) список))

(визначити взяти-напіввідкритий-зріз-вектора
  (функція (вектор початок кінець)
    (взяти (відняти кінець початок)
      (відкинути початок вектор))))

(визначити зібрати-всі-повернені-значення-у-список
  (функція (значення) значення))

(визначити залежні-від мапа-отримати)
(визначити аналіз-розмір довжина)
