; Д10 і Д9: дослідні визначення числової нерівності, векторів, зрізу,
; списку результатів, залежностей та обсягу аналізу.
; Використано тільки наявні українські функції та їхні ратифіковані закони.
; Англомовні назви зберігаються як історичні сумісні прив’язки.

(визначити числа-нерівні?
  (функція (ліве праве) (хибне? (однакові? ліве праве))))
(визначити numeric-not-equal? числа-нерівні?)

; D10:0000101100 VECTOR->LIST / D10:0000101111 LIST->VECTOR
(визначити вектор->список
  (функція (вектор) вектор))
(визначити vector->list вектор->список)
(визначити список->вектор
  (функція (елементи) елементи))
(визначити list->vector список->вектор)

; D10:0000110110 VECTOR-SLICE — те саме, що string-slice на списках
(визначити зріз-вектора
  (функція (вектор початок кінець)
    (взяти (відняти кінець початок) (відкинути початок вектор))))
(визначити vector-slice зріз-вектора)

; D10:0000011000 MULTIPLE-VALUE-LIST
(визначити список-усіх-значень
  (функція (елементи) елементи))
(визначити multiple-value-list список-усіх-значень)

; D9:001011100 DEPENDENTS-OF → map-get
(визначити залежні-від мапа-отримати)
(визначити dependents-of залежні-від)

; D9:001100001 LINT-SIZE → length
(визначити аналіз-розмір довжина)
(визначити lint-size аналіз-розмір)
