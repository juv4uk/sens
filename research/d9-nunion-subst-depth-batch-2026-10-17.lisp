; Українські функції об'єднання, підстановки та глибини дерева.
; Порожнє дерево й атом мають нульову математичну глибину.
; Глибина складеної пари дорівнює одиниці плюс більша глибина її частин.

(визначити об'єднання-на-місці об'єднання)
(визначити застосувати-підстановка замінити)

(визначити світ-глибина
  (функція (дерево)
    (за-умовою
      ((або (порожній? дерево) (атом? дерево)) 0)
      ((хибне? (або (порожній? дерево) (атом? дерево)))
       (додати-1
         (за-умовою
           ((менше?
              (світ-глибина (перше дерево))
              (світ-глибина (решта дерево)))
            (світ-глибина (решта дерево)))
           ((хибне?
              (менше?
                (світ-глибина (перше дерево))
                (світ-глибина (решта дерево))))
            (світ-глибина (перше дерево)))))))))
