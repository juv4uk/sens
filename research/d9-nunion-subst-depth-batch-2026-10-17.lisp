; D9:101101001 APPLY-SUBST — alias to SUBST/замінити
(визначити застосувати-підстановка замінити)
(визначити apply-subst застосувати-підстановка)

; D9:111001011 WORLD-DEPTH — 1 + max(глибина car, глибина cdr); атом/null = 0
(визначити світ-глибина
  (функція (т)
    (за-умовою
      ((або (порожній? т) (атом? т)) 0)
      ((хибне? (або (порожній? т) (атом? т)))
       (додати-1
         (за-умовою
           ((менше?
              (світ-глибина (перше т))
              (світ-глибина (решта т)))
            (світ-глибина (решта т)))
           ((хибне?
              (менше?
                (світ-глибина (перше т))
                (світ-глибина (решта т))))
            (світ-глибина (перше т)))))))))
(визначити world-depth світ-глибина)
