; Дослідні визначення вибору елемента та повторення значення.
; Вони використовують лише ратифіковані повні українські викличні голови.
; Десятковий індекс є математичним числом, а не машинним кодом.
; Ділення виконується чинною функцією частка без нового псевдоніма.

(визначити елемент-за-індексом
  (функція (елементи індекс)
    (за-умовою
      ((нуль? індекс)
       (перше елементи))
      ((порожній? елементи)
       (як-є ()))
      (так
        (елемент-за-індексом
          (решта елементи)
          (відняти-1 індекс))))))

(визначити повторити
  (функція (кількість значення)
    (за-умовою
      ((нуль? кількість)
       (як-є ()))
      (так
        (сполучити
          значення
          (повторити (відняти-1 кількість) значення))))))
