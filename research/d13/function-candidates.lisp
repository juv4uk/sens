; Дослідницькі кандидати D13 · 2026-10-24.
; ЦЕ НЕ РАТИФІКАЦІЯ, НЕ ТАБЛИЦЯ КОДІВ І НЕ ВИКЛИЧНІ ФУНКЦІЇ.
; Владний закон типів: contracts/numeric-domains-ratification.lisp.
; ℤ — точне знакове ціле D12+; ℚ — точна канонічна RATIO-композиція над D12+,
; зі знаменником >0, gcd-скороченням і без float; ℕ₀ — цілі >=0.
; Poly(ℚ), матриці й інтервали тут — специфікаційні скінченні структури,
; не твердження, що їхнє подання або виконання вже допущене в SENS.
; D13 — лише гіпотеза функціонального сімейства над точними числами.
; Координат немає, виконання не доведено.
(
  (schema . d13-experimental-function-candidates-1)
  (status . experimental-unratified)
  (domain . D13)
  (coordinates . unassigned)
  (callable . no)
  (semantic-proof . not-run)
  (numeric-operands . "Точні числа D(12 * 2^n), n >= 0; раціональні композиції — без float")
  (candidates .
    (
      (candidate (укр розширений-нсд) (en extended-gcd)
        (signature . "ℤ × ℤ -> (g:ℕ₀, x:ℤ, y:ℤ)")
        (law . "Для (a,b)=(0,0) канонічно (g,x,y)=(0,0,0); інакше g=gcd(abs(a),abs(b))>0 та a*x+b*y=g. Усі виходи — точні знакові цілі.")
        (counterexample . "g є НСД, але a*x+b*y != g; або нульова пара не повертає канонічну трійку."))
      (candidate (укр діофантів-розвязок) (en solve-linear-diophantine)
        (signature . "ℤ × ℤ × ℤ -> NONE | ALL_PAIRS | PARAMETERIZATION(x0:ℤ,y0:ℤ,dx:ℤ,dy:ℤ)")
        (law . "Для ax+by=c: якщо a=b=0,c!=0 — NONE; якщо a=b=0,c=0 — ALL_PAIRS. Інакше g=gcd(abs(a),abs(b)); якщо g не ділить c — NONE; інакше знайти au+bv=g, x0=(c/g)u, y0=(c/g)v, dx=b/g, dy=-a/g; усі розв'язки x=x0+t*dx,y=y0+t*dy для t∈ℤ.")
        (counterexample . "Для a=b=c=0 повернуто NONE; або повернуто параметризацію, коли gcd(abs(a),abs(b)) не ділить c."))
      (candidate (укр прості-множники) (en prime-factorization)
        (signature . "n∈ℤ, n>=2 -> finite list((p:ℤ,p>=2),(e:ℤ,e>=1))")
        (law . "p-значення є простими та строго зростають; кожен показник e>=1; точний добуток усіх p^e дорівнює n; відсортований розклад єдиний.")
        (counterexample . "Складене p або повторені неупорядковані множники дали правильний добуток, але порушили канонічність."))
      (candidate (укр біноміальний-коефіцієнт) (en binomial-coefficient)
        (signature . "n,k∈ℤ, 0<=k<=n -> value∈ℤ, value>=1")
        (law . "Область: n>=0 та 0<=k<=n; C(n,0)=C(n,n)=1; для 0<k<n виконується тотожність Паскаля; C(n,k)=C(n,n-k).")
        (counterexample . "Для k поза [0,n] повернуто звичайний коефіцієнт; або порушено тотожність Паскаля."))
      (candidate (укр ділення-поліномів-раціональних) (en polynomial-divmod-q)
        (signature . "P,Q∈Poly(ℚ), Q!=0 -> (U,V)∈Poly(ℚ)²")
        (law . "Єдині U,V мають точні раціональні коефіцієнти й задовольняють P=Q*U+V; V=0 або degree(V)<degree(Q).")
        (counterexample . "P=Q*U, але ненульова остача втрачена; або degree(V)>=degree(Q)."))
      (candidate (укр нсд-поліномів-раціональних) (en polynomial-gcd-q)
        (signature . "P,Q∈Poly(ℚ), не обидва нульові -> єдиний monic G∈Poly(ℚ)")
        (law . "G не нульовий, монічний, ділить P та Q; кожний спільний дільник P і Q ділить G. Якщо один аргумент нульовий, G — монічна нормалізація іншого.")
        (counterexample . "Повернено одиницю попри спільний нетривіальний дільник; або не нормалізовано старший коефіцієнт до 1."))
      (candidate (укр визначник-раціональної-матриці) (en determinant-q)
        (signature . "A∈ℚ^(n×n), n∈ℕ₀ -> det(A)∈ℚ")
        (law . "det(I_n)=1 включно з n=0; перестановка рядків змінює знак; додавання кратного одного рядка до іншого не змінює det. Усі операції точні.")
        (counterexample . "Перестановка двох рядків не змінила знак визначника ненульової матриці."))
      (candidate (укр зведена-східчаста-форма) (en rref-q)
        (signature . "A∈ℚ^(m×n) -> (R∈ℚ^(m×n), pivot-columns)")
        (law . "R рядково еквівалентна A; кожен pivot дорівнює 1 і є єдиним ненульовим у своєму стовпці; pivot-стовпці строго зростають; нульові рядки внизу; R єдина.")
        (counterexample . "Залежний рядок породив зайвий pivot або результат не є єдиною reduced row-echelon формою."))
      (candidate (укр множення-раціональних-інтервалів) (en interval-multiply-q)
        (signature . "[a,b],[c,d], a,b,c,d∈ℚ, a<=b,c<=d -> [L,U]")
        (law . "L=min(ac,ad,bc,bd), U=max(ac,ad,bc,bd); результат є найвужчим замкненим раціональним інтервалом для всіх добутків точок із двох вхідних інтервалів.")
        (counterexample . "Вибрано лише ac і bd, тому змішані знаки дають неправильну межу."))
      (candidate (укр цілий-корінь) (en integer-square-root)
        (signature . "n∈ℤ, n>=0 -> (q∈ℤ, q>=0, r∈ℤ, r>=0)")
        (law . "Для кожного точного n>=0: q^2<=n<(q+1)^2 та r=n-q^2; еквівалентно 0<=r<2q+1. Не використовувати float; усі нерівності й квадрати — точні D12+ обчислення.")
        (counterexample . "Для n=15 повернено q=4; або q^2<=n, але r не дорівнює n-q^2."))
    ))
)
