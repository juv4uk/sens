; Дослідницькі кандидати D13 · 2026-10-23.
; ЦЕ НЕ РАТИФІКАЦІЯ, НЕ ТАБЛИЦЯ КОДІВ І НЕ ВИКЛИЧНІ ФУНКЦІЇ.
; Семантичний закон математики: contracts/numeric-domains-ratification.lisp.
; D12,D24,D48,... є числовими значеннями; D13 тут лише гіпотеза окремого
; сімейства функцій над точними числами. Координат немає, виконання не доведено.
(
  (schema . d13-experimental-function-candidates-1)
  (status . experimental-unratified)
  (domain . D13)
  (coordinates . unassigned)
  (callable . no)
  (semantic-proof . not-run)
  (numeric-operands . "Точні числа D(12 * 2^n), n >= 0; раціональні композиції — без float")
  (candidates .
    (
      (candidate (укр розширений-нсд) (en extended-gcd)
        (signature . "Z* × Z* -> (g:Z*, x:Z*, y:Z*)")
        (law . "g = gcd(abs(a),abs(b)); g >= 0; a*x+b*y=g; для a=b=0 канонічно (0,0,0)")
        (counterexample . "g є НСД, але a*x+b*y != g"))
      (candidate (укр діофантів-розвязок) (en solve-linear-diophantine)
        (signature . "Z* × Z* × Z* -> none | (x0,y0,dx,dy)")
        (law . "Для (a,b)!=(0,0) розв'язок існує iff gcd(abs(a),abs(b)) ділить c; dx=b/g, dy=-a/g; усі x=x0+t*dx,y=y0+t*dy")
        (counterexample . "g не ділить c, але повернено пару"))
      (candidate (укр прості-множники) (en prime-factorization)
        (signature . "Z*(n>=2) -> list((prime,exponent))")
        (law . "Кожен prime простий, строго зростає; exponent>=1; добуток prime^exponent дорівнює n")
        (counterexample . "Складене число у списку простих зберігає добуток, але порушує простоту"))
      (candidate (укр біноміальний-коефіцієнт) (en binomial-coefficient)
        (signature . "Z*(n>=0) × Z*(0<=k<=n) -> Z*")
        (law . "C(n,0)=C(n,n)=1; C(n,k)=C(n-1,k-1)+C(n-1,k) для 0<k<n; C(n,k)=C(n,n-k)")
        (counterexample . "Число порушує рекурентну тотожність Паскаля"))
      (candidate (укр ділення-поліномів-раціональних) (en polynomial-divmod-q)
        (signature . "Poly(Q*) × Poly(Q*)[divisor!=0] -> (quotient,remainder)")
        (law . "P=Q*quotient+remainder; remainder=0 або degree(remainder)<degree(Q); канонічні точні коефіцієнти")
        (counterexample . "P=Q*quotient, але ненульову остачу втрачено"))
      (candidate (укр нсд-поліномів-раціональних) (en polynomial-gcd-q)
        (signature . "Poly(Q*) × Poly(Q*)[not both zero] -> monic Poly(Q*)")
        (law . "G монічний; G ділить P та Q; кожний їхній спільний дільник ділить G")
        (counterexample . "Повернено одиницю попри спільний нетривіальний дільник"))
      (candidate (укр визначник-раціональної-матриці) (en determinant-q)
        (signature . "SquareMatrix(Q*) -> Q*")
        (law . "det(I)=1; перестановка двох рядків змінює знак; додавання кратного рядка не змінює det; det(empty)=1")
        (counterexample . "Перестановка двох рядків зберегла знак ненульового визначника"))
      (candidate (укр зведена-східчаста-форма) (en rref-q)
        (signature . "Matrix(Q*) -> (R, pivot-columns)")
        (law . "R рядково еквівалентна входу; pivot=1 і єдиний ненульовий у стовпці; pivots зростають; нульові рядки внизу")
        (counterexample . "Дубльований залежний рядок створив новий pivot"))
      (candidate (укр множення-раціональних-інтервалів) (en interval-multiply-q)
        (signature . "Interval(Q*) × Interval(Q*) -> Interval(Q*)")
        (law . "Для [a,b]*[c,d] нижня межа=min(ac,ad,bc,bd), верхня=max(ac,ad,bc,bd); обидві точні")
        (counterexample . "Вибрано лише ac і bd, проігноровано змішані добутки"))
    ))
)
