; Вставляння до незмінної мапи і проєкція сховища дев'ятого домену.
; Мапа зберігає пари ключа та значення як звичайні списки.
; Повторне вставляння ключа спершу відсіює попередню пару.

(визначити мапа-вставити
  (функція (ключ значення мапа)
    (сполучити
      (сполучити ключ (сполучити значення (як-є ())))
      (відсіяти
        (функція (пара)
          (хибне? (однакові? (перше пара) ключ)))
        мапа))))
(визначити вектор-список
  (функція (вектор) вектор))
(визначити порожній-вміст-сховище мапа-порожній)
(визначити вміст-сховище-отримати мапа-отримати)
(визначити вміст-сховище-містить? мапа-містить?)
(визначити вміст-сховище-покласти мапа-вставити)
