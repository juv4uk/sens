; Д9: дослідні визначення обґрунтованого вектора та списку аргументів.
; Виконувані виклики мають українські імена з ратифікованих доменів.
; vector? і list — історичні сумісні посилання, а не нові семантичні коди.
; Цитовані вектори, списки та рядкові дані залишаються незмінними.

(визначити обґрунтований-вектор? vector?)
(визначити список-аргументів list)

(список
  (обґрунтований-вектор? (як-є #(1 2 3)))
  (хибне? (обґрунтований-вектор? (як-є (1 2 3))))
  (однакові? (список-аргументів (як-є а) (як-є б) (як-є в))
          (список (як-є а) (як-є б) (як-є в)))
  (однакові? (список-аргументів) (список))
  (обґрунтований-вектор? (як-є #()))
  (хибне? (обґрунтований-вектор? (як-є а)))
  (однакові? (список-аргументів (як-є x))
          (список (як-є x)))
  (хибне? (обґрунтований-вектор? (як-є "s"))))

; opt-in повна укр-поверхня: exact identity = lib/domains/d*.lisp; DEFINE-аліас, без нової диспетчеризації.
(визначити список list)
(визначити хибне? not?)
