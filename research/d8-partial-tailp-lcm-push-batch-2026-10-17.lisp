; Д8: композиції для часткового застосування, хвоста, НСК і додавання.
; Це дослідні визначення функцій із ратифікованого восьмого домену.
; Вони не надають нових кодів і не змінюють семантичних законів.
; Англомовні назви «partial», «lcm», «push», «tailp?» лишаються
; сумісними прив'язками, не викличними головами нових функцій.
;
; Д8:00011010 — часткове застосування за законом Д6.
; Д8:00101100 — українська проєкція модульної остачі.
; Д8:00100110 — найменше спільне кратне для невід'ємних Д24+.
; Д8:01000110 — функціональне додавання елемента на початок.
; Д8:01010110 — перевірка належності хвосту за ланцюгом «решта».

(визначити застосувати-префікс частково-застосувати)
(визначити partial застосувати-префікс)

; D8:00101100 MOD uk surface (body already mod / остача)
(визначити модульна-остача mod)
(визначити остача-модульна модульна-остача)

; D8:00100110 LCM — |a*b|/gcd для невід'ємних D24+
(визначити нск
  (функція (ліве праве)
    (за-умовою
      ((або (нуль? ліве) (нуль? праве)) 0)
      ((хибне? (або (нуль? ліве) (нуль? праве)))
       (частка (помножити ліве праве) (нсд ліве праве))))))
(визначити lcm нск)

; D8:01000110 PUSH — функціональний cons на початок
(визначити додати-на-початок
  (функція (елемент список)
    (сполучити елемент список)))
(визначити push додати-на-початок)

; D8:01010110 TAILP — структурно: sub є деяким cdr-ланцюгом lst
(визначити спільний-хвіст?
  (функція (підсписок список-джерело)
    (за-умовою
      ((однакові? підсписок список-джерело) так)
      ((порожній? список-джерело) ні)
      ((хибне? (порожній? список-джерело))
       (спільний-хвіст? підсписок (решта список-джерело))))))
(визначити tailp? спільний-хвіст?)
