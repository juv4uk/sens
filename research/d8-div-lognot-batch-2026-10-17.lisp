; Частка з остачею та скінченне побітове заперечення.
; Значення визначаються тільки для невід'ємних математичних чисел.
; Перетворення між числом і фізичними байтами тут немає.

(визначити частка+остача
  (функція (число дільник)
    (список
      (частка число дільник)
      (модульна-остача число дільник))))

; Міняємо біти лише всередині значущої довжини числа.
(визначити побітове-не
  (функція (число)
    (за-умовою
      ((нуль? число) 0)
      (так
        (додати
          (за-умовою
            ((однакові? (модульна-остача число 2) 0) 1)
            (так 0))
          (помножити
            2
            (побітове-не (частка число 2))))))))
