; Д8: дослідні визначення частки з остачею та скінченного побітового НЕ.
; Лише невід'ємні математичні значення Д24+; це не нові коди функцій.
; Людські операнди записано десятково, машинне пакування — окремий шар.
; Історичні назви «div» та «lognot» залишаються сумісними прив'язками.
; Побітове НЕ тут інвертує лише значущі розряди без сталої ширини.
;
(визначити частка+остача
  (функція (ділене дільник)
    (сполучити (частка ділене дільник)
               (сполучити (модульна-остача ділене дільник) (як-є ())))))
(визначити div частка+остача)

; D8:10110010 LOGNOT — invert bits of the used magnitude (finite support)
(визначити побітове-не
  (функція (значення)
    (за-умовою
      ((нуль? значення) 0)
      ((хибне? (нуль? значення))
       (додати
         (за-умовою
           ((однакові? (модульна-остача значення 2)
                    0)
            1)
           ((хибне?
              (однакові? (модульна-остача значення 2)
                      0))
            0))
         (помножити
           2
           (побітове-не
             (частка значення 2))))))))
(визначити lognot побітове-не)
