; Дослідна виконувана добірка селекторів Д5–Д6.
; Семантика взята з чинних lib/domains/d5.lisp і lib/domains/d6.lisp.
; Порядок операцій зовнішній → внутрішній: CDAAR = решта(перше(перше(x))).
; Викличні голови — тільки повна ратифікована проєкція укр.
; Не створює нових координат, законів або механізмів виконання.

; CDAAR — Д5:01100
(визначити решта-двох-перших
  (функція (значення)
    (решта (перше (перше значення)))))

; CDADR — Д5:01101
(визначити решта-після-першого
  (функція (значення)
    (решта (перше (решта значення)))))

; CDDAR — Д5:01110
(визначити решта-решти-першого
  (функція (значення)
    (решта (решта (перше значення)))))

; CDDDR — Д5:01111
(визначити решта-трьох
  (функція (значення)
    (решта (решта (решта значення)))))

; CAAAR — Д5:10000
(визначити перше-двох-перших
  (функція (значення)
    (перше (перше (перше значення)))))

; CAADR — Д5:10001
(визначити перше-після-першого
  (функція (значення)
    (перше (перше (решта значення)))))

; CADAR — Д5:10010
(визначити перше-решти-першого
  (функція (значення)
    (перше (решта (перше значення)))))

; CADDR — Д5:10011
(визначити третє
  (функція (значення)
    (перше (решта (решта значення)))))

; CADDDR — Д6:100111
(визначити четверте
  (функція (значення)
    (перше (решта (решта (решта значення))))))

; Повне двійкове дерево глибини три: кожен шлях має власний лист.
(визначити дерево-селекторів
  (сполучити
    (сполучити
      (сполучити (як-є а) (як-є б))
      (сполучити (як-є в) (як-є г)))
    (сполучити
      (сполучити (як-є д) (як-є е))
      (сполучити (як-є ж) (як-є з)))))

; Окремий правильний список для четвертого елемента.
(визначити послідовність-чотирьох
  (сполучити (як-є п)
    (сполучити (як-є р)
      (сполучити (як-є с)
        (сполучити (як-є т) (як-є ()))))))

; Справжня SENS-програма-свідок: дев'ять позитивних і чотири
; негативні перевірки напрямку. Очікуваний результат — 13 значень Д1:так.
; Сам текст файлу не доводить запуску; виконуваність перевіряти SENS runtime.
(список
  (тотожне? (решта-двох-перших дерево-селекторів) (як-є б))
  (тотожне? (решта-після-першого дерево-селекторів) (як-є е))
  (тотожне? (решта-решти-першого дерево-селекторів) (як-є г))
  (тотожне? (решта-трьох дерево-селекторів) (як-є з))
  (тотожне? (перше-двох-перших дерево-селекторів) (як-є а))
  (тотожне? (перше-після-першого дерево-селекторів) (як-є д))
  (тотожне? (перше-решти-першого дерево-селекторів) (як-є в))
  (тотожне? (третє дерево-селекторів) (як-є ж))
  (тотожне? (четверте послідовність-чотирьох) (як-є т))
  (хибне? (тотожне? (решта-двох-перших дерево-селекторів) (як-є д)))
  (хибне? (тотожне? (решта-решти-першого дерево-селекторів) (як-є ж)))
  (хибне? (тотожне? (перше-після-першого дерево-селекторів) (як-є б)))
  (хибне? (тотожне? (третє дерево-селекторів) (як-є г)))
)
