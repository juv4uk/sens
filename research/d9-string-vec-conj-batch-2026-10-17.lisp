; Робота з рядком як списком та додавання до вектора.
; Тут рядок є списком символів, а не зовнішнім машинним текстом.
; Усі операції складені з уже визначених функцій мови.

(визначити рядок-решта
  (функція (рядок) (решта рядок)))
(визначити рядок-перший
  (функція (рядок) (перше рядок)))
(визначити рядок-додати приєднати)
(визначити рядок-містить? значення-у-списку?)
(визначити рядок-префікс?
  (функція (префікс рядок)
    (однакові? префікс (взяти (довжина префікс) рядок))))
(визначити рядок-зріз
  (функція (рядок початок кінець)
    (взяти (відняти кінець початок)
      (відкинути початок рядок))))
(визначити вектор-додати
  (функція (вектор значення)
    (приєднати вектор (список значення))))
