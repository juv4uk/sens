;;;; Д10: незалежне свідчення справжнього Common Lisp за стандартом CLHS.
;;;; Це дослідницький оракул, не виконувана семантика СЕНС.
;;;; Стандартні оператори й машинний підсумок залишено незмінними.

(defparameter *д10-фм-виконань-методів* 0)

(defclass д10-фм-основа () ())
(defclass д10-фм-нащадок (д10-фм-основа) ())

(defgeneric д10-фм-доказ (значення))
(defmethod д10-фм-доказ ((значення д10-фм-основа))
  (incf *д10-фм-виконань-методів*)
  :called-primary)
(defmethod д10-фм-доказ :before ((значення д10-фм-основа))
  (incf *д10-фм-виконань-методів*))

(let* ((основний-клас (find-class 'д10-фм-основа))
       (клас-нащадка (find-class 'д10-фм-нащадок))
       (основний-метод
         (find-method #'д10-фм-доказ '() (list основний-клас) nil))
       (попередній-метод
         (find-method #'д10-фм-доказ '(:before) (list основний-клас) nil)))
  (assert основний-метод)
  (assert попередній-метод)
  (assert (not (eq основний-метод попередній-метод)))
  (assert (null (find-method #'д10-фм-доказ '() (list клас-нащадка) nil)))
  (assert (null (find-method #'д10-фм-доказ '(:after) (list основний-клас) nil)))
  (let ((помилка-відсутнього-методу nil)
        (помилка-кількості-аргументів nil))
    (handler-case (find-method #'д10-фм-доказ '() (list клас-нащадка))
      (error () (setf помилка-відсутнього-методу t)))
    (handler-case (find-method #'д10-фм-доказ '() '() nil)
      (error () (setf помилка-кількості-аргументів t)))
    (assert помилка-відсутнього-методу)
    (assert помилка-кількості-аргументів))
  ; Пошук методу не означає його виконання.
  (assert (= 0 *д10-фм-виконань-методів*))
  (format t "D10-FIND-METHOD-REAL-CLOS-ORACLE PASS~%"))
