+name: Post-core Peer Cache
+
+on:
+  push:
+    branches: [main]
+    paths:
+      - "lib/core.lisp"
+      - "lib/core.lisp.fasl"
+      - "lib/surface/semantic-registry.lisp"
+      - "lib/generated/postcore-stable-peer-projection.lisp"
+      - "lib/time.lisp"
+      - "lib/process.lisp"
+      - "lib/tcp.lisp"
+      - "lib/fs.lisp"
+      - "scripts/generate-postcore-peer-cache.lisp"
+      - ".github/workflows/postcore-peer-cache.yml"
+  pull_request:
+    paths:
+      - "lib/core.lisp"
+      - "lib/core.lisp.fasl"
+      - "lib/surface/semantic-registry.lisp"
+      - "lib/generated/postcore-stable-peer-projection.lisp"
+      - "lib/time.lisp"
+      - "lib/process.lisp"
+      - "lib/tcp.lisp"
+      - "lib/fs.lisp"
+      - "scripts/generate-postcore-peer-cache.lisp"
+      - ".github/workflows/postcore-peer-cache.yml"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  check:
+    name: registry-derived cache + FASL
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v5
+      - uses: dtolnay/rust-toolchain@stable
+
+      - name: Build Lisp generator and FASL encoder
+        run: cargo build -p my-lisp-cli --bin my-lisp --bin gen-fasl
+
+      - name: Regenerate post-core cache from semantic authority
+        run: |
+          set -euo pipefail
+          timeout 30s ./target/debug/my-lisp scripts/generate-postcore-peer-cache.lisp
+          git diff --exit-code -- lib/generated/postcore-stable-peer-projection.lisp
+
+      - name: Require core block to equal Lisp-generated projection
+        run: |
+          set -euo pipefail
+          awk '
+            /^; BEGIN GENERATED POSTCORE STABLE PEER PROJECTION/ { inside=1; next }
+            /^; END GENERATED POSTCORE STABLE PEER PROJECTION/ { inside=0 }
+            inside { print }
+          ' lib/core.lisp > /tmp/postcore-stable-peer-projection.lisp
+          cmp /tmp/postcore-stable-peer-projection.lisp lib/generated/postcore-stable-peer-projection.lisp
+
+      - name: Require exact committed FASL
+        run: |
+          set -euo pipefail
+          ./target/debug/gen-fasl lib/core.lisp /tmp/core.lisp.fasl
+          cmp /tmp/core.lisp.fasl lib/core.lisp.fasl
+
+      - name: Execute post-core authority witness
+        run: |
+          set -euo pipefail
+          status="$(./target/debug/my-lisp tests/fixtures/postcore-peer-materialization-witness.lisp)"
+          test "$status" = "(postcore-peer-materialization-witness (status pass))"

