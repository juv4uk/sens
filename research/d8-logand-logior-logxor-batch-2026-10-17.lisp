; Д8: дослідні побітові І, АБО та виключне АБО для невід’ємних Д24+.
; Композиції використовують модульну остачу й частку від ділення на два.
; Викличні голови відповідають ратифікованій українській проєкції.
; Людські математичні операнди записано десятково, без машинних літералів.
; Англійські імена LOGAND/LOGIOR/LOGXOR лишаються сумісними прив’язками.

(визначити побітове-і
  (функція (ліве праве)
    (за-умовою
      ((або (нуль? ліве) (нуль? праве)) 0)
      ((хибне? (або (нуль? ліве) (нуль? праве)))
       (додати
         (за-умовою
           ((та
              (однакові? (модульна-остача ліве 2)
                      1)
              (однакові? (модульна-остача праве 2)
                      1))
            1)
           ((хибне?
              (та
                (однакові? (модульна-остача ліве 2)
                        1)
                (однакові? (модульна-остача праве 2)
                        1)))
            0))
         (помножити
           2
           (побітове-і
             (частка ліве 2)
             (частка праве 2))))))))
(визначити logand побітове-і)

(визначити побітове-або
  (функція (ліве праве)
    (за-умовою
      ((та (нуль? ліве) (нуль? праве)) 0)
      ((хибне? (та (нуль? ліве) (нуль? праве)))
       (додати
         (за-умовою
           ((або
              (однакові? (модульна-остача ліве 2)
                      1)
              (однакові? (модульна-остача праве 2)
                      1))
            1)
           ((хибне?
              (або
                (однакові? (модульна-остача ліве 2)
                        1)
                (однакові? (модульна-остача праве 2)
                        1)))
            0))
         (помножити
           2
           (побітове-або
             (частка ліве 2)
             (частка праве 2))))))))
(визначити logior побітове-або)

(визначити побітове-виключне-або
  (функція (ліве праве)
    (за-умовою
      ((та (нуль? ліве) (нуль? праве)) 0)
      ((хибне? (та (нуль? ліве) (нуль? праве)))
       (додати
         (за-умовою
           ((хибне?
              (однакові? (модульна-остача ліве 2)
                      (модульна-остача праве 2)))
            1)
           ((однакові? (модульна-остача ліве 2)
                    (модульна-остача праве 2))
            0))
         (помножити
           2
           (побітове-виключне-або
             (частка ліве 2)
             (частка праве 2))))))))
(визначити logxor побітове-виключне-або)
