; D8 LOGAND / LOGIOR / LOGXOR — pure non-neg D24+ via mod/quotient
; Residency lib/domains/d8.lisp. No bare numeric call-heads.

(0011 побітове-і
  (0010 (a b)
    (110
      ((or (нуль? a) (нуль? b)) #d24:000000000000000000000000)
      ((0100 (or (нуль? a) (нуль? b)))
       (додати
         (110
           ((and
              (equal? (mod a #d24:000000000000000000000010)
                      #d24:000000000000000000000001)
              (equal? (mod b #d24:000000000000000000000010)
                      #d24:000000000000000000000001))
            #d24:000000000000000000000001)
           ((0100
              (and
                (equal? (mod a #d24:000000000000000000000010)
                        #d24:000000000000000000000001)
                (equal? (mod b #d24:000000000000000000000010)
                        #d24:000000000000000000000001)))
            #d24:000000000000000000000000))
         (помножити
           #d24:000000000000000000000010
           (побітове-і
             (quotient a #d24:000000000000000000000010)
             (quotient b #d24:000000000000000000000010))))))))
(0011 logand побітове-і)

