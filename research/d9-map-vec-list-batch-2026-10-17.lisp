; Українські функції незмінної мапи та вектора дев'ятого домену.
; Мапа є списком пар, вектор - списком значень.
; Джерело не вводить іншої таблиці ідентичностей.

(визначити мапа-порожній
  (функція () (як-є ())))
(визначити мапа-отримати
  (функція (ключ мапа)
    (за-умовою
      ((порожній? (знайти-за-ключем ключ мапа)) (як-є ()))
      ((хибне? (порожній? (знайти-за-ключем ключ мапа)))
       (решта (знайти-за-ключем ключ мапа))))))
(визначити мапа-містить?
  (функція (ключ мапа)
    (хибне? (порожній? (знайти-за-ключем ключ мапа)))))
(визначити мапа-список
  (функція (мапа) мапа))
(визначити вектор-порожній
  (функція () (як-є ())))
(визначити вектор-кількість довжина)
(визначити вектор-н-тий елемент-списку)
