; Українські проєкції вибору елемента й частини списку.
; Індекс і межі задаються десятковими математичними числами.
; Порівняння й структурні операції належать ратифікованим доменам.

(визначити елемент-за-індексом
  (функція (список індекс)
    (за-умовою
      ((нуль? індекс) (перше список))
      ((порожній? список) (як-є ()))
      ((хибне? (порожній? список))
       (елемент-за-індексом
         (решта список)
         (зменшити-на-один індекс))))))

(визначити позиція-з
  (функція (елемент список індекс)
    (за-умовою
      ((порожній? список) (як-є ()))
      ((тотожне? елемент (перше список)) індекс)
      ((хибне? (порожній? список))
       (позиція-з
         елемент
         (решта список)
         (збільшити-на-один індекс))))))

(визначити позиція-першого-збігу
  (функція (елемент список)
    (позиція-з елемент список 0)))

(визначити підпослідовність
  (функція (список початок кінець)
    (взяти (відняти кінець початок)
      (відкинути початок список))))

(визначити елемент-справа
  (функція (список індекс)
    (елемент-за-індексом
      список
      (відняти
        (зменшити-на-один (довжина список))
        індекс))))
