; D8 ELT / POSITION / SUBSEQ / NTH-right — pure composition (lib/domains/d8.lisp)
; Ratified surfaces only (no bare numeric call-heads).

(0011 елемент-за-індексом
  (0010 (lst n)
    (110
      ((нуль? n) (перше lst))
      ((0101 lst) (001 ()))
      ((0100 (0101 lst))
       (елемент-за-індексом (решта lst) (зменшити-на-один n))))))
(0011 elt елемент-за-індексом)

(0011 позиція-з
  (0010 (item lst i)
    (110
      ((0101 lst) (001 ()))
      ((тотожне? item (перше lst)) i)
      ((0100 (0101 lst))
       (позиція-з item (решта lst) (збільшити-на-один i))))))
(0011 позиція-першого-збігу
  (0010 (item lst)
    (позиція-з item lst #d24:000000000000000000000000)))
(0011 position позиція-першого-збігу)

(0011 підпослідовність
  (0010 (lst start end)
    (взяти (відняти end start) (відкинути start lst))))
(0011 subseq підпослідовність)

(0011 елемент-справа
  (0010 (lst n)
    (елемент-за-індексом
      lst
      (відняти (зменшити-на-один (довжина lst)) n))))
(0011 nth-right елемент-справа)
