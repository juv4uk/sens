; Дослідні селектори списків Д8: елемент, позиція та підпослідовність.
; Виконувані голови записано точними українськими назвами Д3–Д4.
; Індекс є людським десятковим операндом математичного домену Д24+.
; Англійські імена elt, position, subseq, nth-right — лише сумісні прив'язки.
; Нових машинних кодів або семантичних законів цей файл не ратифікує.
;
(визначити елемент-за-індексом
  (функція (елементи індекс)
    (за-умовою
      ((нуль? індекс) (перше елементи))
      ((порожній? елементи) (як-є ()))
      ((хибне? (порожній? елементи))
       (елемент-за-індексом (решта елементи) (зменшити-на-один індекс))))))
(визначити elt елемент-за-індексом)

(визначити позиція-з
  (функція (значення елементи поточний-індекс)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((тотожне? значення (перше елементи)) поточний-індекс)
      ((хибне? (порожній? елементи))
       (позиція-з значення (решта елементи) (збільшити-на-один поточний-індекс))))))
(визначити позиція-першого-збігу
  (функція (значення елементи)
    (позиція-з значення елементи 0)))
(визначити position позиція-першого-збігу)

(визначити підпослідовність
  (функція (елементи початок кінець)
    (взяти (відняти кінець початок) (відкинути початок елементи))))
(визначити subseq підпослідовність)

(визначити елемент-справа
  (функція (елементи індекс)
    (елемент-за-індексом
      елементи
      (відняти (зменшити-на-один (довжина елементи)) індекс))))
(визначити nth-right елемент-справа)
