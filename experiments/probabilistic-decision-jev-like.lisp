; Експериментальний шар імовірнісних спостережень мовою СЕНС.
; Жодного нового семантичного домену чи типу значення.
; Імовірність не є істинністю, а законом і походженням керує СЕНС.
; Протокольні мітки збережено; старі назви лишаються прив'язками.

(визначити запит-вибору
  (функція (назва варіанти)
    (список (як-є choice-question/1) назва варіанти)))

(визначити запит-так-ні
  (функція (назва)
    (список (як-є noul-question/1) назва)))

(визначити запит-шкали
  (функція (назва рівні)
    (список (як-є score-question/1) назва рівні)))

(визначити рішення-містить?
  (функція (значення значення-списку)
    (за-умовою
      ((атом? значення-списку) ні)
      ((однакові? значення (перше значення-списку)) так)
      (так (рішення-містить? значення (решта значення-списку))))))

(визначити рішення-правильний-список?
  (функція (значення)
    (за-умовою
      ((атом? значення)
       (за-умовою
         ((тотожне? значення (як-є ())) так)
         (так ні)))
      (так (рішення-правильний-список? (решта значення))))))

(визначити допустима-ймовірність?
  (функція (ймовірність)
    ; Нуль і одиниця мусять мати той самий D24+ домен, що й аргумент.
    (нехай ((нуль (відняти ймовірність ймовірність)))
      (за-умовою
        ((менше? ймовірність нуль) ні)
        ((однакові? ймовірність нуль) так)
        ((менше? (частка ймовірність ймовірність) ймовірність) ні)
        (так так)))))

(визначити сума-ймовірностей-далі
  (функція (розподіл накопичено)
    (за-умовою
      ((атом? розподіл) накопичено)
      (так
       (сума-ймовірностей-далі
         (решта розподіл)
         (додати накопичено (друге (перше розподіл))))))))

(визначити сума-ймовірностей
  (функція (розподіл)
    (за-умовою
      ((атом? розподіл) 0)
      (так
       (сума-ймовірностей-далі
         (решта розподіл)
         (друге (перше розподіл)))))))

(визначити записи-розподілу-допустимі?
  (функція (розподіл варіанти переглянуті)
    (за-умовою
      ((атом? розподіл) так)
      (так
       (нехай ((запис (перше розподіл)))
         (за-умовою
           ((однакові? (довжина запис) 2)
            (нехай ((ключ-запису (перше запис))
                    (ймовірність (друге запис)))
              (за-умовою
                ((рішення-містить? ключ-запису варіанти)
                 (за-умовою
                   ((рішення-містить? ключ-запису переглянуті) ні)
                   ((допустима-ймовірність? ймовірність)
                    (записи-розподілу-допустимі?
                      (решта розподіл)
                      варіанти
                      (сполучити ключ-запису переглянуті)))
                   (так ні)))
                (так ні))))
           (так ні)))))))

(визначити усі-варіанти-присутні?
  (функція (варіанти розподіл)
    (за-умовою
      ((атом? варіанти) так)
      ((рішення-містить?
         (перше варіанти)
         (відобразити (функція (запис) (перше запис)) розподіл))
       (усі-варіанти-присутні? (решта варіанти) розподіл))
      (так ні))))

(визначити допустимий-розподіл?
  (функція (варіанти розподіл)
    (за-умовою
      ((хибне? (рішення-правильний-список? варіанти)) ні)
      ((хибне? (рішення-правильний-список? розподіл)) ні)
      ((атом? варіанти) ні)
      ((атом? розподіл) ні)
      ((хибне? (записи-розподілу-допустимі?
                 розподіл варіанти (як-є ()))) ні)
      (так
       (нехай ((сума (сума-ймовірностей розподіл)))
         ; Порівняння з одиницею зберігає ширину суми, без D24→D48.
         (за-умовою
           ((однакові? сума (відняти сума сума)) ні)
           ((хибне? (однакові? сума (частка сума сума))) ні)
           (так (усі-варіанти-присутні? варіанти розподіл))))))))

(визначити найбільша-ймовірність
  (функція (розподіл поточна)
    (за-умовою
      ((атом? розподіл) поточна)
      (так
       (нехай ((ймовірність (друге (перше розподіл))))
         (за-умовою
           ((менше? поточна ймовірність)
            (найбільша-ймовірність (решта розподіл) ймовірність))
           (так
            (найбільша-ймовірність (решта розподіл) поточна))))))))

(визначити упевненість-розподілу
  (функція (розподіл)
    (за-умовою
      ((атом? розподіл) 0)
      (так
       (найбільша-ймовірність
         (решта розподіл)
         (друге (перше розподіл)))))))

(визначити спостерегти-вибір
  (функція (запит розподіл джерело)
    (за-умовою
      ((допустимий-розподіл? (третє запит) розподіл)
       (список
         (як-є choice-observation/1)
         запит розподіл (упевненість-розподілу розподіл) джерело))
      (так
       (створити-некоректний
         (як-є malformed-choice-distribution)
         (список запит розподіл))))))

(визначити спостерегти-так-ні
  (функція (запит розподіл джерело)
    ; Обидві ймовірності приходять уже з однаковим D24+ доменом.
    ; Спостереження не виводить 1-p із неявного числового літерала.
    (за-умовою
      ((допустимий-розподіл? (як-є (yes no)) розподіл)
       (список
         (як-є noul-observation/1)
         запит розподіл (упевненість-розподілу розподіл) джерело))
      (так
       (створити-некоректний
         (як-є malformed-noul-distribution)
         (список запит розподіл)))))
(визначити спостерегти-шкалу
  (функція (запит розподіл джерело)
    (за-умовою
      ((допустимий-розподіл? (третє запит) розподіл)
       (список
         (як-є score-observation/1)
         запит розподіл (упевненість-розподілу розподіл) джерело))
      (так
       (створити-некоректний
         (як-є malformed-score-distribution)
         (список запит розподіл))))))

(визначити упевненість-спостереження
  (функція (спостереження)
    (четверте спостереження)))

(визначити походження-спостереження
  (функція (спостереження)
    (п'ятий спостереження)))

(визначити правило-так-ні
  (функція (спостереження поріг)
    (за-умовою
      ((однакові? (перше спостереження) (як-є noul-observation/1))
       (за-умовою
         ((допустима-ймовірність? поріг)
          (нехай ((ймовірність (друге (перше (третє спостереження)))))
            (за-умовою
              ((менше? ймовірність поріг)
               (список (як-є decision/1) (як-є defer)
                       спостереження (список (як-є поріг) поріг)))
              (так
               (список (як-є decision/1) (як-є accept)
                       спостереження (список (як-є поріг) поріг))))))
         (так
          (створити-некоректний (як-є malformed-policy-threshold) поріг))))
      (так
       (створити-некоректний
         (як-є unsupported-decision-observation) спостереження)))))

(визначити правило-вибору
  (функція (спостереження варіант поріг)
    (за-умовою
      ((однакові? (перше спостереження) (як-є choice-observation/1))
       (за-умовою
         ((допустима-ймовірність? поріг)
          (нехай ((запис (знайти-варіант-рішення
                           варіант (третє спостереження))))
            (за-умовою
              ((атом? запис)
               (створити-некоректний
                 (як-є option-not-observed)
                 (список варіант спостереження)))
              ((менше? (друге запис) поріг)
               (список (як-є decision/1) (як-є defer)
                       спостереження
                       (список (як-є варіант) варіант)
                       (список (як-є поріг) поріг)))
              (так
               (список (як-є decision/1) (як-є accept)
                       спостереження
                       (список (як-є варіант) варіант)
                       (список (як-є поріг) поріг))))))
         (так
          (створити-некоректний
            (як-є malformed-policy-threshold) поріг))))
      (так
       (створити-некоректний
         (як-є unsupported-decision-observation) спостереження)))))

(визначити знайти-варіант-рішення
  (функція (варіант розподіл)
    (за-умовою
      ((атом? розподіл) (як-є ()))
      ((однакові? варіант (перше (перше розподіл)))
       (перше розподіл))
      (так (знайти-варіант-рішення варіант (решта розподіл))))))

(визначити узгодженість-двох-запитів
  (функція (ліве праве зв'язок)
    (за-умовою
      ((тотожне? зв'язок (як-є independent))
       (список (як-є decision-relation-1)
               (як-є independent) ліве праве))
      ((тотожне? зв'язок (як-є agree))
       (за-умовою
         ((однакові? (третє ліве) (третє праве))
          (список (як-є decision-relation-1)
                  (як-є agree) ліве праве))
         (так (створити-спірний (список ліве праве)))))
      (так
       (створити-некоректний
         (як-є unsupported-question-relation)
         (список зв'язок ліве праве))))))

(визначити синтетичний-свідок-рішення
  (функція (стан запит-вибору запит-так-ні запит-шкали)
    (список
      (як-є probabilistic-witness/1)
      стан
      (спостерегти-вибір
        запит-вибору
        (список (список (як-є billing) (частка 3 4))
                (список (як-є technical) (частка 1 4)))
        (список (як-є джерело)
              (як-є synthetic-witness)
              (як-є стан)
              стан))
      (спостерегти-так-ні
        запит-так-ні
        (список
          (список (як-є yes) (частка 2 3))
          (список (як-є no) (частка 1 3)))
        (список (як-є джерело)
              (як-є synthetic-witness)
              (як-є стан)
              стан))
      (спостерегти-шкалу
        запит-шкали
        (список (список (як-є low) (частка 1 4))
                (список (як-є medium) (частка 1 2))
                (список (як-є high) (частка 1 4)))
        (список (як-є джерело)
              (як-є synthetic-witness)
              (як-є стан)
              стан)))))
