; Експериментальний шар імовірнісних спостережень мовою СЕНС.
; Жодного нового семантичного домену чи типу значення.
; Імовірність не є істинністю, а законом і походженням керує СЕНС.
; Протокольні мітки збережено; старі назви лишаються прив'язками.

(визначити запит-вибору
  (функція (назва варіанти)
    (список (як-є choice-question/1) назва варіанти)))

(визначити запит-так-ні
  (функція (назва)
    (список (як-є noul-question/1) назва)))

(визначити запит-шкали
  (функція (назва рівні)
    (список (як-є score-question/1) назва рівні)))

(визначити рішення-містить?
  (функція (значення значення-списку)
    (за-умовою
      ((атом? значення-списку) ні)
      ((однакові? значення (перше значення-списку)) так)
      (так (рішення-містить? значення (решта значення-списку))))))

(визначити рішення-правильний-список?
  (функція (значення)
    (за-умовою
      ((атом? значення)
       (за-умовою
         ((тотожне? значення (як-є ())) так)
         (так ні)))
      (так (рішення-правильний-список? (решта значення))))))

(визначити допустима-ймовірність?
  (функція (ймовірність)
    (за-умовою
      ((менше? ймовірність 0) ні)
      ((менше? 1 ймовірність) ні)
      (так так))))

(визначити сума-ймовірностей
  (функція (розподіл)
    (за-умовою
      ((атом? розподіл) 0)
      (так
       (додати (друге (перше розподіл))
               (сума-ймовірностей (решта розподіл)))))))

(визначити записи-розподілу-допустимі?
  (функція (розподіл варіанти переглянуті)
    (за-умовою
      ((атом? розподіл) так)
      (так
       (нехай ((запис (перше розподіл)))
         (за-умовою
           ((однакові? (довжина запис) 2)
            (нехай ((ключ-запису (перше запис))
                    (ймовірність (друге запис)))
              (за-умовою
                ((рішення-містить? ключ-запису варіанти)
                 (за-умовою
                   ((рішення-містить? ключ-запису переглянуті) ні)
                   ((допустима-ймовірність? ймовірність)
                    (записи-розподілу-допустимі?
                      (решта розподіл)
                      варіанти
                      (сполучити ключ-запису переглянуті)))
                   (так ні)))
                (так ні))))
           (так ні)))))))

(визначити усі-варіанти-присутні?
  (функція (варіанти розподіл)
    (за-умовою
      ((атом? варіанти) так)
      ((рішення-містить?
         (перше варіанти)
         (відобразити (функція (запис) (перше запис)) розподіл))
       (усі-варіанти-присутні? (решта варіанти) розподіл))
      (так ні))))

(визначити допустимий-розподіл?
  (функція (варіанти розподіл)
    (за-умовою
      ((хибне? (рішення-правильний-список? варіанти)) ні)
      ((хибне? (рішення-правильний-список? розподіл)) ні)
      ((атом? варіанти) ні)
      ((атом? розподіл) ні)
      ((хибне? (записи-розподілу-допустимі?
                 розподіл варіанти (як-є ()))) ні)
      ((хибне? (однакові? (сума-ймовірностей розподіл) 1)) ні)
      (так (усі-варіанти-присутні? варіанти розподіл)))))

(визначити найбільша-ймовірність
  (функція (розподіл поточна)
    (за-умовою
      ((атом? розподіл) поточна)
      (так
       (нехай ((ймовірність (друге (перше розподіл))))
         (за-умовою
           ((менше? поточна ймовірність)
            (найбільша-ймовірність (решта розподіл) ймовірність))
           (так
            (найбільша-ймовірність (решта розподіл) поточна))))))))

(визначити упевненість-розподілу
  (функція (розподіл)
    (найбільша-ймовірність розподіл 0)))

(визначити спостерегти-вибір
  (функція (запит розподіл джерело)
    (за-умовою
      ((допустимий-розподіл? (третє запит) розподіл)
       (список
         (як-є choice-observation/1)
         запит розподіл (упевненість-розподілу розподіл) джерело))
      (так
       (створити-некоректний
         (як-є malformed-choice-distribution)
         (список запит розподіл))))))

(визначити спостерегти-так-ні
  (функція (запит ймовірність-так джерело)
    (за-умовою
      ((допустима-ймовірність? ймовірність-так)
       (нехай ((розподіл
                (список
                  (список (як-є yes) ймовірність-так)
                  (список (як-є no) (відняти 1 ймовірність-так)))))
         (список
           (як-є noul-observation/1)
           запит розподіл (упевненість-розподілу розподіл) джерело)))
      (так
       (створити-некоректний
         (як-є malformed-noul-probability)
         (список запит ймовірність-так))))))

(визначити спостерегти-шкалу
  (функція (запит розподіл джерело)
    (за-умовою
      ((допустимий-розподіл? (третє запит) розподіл)
       (список
         (як-є score-observation/1)
         запит розподіл (упевненість-розподілу розподіл) джерело))
      (так
       (створити-некоректний
         (як-є malformed-score-distribution)
         (список запит розподіл))))))

(визначити упевненість-спостереження
  (функція (спостереження)
    (четверте спостереження)))

(визначити походження-спостереження
  (функція (спостереження)
    (п'ятий спостереження)))

(визначити правило-так-ні
  (функція (спостереження поріг)
    (за-умовою
      ((однакові? (перше спостереження) (як-є noul-observation/1))
       (за-умовою
         ((допустима-ймовірність? поріг)
          (нехай ((ймовірність (друге (перше (третє спостереження)))))
            (за-умовою
              ((менше? ймовірність поріг)
               (список (як-є decision/1) (як-є defer)
                       спостереження (список (як-є поріг) поріг)))
              (так
               (список (як-є decision/1) (як-є accept)
                       спостереження (список (як-є поріг) поріг))))))
         (так
          (створити-некоректний (як-є malformed-policy-threshold) поріг))))
      (так
       (створити-некоректний
         (як-є unsupported-decision-observation) спостереження)))))

(визначити правило-вибору
  (функція (спостереження варіант поріг)
    (за-умовою
      ((однакові? (перше спостереження) (як-є choice-observation/1))
       (за-умовою
         ((допустима-ймовірність? поріг)
          (нехай ((запис (знайти-варіант-рішення
                           варіант (третє спостереження))))
            (за-умовою
              ((атом? запис)
               (створити-некоректний
                 (як-є option-not-observed)
                 (список варіант спостереження)))
              ((менше? (друге запис) поріг)
               (список (як-є decision/1) (як-є defer)
                       спостереження
                       (список (як-є варіант) варіант)
                       (список (як-є поріг) поріг)))
              (так
               (список (як-є decision/1) (як-є accept)
                       спостереження
                       (список (як-є варіант) варіант)
                       (список (як-є поріг) поріг))))))
         (так
          (створити-некоректний
            (як-є malformed-policy-threshold) поріг))))
      (так
       (створити-некоректний
         (як-є unsupported-decision-observation) спостереження)))))

(визначити знайти-варіант-рішення
  (функція (варіант розподіл)
    (за-умовою
      ((атом? розподіл) (як-є ()))
      ((однакові? варіант (перше (перше розподіл)))
       (перше розподіл))
      (так (знайти-варіант-рішення варіант (решта розподіл))))))

(визначити узгодженість-двох-запитів
  (функція (ліве праве зв'язок)
    (за-умовою
      ((тотожне? зв'язок (як-є independent))
       (список (як-є decision-relation-1)
               (як-є independent) ліве праве))
      ((тотожне? зв'язок (як-є agree))
       (за-умовою
         ((однакові? (третє ліве) (третє праве))
          (список (як-є decision-relation-1)
                  (як-є agree) ліве праве))
         (так (створити-спірний (список ліве праве)))))
      (так
       (створити-некоректний
         (як-є unsupported-question-relation)
         (список зв'язок ліве праве))))))

(визначити синтетичний-свідок-рішення
  (функція (стан запит-вибору запит-так-ні запит-шкали)
    (список
      (як-є probabilistic-witness/1)
      стан
      (спостерегти-вибір
        запит-вибору
        (як-є ((billing 3/4) (technical 1/4)))
        (список (як-є джерело)
              (як-є synthetic-witness)
              (як-є стан)
              стан))
      (спостерегти-так-ні
        запит-так-ні
        2/3
        (список (як-є джерело)
              (як-є synthetic-witness)
              (як-є стан)
              стан))
      (спостерегти-шкалу
        запит-шкали
        (як-є ((low 1/4) (medium 1/2) (high 1/4)))
        (список (як-є джерело)
              (як-є synthetic-witness)
              (як-є стан)
              стан)))))


; Перший Jev-подібний механізм вибирає дію з реального розподілу.
; Він не вигадує ймовірності: споживає валідоване спостереження,
; зберігає provenance та відкладає вибір за рівності найвищих шансів.
(визначити спостереження-вибору-допустиме?
  (функція (спостереження)
    (за-умовою
      ((хибне? (рішення-правильний-список? спостереження)) ні)
      ((хибне? (однакові? (довжина спостереження) 5)) ні)
      ((хибне? (однакові? (перше спостереження) (як-є choice-observation/1))) ні)
      ((хибне? (рішення-правильний-список? (друге спостереження))) ні)
      ((хибне? (однакові? (довжина (друге спостереження)) 3)) ні)
      ((хибне? (однакові? (перше (друге спостереження)) (як-є choice-question/1))) ні)
      ((хибне? (допустимий-розподіл?
                 (третє (друге спостереження))
                 (третє спостереження))) ні)
      ((хибне? (однакові?
                 (четверте спостереження)
                 (упевненість-розподілу (третє спостереження)))) ні)
      (так так))))

(визначити найімовірніші-варіанти
  (функція (розподіл максимуму)
    (за-умовою
      ((атом? розподіл) (як-є ()))
      ((однакові? (друге (перше розподіл)) максимуму)
       (сполучити
         (перше (перше розподіл))
         (найімовірніші-варіанти (решта розподіл) максимуму)))
      (так
       (найімовірніші-варіанти (решта розподіл) максимуму)))))

(визначити правило-автоматичного-вибору
  (функція (спостереження поріг)
    (за-умовою
      ((хибне? (допустима-ймовірність? поріг))
       (створити-некоректний (як-є malformed-policy-threshold) поріг))
      ((хибне? (спостереження-вибору-допустиме? спостереження))
       (створити-некоректний (як-є malformed-choice-observation) спостереження))
      (так
       (нехай ((розподіл (третє спостереження))
               (впевненість (четверте спостереження))
               (верхні-варіанти
                 (найімовірніші-варіанти
                   (третє спостереження)
                   (упевненість-розподілу (третє спостереження)))))
         (за-умовою
           ((атом? верхні-варіанти)
            (створити-некоректний (як-є empty-choice-distribution) спостереження))
           ((хибне? (однакові? (довжина верхні-варіанти) 1))
            (список
              (як-є decision/1)
              (як-є defer)
              спостереження
              (список (як-є reason) (як-є ambiguous-maximum-probability))
              (список (як-є candidates) верхні-варіанти)
              (список (як-є threshold) поріг)
              (список (як-є confidence) впевненість)))
           ((менше? впевненість поріг)
            (список
              (як-є decision/1)
              (як-є defer)
              спостереження
              (список (як-є reason) (як-є below-confidence-threshold))
              (список (як-є variant) (перше верхні-варіанти))
              (список (як-є threshold) поріг)
              (список (як-є confidence) впевненість)))
           (так
            (список
              (як-є decision/1)
              (як-є accept)
              спостереження
              (список (як-є variant) (перше верхні-варіанти))
              (список (як-є threshold) поріг)
              (список (як-є confidence) впевненість)))))))))

; Сумісні прив'язки до тих самих українських функцій.
(визначити pd-question-choice запит-вибору)
(визначити pd-question-noul запит-так-ні)
(визначити pd-question-score запит-шкали)
(визначити pd-member? рішення-містить?)
(визначити pd-proper-list? рішення-правильний-список?)
(визначити pd-probability-valid? допустима-ймовірність?)
(визначити pd-sum-probabilities сума-ймовірностей)
(визначити pd-distribution-entries-valid? записи-розподілу-допустимі?)
(визначити pd-all-options-present? усі-варіанти-присутні?)
(визначити pd-distribution-valid? допустимий-розподіл?)
(визначити pd-max-probability найбільша-ймовірність)
(визначити pd-confidence упевненість-розподілу)
(визначити pd-choice-observe спостерегти-вибір)
(визначити pd-noul-observe спостерегти-так-ні)
(визначити pd-score-observe спостерегти-шкалу)
(визначити pd-observation-confidence упевненість-спостереження)
(визначити pd-observation-provenance походження-спостереження)
(визначити pd-noul-policy правило-так-ні)
(визначити pd-choice-policy правило-вибору)
(визначити pd-choice-auto-policy правило-автоматичного-вибору)
(визначити pd-top-options найімовірніші-варіанти)
(визначити pd-find-option знайти-варіант-рішення)
(визначити pd-two-question-consistency узгодженість-двох-запитів)
(визначити pd-synthetic-witness синтетичний-свідок-рішення)
