; #1257 — Матриця носіїв результату предиката четвертого ядра.
;
; Лише дослідження: файл не визначає остаточного носія.
; Мова перевіряє круговий перехід запис → читання.
; Історичний сід8 — тільки текстове свідчення походження, не поточний тип чи число.
; Старе 00000011 означало EQ, чинна тотожність — D3:101 / тотожне?.
; Символ з написанням "00" може змінити ідентичність після читання.
; Рядок точно зберігає написання як транспортні дані,
; але не встановлює нової семантичної тотожності.
(визначити матриця-символ (текст-у-символ "00"))
(визначити матриця-записаний-символ (значення-у-текст матриця-символ))
(визначити матриця-прочитаний-символ (прочитати матриця-записаний-символ))

(визначити матриця-рядок "00")
(визначити матриця-записаний-рядок (значення-у-текст матриця-рядок))
(визначити матриця-прочитаний-рядок (прочитати матриця-записаний-рядок))

(визначити матриця-історичний-запис "00000011")
(визначити матриця-чинна-тотожність (як-є тотожне?))
; На відміну від текстової історії, це справжній виклик D3:101 через укр.
(визначити матриця-чинний-результат-д3
  (тотожне? (як-є контрольний-атом) (як-є контрольний-атом)))
(визначити матриця-записаний-сід (значення-у-текст матриця-історичний-запис))
(визначити матриця-прочитаний-сід (прочитати матриця-записаний-сід))

(визначити матриця-описувач-двійкового (бінарний 2))

(визначити матриця-спостережене
  (список
    (список (як-є binary-descriptor) матриця-описувач-двійкового)
    (список (як-є symbol-written) матриця-записаний-символ)
    (список (як-є symbol-read) матриця-прочитаний-символ)
    (список (як-є symbol-roundtrip)
          (однакові? матриця-символ матриця-прочитаний-символ))
    (список (як-є string-written) матриця-записаний-рядок)
    (список (як-є string-read) матриця-прочитаний-рядок)
    (список (як-є string-roundtrip)
          (однакові? матриця-рядок матриця-прочитаний-рядок))
    (список (як-є sid-written) матриця-записаний-сід)
    (список (як-є sid-read) матриця-прочитаний-сід)
    (список (як-є sid-current-ukr) матриця-чинна-тотожність)
    (список (як-є current-d3-eq-result) матриця-чинний-результат-д3)
    (список (як-є sid-roundtrip)
          (однакові? матриця-історичний-запис матриця-прочитаний-сід))))

(визначити матриця-очікуване
  (список
    (список (як-є binary-descriptor) (список (як-є binary) 2))
    (список (як-є symbol-written) "00")
    (список (як-є symbol-read) 0)
    (список (як-є symbol-roundtrip) (як-є (0)))
    (список (як-є string-written) "\"00\"")
    (список (як-є string-read) "00")
    (список (як-є string-roundtrip) (як-є (1)))
    (список (як-є sid-written) "\"00000011\"")
    (список (як-є sid-read) "00000011")
    (список (як-є sid-current-ukr) (як-є тотожне?))
    (список (як-є current-d3-eq-result) (атом? (як-є ())))
    (список (як-є sid-roundtrip) (як-є (1)))))

(за-умовою
  ((однакові? матриця-спостережене матриця-очікуване)
   (як-є (core4-answer-carrier-matrix-ok)))
  ((атом? (як-є ()))
   (список (як-є core4-answer-carrier-matrix-mismatch)
         матриця-очікуване
         матриця-спостережене)))
