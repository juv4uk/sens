; Дослідження родоводу функцій.
; Граф використовує чинні функційні ідентичності, цитовані через повну проєкцію «укр».
; Дослід перевіряє, які ратифіковані операції дозволяють відтворити інші.
; Це не нова таблиця повноважень. Ребра графа — дослідні свідчення,
; підкріплені виконуваними визначеннями в цьому файлі.
;
; Використані чинні тотожності доменів (у цитованих даних — проєкція «укр»):
;   quote   D3:001 / як-є
;   cons    D3:111 / сполучити
;   car     D3:100 / перше
;   cdr     D3:011 / решта
;   pair    D8:11111101 / пара
;   second  D4:1001 / друге
;   third   D5:10011 / третє
;   fourth  D6:100111 / четверте
;   fifth   D9:110110101 / п'ятий
;   caar    D4:1000 / перше-першого
;   cadr    D4:1001 / друге
;   cddr    D4:0111 / решта-решти

(визначити родовід-залежить-від (як-є родовід-залежить-від))

; Одне ребро означає: ДЖЕРЕЛО безпосередньо використано виконуваною
; лабораторною реконструкцією ЦІЛІ. Смисл відношення живе в цьому
; експерименті, а не в історичному восьмибітному ідентифікаторі.
(визначити родовід-функцій
  (список
    (список (як-є сполучити) родовід-залежить-від (як-є пара))
    (список (як-є як-є) родовід-залежить-від (як-є пара))

    (список (як-є перше) родовід-залежить-від (як-є друге))
    (список (як-є решта) родовід-залежить-від (як-є друге))

    (список (як-є перше) родовід-залежить-від (як-є третє))
    (список (як-є решта) родовід-залежить-від (як-є третє))

    (список (як-є перше) родовід-залежить-від (як-є четверте))
    (список (як-є решта) родовід-залежить-від (як-є четверте))

    (список (як-є перше) родовід-залежить-від (як-є п'ятий))
    (список (як-є решта) родовід-залежить-від (як-є п'ятий))

    (список (як-є перше) родовід-залежить-від (як-є перше-першого))

    (список (як-є перше) родовід-залежить-від (як-є друге))
    (список (як-є решта) родовід-залежить-від (як-є друге))

    (список (як-є решта) родовід-залежить-від (як-є решта-решти))))

; Лабораторні реконструкції. Імена навмисно не є іменами реєстру:
; наявні функції лишаються незмінними, поки ми перевіряємо достатність.

(визначити дослід-пара
  (функція (ліве праве)
    (сполучити ліве (сполучити праве (як-є ())))))

(визначити дослід-друге
  (функція (значення)
    (перше (решта значення))))

(визначити дослід-третє
  (функція (значення)
    (перше (решта (решта значення)))))

(визначити дослід-четверте
  (функція (значення)
    (перше (решта (решта (решта значення))))))

(визначити дослід-п'яте
  (функція (значення)
    (перше (решта (решта (решта (решта значення)))))))

(визначити дослід-перше-першого
  (функція (значення)
    (перше (перше значення))))

(визначити дослід-перше-решти
  (функція (значення)
    (перше (решта значення))))

(визначити дослід-решта-решти
  (функція (значення)
    (решта (решта значення))))

; Явні записи результатів лишають () доступним як звичайні дані.
(визначити перевірити-родовід
  (функція (ідентичність спостережене очікуване)
    (за-умовою
      ((однакові? спостережене очікуване)
       (список ідентичність (як-є reproduced)))
      (так
       (список ідентичність (як-є diverged))))))

(визначити свідчення-родоводу-функцій
  (функція ()
    (нехай ((плаский-набір (як-є (a b c d e))))
      (нехай ((вкладений-набір (як-є ((left inner) right))))
        (список
          (перевірити-родовід
            (як-є пара)
            (дослід-пара (як-є left) (як-є right))
            (пара (як-є left) (як-є right)))
          (перевірити-родовід (як-є друге) (дослід-друге плаский-набір) (друге плаский-набір))
          (перевірити-родовід (як-є третє) (дослід-третє плаский-набір) (третє плаский-набір))
          (перевірити-родовід (як-є четверте) (дослід-четверте плаский-набір) (четверте плаский-набір))
          (перевірити-родовід (як-є п'ятий) (дослід-п'яте плаский-набір) (п'ятий плаский-набір))
          (перевірити-родовід (як-є перше-першого) (дослід-перше-першого вкладений-набір) (перше-першого вкладений-набір))
          (перевірити-родовід (як-є друге) (дослід-перше-решти плаский-набір) (друге плаский-набір))
          (перевірити-родовід (як-є решта-решти) (дослід-решта-решти плаский-набір) (решта-решти плаский-набір)))))))

; Запити до графа експериментального родоводу. Вони спрямовані:
; «які цілі безпосередньо залежать від ДЖЕРЕЛА?» Ми навмисно повертаємо
; кожну відповідну ціль, а не обираємо одну.

(визначити прямі-нащадки-родоводу
  (функція (граф джерело)
    (за-умовою
      ((атом? граф) (як-є ()))
      ((однакові? (перше (перше граф)) джерело)
       (сполучити
         (третє (перше граф))
         (прямі-нащадки-родоводу (решта граф) джерело)))
      (так
       (прямі-нащадки-родоводу (решта граф) джерело)))))

(визначити спостереження-родоводу-функцій
  (функція ()
    (список
      (список
        (як-є from-cons)
        (прямі-нащадки-родоводу родовід-функцій (як-є сполучити)))
      (список
        (як-є from-car)
        (прямі-нащадки-родоводу родовід-функцій (як-є перше)))
      (список
        (як-є from-cdr)
        (прямі-нащадки-родоводу родовід-функцій (як-є решта)))
      (список
        (як-є reproductions)
        (свідчення-родоводу-функцій)))))


; ---------------------------------------------------------------------------
; Експериментальні проби перекриття ідентичностей.
;
; Різні реалізації однієї чинної тотожності можуть бути
; спостережно невідрізнювані на вибраній області. Це НЕ створює нових
; семантичних ідентичностей. Це дає свідчення кандидатної
; еквівалентності для пізніших експериментів.

(визначити родовід-спостерігає-подібність (як-є родовід-спостерігає-подібність))

(визначити пара-спостереження
  (функція (ліве праве)
    (список ліве праве)))

(визначити спостереження-однакові?
  (функція (ліве праве)
    (однакові? ліве праве)))

(визначити зразки-еквівалентні-для-двох-унарних?
  (функція (перша-функція друга-функція перший-зразок другий-зразок)
    (за-умовою
      ((спостереження-однакові?
         (перша-функція перший-зразок)
         (друга-функція перший-зразок))
       (за-умовою
         ((спостереження-однакові?
            (перша-функція другий-зразок)
            (друга-функція другий-зразок))
          так)
         (так ні)))
      (так ні))))

; Похідні назви й чинні тотожності:
;   second  = D4:1001 / друге
;   cadr    = D4:1001 / друге
;   fourth  = D6:100111 / четверте
;   cadddr  = D6:100111 / четверте
;
; Поточна реалізація ядра:
;   second і cadr — одна чинна ідентичність D4:1001 (друге);
;   fourth і cadddr — одна чинна ідентичність D6:100111 (четверте).
(визначити кандидати-перекриття-функцій
  (список
    (список (як-є друге) родовід-спостерігає-подібність (як-є друге))
    (список (як-є четверте) родовід-спостерігає-подібність (як-є четверте))))

(визначити свідчення-перекриття-функцій
  (функція ()
    (нехай ((перший-зразок (як-є (a b c d e))))
      (нехай ((другий-зразок (як-є ((x y) (p q) r s t))))
        (список
          (список
            (як-є second-vs-cadr)
            (зразки-еквівалентні-для-двох-унарних?
              друге дослід-друге перший-зразок другий-зразок))
          (список
            (як-є fourth-vs-cadddr)
            (зразки-еквівалентні-для-двох-унарних?
              четверте дослід-четверте перший-зразок другий-зразок))
          ; Навмисно слабше перекриття: pair і list збігаються рівно на двох
          ; аргументах, але LIST варіативний, тож це лише свідчення перекриття,
          ; ніколи не заява про еквівалентність.
          (список
            (як-є pair-vs-list-two-args)
            (спостереження-однакові?
              (пара (як-є left) (як-є right))
              (список (як-є left) (як-є right)))))))))

; ---------------------------------------------------------------------------
; Острів уніфікації.
;
; Тут «породження» — це гіперграф залежностей: ціль може вимагати кілька
; зареєстрованих ідентичностей разом. Внутрішні допоміжні лишаються
; апаратом і не отримують синтетичних семантичних ідентичностей.

(визначити родовід-потребує (як-є родовід-потребує))

; Чинні ідентичності функцій:
; logic-var   D9:101110010 / логічна-змінна
; var?        D9:101100100 / змінна?
; apply-subst D9:101101001 / застосувати-підстановка
; walk        D9:101110100 / пройти
; occurs-check D9:101110101 / входить-перевірити?
; unify       D9:101010000 / уніфікувати
;
; Чинні домени ядра/списку, використані реалізаціями:
; atom   D3:010 / атом?
; eq     D3:101 / тотожне?
; cons   D3:111 / сполучити
; car    D3:100 / перше
; cdr    D3:011 / решта
; cond   D3:110 / за-умовою
; list   D4:1110 / список
; second D4:1001 / друге
; equal? D8:11110111 / однакові?

(визначити родовід-уніфікації
  (список
    ; logic-var = list + побудова quote/даних
    (список (як-є список) родовід-потребує (як-є логічна-змінна))

    ; var? структурно залежить від atom/car/eq/cond
    (список (як-є атом?) родовід-потребує (як-є змінна?))
    (список (як-є перше) родовід-потребує (як-є змінна?))
    (список (як-є тотожне?) родовід-потребує (як-є змінна?))
    (список (як-є за-умовою) родовід-потребує (як-є змінна?))

    ; walk вживає var? плюс структурний пошук підстановки
    (список (як-є змінна?) родовід-потребує (як-є пройти))

    ; occurs-check рекурсивно потребує walk/var?/equal?/second/car/cdr
    (список (як-є пройти) родовід-потребує (як-є входить-перевірити?))
    (список (як-є змінна?) родовід-потребує (як-є входить-перевірити?))
    (список (як-є однакові?) родовід-потребує (як-є входить-перевірити?))
    (список (як-є друге) родовід-потребує (як-є входить-перевірити?))
    (список (як-є перше) родовід-потребує (як-є входить-перевірити?))
    (список (як-є решта) родовід-потребує (як-є входить-перевірити?))

    ; apply-subst розіменовує через walk і відбудовує терми через cons/car/cdr
    (список (як-є пройти) родовід-потребує (як-є застосувати-підстановка))
    (список (як-є сполучити) родовід-потребує (як-є застосувати-підстановка))
    (список (як-є перше) родовід-потребує (як-є застосувати-підстановка))
    (список (як-є решта) родовід-потребує (як-є застосувати-підстановка))

    ; сам unify зосереджений навколо walk, var?, occurs-check, equal?
    (список (як-є пройти) родовід-потребує (як-є уніфікувати))
    (список (як-є змінна?) родовід-потребує (як-є уніфікувати))
    (список (як-є входить-перевірити?) родовід-потребує (як-є уніфікувати))
    (список (як-є однакові?) родовід-потребує (як-є уніфікувати))))

(визначити джерела-родоводу-для
  (функція (граф ціль)
    (за-умовою
      ((атом? граф) (як-є ()))
      ((однакові? (третє (перше граф)) ціль)
       (сполучити
         (перше (перше граф))
         (джерела-родоводу-для (решта граф) ціль)))
      (так
       (джерела-родоводу-для (решта граф) ціль)))))

(визначити свідчення-родоводу-уніфікації
  (функція ()
    (список
      (список
        (як-є walk-needs)
        (джерела-родоводу-для родовід-уніфікації (як-є пройти)))
      (список
        (як-є occurs-check-needs)
        (джерела-родоводу-для родовід-уніфікації (як-є входить-перевірити?)))
      (список
        (як-є apply-subst-needs)
        (джерела-родоводу-для родовід-уніфікації (як-є застосувати-підстановка)))
      (список
        (як-є unify-needs)
        (джерела-родоводу-для родовід-уніфікації (як-є уніфікувати)))
      ; Виконувана поведінкова проба, що показує: UNIFY створює підстановку,
      ; яку APPLY-SUBST може спожити. Це динамічне відношення, не лише статичні
      ; метадані залежностей.
      (список
        (як-є unify-produces-for-apply-subst)
        (нехай ((підстановка
                (уніфікувати
                  (список (як-є parent) (як-є alice) (логічна-змінна (як-є x)))
                  (список (як-є parent) (як-є alice) (як-є bob))
                  (як-є ()))))
          (застосувати-підстановка (логічна-змінна (як-є x)) підстановка))))))

(визначити свідчення-лабораторії-функцій
  (функція ()
    (список
      (список (як-є structural-genealogy) (спостереження-родоводу-функцій))
      (список (як-є overlap-candidates) (свідчення-перекриття-функцій))
      (список (як-є unification-island) (свідчення-родоводу-уніфікації)))))
