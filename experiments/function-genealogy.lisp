; Дослідження родоводу функцій.
; Семантичний реєстр надає непрозорі історичні ідентичності BitPattern8.
; Дослід перевіряє, які зареєстровані операції дозволяють відтворити інші.
; Це не нова таблиця повноважень. Ребра графа — дослідні свідчення,
; підкріплені виконуваними визначеннями в цьому файлі.
;
; Використані ідентичності реєстру:
;   quote   00000001
;   cons    00000100
;   car     00000101
;   cdr     00000110
;   pair    00101110
;   second  00101111
;   third   00110000
;   fourth  00110001
;   fifth   00110010
;   caar    00110011
;   cadr    00110100
;   cddr    00110101

(визначити родовід-залежить-від 11110000)

; Одне ребро означає: ДЖЕРЕЛО безпосередньо використано виконуваною
; лабораторною реконструкцією ЦІЛІ. Смисл відношення живе в цьому
; експерименті, а не в самому бітовому шаблоні.
(визначити родовід-функцій
  (список
    (список 00000100 родовід-залежить-від 00101110)
    (список 00000001 родовід-залежить-від 00101110)

    (список 00000101 родовід-залежить-від 00101111)
    (список 00000110 родовід-залежить-від 00101111)

    (список 00000101 родовід-залежить-від 00110000)
    (список 00000110 родовід-залежить-від 00110000)

    (список 00000101 родовід-залежить-від 00110001)
    (список 00000110 родовід-залежить-від 00110001)

    (список 00000101 родовід-залежить-від 00110010)
    (список 00000110 родовід-залежить-від 00110010)

    (список 00000101 родовід-залежить-від 00110011)

    (список 00000101 родовід-залежить-від 00110100)
    (список 00000110 родовід-залежить-від 00110100)

    (список 00000110 родовід-залежить-від 00110101)))

; Лабораторні реконструкції. Імена навмисно не є іменами реєстру:
; наявні функції лишаються незмінними, поки ми перевіряємо достатність.

(визначити дослід-пара
  (функція (ліве праве)
    (сполучити ліве (сполучити праве (як-є ())))))

(визначити дослід-друге
  (функція (значення)
    (перше (решта значення))))

(визначити дослід-третє
  (функція (значення)
    (перше (решта (решта значення)))))

(визначити дослід-четверте
  (функція (значення)
    (перше (решта (решта (решта значення))))))

(визначити дослід-п'яте
  (функція (значення)
    (перше (решта (решта (решта (решта значення)))))))

(визначити дослід-перше-першого
  (функція (значення)
    (перше (перше значення))))

(визначити дослід-перше-решти
  (функція (значення)
    (перше (решта значення))))

(визначити дослід-решта-решти
  (функція (значення)
    (решта (решта значення))))

; Явні записи результатів лишають () доступним як звичайні дані.
(визначити перевірити-родовід
  (функція (ідентичність спостережене очікуване)
    (за-умовою
      ((однакові? спостережене очікуване)
       (список ідентичність (як-є reproduced)))
      (так
       (список ідентичність (як-є diverged))))))

(визначити свідчення-родоводу-функцій
  (функція ()
    (нехай ((плаский-набір (як-є (a b c d e))))
      (нехай ((вкладений-набір (як-є ((left inner) right))))
        (список
          (перевірити-родовід
            00101110
            (дослід-пара (як-є left) (як-є right))
            (пара (як-є left) (як-є right)))
          (перевірити-родовід 00101111 (дослід-друге плаский-набір) (друге плаский-набір))
          (перевірити-родовід 00110000 (дослід-третє плаский-набір) (третє плаский-набір))
          (перевірити-родовід 00110001 (дослід-четверте плаский-набір) (четверте плаский-набір))
          (перевірити-родовід 00110010 (дослід-п'яте плаский-набір) (п'ятий плаский-набір))
          (перевірити-родовід 00110011 (дослід-перше-першого вкладений-набір) (перше-першого вкладений-набір))
          (перевірити-родовід 00110100 (дослід-перше-решти плаский-набір) (друге плаский-набір))
          (перевірити-родовід 00110101 (дослід-решта-решти плаский-набір) (решта-решти плаский-набір)))))))

; Запити до графа експериментального родоводу. Вони спрямовані:
; «які цілі безпосередньо залежать від ДЖЕРЕЛА?» Ми навмисно повертаємо
; кожну відповідну ціль, а не обираємо одну.

(визначити прямі-нащадки-родоводу
  (функція (граф джерело)
    (за-умовою
      ((атом? граф) (як-є ()))
      ((тотожне? (перше (перше граф)) джерело)
       (сполучити
         (третє (перше граф))
         (прямі-нащадки-родоводу (решта граф) джерело)))
      (так
       (прямі-нащадки-родоводу (решта граф) джерело)))))

(визначити спостереження-родоводу-функцій
  (функція ()
    (список
      (список
        (як-є from-cons)
        (прямі-нащадки-родоводу родовід-функцій 00000100))
      (список
        (як-є from-car)
        (прямі-нащадки-родоводу родовід-функцій 00000101))
      (список
        (як-є from-cdr)
        (прямі-нащадки-родоводу родовід-функцій 00000110))
      (список
        (як-є reproductions)
        (свідчення-родоводу-функцій)))))


; ---------------------------------------------------------------------------
; Експериментальні проби перекриття ідентичностей.
;
; Реєстр може містити різні ідентичності, чиї поточні реалізації Lisp
; спостережно невідрізнювані на вибраній області. Це НЕ згортає їхні
; семантичні ідентичності автоматично. Це дає свідчення кандидатної
; еквівалентності для пізніших експериментів.

(визначити родовід-спостерігає-подібність 11110001)

(визначити пара-спостереження
  (функція (ліве праве)
    (список ліве праве)))

(визначити спостереження-однакові?
  (функція (ліве праве)
    (однакові? ліве праве)))

(визначити зразки-еквівалентні-для-двох-унарних?
  (функція (перша-функція друга-функція перший-зразок другий-зразок)
    (за-умовою
      ((спостереження-однакові?
         (перша-функція перший-зразок)
         (друга-функція перший-зразок))
       (за-умовою
         ((спостереження-однакові?
            (перша-функція другий-зразок)
            (друга-функція другий-зразок))
          (як-є (1)))
         (так (як-є (0)))))
      (так (як-є (0))))))

; Різні ідентичності реєстру:
;   second  = 00101111
;   cadr    = 00110100
;   fourth  = 00110001
;   cadddr  = 00110110
;
; Поточна реалізація ядра:
;   second і cadr мають ідентичні тіла;
;   cadddr буквально визначений як той самий об'єкт-замикання, що й fourth.
(визначити кандидати-перекриття-функцій
  (список
    (список 00101111 родовід-спостерігає-подібність 00110100)
    (список 00110001 родовід-спостерігає-подібність 00110110)))

(визначити свідчення-перекриття-функцій
  (функція ()
    (нехай ((перший-зразок (як-є (a b c d e))))
      (нехай ((другий-зразок (як-є ((x y) (p q) r s t))))
        (список
          (список
            (як-є second-vs-cadr)
            (зразки-еквівалентні-для-двох-унарних?
              second cadr перший-зразок другий-зразок))
          (список
            (як-є fourth-vs-cadddr)
            (зразки-еквівалентні-для-двох-унарних?
              fourth cadddr перший-зразок другий-зразок))
          ; Навмисно слабше перекриття: pair і list збігаються рівно на двох
          ; аргументах, але LIST варіативний, тож це лише свідчення перекриття,
          ; ніколи не заява про еквівалентність.
          (список
            (як-є pair-vs-list-two-args)
            (спостереження-однакові?
              (пара (як-є left) (як-є right))
              (список (як-є left) (як-є right)))))))))

; ---------------------------------------------------------------------------
; Острів уніфікації.
;
; Тут «породження» — це гіперграф залежностей: ціль може вимагати кілька
; зареєстрованих ідентичностей разом. Внутрішні допоміжні лишаються
; апаратом і не отримують синтетичних семантичних ідентичностей.

(визначити родовід-потребує 11110010)

; Ідентичності реєстру:
; logic-var   10001000
; var?        10001001
; apply-subst 10001010
; walk        10001011
; occurs-check 10001100
; unify       10000111
;
; Ідентичності ядра/списку, використані тими реалізаціями:
; atom   00000010
; eq     00000011
; cons   00000100
; car    00000101
; cdr    00000110
; cond   00000111
; list   00100111
; second 00101111
; equal? 00100010

(визначити родовід-уніфікації
  (список
    ; logic-var = list + побудова quote/даних
    (список 00100111 родовід-потребує 10001000)

    ; var? структурно залежить від atom/car/eq/cond
    (список 00000010 родовід-потребує 10001001)
    (список 00000101 родовід-потребує 10001001)
    (список 00000011 родовід-потребує 10001001)
    (список 00000111 родовід-потребує 10001001)

    ; walk вживає var? плюс структурний пошук підстановки
    (список 10001001 родовід-потребує 10001011)

    ; occurs-check рекурсивно потребує walk/var?/equal?/second/car/cdr
    (список 10001011 родовід-потребує 10001100)
    (список 10001001 родовід-потребує 10001100)
    (список 00100010 родовід-потребує 10001100)
    (список 00101111 родовід-потребує 10001100)
    (список 00000101 родовід-потребує 10001100)
    (список 00000110 родовід-потребує 10001100)

    ; apply-subst розіменовує через walk і відбудовує терми через cons/car/cdr
    (список 10001011 родовід-потребує 10001010)
    (список 00000100 родовід-потребує 10001010)
    (список 00000101 родовід-потребує 10001010)
    (список 00000110 родовід-потребує 10001010)

    ; сам unify зосереджений навколо walk, var?, occurs-check, equal?
    (список 10001011 родовід-потребує 10000111)
    (список 10001001 родовід-потребує 10000111)
    (список 10001100 родовід-потребує 10000111)
    (список 00100010 родовід-потребує 10000111)))

(визначити джерела-родоводу-для
  (функція (граф ціль)
    (за-умовою
      ((атом? граф) (як-є ()))
      ((тотожне? (третє (перше граф)) ціль)
       (сполучити
         (перше (перше граф))
         (джерела-родоводу-для (решта граф) ціль)))
      (так
       (джерела-родоводу-для (решта граф) ціль)))))

(визначити свідчення-родоводу-уніфікації
  (функція ()
    (список
      (список
        (як-є walk-needs)
        (джерела-родоводу-для родовід-уніфікації 10001011))
      (список
        (як-є occurs-check-needs)
        (джерела-родоводу-для родовід-уніфікації 10001100))
      (список
        (як-є apply-subst-needs)
        (джерела-родоводу-для родовід-уніфікації 10001010))
      (список
        (як-є unify-needs)
        (джерела-родоводу-для родовід-уніфікації 10000111))
      ; Виконувана поведінкова проба, що показує: UNIFY створює підстановку,
      ; яку APPLY-SUBST може спожити. Це динамічне відношення, не лише статичні
      ; метадані залежностей.
      (список
        (як-є unify-produces-for-apply-subst)
        (нехай ((підстановка
                (уніфікувати
                  (список (як-є parent) (як-є alice) (логічна-змінна (як-є x)))
                  (список (як-є parent) (як-є alice) (як-є bob))
                  (як-є ()))))
          (застосувати-підстановка (логічна-змінна (як-є x)) підстановка))))))

(визначити свідчення-лабораторії-функцій
  (функція ()
    (список
      (список (як-є structural-genealogy) (спостереження-родоводу-функцій))
      (список (як-є overlap-candidates) (свідчення-перекриття-функцій))
      (список (як-є unification-island) (свідчення-родоводу-уніфікації)))))
