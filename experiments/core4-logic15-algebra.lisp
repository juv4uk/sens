; #1391 — виконуваний свідок затверджених законів Core4 (контракт
; contracts/core4-predicate-answer-scale.lisp, схема /3, 2026-09-26).
; Спершу це було дослідження; власник затвердив AND/OR/COND і носій
; «список бітів». Runtime atom?/eq? на ці закони переходять окремим PR.
;
; Питання: якщо 15 відповідей лежать на одній лінії істинності
;
;   0 < 00 < … < 0000000 < () < 1111111 < … < 11 < 1
;
; а NOT — чинний закон «інвертувати біти, зберегти ширину», то чи
; дають «ні перемагає / так слабшає» (AND) та його дуальний OR
; чесну алгебру? І чи вкладається в неї бінарна логіка Core1–3 {0, 1}
; без суперечності?
;
; Донори (#1393): research/219-multi-logic-candidates (корпус E0–E6,
; таблиці K3), research/223-many-valued-logic (Belnap FOUR: два окремі
; порядки — істини та інформації), research/432-car-cdr-bounded-basis
; (вичерпна перевірка замість віри).
;
; Чистий СЕНС: лише функції з допущеним механізмом —
;   00000001 як-є (через '), 00000010 атом?, 00000011 тотожне?,
;   00000100 сполучити, 00000101 перше, 00000110 решта,
;   00000111 за-умовою, 00001000 функція, 00001001 визначити,
;   00001100 додати.
; Без equal?/assoc/=/рядків: вони поки не мають механізму СЕНС.
;
; Носій відповіді тут — список бітів: 1 = (1), 000 = (0 0 0), межа = ().
; Власник затвердив цей носій 2026-09-26 (#1257 закрито рішенням). Він має дві
; властивості: кожен біт — окремий токен, тож немає колізії reader-а з
; числами чи з 8-бітними функціями; а межа () — буквально відповідь без
; жодного біта.
;
; Самі закони цього файлу теж відповідають мовою шкали:
; (1) — «так», (0) — «ні».

; ---------------------------------------------------------------------
; 1. Біти й напрям

; 0 ↔ 1; будь-що інше — вичерпання за-умовою (fail-closed).
(0011 л15-переверни-біт
  (0010 (біт)
    (110
      ((101 біт 1) (1) 0)
      ((101 біт 0) (1) 1))))

; Найсильніша відповідь того самого напряму: (1), (0) або ().
; Це рівно бінарні значення Core1–3 плюс межа.
(0011 л15-напрям
  (0010 (в)
    (110
      ((010 в) () '())
      ((010 в) (0) (111 (100 в) '())))))

; ---------------------------------------------------------------------
; 2. Два чинні закони #1391, записані структурно

; NOT = інвертувати кожен біт, ширина та сама.
; () — нерухома точка «задарма»: інвертувати нічого.
(0011 л15-не
  (0010 (в)
    (110
      ((010 в) () '())
      ((010 в) (0)
       (111 (л15-переверни-біт (100 в))
                 (л15-не (011 в)))))))

(0011 л15-ширина
  (0010 (в)
    (110
      ((010 в) () 0)
      ((010 в) (0)
       (01010 1 (л15-ширина (011 в)))))))

; Послаблення = дописати той самий біт: (сполучити (перше в) в).
; Восьмий біт належить простору 256 функцій, тож тут шкала сходиться в ().
(0011 л15-послабити
  (0010 (в)
    (110
      ((010 в) () '())
      ((010 в) (0)
       (л15-без-восьмого (111 (100 в) в))))))

(0011 л15-без-восьмого
  (0010 (в)
    (110
      ((101 (л15-ширина в) 8) (1) '())
      ((101 (л15-ширина в) 8) (0) в))))

; ---------------------------------------------------------------------
; 3. AND/OR (затверджено 2026-09-26: мінімум і максимум на лінії істинності)

; Коротша/довша з двох відповідей одного напряму — без чисел,
; одночасним кроком по обох списках.
(0011 л15-коротша
  (0010 (a b) (л15-коротша-крок a b a b)))
(0011 л15-коротша-крок
  (0010 (x y a b)
    (110
      ((010 x) () a)
      ((010 y) () b)
      ((010 y) (0)
       (л15-коротша-крок (011 x) (011 y) a b)))))

(0011 л15-довша
  (0010 (a b) (л15-довша-крок a b a b)))
(0011 л15-довша-крок
  (0010 (x y a b)
    (110
      ((010 x) () b)
      ((010 y) () a)
      ((010 y) (0)
       (л15-довша-крок (011 x) (011 y) a b)))))

; AND: «ні» перемагає; з двох «ні» — сильніше (коротше);
; з двох «так» — слабше (довше); межа поглинає «так».
; Диспетчеризація йде власними відповідями шкали (0) () (1).
(0011 л15-і
  (0010 (a b)
    (110
      ((л15-напрям a) (0)
       (110
         ((л15-напрям b) (0) (л15-коротша a b))
         ((л15-напрям b) () a)
         ((л15-напрям b) (1) a)))
      ((л15-напрям a) ()
       (110
         ((л15-напрям b) (0) b)
         ((л15-напрям b) () '())
         ((л15-напрям b) (1) '())))
      ((л15-напрям a) (1)
       (110
         ((л15-напрям b) (0) b)
         ((л15-напрям b) () '())
         ((л15-напрям b) (1) (л15-довша a b)))))))

; OR не пишеться окремо: це дуал AND через NOT (де Морган).
(0011 л15-або
  (0010 (a b) (л15-не (л15-і (л15-не a) (л15-не b)))))

; a ≤ b  ⇔  a ∧ b = a
(0011 л15-не-вище?
  (0010 (a b) (л15-рівні? (л15-і a b) a)))

; ---------------------------------------------------------------------
; 4. Інструменти перевірки (власні, без equal?)

; Структурна рівність дерев; відповідає (1) або (0).
(0011 л15-рівні?
  (0010 (a b)
    (110
      ((010 a) ()
       (110
         ((010 b) () '(1))
         ((010 b) (1) '(0))
         ((010 b) (0) '(0))))
      ((010 a) (1)
       (110
         ((010 b) () '(0))
         ((010 b) (0) '(0))
         ((010 b) (1)
          (110
            ((101 a b) (1) '(1))
            ((101 a b) (0) '(0))))))
      ((010 a) (0)
       (110
         ((010 b) () '(0))
         ((010 b) (1) '(0))
         ((010 b) (0)
          (110
            ((л15-рівні? (100 a) (100 b)) (1)
             (л15-рівні? (011 a) (011 b)))
            ((л15-рівні? (100 a) (100 b)) (0) '(0)))))))))

(0011 л15-список (0010 речі речі))
(0011 л15-друге (0010 (п) (100 (011 п))))
(0011 л15-третє (0010 (п) (100 (011 (011 п)))))

(0011 л15-зчепити
  (0010 (xs ys)
    (110
      ((010 xs) () ys)
      ((010 xs) (0)
       (111 (100 xs) (л15-зчепити (011 xs) ys))))))

(0011 л15-кожному
  (0010 (f xs)
    (110
      ((010 xs) () '())
      ((010 xs) (0)
       (111 (f (100 xs)) (л15-кожному f (011 xs)))))))

(0011 л15-сплющити
  (0010 (xss)
    (110
      ((010 xss) () '())
      ((010 xss) (0)
       (л15-зчепити (100 xss) (л15-сплющити (011 xss)))))))

; Усі пари / трійки значень.
(0011 л15-пари
  (0010 (xs)
    (л15-сплющити
      (л15-кожному
        (0010 (x) (л15-кожному (0010 (y) (л15-список x y)) xs))
        xs))))

(0011 л15-трійки
  (0010 (xs)
    (л15-сплющити
      (л15-кожному
        (0010 (п) (л15-кожному (0010 (z) (л15-список (100 п) (л15-друге п) z)) xs))
        (л15-пари xs)))))

; Елементи, на яких закон відповів (0), — контрприклади.
(0011 л15-де-хибить
  (0010 (закон xs)
    (110
      ((010 xs) () '())
      ((010 xs) (0)
       (110
         ((закон (100 xs)) (1) (л15-де-хибить закон (011 xs)))
         ((закон (100 xs)) (0)
          (111 (100 xs) (л15-де-хибить закон (011 xs)))))))))

; Елементи, на яких закон відповів (1).
(0011 л15-де-тримає
  (0010 (закон xs)
    (110
      ((010 xs) () '())
      ((010 xs) (0)
       (110
         ((закон (100 xs)) (0) (л15-де-тримає закон (011 xs)))
         ((закон (100 xs)) (1)
          (111 (100 xs) (л15-де-тримає закон (011 xs)))))))))

; ---------------------------------------------------------------------
; 5. Шкала породжується законом послаблення, а не списком вручну

(0011 л15-гілка
  (0010 (в)
    (110
      ((010 в) () '())
      ((010 в) (0)
       (111 в (л15-гілка (л15-послабити в)))))))

(0011 л15-шкала
  (111 '() (л15-зчепити (л15-гілка '(0)) (л15-гілка '(1)))))

; Лінія істинності з контракту: 0 < 00 < … < 0000000 < () < 1111111 < … < 11 < 1.
; Гілка «ні» вже йде за зростанням, гілку «так» треба обернути.
(0011 л15-обернути
  (0010 (xs) (л15-обернути-крок xs '())))
(0011 л15-обернути-крок
  (0010 (xs acc)
    (110
      ((010 xs) () acc)
      ((010 xs) (0)
       (л15-обернути-крок (011 xs) (111 (100 xs) acc))))))

(0011 л15-лінія
  (л15-зчепити (л15-гілка '(0))
               (111 '() (л15-обернути (л15-гілка '(1))))))

; Котра з двох відповідей трапляється на лінії раніше.
(0011 л15-раніша
  (0010 (лінія a b)
    (110
      ((л15-рівні? (100 лінія) a) (1) a)
      ((л15-рівні? (100 лінія) a) (0)
       (110
         ((л15-рівні? (100 лінія) b) (1) b)
         ((л15-рівні? (100 лінія) b) (0)
          (л15-раніша (011 лінія) a b)))))))

(0011 л15-двійкове '((0) (1)))
(0011 л15-k3 '((0) () (1)))

; ---------------------------------------------------------------------
; 6. Спостереження

(0011 л15-спостережено
  (л15-список
    ; скільки станів породжує закон послаблення: 15
    (л15-ширина л15-шкала)
    ; найслабше «ні» ще у шкалі, наступне послаблення — межа
    (л15-послабити '(0 0 0 0 0 0 0))

    ; NOT: інволюція; єдина нерухома точка — ()
    (л15-де-хибить (0010 (a) (л15-рівні? (л15-не (л15-не a)) a)) л15-шкала)
    (л15-де-тримає (0010 (a) (л15-рівні? (л15-не a) a)) л15-шкала)

    ; ґратка: комутативність, ідемпотентність, поглинання
    (л15-де-хибить
      (0010 (п) (л15-рівні? (л15-і (100 п) (л15-друге п))
                                (л15-і (л15-друге п) (100 п))))
      (л15-пари л15-шкала))
    (л15-де-хибить (0010 (a) (л15-рівні? (л15-і a a) a)) л15-шкала)
    (л15-де-хибить
      (0010 (п) (л15-рівні? (л15-і (100 п) (л15-або (100 п) (л15-друге п)))
                                (100 п)))
      (л15-пари л15-шкала))

    ; асоціативність і дистрибутивність — на всіх 3375 трійках
    (л15-де-хибить
      (0010 (п) (л15-рівні? (л15-і (100 п) (л15-і (л15-друге п) (л15-третє п)))
                                (л15-і (л15-і (100 п) (л15-друге п)) (л15-третє п))))
      (л15-трійки л15-шкала))
    (л15-де-хибить
      (0010 (п) (л15-рівні? (л15-і (100 п) (л15-або (л15-друге п) (л15-третє п)))
                                (л15-або (л15-і (100 п) (л15-друге п))
                                         (л15-і (100 п) (л15-третє п)))))
      (л15-трійки л15-шкала))

    ; NOT обертає порядок: a ≤ b ⇒ ¬b ≤ ¬a
    (л15-де-хибить
      (0010 (п)
        (110
          ((л15-не-вище? (100 п) (л15-друге п)) (0) '(1))
          ((л15-не-вище? (100 п) (л15-друге п)) (1)
           (л15-не-вище? (л15-не (л15-друге п)) (л15-не (100 п))))))
      (л15-пари л15-шкала))

    ; закон Кліні: a ∧ ¬a ≤ b ∨ ¬b
    (л15-де-хибить
      (0010 (п) (л15-не-вище? (л15-і (100 п) (л15-не (100 п)))
                                  (л15-або (л15-друге п) (л15-не (л15-друге п)))))
      (л15-пари л15-шкала))

    ; закон контракту: AND — мінімум, OR — максимум на лінії (усі 225 пар)
    (л15-де-хибить
      (0010 (п) (л15-рівні? (л15-і (100 п) (л15-друге п))
                                (л15-раніша л15-лінія (100 п) (л15-друге п))))
      (л15-пари л15-шкала))
    (л15-де-хибить
      (0010 (п) (л15-рівні? (л15-або (100 п) (л15-друге п))
                                (л15-раніша (л15-обернути л15-лінія) (100 п) (л15-друге п))))
      (л15-пари л15-шкала))

    ; виключене третє a ∨ ¬a = 1: де воно тримає?
    (л15-де-тримає (0010 (a) (л15-рівні? (л15-або a (л15-не a)) '(1))) л15-шкала)

    ; послаблення завжди лежить між a та межею: a∧() ≤ послаблене ≤ a∨()
    (л15-де-хибить
      (0010 (a)
        (110
          ((л15-не-вище? (л15-і a '()) (л15-послабити a)) (0) '(0))
          ((л15-не-вище? (л15-і a '()) (л15-послабити a)) (1)
           (л15-не-вище? (л15-послабити a) (л15-або a '())))))
      л15-шкала)

    ; Core1–3: {0, 1} замкнене і дає звичайні булеві таблиці
    (л15-кожному (0010 (п) (л15-і (100 п) (л15-друге п))) (л15-пари л15-двійкове))
    (л15-кожному (0010 (п) (л15-або (100 п) (л15-друге п))) (л15-пари л15-двійкове))
    (л15-кожному л15-не л15-двійкове)

    ; зріз {0, (), 1} дає рівно сильну логіку Кліні K3 (донор #219)
    (л15-кожному (0010 (п) (л15-і (100 п) (л15-друге п))) (л15-пари л15-k3))
    (л15-кожному (0010 (п) (л15-або (100 п) (л15-друге п))) (л15-пари л15-k3))))

(0011 л15-очікувано
  (л15-список
    15
    '()
    '()
    '(())
    '()
    '()
    '()
    '()
    '()
    '()
    '()
    '()
    '()
    '((0) (1))
    '()
    ; AND на {0,1}: 00 01 10 11
    '((0) (0) (0) (1))
    ; OR на {0,1}
    '((0) (1) (1) (1))
    ; NOT на {0,1}
    '((1) (0))
    ; AND K3: рядки 0 () 1 × стовпці 0 () 1
    '((0) (0) (0)  (0) () ()  (0) () (1))
    ; OR K3
    '((0) () (1)  () () (1)  (1) (1) (1))))

(110
  ((л15-рівні? л15-спостережено л15-очікувано) (1)
   '(core4-logic15-algebra-ok))
  ((л15-рівні? л15-спостережено л15-очікувано) (0)
   (л15-список 'core4-logic15-algebra-mismatch л15-очікувано л15-спостережено)))
