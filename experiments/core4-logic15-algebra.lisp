; #1391 — виконуваний свідок затверджених законів Core4 (контракт
; contracts/core4-predicate-answer-scale.lisp, схема /3, 2026-09-26).
; Спершу це було дослідження; власник затвердив AND/OR/COND і носій
; «список бітів». Runtime atom?/eq? на ці закони переходять окремим PR.
;
; Питання: якщо 15 відповідей лежать на одній лінії істинності
;
;   0 < 00 < … < 0000000 < () < 1111111 < … < 11 < 1
;
; а NOT — чинний закон «інвертувати біти, зберегти ширину», то чи
; дають «ні перемагає / так слабшає» (AND) та його дуальний OR
; чесну алгебру? І чи вкладається в неї бінарна логіка Core1–3 {0, 1}
; без суперечності?
;
; Донори (#1393): research/219-multi-logic-candidates (корпус E0–E6,
; таблиці K3), research/223-many-valued-logic (Belnap FOUR: два окремі
; порядки — істини та інформації), research/432-car-cdr-bounded-basis
; (вичерпна перевірка замість віри).
;
; Чистий СЕНС: лише функції з допущеним механізмом —
;   00000001 як-є (через '), 00000010 атом?, 00000011 тотожне?,
;   00000100 сполучити, 00000101 перше, 00000110 решта,
;   00000111 за-умовою, 00001000 функція, 00001001 визначити,
;   00001100 додати.
; Без equal?/assoc/=/рядків: вони поки не мають механізму СЕНС.
;
; Носій відповіді тут — список бітів: 1 = (1), 000 = (0 0 0), межа = ().
; Власник затвердив цей носій 2026-09-26 (#1257 закрито рішенням). Він має дві
; властивості: кожен біт — окремий токен, тож немає колізії reader-а з
; числами чи з 8-бітними функціями; а межа () — буквально відповідь без
; жодного біта.
;
; Самі закони цього файлу теж відповідають мовою шкали:
; (1) — «так», (0) — «ні».

; ---------------------------------------------------------------------
; 1. Біти й напрям

; 0 ↔ 1; будь-що інше — вичерпання за-умовою (fail-closed).
(визначити л15-переверни-біт
  (функція (біт)
    (за-умовою
      ((тотожне? біт 1) (1) 0)
      ((тотожне? біт 0) (1) 1))))

; Найсильніша відповідь того самого напряму: (1), (0) або ().
; Це рівно бінарні значення Core1–3 плюс межа.
(визначити л15-напрям
  (функція (в)
    (за-умовою
      ((атом? в) () '())
      ((атом? в) (0) (сполучити (перше в) '())))))

; ---------------------------------------------------------------------
; 2. Два чинні закони #1391, записані структурно

; NOT = інвертувати кожен біт, ширина та сама.
; () — нерухома точка «задарма»: інвертувати нічого.
(визначити л15-не
  (функція (в)
    (за-умовою
      ((атом? в) () '())
      ((атом? в) (0)
       (сполучити (л15-переверни-біт (перше в))
                 (л15-не (решта в)))))))

(визначити л15-ширина
  (функція (в)
    (за-умовою
      ((атом? в) () 0)
      ((атом? в) (0)
       (додати 1 (л15-ширина (решта в)))))))

; Послаблення = дописати той самий біт: (сполучити (перше в) в).
; Восьмий біт належить простору 256 функцій, тож тут шкала сходиться в ().
(визначити л15-послабити
  (функція (в)
    (за-умовою
      ((атом? в) () '())
      ((атом? в) (0)
       (л15-без-восьмого (сполучити (перше в) в))))))

(визначити л15-без-восьмого
  (функція (в)
    (за-умовою
      ((тотожне? (л15-ширина в) 8) (1) '())
      ((тотожне? (л15-ширина в) 8) (0) в))))

; ---------------------------------------------------------------------
; 3. AND/OR (затверджено 2026-09-26: мінімум і максимум на лінії істинності)

; Коротша/довша з двох відповідей одного напряму — без чисел,
; одночасним кроком по обох списках.
(визначити л15-коротша
  (функція (лівий-аргумент правий-аргумент) (л15-коротша-крок лівий-аргумент правий-аргумент лівий-аргумент правий-аргумент)))
(визначити л15-коротша-крок
  (функція (елемент інший-елемент лівий-аргумент правий-аргумент)
    (за-умовою
      ((атом? елемент) () лівий-аргумент)
      ((атом? інший-елемент) () правий-аргумент)
      ((атом? інший-елемент) (0)
       (л15-коротша-крок (решта елемент) (решта інший-елемент) лівий-аргумент правий-аргумент)))))

(визначити л15-довша
  (функція (лівий-аргумент правий-аргумент) (л15-довша-крок лівий-аргумент правий-аргумент лівий-аргумент правий-аргумент)))
(визначити л15-довша-крок
  (функція (елемент інший-елемент лівий-аргумент правий-аргумент)
    (за-умовою
      ((атом? елемент) () правий-аргумент)
      ((атом? інший-елемент) () лівий-аргумент)
      ((атом? інший-елемент) (0)
       (л15-довша-крок (решта елемент) (решта інший-елемент) лівий-аргумент правий-аргумент)))))

; AND: «ні» перемагає; з двох «ні» — сильніше (коротше);
; з двох «так» — слабше (довше); межа поглинає «так».
; Диспетчеризація йде власними відповідями шкали (0) () (1).
(визначити л15-і
  (функція (лівий-аргумент правий-аргумент)
    (за-умовою
      ((л15-напрям лівий-аргумент) (0)
       (за-умовою
         ((л15-напрям правий-аргумент) (0) (л15-коротша лівий-аргумент правий-аргумент))
         ((л15-напрям правий-аргумент) () лівий-аргумент)
         ((л15-напрям правий-аргумент) (1) лівий-аргумент)))
      ((л15-напрям лівий-аргумент) ()
       (за-умовою
         ((л15-напрям правий-аргумент) (0) правий-аргумент)
         ((л15-напрям правий-аргумент) () '())
         ((л15-напрям правий-аргумент) (1) '())))
      ((л15-напрям лівий-аргумент) (1)
       (за-умовою
         ((л15-напрям правий-аргумент) (0) правий-аргумент)
         ((л15-напрям правий-аргумент) () '())
         ((л15-напрям правий-аргумент) (1) (л15-довша лівий-аргумент правий-аргумент)))))))

; OR не пишеться окремо: це дуал AND через NOT (де Морган).
(визначити л15-або
  (функція (лівий-аргумент правий-аргумент) (л15-не (л15-і (л15-не лівий-аргумент) (л15-не правий-аргумент)))))

; a ≤ b  ⇔  a ∧ b = a
(визначити л15-не-вище?
  (функція (лівий-аргумент правий-аргумент) (л15-рівні? (л15-і лівий-аргумент правий-аргумент) лівий-аргумент)))

; ---------------------------------------------------------------------
; 4. Інструменти перевірки (власні, без equal?)

; Структурна рівність дерев; відповідає (1) або (0).
(визначити л15-рівні?
  (функція (лівий-аргумент правий-аргумент)
    (за-умовою
      ((атом? лівий-аргумент) ()
       (за-умовою
         ((атом? правий-аргумент) () '(1))
         ((атом? правий-аргумент) (1) '(0))
         ((атом? правий-аргумент) (0) '(0))))
      ((атом? лівий-аргумент) (1)
       (за-умовою
         ((атом? правий-аргумент) () '(0))
         ((атом? правий-аргумент) (0) '(0))
         ((атом? правий-аргумент) (1)
          (за-умовою
            ((тотожне? лівий-аргумент правий-аргумент) (1) '(1))
            ((тотожне? лівий-аргумент правий-аргумент) (0) '(0))))))
      ((атом? лівий-аргумент) (0)
       (за-умовою
         ((атом? правий-аргумент) () '(0))
         ((атом? правий-аргумент) (1) '(0))
         ((атом? правий-аргумент) (0)
          (за-умовою
            ((л15-рівні? (перше лівий-аргумент) (перше правий-аргумент)) (1)
             (л15-рівні? (решта лівий-аргумент) (решта правий-аргумент)))
            ((л15-рівні? (перше лівий-аргумент) (перше правий-аргумент)) (0) '(0)))))))))

(визначити л15-список (функція речі речі))
(визначити л15-друге (функція (п) (перше (решта п))))
(визначити л15-третє (функція (п) (перше (решта (решта п)))))

(визначити л15-зчепити
  (функція (елементи інші-елементи)
    (за-умовою
      ((атом? елементи) () інші-елементи)
      ((атом? елементи) (0)
       (сполучити (перше елементи) (л15-зчепити (решта елементи) інші-елементи))))))

(визначити л15-кожному
  (функція (дія елементи)
    (за-умовою
      ((атом? елементи) () '())
      ((атом? елементи) (0)
       (сполучити (дія (перше елементи)) (л15-кожному дія (решта елементи)))))))

(визначити л15-сплющити
  (функція (вкладені-списки)
    (за-умовою
      ((атом? вкладені-списки) () '())
      ((атом? вкладені-списки) (0)
       (л15-зчепити (перше вкладені-списки) (л15-сплющити (решта вкладені-списки)))))))

; Усі пари / трійки значень.
(визначити л15-пари
  (функція (елементи)
    (л15-сплющити
      (л15-кожному
        (функція (елемент) (л15-кожному (функція (інший-елемент) (л15-список елемент інший-елемент)) елементи))
        елементи))))

(визначити л15-трійки
  (функція (елементи)
    (л15-сплющити
      (л15-кожному
        (функція (п) (л15-кожному (функція (третій-елемент) (л15-список (перше п) (л15-друге п) третій-елемент)) елементи))
        (л15-пари елементи)))))

; Елементи, на яких закон відповів (0), — контрприклади.
(визначити л15-де-хибить
  (функція (закон елементи)
    (за-умовою
      ((атом? елементи) () '())
      ((атом? елементи) (0)
       (за-умовою
         ((закон (перше елементи)) (1) (л15-де-хибить закон (решта елементи)))
         ((закон (перше елементи)) (0)
          (сполучити (перше елементи) (л15-де-хибить закон (решта елементи)))))))))

; Елементи, на яких закон відповів (1).
(визначити л15-де-тримає
  (функція (закон елементи)
    (за-умовою
      ((атом? елементи) () '())
      ((атом? елементи) (0)
       (за-умовою
         ((закон (перше елементи)) (0) (л15-де-тримає закон (решта елементи)))
         ((закон (перше елементи)) (1)
          (сполучити (перше елементи) (л15-де-тримає закон (решта елементи)))))))))

; ---------------------------------------------------------------------
; 5. Шкала породжується законом послаблення, а не списком вручну

(визначити л15-гілка
  (функція (в)
    (за-умовою
      ((атом? в) () '())
      ((атом? в) (0)
       (сполучити в (л15-гілка (л15-послабити в)))))))

(визначити л15-шкала
  (сполучити '() (л15-зчепити (л15-гілка '(0)) (л15-гілка '(1)))))

; Лінія істинності з контракту: 0 < 00 < … < 0000000 < () < 1111111 < … < 11 < 1.
; Гілка «ні» вже йде за зростанням, гілку «так» треба обернути.
(визначити л15-обернути
  (функція (елементи) (л15-обернути-крок елементи '())))
(визначити л15-обернути-крок
  (функція (елементи накопичувач)
    (за-умовою
      ((атом? елементи) () накопичувач)
      ((атом? елементи) (0)
       (л15-обернути-крок (решта елементи) (сполучити (перше елементи) накопичувач))))))

(визначити л15-лінія
  (л15-зчепити (л15-гілка '(0))
               (сполучити '() (л15-обернути (л15-гілка '(1))))))

; Котра з двох відповідей трапляється на лінії раніше.
(визначити л15-раніша
  (функція (лінія лівий-аргумент правий-аргумент)
    (за-умовою
      ((л15-рівні? (перше лінія) лівий-аргумент) (1) лівий-аргумент)
      ((л15-рівні? (перше лінія) лівий-аргумент) (0)
       (за-умовою
         ((л15-рівні? (перше лінія) правий-аргумент) (1) правий-аргумент)
         ((л15-рівні? (перше лінія) правий-аргумент) (0)
          (л15-раніша (решта лінія) лівий-аргумент правий-аргумент)))))))

(визначити л15-двійкове '((0) (1)))
(визначити л15-кліні-три '((0) () (1)))

; ---------------------------------------------------------------------
; 6. Спостереження

(визначити л15-спостережено
  (л15-список
    ; скільки станів породжує закон послаблення: 15
    (л15-ширина л15-шкала)
    ; найслабше «ні» ще у шкалі, наступне послаблення — межа
    (л15-послабити '(0 0 0 0 0 0 0))

    ; NOT: інволюція; єдина нерухома точка — ()
    (л15-де-хибить (функція (лівий-аргумент) (л15-рівні? (л15-не (л15-не лівий-аргумент)) лівий-аргумент)) л15-шкала)
    (л15-де-тримає (функція (лівий-аргумент) (л15-рівні? (л15-не лівий-аргумент) лівий-аргумент)) л15-шкала)

    ; ґратка: комутативність, ідемпотентність, поглинання
    (л15-де-хибить
      (функція (п) (л15-рівні? (л15-і (перше п) (л15-друге п))
                                (л15-і (л15-друге п) (перше п))))
      (л15-пари л15-шкала))
    (л15-де-хибить (функція (лівий-аргумент) (л15-рівні? (л15-і лівий-аргумент лівий-аргумент) лівий-аргумент)) л15-шкала)
    (л15-де-хибить
      (функція (п) (л15-рівні? (л15-і (перше п) (л15-або (перше п) (л15-друге п)))
                                (перше п)))
      (л15-пари л15-шкала))

    ; асоціативність і дистрибутивність — на всіх 3375 трійках
    (л15-де-хибить
      (функція (п) (л15-рівні? (л15-і (перше п) (л15-і (л15-друге п) (л15-третє п)))
                                (л15-і (л15-і (перше п) (л15-друге п)) (л15-третє п))))
      (л15-трійки л15-шкала))
    (л15-де-хибить
      (функція (п) (л15-рівні? (л15-і (перше п) (л15-або (л15-друге п) (л15-третє п)))
                                (л15-або (л15-і (перше п) (л15-друге п))
                                         (л15-і (перше п) (л15-третє п)))))
      (л15-трійки л15-шкала))

    ; NOT обертає порядок: a ≤ b ⇒ ¬b ≤ ¬a
    (л15-де-хибить
      (функція (п)
        (за-умовою
          ((л15-не-вище? (перше п) (л15-друге п)) (0) '(1))
          ((л15-не-вище? (перше п) (л15-друге п)) (1)
           (л15-не-вище? (л15-не (л15-друге п)) (л15-не (перше п))))))
      (л15-пари л15-шкала))

    ; закон Кліні: a ∧ ¬a ≤ b ∨ ¬b
    (л15-де-хибить
      (функція (п) (л15-не-вище? (л15-і (перше п) (л15-не (перше п)))
                                  (л15-або (л15-друге п) (л15-не (л15-друге п)))))
      (л15-пари л15-шкала))

    ; закон контракту: AND — мінімум, OR — максимум на лінії (усі 225 пар)
    (л15-де-хибить
      (функція (п) (л15-рівні? (л15-і (перше п) (л15-друге п))
                                (л15-раніша л15-лінія (перше п) (л15-друге п))))
      (л15-пари л15-шкала))
    (л15-де-хибить
      (функція (п) (л15-рівні? (л15-або (перше п) (л15-друге п))
                                (л15-раніша (л15-обернути л15-лінія) (перше п) (л15-друге п))))
      (л15-пари л15-шкала))

    ; виключене третє a ∨ ¬a = 1: де воно тримає?
    (л15-де-тримає (функція (лівий-аргумент) (л15-рівні? (л15-або лівий-аргумент (л15-не лівий-аргумент)) '(1))) л15-шкала)

    ; послаблення завжди лежить між a та межею: a∧() ≤ послаблене ≤ a∨()
    (л15-де-хибить
      (функція (лівий-аргумент)
        (за-умовою
          ((л15-не-вище? (л15-і лівий-аргумент '()) (л15-послабити лівий-аргумент)) (0) '(0))
          ((л15-не-вище? (л15-і лівий-аргумент '()) (л15-послабити лівий-аргумент)) (1)
           (л15-не-вище? (л15-послабити лівий-аргумент) (л15-або лівий-аргумент '())))))
      л15-шкала)

    ; Core1–3: {0, 1} замкнене і дає звичайні булеві таблиці
    (л15-кожному (функція (п) (л15-і (перше п) (л15-друге п))) (л15-пари л15-двійкове))
    (л15-кожному (функція (п) (л15-або (перше п) (л15-друге п))) (л15-пари л15-двійкове))
    (л15-кожному л15-не л15-двійкове)

    ; зріз {0, (), 1} дає рівно сильну логіку Кліні K3 (донор #219)
    (л15-кожному (функція (п) (л15-і (перше п) (л15-друге п))) (л15-пари л15-кліні-три))
    (л15-кожному (функція (п) (л15-або (перше п) (л15-друге п))) (л15-пари л15-кліні-три))))

(визначити л15-очікувано
  (л15-список
    15
    '()
    '()
    '(())
    '()
    '()
    '()
    '()
    '()
    '()
    '()
    '()
    '()
    '((0) (1))
    '()
    ; AND на {0,1}: 00 01 10 11
    '((0) (0) (0) (1))
    ; OR на {0,1}
    '((0) (1) (1) (1))
    ; NOT на {0,1}
    '((1) (0))
    ; AND K3: рядки 0 () 1 × стовпці 0 () 1
    '((0) (0) (0)  (0) () ()  (0) () (1))
    ; OR K3
    '((0) () (1)  () () (1)  (1) (1) (1))))

(за-умовою
  ((л15-рівні? л15-спостережено л15-очікувано) (1)
   '(core4-logic15-algebra-ok))
  ((л15-рівні? л15-спостережено л15-очікувано) (0)
   (л15-список 'core4-logic15-algebra-mismatch л15-очікувано л15-спостережено)))

; Сумісна назва історичного зрізу K3.
(визначити л15-k3 л15-кліні-три)
