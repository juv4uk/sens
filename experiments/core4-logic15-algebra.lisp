; #1391 — виконуваний свідок затверджених законів Core4 (контракт
; contracts/core4-predicate-answer-scale.lisp, схема /3, 2026-09-26).
; Спершу це було дослідження; власник затвердив AND/OR/COND і носій
; «список бітів». Runtime atom?/eq? на ці закони переходять окремим PR.
;
; Питання: якщо 15 відповідей лежать на одній лінії істинності
;
;   0 < 00 < … < 0000000 < () < 1111111 < … < 11 < 1
;
; а NOT — чинний закон «інвертувати біти, зберегти ширину», то чи
; дають «ні перемагає / так слабшає» (AND) та його дуальний OR
; чесну алгебру? І чи вкладається в неї бінарна логіка Core1–3 {0, 1}
; без суперечності?
;
; Донори (#1393): research/219-multi-logic-candidates (корпус E0–E6,
; таблиці K3), research/223-many-valued-logic (Belnap FOUR: два окремі
; порядки — істини та інформації), research/432-car-cdr-bounded-basis
; (вичерпна перевірка замість віри).
;
; Чистий СЕНС: лише функції з допущеним механізмом —
;   00000001 як-є (через '), 00000010 атом?, 00000011 тотожне?,
;   00000100 сполучити, 00000101 перше, 00000110 решта,
;   00000111 за-умовою, 00001000 функція, 00001001 визначити,
;   00001100 додати.
; Без equal?/assoc/=/рядків: вони поки не мають механізму СЕНС.
;
; Носій відповіді тут — список бітів: 1 = (1), 000 = (0 0 0), межа = ().
; Власник затвердив цей носій 2026-09-26 (#1257 закрито рішенням). Він має дві
; властивості: кожен біт — окремий токен, тож немає колізії reader-а з
; числами чи з 8-бітними функціями; а межа () — буквально відповідь без
; жодного біта.
;
; Самі закони цього файлу теж відповідають мовою шкали:
; (1) — «так», (0) — «ні».

; ---------------------------------------------------------------------
; 1. Біти й напрям

; 0 ↔ 1; будь-що інше — вичерпання за-умовою (fail-closed).
(визначити л15-переверни-біт
  (функція (біт)
    (за-умовою
      ((тотожне? біт 1) (1) 0)
      ((тотожне? біт 0) (1) 1))))

; Найсильніша відповідь того самого напряму: (1), (0) або ().
; Це рівно бінарні значення Core1–3 плюс межа.
(визначити л15-напрям
  (функція (в)
    (за-умовою
      ((атом? в) () '())
      ((атом? в) (0) (сполучити (перше в) '())))))

; ---------------------------------------------------------------------
; 2. Два чинні закони #1391, записані структурно

; NOT = інвертувати кожен біт, ширина та сама.
; () — нерухома точка «задарма»: інвертувати нічого.
(визначити л15-не
  (функція (в)
    (за-умовою
      ((атом? в) () '())
      ((атом? в) (0)
       (сполучити (л15-переверни-біт (перше в))
                 (л15-не (решта в)))))))

(визначити л15-ширина
  (функція (в)
    (за-умовою
      ((атом? в) () 0)
      ((атом? в) (0)
       (01010 1 (л15-ширина (011 в)))))))

; Послаблення = дописати той самий біт: (сполучити (перше в) в).
; Восьмий біт належить простору 256 функцій, тож тут шкала сходиться в ().
(визначити л15-послабити
  (функція (в)
    (за-умовою
      ((атом? в) () '())
      ((атом? в) (0)
       (л15-без-восьмого (сполучити (перше в) в))))))

(визначити л15-без-восьмого
  (функція (в)
    (за-умовою
      ((тотожне? (л15-ширина в) 8) (1) '())
      ((тотожне? (л15-ширина в) 8) (0) в))))

; ---------------------------------------------------------------------
; 3. AND/OR (затверджено 2026-09-26: мінімум і максимум на лінії істинності)

; Коротша/довша з двох відповідей одного напряму — без чисел,
; одночасним кроком по обох списках.
(визначити л15-коротша
  (функція (a b) (л15-коротша-крок a b a b)))
(визначити л15-коротша-крок
  (функція (x y a b)
    (за-умовою
      ((атом? x) () a)
      ((атом? y) () b)
      ((атом? y) (0)
       (л15-коротша-крок (решта x) (решта y) a b)))))

(визначити л15-довша
  (функція (a b) (л15-довша-крок a b a b)))
(визначити л15-довша-крок
  (функція (x y a b)
    (за-умовою
      ((атом? x) () b)
      ((атом? y) () a)
      ((атом? y) (0)
       (л15-довша-крок (решта x) (решта y) a b)))))

; AND: «ні» перемагає; з двох «ні» — сильніше (коротше);
; з двох «так» — слабше (довше); межа поглинає «так».
; Диспетчеризація йде власними відповідями шкали (0) () (1).
(визначити л15-і
  (функція (a b)
    (за-умовою
      ((л15-напрям a) (0)
       (за-умовою
         ((л15-напрям b) (0) (л15-коротша a b))
         ((л15-напрям b) () a)
         ((л15-напрям b) (1) a)))
      ((л15-напрям a) ()
       (за-умовою
         ((л15-напрям b) (0) b)
         ((л15-напрям b) () '())
         ((л15-напрям b) (1) '())))
      ((л15-напрям a) (1)
       (за-умовою
         ((л15-напрям b) (0) b)
         ((л15-напрям b) () '())
         ((л15-напрям b) (1) (л15-довша a b)))))))

; OR не пишеться окремо: це дуал AND через NOT (де Морган).
(визначити л15-або
  (функція (a b) (л15-не (л15-і (л15-не a) (л15-не b)))))

; a ≤ b  ⇔  a ∧ b = a
(визначити л15-не-вище?
  (функція (a b) (л15-рівні? (л15-і a b) a)))

; ---------------------------------------------------------------------
; 4. Інструменти перевірки (власні, без equal?)

; Структурна рівність дерев; відповідає (1) або (0).
(визначити л15-рівні?
  (функція (a b)
    (за-умовою
      ((атом? a) ()
       (за-умовою
         ((атом? b) () '(1))
         ((атом? b) (1) '(0))
         ((атом? b) (0) '(0))))
      ((атом? a) (1)
       (за-умовою
         ((атом? b) () '(0))
         ((атом? b) (0) '(0))
         ((атом? b) (1)
          (за-умовою
            ((тотожне? a b) (1) '(1))
            ((тотожне? a b) (0) '(0))))))
      ((атом? a) (0)
       (за-умовою
         ((атом? b) () '(0))
         ((атом? b) (1) '(0))
         ((атом? b) (0)
          (за-умовою
            ((л15-рівні? (перше a) (перше b)) (1)
             (л15-рівні? (решта a) (решта b)))
            ((л15-рівні? (перше a) (перше b)) (0) '(0)))))))))

(визначити л15-список (функція речі речі))
(визначити л15-друге (функція (п) (перше (решта п))))
(визначити л15-третє (функція (п) (перше (решта (решта п)))))

(визначити л15-зчепити
  (функція (xs ys)
    (за-умовою
      ((атом? xs) () ys)
      ((атом? xs) (0)
       (сполучити (перше xs) (л15-зчепити (решта xs) ys))))))

(визначити л15-кожному
  (функція (f xs)
    (за-умовою
      ((атом? xs) () '())
      ((атом? xs) (0)
       (сполучити (f (перше xs)) (л15-кожному f (решта xs)))))))

(визначити л15-сплющити
  (функція (xss)
    (за-умовою
      ((атом? xss) () '())
      ((атом? xss) (0)
       (л15-зчепити (перше xss) (л15-сплющити (решта xss)))))))

; Усі пари / трійки значень.
(визначити л15-пари
  (функція (xs)
    (л15-сплющити
      (л15-кожному
        (функція (x) (л15-кожному (функція (y) (л15-список x y)) xs))
        xs))))

(визначити л15-трійки
  (функція (xs)
    (л15-сплющити
      (л15-кожному
        (функція (п) (л15-кожному (функція (z) (л15-список (перше п) (л15-друге п) z)) xs))
        (л15-пари xs)))))

; Елементи, на яких закон відповів (0), — контрприклади.
(визначити л15-де-хибить
  (функція (закон xs)
    (за-умовою
      ((атом? xs) () '())
      ((атом? xs) (0)
       (за-умовою
         ((закон (перше xs)) (1) (л15-де-хибить закон (решта xs)))
         ((закон (перше xs)) (0)
          (сполучити (перше xs) (л15-де-хибить закон (решта xs)))))))))

; Елементи, на яких закон відповів (1).
(визначити л15-де-тримає
  (функція (закон xs)
    (за-умовою
      ((атом? xs) () '())
      ((атом? xs) (0)
       (за-умовою
         ((закон (перше xs)) (0) (л15-де-тримає закон (решта xs)))
         ((закон (перше xs)) (1)
          (сполучити (перше xs) (л15-де-тримає закон (решта xs)))))))))

; ---------------------------------------------------------------------
; 5. Шкала породжується законом послаблення, а не списком вручну

(визначити л15-гілка
  (функція (в)
    (за-умовою
      ((атом? в) () '())
      ((атом? в) (0)
       (сполучити в (л15-гілка (л15-послабити в)))))))

(визначити л15-шкала
  (сполучити '() (л15-зчепити (л15-гілка '(0)) (л15-гілка '(1)))))

; Лінія істинності з контракту: 0 < 00 < … < 0000000 < () < 1111111 < … < 11 < 1.
; Гілка «ні» вже йде за зростанням, гілку «так» треба обернути.
(визначити л15-обернути
  (функція (xs) (л15-обернути-крок xs '())))
(визначити л15-обернути-крок
  (функція (xs acc)
    (за-умовою
      ((атом? xs) () acc)
      ((атом? xs) (0)
       (л15-обернути-крок (решта xs) (сполучити (перше xs) acc))))))

(визначити л15-лінія
  (л15-зчепити (л15-гілка '(0))
               (сполучити '() (л15-обернути (л15-гілка '(1))))))

; Котра з двох відповідей трапляється на лінії раніше.
(визначити л15-раніша
  (функція (лінія a b)
    (за-умовою
      ((л15-рівні? (перше лінія) a) (1) a)
      ((л15-рівні? (перше лінія) a) (0)
       (за-умовою
         ((л15-рівні? (перше лінія) b) (1) b)
         ((л15-рівні? (перше лінія) b) (0)
          (л15-раніша (решта лінія) a b)))))))

(визначити л15-двійкове '((0) (1)))
(визначити л15-k3 '((0) () (1)))

; ---------------------------------------------------------------------
; 6. Спостереження

(визначити л15-спостережено
  (л15-список
    ; скільки станів породжує закон послаблення: 15
    (л15-ширина л15-шкала)
    ; найслабше «ні» ще у шкалі, наступне послаблення — межа
    (л15-послабити '(0 0 0 0 0 0 0))

    ; NOT: інволюція; єдина нерухома точка — ()
    (л15-де-хибить (функція (a) (л15-рівні? (л15-не (л15-не a)) a)) л15-шкала)
    (л15-де-тримає (функція (a) (л15-рівні? (л15-не a) a)) л15-шкала)

    ; ґратка: комутативність, ідемпотентність, поглинання
    (л15-де-хибить
      (функція (п) (л15-рівні? (л15-і (перше п) (л15-друге п))
                                (л15-і (л15-друге п) (перше п))))
      (л15-пари л15-шкала))
    (л15-де-хибить (функція (a) (л15-рівні? (л15-і a a) a)) л15-шкала)
    (л15-де-хибить
      (функція (п) (л15-рівні? (л15-і (перше п) (л15-або (перше п) (л15-друге п)))
                                (перше п)))
      (л15-пари л15-шкала))

    ; асоціативність і дистрибутивність — на всіх 3375 трійках
    (л15-де-хибить
      (функція (п) (л15-рівні? (л15-і (перше п) (л15-і (л15-друге п) (л15-третє п)))
                                (л15-і (л15-і (перше п) (л15-друге п)) (л15-третє п))))
      (л15-трійки л15-шкала))
    (л15-де-хибить
      (функція (п) (л15-рівні? (л15-і (перше п) (л15-або (л15-друге п) (л15-третє п)))
                                (л15-або (л15-і (перше п) (л15-друге п))
                                         (л15-і (перше п) (л15-третє п)))))
      (л15-трійки л15-шкала))

    ; NOT обертає порядок: a ≤ b ⇒ ¬b ≤ ¬a
    (л15-де-хибить
      (функція (п)
        (за-умовою
          ((л15-не-вище? (перше п) (л15-друге п)) (0) '(1))
          ((л15-не-вище? (перше п) (л15-друге п)) (1)
           (л15-не-вище? (л15-не (л15-друге п)) (л15-не (перше п))))))
      (л15-пари л15-шкала))

    ; закон Кліні: a ∧ ¬a ≤ b ∨ ¬b
    (л15-де-хибить
      (функція (п) (л15-не-вище? (л15-і (перше п) (л15-не (перше п)))
                                  (л15-або (л15-друге п) (л15-не (л15-друге п)))))
      (л15-пари л15-шкала))

    ; закон контракту: AND — мінімум, OR — максимум на лінії (усі 225 пар)
    (л15-де-хибить
      (функція (п) (л15-рівні? (л15-і (перше п) (л15-друге п))
                                (л15-раніша л15-лінія (перше п) (л15-друге п))))
      (л15-пари л15-шкала))
    (л15-де-хибить
      (функція (п) (л15-рівні? (л15-або (перше п) (л15-друге п))
                                (л15-раніша (л15-обернути л15-лінія) (перше п) (л15-друге п))))
      (л15-пари л15-шкала))

    ; виключене третє a ∨ ¬a = 1: де воно тримає?
    (л15-де-тримає (функція (a) (л15-рівні? (л15-або a (л15-не a)) '(1))) л15-шкала)

    ; послаблення завжди лежить між a та межею: a∧() ≤ послаблене ≤ a∨()
    (л15-де-хибить
      (функція (a)
        (за-умовою
          ((л15-не-вище? (л15-і a '()) (л15-послабити a)) (0) '(0))
          ((л15-не-вище? (л15-і a '()) (л15-послабити a)) (1)
           (л15-не-вище? (л15-послабити a) (л15-або a '())))))
      л15-шкала)

    ; Core1–3: {0, 1} замкнене і дає звичайні булеві таблиці
    (л15-кожному (функція (п) (л15-і (перше п) (л15-друге п))) (л15-пари л15-двійкове))
    (л15-кожному (функція (п) (л15-або (перше п) (л15-друге п))) (л15-пари л15-двійкове))
    (л15-кожному л15-не л15-двійкове)

    ; зріз {0, (), 1} дає рівно сильну логіку Кліні K3 (донор #219)
    (л15-кожному (функція (п) (л15-і (перше п) (л15-друге п))) (л15-пари л15-k3))
    (л15-кожному (функція (п) (л15-або (перше п) (л15-друге п))) (л15-пари л15-k3))))

(визначити л15-очікувано
  (л15-список
    15
    '()
    '()
    '(())
    '()
    '()
    '()
    '()
    '()
    '()
    '()
    '()
    '()
    '((0) (1))
    '()
    ; AND на {0,1}: 00 01 10 11
    '((0) (0) (0) (1))
    ; OR на {0,1}
    '((0) (1) (1) (1))
    ; NOT на {0,1}
    '((1) (0))
    ; AND K3: рядки 0 () 1 × стовпці 0 () 1
    '((0) (0) (0)  (0) () ()  (0) () (1))
    ; OR K3
    '((0) () (1)  () () (1)  (1) (1) (1))))

(за-умовою
  ((л15-рівні? л15-спостережено л15-очікувано) (1)
   '(core4-logic15-algebra-ok))
  ((л15-рівні? л15-спостережено л15-очікувано) (0)
   (л15-список 'core4-logic15-algebra-mismatch л15-очікувано л15-спостережено)))
