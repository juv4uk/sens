; Перевірка SENS-спискової моделі Core1, не історичного ARRAY.
; Донор mccarthy-eval має змінні глобальні LIST-масиви: його OOB STORE
; не змінює комірку й повертає записане значення. Тут перевіряється
; власний контракт спискового значення: вихід за межі є явною помилкою.
(список
  (масив? (як-є ()))
  (масив? (як-є (1)))
  (масив? (як-є (1 2)))
  (масив? 0)
  (масив 0)
  (значення-масиву-за-індексом (як-є (10 20 30)) 0)
  (змінити-елемент-масиву (як-є (10 20 30)) 2 99)
  (помилка? (значення-масиву-за-індексом (як-є (10 20)) -1))
  (помилка? (значення-масиву-за-індексом (як-є (10 20)) 2))
  (тотожне?
    (помилка? (змінити-елемент-масиву (як-є (10 20)) 2 99))
    так))
