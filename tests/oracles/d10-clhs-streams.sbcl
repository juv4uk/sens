;;;; Незалежний дослідний оракул потоків ANSI Common Lisp / SBCL.
;;;; Це не програма СЕНС, не джерело кодів Д10 і не ратифікація семантики.
;;;; Власні функції, змінні й діагностика — українською.
;;;; Стандартні форми Common Lisp, контрольні значення й протокольні маркери збережено.
(in-package :cl-user)

(defvar *д10-вхідний-потік* nil)

(defun перевірити-рівність (фактичне очікуване назва)
  (unless (equal фактичне очікуване)
    (error "D10 STREAMS ORACLE BLOCK ~A: отримано=~S очікувано=~S"
           назва фактичне очікуване)))

(defun засвідчити-потік-псевдонім ()
  (let* ((*д10-вхідний-потік* (make-string-input-stream "a"))
         (псевдонім (make-synonym-stream '*д10-вхідний-потік*)))
    (unwind-protect
         (progn
           (перевірити-рівність (read-char псевдонім nil :eof) #\a
                               "перше динамічне зв'язування")
           (let ((*д10-вхідний-потік* (make-string-input-stream "b")))
             (unwind-protect
                  (перевірити-рівність (read-char псевдонім nil :eof) #\b
                                      "переприв'язування потоку")
               (close *д10-вхідний-потік*)))
           (перевірити-рівність (read-char псевдонім nil :eof) :eof
                               "початковий потік уже вичерпано"))
      (close псевдонім)
      (close *д10-вхідний-потік*)))
  (format t "PASS DYNAMIC-SYNONYM-STREAM-TARGET~%"))

(defun засвідчити-спорожнення-виводу ()
  (let ((буфер (make-string-output-stream)))
    (unwind-protect
         (progn
           (write-string "ab" буфер)
           (перевірити-рівність (get-output-stream-string буфер) "ab"
                               "перше спорожнення")
           (перевірити-рівність (get-output-stream-string буфер) ""
                               "друге спорожнення")
           (write-string "c" буфер)
           (перевірити-рівність (get-output-stream-string буфер) "c"
                               "спорожнення після запису")
           (format t "PASS DRAIN-STRING-OUTPUT-STREAM~%"))
      (close буфер))))

(defun засвідчити-об'єднаний-потік ()
  (let ((перший (make-string-input-stream "ab"))
        (другий (make-string-input-stream "cd")))
    (let ((потік (make-concatenated-stream перший другий)))
      (unwind-protect
           (progn
             (перевірити-рівність
               (loop repeat 4 collect (read-char потік nil :eof))
               (list #\a #\b #\c #\d)
               "чотири послідовні читання")
             (перевірити-рівність (read-char потік nil :eof) :eof
                                 "кінець після обох потоків"))
        (close потік)
        (close перший)
        (close другий))))
  (let ((перший (make-string-input-stream ""))
        (другий (make-string-input-stream "x")))
    (let ((потік (make-concatenated-stream перший другий)))
      (unwind-protect
           (progn
             (перевірити-рівність (read-char потік nil :eof) #\x
                                 "порожній перший потік пропускаємо")
             (перевірити-рівність (read-char потік nil :eof) :eof
                                 "справжній кінець потоку"))
        (close потік)
        (close перший)
        (close другий))))
  (format t "PASS ORDERED-CONCATENATED-INPUT~%"))

(format t "SBCL-ORACLE: ~A~%" (lisp-implementation-version))
(засвідчити-потік-псевдонім)
(засвідчити-спорожнення-виводу)
(засвідчити-об'єднаний-потік)
(format t "D10-CLHS-STREAMS-DONOR: PASS 3/3~%")
