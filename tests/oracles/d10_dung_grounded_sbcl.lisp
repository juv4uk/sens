;;;; Д10: незалежний дослідницький оракул обґрунтованої семантики Данґа (1995).
;;;; (role research-only)
;;;; (semantic-authority-change none)
;;;; Найменшу нерухому точку характеристичної функції перевіряємо у SBCL,
;;;; незалежно від синхронних хвиль прийняття й відхилення моделі Python.

(defpackage :d10-dung-oracle (:use :cl))
(in-package :d10-dung-oracle)

(defvar *перевірок* 0)
(defvar *перевірених-графів* 0)

(defun перевірити (назва фактичне очікуване)
  (unless (equal фактичне очікуване)
    (error "~A: очікувалося ~S; отримано ~S" назва очікуване фактичне))
  (incf *перевірок*))

(defun точний-список-вершин? (вершини)
  (and (listp вершини)
       (every (lambda (вершина)
                (and (symbolp вершина) вершина))
              вершини)
       (= (length вершини)
          (length (remove-duplicates вершини :test #'eq)))))

(defun правильний-граф? (вершини дуги)
  (and (точний-список-вершин? вершини)
       (listp дуги)
       (every (lambda (дуга)
                (and (listp дуга)
                     (= (length дуга) 2)
                     (member (first дуга) вершини :test #'eq)
                     (member (second дуга) вершини :test #'eq)))
              дуги)
       (= (length дуги)
          (length (remove-duplicates дуги :test #'equal)))))

(defun атакує? (нападник ціль дуги)
  (member (list нападник ціль) дуги :test #'equal))

(defun захищено? (аргумент прийняті вершини дуги)
  (every (lambda (нападник)
           (or (not (атакує? нападник аргумент дуги))
               (some (lambda (захисник)
                       (атакує? захисник нападник дуги))
                     прийняті)))
         вершини))

(defun характеристична-функція (прийняті вершини дуги)
  (remove-if-not (lambda (вершина)
                   (захищено? вершина прийняті вершини дуги))
                 вершини))

(defun обґрунтоване-розширення (вершини дуги)
  (unless (правильний-граф? вершини дуги)
    (error "Скінченний граф атак: повторена або недопустима вершина чи дуга"))
  (let ((прийняті nil))
    (loop for крок from 0 to (1+ (length вершини)) do
      (let ((наступні (характеристична-функція прийняті вершини дуги)))
        (when (equal наступні прийняті)
          (return))
        (when (= крок (1+ (length вершини)))
          (error "Не досягнуто скінченної нерухомої точки"))
        (setf прийняті наступні)))
    (let ((відхилені
            (remove-if-not
              (lambda (вершина)
                (some (lambda (нападник)
                        (атакує? нападник вершина дуги))
                      прийняті))
              вершини)))
      ;; Ключі результату є незмінними ідентичностями зовнішнього протоколу.
      (list :in прийняті
            :out відхилені
            :undec (remove-if
                     (lambda (вершина)
                       (or (member вершина прийняті :test #'eq)
                           (member вершина відхилені :test #'eq)))
                     вершини)))))

(defun відхилено-вхід? (вершини дуги)
  (handler-case
      (progn (обґрунтоване-розширення вершини дуги) nil)
    (error () t)))

(defun усі-дуги-за-маскою (вершини код)
  (let ((лічильник -1))
    (loop for нападник in вершини nconc
      (loop for ціль in вершини
            for розряд = (incf лічильник)
            when (logbitp розряд код)
              collect (list нападник ціль)))))

(defun перевірити-інваріанти (відповідь вершини дуги)
  (let* ((прийняті (getf відповідь :in))
         (відхилені (getf відповідь :out))
         (невизначені (getf відповідь :undec)))
    (unless (and (= (length (append прийняті відхилені невизначені))
                    (length вершини))
                 (null (intersection прийняті відхилені))
                 (null (intersection прийняті невизначені))
                 (null (intersection відхилені невизначені))
                 (equal прийняті
                        (характеристична-функція прийняті вершини дуги))
                 (every (lambda (вершина)
                          (some (lambda (нападник)
                                  (атакує? нападник вершина дуги))
                                прийняті))
                        відхилені)
                 (every (lambda (вершина)
                          (not (member вершина відхилені)))
                        невизначені))
      (error "Порушено інваріанти розбиття або нерухомої точки"))))

(defun перевірити-набір ()
  (dolist (рядок
           '(((a) () (:in (a) :out () :undec ()))
             ((a b) ((a b)) (:in (a) :out (b) :undec ()))
             ((a b c) ((a b) (b c)) (:in (a c) :out (b) :undec ()))
             ((a b) ((a b) (b a)) (:in () :out () :undec (a b)))
             ((a) ((a a)) (:in () :out () :undec (a)))
             ((a b c) ((a b) (b c) (c a))
              (:in () :out () :undec (a b c)))
             ((a b c d) ((a b) (b c) (c a) (d a))
              (:in (b d) :out (a c) :undec ()))
             ((x a b) ((a b) (b a))
              (:in (x) :out () :undec (a b)))
             (() () (:in () :out () :undec ()))))
    (перевірити "Початкове свідчення семантики Данґа"
               (обґрунтоване-розширення (first рядок) (second рядок))
               (third рядок)))
  (перевірити "Повтор аргументу відхиляється"
             (відхилено-вхід? '(a a) nil) t)
  (перевірити "Невідома кінцева вершина дуги відхиляється"
             (відхилено-вхід? '(a) '((b a))) t)
  (перевірити "Повтор дуги відхиляється"
             (відхилено-вхід? '(a b) '((a b) (a b))) t)
  (перевірити "Атом замість графа відхиляється"
             (відхилено-вхід? 'a '((a a))) t)
  (перевірити "Самоатака не примушує прийняти аргумент"
             (обґрунтоване-розширення '(a) '((a a)))
             '(:in () :out () :undec (a)))
  (loop for кількість from 0 to 3 do
    (let ((вершини (subseq '(a b c) 0 кількість)))
      (loop for код from 0 below (ash 1 (* кількість кількість)) do
        (let* ((дуги (усі-дуги-за-маскою вершини код))
               (відповідь (обґрунтоване-розширення вершини дуги)))
          (перевірити-інваріанти відповідь вершини дуги)
          (incf *перевірених-графів*)))))
  (unless (= *перевірених-графів* 531)
    (error "Очікувалося 531 скінченний орієнтований граф, отримано ~D"
           *перевірених-графів*))
  ;; Підсумковий рядок збережено для автоматичних споживачів.
  (format t "D10 DUNG independent real SBCL oracle PASS ~D named checks and ~D complete finite graphs~%"
          *перевірок* *перевірених-графів*)
  (finish-output))

(handler-case (перевірити-набір)
  (error (помилка)
    (format *error-output* "D10 DUNG independent SBCL oracle FAIL: ~A~%"
            помилка)
    (sb-ext:exit :code 1)))
