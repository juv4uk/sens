;;;; Д10: незалежна математична модель у справжньому SBCL, лише дослідний оракул.
;;;; (role research-only)
;;;; (semantic-authority-change none)
;;;; Джерела: NIST SP811 §8.5 та BIPM (визначення кельвіна).
;;;; Це НЕ виконувані слова .sens і НЕ оракул власного обчислювача СЕНС.
;;;; Службові слова Common Lisp і зовнішні ключі :point/:delta не перекладаємо.

(defpackage :d10-affine-measure (:use :cl))
(in-package :d10-affine-measure)

(defvar *кількість-перевірок* 0)

(defun перевірити (назва фактичне очікуване)
  (unless (equal фактичне очікуване)
    (error "~A: очікувано ~S, отримано ~S" назва очікуване фактичне))
  (incf *кількість-перевірок*))

(defun відхилено? (дія)
  (handler-case (progn (funcall дія) nil)
    (error () t)))

(defstruct (одиниця (:constructor сира-одиниця (розмірності множник початок)))
  розмірності множник початок)

(defun створити-точну-одиницю (розмірності множник початок)
  (unless (and (listp розмірності) (= (length розмірності) 7)
               (every #'rationalp розмірності)
               (rationalp множник) (> множник 0)
               (rationalp початок))
    (error "Некоректна точна одиниця із сімома розмірностями"))
  (сира-одиниця розмірності множник початок))

(defun перетворити-значення (значення вид звідки куди)
  (unless (and (rationalp значення) (member вид '(:point :delta)))
    (error "Потрібні точне раціональне число й вид POINT або DELTA"))
  (unless (and (одиниця-p звідки) (одиниця-p куди)
               (equal (одиниця-розмірності звідки)
                      (одиниця-розмірності куди)))
    (error "Несумісні розмірності"))
  ;; Незалежно обчислюємо відносні афінні коефіцієнти, а не повторюємо
  ;; двоетапне перетворення через фізичну базову координату в моделі Python.
  (let* ((відносний-множник (/ (одиниця-множник звідки)
                               (одиниця-множник куди)))
         (відносний-початок (if (eq вид :point)
                                (/ (- (одиниця-початок звідки)
                                      (одиниця-початок куди))
                                   (одиниця-множник куди))
                                0)))
    (list (+ (* відносний-множник значення) відносний-початок) вид)))

(defparameter *температура* '(0 0 0 0 1 0 0))
(defparameter *довжина* '(1 0 0 0 0 0 0))
(defparameter *кельвін* (створити-точну-одиницю *температура* 1 0))
(defparameter *цельсій* (створити-точну-одиницю *температура* 1 5463/20)) ; 273,15 K
(defparameter *фаренгейт* (створити-точну-одиницю *температура* 5/9 45967/180))
(defparameter *метр* (створити-точну-одиницю *довжина* 1 0))

(defun набір-перевірок ()
  (перевірити "точка Цельсія → кельвін"
             (перетворити-значення 0 :point *цельсій* *кельвін*)
             '(5463/20 :point))
  (перевірити "різниця Цельсія → кельвін"
             (перетворити-значення 5 :delta *цельсій* *кельвін*)
             '(5 :delta))
  (перевірити "точка Фаренгейта → кельвін"
             (перетворити-значення 32 :point *фаренгейт* *кельвін*)
             '(5463/20 :point))
  (перевірити "різниця Фаренгейта → кельвін"
             (перетворити-значення 9 :delta *фаренгейт* *кельвін*)
             '(5 :delta))
  (перевірити "повернення з кельвіна до Цельсія"
             (перетворити-значення 5463/20 :point *кельвін* *цельсій*)
             '(0 :point))
  (перевірити "температура кипіння у Фаренгейтах"
             (перетворити-значення 100 :point *цельсій* *фаренгейт*)
             '(212 :point))
  (перевірити "різниця 100 °C дорівнює 180 °F"
             (перетворити-значення 100 :delta *цельсій* *фаренгейт*)
             '(180 :delta))
  (перевірити "0 °C не дорівнює 0 K"
             (equal (перетворити-значення 0 :point *цельсій* *кельвін*)
                    '(0 :point))
             nil)
  (перевірити "точне зворотне перетворення точки"
             (перетворити-значення
               (first (перетворити-значення -75/13 :point *фаренгейт* *кельвін*))
               :point *кельвін* *фаренгейт*)
             '(-75/13 :point))
  (перевірити "точне зворотне перетворення різниці"
             (перетворити-значення
               (first (перетворити-значення 17/19 :delta *фаренгейт* *цельсій*))
               :delta *цельсій* *фаренгейт*)
             '(17/19 :delta))
  (перевірити "зсув не впливає на різницю"
             (перетворити-значення 7 :delta *цельсій* *кельвін*)
             '(7 :delta))
  (перевірити "несумісні розмірності відхилено"
             (відхилено? (lambda ()
                           (перетворити-значення 1 :point *цельсій* *метр*)))
             t)
  (перевірити "неточне число відхилено"
             (відхилено? (lambda ()
                           (перетворити-значення 0.5 :point *цельсій* *кельвін*)))
             t)
  (перевірити "нульовий множник відхилено"
             (відхилено? (lambda ()
                           (створити-точну-одиницю *температура* 0 0)))
             t)
  (перевірити "неправильну кількість розмірностей відхилено"
             (відхилено? (lambda ()
                           (створити-точну-одиницю '(1 0) 1 0)))
             t)
  (перевірити "невідомий вид відхилено"
             (відхилено? (lambda ()
                           (перетворити-значення 1 :unknown *цельсій* *кельвін*)))
             t)
  (перевірити "неточний початок відхилено"
             (відхилено? (lambda ()
                           (створити-точну-одиницю *температура* 1 0.1)))
             t)
  (let* ((джерело (створити-точну-одиницю *температура* 4/5 11/13))
         (проміжна (створити-точну-одиницю *температура* 7/9 -3/8))
         (призначення (створити-точну-одиницю *температура* 5/11 2/3)))
    (dolist (вид '(:point :delta))
      (let* ((значення -333/7)
             (проміжне-значення (first
                                  (перетворити-значення значення вид
                                                         джерело проміжна)))
             (через-проміжну (перетворити-значення
                               проміжне-значення вид проміжна призначення))
             (безпосередньо (перетворити-значення
                               значення вид джерело призначення)))
        (перевірити "композиція перетворень одиниць"
                   через-проміжну безпосередньо))))
  ; Незмінний машинний маркер використовується зовнішнім перевіряльником.
  (format t "D10 AFFINE-QUANTITY real SBCL donor oracle PASS ~D checks~%"
          *кількість-перевірок*)
  (finish-output))

(handler-case (набір-перевірок)
  (error (помилка)
    (format *error-output* "D10 AFFINE-QUANTITY SBCL FAIL ~A~%" помилка)
    (sb-ext:exit :code 1)))
