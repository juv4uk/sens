; Мовний закон точного D24+ ділення та остачі для меж UTF-8.
; Всі значення будуються іменованими числами, без цифрових літералів.
; SENS перевіряє вектор чисел; хост не виконує арифметичний оракул.
(за-умовою
  ((однакові?
     (список
       (кодування-юнікод-8-ціла-частка
         кодування-число-нуль
         кодування-число-шістдесят-чотири)
       (кодування-юнікод-8-ціла-частка
         (відняти кодування-число-сто-двадцять-сім
                  кодування-число-шістдесят-чотири)
         кодування-число-шістдесят-чотири)
       (кодування-юнікод-8-ціла-частка
         кодування-число-шістдесят-чотири
         кодування-число-шістдесят-чотири)
       (кодування-юнікод-8-ціла-частка
         (додати кодування-число-шістдесят-чотири
                 кодування-число-один)
         кодування-число-шістдесят-чотири)
       (кодування-юнікод-8-ціла-частка
         кодування-число-двісті-п'ятдесят-п'ять
         кодування-число-шістдесят-чотири)
       (кодування-юнікод-8-ціла-частка
         кодування-число-двісті-п'ятдесят-шість
         кодування-число-шістдесят-чотири)
       (кодування-юнікод-8-ціла-остача
         кодування-число-двісті-п'ятдесят-п'ять
         кодування-число-шістдесят-чотири)
       (кодування-юнікод-8-ціла-остача
         кодування-число-двісті-п'ятдесят-шість
         кодування-число-шістдесят-чотири))
     (список
       кодування-число-нуль
       кодування-число-нуль
       кодування-число-один
       кодування-число-один
       кодування-число-три
       кодування-число-чотири
       (відняти кодування-число-сто-двадцять-сім
                кодування-число-шістдесят-чотири)
       кодування-число-нуль))
   (атом? (як-є ())))
  (так (атом? (як-є (())))))
