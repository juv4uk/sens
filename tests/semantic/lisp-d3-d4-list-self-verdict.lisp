; Нативні закони побудови списку: Д3 CONS/CAR/CDR, Д4 NULL і LAMBDA.
; Семантичні очікування та негативні випадки визначає тільки Lisp/SENS.
; Фізичні байти створює Zig/T5M, Rust не визначає жодної рівності.
; Д5 REVERSE не підміняємо: фізичне виконання ще не допускає його виклику.

(визначити довести-закон-списку
  (функція (умова)
    (за-умовою
      ((хибне? умова) (перше (як-є ())))
      (так так))))

(визначити структурний-список
  (сполучити (як-є альфа)
    (сполучити (як-є бета)
      (сполучити (як-є гамма) (як-є ())))))

; Перше, наступне й останнє значення відтворюють точні атоми.
(довести-закон-списку
  (однакові? (перше структурний-список) (як-є альфа)))
(довести-закон-списку
  (однакові? (перше (решта структурний-список)) (як-є бета)))
(довести-закон-списку
  (однакові? (перше (решта (решта структурний-список))) (як-є гамма)))

; Після трьох CDR хвіст є порожнім списком, не хибним D1-значенням.
(довести-закон-списку
  (порожній? (решта (решта (решта структурний-список)))))

; Розклад CAR/CDR і повторне CONS зберігають структуру.
(довести-закон-списку
  (однакові?
    (сполучити (перше структурний-список) (решта структурний-список))
    структурний-список))

; Негатив: відкинутий перший елемент не відновлює початковий список.
(довести-закон-списку
  (хибне? (однакові? (решта структурний-список) структурний-список)))

; Цитування зберігає помилкову викличну форму як дані.
(довести-закон-списку
  (однакові? (перше (як-є (перше ()))) (як-є перше)))

; Передавання списку в LAMBDA не змінює його перший атом.
(довести-закон-списку
  (однакові?
    ((функція (список) (перше список)) структурний-список)
    (як-є альфа)))

; Точний вердикт D1:YES визначено самим SENS.
(атом? (як-є ()))
