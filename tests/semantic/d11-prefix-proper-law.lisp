; Д11: позитивний структурний D1-закон префікса повних D3-списків.
; Обидва входи правильні; атоми D1 та порожні D3-елементи не губляться.
(за-умовою
  ((хибне?
     (список-префікс-строгий?
       (як-є ())
       (список ні (як-є ()) (як-є а))))
   ні)
  ((хибне?
     (список-префікс-строгий?
       (список (як-є а) (як-є ()))
       (список (як-є а) (як-є ()) (як-є б))))
   ні)
  ((хибне?
     (список-префікс-строгий?
       (список так ні)
       (список так ні (як-є кінець))))
   ні)
  ((хибне?
     (список-префікс-строгий?
       (список (як-є (а б)))
       (список (як-є (а б)) (як-є зайве))))
   ні)
  ((список-префікс-строгий?
     (список (як-є а) (як-є б))
     (список (як-є а)))
   ні)
  ((список-префікс-строгий?
     (список (як-є б))
     (список (як-є а) (як-є б)))
   ні)
  ((список-префікс-строгий?
     (список ні)
     (список (як-є ())))
   ні)
  (так так))
