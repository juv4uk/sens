; Закони лексичних замикань і першокласних функцій D4.
; Це виконувана українська Lisp-програма. Жодного SID8, числових
; голів/літералів чи визначення логічного результату в Rust або Zig.
; Кожна хибна умова веде до невикличного CAR порожнього списку.

(за-умовою
  ; Замикання вже вийшло із зовнішньої функції, але зберігає NIL.
  (( ((функція (зовнішній)
         (функція (внутрішній) (атом? зовнішній)))
       (як-є ()))
     (сполучити (як-є ()) (як-є ())))
   (за-умовою
     ; Заміна зовнішнього аргумента парою повинна змінити результат.
     ((хибне?
        ( ((функція (зовнішній)
             (функція (внутрішній) (атом? зовнішній)))
           (сполучити (як-є ()) (як-є ())))
          (як-є ())))
      (за-умовою
        ; Внутрішній однойменний параметр затінює зовнішню пару.
        (( ((функція (значення)
               (функція (значення) (атом? значення)))
             (сполучити (як-є ()) (як-є ())))
            (як-є ()))
         (за-умовою
           ; Затінення також працює в протилежному напрямку.
           ((хибне?
              ( ((функція (значення)
                   (функція (значення) (атом? значення)))
                 (як-є ()))
                (сполучити (як-є ()) (як-є ()))))
            (за-умовою
              ; Замикання є значенням: передавання його третій функції
              ; не замінює збережене лексичне оточення.
              (( (функція (обчислювач)
                    (обчислювач (сполучити (як-є ()) (як-є ()))))
                  ((функція (зовнішній)
                     (функція (внутрішній) (атом? зовнішній)))
                   (як-є ())))
               так)
              (так (перше (як-є ())))))
           (так (перше (як-є ())))))
        (так (перше (як-є ())))))
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))
