; D8 CHAR-CODE/STRING->SYMBOL/SYMBOL->STRING: 7 D1 one-bit outcomes.
(список
  (equal? (код-символу "A") #d24:000000000000000001000001)
  (equal? (текст-у-символ "вовк") (як-є вовк))
  (equal? (символ-у-текст (як-є вовк)) "вовк")
  (equal? (символ-у-текст (текст-у-символ "вовк")) "вовк")
  (хибне? (equal? (текст-у-символ "вовк") (як-є кіт)))
  (хибне? (equal? (код-символу "A") (код-символу "B")))
  (equal? (текст-у-символ (символ-у-текст (як-є вовк))) (як-є вовк)))
