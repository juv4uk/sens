; Точна D24+ арифметика належить мові; усі очікувані значення названі.
; Тут немає цифрових викличних голів або числових літералів.
; Кожен закон перевіряє нуль різниці точних математичних значень.
(за-умовою
  ((нуль?
     (відняти
       (додати число-два число-три)
       число-п'ять))
   (за-умовою
     ((нуль?
        (відняти
          (обернене число-два)
          (частка число-один число-два)))
      (за-умовою
        ((нуль?
           (відняти
             (помножити
               (додати
                 (частка число-один число-два)
                 (частка число-один число-три))
               (додати число-три число-три))
             число-п'ять))
         (за-умовою
           ((нуль?
              (додати
                (помножити
                  (відняти число-нуль число-два)
                  число-три)
                (додати число-три число-три)))
            (за-умовою
              ((нуль?
                 (додати
                   (відняти
                     число-п'ять
                     (додати число-три число-п'ять))
                   число-три))
               (за-умовою
                 ((нуль?
                    (відняти
                      (частка
                        (додати число-три число-три)
                        число-чотири)
                      (частка число-три число-два)))
                  (атом? (як-є ())))
                 (так (перше (як-є ())))))
              (так (перше (як-є ())))))
           (так (перше (як-є ())))))
        (так (перше (як-є ())))))
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))
