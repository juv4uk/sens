; T5M — SENS-тайминг ВЛАСНИМ годинником (mono-ns), без Python.
; mono-ns — монотонний лічильник; різниця двох викликів = час у наносекундах.
; Обчислюємо розмір виходу ТА час кодекa в одній SENS-програмі.
(let ((старт (mono-ns)))
  (let ((байти (т5м-у-байти (list (list #d1:1 #d1:0 #d1:1)
                                  (list #d1:1 #d1:1)))))
    (let ((кінець (mono-ns)))
      (list (довжина байти)                 ; 3 байти
            (різниця кінець старт)))))      ; час у нс
