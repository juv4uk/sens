; D9:110100101 numeric order + D9:010000000 proper CDR + D9:010110001 dotted CDR.
; Exactly eight D1:1 witnesses, including negative equality/order controls.
; All arithmetic operands are exact D24 words, never decimal intermediates.
(список
  (числовий-рівність #d24:000000000000000000000010 #d24:000000000000000000000010)
  (за-умовою ((числовий-рівність #d24:000000000000000000000010 #d24:000000000000000000000011) #d1:0) (#d1:1 #d1:1))
  (за-умовою ((числовий-рівність #d24:000000000000000000000011 #d24:000000000000000000000010) #d1:0) (#d1:1 #d1:1))
  (числовий-рівність #d24:000000000000000000000000 #d24:000000000000000000000000)
  (канон-закон-решта-правильний (як-є голова) (список (як-є а) (як-є б)))
  (канон-закон-решта-правильний (як-є голова) (як-є ()))
  (канон-закон-решта-крапковий (як-є голова) (як-є хвіст))
  (за-умовою
    ((тотожне? (решта (сполучити (як-є голова) (як-є хвіст))) (як-є не-хвіст)) #d1:0)
    (#d1:1 #d1:1)))
