; Закони побудови пари дев'ятого домену.
; Три позитивні перевірки підтверджують перший елемент, решту
; та неатомарність складеної пари.
; Три негативні перевірки навмисно порушують ці твердження.
; Очікувані значення за порядком є так, так, так, ні, ні, ні.
(список
  (канон-закон-перше-пара (як-є а) (як-є б))
  (канон-закон-решта-пара (як-є а) (як-є б))
  (канон-закон-атом-пара (як-є а) (як-є б))
  (тотожне? (перше (сполучити (як-є а) (як-є б))) (як-є б))
  (тотожне? (решта (сполучити (як-є а) (як-є б))) (як-є а))
  (атом? (сполучити (як-є а) (як-є б))))
