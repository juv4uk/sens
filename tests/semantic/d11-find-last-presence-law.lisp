; Д11: останній збіг, його прапорець і структурне () — SENS.
; Перший атом так та останній атом ні відрізняються.
(за-умовою
  ((однакові?
     (знайти-останній-із-наявністю
       атом? (список так ні))
     (список так ні))
   так)
  (так (перше (як-є ()))))

; Структурне () є повноцінним знайденим значенням.
(за-умовою
  ((однакові?
     (знайти-останній-із-наявністю
       порожній? (список (як-є ()) так (як-є ())))
     (список так (як-є ())))
   так)
  (так (перше (як-є ()))))

; Відсутність та порожній вхід — два різні закони.
(за-умовою
  ((однакові?
     (знайти-останній-із-наявністю
       (функція (елемент) (хибне? елемент))
       (список так так))
     (список ні (як-є ())))
   так)
  (так (перше (як-є ()))))
(за-умовою
  ((однакові?
     (знайти-останній-із-наявністю
       (функція (елемент) (перше (як-є ())))
       (як-є ()))
     (список ні (як-є ())))
   так)
  (так (перше (як-є ()))))

; D11: повторні збіги, зокрема точний D1:ні.
(за-умовою
  ((однакові?
     (знайти-останній-із-наявністю
       атом? (список ні так ні так ні))
     (список так ні))
   так)
  (так (перше (як-є ()))))

; Структурне () є знайденим елементом, а не відсутністю.
(за-умовою
  ((однакові?
     (знайти-останній-із-наявністю
       порожній? (список так (як-є ()) так))
     (список так (як-є ())))
   так)
  (так (перше (як-є ()))))

(атом? (як-є ()))
