; LET: паралельне зв'язування. LET*: другий запис бачить перший.
(за-умовою
 ((тотожне? (нехай ((перший так) (другий ні)) перший) так)
  (за-умовою
   ((тотожне?
      (нехай-послідовно ((перший так) (другий перший)) другий)
      так)
    (тотожне? (нехай-послідовно () так) так))
   (так (перше (як-є ())))))
 (так (перше (як-є ()))))
