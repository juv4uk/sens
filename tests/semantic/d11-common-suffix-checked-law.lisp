; D11: позитивний закон proper/dotted із точним D1-вердиктом.
; Залежності підвантажує тільки фізичний SENS runner.
(визначити правильний-суфікс
  (спільний-суфікс-перевірений
    (список (як-є атом?) (як-є решта))
    (список (як-є сполучити) (як-є решта))))
(визначити лівий-крапковий
  (спільний-суфікс-перевірений
    (сполучити (як-є атом?) ні)
    (список (як-є атом?))))
(визначити правий-крапковий
  (спільний-суфікс-перевірений
    (список (як-є атом?))
    (сполучити (як-є решта) так)))

(за-умовою
  ((перше правильний-суфікс)
   (за-умовою
     ((тотожне? (перше (друге правильний-суфікс)) (як-є решта))
      (за-умовою
        ((хибне? (перше лівий-крапковий))
         (за-умовою
           ((хибне? (друге лівий-крапковий))
            (за-умовою
              ((хибне? (перше правий-крапковий))
               (друге правий-крапковий))
              (так ні)))
           (так ні)))
        (так ні)))
     (так ні)))
  (так ні))
