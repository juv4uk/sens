; Вісім законів вибору елемента, пошуку позиції та підпослідовності.
; Індекси є людськими десятковими числами.
; Викличні назви беруться з українських проєкцій чинних доменів.
(визначити елемент-за-індексом
  (функція (послідовність індекс)
    (за-умовою
      ((нуль? індекс) (перше послідовність))
      ((порожній? послідовність) (як-є ()))
      ((хибне? (порожній? послідовність))
       (елемент-за-індексом (решта послідовність) (зменшити-на-один індекс))))))
(визначити позиція-з
  (функція (шукане послідовність позиція)
    (за-умовою
      ((порожній? послідовність) (як-є ()))
      ((тотожне? шукане (перше послідовність)) позиція)
      ((хибне? (порожній? послідовність))
       (позиція-з шукане (решта послідовність) (збільшити-на-один позиція))))))
(визначити позиція-першого-збігу
  (функція (шукане послідовність)
    (позиція-з шукане послідовність (довжина (як-є ())))))
(визначити елемент-справа
  (функція (послідовність індекс)
    (елемент-за-індексом
      послідовність
      (відняти (зменшити-на-один (довжина послідовність)) індекс))))
(список
  (однакові? (елемент-за-індексом
            (список (як-є а) (як-є б) (як-є в))
            (довжина (як-є (а))))
          (як-є б))
  (однакові? (позиція-першого-збігу
            (як-є б)
            (список (як-є а) (як-є б) (як-є в)))
          (довжина (як-є (а))))
  (порожній? (позиція-першого-збігу
           (як-є немає)
           (список (як-є а))))
  (однакові? (підпослідовність
            (список (як-є а) (як-є б) (як-є в) (як-є г))
            (довжина (як-є (а)))
            (довжина (як-є (а б в))))
          (список (як-є б) (як-є в)))
  (однакові? (елемент-справа
            (список (як-є а) (як-є б) (як-є в))
            (довжина (як-є ())))
          (як-є в))
  (однакові? (елемент-справа
            (список (як-є а) (як-є б) (як-є в))
            (довжина (як-є (а))))
          (як-є б))
  (однакові? (елемент-за-індексом
            (список (як-є а))
            (довжина (як-є ())))
          (як-є а))
  (порожній? (елемент-за-індексом
           (як-є ())
           (довжина (як-є ())))))
