; D11: вже визначений закон внутрішній-світ-прибрати-перше із lib/world.lisp.
; Похідна композиція: вилучити рівно перше структурно рівне значення,
; не змінюючи жодного наступного; відсутність залишає список незмінним.
; Усі вирази є нативними D1-свідками SENS, а не host-таблицею відповідей.

; Два збіги: зникає тільки перший.
(внутрішня-рівність-версій
  (внутрішній-світ-прибрати-перше (як-є а) (як-є (а б а в)))
  (як-є (б а в)))

; Відсутній елемент: усе залишається.
(внутрішня-рівність-версій
  (внутрішній-світ-прибрати-перше (як-є а) (як-є (б в)))
  (як-є (б в)))

; Порожня послідовність залишається порожньою.
(внутрішня-рівність-версій
  (внутрішній-світ-прибрати-перше (як-є а) (як-є ()))
  (як-є ()))

; Атом не обробляється як список.
(внутрішня-рівність-версій
  (внутрішній-світ-прибрати-перше (як-є а) (як-є хвіст))
  (як-є ()))

; Негативна альтернатива: вилучати обидва збіги неправильно.
(хибне?
  (внутрішня-рівність-версій
    (внутрішній-світ-прибрати-перше (як-є а) (як-є (а б а в)))
    (як-є (б в))))
