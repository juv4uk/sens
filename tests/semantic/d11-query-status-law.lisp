; Д11 Contract 12.0: окремий запит показує причину без третьої істини.
; (єдиний ()) доводить, що структурний () знайдено рівно один раз.
; (немає) стосується лише закритого перевіреного скінченного списку.
(визначити вибрати-порожній?
  (функція (елемент) (порожній? елемент)))
(за-умовою
  ((однакові?
     (стан-однозначного-пошуку
       вибрати-порожній? (список (як-є ()) (як-є а)))
     (список (як-є єдиний) (як-є ())))
   (за-умовою
     ((однакові?
        (стан-однозначного-пошуку
          (функція (елемент) ні)
          (список (як-є а) (як-є б)))
        (список (як-є немає)))
      (за-умовою
        ((однакові?
           (стан-однозначного-пошуку
             (функція (елемент) так)
             (список (як-є а) (як-є б)))
           (список (як-є кілька)))
         (за-умовою
           ((однакові?
              (стан-однозначного-пошуку
                (функція (елемент) так)
                (список ні))
              (список (як-є єдиний) ні))
            (за-умовою
              ((однакові?
                 (стан-однозначного-пошуку
                   (функція (елемент) (перше (як-є ())))
                   (як-є ()))
                 (список (як-є немає)))
               так)
              (так ні)))
           (так ні)))
        (так ні)))
     (так ні)))
  (так ні))
