; Д4: ізолюємо вхідні типи, від яких залежить рекурсивний обхід.
; Цитований атом не є порожнім списком; непорожній список не є атомом.
; Якщо хоча б один мовний факт порушено, саме SENS виконує недопустимий CAR.
; Без цифрових голів, сирих кодів чи хостової моделі семантики.
(за-умовою
  ((атом? (як-є пошкоджений-хвіст))
   (за-умовою
     ((хибне? (порожній? (як-є пошкоджений-хвіст)))
      (за-умовою
        ((хибне? (атом? (як-є (радіо антена))))
         (за-умовою
           ((хибне? (порожній? (як-є (радіо антена))))
            (порожній? (як-є ())))
           (так (перше (як-є ())))))
        (так (перше (як-є ())))))
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))
