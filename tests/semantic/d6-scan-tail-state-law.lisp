; Д6:101111 SCAN — закон синтаксично хвостового SENS-помічника.
; Усі стани включно з початковим, повтори й порядок не губляться.
(за-умовою
  ((хибне?
    (однакові?
      (накопичувати-до
        (функція (стан елемент) (сполучити елемент стан))
        (як-є ())
        (список так ні так))
      (список
        (як-є ())
        (список так)
        (список ні так)
        (список так ні так))))
    ні)
  ((хибне?
    (однакові?
      (накопичувати-зворотні-стани
        (функція (стан елемент) (сполучити елемент стан))
        (список так)
        (список ні)
        (список (список так) (як-є ())))
      (список (як-є ()) (список так) (список ні так))))
    ні)
  ((хибне?
    (однакові?
      (накопичувати-до
        (функція (стан елемент) (перше елемент))
        (список ні)
        (як-є ()))
      (список (список ні))))
    ні)
  (так так))
