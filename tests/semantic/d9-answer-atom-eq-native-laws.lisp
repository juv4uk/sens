; Eight strict D1 return witnesses with no quoted digit substitution.
(список
  (equal? (відповідь-атом (як-є ())) (як-є ()))
  (equal? (відповідь-атом (як-є символ)) (список #d1:1))
  (equal? (відповідь-атом (як-є (символ))) (список #d1:0))
  (equal? (відповідь-атом #d24:000000000000000000000010) (список #d1:1))
  (equal? (відповідь-рівність (як-є a) (як-є a)) (список #d1:1))
  (equal? (відповідь-рівність (як-є a) (як-є b)) (список #d1:0))
  (equal? (відповідь-рівність #d24:000000000000000000000011 #d24:000000000000000000000011) (список #d1:1))
  (equal? (відповідь-рівність #d24:000000000000000000000011 #d24:000000000000000000000100) (список #d1:0))
)
