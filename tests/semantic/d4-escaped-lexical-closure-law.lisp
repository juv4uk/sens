; Виконуваний закон Д4: вкладена функція зберігає лексичне зв'язування.
; Зовнішня функція вже завершилася, а захоплене Д1:так зберігається.
; Пізніше визначення і аргумент виклику не можуть підмінити захоплене.
; При порушенні SENS викликає невикличну Д1-голову (ні).

(визначити утворити-замикання-д4
  (функція (захоплене)
    (функція (підміна)
      захоплене)))

(визначити збережене-замикання-д4
  (утворити-замикання-д4
    (атом? (як-є ()))))

(визначити пізніше-значення-д4
  (хибне? (атом? (як-є ()))))

(за-умовою
  ((тотожне?
     (збережене-замикання-д4 пізніше-значення-д4)
     (атом? (як-є ())))
   (за-умовою
     ((хибне?
        (тотожне?
          (збережене-замикання-д4 пізніше-значення-д4)
          пізніше-значення-д4))
      так)
     (так (ні))))
  (так (ні)))
