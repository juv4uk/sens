; Д1/Д3/Д4: закон де Моргана для всіх комбінацій двох точних D1-предикатів.
; Логічні «і» та «або» записані через COND, без нових дубльованих функцій.
; Вердикт обчислює лише SENS; числових голів, літералів або SID8 немає.
; Для кожної пари: НЕ (ліве І праве) = (НЕ ліве) АБО (НЕ праве).
((функція (перевірити)
   (за-умовою
     ((перевірити так так)
       (за-умовою
         ((перевірити так ні)
           (за-умовою
             ((перевірити ні так)
               (за-умовою
                 ((перевірити ні ні) так)
                 (так ні)))
             (так ні)))
         (так ні)))
     (так ні)))
 (функція (ліве праве)
   (тотожне?
     (хибне?
       (за-умовою
         (ліве (за-умовою (праве так) (так ні)))
         (так ні)))
     (за-умовою
       ((хибне? ліве) так)
       ((хибне? праве) так)
       (так ні)))))
