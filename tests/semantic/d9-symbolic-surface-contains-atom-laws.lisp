; Вісім самостійних законів символічної поверхні та
; наявності атома для ратифікованих тотожностей D9.
; Хибні твердження перевіряються окремими спростуваннями.
; Нового прямого машинного виклику D9 тут не запроваджуємо.

(список
  (тотожне?
    (канон-закон-стан (канон-закон-символьний-поверхня))
    (як-є satisfied))
  (однакові?
    (канон-закон-символьний-поверхня)
    (канон-запис-закону (як-є symbolic-surface) (як-є satisfied)))
  (хибне?
    (однакові? (канон-закон-символьний-поверхня)
            (канон-запис-закону (як-є symbolic-surface) (як-є violated))))
  (містить-атом? (як-є ліве)
    (сполучити (як-є ліве) (сполучити (як-є праве) (як-є ()))))
  (містить-атом? (як-є праве)
    (сполучити (як-є ліве) (сполучити (як-є праве) (як-є ()))))
  (хибне? (містить-атом? (як-є третє)
    (сполучити (як-є ліве) (сполучити (як-є праве) (як-є ())))))
  (містить-атом? (як-є ліве)
    (сполучити (сполучити (як-є ліве) (як-є ())) (як-є ())))
  (хибне? (містить-атом? (як-є праве)
    (сполучити (сполучити (як-є ліве) (як-є ())) (як-є ())))))
