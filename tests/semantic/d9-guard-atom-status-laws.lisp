; Дванадцять перевірок рішень захисту та станів доказів дев'ятого домену.
(список
  (захист-рішення? (як-є allow))
  (захист-рішення? (як-є warn))
  (захист-рішення? (як-є reject))
  (захист-рішення? (як-є unknown))
  (хибне? (захист-рішення? (як-є deny)))
  (хибне? (захист-рішення? (список (як-є allow))))
  (захист-доказ-стан? (як-є confirmed))
  (захист-доказ-стан? (як-є partial))
  (захист-доказ-стан? (як-є unresolved))
  (захист-доказ-стан? (як-є broken))
  (хибне? (захист-доказ-стан? (як-є absent)))
  (хибне? (захист-доказ-стан? (список (як-є confirmed)))))

; Виконання використовує чинні українські ратифіковані назви, без повторних зв'язувань.
