; Д11: незалежний мовний закон для БЕНЧМАРКУ трьох сімейств.
; Визначення виконуються із справжніх бібліотек та benchmarks/d11-families.lisp.
; Shell тільки складає джерела; істинність визначає SENS після Zig/T5M.
; D7-ключі у фізичному носії — структурні гліфи: D8 однакові?, НЕ D3 тотожне?.
; Очікувані списки теж збираємо D9 СПИСОК із окремих D7 символів.

; Відбір за ключем «а» зберігає чотири входження та порядок.
(за-умовою
  ((однакові? б-відбір (список (як-є а) (як-є а) (як-є а) (як-є а))) так)
  (так (перше (як-є ()))))

; Асоціація знайшла другий ключ і повернула точну присутність D1.
(за-умовою
  ((перше б-асоціація) так)
  (так (перше (як-є ()))))

; Знайдений ключ та значення належать одному записові.
(за-умовою
  ((однакові? (перше (друге б-асоціація)) (як-є б)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((однакові? (решта (друге б-асоціація)) (як-є у)) так)
  (так (перше (як-є ()))))

; Групування зберігає чотири входження першого ключа в унарній формі.
(за-умовою
  ((однакові? (перше б-лічба) (список (як-є а) (список (як-є о) (як-є о) (як-є о) (як-є о)))) так)
  (так (перше (як-є ()))))

; Тільки після всіх тверджень повертається точна істина D1.
(атом? (як-є ()))
