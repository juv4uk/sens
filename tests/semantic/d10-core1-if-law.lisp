; D10 якщо повертає саме вибране значення, зокрема D1 так/ні.
; Дві форми перевіряють неявну альтернативу, три форми — явний вибір.
; Невибрані форми навмисно є не-викличними D1 значеннями.
(за-умовою
 ((однакові? (якщо (однакові? (як-є а) (як-є а)) так) так)
  (за-умовою
   ((хибне? (якщо (однакові? (як-є а) (як-є б)) так))
    (за-умовою
     ((однакові? (якщо (однакові? (як-є а) (як-є б)) так ні) ні)
      (за-умовою
       ((однакові? (якщо (однакові? (як-є а) (як-є б)) (ні так) ні) ні)
        (за-умовою
         ((однакові? (якщо (однакові? (як-є а) (як-є а)) так (ні так)) так) так)
         (так ні)))
       (так ні)))
     (так ні)))
   (так ні)))
 (так ні))
