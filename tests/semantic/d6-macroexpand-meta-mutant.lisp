; Негативний SENS-мутант D6: хибне твердження «лексичне
; немакросне зв'язування все одно розгортається як макрос».
; Очікуваний точний результат Д1:ні. Потрібні lib/meta-eval.lisp
; та lib/d6-macroexpand-meta.lisp.
(визначити д6-мутант-форма
  (як-є (тестовий-макрос (як-є дані))))

(визначити д6-мутант-оточення
  (список
    (сполучити (як-є тестовий-макрос) ні)))

(визначити д6-мутант-наслідок
  (розгорнути-макрос-1 д6-мутант-форма д6-мутант-оточення))

; Якщо помилка або реальне розгортання — мутант має бути відхилений.
; Для чинного закону тут рівно Д1:ні.
(за-умовою
  ((це-результат-невдалого-обчислення? д6-мутант-наслідок) ні)
  (так (перше (решта д6-мутант-наслідок))))
