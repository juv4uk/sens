; Д4: повторне визначення й затінення перевіряє сам SENS.
; Невірна рання стадія переходить у невикличний Д1:ні.
; Zig/T5M переносить біти, Rust не визначає значення мови.
(визначити читати-пізніше-д4
  (функція () пізнє-значення-д4))
(визначити пізнє-значення-д4
  (хибне? (атом? (як-є ()))))
(за-умовою
  ((хибне? (читати-пізніше-д4)) так)
  (так (ні)))
(визначити пізнє-значення-д4
  (атом? (як-є ())))
; Лексичний параметр затінює значення верхньої рамки.
(за-умовою
  ((тотожне?
     ((функція (пізнє-значення-д4) пізнє-значення-д4)
      (хибне? (атом? (як-є ()))))
     (хибне? (атом? (як-є ()))))
   так)
  (так (ні)))
; Замикання бачить нове визначення з тієї самої рамки.
(за-умовою
  ((тотожне?
     (читати-пізніше-д4)
     (атом? (як-є ())))
   так)
  (так (ні)))
