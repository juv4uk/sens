; Д8: похідні від Д6 ANY/ALL та Д4 NOT; жодного нового примітива.
; Лише D3:() — порожній список. Зберігаємо коротке замикання.
; Кожне хибне твердження повертає D1:ні; всі правильні — D1:так.
(за-умовою
  ((хибне?
     (жодне-не-задовольняє?
       (функція (елемент) елемент) (як-є ())))
   ні)
  ((хибне?
     (усі-не-задовольняють?
       (функція (елемент) елемент) (як-є ())))
   ні)
  ((є-що-не-задовольняє?
     (функція (елемент) елемент) (як-є ()))
   ні)
  ((хибне?
     (є-що-не-задовольняє?
       (функція (елемент) елемент)
       (сполучити ні ні)))
   ні)
  ((жодне-не-задовольняє?
     (функція (елемент) елемент)
     (сполучити так ні))
   ні)
  (так так))
