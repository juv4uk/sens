; Перехідна назва файла зберігається для CI, але D7-текст не тестуємо як D3-атом.
; D7-гліфи — структурні дані: їхню рівність визначає точне D8-порівняння.
; D3-ATOM застосовуємо лише до об'єктів, що справді належать D3.
; Кожна умова та остаточний D1-вердикт обчислюються самим Lisp/SENS.
(за-умовою
  ((однакові? (як-є пошкоджений-хвіст) (як-є пошкоджений-хвіст)) так)
  (так (перше (як-є ()))))
; Різні D7-тексти не зливаються в одну тотожність.
(за-умовою
  ((хибне? (однакові? (як-є пошкоджений-хвіст) (як-є інший-хвіст))) так)
  (так (перше (як-є ()))))
; D7-текстова тотожність не є D3-порожнім списком.
(за-умовою
  ((хибне? (однакові? (як-є пошкоджений-хвіст) (як-є ()))) так)
  (так (перше (як-є ()))))
; D3: порожній список має ратифіковану атомність.
(за-умовою
  ((атом? (як-є ())) так)
  (так (перше (як-є ()))))
; D3: непорожня пара не є атомом.
(за-умовою
  ((хибне? (атом? (як-є (радіо антена)))) так)
  (так (перше (як-є ()))))
; D4: непорожня пара не є порожнім списком.
(за-умовою
  ((хибне? (порожній? (як-є (радіо антена)))) так)
  (так (перше (як-є ()))))
; Підсумкова точна D1 істина після всіх структурних та атомних законів.
(порожній? (як-є ()))
