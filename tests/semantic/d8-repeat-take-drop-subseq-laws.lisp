; Вісім законів повторення елемента, вибору й відкидання частин списку.
; Індекси подано людськими десятковими числами, без машинних літералів.
; Позитивні та негативні випадки виконуються мовою СЕНС.
(список
  (однакові? (повторити 0 (як-є а)) (як-є ()))
  (однакові? (повторити 1 (як-є а)) (список (як-є а)))
  (однакові? (повторити 2 (як-є а)) (список (як-є а) (як-є а)))
  (хибне? (однакові? (повторити 2 (як-є а)) (список (як-є а) (як-є б))))
  (однакові? (взяти 2 (список (як-є а) (як-є б) (як-є в))) (список (як-є а) (як-є б)))
  (однакові? (відкинути 2 (список (як-є а) (як-є б) (як-є в))) (список (як-є в)))
  (однакові? (підпослідовність (список (як-є а) (як-є б) (як-є в)) 1 3) (список (як-є б) (як-є в)))
  (хибне? (однакові? (взяти 1 (список (як-є а) (як-є б) (як-є в))) (список (як-є б)))))
