; Канонічні індекси лише D24. Немає прямої D8 callability / legacy SID8.
(список
  (equal? (повторити #d24:000000000000000000000000 (як-є а)) (як-є ()))
  (equal? (повторити #d24:000000000000000000000001 (як-є а)) (список (як-є а)))
  (equal? (повторити #d24:000000000000000000000010 (як-є а)) (список (як-є а) (як-є а)))
  (хибне? (equal? (повторити #d24:000000000000000000000010 (як-є а)) (список (як-є а) (як-є б))))
  (equal? (взяти #d24:000000000000000000000010 (список (як-є а) (як-є б) (як-є в))) (список (як-є а) (як-є б)))
  (equal? (відкинути #d24:000000000000000000000010 (список (як-є а) (як-є б) (як-є в))) (список (як-є в)))
  (equal? (підпослідовність (список (як-є а) (як-є б) (як-є в)) #d24:000000000000000000000001 #d24:000000000000000000000011) (список (як-є б) (як-є в)))
  (хибне? (equal? (взяти #d24:000000000000000000000001 (список (як-є а) (як-є б) (як-є в))) (список (як-є б)))))

