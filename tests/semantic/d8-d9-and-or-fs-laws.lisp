; Вісім законів логічного поєднання, ділення та роботи зі списковим сховищем.
; Викличні назви взято з чинної української проєкції.
; Числові операнди записані десятково, без машинних літералів.
(визначити фс-містить?
  (функція (ключ мапа)
    (хибне? (порожній? (знайти-за-ключем ключ мапа)))))
(визначити фс-список
  (функція (записи) записи))
(визначити мапа-факт-від
  (функція (ключ мапа)
    (за-умовою
      ((порожній? (знайти-за-ключем ключ мапа)) (як-є ()))
      ((хибне? (порожній? (знайти-за-ключем ключ мапа)))
       (решта (знайти-за-ключем ключ мапа))))))
(список
  (та (однакові? (як-є а) (як-є а)) (однакові? (як-є б) (як-є б)))
  (хибне? (та (однакові? (як-є а) (як-є а)) (однакові? (як-є а) (як-є б))))
  (або (однакові? (як-є а) (як-є б)) (однакові? (як-є а) (як-є а)))
  (однакові? (частка 8
                    2)
          4)
  (однакові? (значення-списком (список (як-є х))) (список (як-є х)))
  (однакові? (фс-порожній) (як-є ()))
  (фс-містить? (як-є к) (список (список (як-є к) (як-є значення))))
  (однакові? (фс-список (список (як-є а))) (список (як-є а))))
