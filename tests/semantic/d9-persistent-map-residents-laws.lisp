; D9 resident projections over the active immutable persistent-map mechanism.
; Exact identities: MAP-EMPTY D9:101100011; MAP-GET D9:101100101;
; MAP-CONTAINS? D9:101100010; MAP->LIST D9:101001100.
; The source mechanism returns () or (value), and stores ordered dotted entries.
(load "lib/core.lisp")
(load "lib/persistent-map.lisp")
(список
  (однакові? (мапа-порожній) (як-є ()))
  (однакові? (мапа-отримати (як-є k)
      (внутрішня-мапа-вставити (як-є k) (як-є v) (мапа-порожній)))
    (список (як-є v)))
  (однакові? (мапа-отримати (як-є missing) (мапа-порожній)) (як-є ()))
  (мапа-містить? (як-є k)
    (внутрішня-мапа-вставити (як-є k) (як-є v) (мапа-порожній)))
  (хибне? (мапа-містить? (як-є missing) (мапа-порожній)))
  (однакові? (мапа-список
      (внутрішня-мапа-вставити (як-є k) (як-є v) (мапа-порожній)))
    (список (сполучити (як-є k) (як-є v))))
  (однакові? (мапа-отримати (як-є k)
      (внутрішня-мапа-вставити (як-є k) (як-є ()) (мапа-порожній)))
    (список (як-є ())))
  (однакові? (мапа-список
      (внутрішня-мапа-вставити (як-є k) (як-є v2)
        (внутрішня-мапа-вставити (як-є k) (як-є v1) (мапа-порожній))))
    (список (сполучити (як-є k) (як-є v2)))))

