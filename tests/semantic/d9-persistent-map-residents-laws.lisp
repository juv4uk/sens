; D9-проєкції резидентів над активним механізмом незмінної persistent-map.
; Точні ідентичності: MAP-EMPTY D9:101100011; MAP-GET D9:101100101;
; MAP-CONTAINS? D9:101100010; MAP->LIST D9:101001100.
; Вихідний механізм повертає () або (значення) і зберігає впорядковані записи.
; Завантаження бібліотек виконує чинна українська функція.
(завантажити-файл "lib/core.lisp")
(завантажити-файл "lib/persistent-map.lisp")
(список
  (однакові? (мапа-порожній) (як-є ()))
  (однакові? (мапа-отримати (як-є k)
      (внутрішня-мапа-вставити (як-є k) (як-є v) (мапа-порожній)))
    (список (як-є v)))
  (однакові? (мапа-отримати (як-є missing) (мапа-порожній)) (як-є ()))
  (мапа-містить? (як-є k)
    (внутрішня-мапа-вставити (як-є k) (як-є v) (мапа-порожній)))
  (хибне? (мапа-містить? (як-є missing) (мапа-порожній)))
  (однакові? (мапа-список
      (внутрішня-мапа-вставити (як-є k) (як-є v) (мапа-порожній)))
    (список (сполучити (як-є k) (як-є v))))
  (однакові? (мапа-отримати (як-є k)
      (внутрішня-мапа-вставити (як-є k) (як-є ()) (мапа-порожній)))
    (список (як-є ())))
  (однакові? (мапа-список
      (внутрішня-мапа-вставити (як-є k) (як-є v2)
        (внутрішня-мапа-вставити (як-є k) (як-є v1) (мапа-порожній))))
    (список (сполучити (як-є k) (як-є v2)))))

; Первинні українські визначення завантажуються з відповідних бібліотек.
; Не перекриваємо їх зворотними англомовними псевдонімами.
