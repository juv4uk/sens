; Д3/Д4 ZIP: правильні два списки, порядок і точна кінцева форма.
(визначити доказові-пари-zip
  (спарувати-скінченні-списки
    (список (як-є атом?) (як-є решта))
    (список (як-є сполучити) (як-є тотожне?))))
(за-умовою
  ((тотожне? (перше (перше доказові-пари-zip)) (як-є атом?))
   (за-умовою
     ((тотожне? (решта (перше доказові-пари-zip)) (як-є сполучити))
      (за-умовою
        ((тотожне? (перше (друге доказові-пари-zip)) (як-є решта))
         (за-умовою
           ((тотожне? (решта (друге доказові-пари-zip)) (як-є тотожне?))
            (порожній? (решта (решта доказові-пари-zip))))
           (так ні)))
        (так ні)))
     (так ні)))
  (так ні))
