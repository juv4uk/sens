; Закон QUOTE/COND мовою SENS: цитоване (ні) лишається інертними даними.
; CDR одноелементного цитованого списку порожній, CAR цього списку — непорожня структура.
; Усі очікування записані в Lisp. Два шляхи фізичного T5M мають повернути Д1:так.
(за-умовою
  ((порожній? (решта (як-є ((ні)))))
   (за-умовою
     ((хибне? (порожній? (перше (як-є ((ні))))))
      так)
     (так ні)))
  (так ні))
