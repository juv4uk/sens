; Нативні закони Д1/Д3/Д4. Семантика і логіка належать Lisp/SENS.
; Вектор містить дванадцять незалежних Д1-вердиктів: усі мають бути так.
; D3 ATOM/EQ перевіряють одно-гліфові атоми D7. Багатогліфовий D7 у T5M має D2-структуру.
; Дійсність перевіряє SENS; Rust не дублює ці закони, Zig лише переносить T5M.
(список
  ; Д3 ATOM: атом і складене значення мають різну природу.
  (атом? (як-є а))
  (хибне? (атом? (як-є (а))))
  ; Д3 CONS/CAR/CDR: обидві проєкції тієї самої пари.
  (тотожне?
    (перше (сполучити (як-є б) (як-є в)))
    (як-є б))
  (тотожне?
    (решта (сполучити (як-є б) (як-є в)))
    (як-є в))
  ; Д4 NULL: () не можна плутати з непорожнім списком.
  (порожній? (як-є ()))
  (хибне? (порожній? (як-є (а))))
  ; Д4 CADR/LIST і LAMBDA: реальні виклики, не коди.
  (тотожне?
    (друге (список (як-є б) (як-є в)))
    (як-є в))
  (тотожне?
    ((функція (значення) значення) (як-є а))
    (як-є а))
  ; Д3 COND: наступна гілка не повинна виконувати CAR над атомом.
  (за-умовою
    ((атом? (як-є а)) так)
    (так (перше (як-є а))))
  ; Д3 EQ: два різні атоми не стають тотожними.
  (хибне? (тотожне? (як-є б) (як-є в)))
  ; Цитування зберігає структуру даних, а не виконує її як програму.
  (однакові?
    (як-є (б в))
    (список (як-є б) (як-є в)))
  ; Хибна умова переходить далі; результат невибраної гілки не обчислюється.
  (за-умовою
    ((атом? (як-є (а))) (перше (як-є (а))))
    (так (тотожне? (як-є г) (як-є г)))))
