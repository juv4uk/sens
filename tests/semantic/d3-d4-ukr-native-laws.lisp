; Нативні закони Д1/Д3/Д4. Семантика і логіка належать Lisp/SENS.
; Вектор містить десять незалежних Д1-вердиктів: усі мають бути так.
; Дійсність перевіряє SENS; Rust не дублює ці закони, Zig лише переносить T5M.
(список
  ; Д3 ATOM: атом і складене значення мають різну природу.
  (атом? (як-є сигнал))
  (хибне? (атом? (як-є (сигнал))))
  ; Д3 CONS/CAR/CDR: обидві проєкції тієї самої пари.
  (тотожне?
    (перше (сполучити (як-є голова) (як-є хвіст)))
    (як-є голова))
  (тотожне?
    (решта (сполучити (як-є голова) (як-є хвіст)))
    (як-є хвіст))
  ; Д4 NULL: () не можна плутати з непорожнім списком.
  (порожній? (як-є ()))
  (хибне? (порожній? (як-є (сигнал))))
  ; Д4 CADR/LIST і LAMBDA: реальні виклики, не коди.
  (тотожне?
    (друге (список (як-є голова) (як-є хвіст)))
    (як-є хвіст))
  (тотожне?
    ((функція (значення) значення) (як-є сигнал))
    (як-є сигнал))
  ; Д3 COND: наступна гілка не повинна виконувати CAR над атомом.
  (за-умовою
    ((атом? (як-є сигнал)) так)
    (так (перше (як-є сигнал))))
  ; Д3 EQ: два різні атоми не стають тотожними.
  (хибне? (тотожне? (як-є голова) (як-є хвіст))))
