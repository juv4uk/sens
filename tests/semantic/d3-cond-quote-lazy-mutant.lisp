; першої гілки. Дійсний SENS має повернути Д1 ні, а не PASS.
(за-умовою
  ((тотожне?
     (за-умовою
       ((атом? (як-є радіо)) (як-є підмінено))
       (так (перше (як-є ()))))
     (як-є вибрано))
    (хибне? (тотожне? (як-є радіо) (як-є антена))))
  (так (хибне? (атом? (як-є ())))))
