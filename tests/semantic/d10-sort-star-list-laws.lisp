; Вісім законів впорядкування списків з власною функцією порівняння.
; Перевіряються висхідний і спадний порядок, порожні списки та рівні ключі.
; Числа є десятковими математичними значеннями, а не машинними літералами.
(список
  (однакові?
    (сортувати-зірочка (як-є ())
      (функція (а б) (менше? а б))) (як-є ()))
  (однакові?
    (сортувати-зірочка (список 1)
      (функція (а б) (менше? а б)))
    (список 1))
  (однакові?
    (сортувати-зірочка
      (список 3
              1
              2)
      (функція (а б) (менше? а б)))
    (список 1
            2
            3))
  (однакові?
    (сортувати-зірочка
      (список 1
              3
              2)
      (функція (а б) (більше? а б)))
    (список 3
            2
            1))
  (однакові?
    (сортувати-зірочка
      (список
        (список 2 (як-є а))
        (список 1 (як-є б))
        (список 2 (як-є в)))
      (функція (а б) (менше? (перше а) (перше б))))
    (список
      (список 1 (як-є б))
      (список 2 (як-є а))
      (список 2 (як-є в))))
  (однакові?
    ((функція (вхід)
       (список
         (сортувати-зірочка вхід
           (функція (а б) (менше? а б)))
         вхід))
     (список 3
             1))
    (список
      (список 1
              3)
      (список 3
              1)))
  (однакові?
    (сортувати-зірочка
      (список 2
              2)
      (функція (а б) (менше? а б)))
    (список 2
            2))
  (хибне?
    (однакові?
      (сортувати-зірочка
        (список 2
                1)
        (функція (а б) (менше? а б)))
      (список 2
              1))))
