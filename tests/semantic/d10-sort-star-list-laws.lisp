; D10:0011001011 SORT* — список тільки, аргументи (елементи перед?).
; Вісім D1-свідків реального SENS-сортування, без локальних DEFINE.
; Дійсна D24-арифметика; компаратор повертає лише D1:1 / D1:0.
(список
  (однакові?
    (сортувати-зірочка (як-є ())
      (функція (а б) (менше? а б))) (як-є ()))
  (однакові?
    (сортувати-зірочка (список #d24:000000000000000000000001)
      (функція (а б) (менше? а б)))
    (список #d24:000000000000000000000001))
  (однакові?
    (сортувати-зірочка
      (список #d24:000000000000000000000011
              #d24:000000000000000000000001
              #d24:000000000000000000000010)
      (функція (а б) (менше? а б)))
    (список #d24:000000000000000000000001
            #d24:000000000000000000000010
            #d24:000000000000000000000011))
  (однакові?
    (сортувати-зірочка
      (список #d24:000000000000000000000001
              #d24:000000000000000000000011
              #d24:000000000000000000000010)
      (функція (а б) (більше? а б)))
    (список #d24:000000000000000000000011
            #d24:000000000000000000000010
            #d24:000000000000000000000001))
  (однакові?
    (сортувати-зірочка
      (список
        (список #d24:000000000000000000000010 (як-є а))
        (список #d24:000000000000000000000001 (як-є б))
        (список #d24:000000000000000000000010 (як-є в)))
      (функція (а б) (менше? (перше а) (перше б))))
    (список
      (список #d24:000000000000000000000001 (як-є б))
      (список #d24:000000000000000000000010 (як-є а))
      (список #d24:000000000000000000000010 (як-є в))))
  (однакові?
    ((функція (вхід)
       (список
         (сортувати-зірочка вхід
           (функція (а б) (менше? а б)))
         вхід))
