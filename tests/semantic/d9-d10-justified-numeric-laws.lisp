; D9:010011101/010101001/001111010/001110000 + D10:0000000111.
; Факти та підтримки — власний SENS; числа лише точно кваліфіковані D24.
; Шість позитивних і два заперечні D1 свідки; жодної D9/D10 opcode-імітації.
(list
  (обґрунтований-член? (як-є а) (list (як-є б) (як-є а)))
  (not? (обґрунтований-член? (як-є в) (list (як-є б) (як-є а))))
  (equal? (видалити-обґрунтований (як-є а)
           (list (як-є а) (як-є б) (як-є а)))
         (list (як-є б)))
  (equal? (видалити-обґрунтований (як-є в)
           (list (як-є а) (як-є б)))
         (list (як-є а) (як-є б)))
  (equal? (створити-обґрунтований (як-є факт) (list (як-є доказ)))
         (list (як-є факт) (list (як-є доказ))))
  (equal? (обрізати-обґрунтування
           (list
             (створити-обґрунтований (як-є живий) (list (як-є доказ)))
             (створити-обґрунтований (як-є без-доказу) (як-є ()))))
         (list (створити-обґрунтований
                 (як-є живий) (list (як-є доказ)))))
  (числа-нерівні? #d24:000000000000000000000010 #d24:000000000000000000000011)
  (not? (числа-нерівні? #d24:000000000000000000000010 #d24:000000000000000000000010)))
