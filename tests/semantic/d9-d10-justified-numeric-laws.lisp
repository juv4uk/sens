; Вісім законів обґрунтованих фактів і точної числової нерівності.
; Перевіряється додавання, вилучення фактів і збереження підтримок.
; Математичні операнди подано десятково, без машинних літералів.
(список
  (обґрунтований-член? (як-є а)
    (список
      (створити-обґрунтований (як-є б) (список (як-є свідок-б)))
      (створити-обґрунтований (як-є а) (список (як-є свідок-а)))))
  (хибне? (обґрунтований-член? (як-є в)
    (список
      (створити-обґрунтований (як-є б) (список (як-є свідок-б)))
      (створити-обґрунтований (як-є а) (список (як-є свідок-а))))))
  (однакові?
    (видалити-обґрунтований (як-є а)
      (список
        (створити-обґрунтований (як-є а) (список (як-є свідок-1)))
        (створити-обґрунтований (як-є б) (список (як-є свідок-2)))
        (створити-обґрунтований (як-є а) (список (як-є свідок-3)))))
    (список (створити-обґрунтований (як-є б) (список (як-є свідок-2)))))
  (однакові?
    (видалити-обґрунтований (як-є в)
      (список
        (створити-обґрунтований (як-є а) (список (як-є свідок-1)))
        (створити-обґрунтований (як-є б) (список (як-є свідок-2)))))
    (список
      (створити-обґрунтований (як-є а) (список (як-є свідок-1)))
      (створити-обґрунтований (як-є б) (список (як-є свідок-2)))))
  (однакові?
    (створити-обґрунтований (як-є факт) (список (як-є доказ)))
    (сполучити (як-є факт) (список (як-є доказ))))
  (однакові?
    (обрізати-обґрунтування
      (список
        (створити-обґрунтований (як-є живий) (список (як-є доказ)))
        (створити-обґрунтований (як-є без-доказу) (як-є ()))))
    (список (створити-обґрунтований (як-є живий) (список (як-є доказ)))))
  (числа-нерівні? (довжина (як-є (а б))) (довжина (як-є (а б в))))
  (хибне? (числа-нерівні? (довжина (як-є (а б))) (довжина (як-є (а б))))))
