; Д4: негативний контрприклад до визначення атома.
; Мутант помилково припускає, що непорожня пара також є атомом.
; Правильна мова повертає Д1:ні; неправильний D1:так спричиняє CAR NIL.
(за-умовою
  ((атом? (як-є пошкоджений-хвіст))
   (за-умовою
     ((хибне? (порожній? (як-є пошкоджений-хвіст)))
      (за-умовою
        ((атом? (як-є (радіо антена))) (перше (як-є ())))
        (так ні)))
     (так ні)))
  (так ні))
