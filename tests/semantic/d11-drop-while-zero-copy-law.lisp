; Д11: ранній D1:ні зупиняє відкидання, але не перевірку структури.
; Збережені порядок, кратність і вкладені D3:() як звичайні елементи.
(за-умовою
  ((хибне?
     (однакові?
       (відкинути-поки-доменний-предикат
         (функція (елемент) (хибне? елемент))
         (список ні ні так ні))
       (список так ні)))
   ні)
  ((хибне?
     (однакові?
       (відкинути-поки-доменний-предикат
         порожній?
         (список (як-є ()) (як-є ()) так (як-є ())))
       (список так (як-є ()))))
   ні)
  ((хибне?
     (порожній?
       (відкинути-поки-доменний-предикат
         (функція (елемент) (перше (як-є ())))
         (як-є ()))))
   ні)
  (так так))
