; Шість перевірок позиції першого збігу та рівності дерев.
; Перший збіг має десятковий індекс, відсутній збіг є порожнім.
(список
  (однакові?
    (позиція-першого-збігу
      (функція (кандидат) (атом? кандидат))
      (список (список (як-є а)) (як-є б) (як-є в)))
    1)
  (порожній?
    (позиція-першого-збігу
      (функція (кандидат) (атом? кандидат))
      (список (список (як-є а)) (список (як-є б)))))
  (однакові?
    (позиція-першого-збігу
      (функція (кандидат) (атом? кандидат))
      (список (як-є а) (список (як-є б))))
    0)
  (однакові?
    (позиція-першого-збігу
      (функція (кандидат) (атом? кандидат))
      (список (список (як-є а)) (як-є б)))
    0)
  (дерева-рівні?
    (список (як-є а) (список (як-є б)))
    (список (як-є а) (список (як-є б))))
  (дерева-рівні?
    (список (як-є а) (список (як-є б)))
    (список (як-є а) (список (як-є в)))))
