; Закони округлення вниз і побітового заперечення.
; Чотири перевірки знаків частки й чотири знакові тотожності.
(список
  (однакові? (округлити-вниз 7 3) 2)
  (однакові? (округлити-вниз (змінити-знак 7) 3) (змінити-знак 3))
  (однакові? (округлити-вниз 7 (змінити-знак 3)) (змінити-знак 3))
  (однакові? (округлити-вниз (змінити-знак 7) (змінити-знак 3)) 2)
  (однакові? (побітове-не 0) (змінити-знак 1))
  (однакові? (побітове-не 3) (змінити-знак 4))
  (однакові? (побітове-не (змінити-знак 1)) 0)
  (однакові? (побітове-не (змінити-знак 2)) 1))
