((lambda (дерево)
  (list
    (eq? (р-п-п-п дерево) (quote б))
    (not? (eq? (р-п-п-п дерево) (quote ж)))
    (eq? (р-п-п-р дерево) (quote з))
    (not? (eq? (р-п-п-р дерево) (quote ж)))
    (eq? (р-п-р-п дерево) (quote д))
    (not? (eq? (р-п-р-п дерево) (quote и)))
    (eq? (р-п-р-р дерево) (quote й))
    (not? (eq? (р-п-р-р дерево) (quote і)))
    (eq? (р-р-п-п дерево) (quote г))
    (not? (eq? (р-р-п-п дерево) (quote ї)))
    (eq? (р-р-п-р дерево) (quote і))
    (not? (eq? (р-р-п-р дерево) (quote й)))
    (eq? (р-р-р-п дерево) (quote є))
    (not? (eq? (р-р-р-п дерево) (quote к)))
    (eq? (р-р-р-р дерево) (quote л))
    (not? (eq? (р-р-р-р дерево) (quote к)))
    (eq? (п-п-п-п дерево) (quote а))
    (not? (eq? (п-п-п-п дерево) (quote б)))
    (eq? (п-п-п-р дерево) (quote ж))
    (not? (eq? (п-п-п-р дерево) (quote б)))
    (eq? (п-п-р-п дерево) (quote ґ))
    (not? (eq? (п-п-р-п дерево) (quote в)))
    (eq? (п-п-р-р дерево) (quote ї))
    (not? (eq? (п-п-р-р дерево) (quote г)))
    (eq? (п-р-п-п дерево) (quote в))
    (not? (eq? (п-р-п-п дерево) (quote ґ)))
    (eq? (п-р-п-р дерево) (quote и))
    (not? (eq? (п-р-п-р дерево) (quote д)))
    (eq? (п-р-р-п дерево) (quote е))
    (not? (eq? (п-р-р-п дерево) (quote є)))
    (eq? (п-р-р-р дерево) (quote к))
    (not? (eq? (п-р-р-р дерево) (quote є)))))
 (cons (cons (cons (cons (quote а) (quote б)) (cons (quote в) (quote г))) (cons (cons (quote ґ) (quote д)) (cons (quote е) (quote є)))) (cons (cons (cons (quote ж) (quote з)) (cons (quote и) (quote і))) (cons (cons (quote ї) (quote й)) (cons (quote к) (quote л))))))
