; D9 FS: з двох чинних асоціативних записів утворюється мапа.
; Перевірку присутності ключів виконує SENS (точний D1), не Rust.
(визначити свідок-д9-фс-мапа
  (фс-зв'язки-з-список
    (список
      (сполучити (як-є перший) (як-є значення-а))
      (сполучити (як-є другий) (як-є значення-б)))
    (мапа-порожній)))

(за-умовою
  ((внутрішня-мапа-містить (як-є перший) свідок-д9-фс-мапа)
   (внутрішня-мапа-містить (як-є другий) свідок-д9-фс-мапа))
  (так ні))
