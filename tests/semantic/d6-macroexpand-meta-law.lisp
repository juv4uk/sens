; Д6 MACROEXPAND-1 / MACROEXPAND — позитивний закон у власному SENS.
; Потрібно завантажити lib/meta-eval.lisp і lib/d6-macroexpand-meta.lisp.
; Лексичний макрос повертає форму (як-є готово), НЕ виконує її.
(визначити д6-приклад-макрос
  (список
    (як-є macro)
    (список (як-є вхід))
    (список (як-є (як-є (як-є готово))))
    (як-є ())))

(визначити д6-приклад-оточення
  (список
    (сполучити (як-є тестовий-макрос) д6-приклад-макрос)))

(визначити д6-приклад-форма
  (як-є (тестовий-макрос (як-є дані))))

(визначити д6-приклад-один
  (розгорнути-макрос-1 д6-приклад-форма д6-приклад-оточення))

(визначити д6-приклад-повний
  (розгорнути-макрос д6-приклад-форма д6-приклад-оточення))

; Ближня лексична прив'язка не є макросом: не розгортаємо.
(визначити д6-приклад-затінене
  (розгорнути-макрос-1
    д6-приклад-форма
    (сполучити
      (сполучити (як-є тестовий-макрос) ні)
      д6-приклад-оточення)))

; Макрос, який розгортається у самого себе, має дати помилку,
; а не переповнити стек і не удавати успішну стабілізацію.
(визначити д6-приклад-макрос-цикл
  (список
    (як-є macro)
    (список (як-є вхід))
    (список (як-є (як-є (тестовий-макрос (як-є дані)))))
    (як-є ())))

(визначити д6-приклад-цикл
  (розгорнути-макрос
    д6-приклад-форма
    (список
      (сполучити (як-є тестовий-макрос)
        д6-приклад-макрос-цикл))))

; Д1 так тільки якщо всі твердження виконуються незалежно.
(за-умовою
  ((це-результат-невдалого-обчислення? д6-приклад-один) ні)
  ((хибне? (перше (решта д6-приклад-один))) ні)
  ((хибне?
     (однакові?
       (решта (решта д6-приклад-один))
       (як-є (як-є готово))))
   ні)
  ((це-результат-невдалого-обчислення? д6-приклад-повний) ні)
  ((хибне?
     (однакові?
       (решта д6-приклад-повний)
       (як-є (як-є готово))))
   ні)
  ((це-результат-невдалого-обчислення? д6-приклад-затінене) ні)
  ((перше (решта д6-приклад-затінене)) ні)
  ((хибне?
     (однакові?
       (решта (решта д6-приклад-затінене))
       д6-приклад-форма))
   ні)
  ((хибне?
     (це-результат-невдалого-обчислення? д6-приклад-цикл))
   ні)
  (так так))
