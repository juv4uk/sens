; Д11 ALIST-VALUE-PRESENCE: чотири закони розділення наявності і даних.
; Знайдене D1:ні НЕ є відсутнім ключем.
(за-умовою
  ((однакові?
     (знайти-значення-запису-із-наявністю
       тотожне? так (список (сполучити так ні)))
     (список так ні))
   так)
  (так (перше (як-є ()))))
; Знайдений структурний D3 () так само має окремий D1:так.
(за-умовою
  ((однакові?
     (знайти-значення-запису-із-наявністю
       тотожне? так (список (сполучити так (як-є ()))))
     (список так (як-є ())))
   так)
  (так (перше (як-є ()))))
; Відсутність — (D1:ні D3:()), не один із знайдених порожніх результатів.
(за-умовою
  ((однакові?
     (знайти-значення-запису-із-наявністю
       тотожне? ні (список (сполучити так ні)))
     (список ні (як-є ())))
   так)
  (так (перше (як-є ()))))
; Перший із двох однакових ключів зберігає своє D1:ні.
(за-умовою
  ((однакові?
     (знайти-значення-запису-із-наявністю
       тотожне? так
       (список (сполучити так ні)
               (сполучити так (як-є ()))))
     (список так ні))
   так)
  (так (перше (як-є ()))))
; D3 NULL — єдина база alist, атомна D3 EQ тут не потрібна.
; D1:ні не є порожнім списком; коректна пара — повноцінний запис.
(за-умовою
  ((правильна-таблиця-асоціацій? (як-є ())) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне? (правильна-таблиця-асоціацій? ні)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((правильна-таблиця-асоціацій?
     (список (сполучити так ні))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне?
     (правильна-таблиця-асоціацій?
       (сполучити (сполучити так ні) ні))) так)
  (так (перше (як-є ()))))

; Порожній alist не викликає навіть предикат, що спричинив би D3 CAR Type.
(за-умовою
  ((однакові?
     (знайти-значення-запису-із-наявністю
       (функція (лівий правий) (перше (як-є ())))
       так (як-є ()))
     (список ні (як-є ())))
   так)
  (так (перше (як-є ()))))
(атом? (як-є ()))
