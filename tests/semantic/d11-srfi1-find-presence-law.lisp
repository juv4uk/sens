; Д11 FIND-PRESENCE: усі свідки виконуються лише в тестовому файлі.
; Бібліотека має тільки єдине чинне SENS DEFINE: імпорт не є тестом.
; Допоміжні DEFINE нижче локальні для фізичного позитивного закону.
; У фізичному SENS Д3 EQ порівнює лише атоми.
; Списковий результат розбираємо через Д3 ПЕРШЕ/Д4 ДРУГЕ,
; а не застосовуємо атомну тотожність до цілої пари.

; Для фізичного reader SENS викличні голови мають бути іменованими.
; Однакові закони свідків не розмножуємо анонімними головами ФУНКЦІЯ.
; Невдалий закон спричиняє справжню помилку Д3 ПЕРШЕ від ().
(визначити довести-знайдене-ні
  (функція (результат)
    (за-умовою
      ((перше результат)
       (за-умовою
         ((хибне? (друге результат)) так)
         (так (перше (як-є ())))))
      (так (перше (як-є ()))))))

(визначити довести-знайдене-порожнє
  (функція (результат)
    (за-умовою
      ((перше результат)
       (за-умовою
         ((порожній? (друге результат)) так)
         (так (перше (як-є ())))))
      (так (перше (як-є ()))))))

(визначити довести-відсутність-значення
  (функція (результат)
    (за-умовою
      ((хибне? (перше результат))
       (за-умовою
         ((порожній? (друге результат)) так)
         (так (перше (як-є ())))))
      (так (перше (як-є ()))))))

; Знайдений Д1:НІ є елементом, а не відсутністю.
(довести-знайдене-ні
  (знайти-перший-із-наявністю
    (функція (елемент) (хибне? елемент))
    (список так ні так)))

; Структурне () — знайдене значення із незалежним прапорцем ТАК.
(довести-знайдене-порожнє
  (знайти-перший-із-наявністю
    порожній?
    (список (як-є атом?) (як-є ()))))

; Відсутність: на списку тільки з Д1 ТАК предикат НЕ знаходить Д1 НІ.
(довести-відсутність-значення
  (знайти-перший-із-наявністю
    (функція (елемент) (хибне? елемент))
    (список так так)))

; Порожній список не обчислює предикат із помилковим тілом.
(довести-відсутність-значення
  (знайти-перший-із-наявністю
    (функція (елемент) (перше (як-є ())))
    (як-є ())))

; Перевірка форми передує короткому замиканню предиката.
(довести-знайдене-ні
  (знайти-перший-із-наявністю
    (функція (елемент) (хибне? елемент))
    (список ні так)))

; Негативний мутант: коли знайдено НІ, прапорець НЕ стає НІ.
(довести-знайдене-ні
  (знайти-перший-із-наявністю
    (функція (елемент) (хибне? елемент))
    (список ні)))

; Завершальний мовний вердикт.
(атом? (як-є ()))

; Незалежний позитив D1:1 доповнює перенесені мовні закони.
; Д11 FIND-PRESENCE: незалежна ознака наявності, D1:ні ≠ D3:().
; Перетворення результату й очікування виконуються тільки мовою СЕНС.
(за-умовою
  ((однакові?
     (знайти-перший-із-наявністю
       (функція (значення) (хибне? значення))
       (список так ні так))
     (список так ні))
   (за-умовою
     ((однакові?
        (знайти-перший-із-наявністю
          порожній?
          (список (як-є ())))
        (список так (як-є ())))
      (за-умовою
        ((однакові?
           (знайти-перший-із-наявністю
             (функція (значення) (хибне? значення))
             (список так так))
           (список ні (як-є ())))
         так)
        (так ні)))
     (так ні)))
  (так ні))
