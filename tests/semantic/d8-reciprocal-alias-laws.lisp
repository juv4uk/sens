; Вісім законів оберненого числа та оберненої функції.
; Перевіряємо одиницю, додатні значення та від'ємну одиницю.
; Всі математичні числа записані десятково.
; Два негативні приклади відхиляють неправильну рівність.

(список
  (однакові? (обернене-число 1)
          1)
  (однакові? (обернене-число 2)
          (обернене 2))
  (однакові? (обернене-число (обернене-число 2))
          2)
  (однакові? (обернене-число (відняти 0
                                    1))
          (відняти 0
                   1))
  (однакові? (модуль (обернене-число (відняти 0
                                            1)))
          1)
  (однакові? (обернене-число 3)
          (обернене 3))
  (хибне? (однакові? (обернене-число 2)
                2))
  (хибне? (однакові? (обернене-число (відняти 0
                                          1))
                1)))
