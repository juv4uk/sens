; D8:11011010 / D9:001100011,001110111,001100110,010111000.
; Кожен закон повертає рівно D1:1; останній контроль перевіряє хибну орієнтацію.
(список
  (equal? (кліпс-слот-ім'я (quote (slot колір))) (quote колір))
  (equal? (кліпс-слот-імена
             (quote ((slot колір) (slot вік))))
          (quote (колір вік)))
  (equal? (кліпс-визначити-шаблон-слоти
             (quote (deftemplate тварина (slot вид) (slot колір))))
          (quote (вид колір)))
  (equal? (кліпс-факт-клауза (quote (колір лис рудий)))
          (quote ((колір лис рудий))))
  (equal? (решта-від-позиції 0 (quote (а б в))) (quote (а б в)))
  (equal? (решта-від-позиції 2 (quote (а б в))) (quote (в)))
  (not? (equal? (кліпс-слот-імена (quote ((slot колір) (slot вік))))
                (quote (вік колір)))))
