; D8:11011010 / D9:001100011,001110111,001100110,010111000.
; Кожен закон повертає рівно D1:1; останній контроль перевіряє хибну орієнтацію.
(список
  (equal? (кліпс-слот-ім'я (як-є (slot колір))) (як-є колір))
  (equal? (кліпс-слот-імена
             (як-є ((slot колір) (slot вік))))
          (як-є (колір вік)))
  (equal? (кліпс-визначити-шаблон-слоти
             (як-є (deftemplate тварина (slot вид) (slot колір))))
          (як-є (вид колір)))
  (equal? (кліпс-факт-клауза (як-є (колір лис рудий)))
          (як-є ((колір лис рудий))))
  (equal? (решта-від-позиції 0 (як-є (а б в))) (як-є (а б в)))
  (equal? (решта-від-позиції 2 (як-є (а б в))) (як-є (в)))
  (хибне? (equal? (кліпс-слот-імена (як-є ((slot колір) (slot вік))))
                (як-є (вік колір)))))

