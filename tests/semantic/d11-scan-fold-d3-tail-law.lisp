; D11 reductions та pair-fold: точна D3-структура й порядок D1-значень.
; Позитивні закони обчислює тільки SENS.
(за-умовою
  ((однакові?
     (накопичити-проміжні-стани
       (функція (стан елемент) елемент)
       так (список ні так))
     (список так ні так))
   (за-умовою
     ((однакові?
        (згорнути-по-хвостах-зліва
          (функція (хвіст стан) (перше хвіст))
          ні (список ні так))
        так)
      (однакові?
        (згорнути-по-хвостах-справа
          (функція (хвіст стан) (перше хвіст))
          так (список ні так))
        ні))
     (так ні)))
  (так ні))
