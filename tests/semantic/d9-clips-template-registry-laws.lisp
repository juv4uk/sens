; Вісім мовних законів реєстру шаблонів CLIPS у D9.
; Зовнішні назви deftemplate, slot і deffacts зберігаємо
; як цитовані протокольні дані, а не перейменовуємо на виклики.

(список
  (однакові? (кліпс-визначити-шаблон-ім'я (як-є (deftemplate читання (slot датчик))))
          (як-є читання))
  (однакові? (кліпс-шаблони-з-форми (як-є ())) (як-є ()))
  (однакові? (кліпс-шаблони-з-форми (як-є ((deffacts набір (факт)))))
          (як-є ()))
  (однакові?
    (кліпс-шаблони-з-форми
      (як-є ((deftemplate читання (slot датчик) (slot значення)))))
    (як-є ((читання датчик значення))))
  (однакові?
    (кліпс-шаблони-з-форми
      (як-є ((deffacts шум (сигнал))
              (deftemplate перший (slot а))
              (deftemplate другий (slot б)))))
    (як-є ((перший а) (другий б))))
  (однакові?
    (кліпс-шаблон-слот-порядок
      (як-є другий)
      (кліпс-шаблони-з-форми
        (як-є ((deftemplate перший (slot а))
                (deftemplate другий (slot б))))))
    (як-є (б)))
  (однакові?
    (кліпс-шаблон-слот-порядок
      (як-є відсутній)
      (кліпс-шаблони-з-форми
        (як-є ((deftemplate перший (slot а))))))
    (як-є ()))
  (однакові?
    (кліпс-шаблони-з-форми
      (як-є (((deftemplate) помилкове)
              (deftemplate робоче (slot дані)))))
    (як-є ((робоче дані)))))
