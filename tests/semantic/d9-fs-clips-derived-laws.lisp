; D9 FS/CLIPS: вісім точних D1-законів українських поверхонь.
(список
  (equal? (фс-об'єкт-адреси (quote ())) (quote ()))
  (equal? (фс-об'єкт-адреси
            (список (сполучити (quote адреса-а) (quote вміст-а))))
          (список (quote адреса-а)))
  (equal? (фс-об'єкт-адреси
            (список (сполучити (quote адреса-а) (quote вміст-а))
                  (сполучити (quote адреса-б) (quote вміст-б))))
          (список (quote адреса-а) (quote адреса-б)))
  (equal? (clips-змінна-терм (quote ?x))
          (список (quote var) (quote x)))
  (equal? (clips-змінна-терм (quote ?slot))
          (список (quote var) (quote slot)))
  (equal? (clips-шаблон-слот-порядок
            (quote персона)
            (список (сполучити (quote персона) (список (quote слот-а) (quote слот-б)))))
          (список (quote слот-а) (quote слот-б)))
  (equal? (clips-шаблон-слот-порядок
            (quote відсутнє)
            (список (сполучити (quote персона) (список (quote слот-а)))))
          (quote ()))
  (equal? (clips-шаблон-слот-порядок
            (quote персона)
            (список (quote пошкоджений)
                  (сполучити (quote персона) (список (quote слот-а)))))
          (список (quote слот-а))))

