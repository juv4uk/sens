; Вісім точних законів дев'ятого домену для файлових операцій і правил кліпс.
(список
  (однакові? (фс-об'єкт-адреси (як-є ())) (як-є ()))
  (однакові? (фс-об'єкт-адреси
            (список (сполучити (як-є адреса-а) (як-є вміст-а))))
          (список (як-є адреса-а)))
  (однакові? (фс-об'єкт-адреси
            (список (сполучити (як-є адреса-а) (як-є вміст-а))
                  (сполучити (як-є адреса-б) (як-є вміст-б))))
          (список (як-є адреса-а) (як-є адреса-б)))
  (однакові? (кліпс-змінна-терм (як-є ?x))
          (список (як-є var) (як-є x)))
  (однакові? (кліпс-змінна-терм (як-є ?slot))
          (список (як-є var) (як-є slot)))
  (однакові? (кліпс-шаблон-слот-порядок
            (як-є персона)
            (список (сполучити (як-є персона) (список (як-є слот-а) (як-є слот-б)))))
          (список (як-є слот-а) (як-є слот-б)))
  (однакові? (кліпс-шаблон-слот-порядок
            (як-є відсутнє)
            (список (сполучити (як-є персона) (список (як-є слот-а)))))
          (як-є ()))
  (однакові? (кліпс-шаблон-слот-порядок
            (як-є персона)
            (список (як-є пошкоджений)
                  (сполучити (як-є персона) (список (як-є слот-а)))))
          (список (як-є слот-а))))

