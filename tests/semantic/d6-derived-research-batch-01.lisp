; Десять законів пошуку за значенням і перевірки предикатів.
; Парний хвіст пропускається до атомного D3 EQ; наступний атомний збіг шукається.
; Пара як запит також відхиляється до порівняння.
; Усі викличні голови взято з повної української проєкції.
; Правильні й хибні результати перевіряються самою мовою СЕНС.
(список
  (однакові?
    (знайти-за-значенням (як-є значення-два)
      (список (сполучити (як-є ключ-структурний)
                        (сполучити (як-є значення-два) (як-є ())))
              (сполучити (як-є ключ-один) (як-є значення-один))
              (сполучити (як-є ключ-два) (як-є значення-два))))
    (сполучити (як-є ключ-два) (як-є значення-два)))
  (порожній? (знайти-за-значенням (як-є невідоме)
    (список (сполучити (як-є ключ-структурний)
                        (сполучити (як-є значення-два) (як-є ())))
            (сполучити (як-є ключ-один) (як-є значення-один)))))
  (порожній? (знайти-за-значенням (як-є ключ-два)
    (список (сполучити (як-є ключ-два) (як-є значення-два)))))
  (хибне? (будь-яке? (функція (х) (однакові? х (як-є є))) (як-є ())))
  (будь-яке? (функція (х) (однакові? х (як-є є)))
             (список (як-є нема) (як-є є)))
  (хибне? (будь-яке? (функція (х) (однакові? х (як-є є)))
                     (список (як-є нема) (як-є ні))))
  (усі? (функція (х) (однакові? х (як-є є))) (як-є ()))
  (усі? (функція (х) (однакові? х (як-є є)))
        (список (як-є є) (як-є є)))
  ; Пара як шукане значення не передається до атомного D3 EQ.
  (порожній? (знайти-за-значенням
    (сполучити (як-є значення-два) (як-є ()))
    (список (сполучити (як-є ключ-два) (як-є значення-два)))))
  (хибне? (усі? (функція (х) (однакові? х (як-є є)))
              (список (як-є є) (як-є нема)))))
