; Д11: фізичний наскрізний закон «групування → унарна кратність».
; Не суміжність, а тотожність ключа: а,б,а,в,б → а:2, б:2, в:1.
; Другий закон перевіряє проєкцію складеного елемента на перший ключ.
; Порядок ключів зберігає першу появу; джерело істини — тільки SENS.
(за-умовою
  ((однакові?
     (частоти-елементів-унарно (як-є (а б а в б)))
     (як-є ((а (о о)) (б (о о)) (в (о)))))
   (за-умовою
     ((однакові?
        (частоти-за-ключем-унарно
          (функція (елемент) (перше елемент))
          (як-є ((б х) (а у) (б к) (в м) (а н))))
        (як-є ((б (о о)) (а (о о)) (в (о)))))
      так)
     (так ні)))
  (так ні))
