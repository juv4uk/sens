; Десять законів розділення правила та складання висновків КЛІПС.
; Протокольні позначки збережено в цитуванні без нового допуску команд.
(список
  (однакові? (розділити-правило-кліпс (як-є ()))
          (як-є (() ())))
  (однакові? (розділити-правило-кліпс
            (як-є (=> (assert (готово)))))
          (як-є (() ((assert (готово))))))
  (однакові? (розділити-правило-кліпс
            (як-є ((умова-а) => (assert (факт-а)))))
          (як-є (((умова-а)) ((assert (факт-а))))))
  (однакові? (розділити-правило-кліпс
            (як-є ((умова-а) (умова-б) => (assert (факт-а)) (assert (факт-б)))))
          (як-є (((умова-а) (умова-б))
                  ((assert (факт-а)) (assert (факт-б))))))
  (однакові? (розділити-правило-кліпс
            (як-є ((умова-а) (умова-б))))
          (як-є (((умова-а) (умова-б)) ())))
  (однакові? (розділити-правило-кліпс
            (як-є (((=>) умова-а) => хвіст)))
          (як-є ((((=>) умова-а)) (хвіст))))
  (однакові? (зібрати-висновки-кліпс (як-є ()))
          (як-є ()))
  (однакові? (зібрати-висновки-кліпс
            (як-є ((assert (факт-а)))))
          (як-є ((факт-а))))
  (однакові? (зібрати-висновки-кліпс
            (як-є ((assert (факт-а) (факт-б)))))
          (як-є ((факт-а) (факт-б))))
  (однакові? (зібрати-висновки-кліпс
            (як-є ((assert (факт-а))
                    (assert (факт-б) (факт-в)))))
          (як-є ((факт-а) (факт-б) (факт-в)))))
