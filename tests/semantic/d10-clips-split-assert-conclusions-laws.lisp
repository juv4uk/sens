; D10 CLIPS — 10 фізичних D1-законів split-at-arrow + assert-conclusions.
; Лише похідні функції SENS: не прямий допуск D10 opcode.
(список
  (equal? (розділити-правило-кліпс (як-є ()))
          (як-є (() ())))
  (equal? (розділити-правило-кліпс
            (як-є (=> (assert (готово)))))
          (як-є (() ((assert (готово))))))
  (equal? (розділити-правило-кліпс
            (як-є ((умова-а) => (assert (факт-а)))))
          (як-є (((умова-а)) ((assert (факт-а))))))
  (equal? (розділити-правило-кліпс
            (як-є ((умова-а) (умова-б) => (assert (факт-а)) (assert (факт-б)))))
          (як-є (((умова-а) (умова-б))
                  ((assert (факт-а)) (assert (факт-б))))))
  (equal? (розділити-правило-кліпс
            (як-є ((умова-а) (умова-б))))
          (як-є (((умова-а) (умова-б)) ())))
  (equal? (розділити-правило-кліпс
            (як-є (((=>) умова-а) => хвіст)))
          (як-є ((((=>) умова-а)) (хвіст))))
  (equal? (зібрати-висновки-кліпс (як-є ()))
          (як-є ()))
  (equal? (зібрати-висновки-кліпс
            (як-є ((assert (факт-а)))))
          (як-є ((факт-а))))
  (equal? (зібрати-висновки-кліпс
            (як-є ((assert (факт-а) (факт-б)))))
          (як-є ((факт-а) (факт-б))))
  (equal? (зібрати-висновки-кліпс
            (як-є ((assert (факт-а))
                    (assert (факт-б) (факт-в)))))
          (як-є ((факт-а) (факт-б) (факт-в)))))

