; Закон у стилі Gabriel takl/div2: унарне «число» = довжина списку одиниць.
; (унарне-відняти xs) скидає один елемент; порожнє лишається порожнім.

(визначити унарне-відняти
  (функція (залишок)
    (за-умовою
      ((атом? залишок) (як-є ()))
      (так (решта залишок)))))

(визначити свідок-унарного
  (функція ()
    (нехай ((три (сполучити (як-є одиниця)
                    (сполучити (як-є одиниця)
                      (сполучити (як-є одиниця) (як-є ())))))
            (два (унарне-відняти три)))
      (за-умовою
        ((тотожне? (перше два) (як-є одиниця))
         (за-умовою
           ((тотожне? (перше (решта два)) (як-є одиниця))
            (за-умовою
              ((атом? (решта (решта два)))
               (як-є (закон-унарне-віднімання (status pass))))
              (так (як-є (закон-унарне-віднімання (status fail))))))
           (так (як-є (закон-унарне-віднімання (status fail))))))
        (так (як-є (закон-унарне-віднімання (status fail))))))))

(свідок-унарного)
