; D11 F11-TREE-TEST: нативна мова SENS дає точний D1:так.
; Бібліотека: lib/d11-tree-equal-by-test.lisp (передається як binding-source).
; Доказ: пара/пара, точковий хвіст, атом/пара, довільний тест листків.
; Невиконання будь-якого закону повертає D1:ні.

; Напрям передавання листків у першокласний SENS-порівнювач істотний:
; D1:ні зліва приймається, D1:так зліва відхиляється.
; На завершальних D3:() перевіряємо тільки структурну порожнечу.
(визначити порівняти-листки-спрямовано
  (функція (лівий правий)
    (за-умовою
      ((порожній? лівий) (порожній? правий))
      ((хибне? лівий) так)
      (так ні))))

(за-умовою
  ((хибне?
     (дерева-рівні-за-тестом?
       (сполучити (як-є а)
         (сполучити (як-є б) (як-є ())))
       (сполучити (як-є а)
         (сполучити (як-є б) (як-є ())))
       (функція (лівий правий) (тотожне? лівий правий))))
   ні)
  ((хибне?
     (дерева-рівні-за-тестом?
       (сполучити (як-є а) (як-є б))
       (сполучити (як-є в) (як-є г))
       (функція (лівий правий) так)))
   ні)
  ((дерева-рівні-за-тестом?
     (як-є а) (як-є а)
     (функція (лівий правий) ні))
   ні)
  ((дерева-рівні-за-тестом?
     (як-є а) (сполучити (як-є а) (як-є ()))
     (функція (лівий правий) так))
   ні)
  ((дерева-рівні-за-тестом?
     (сполучити (як-є а) (сполучити (як-є б) (як-є ())))
     (сполучити (як-є а)
       (сполучити (сполучити (як-є б) (як-є ())) (як-є ())))
     (функція (лівий правий) так))
   ні)
  ; Для однакової парної форми порядок аргументів тесту не можна міняти.
  ((хибне?
     (дерева-рівні-за-тестом?
       (сполучити ні (як-є ()))
       (сполучити так (як-є ()))
       порівняти-листки-спрямовано))
   ні)
  ((дерева-рівні-за-тестом?
     (сполучити так (як-є ()))
     (сполучити ні (як-є ()))
     порівняти-листки-спрямовано)
   ні)
  (так так))
