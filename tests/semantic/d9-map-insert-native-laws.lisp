; Дев'ять законів незмінної мапи та перетворення вектора на список.
; Запис наявного ключа замінює значення, але не дублює ключ.
; Четверта перевірка навмисно дає ні, бо старе значення замінено.
; Числові величини та всі імена набираються українською клавіатурою.
(список
  (однакові?
    (мапа-отримати (як-є ключ)
      (мапа-вставити (як-є ключ) (як-є значення) (мапа-порожній)))
    (список (як-є значення)))
  (мапа-містить? (як-є ключ)
    (мапа-вставити (як-є ключ) (як-є значення) (мапа-порожній)))
  (однакові?
    (мапа-отримати (як-є ключ)
      (мапа-вставити (як-є ключ) (як-є нове)
        (мапа-вставити (як-є ключ) (як-є старе) (мапа-порожній))))
    (список (як-є нове)))
  (однакові?
    (мапа-отримати (як-є ключ)
      (мапа-вставити (як-є ключ) (як-є нове)
        (мапа-вставити (як-є ключ) (як-є старе) (мапа-порожній))))
    (список (як-є старе)))
  (однакові?
    (довжина (мапа-список
      (мапа-вставити (як-є ключ) (як-є нове)
        (мапа-вставити (як-є ключ) (як-є старе) (мапа-порожній)))))
    число-один)
  (мапа-містить? (як-є ключ)
    (мапа-вставити (як-є інший-ключ) (як-є друге-значення)
      (мапа-вставити (як-є ключ) (як-є перше-значення) (мапа-порожній))))
  (мапа-містить? (як-є інший-ключ)
    (мапа-вставити (як-є інший-ключ) (як-є друге-значення)
      (мапа-вставити (як-є ключ) (як-є перше-значення) (мапа-порожній))))
  (однакові? (вектор-список (список (як-є перше-значення) (як-є друге-значення)))
          (список (як-є перше-значення) (як-є друге-значення)))
  (однакові? (вектор-список (вектор-порожній)) (як-є ())))
