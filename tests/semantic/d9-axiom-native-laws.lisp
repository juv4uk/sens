; Вісім законів аксіом, фактів та їхніх обґрунтувань.
; Аксіома має порожні підтримки, а помилкові збіги відхиляються.
(список
  (однакові? (аксіома (як-є факт))
             (створити-обґрунтований (як-є факт) (як-є ())))
  (порожній? (підтримки-від (аксіома (як-є факт))))
  (однакові? (факт-від (аксіома (як-є факт))) (як-є факт))
  (обґрунтований-член? (як-є факт) (список (аксіома (як-є факт))))
  (хибне? (обґрунтований-член? (як-є інший)
           (список (аксіома (як-є факт)))))
  (хибне? (однакові? (аксіома (як-є факт)) (аксіома (як-є інший))))
  (однакові? (видалити-обґрунтований (як-є факт)
                (список (аксіома (як-є факт)) (аксіома (як-є інший))))
             (список (аксіома (як-є інший))))
  (однакові? (обрізати-обґрунтування
                (список (аксіома (як-є факт))))
             (як-є ())))
