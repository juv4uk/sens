; Мовний закон D6 COMPOSE, FLIP, CURRY через D4 APPLY.
; Функції-значення передаємо як дані SENS, не викликаємо анонімну
; форму безпосередньо в голові іншого виклику.
(визначити вхід-композиції
  (сполучити так (сполучити ні (як-є ()))))

(визначити результат-композиції
  (застосувати
    (скласти-функції
      (функція (значення) (перше значення))
      (функція (значення) (решта значення)))
    (список вхід-композиції)))

(визначити результат-перестановки
  (застосувати
    (поміняти-аргументи
      (функція (лівий правий)
        (сполучити лівий (сполучити правий (як-є ())))))
    (список так ні)))

(визначити результат-часткового
  (застосувати
    (частково-застосувати
      (функція (голова хвіст) (сполучити голова хвіст))
      так)
    (список (як-є ()))))

(за-умовою
  ((хибне? (атом? результат-композиції)) ні)
  ((хибне? (тотожне? результат-композиції ні)) ні)
  ((хибне? (тотожне? (перше результат-перестановки) ні)) ні)
  ((хибне? (тотожне? (друге результат-перестановки) так)) ні)
  ((хибне? (тотожне? (перше результат-часткового) так)) ні)
  ((хибне? (порожній? (решта результат-часткового))) ні)
  (так так))
