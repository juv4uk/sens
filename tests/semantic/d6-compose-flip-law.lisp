; Мовний закон D6: COMPOSE, FLIP і CURRY — тільки через наявні функції SENS.
; Вирок має бути D1:так лише коли всі позитивні й негативні умови збережено.
; Немає числових машинних голів: усі перевірки працюють на символах і списках.

(та
  (тотожне?
    ((скласти-функції
       (функція (значення) (перше значення))
       (функція (значення) (решта значення)))
     (як-є (ліве праве)))
    (як-є праве))
  (хибне?
    (тотожне?
      ((скласти-функції
         (функція (значення) (перше значення))
         (функція (значення) (решта значення)))
       (як-є (ліве праве)))
      (як-є ліве)))
  (тотожне?
    (перше
      ((функція (зв'язана-дія)
         (зв'язана-дія (як-є ліве) (як-є праве)))
       (поміняти-аргументи
         (функція (лівий правий)
           (сполучити лівий (сполучити правий (як-є ())))))))
    (як-є праве))
  (тотожне?
    (перше
      (решта
        ((функція (зв'язана-дія)
           (зв'язана-дія (як-є ліве) (як-є праве)))
         (поміняти-аргументи
           (функція (лівий правий)
             (сполучити лівий (сполучити правий (як-є ()))))))))
    (як-є ліве))
  (однакові?
    ((частково-застосувати
       (функція (голова хвіст) (сполучити голова хвіст))
       (як-є а))
     (як-є ()))
    (список (як-є а)))
  (хибне?
    (однакові?
      ((частково-застосувати
         (функція (голова хвіст) (сполучити голова хвіст))
         (як-є а))
       (як-є ()))
      (список (як-є б))))
  ; D6:111100 ANY — пошук справжнього свідка та нуль на порожньому списку.
  (будь-яке?
    (функція (значення) (тотожне? значення (як-є б)))
    (як-є (а б)))
  (хибне?
    (будь-яке?
      (функція (значення) (тотожне? значення (як-є б)))
      (як-є ())))
  ; D6:111101 ALL — вакуозна істина, успіх і справжній контрприклад.
  (усі?
    (функція (значення) (тотожне? значення (як-є а)))
    (як-є ()))
  (усі?
    (функція (значення) (тотожне? значення (як-є а)))
    (як-є (а а)))
  (хибне?
    (усі?
      (функція (значення) (тотожне? значення (як-є а)))
      (як-є (а б))))
  ; D6:101110 REDUCE — ліве згортання з явним станом, не host fold.
  (однакові?
    (згорнути
      (функція (стан значення) (сполучити значення стан))
      (як-є ())
      (як-є (а б в)))
    (як-є (в б а)))
  ; D6:101111 SCAN — послідовність усіх станів, з початковим і кінцевим.
  (однакові?
    (накопичувати
      (функція (стан значення) (сполучити значення стан))
      (як-є ())
      (як-є (а б в)))
    (як-є (() (а) (б а) (в б а))))
  ; D6:111000/111001 — ZIP/UNZIP зберігає орієнтацію і порядок.
  (однакові?
    (розпарувати-пари
      (спарувати-послідовності
        (як-є (а б))
        (як-є (в г))))
    (як-є ((а б) (в г))))
  ; D6:110000/110001 — TAKE/DROP на одному D24 count із D6 LENGTH.
  (однакові?
    (взяти
      (довжина (як-є (а б)))
      (як-є (а б в)))
    (як-є (а б)))
  (однакові?
    (відкинути
      (довжина (як-є (а б)))
      (як-є (а б в)))
    (як-є (в)))
)
