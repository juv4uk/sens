; Позитивна семантика першокласного доменного коду доводиться самою мовою.
; Кожний невірний результат викликає помилку нативного СЕНС, а не Python/JSON.
; Д7 — лише українська поверхня, математика — Д24+.
(визначити виконати-двомісну-доменну
  (функція (операція ліве праве)
    (операція ліве праве)))
(визначити довести-точне-додавання-д5
  (функція (результат)
    (за-умовою
      ((менше? 41 результат)
       (за-умовою
         ((менше? результат 43) результат)
         (так (перше (як-є ())))))
      (так (перше (як-є ()))))))
; 20 + 22 = 42: виклик переданого Д5:01010 ДОДАТИ виконує сам СЕНС.
(довести-точне-додавання-д5
  (виконати-двомісну-доменну додати 20 22))
