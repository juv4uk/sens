; D24+: числові основи UTF-8 утворює сама SENS без D6 LENGTH.
; Незалежний позитивний Lisp-закон, фізичний носій створює Zig/T5M.
(за-умовою
  ((однакові? кодування-число-нуль число-нуль)
   (за-умовою
     ((однакові? кодування-число-один число-один)
      (за-умовою
        ((однакові? кодування-число-чотири
                     (помножити кодування-число-два кодування-число-два))
         (за-умовою
           ((однакові? кодування-число-шістнадцять
                        (помножити кодування-число-чотири кодування-число-чотири)) так)
           (так ні)))
        (так ні)))
     (так ні)))
  (так ні))
