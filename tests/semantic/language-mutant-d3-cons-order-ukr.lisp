; Д3: CONS зберігає порядок двох різних ратифікованих атомів.
; CAR читає голову, CAR(CDR(...)) — другий атом, CDR(CDR(...)) — порожній хвіст.
; Негативний мутант підміняє очікуваний другий атом та повертає Д1:ні.
; Умовні гілки SENS мають рівно дві частини: предикат та вираз.
(за-умовою
  ((тотожне?
     (перше (сполучити (як-є атом?)
       (сполучити (як-є решта) (як-є ()))))
     (як-є атом?))
   (за-умовою
     ((тотожне?
        (перше (решта (сполучити (як-є атом?)
          (сполучити (як-є решта) (як-є ())))))
        (як-є атом?))
      (порожній?
        (решта (решта (сполучити (як-є атом?)
          (сполучити (як-є решта) (як-є ())))))))
     (так ні)))
  (так ні))
