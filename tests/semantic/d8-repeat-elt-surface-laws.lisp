; Шість перевірок елемента за індексом, повторення та частки.
; Окремі визначення використовують українські назви і точні доменні закони.
; Числові аргументи подано людськими десятковими числами.

(визначити елемент-за-індексом
  (функція (послідовність індекс)
    (за-умовою
      ((нуль? індекс) (перше послідовність))
      ((порожній? послідовність) (як-є ()))
      ((хибне? (порожній? послідовність))
       (елемент-за-індексом
         (решта послідовність)
         (зменшити-на-1 індекс))))))

(список
  (однакові?
    (елемент-за-індексом
      (список (як-є а) (як-є б) (як-є в)) (довжина (як-є (а))))
    (як-є б))
  (однакові?
    (повторити (довжина (як-є (а б в))) (як-є х))
    (список (як-є х) (як-є х) (як-є х)))
  (однакові? (повторити (довжина (як-є ())) (як-є х)) (як-є ()))
  (порожній? (елемент-за-індексом (як-є ()) (довжина (як-є ()))))
  (однакові? (частка (довжина (як-є (а б в г ґ д е є ж з))) (довжина (як-є (а б)))) (довжина (як-є (а б в г ґ))))
  (однакові?
    (елемент-за-індексом (список (як-є а)) (довжина (як-є ())))
    (як-є а)))
