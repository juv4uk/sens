; Шість перевірок елемента за індексом, повторення та частки.
; Окремі визначення використовують українські назви і точні доменні закони.
; Числові аргументи подано людськими десятковими числами.

(визначити елемент-за-індексом
  (функція (послідовність індекс)
    (за-умовою
      ((нуль? індекс) (перше послідовність))
      ((порожній? послідовність) (як-є ()))
      ((хибне? (порожній? послідовність))
       (елемент-за-індексом
         (решта послідовність)
         (зменшити-на-1 індекс))))))

(визначити повторити
  (функція (кількість значення)
    (за-умовою
      ((нуль? кількість) (як-є ()))
      ((хибне? (нуль? кількість))
       (сполучити значення
         (повторити (зменшити-на-1 кількість) значення))))))

(список
  (однакові?
    (елемент-за-індексом
      (список (як-є а) (як-є б) (як-є в)) 1)
    (як-є б))
  (однакові?
    (повторити 3 (як-є х))
    (список (як-є х) (як-є х) (як-є х)))
  (однакові? (повторити 0 (як-є х)) (як-є ()))
  (порожній? (елемент-за-індексом (як-є ()) 0))
  (однакові? (частка 10 2) 5)
  (однакові?
    (елемент-за-індексом (список (як-є а)) 0)
    (як-є а)))
