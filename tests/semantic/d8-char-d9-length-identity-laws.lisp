; Десять свідків символьних індексів, довжини тексту й тотожності.
; Сім тверджень правильні, три наступні є навмисними спростуваннями.
(список
  (однакові? (символ "кіт" 0) "к")
  (однакові? (символ "кіт" 1) "і")
  (однакові? (символ "кіт" 2) "т")
  (числовий-рівність (рядок-довжина "") 0)
  (числовий-рівність (рядок-довжина "їж") 2)
  (однакові? (тотожність (список (як-є а) (як-є б)))
    (список (як-є а) (як-є б)))
  (канон-закон-решта-неправильний (як-є а) (як-є б))
  (однакові? (символ "кіт" 1) "т")
  (числовий-рівність (рядок-довжина "їж") 1)
  (тотожне? (решта (сполучити (як-є а) (як-є б))) (як-є а)))
