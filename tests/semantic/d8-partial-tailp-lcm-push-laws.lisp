; Вісім законів часткового застосування, спільного хвоста, кратного та додавання на початок.
; Локальні змінні й викличні голови мають українські імена.
; Усі математичні числа записані десятково, без бітових літералів.
(визначити застосувати-префікс частково-застосувати)
(визначити нск
  (функція (перший другий)
    (за-умовою
      ((або (нуль? перший) (нуль? другий)) 0)
      ((хибне? (або (нуль? перший) (нуль? другий)))
       (частка (помножити перший другий) (найбільший-спільний-дільник перший другий))))))
(визначити додати-на-початок
  (функція (елемент послідовність)
    (сполучити елемент послідовність)))
(визначити спільний-хвіст?
  (функція (хвіст послідовність)
    (за-умовою
      ((однакові? хвіст послідовність) так)
      ((порожній? послідовність) ні)
      ((хибне? (порожній? послідовність))
       (спільний-хвіст? хвіст (решта послідовність))))))
(список
  (однакові? ((застосувати-префікс сполучити (як-є х)) (як-є ()))
          (сполучити (як-є х) (як-є ())))
  (однакові? (додати-на-початок (як-є а) (список (як-є б)))
          (список (як-є а) (як-є б)))
  (тотожне?
    (спільний-хвіст?
      (список (як-є б) (як-є в))
      (список (як-є а) (як-є б) (як-є в)))
    так)
  (тотожне?
    (спільний-хвіст?
      (список (як-є а))
      (список (як-є б) (як-є в)))
    ні)
  (однакові? (нск 4
               6)
          12)
  (однакові? (нск 0
               5)
          0)
  (однакові? (додати-на-початок (як-є х) (як-є ()))
          (список (як-є х)))
  (спільний-хвіст? (як-є ()) (як-є ())))
