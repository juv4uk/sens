; D11: правильність множини визначає D3:(), а не загальна хибність.
; D1:ні допустимий як ЕЛЕМЕНТ списку, але не як його структурний хвіст.
; Позитивний закон повністю обчислюється SENS і повертає D1:так.
(за-умовою
  ((хибне? (правильна-множина? (як-є ()))) ні)
  ((хибне? (правильна-множина? (список ні так))) ні)
  ((хибне? (правильний-ланцюг-множин? (як-є ()))) ні)
  ((хибне? (правильний-ланцюг-множин? (список (список ні)))) ні)
  ((правильна-множина? ні) ні)
  ((правильна-множина? (сполучити так ні)) ні)
  ((правильний-ланцюг-множин? ні) ні)
  ((правильний-ланцюг-множин? (сполучити (список так) ні)) ні)
  ((правильний-ланцюг-множин? (список (сполучити так ні))) ні)
  (так так))
