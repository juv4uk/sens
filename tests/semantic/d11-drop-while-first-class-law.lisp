; D11 DROP-WHILE: повернути саме суфікс після початкових D1 ні.
(за-умовою
  ((однакові?
     (відкинути-поки-умова
       (функція (елемент) (хибне? елемент))
       (список ні ні так ні))
     (список так ні))
   так)
  (так (перше (як-є ()))))
; Вкладений D3 () є даними: лишити його у суфіксі.
(за-умовою
  ((однакові?
     (відкинути-поки-умова порожній?
       (список (як-є ()) (як-є ()) так (як-є ())))
     (список так (як-є ())))
   так)
  (так (перше (як-є ()))))
; Якщо немає початкових збігів — початковий список не змінюється.
(за-умовою
  ((однакові?
     (відкинути-поки-умова
       (функція (елемент) (хибне? елемент))
       (список так ні))
     (список так ні))
   так)
  (так (перше (як-є ()))))
; Коли збігаються всі елементи, результат є D3 ().
(за-умовою
  ((порожній?
     (відкинути-поки-умова
       (функція (елемент) (хибне? елемент))
       (список ні ні)))
   так)
  (так (перше (як-є ()))))
; Порожній вхід не викликає користувацького предиката.
(за-умовою
  ((порожній?
     (відкинути-поки-умова
       (функція (елемент) (перше (як-є ())))
       (як-є ())))
   так)
  (так (перше (як-є ()))))
(атом? (як-є ()))
