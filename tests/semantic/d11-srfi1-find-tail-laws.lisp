; Д11 SRFI-1 FIND-TAIL: закони власної мови SENS, українська Lisp-проєкція.
; Порівняння довільних D7-текстових символів виконує D8 ОДНАКОВІ?.
; D3 ТОТОЖНЕ? лишається для двох канонічних атомів: Type не є Д1:ні.
; Перед виконанням завантажити lib/d11-srfi1-find-tail.lisp.
; Сім хибних тверджень перевіряє ХИБНЕ?, а не таблиця Rust.
; Порушення закону відхиляється CAR порожнього списку самим SENS.

; Бібліотечні перевірки перенесено з lib/d11-srfi1-find-tail.lisp.
; Вони запускаються тільки як мовні свідки SENS, не під час завантаження DEFINE.
; Нативний свідок першокласного Д3:010 АТОМ? як переданої функції:
; перша голова складена, тож знайти-хвіст зберігає решту без копіювання.
(за-умовою
  ((однакові?
     (перше
       (знайти-хвіст-за-умовою
         атом?
         (список (список (як-є атом?)) (як-є решта) (як-є сполучити))))
     (як-є решта))
   (атом? (як-є ())))
  (так (перше (як-є ()))))

; Негативний закон: першокласний Д4 ПОРОЖНІЙ? повертає
; точне Д1:ні на ОБОХ непорожніх атомах. Д8 канонічне «значення»
; не можна використовувати як параметр анонімного замикання.
; Якщо хоча б один елемент хибно прийнято, нативний SENS завершує
; виконання помилкою через недопущений виклик ПЕРШЕ на порожньому.
(за-умовою
  ((знайти-хвіст-за-умовою
     порожній?
     (список (як-є атом?) (як-є решта)))
   (перше (як-є ())))
  (так так))

; порожній: закон.
(за-умовою
  ((хибне? (знайти-хвіст-за-умовою (функція (елемент) (однакові? елемент (як-є а))) (як-є ()))) так)
  (так (перше (як-є ()))))

; немає-збігу: закон.
(за-умовою
  ((хибне? (знайти-хвіст-за-умовою (функція (елемент) (однакові? елемент (як-є в))) (як-є (а б)))) так)
  (так (перше (як-є ()))))

; один-є: закон.
(за-умовою
  ((однакові? (знайти-хвіст-за-умовою (функція (елемент) (однакові? елемент (як-є а))) (як-є (а))) (як-є (а))) так)
  (так (перше (як-є ()))))

; перший: закон.
(за-умовою
  ((однакові? (знайти-хвіст-за-умовою (функція (елемент) (однакові? елемент (як-є а))) (як-є (а б в))) (як-є (а б в))) так)
  (так (перше (як-є ()))))

; середній: закон.
(за-умовою
