  (так (перше (як-є ()))))

; останній: закон.
(за-умовою
  ((однакові? (знайти-хвіст-за-умовою (функція (елемент) (однакові? елемент (як-є в))) (як-є (а б в))) (як-є (в))) так)
  (так (перше (як-є ()))))

; перший-з-повторів: закон.
(за-умовою
