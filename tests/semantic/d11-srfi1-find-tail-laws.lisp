  (так (перше (як-є ()))))

; зберегти-пізніші-елементи: закон.
(за-умовою
  ((однакові? (знайти-хвіст-за-умовою (функція (елемент) (однакові? елемент (як-є б))) (як-є (а б в б г))) (як-є (б в б г))) так)
  (так (перше (як-є ()))))

; складений-елемент: закон.
(за-умовою
  ((однакові? (знайти-хвіст-за-умовою (функція (елемент) (однакові? елемент (як-є (а)))) (як-є (б (а) (в)))) (як-є ((а) (в)))) так)
  (так (перше (як-є ()))))

; за-першим-у-парі: закон.
(за-умовою
  ((однакові? (знайти-хвіст-за-умовою (функція (елемент) (однакові? (перше елемент) (як-є б))) (як-є ((а х) (б у) (а я)))) (як-є ((б у) (а я)))) так)
  (так (перше (як-є ()))))

; замикання-ціль: закон.
; Ціль зв'язується лексично: у фізичній SENS-проєкції не викликаємо
; анонімну функцію як синтаксичну голову форми.
(за-умовою
  ((однакові?
     (нехай-послідовно
       ((ціль (як-є б)))
       (знайти-хвіст-за-умовою
         (функція (елемент) (однакові? елемент ціль))
         (як-є (а б в))))
     (як-є (б в)))
   так)
  (так (перше (як-є ()))))

; збіг-на-ні: закон.
(за-умовою
  ((однакові? (знайти-хвіст-за-умовою (функція (елемент) (однакові? елемент (як-є ні))) (список (як-є а) (як-є ні) (як-є б))) (список (як-є ні) (як-є б))) так)
  (так (перше (як-є ()))))

; ніякої-перевірки-на-порожньому: закон.
(за-умовою
  ((хибне? (знайти-хвіст-за-умовою (функція (елемент) (перше (як-є ()))) (як-є ()))) так)
  (так (перше (як-є ()))))

; не-цілий-вихід: контрприклад.
(за-умовою
  ((хибне? (однакові? (знайти-хвіст-за-умовою (функція (елемент) (однакові? елемент (як-є б))) (як-є (а б в))) (як-є (а б в)))) так)
  (так (перше (як-є ()))))

; не-пропускати-успішний: контрприклад.
(за-умовою
  ((хибне? (однакові? (знайти-хвіст-за-умовою (функція (елемент) (однакові? елемент (як-є а))) (як-є (б а а))) (як-є (а)))) так)
  (так (перше (як-є ()))))

; не-фільтрувати-хвіст: контрприклад.
(за-умовою
  ((хибне? (однакові? (знайти-хвіст-за-умовою (функція (елемент) (однакові? елемент (як-є б))) (як-є (а б в б))) (як-є (б б)))) так)
  (так (перше (як-є ()))))

; не-порожній-за-невдачі: контрприклад.
(за-умовою
  ((хибне? (однакові? (знайти-хвіст-за-умовою (функція (елемент) (однакові? елемент (як-є г))) (як-є (а б))) (як-є ()))) так)
  (так (перше (як-є ()))))

; не-загубити-вкладені: контрприклад.
(за-умовою
  ((хибне? (однакові? (знайти-хвіст-за-умовою (функція (елемент) (однакові? елемент (як-є (а)))) (як-є (б (а) (в)))) (як-є ((а))))) так)
  (так (перше (як-є ()))))

; не-шукати-пізніший: контрприклад.
(за-умовою
  ((хибне? (однакові? (знайти-хвіст-за-умовою (функція (елемент) (однакові? елемент (як-є б))) (як-є (а б в б))) (як-є (б)))) так)
  (так (перше (як-є ()))))

; не-підміняти-ні: контрприклад.
(за-умовою
  ((хибне? (однакові? (знайти-хвіст-за-умовою (функція (елемент) (однакові? елемент (як-є ні))) (список (як-є а) (як-є ні) (як-є б))) (як-є ні))) так)
  (так (перше (як-є ()))))

; Однобітний фінальний самовердикт після всіх тверджень.
(атом? (як-є ()))
