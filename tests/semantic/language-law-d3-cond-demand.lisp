; Д3 COND: невибрана гілка не виконує ні умови, ні наслідку.
; Джерело істини — Lisp/SENS; Zig транспортує T5M, Rust не обчислює закон.
; Навмисно хибні форми CAR NIL перевіряють лінивість реального обчислювача.

(визначити довести-лінивість-д3
  (функція (умова)
    (за-умовою
      ((хибне? умова) (перше (як-є ())))
      (так так))))

; Хибна умова забороняє обчислювати CAR NIL у першій гілці.
; Після істинної другої гілки не можна навіть перевіряти наступну умову.
(довести-лінивість-д3
  (за-умовою
    ((хибне? (атом? (як-є ()))) (перше (як-є ())))
    ((атом? (як-є ())) (атом? (як-є ())))
    ((перше (як-є ())) (перше (як-є ())))))

; Успішна перша гілка не повинна обчислювати наступну умову.
(за-умовою
  ((атом? (як-є ())) (атом? (як-є ())))
  ((перше (як-є ())) (перше (як-є ()))))
