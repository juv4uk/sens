; Д4: семантика «обійти» з єдиної програми benchmarks/recursion.lisp.
; Свідок виконується разом із бібліотекою; не самостійно.
; Для перевірки невірного хвоста використовуємо ратифікований атом D3: АТОМ?.
; Це ізолює рекурсію від окремого відкритого дефекту D7-подання тексту.
; D8 порівнює структурні результати; D3 EQ не застосовуємо до списків.
(за-умовою
  ((однакові? (обійти (як-є ())) (як-є завершено))
   (за-умовою
     ((однакові? (обійти (як-є (радіо антена))) (як-є завершено))
      (за-умовою
        ((однакові? (обійти (як-є атом?))
                    (як-є помилка-не-список))
         (хибне? (однакові?
                   (обійти (як-є атом?))
                   (як-є завершено))))
        (так ні)))
     (так ні)))
  (так ні))
