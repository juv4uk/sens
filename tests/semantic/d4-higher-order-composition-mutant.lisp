; Негативний мовний D4: порядок композиції лишається незмінним.
; Навмисно хибне лише твердження про пару CONS: NOT(ATOM(CONS)) — істина.
; SENS має повернути D1:ні; Rust і Zig не визначають логічного результату.
((функція (складена)
   (за-умовою
     ((хибне? (складена (як-є ())))
      (за-умовою
        ((хибне? (складена (сполучити (як-є ()) (як-є ()))))
         (за-умовою
           ((складена (як-є (радіо антена))) так)
           (так ні)))
        (так ні)))
     (так ні)))
 ((функція (після до)
    (функція (значення)
      (після (до значення))))
  (функція (судження) (хибне? судження))
  (функція (елемент) (атом? елемент))))
