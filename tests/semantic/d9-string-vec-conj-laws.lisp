; Вісім законів рядка, його складників і додавання до вектора.
; Символи набираються з української клавіатури.
; Межі текстового зрізу записані десятковими числами.

(список
  (однакові? (рядок-перший (список (як-є а) (як-є б))) (як-є а))
  (однакові? (рядок-решта (список (як-є а) (як-є б))) (список (як-є б)))
  (однакові? (рядок-додати (список (як-є а)) (список (як-є б)))
          (список (як-є а) (як-є б)))
  (рядок-містить? (як-є б) (список (як-є а) (як-є б)))
  (рядок-префікс? (список (як-є а)) (список (як-є а) (як-є б)))
  (хибне? (рядок-префікс? (список (як-є б)) (список (як-є а) (як-є б))))
  (однакові? (рядок-зріз (список (як-є а) (як-є б) (як-є в))
                      1
                      3)
          (список (як-є б) (як-є в)))
  (однакові? (вектор-додати (список (як-є а)) (як-є б))
          (список (як-є а) (як-є б))))
