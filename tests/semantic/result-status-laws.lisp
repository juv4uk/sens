; Виконуваний мовний свідок для станів результату міркування.
; Семантичне джерело — цей український Lisp; Rust лише запускає його.
; CI додає lib/result-status.lisp як залежність і проводить bundle через T5M.
(за-умовою
  ((однакові?
     (список
       (результат-стан
         (створити-доведений (як-є твердження) (як-є (свідок))))
       (перше
         (результат-вміст
           (створити-доведений (як-є твердження) (як-є (свідок)))))
       (результат-стан
         (створити-невідоме (як-є предмет)))
       (результат-стан
         (створити-частковий (як-є значення) (як-є межа)))
       (результат-стан
         (створити-заблокований (як-є причина)))
       (результат-стан
         (створити-спірний (як-є доказ)))
       (результат-стан
         (створити-некоректний (як-є причина) (як-є вміст)))
       (хибне? (результат-позначений? (як-є необрамлене)))
       (хибне?
         (результат-позначений?
           (сполучити (як-є proved) (атом? (як-є ())))))
       ; D3 NIL є коректним порожнім списком. D1:так як хвіст — реальний атом, але не D3 NIL;
       ; цитований D7-символ хвоста не підмінює бітове значення.
       (результат-є-правильним-списком? (як-є ()))
       (хибне?
         (результат-є-правильним-списком?
           (сполучити (як-є proved) (атом? (як-є ()))))))
     (список
       (як-є proved)
       (як-є твердження)
       (як-є unknown)
       (як-є partial)
       (як-є blocked)
       (як-є disputed)
       (як-є invalid)
       так
       так
       так
       так))
   (атом? (як-є ())))
  (так (перше (як-є ()))))
