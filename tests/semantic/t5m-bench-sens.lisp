; T5M — SENS-бенчмарк (міряє МОВА, не Python).
; Час: SENS не має годинника (mono-ns навмисно не збудований, core4.lisp:92),
; тож мова міряє РОЗМІР (кількість байтів/трітів) — те, що справді її.
; Це доводить: кодек міряється власними засобами, без Python.
(список
  ; довжина списку трітів одного слова "101" = 3
  (equal? (довжина (т5-тріти-слова (список так ні так)))
          #d24:000000000000000000000011)
  ; т5м-у-байти(["1"]) → 3 байти (одна 15-трітова група)
  (equal? (довжина (т5м-у-байти (список (список так))))
          #d24:000000000000000000000011)
  ; т5м-у-байти(["101","11"]) → 3 байти (7 трітів + 8 пад = 15)
  (equal? (довжина (т5м-у-байти (список (список так ні так)
                                      (список так так))))
          #d24:000000000000000000000011)
  ; т5м-у-байти 6 слів по 5 біт → трітів 6*5+5=35 → 45 (кратне 15) → 9 байт
  (equal? (довжина (т5м-у-байти (список (список так так так так так)
                                      (список так так так так так)
                                      (список так так так так так)
                                      (список так так так так так)
                                      (список так так так так так)
                                      (список так так так так так))))
          #d24:000000000000000000001001)
  ; round-trip: декод(код(слова)) дає той самий список слів
  (equal? (т5м-з-байтів (т5м-у-байти (список (список так ні так)
                                           (список так так))))
          (список (список так ні так) (список так так)))
  ; негативний: 6×5біт НЕ дають 3 байти (це 9)
  (хибне? (equal? (довжина (т5м-у-байти (список (список так так так так так)
                                            (список так так так так так)
                                            (список так так так так так)
                                            (список так так так так так)
                                            (список так так так так так)
                                            (список так так так так так))))
                #d24:000000000000000000001111)))

