; Закони вставлення у мапу, отримання значень зі сховища та спискового вектора.
; Вісім перевірок охоплюють створення, заміну й відсутність ключа.
; Повні українські викличні назви, без бітових викликів і чужих псевдонімів.
(визначити вміст-сховище-отримати
  (функція (ключ мапа)
    (за-умовою
      ((порожній? (знайти-за-ключем ключ мапа)) (як-є ()))
      ((хибне? (порожній? (знайти-за-ключем ключ мапа)))
       (решта (знайти-за-ключем ключ мапа))))))
(визначити вміст-сховище-містить?
  (функція (ключ мапа)
    (хибне? (порожній? (знайти-за-ключем ключ мапа)))))
(список
  (однакові? (вектор-список (список (як-є а) (як-є б)))
          (список (як-є а) (як-є б)))
  (однакові? (порожній-вміст-сховище) (як-є ()))
  (однакові? (мапа-вставити (як-є к) (як-є значення) (як-є ()))
          (список (список (як-є к) (як-є значення))))
  (однакові? (мапа-вставити (як-є к) (як-є значення-два)
                         (список (список (як-є к) (як-є значення-один))))
          (список (список (як-є к) (як-є значення-два))))
  (вміст-сховище-містить? (як-є к)
                          (список (список (як-є к) (як-є значення))))
  (хибне? (вміст-сховище-містить? (як-є відсутнє) (як-є ())))
  (однакові? (вміст-сховище-отримати (як-є к)
                                  (список (список (як-є к) (як-є значення))))
          (список (як-є значення)))
  (однакові? (вектор-список (як-є ())) (як-є ())))
