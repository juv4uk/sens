; Д11 APPEND-REVERSE: порядок, D1-елемент, D3:() як елемент і порожня голова.
; Лише власний SENS визначає рівність та D1 результат.
(визначити результат-оберненого-додавання
  (приєднати-обернену-голову
    (список так ні)
    (список (як-є ()))))
(за-умовою
  ((однакові?
     результат-оберненого-додавання
     (список ні так (як-є ())))
   (за-умовою
     ((однакові?
        (приєднати-обернену-голову
          (як-є ())
          (список так ні))
        (список так ні))
      (за-умовою
        ((однакові?
           (приєднати-обернену-голову
             (список так)
             (як-є ()))
           (список так))
         так)
        (так ні)))
     (так ні)))
  (так ні))
