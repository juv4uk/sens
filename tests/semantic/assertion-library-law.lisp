; SENS_SOURCE: позитивний самокалібрувальний закон M1.
; NATIVE_SENS_POSITIVE: 4 кейси, 2 PASS, 2 очікувані FAIL та точні імена.
; NATIVE_SENS_NEGATIVE: мутант ламає загальний лічильник; окремо є Type-негатив.
; Кейс 1: твердження істинне на відомому значенні.
; Кейс 2: хибне твердження має бути записане у звіті як провал.
; Кейс 3: однакові вкладені структури.
; Кейс 4: вкладені структури з різним елементом.

(нехай ((звіт
  (запустити-твердження
    (список
      (список (як-є істина-істина)
        (функція ()
          (твердження-однаковості
            (атом? (як-є ()))
            (атом? (як-є ())))))
      (список (як-є істина-хиба)
        (функція ()
          (твердження-однаковості
            (атом? (як-є ()))
            (хибне? (атом? (як-є ()))))))
      (список (як-є вкладені-однакові)
        (функція ()
          (твердження-однаковості
            (список (як-є гілка) (список (як-є лист)))
            (список (як-є гілка) (список (як-є лист))))))
      (список (як-є вкладені-різні)
        (функція ()
          (твердження-однаковості
            (список (як-є гілка) (список (як-є лист)))
            (список (як-є гілка) (список (як-є інший-лист)))))))))
  (та
    (рівне? (перше звіт) 4)
    (рівне? (друге звіт) 2)
    (рівне? (третє звіт) 2)
    (однакові? (четверте звіт)
      (список (як-є вкладені-різні) (як-є істина-хиба))))))
