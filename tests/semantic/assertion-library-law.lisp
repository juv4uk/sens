; SENS_SOURCE: позитивний самокалібрувальний закон M1.
; NATIVE_SENS_POSITIVE: звіт містить 2 запущені, 1 PASS, 1 FAIL.
; NATIVE_SENS_NEGATIVE: парний мутант змінює очікувану кількість на 3.
; Намірено-хибний тест повинен бути зарахований як провал, не як успіх.

(нехай ((звіт
  (запустити-твердження
    (список
      (список (як-є істина-істина)
        (функція ()
          (твердження-однаковості
            (атом? (як-є ()))
            (атом? (як-є ())))))
      (список (як-є істина-хиба)
        (функція ()
          (твердження-однаковості
            (атом? (як-є ()))
            (хибне? (атом? (як-є ()))))))))))
  (та
    (рівне? (перше звіт) 2)
    (рівне? (друге звіт) 1)
    (рівне? (третє звіт) 1)
    (однакові? (четверте звіт) (список (як-є істина-хиба)))))
