  (та
    (однакові? (перше звіт) (сполучити так (сполучити так (сполучити так (сполучити так (як-є ()))))))
    (однакові? (друге звіт) (сполучити так (сполучити так (як-є ()))))
    (однакові? (третє звіт) (сполучити так (сполучити так (як-є ()))))
    (однакові?
      (четверте звіт)
      (список (як-є вкладені-різні) (як-є істина-хиба))))))
