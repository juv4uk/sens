; D8:10100000 COPY-LIST — вісім D1 точних позитивних і контрастних свідків.
(список
  (порожній? (копіювати-список (quote ())))
  (equal? (копіювати-список (список (quote а) (quote б)))
          (список (quote а) (quote б)))
  (equal? (копіювати-список (список (список (quote а)) (quote б)))
          (список (список (quote а)) (quote б)))
  (хибне? (equal? (копіювати-список (список (quote а) (quote б)))
                (список (quote б) (quote а))))
  (equal? (перше (копіювати-список (список (quote а) (quote б))))
          (quote а))
  (equal? (решта (копіювати-список (список (quote а) (quote б))))
          (список (quote б)))
  (equal? (копіювати-список
            (копіювати-список (список (quote а) (quote б))))
          (список (quote а) (quote б)))
  (equal? (копіювати-список (список (quote а) (quote а)))
          (список (quote а) (quote а))))

