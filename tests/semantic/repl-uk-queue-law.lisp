; Закон REPL: шість полів української проєкції у точному порядку.
; Немає текстового SID8/Sens8 виклику, D7 містить лише назви.
; Перевіряє сам SENS: коректні дані, пропуск і перестановка полів.

(визначити очікувані-поля-репл
  (список (як-є ук) (як-є укр) (як-є сан)
          (як-є ен) (як-є лісп) (як-є сим)))

(визначити поля-правильні?
  (функція (рядок очікувані)
    (за-умовою
      ((атом? очікувані) (атом? рядок))
      ((атом? рядок) ні)
      ((атом? (перше рядок)) ні)
      ((тотожне? (перше (перше рядок)) (перше очікувані))
       (поля-правильні? (решта рядок) (решта очікувані)))
      (так ні))))

(визначити свідок-репл-закону
  (функція ()
    (за-умовою
      ((поля-правильні?
         (список (список (як-є ук) (як-є як-є))
                 (список (як-є укр) (як-є як-є))
                 (список (як-є сан) (як-є с))
                 (список (як-є ен) (як-є е))
                 (список (як-є лісп) (як-є л))
                 (список (як-є сим) (як-є ())))
         очікувані-поля-репл)
       (за-умовою
         ((хибне?
            (поля-правильні?
              (список (список (як-є ук) (як-є як-є)))
              очікувані-поля-репл))
          (за-умовою
            ((хибне?
               (поля-правильні?
                 (список (список (як-є укр) (як-є як-є))
                         (список (як-є ук) (як-є як-є)))
                 (список (як-є ук) (як-є укр))))
             (як-є (репл-закон (status pass))))
            (так (як-є (репл-закон (status fail))))))
         (так (як-є (репл-закон (status fail))))))
      (так (як-є (репл-закон (status fail)))))))

(свідок-репл-закону)
