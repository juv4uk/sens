; Виконуваний український SENS-свідок черги.
; Успіх: після невідомого імені сесія зберігає визначення;
; рівно три форми мають дати вивід. Після явного завершення
; стоїть небезпечна форма, яка НЕ МОЖЕ виконуватися.
; Десять реальних ширин читаються як буквальні біти без втрат;
; порожні/довші/зі стороннім символом слова fail-closed.
; Десятибітний носій лишається Lisp-даними без D10 callability.
; Побітова тотожність D10 та відмова від хибної D9-ширини.
; Новий SENS-свідок: усі 10 ширин визначені за структурою;
; D10 і D9 з однаковим префіксом мають різні мітки.
; Додатковий закон ЄДИНОГО циклу: те саме середовище читає D10
; як повні десять бітів і відкидає одинадцять, не викликаючи D10.
; Старий закон REPL-черги та його однобітний негатив зберігаємо.
(за-умовою
  ((репл-мітки-черги?
     (сполучити
       (решта (репл-крок-з-доменами "0100111111"
                (репл-почати (як-є ()))))
       (як-є ()))
     (як-є (д10)))
   (за-умовою
     ((тотожне?
        (перше
          (решта
            (репл-крок-з-доменами
              "01001111110"
              (репл-почати (як-є ())))))
        (як-є неправильне-доменне-слово))
         (за-умовою
           ((репл-мітки-черги?
              (репл-доменна-черга
                (як-є ("0" "00" "000" "0000" "00000" "000000" "0000000" "00000000" "000000000" "0000000000")))
              репл-доменні-позначки)
            (за-умовою
              ((тотожне?
                 (перше (репл-читати-слово-з-доменом "0100111111"))
                 (як-є д10))
               (за-умовою
                 ((тотожне?
                    (перше (репл-читати-слово-з-доменом "010011111"))
                    (як-є д9))
                  (за-умовою
           ((репл-біти-збігаються? (решта (репл-читати-доменне-слово "0100111111")) "0100111111")
            (за-умовою
              ((тотожне? (репл-біти-збігаються? (решта (репл-читати-доменне-слово "0000000000")) "000000000") #d1:0)
               (за-умовою
                 ((репл-доменне-слово? "0")
                  (за-умовою
                    ((репл-доменне-слово? "00")
                     (за-умовою
                       ((репл-доменне-слово? "000")
                        (за-умовою
                          ((репл-доменне-слово? "0000")
                           (за-умовою
                             ((репл-доменне-слово? "00000")
                              (за-умовою
                                ((репл-доменне-слово? "000000")
                                 (за-умовою
                                   ((репл-доменне-слово? "0000000")
                                    (за-умовою
                                      ((репл-доменне-слово? "00000000")
                                       (за-умовою
                                         ((репл-доменне-слово? "000000000")
                                          (за-умовою
                                            ((репл-доменне-слово? "0000000000")
                                             (за-умовою
                                               ((тотожне? (репл-доменне-слово? "") #d1:0)
                                                (за-умовою
                                                  ((тотожне? (репл-доменне-слово? "00000000000") #d1:0)
                                                   (за-умовою
                                                     ((тотожне? (репл-доменне-слово? "0000200") #d1:0)
                                                      (за-умовою
                                                        ((тотожне? (репл-доменне-слово? "0 1") #d1:0)
                                                         (за-умовою
                                                           ((тотожне? (репл-доменне-слово? "01001111110") #d1:0)
                                                            (за-умовою
                                                              ((тотожне? (репл-доменне-слово? "1x") #d1:0)
                                                               (за-умовою
                                                                 ((тотожне? (текст-у-символ (перше (решта (репл-читати-доменне-слово "0000000000")))) (текст-у-символ "0"))
                                                                  (за-умовою
                                                                    ((тотожне?
                                                                       (решта
                                                                         (репл-черга
                                                                           (як-є
                                                                             ("(визначити відповідь (як-є #d1:1))"
                                                                              "невідоме-для-репл"
                                                                              "відповідь"
                                                                              "(репл-завершити)"
                                                                              "(#d1:0)"))
                                                                           (репл-почати (як-є ()))))
                                                                       #d1:1)
                                                                     (за-умовою
                                                                       ((тотожне?
                                                                          (решта
                                                                            (репл-виконати
                                                                              (як-є
                                                                                ((визначити відповідь (як-є #d1:1))
                                                                                 (репл-завершити)
                                                                                 (#d1:0)))
                                                                              (репл-почати (як-є ()))))
                                                                          #d1:1)
                                                                        #d1:1)
                                                                       (#d1:1 (#d1:0))))
                                                                    (#d1:1 (#d1:0))))
                                                                 (#d1:1 (#d1:0))))
                                                              (#d1:1 (#d1:0))))
                                                           (#d1:1 (#d1:0))))
                                                        (#d1:1 (#d1:0))))
                                                     (#d1:1 (#d1:0))))
                                                  (#d1:1 (#d1:0))))
                                               (#d1:1 (#d1:0))))
                                            (#d1:1 (#d1:0))))
                                         (#d1:1 (#d1:0))))
                                      (#d1:1 (#d1:0))))
                                   (#d1:1 (#d1:0))))
                                (#d1:1 (#d1:0))))
                             (#d1:1 (#d1:0))))
                          (#d1:1 (#d1:0))))
                       (#d1:1 (#d1:0))))
                    (#d1:1 (#d1:0))))
                 (#d1:1 (#d1:0))))
              (#d1:1 (#d1:0))))
           (#d1:1 (#d1:0))))
                 (#d1:1 (#d1:0))))
              (#d1:1 (#d1:0))))
           (#d1:1 (#d1:0)))       )
     (#d1:1 (#d1:0))))
  (#d1:1 (#d1:0)))
