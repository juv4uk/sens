; Виконуваний український SENS-свідок черги.
; Успіх: після невідомого імені сесія зберігає визначення;
; рівно три форми мають дати вивід. Після явного завершення
; стоїть небезпечна форма, яка НЕ МОЖЕ виконуватися.
; Десять реальних ширин читаються як буквальні біти без втрат;
; порожні/довші/зі стороннім символом слова fail-closed.
; Десятибітний носій лишається Lisp-даними без D10 callability.
; Побітова тотожність D10 та відмова від хибної D9-ширини.
; Новий SENS-свідок: усі 10 ширин визначені за структурою;
; D10 і D9 з однаковим префіксом мають різні мітки.
; Додатковий закон ЄДИНОГО циклу: те саме середовище читає D10
; як повні десять бітів і відкидає одинадцять, не викликаючи D10.
; Старий закон REPL-черги та його однобітний негатив зберігаємо.
; Доказ прямої української проєкції вже прочитаної доменної
; таблиці: однаковий префікс не змішує D9 і D10. Це лише
; локальна тестова вибірка, НЕ нова таблиця ідентичностей.
((функція (таблиця)
   (за-умовою
     ((тотожне?
        (репл-українська-назва-з-таблиці "0100111111" таблиця)
        (як-є обчислити-верхню-форму))
      (за-умовою
        ((тотожне?
           (репл-українська-назва-з-таблиці "0010" таблиця)
           (як-є функція))
         (за-умовою
           ((тотожне?
              (репл-українська-назва-з-таблиці "010011111" таблиця)
              (як-є ()))
              (за-умовою
                ((репл-мітки-черги?
                   (сполучити
                     (решта (репл-крок-з-доменами "0100111111"
                              (репл-почати (як-є ()))))
                     (як-є ()))
                   (як-є (д10)))
                 (за-умовою
                   ((тотожне?
                      (перше
                        (решта
                          (репл-крок-з-доменами
                            "01001111110"
                            (репл-почати (як-є ())))))
                      (як-є неправильне-доменне-слово))
                       (за-умовою
                         ((репл-мітки-черги?
                            (репл-доменна-черга
                              (як-є ("0" "00" "000" "0000" "00000" "000000" "0000000" "00000000" "000000000" "0000000000")))
                            репл-доменні-позначки)
                          (за-умовою
                            ((тотожне?
                               (перше (репл-читати-слово-з-доменом "0100111111"))
                               (як-є д10))
                             (за-умовою
                               ((тотожне?
                                  (перше (репл-читати-слово-з-доменом "010011111"))
                                  (як-є д9))
                                (за-умовою
                         ((репл-біти-збігаються? (решта (репл-читати-доменне-слово "0100111111")) "0100111111")
                          (за-умовою
                            ((тотожне? (репл-біти-збігаються? (решта (репл-читати-доменне-слово "0000000000")) "000000000") ні)
                             (за-умовою
                               ((репл-доменне-слово? "0")
                                (за-умовою
                                  ((репл-доменне-слово? "00")
                                   (за-умовою
                                     ((репл-доменне-слово? "000")
                                      (за-умовою
                                        ((репл-доменне-слово? "0000")
                                         (за-умовою
                                           ((репл-доменне-слово? "00000")
                                            (за-умовою
                                              ((репл-доменне-слово? "000000")
                                               (за-умовою
                                                 ((репл-доменне-слово? "0000000")
                                                  (за-умовою
                                                    ((репл-доменне-слово? "00000000")
                                                     (за-умовою
                                                       ((репл-доменне-слово? "000000000")
                                                        (за-умовою
                                                          ((репл-доменне-слово? "0000000000")
                                                           (за-умовою
                                                             ((тотожне? (репл-доменне-слово? "") ні)
                                                              (за-умовою
                                                                ((тотожне? (репл-доменне-слово? "00000000000") ні)
                                                                 (за-умовою
                                                                   ((тотожне? (репл-доменне-слово? "0000200") ні)
                                                                    (за-умовою
                                                                      ((тотожне? (репл-доменне-слово? "0 1") ні)
                                                                       (за-умовою
                                                                         ((тотожне? (репл-доменне-слово? "01001111110") ні)
                                                                          (за-умовою
                                                                            ((тотожне? (репл-доменне-слово? "1x") ні)
                                                                             (за-умовою
                                                                               ((тотожне? (текст-у-символ (перше (решта (репл-читати-доменне-слово "0000000000")))) (текст-у-символ "0"))
                                                                                (за-умовою
                                                                                  ((тотожне?
                                                                                     (решта
                                                                                       (репл-черга
                                                                                         (як-є
                                                                                           ("(визначити відповідь так)"
                                                                                            "невідоме-для-репл"
                                                                                            "відповідь"
                                                                                            "(репл-завершити)"
                                                                                            "(ні)"))
                                                                                         (репл-почати (як-є ()))))
                                                                                     так)
                                                                                   (за-умовою
                                                                                     ((тотожне?
                                                                                        (решта
                                                                                          (репл-виконати
                                                                                            (як-є
                                                                                              ((визначити відповідь так)
                                                                                               (репл-завершити)
                                                                                               (ні)))
                                                                                            (репл-почати (як-є ()))))
                                                                                        так)
                                                                                      так)
                                                                                     (так (ні))))
                                                                                  (так (ні))))
                                                                               (так (ні))))
                                                                            (так (ні))))
                                                                         (так (ні))))
                                                                      (так (ні))))
                                                                   (так (ні))))
                                                                (так (ні))))
                                                             (так (ні))))
                                                          (так (ні))))
                                                       (так (ні))))
                                                    (так (ні))))
                                                 (так (ні))))
                                              (так (ні))))
                                           (так (ні))))
                                        (так (ні))))
                                     (так (ні))))
                                  (так (ні))))
                               (так (ні))))
                            (так (ні))))
                         (так (ні))))
                               (так (ні))))
                            (так (ні))))
                         (так (ні)))       )
                   (так (ні))))
                (так (ні)))
           (так (ні))))
        (так (ні))))
     (так (ні))))
 (як-є
   (domain-table/1
     ("001" (ук як-є) (en quote) (LISP QUOTE))
     ("0010" (ук функція) (en lambda) (LISP LAMBDA))
     ("0100111111" (ук обчислити-верхню-форму) (en eval-top-form) (LISP EVAL-TOP-FORM))))))
