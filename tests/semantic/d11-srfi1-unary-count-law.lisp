; Д11: незалежні граничні закони D3 () і D1 ні.
; Вирок виражено лише через SENS D1; відхилення — D3 Type.
(за-умовою
  ((правильний-список-для-підрахунку? (як-є ())) так)
  (так (перше (як-є ()))))
(за-умовою
  ((правильний-список-для-підрахунку? (список ні)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне? (правильний-список-для-підрахунку? ні)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне? (правильний-список-для-підрахунку?
              (сполучити так ні))) так)
  (так (перше (як-є ()))))

; Д11 унарний COUNT: кожний збіг додає D1:так, а не D24 число.
; Д3 () — окреме від D1:ні; скінченні списки проходять повну перевірку.
(за-умовою
  ((однакові?
     (порахувати-за-умовою-унарно
       (функція (значення) (хибне? значення))
       (список ні так ні))
     (список так так))
   (за-умовою
     ((однакові?
        (порахувати-пари-за-умовою-унарно
          (функція (лівий правий) (тотожне? лівий правий))
          (список так ні так)
          (список так так))
        (список так))
      (за-умовою
        ((порожній?
           (порахувати-за-умовою-унарно
             (функція (значення) (перше (як-є ())))
             (як-є ())))
         так)
        (так ні)))
     (так ні)))
  (так ні))
