; Д11 SRFI-1 COUNT: сім законів в ОДНОМУ SENS-вердикті.
; D3:() — єдиний кінець, D1:ні дозволений як елемент, але не як хвіст.
; Перші чотири структуральні свідки не може замаскувати остання форма.
; Лічба — унарний список D1:так; предикат для () не викликається.
; Кожний хибний закон дає справжній D3 CAR Type, не удаваний PASS.
(за-умовою
  ((правильний-список-для-підрахунку? (як-є ()))
   (за-умовою
     ((правильний-список-для-підрахунку? (список ні))
      (за-умовою
        ((хибне? (правильний-список-для-підрахунку? ні))
         (за-умовою
           ((хибне?
            (правильний-список-для-підрахунку?
              (сполучити так ні)))
            (за-умовою
              ((однакові?
               (порахувати-за-умовою-унарно
                 (функція (значення) (хибне? значення))
                 (список ні так ні))
               (список так так))
               (за-умовою
                 ((однакові?
                  (порахувати-пари-за-умовою-унарно
                    (функція (лівий правий) (тотожне? лівий правий))
                    (список так ні так)
                    (список так так))
                  (список так))
                  (за-умовою
                    ((порожній?
                     (порахувати-за-умовою-унарно
                       (функція (значення) (перше (як-є ())))
                       (як-є ())))
                     так)
                    (так (перше (як-є ())))))
                 (так (перше (як-є ())))))
              (так (перше (як-є ())))))
           (так (перше (як-є ())))))
        (так (перше (як-є ())))))
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))
