; Д6:101111 SCAN: кожен стан, порядок і останній стан REDUCE.
; Лише канонічні D1/D3, без D7 чи числових літералів.
; Для правильного непорожнього списку включаємо початковий стан.

(за-умовою
  ((хибне?
     (однакові?
       (накопичувати
         (функція (стан елемент) (сполучити елемент стан))
         (як-є ())
         (список так ні))
       (список (як-є ()) (список так) (список ні так))))
   ні)
  ((хибне?
     (однакові?
       (перше
         (зворот
           (накопичувати
             (функція (стан елемент) (сполучити елемент стан))
             (як-є ())
             (список так ні))))
       (згорнути
         (функція (стан елемент) (сполучити елемент стан))
         (як-є ())
         (список так ні))))
   ні)
  ((хибне?
     (порожній?
       (накопичувати
         (функція (стан елемент) (перше елемент))
         (як-є ())
         (як-є ()))))
   ні)
  ((хибне?
     (однакові?
       (накопичувати-до
         (функція (стан елемент) (перше елемент))
         (список так)
         (як-є ()))
       (список (список так))))
   ні)
  (так так))
