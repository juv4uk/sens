; Чотири перевірки похідних операцій над списками.
; Позиція елемента визначається десятковим математичним числом.
; Порівняння результатів відбувається у ратифікованій українській проєкції.
(список
  (однакові?
    (решта-від-позиції 1
      (список (як-є а) (як-є б) (як-є в)))
    (список (як-є б) (як-є в)))
  (порожній?
    (решта-від-позиції 4
      (список (як-є а) (як-є б))))
  (усі-задовольняють?
    (функція (елемент) (однакові? елемент (як-є так)))
    (список (як-є так) (як-є так)))
  (хибне?
    (усі-задовольняють?
      (функція (елемент) (однакові? елемент (як-є так)))
      (список (як-є так) (як-є ні)))))
