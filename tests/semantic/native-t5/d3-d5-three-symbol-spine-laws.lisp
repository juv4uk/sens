; Д3/Д5: три різні канонічні атоми, DEFINE та повний прохід по остову.
; Перевірка порядку CAR/CDR, кінцевого NIL і негативної рівності.
(визначити трійка-законів
  (список (як-є атом?) (як-є решта) (як-є сполучити)))
(список
  (тотожне? (перше трійка-законів) (як-є атом?))
  (тотожне? (перше (решта трійка-законів)) (як-є решта))
  (тотожне? (перше (решта (решта трійка-законів))) (як-є сполучити))
  (атом? (решта (решта (решта трійка-законів))))
  (хибне? (атом? (решта (решта трійка-законів))))
  (хибне? (тотожне? (перше трійка-законів) (як-є сполучити))))
