; Д4 ПОРОЖНІЙ? від хвоста двоелементного списку — D1:0, а ХИБНЕ? дає D1:1.
; ПЕРШЕ/РЕШТА зберігають другий атом, хибна рівність із першим повертає D1:0.
; Закон виконується SENS — жодної хостової семантики.
(за-умовою
  ((хибне? (порожній? (решта (список (як-є атом?) (як-є тотожне?)))))
   (за-умовою
     ((тотожне? (перше (решта (список (як-є атом?) (як-є тотожне?)))) (як-є тотожне?))
      (хибне? (тотожне? (перше (решта (список (як-є атом?) (як-є тотожне?)))) (як-є атом?))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
