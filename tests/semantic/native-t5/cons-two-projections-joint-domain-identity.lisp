; D3 CONS з атомарним хвостом: CAR і CDR зберігають обидві різні тотожності.
; Вкладений D3 COND виконується лише після першого точного D1 свідка.
(за-умовою
  ((тотожне? (перше (сполучити (як-є атом?) (як-є тотожне?))) (як-є атом?))
   (за-умовою
     ((тотожне? (решта (сполучити (як-є атом?) (як-є тотожне?))) (як-є тотожне?))
      (атом? (як-є ())))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
