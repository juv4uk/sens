; Виконувана українська функція: пропустити початок списку до першого
; входження позначки, зберігши саму позначку й решту списку.
; СЕНС, а не зовнішній скрипт, виконує рекурсію, D1 COND та D3 EQ.
(визначити пропустити-до-позначки
  (функція (позначка елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((тотожне? позначка (перше елементи)) елементи)
      ((атом? (як-є ()))
       (пропустити-до-позначки позначка (решта елементи))))))

; Перша, середня, відсутня та порожня гілки живої функції.
(список
  (пропустити-до-позначки (як-є а) (як-є (а б в)))
  (пропустити-до-позначки (як-є б) (як-є (а б в)))
  (пропустити-до-позначки (як-є г) (як-є (а б в)))
  (пропустити-до-позначки (як-є а) (як-є ())))
