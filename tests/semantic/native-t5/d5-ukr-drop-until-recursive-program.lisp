; Виконувана українська функція: пропустити NIL-голови до першого
; складеного елемента; той елемент і решта списку не губляться.
; Розрізнення атома й пари є точним законом Д3, без текстового EQ.
(визначити пропустити-до-складеного
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((хибне? (атом? (перше елементи))) елементи)
      ((атом? (як-є ()))
       (пропустити-до-складеного (решта елементи))))))

; Складений одразу, після одного NIL, відсутній, порожній.
(список
  (пропустити-до-складеного (як-є ((()) ())))
  (пропустити-до-складеного (як-є (() (()) ())))
  (пропустити-до-складеного (як-є (() () ())))
  (пропустити-до-складеного (як-є ())))
