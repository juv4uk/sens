; Д4 РЕШТА-ПЕРШОГО над приєднаними списками повертає хвіст першої пари.
; Пізніший атом у правому списку не змінює перший ратифікований хвіст.
(за-умовою
  ((тотожне?
     (решта-першого
       (приєднати
         (список (сполучити (як-є атом?) (як-є решта)))
         (список (як-є тотожне?))))
     (як-є решта))
   (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
