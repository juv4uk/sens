; Виконувана українська функція: залишити початок списку з NIL-голів
; до першого складеного елемента, не включаючи його.
; Точні D3 атом/пара, D3 CAR/CDR/CONS і рекурсія; без EQ на D7 тексті.
(визначити взяти-перед-складеним
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((хибне? (атом? (перше елементи))) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (перше елементи)
         (взяти-перед-складеним (решта елементи)))))))

; Перший складений, після NIL, без складеного, порожній.
(список
  (взяти-перед-складеним (як-є ((()) ())))
  (взяти-перед-складеним (як-є (() (()) ())))
  (взяти-перед-складеним (як-є (() () ())))
  (взяти-перед-складеним (як-є ())))
