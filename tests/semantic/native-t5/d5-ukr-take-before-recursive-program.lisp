; Виконувана українська функція: взяти початок списку перед позначкою.
; D3 EQ, D3 CONS, D3 COND та рекурсія належать СЕНС; хост не обчислює.
(визначити взяти-перед-позначкою
  (функція (позначка елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((тотожне? позначка (перше елементи)) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (перше елементи)
         (взяти-перед-позначкою позначка (решта елементи)))))))

; Початок, середина, відсутня позначка, порожні вхідні дані.
(список
  (взяти-перед-позначкою (як-є а) (як-є (а б в)))
  (взяти-перед-позначкою (як-є б) (як-є (а б в)))
  (взяти-перед-позначкою (як-є г) (як-є (а б в)))
  (взяти-перед-позначкою (як-є а) (як-є ())))
