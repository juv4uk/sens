; D11 GROUP-BY: D1 / D3 / D4 / D8 позитив трьох прямих SENS входів.
; Завантажити lib/d11-clojure-group-by.lisp, результат SENS D1:так.
(за-умовою
  ((однакові?
     (вибрати-елементи-з-ключем
       (функція (елемент) елемент)
       так (список так ні так))
     (список так так))
   (за-умовою
     ((однакові?
        (вилучити-елементи-з-ключем
          (функція (елемент) елемент)
          так (список так ні так))
        (список ні))
      (за-умовою
        ((однакові?
           (розділити-елементи-за-ключем
             (функція (елемент) елемент)
             так (список так ні так))
           (сполучити (список так так) (список ні)))
         так)
        (так (перше (як-є ())))))
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))
