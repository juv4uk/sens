; Д11 розрізнення термінатора: тільки нативні SENS-свідки, не імпорт.
; Позитивний випадок: структурна порожнеча, не Д1:ні.
(за-умовою
  ((перше (розрізнити-хвіст-списку (як-є ()))) так)
  (так (перше (як-є ()))))

; Значення порожнього завершення повинно лишатися саме ().
(за-умовою
  ((порожній? (друге (розрізнити-хвіст-списку (як-є ())))) так)
  (так (перше (як-є ()))))

; Правильний список має завершуватися (), навіть якщо голова є списком.
(за-умовою
  ((перше
     (розрізнити-хвіст-списку
       (список (список (як-є атом?)) (як-є решта)))) так)
  (так (перше (як-є ()))))

; Неправильний список із термінатором Д1:так: присутність НЕ є істиною.
(за-умовою
  ((хибне?
     (перше
       (розрізнити-хвіст-списку
         (сполучити (як-є атом?) так)))) так)
  (так (перше (як-є ()))))

; Хвіст Д1:так повертається точно, без заміни на порожній список.
(за-умовою
  ((друге
     (розрізнити-хвіст-списку
       (сполучити (як-є атом?) так))) так)
  (так (перше (як-є ()))))

; Хвіст Д1:ні — реальні дані, не відсутність запису.
(за-умовою
  ((хибне?
     (перше
       (розрізнити-хвіст-списку
         (сполучити (як-є атом?) ні)))) так)
  (так (перше (як-є ()))))

(за-умовою
  ((хибне?
     (друге
       (розрізнити-хвіст-списку
         (сполучити (як-є атом?) ні)))) так)
  (так (перше (як-є ()))))

; Сам атом також відрізняється від порожнього списку.
(за-умовою
  ((хибне? (перше (розрізнити-хвіст-списку ні))) так)
  (так (перше (як-є ()))))

; Рекурсія проходить усі пари та знаходить термінатор, не перший елемент.
(за-умовою
  ((хибне?
     (друге
       (розрізнити-хвіст-списку
         (сполучити (як-є атом?)
           (сполучити (як-є решта) ні))))) так)
  (так (перше (як-є ()))))

; Завершення перенесених законів: повернути чинний D1:так.
(атом? (як-є ()))

; Незалежний фізичний закон на однакових payload D1:ні і D3:().
; Результат пари з D1:ні — (ні ні), а порожній список — (так ()).
(за-умовою
  ((однакові?
     (розрізнити-хвіст-списку
       (сполучити так ні))
     (список ні ні))
   (за-умовою
     ((однакові?
        (розрізнити-хвіст-списку
          (список (як-є ()) так))
        (список так (як-є ())))
      так)
     (так ні)))
  (так ні))

; Д11 LIST-TERMINATOR: правильність зовнішнього списку визначає
; лише його власний D3-хвіст, не вкладене значення голови.
; Вкладений крапковий D1:ні — допустимі дані правильного списку.
; Але такий самий D1:ні в зовнішньому хвості є неправильним кінцем.
(за-умовою
  ((однакові?
     (розрізнити-хвіст-списку
       (список (сполучити так ні)))
     (список так (як-є ())))
   (за-умовою
     ((однакові?
        (розрізнити-хвіст-списку
          (сполучити (сполучити так ні)
            (сполучити (як-є ()) ні)))
        (список ні ні))
      так)
     (так ні)))
  (так ні))
