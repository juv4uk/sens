; Д11: закон завершення proper/dotted списків.
; Виконати з lib/d11-list-terminator-evidence.lisp, результат D1:так.
(за-умовою
  ((порожній?
     (друге
       (розрізнити-хвіст-списку
         (список (як-є атом?) (як-є решта)))))
   (за-умовою
     ((хибне?
        (перше
          (розрізнити-хвіст-списку
            (сполучити (як-є атом?) ні))))
      (хибне?
        (друге
          (розрізнити-хвіст-списку
            (сполучити (як-є атом?) ні)))))
     (так ні)))
  (так ні))
