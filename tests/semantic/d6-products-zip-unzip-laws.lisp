; D6:111000 ZIP / D6:111001 UNZIP — рівнодовгі списки, закон #3370.
; Очікуване native значення: (1 1 0). Остання клітинка — негатив орієнтації.
; Це виклик українських SENS-визначень, не direct D6:bits.
(list
  (equal?
    (розпарувати-пари
      (спарувати-послідовності
        (list (quote ліве-а) (quote ліве-б))
        (list (quote праве-а) (quote праве-б))))
    (list
      (list (quote ліве-а) (quote ліве-б))
      (list (quote праве-а) (quote праве-б))))
  (equal?
    (розпарувати-пари (спарувати-послідовності (list) (list)))
    (list (list) (list)))
  (equal?
    (розпарувати-пари
      (спарувати-послідовності
        (list (quote ліве-а))
        (list (quote праве-а))))
    (list (list (quote праве-а)) (list (quote ліве-а)))))
