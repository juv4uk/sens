; D9: українські виклики чотирьох ратифікованих замикань із core4.
; Жодних нових числових літералів: числа утворює D24-довжина.
; 10 позитивних та інверсних законів виконуються самим SENS.
(list
  (equal? (бінарний (quote ширина)) (quote (binary ширина)))
  (not? (equal? (бінарний (quote ширина)) (quote (binary інша))))
  (equal? (частка-остача (довжина (quote (а б в г)))
                         (довжина (quote (а б))))
          (list (довжина (quote (а б))) (довжина (quote ()))))
  (equal? (частка-остача (довжина (quote (а б в)))
                         (довжина (quote (а б))))
          (list (довжина (quote (а))) (довжина (quote (а)))))
  (not? (equal? (частка-остача (довжина (quote (а б в)))
                               (довжина (quote (а б))))
                (list (довжина (quote (а б))) (довжина (quote ())))))
  ; NUMBER->STRING є текстовою проєкцією канонічного D8 writer,
  ; а не другим десятковим форматом для D24.
  (equal? (число-рядок (довжина (quote (а б))))
          (11110100 (довжина (quote (а б)))))
  (not? (equal? (число-рядок (довжина (quote (а б))))
                (число-рядок (довжина (quote ())))))
  (символ? (quote назва))
  (not? (символ? (list (quote назва))))
  (not? (equal? (бінарний (quote ширина)) (quote (binary)))))
