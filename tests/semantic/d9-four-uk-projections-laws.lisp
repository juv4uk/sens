; Д9: українські виклики трьох ратифікованих замикань із Кор4. двійковий = Д9:110110110.
; Числа є математичними Д24+, довжину обчислює власний закон Д3-Д5.
; 8 позитивних та інверсних законів виконуються самим СЕНС.
; Виконавець Д9: мінімальні ПРЯМІ закони чинного Кор4, без 303 КіБ
; історичних форм, де залишились імена, не представлені Д7 версії 2.
; Зіставити ці визначення з бібліотекою ядра 4; семантику виконує СЕНС.
; Власна мала програма має точний фізичний Т5М та 8 живих свідків.
(визначити список (функція аргументи-функції аргументи-функції))
; Ці визначення виконуються у СЕНС. Д3 тотожне? викликається лише на атомах.
; Жодного сід8 чи невикличної Д6 ДОВЖИНА у фізичному свідку.
(визначити однакові?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве) (за-умовою ((атом? праве) (тотожне? ліве праве)) (так ні)))
   ((атом? праве) ні)
   ((однакові? (перше ліве) (перше праве))
    (однакові? (решта ліве) (решта праве)))
   (так ні))))
(визначити хибне?
 (функція (прапорець)
  (за-умовою (прапорець ні) (так так))))
(визначити порожній?
 (функція (значення)
  (за-умовою ((атом? значення) (тотожне? значення (як-є ()))) (так ні))))
(визначити довжина-списку-д9
 (функція (елементи)
  (за-умовою
   ((атом? елементи) 0)
   (так (додати 1 (довжина-списку-д9 (решта елементи)))))))

(визначити двійковий
  (функція (ширина)
    (список (як-є двійковий) ширина)))
(визначити символ?
  (функція (значення-аргументу)
    (за-умовою
      ((порожній? значення-аргументу) ні)
      ((хибне? (атом? значення-аргументу)) ні)
      ((тотожне? значення-аргументу (текст-у-символ (значення-у-текст значення-аргументу))) так)
      (так ні))))
(визначити частка-остача
  (функція (ділене дільник)
    (список (частка ділене дільник)
      (відняти ділене
        (помножити дільник (частка ділене дільник))))))

; Список Д1 сам по собі не перевіряє закони. Негативний свідок
; зупиняє саме нативний СЕНС, без зовнішнього ствердження та іншої мови.
(визначити довести-всі-вісім
 (функція (свідки)
  (за-умовою
   ((порожній? свідки) так)
   ((перше свідки) (довести-всі-вісім (решта свідки)))
   (так (перше (як-є ()))))))

(довести-всі-вісім
 (список
  (однакові? (двійковий (як-є ширина)) (як-є (двійковий ширина)))
  (хибне? (однакові? (двійковий (як-є ширина)) (як-є (двійковий інша))))
  (однакові? (частка-остача (довжина-списку-д9 (як-є (а б в г)))
                         (довжина-списку-д9 (як-є (а б))))
          (список (довжина-списку-д9 (як-є (а б))) (довжина-списку-д9 (як-є ()))))
  (однакові? (частка-остача (довжина-списку-д9 (як-є (а б в)))
                         (довжина-списку-д9 (як-є (а б))))
          (список (довжина-списку-д9 (як-є (а))) (довжина-списку-д9 (як-є (а)))))
  (хибне? (однакові? (частка-остача (довжина-списку-д9 (як-є (а б в)))
                               (довжина-списку-д9 (як-є (а б))))
                (список (довжина-списку-д9 (як-є (а б))) (довжина-списку-д9 (як-є ())))))
  (символ? (як-є назва))
  (хибне? (символ? (список (як-є назва))))
  (хибне? (однакові? (двійковий (як-є ширина)) (як-є (двійковий))))))

; Виклики використовують повні ратифіковані українські імена.
