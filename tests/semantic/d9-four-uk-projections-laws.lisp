; Д9: українські виклики трьох ратифікованих замикань із Кор4. двійковий = Д9:110110110.
; Числа є математичними Д24+, довжину обчислює власний закон Д3-Д5.
; 8 позитивних та інверсних законів реально виконує сам СЕНС.
; Виконавець Д9: мінімальні ПРЯМІ закони чинного Кор4, без 303 КіБ
; історичних форм, де залишились імена, не представлені Д7 версії 2.
; Виклики йдуть на ратифіковані поверхні Кор4; семантику виконує СЕНС.
; Власна мала програма вимагає перевірки фізичного T5M та 8 живих свідків.
; Д4:1110 СПИСОК уже ратифікований та виконується напряму; повторний визначити заборонений.
; Д3 тотожне? викликається лише на атомах.
; Жодного сід8 чи невикличної Д6 ДОВЖИНА у фізичному свідку.

; Д4:0100 ХИБНЕ? виконується канонічно; локальна реалізація затіняла домен.
; Для перевірки порожнечі використовуємо чинний ратифікований Д4:0101.
; Локальний порожній? через атом? і тотожне? помилково затіняв його.
; Нативні регресії: порожнє - так, складена пара - Д1 ні.
; Хибне рішення завершиться помилкою самого СЕНС.
(за-умовою
 ((порожній? (як-є ())) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (порожній? (список (як-є атом?)))) так)
 (так (перше (як-є ()))))

(визначити довжина-списку-д9
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) 0)
   ((атом? елементи) 0)
   (так (додати 1 (довжина-списку-д9 (решта елементи)))))))

; Д9: SYMBOL? не має доведеного прямого T5M-виклику на Text7.
; Читання (як-є назва) не є Value::Symbol, і symbol->string не
; приймає Text7. Не вдавати доказ через host або невірний міст.
; Окремий прямий закон SYMBOL? повернемо лише після його допуску.
; Прямий Д8:11101110 символ-у-текст зберігає саме назву символу.
; Д8:11110100 значення-у-текст створює wire-проєкцію (#t7), НЕ назву:
; її обернення текст-у-символ давало іншу ідентичність, хибне Д1.

; Іменований D4 DEFINE замість недопущеного негайного value-call LAMBDA.
; Одна й та сама точна D24+ частка використовується в обох полях.
(визначити скласти-частку-й-остачу
  (функція (ділене дільник ціла-частка)
    (список ціла-частка
      (відняти ділене (помножити дільник ціла-частка)))))

; Список Д1 сам по собі не перевіряє закони. Негативний свідок
; зупиняє саме нативний СЕНС, без зовнішнього ствердження та іншої мови.
(визначити довести-всі-вісім
 (функція (свідки)
  (за-умовою
   ((порожній? свідки) так)
   ((перше свідки) (довести-всі-вісім (решта свідки)))
   (так (перше (як-є ()))))))

(довести-всі-вісім
 (список
  (однакові? (двійковий (як-є атом?)) (як-є (двійковий атом?)))
  (хибне? (однакові? (двійковий (як-є атом?)) (як-є (двійковий решта))))
  (однакові? (частка-остача (довжина-списку-д9 (як-є (а б в г)))
                         (довжина-списку-д9 (як-є (а б))))
          (список (довжина-списку-д9 (як-є (а б))) (довжина-списку-д9 (як-є ()))))
  (однакові? (частка-остача (довжина-списку-д9 (як-є (а б в)))
                         (довжина-списку-д9 (як-є (а б))))
          (список (довжина-списку-д9 (як-є (а))) (довжина-списку-д9 (як-є (а)))))
  (хибне? (однакові? (частка-остача (довжина-списку-д9 (як-є (а б в)))
                               (довжина-списку-д9 (як-є (а б))))
                (список (довжина-списку-д9 (як-є (а б))) (довжина-списку-д9 (як-є ())))))
  ; Додаткові живі свідки без сурогату Symbol через Text7:
  ; значення D9 двійковий — власна пара SENS, не байтова адреса.
  (однакові? (двійковий (як-є решта)) (як-є (двійковий решта)))
  ; П'ять елементів / два — ціла частка 2 та остача 1.
  ; Д24+ рахує сам СЕНС, не Python чи shell.
  (однакові?
    (частка-остача (довжина-списку-д9 (як-є (а б в г д)))
                   (довжина-списку-д9 (як-є (а б))))
    (список (довжина-списку-д9 (як-є (а б)))
            (довжина-списку-д9 (як-є (а)))))
  (хибне? (однакові? (двійковий (як-є атом?)) (як-є (двійковий))))))

; Виклики використовують повні ратифіковані українські імена.
