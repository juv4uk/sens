; D9: українські виклики трьох ратифікованих замикань із Core4. BINARY=двійковий, D9:110110110.
; Жодних нових числових літералів: числа утворює D24-довжина.
; 8 позитивних та інверсних законів виконуються самим SENS.
; D9 runtime: мінімальні ПРЯМІ закони чинного Core4, без 303 KiB
; історичних форм, де залишились імена, не представлені D7 v2.
; Зіставити ці визначення з lib/core4.lisp; семантику виконує SENS.
; Власна мала програма має точний фізичний T5M та 8 живих свідків.
; Точні D3-закони Core4, необхідні цьому самостійному D9-свідку.
; D3 ТОТОЖНЕ? порівнює лише атоми; пари рекурсивно CAR/CDR.
; Ні SENS-символи, ні текст D7 не стають байтовими SID8.
(визначити однакові?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((однакові? (перше ліве) (перше праве))
    (однакові? (решта ліве) (решта праве)))
   (так ні))))
(визначити хибне?
 (функція (прапорець)
  (за-умовою
   (прапорець ні)
   (так так))))
(визначити порожній?
 (функція (значення)
  (за-умовою
   ((атом? значення) (тотожне? значення (як-є ())))
   (так ні))))

(визначити список (функція аргументи-функції аргументи-функції))

; EQUAL з Core4 не є вбудованим Text7 викликом фізичного SENS.
; Визначаємо структурну рівність на D3/D5 тут: EQ лише для атомів,
; а пару порівнюємо рекурсивно. Не привласнюємо D8/SID8 координату.
(визначити однакові?
  (функція (ліве праве)
    (за-умовою
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (тотожне? ліве праве))
         (так ні)))
      ((атом? праве) ні)
      ((однакові? (перше ліве) (перше праве))
       (однакові? (решта ліве) (решта праве)))
      (так ні))))
(визначити двійковий
  (функція (ширина)
    (список (як-є binary) ширина)))
(визначити символ?
  (функція (значення-аргументу)
    (за-умовою
      ((порожній? значення-аргументу) ні)
      ((хибне? (атом? значення-аргументу)) ні)
      ((тотожне? значення-аргументу (текст-у-символ (значення-у-текст значення-аргументу))) так)
      (так ні))))
(визначити частка-остача
  (функція (ділене дільник)
    (список (частка ділене дільник)
      (відняти ділене
        (помножити дільник (частка ділене дільник))))))

(список
  (однакові? (двійковий (як-є ширина)) (як-є (binary ширина)))
  (хибне? (однакові? (двійковий (як-є ширина)) (як-є (binary інша))))
  (однакові? (частка-остача (довжина (як-є (а б в г)))
                         (довжина (як-є (а б))))
          (список (довжина (як-є (а б))) (довжина (як-є ()))))
  (однакові? (частка-остача (довжина (як-є (а б в)))
                         (довжина (як-є (а б))))
          (список (довжина (як-є (а))) (довжина (як-є (а)))))
  (хибне? (однакові? (частка-остача (довжина (як-є (а б в)))
                               (довжина (як-є (а б))))
                (список (довжина (як-є (а б))) (довжина (як-є ())))))
  (символ? (як-є назва))
  (хибне? (символ? (список (як-є назва))))
  (хибне? (однакові? (двійковий (як-є ширина)) (як-є (binary)))))

; Виклики використовують повні ратифіковані українські імена.
