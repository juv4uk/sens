; D9: українські виклики трьох ратифікованих замикань із core4.
; Жодних нових числових літералів: числа утворює D24-довжина.
; 8 позитивних та інверсних законів виконуються самим SENS.
(список
  (equal? (бінарний (quote ширина)) (quote (binary ширина)))
  (хибне? (equal? (бінарний (quote ширина)) (quote (binary інша))))
  (equal? (частка-остача (довжина (quote (а б в г)))
                         (довжина (quote (а б))))
          (список (довжина (quote (а б))) (довжина (quote ()))))
  (equal? (частка-остача (довжина (quote (а б в)))
                         (довжина (quote (а б))))
          (список (довжина (quote (а))) (довжина (quote (а)))))
  (хибне? (equal? (частка-остача (довжина (quote (а б в)))
                               (довжина (quote (а б))))
                (список (довжина (quote (а б))) (довжина (quote ())))))
  (символ? (quote назва))
  (хибне? (символ? (список (quote назва))))
  (хибне? (equal? (бінарний (quote ширина)) (quote (binary)))))

