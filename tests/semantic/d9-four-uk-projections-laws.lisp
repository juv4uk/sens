; Д9: українські виклики трьох ратифікованих замикань із Кор4. двійковий = Д9:110110110.
; Числа є математичними Д24+, довжину обчислює власний закон Д3-Д5.
; 8 позитивних та інверсних законів виконуються самим СЕНС.
; Виконавець Д9: мінімальні ПРЯМІ закони чинного Кор4, без 303 КіБ
; історичних форм, де залишились імена, не представлені Д7 версії 2.
; Зіставити ці визначення з бібліотекою ядра 4; семантику виконує СЕНС.
; Власна мала програма має точний фізичний Т5М та 8 живих свідків.
(визначити список (функція аргументи-функції аргументи-функції))
; Ці визначення виконуються у СЕНС. Д3 тотожне? викликається лише на атомах.
; Жодного сід8 чи невикличної Д6 ДОВЖИНА у фізичному свідку.
(визначити однакові?
  (функція (перший-аргумент другий-аргумент)
    (за-умовою
      ((порожній? перший-аргумент) (порожній? другий-аргумент))
      ((порожній? другий-аргумент)
       (атом? (як-є (()))))
      ((атом? перший-аргумент)
       (за-умовою
         ((атом? другий-аргумент)
          (тотожне? перший-аргумент другий-аргумент))
         ((атом? (як-є ()))
          (атом? (як-є (()))))))
      ((атом? другий-аргумент)
       (атом? (як-є (()))))
      ((однакові? (перше перший-аргумент) (перше другий-аргумент))
       (однакові? (решта перший-аргумент) (решта другий-аргумент)))
      ((атом? (як-є ()))
       (атом? (як-є (())))))))
(визначити хибне?
  (функція (значення-аргументу)
    (за-умовою
      (значення-аргументу (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (як-є ())) (атом? (як-є ()))))))
(визначити порожній?
  (функція (аргумент-х)
    (за-умовою
      ((атом? аргумент-х)
       (тотожне? аргумент-х (як-є ())))
      ((тотожне? (як-є x) (як-є x))
       (атом? (сполучити (як-є x) (як-є ())))))))
(визначити довжина-списку-д9
 (функція (елементи)
  (за-умовою
   ((атом? елементи) 0)
   (так (додати 1 (довжина-списку-д9 (решта елементи)))))))

(визначити двійковий
  (функція (ширина)
    (список (як-є binary) ширина)))
(визначити символ?
  (функція (значення-аргументу)
    (за-умовою
      ((порожній? значення-аргументу) ні)
      ((хибне? (атом? значення-аргументу)) ні)
      ((тотожне? значення-аргументу (текст-у-символ (значення-у-текст значення-аргументу))) так)
      (так ні))))
; D5 частка є точною математичною часткою (для 3/2 — дріб),
; а НЕ цілою евклідовою часткою. Тому q=ділене/дільник тут було
; семантично хибним: 3/2 давало залишок 0 замість 1.
; Для невід'ємних D24+ цілих одержуємо q,r лише законами SENS:
; 0 <= r < дільник та ділене = q*дільник + r.
; Це навмисно проста опорна реалізація, не host-ділення.
(визначити частка-остача-обхід
  (функція (залишок дільник частка-ціла)
    (за-умовою
      ((менше? залишок дільник) (список частка-ціла залишок))
      (так (частка-остача-обхід
            (відняти залишок дільник)
            дільник
            (додати частка-ціла 1))))))
(визначити частка-остача
  (функція (ділене дільник)
    (за-умовою
      ((нуль? дільник) (перше (як-є ())))
      ((менше? ділене 0) (перше (як-є ())))
      ((менше? дільник 0) (перше (як-є ())))
      (так (частка-остача-обхід ділене дільник 0)))))

; Список Д1 сам по собі не перевіряє закони. Негативний свідок
; зупиняє саме нативний СЕНС, без зовнішнього ствердження та іншої мови.
(визначити довести-всі-вісім
 (функція (свідки)
  (за-умовою
   ((порожній? свідки) так)
   ((перше свідки) (довести-всі-вісім (решта свідки)))
   (так (перше (як-є ()))))))

(довести-всі-вісім
 (список
  (однакові? (двійковий (як-є атом?)) (як-є (binary атом?)))
  (хибне? (однакові? (двійковий (як-є атом?)) (як-є (binary решта))))
  (однакові? (частка-остача (довжина-списку-д9 (як-є (а б в г)))
                         (довжина-списку-д9 (як-є (а б))))
          (список (довжина-списку-д9 (як-є (а б))) (довжина-списку-д9 (як-є ()))))
  (однакові? (частка-остача (довжина-списку-д9 (як-є (а б в)))
                         (довжина-списку-д9 (як-є (а б))))
          (список (довжина-списку-д9 (як-є (а))) (довжина-списку-д9 (як-є (а)))))
  (хибне? (однакові? (частка-остача (довжина-списку-д9 (як-є (а б в)))
                               (довжина-списку-д9 (як-є (а б))))
                (список (довжина-списку-д9 (як-є (а б))) (довжина-списку-д9 (як-є ())))))
  (символ? (як-є сполучити))
  (хибне? (символ? (список (як-є сполучити))))
  (хибне? (однакові? (двійковий (як-є атом?)) (як-є (binary))))))

; Виклики використовують повні ратифіковані українські імена.
