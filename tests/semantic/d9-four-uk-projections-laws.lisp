; D9: українські виклики трьох ратифікованих замикань із Core4. BINARY=двійковий, D9:110110110.
; Математичні цілі 0–4 — людська проєкція точних D24 операндів;
; D6:000000 ДОВЖИНА є ратифікованим резидентом, але не допущеним викликом.
; Не підміняти недопущений D6-виклик арифметикою D7/хоста.
; 8 позитивних та інверсних законів виконуються самим SENS.
; D9 runtime: мінімальні ПРЯМІ закони чинного Core4, без 303 KiB
; історичних форм, де залишились імена, не представлені D7 v2.
; Зіставити ці визначення з lib/core4.lisp; семантику виконує SENS.
; Власна мала програма має точний фізичний T5M та 8 живих свідків.
(визначити список (функція аргументи-функції аргументи-функції))

; Точне мовне визначення D8:11110111 із чинного Core4 (не D7-опкод).
(визначити однакові?
  (функція (перший-аргумент другий-аргумент)
    (за-умовою
      ((порожній? перший-аргумент) (порожній? другий-аргумент))
      ((порожній? другий-аргумент)
       (атом? (як-є (()))))
      ((атом? перший-аргумент)
       (за-умовою
         ((атом? другий-аргумент)
          (тотожне? перший-аргумент другий-аргумент))
         ((атом? (як-є ()))
          (атом? (як-є (()))))))
      ((атом? другий-аргумент)
       (атом? (як-є (()))))
      ((однакові? (перше перший-аргумент) (перше другий-аргумент))
       (однакові? (решта перший-аргумент) (решта другий-аргумент)))
      ((атом? (як-є ()))
       (атом? (як-є (())))))))
(визначити двійковий
  (функція (ширина)
    (список (як-є binary) ширина)))
(визначити символ?
  (функція (значення-аргументу)
    (за-умовою
      ((порожній? значення-аргументу) ні)
      ((хибне? (атом? значення-аргументу)) ні)
      ((тотожне? значення-аргументу (текст-у-символ (значення-у-текст значення-аргументу))) так)
      (так ні))))
(визначити частка-остача
  (функція (ділене дільник)
    (список (частка ділене дільник)
      (відняти ділене
        (помножити дільник (частка ділене дільник))))))

; Закон 1: SENS повертає D1 істину, інакше CAR(NIL) є реальною помилкою.
(за-умовою
 ((однакові? (двійковий (як-є ширина)) (як-є (binary ширина))) так)
 (так (перше (як-є ()))))

; Закон 2: SENS повертає D1 істину, інакше CAR(NIL) є реальною помилкою.
(за-умовою
 ((хибне? (однакові? (двійковий (як-є ширина)) (як-є (binary інша)))) так)
 (так (перше (як-є ()))))

; Закон 3: SENS повертає D1 істину, інакше CAR(NIL) є реальною помилкою.
(за-умовою
 ((однакові? (частка-остача 4
                         2)
          (список 2 0)) так)
 (так (перше (як-є ()))))

; Закон 4: SENS повертає D1 істину, інакше CAR(NIL) є реальною помилкою.
(за-умовою
 ((однакові? (частка-остача 3
                         2)
          (список 1 1)) так)
 (так (перше (як-є ()))))

; Закон 5: SENS повертає D1 істину, інакше CAR(NIL) є реальною помилкою.
(за-умовою
 ((хибне? (однакові? (частка-остача 3
                               2)
                (список 2 0))) так)
 (так (перше (як-є ()))))

; Закон 6: SENS повертає D1 істину, інакше CAR(NIL) є реальною помилкою.
(за-умовою
 ((символ? (як-є назва)) так)
 (так (перше (як-є ()))))

; Закон 7: SENS повертає D1 істину, інакше CAR(NIL) є реальною помилкою.
(за-умовою
 ((хибне? (символ? (список (як-є назва)))) так)
 (так (перше (як-є ()))))

; Закон 8: SENS повертає D1 істину, інакше CAR(NIL) є реальною помилкою.
(за-умовою
 ((хибне? (однакові? (двійковий (як-є ширина)) (як-є (binary)))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))

; Виклики використовують повні ратифіковані українські імена.
