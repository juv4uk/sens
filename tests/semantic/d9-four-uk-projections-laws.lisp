; D9: українські виклики трьох ратифікованих замикань із Core4. BINARY=двійковий, D9:110110110.
; Математичні цілі 0–4 — людська проєкція точних D24 операндів;
; D6:000000 ДОВЖИНА є ратифікованим резидентом, але не допущеним викликом.
; Не підміняти недопущений D6-виклик арифметикою D7/хоста.
; 8 позитивних та інверсних законів виконуються самим SENS.
; D9 runtime: мінімальні ПРЯМІ закони чинного Core4, без 303 KiB
; історичних форм, де залишились імена, не представлені D7 v2.
; Зіставити ці визначення з lib/core4.lisp; семантику виконує SENS.
; Власна мала програма має точний фізичний T5M та 8 живих свідків.
(визначити список (функція аргументи-функції аргументи-функції))

; Точне мовне визначення D8:11110111 із чинного Core4 (не D7-опкод).
(визначити однакові?
  (функція (перший-аргумент другий-аргумент)
    (за-умовою
      ((порожній? перший-аргумент) (порожній? другий-аргумент))
      ((порожній? другий-аргумент)
       (атом? (як-є (()))))
      ((атом? перший-аргумент)
       (за-умовою
         ((атом? другий-аргумент)
          (тотожне? перший-аргумент другий-аргумент))
         ((атом? (як-є ()))
          (атом? (як-є (()))))))
      ((атом? другий-аргумент)
       (атом? (як-є (()))))
      ((однакові? (перше перший-аргумент) (перше другий-аргумент))
       (однакові? (решта перший-аргумент) (решта другий-аргумент)))
      ((атом? (як-є ()))
       (атом? (як-є (())))))))
(визначити двійковий
  (функція (ширина)
    (список (як-є binary) ширина)))
(визначити символ?
  (функція (значення-аргументу)
    (за-умовою
      ((порожній? значення-аргументу) ні)
      ((хибне? (атом? значення-аргументу)) ні)
      ((тотожне? значення-аргументу (текст-у-символ (значення-у-текст значення-аргументу))) так)
      (так ні))))
; D9:111111111 DIVMOD: точна ціла частка та остача невід'ємних D24+.
; D5:10111 ЧАСТКА — раціональне ділення: 3/2 НЕ є цілою часткою 1.
; Один рекурсивний бінарний обхід: ділимо спочатку на подвоєний
; дільник і повертаємо (2q + біт, r) за точним D5 порівнянням.
; Подвоєння припустиме тільки якщо (ділене - дільник) >= дільник:
; це не переносить тимчасово D24 у D48 перед перевіркою меж.
(визначити частка-остача-від-подвоєного
 (функція (пара-подвоєна дільник)
  (за-умовою
   ((менше? (друге пара-подвоєна) дільник)
    (список (додати (перше пара-подвоєна) (перше пара-подвоєна))
            (друге пара-подвоєна)))
   (так
    (список
      (додати (додати (перше пара-подвоєна) (перше пара-подвоєна)) 1)
      (відняти (друге пара-подвоєна) дільник))))))

(визначити частка-остача-невідємні
 (функція (ділене дільник)
  (за-умовою
   ((менше? ділене дільник) (список 0 ділене))
   ((менше? (відняти ділене дільник) дільник)
    (список 1 (відняти ділене дільник)))
   (так
    (частка-остача-від-подвоєного
      (частка-остача-невідємні ділене (додати дільник дільник))
      дільник)))))

(визначити частка-остача
 (функція (ділене дільник)
  (за-умовою
   ((нуль? дільник) (частка ділене дільник))
   ((менше? ділене (відняти ділене ділене)) (перше (як-є ())))
   ((менше? дільник (відняти дільник дільник)) (перше (як-є ())))
   (так (частка-остача-невідємні ділене дільник)))))


