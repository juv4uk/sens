; Вісім виконуваних законів трьох похідних функцій D9.
; ОБ'ЄДНАННЯ-НА-МІСЦІ: ратифікований D9:110001100.
; У незмінній мові СЕНС воно має структурний результат об'єднання.
; ЗАСТОСУВАТИ-ПІДСТАНОВКА: ратифікований D9:101101001.
; СВІТ-ГЛИБИНА: D9:111001011 — глибина двійкового дерева пар.
; Операції вже визначено у lib/core4.lisp, повторних реалізацій немає.
; Дані в цитованих формах залишено без змін.
; Для (a (b)) глибина дорівнює 3: два вузли у хвості й коренева пара.

(список
  (однакові? (об'єднання-на-місці (список (як-є а)) (список (як-є б)))
            (об'єднання (список (як-є а)) (список (як-є б))))
  (однакові? (об'єднання-на-місці (список (як-є а)) (список (як-є а)))
            (список (як-є а)))
  (однакові? (застосувати-підстановка (як-є нове) (як-є старе)
                                     (список (як-є старе) (як-є x)))
            (список (як-є нове) (як-є x)))
  (однакові? (світ-глибина (як-є ())) 0)
  (однакові? (світ-глибина (як-є атом)) 0)
  (однакові? (світ-глибина (список (як-є a))) 1)
  (однакові? (світ-глибина (список (список (як-є a)))) 2)
  (однакові? (світ-глибина (список (як-є a) (список (як-є b)))) 3))
