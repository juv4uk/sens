; Живі закони української проєкції SENS: логіка D1, пари D3 і функція D4.
; Семантичний вердикт обчислює сам SENS; зовнішній виконавець не порівнює відповіді.
; Кожен хибний результат веде до навмисно невизначеної голови.
; Жодних SID8/Sens8, цифрових голів чи числових літералів.

(визначити вимагати-мовний-закон
  (функція (назва-закону умова)
    (за-умовою
      (умова (як-є ()))
      ((хибне? умова) (порушено-мовний-закон назва-закону)))))

; D3 — структурна порожнеча, атом, пара, цитування та тотожність.
(вимагати-мовний-закон (як-є порожнє-є-атомом)
  (атом? (як-є ())))
(вимагати-мовний-закон (як-є символ-є-атомом)
  (атом? (як-є антена)))
(вимагати-мовний-закон (як-є пара-не-атом)
  (хибне? (атом? (сполучити (як-є радіо) (як-є антена)))))
(вимагати-мовний-закон (як-є рефлексивна-тотожність)
  (тотожне? (як-є радіо) (як-є радіо)))
(вимагати-мовний-закон (як-є відмінні-атоми)
  (хибне? (тотожне? (як-є радіо) (як-є антена))))
(вимагати-мовний-закон (як-є перше-сполученої-пари)
  (тотожне? (перше (сполучити (як-є радіо) (як-є антена))) (як-є радіо)))
(вимагати-мовний-закон (як-є решта-сполученої-пари)
  (тотожне? (решта (сполучити (як-є радіо) (як-є антена))) (як-є антена)))
(вимагати-мовний-закон (як-є цитування-не-виконує-дані)
  (тотожне? (перше (як-є (невизначений-виклик антена))) (як-є невизначений-виклик)))

; D3 COND бере першу істинну умову, а хибну гілку не виконує.
(вимагати-мовний-закон (як-є умова-коротке-замикання)
  (тотожне?
    (за-умовою
      ((хибне? (атом? (як-є ()))) (помилкове-виконання-гілки))
      ((атом? (як-є ())) (як-є допустима-гілка)))
    (як-є допустима-гілка)))

; D4 LAMBDA зберігає точну тотожність переданого атома.
(вимагати-мовний-закон (як-є параметр-функції)
  (тотожне? ((функція (значення) значення) (як-є сигнал)) (як-є сигнал)))

(як-є (мовні-закони-пройдено))
