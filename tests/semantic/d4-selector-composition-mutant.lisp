; Негативний Д4 свідок: четверте порівняння хибне; SENS мусить повернути Д1:ні.
; Мутація змінює лише очікуваний атом, не логіку селектора.
((функція (структура)
  ; перше-першого повертає голову внутрішнього списку
  (за-умовою
    ((тотожне? (перше-першого структура) (як-є атом?))
      ; решта-першого зберігає другу голову першої пари
      (за-умовою
        ((тотожне? (перше (решта-першого структура)) (як-є решта))
          ; друге обирає другий внутрішній список
          (за-умовою
            ((тотожне? (перше (друге структура)) (як-є тотожне?))
              ; CAR(CDR(CADR)) обирає хвіст другого внутрішнього списку (хибне очікування)
              (за-умовою
                ((тотожне? (перше (решта (друге структура))) (як-є решта))
                  ; решта-решти відкидає рівно два елементи
                  (за-умовою
                    ((тотожне? (перше (решта-решти структура)) (як-є за-умовою))
                      ; після останнього елемента є NIL
                      (за-умовою
                        ((порожній? (решта (решта-решти структура)))
                          так)
                        (так ні)))
                    (так ні)))
                (так ні)))
            (так ні)))
        (так ні)))
    (так ні)))
 (список
   (список (як-є атом?) (як-є решта))
   (список (як-є тотожне?) (як-є сполучити))
   (як-є за-умовою)))
