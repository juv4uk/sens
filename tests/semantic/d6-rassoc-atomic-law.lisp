; Д6 RASSOC: часткове Д3 EQ не отримує структурні значення.
; Відхиляємо структурні кандидати без Type; обираємо ПЕРШУ атомарну пару.
; Вердикт належить виключно SENS, без host-оракула.
(за-умовою
  ((однакові?
     (знайти-за-значенням так
       (список
         (сполучити ні (список так ні))
         (сполучити так так)))
     (сполучити так так))
   (за-умовою
     ((порожній?
        (знайти-за-значенням
          (список так ні)
          (список (сполучити так (список так ні)))))
      (за-умовою
        ((однакові?
           (знайти-за-значенням так
             (список
               (сполучити ні так)
               (сполучити так так)))
           (сполучити ні так))
         так)
        (так ні)))
     (так ні)))
  (так ні))
