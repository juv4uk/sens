
; Вісім перевірок одинадцяти законів відповідності Канону.
; Значення істини та хиби беруться з першого домену без закодованих літералів.
; Цитовані мітки стану належать чинному протоколу Канону.
(список
  (однакові? (канон-відповідає?)
          (канон-відповідність-результат (як-є satisfied)))
  (однакові? (канон-запис-д1-ознаки (як-є car-cons) так)
          (канон-закон-виконаний (як-є car-cons)))
  (однакові? (канон-запис-д1-ознаки (як-є car-cons) ні)
          (канон-закон-порушений (як-є car-cons)))
  (тотожне? (канон-закон-стан
             (канон-запис-д1-ознаки (як-є cdr-cons) так))
            (як-є satisfied))
  (тотожне? (канон-закон-стан
             (канон-запис-д1-ознаки (як-є cdr-cons) ні))
            (як-є violated))
  (однакові? (канон-відповідність-з (як-є ()))
          (канон-відповідність-результат (як-є satisfied)))
  (однакові? (канон-відповідність-з
             (список (канон-запис-д1-ознаки (як-є law-x) так)
                     (канон-запис-д1-ознаки (як-є law-y) так)))
          (канон-відповідність-результат (як-є satisfied)))
  (однакові? (канон-відповідність-з
             (список (канон-запис-д1-ознаки (як-є law-x) так)
                     (канон-запис-д1-ознаки (як-є law-y) ні)))
          (канон-відповідність-результат (як-є violated))))
