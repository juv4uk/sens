; Закони тотожності фактів з обґрунтуваннями дев'ятого домену.
; Перевірки розрізняють сам факт і список його підстав.
; Вісім позитивних та заперечних випадків виконуються мовою СЕНС.
(список
  (обґрунтований-член? (як-є факт-а)
    (список (сполучити (як-є факт-а) (список (як-є опора)))))
  (хибне? (обґрунтований-член? (як-є немає)
    (список (сполучити (як-є факт-а) (список (як-є опора))))))
  (обґрунтований-член? (список (як-є складний) (як-є факт))
    (список (сполучити (список (як-є складний) (як-є факт))
                       (список (як-є опора)))))
  (однакові?
    (видалити-обґрунтований (як-є факт-а)
      (список
        (сполучити (як-є факт-а) (список (як-є опора-1)))
        (сполучити (як-є факт-б) (список (як-є опора-2)))
        (сполучити (як-є факт-а) (список (як-є опора-3)))))
    (список (сполучити (як-є факт-б) (список (як-є опора-2)))))
  (однакові?
    (видалити-обґрунтований (як-є немає)
      (список (сполучити (як-є факт-а) (список (як-є опора)))))
    (список (сполучити (як-є факт-а) (список (як-є опора)))))
  (однакові?
    (додати-нові-обґрунтований
      (список
        (сполучити (як-є факт-а) (список (як-є інша-опора)))
        (сполучити (як-є факт-б) (список (як-є опора-б))))
      (список (сполучити (як-є факт-а) (список (як-є опора-а)))))
    (список
      (сполучити (як-є факт-б) (список (як-є опора-б)))
      (сполучити (як-є факт-а) (список (як-є опора-а)))))
  (однакові?
    (додати-нові-обґрунтований (як-є ())
      (список (сполучити (як-є факт-а) (список (як-є опора-а)))))
    (список (сполучити (як-є факт-а) (список (як-є опора-а)))))
  (однакові?
    (додати-нові-обґрунтований
      (список
        (сполучити (як-є факт-а) (список (як-є опора-а)))
        (сполучити (як-є факт-б) (список (як-є опора-б))))
      (як-є ()))
    (список
      (сполучити (як-є факт-б) (список (як-є опора-б)))
      (сполучити (як-є факт-а) (список (як-є опора-а))))))
