; Закон додавання перевернутої асоціації восьмого домену.
; Два позитивні приклади перевіряють порожній і непорожній список.
; Негативний приклад перевіряє, що порядок значення й ключа
; не можна відновити довільним переставленням.
; Очікувані відповіді за порядком є так, так, ні.
(список
  (однакові?
    (додати-асоціацію-навпаки (як-є новий-ключ) (як-є нове-значення) (список))
    (список (сполучити (як-є нове-значення) (як-є новий-ключ))))
  (однакові?
    (додати-асоціацію-навпаки
      (як-є новий-ключ) (як-є нове-значення)
      (список (сполучити (як-є старий-ключ) (як-є старе-значення))))
    (список
      (сполучити (як-є нове-значення) (як-є новий-ключ))
      (сполучити (як-є старе-значення) (як-є старий-ключ))))
  (однакові?
    (додати-асоціацію-навпаки
      (як-є новий-ключ) (як-є нове-значення)
      (список (сполучити (як-є старий-ключ) (як-є старе-значення))))
    (список
      (сполучити (як-є нове-значення) (як-є новий-ключ))
      (сполучити (як-є старий-ключ) (як-є старе-значення)))))
