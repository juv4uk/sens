  ((хибне? (тотожне? (як-є альфа) (як-є бета)))
    (за-умовою
      ((тотожне?
         (перше (сполучити (як-є альфа) (як-є ())))
         (як-є альфа))
        (за-умовою
          ((хибне? (атом? (сполучити (як-є альфа) (як-є ()))))
            (атом? (як-є ())))
          ((атом? (як-є ())) (ні (як-є порушення-атома)))))
      ((атом? (як-є ())) (ні (як-є порушення-першого)))))
  ((атом? (як-є ())) (ні (як-є порушення-рівності))))
