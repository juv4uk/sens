; Негативний мутант закону де Моргана: у правій частині двічі взято НЕ ліве.
; Друга гілка має перевіряти НЕ праве, отже при (так ні) результат Д1:ні.
; Це повний виконуваний Lisp-контрприклад, без хостового оракула.
((функція (перевірити)
   (за-умовою
     ((перевірити так так)
       (за-умовою
         ((перевірити так ні)
           (за-умовою
             ((перевірити ні так)
               (за-умовою
                 ((перевірити ні ні) так)
                 (так ні)))
             (так ні)))
         (так ні)))
     (так ні)))
 (функція (ліве праве)
   (тотожне?
     (хибне?
       (за-умовою
         (ліве (за-умовою (праве так) (так ні)))
         (так ні)))
     (за-умовою
       ((хибне? ліве) так)
       ((хибне? ліве) так)
       (так ні)))))
