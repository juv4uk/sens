; Д6:111100 ANY / Д6:111101 ALL — чинні викличні мовні функції.
; D3-пари будує D4 СПИСОК; перший збіг, усі атоми та порожній ввід.
; Повертаємо точну істину D1:так. Немає вигаданого машинного opcode.
(за-умовою
  ((будь-яке?
     (функція (елемент) (тотожне? елемент (як-є б)))
     (список (як-є а) (як-є б)))
   (за-умовою
     ((усі?
        (функція (елемент) (атом? елемент))
        (список (як-є а) (як-є б)))
      (за-умовою
        ((хибне?
           (будь-яке?
             (функція (елемент) (атом? елемент))
             (як-є ())))
         (усі?
           (функція (елемент) (атом? елемент))
           (як-є ())))
        (так ні)))
     (так ні)))
  (так ні))
