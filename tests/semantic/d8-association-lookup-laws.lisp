; Сім перевірок пошуку асоціацій за тотожністю ключа або умовою.
; Позитивні й негативні свідки відрізняють ключі від значень.
(список
  (однакові? (знайти-асоціацію-за-тотожністю (як-є ключ-два)
            (список (сполучити (як-є ключ-один) (як-є значення-один))
                  (сполучити (як-є ключ-два) (як-є значення-два))))
          (сполучити (як-є ключ-два) (як-є значення-два)))
  (порожній? (знайти-асоціацію-за-тотожністю (як-є немає)
           (список (сполучити (як-є ключ-один) (як-є значення-один)))))
  (порожній? (знайти-асоціацію-за-тотожністю (як-є значення-два)
           (список (сполучити (як-є ключ-два) (як-є значення-два)))))
  (однакові? (знайти-асоціацію-якщо
            (функція (елемент) (однакові? елемент (як-є значення-два)))
            (список (сполучити (як-є ключ-один) (як-є значення-один))
                  (сполучити (як-є ключ-два) (як-є значення-два))))
          (сполучити (як-є ключ-два) (як-є значення-два)))
  (порожній? (знайти-асоціацію-якщо
           (функція (елемент) (однакові? елемент (як-є немає)))
           (список (сполучити (як-є ключ-два) (як-є значення-два)))))
  (порожній? (знайти-асоціацію-якщо
           (функція (елемент) (однакові? елемент (як-є ключ-два)))
           (список (сполучити (як-є ключ-два) (як-є значення-два)))))
  (порожній? (знайти-асоціацію-якщо
           (функція (елемент) (однакові? елемент (як-є будь-що))) (як-є ()))))
