; Д11: шостий селектор, дев'ять законів із D1/D2 даними.
; D7-текстові контрприклади продовжують окремо падати в D7-тестах,
; тут перевіряється виключно позиція, а не декодування текстових гліфів.
; Точне визначення шосте-значення-групи походить з lib/meta-eval.lisp.
; Усі закони виконує SENS після Zig/T5M. Невдача викликає CAR Type.

; шостий елемент шести.
(за-умовою
  ((однакові? (шосте-значення-групи (список так так так так так ні)) ні) так)
  (так (перше (як-є ()))))

; не перший.
(за-умовою
  ((хибне? (однакові? (шосте-значення-групи (список так так так так так ні)) так)) так)
  (так (перше (як-є ()))))

; не п'ятий.
(за-умовою
  ((хибне? (однакові? (шосте-значення-групи (список так так так так так ні)) (перше (решта (решта (решта (решта (список так так так так так ні)))))))) так)
  (так (перше (як-є ()))))

; не сьомий.
(за-умовою
  ((хибне? (однакові? (шосте-значення-групи (список так так так так так ні так)) так)) так)
  (так (перше (як-є ()))))

; сім елементів не зсувають шостий.
(за-умовою
  ((однакові? (шосте-значення-групи (список так так так так так ні так)) ні) так)
  (так (перше (як-є ()))))

; вкладена пара шостою.
(за-умовою
  ((однакові? (шосте-значення-групи (список так так так так так (сполучити так ні))) (сполучити так ні)) так)
  (так (перше (як-є ()))))

; вкладена пара не атом.
(за-умовою
  ((хибне? (однакові? (шосте-значення-групи (список так так так так так (сполучити так ні))) так)) так)
  (так (перше (як-є ()))))

; порожній шостий.
(за-умовою
  ((однакові? (шосте-значення-групи (список так так так так так (як-є ()))) (як-є ())) так)
  (так (перше (як-є ()))))

; повторені D1.
(за-умовою
  ((однакові? (шосте-значення-групи (список так так так так так ні ні)) ні) так)
  (так (перше (як-є ()))))

; Власний фінальний результат D1:так.
(атом? (як-є ()))
