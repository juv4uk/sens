; Закон рекурсії D4/D5: DEFINE, LAMBDA, COND, CAR, CDR, ATOM, NIL.
; Саме SENS обчислює успіх/контрприклад; Zig переносить фізичний T5M.
; Жодних цифрових голів, SID8, числових літералів чи D7-дублів NIL.
; Негативний мутант змінює умову рекурсії, а не очікувану відповідь.

(визначити усі-атоми-рекурсивно?
  (функція (залишок)
    (за-умовою
      ((порожній? залишок) (атом? (як-є ())))
      ((хибне? (атом? (перше залишок)))
       (усі-атоми-рекурсивно? (решта залишок)))
      ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ())))))))

; Для пустого списку — істина; для двох атомів — істина;
; вкладена пара — не атом, тому рекурсивний предикат хибний.
(за-умовою
  ((хибне? (усі-атоми-рекурсивно? (як-є ()))) (атом? (сполучити (як-є ()) (як-є ()))))
  ((хибне?
     (усі-атоми-рекурсивно?
       (сполучити (як-є ())
         (сполучити (як-є ()) (як-є ()))))) (атом? (сполучити (як-є ()) (як-є ()))))
  ((усі-атоми-рекурсивно?
     (сполучити
       (сполучити (як-є ()) (як-є ()))
       (як-є ()))) (атом? (сполучити (як-є ()) (як-є ()))))
  ((атом? (як-є ())) (атом? (як-є ()))))
