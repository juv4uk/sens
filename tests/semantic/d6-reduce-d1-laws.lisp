; Закони згортання порожнього та непорожнього списку.
; Перевірки виявляють втрату першого або останнього елемента.
(список
  (однакові?
    (згорнути (функція (накопичене елемент) (сполучити елемент накопичене))
      (як-є ()) (список (як-є а) (як-є б) (як-є в)))
    (список (як-є в) (як-є б) (як-є а)))
  (однакові?
    (згорнути (функція (накопичене елемент) (сполучити елемент накопичене))
      (як-є ()) (список (як-є а) (як-є б)))
    (список (як-є б) (як-є а)))
  (однакові?
    (згорнути (функція (накопичене елемент) (сполучити елемент накопичене))
      (як-є а) (як-є ()))
    (як-є а)))
