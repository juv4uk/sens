; SENS_SOURCE=tests/semantic/бенчмарк-медіана-law.lisp
; NATIVE_SENS_POSITIVE=NOT_VERIFIED
; NATIVE_SENS_NEGATIVE=NOT_VERIFIED
;
; Структурний свідок медіани: три виміри, середній після впорядкування.
; Без Python, без JSON, без SHA-256.

(визначити порожній-список? (функція (xs) (порожній? xs)))

(визначити взяти-перше
  (функція (xs)
    (перше xs)))

; Три однакові виміри — медіана є першим елементом упорядкованого списку.
; Тут лише перевірка, що список з трьох «так» не порожній і перший — так.
(за-умовою
  ((хибне? (порожній-список? (сполучити так (сполучити так (сполучити так (як-є ()))))))
   (за-умовою
     ((тотожне? (взяти-перше (сполучити так (сполучити так (сполучити так (як-є ()))))) так)
      так)
     (так (ні))))
  (так (ні)))
