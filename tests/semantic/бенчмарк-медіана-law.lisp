;
; Медіана працює лише з трьома впорядкованими зразками.
; Усі перевірки розміру та вибір середнього елемента — SENS.
(визначити рівно-три?
  (функція (зразки)
    (за-умовою
      ((атом? зразки) ні)
      ((атом? (решта зразки)) ні)
      ((атом? (решта (решта зразки))) ні)
      ((атом? (решта (решта (решта зразки))))
       (тотожне? (решта (решта (решта зразки))) (як-є ())))
      (так ні))))

(визначити медіана-трьох
  (функція (зразки)
    (за-умовою
      ((рівно-три? зразки)
       (перше (решта зразки)))
      (так (як-є ())))))

(за-умовою
  ((рівне?
     (сполучити (як-є вимір) (як-є ()))
     (сполучити (як-є вимір) (як-є ())))
   (за-умовою
     ((хибне?
        (рівне?
          (сполучити (як-є вимір) (як-є ()))
          (сполучити (як-є інший-вимір) (як-є ()))))
      (за-умовою
  ((тотожне?
     (медіана-трьох
       (сполучити (як-є низький)
         (сполучити (як-є середній)
           (сполучити (як-є високий) (як-є ())))))
     (як-є середній))
   (за-умовою
     ((тотожне?
        (медіана-трьох
          (сполучити (як-є низький)
            (сполучити (як-є середній) (як-є ()))))
        (як-є ()))
      (за-умовою
        ((тотожне?
           (медіана-трьох
             (сполучити (як-є низький)
               (сполучити (як-є середній)
                 (сполучити (як-є високий)
                   (сполучити (як-є зайвий) (як-є ()))))))
           (як-є ()))
         так)
        (так (ні))))
     (так (ні))))
  (так (ні))))
     (так (ні))))
  (так (ні)))
