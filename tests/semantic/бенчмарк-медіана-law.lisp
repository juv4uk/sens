;
; Три вже впорядковані зразки. Медіана — середній елемент,
; який вибирається мовною композицією решта/перше.
(визначити медіана-трьох
  (функція (зразки)
    (перше (решта зразки))))

(за-умовою
  ((тотожне?
     (медіана-трьох
       (сполучити (як-є низький)
         (сполучити (як-є середній)
           (сполучити (як-є високий) (як-є ())))))
     (як-є середній))
   так)
  (так (ні)))
