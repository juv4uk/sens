; Семантика списку: перше / решта / сполучити — структурний закон.

(визначити свідок-списку
  (функція ()
    (нехай ((с (сполучити (як-є а) (сполучити (як-є б) (як-є ())))))
      (за-умовою
        ((тотожне? (перше с) (як-є а))
         (за-умовою
           ((тотожне? (перше (решта с)) (як-є б))
            (за-умовою
              ((атом? (решта (решта с)))
               (як-є (закон-списку (status pass))))
              (так (як-є (закон-списку (status fail))))))
           (так (як-є (закон-списку (status fail))))))
        (так (як-є (закон-списку (status fail))))))))

(свідок-списку)
