; Виконуваний закон СІМЕЙСТВА АСОЦІАЦІЙ Д11 (d11-family-association).
;
; Мовний семантичний свідок на НАЯВНІЙ функції lib/d11-srfi1-alist-protocol.lisp.
; Самовердикт: хибний факт веде в (перше (як-є ())) — невикличний вираз.
; Закон: пошук за ключем повертає ПЕРШИЙ збіг; не знайдено → (ні ()); D1 ні — не помилка.

; Знайдено: ключ б → (так (б . у)).
(за-умовою
  ((однакові? (знайти-запис-із-наявністю
                (функція (ключ запис-ключ) (тотожне? ключ запис-ключ))
                (як-є б)
                (список (сполучити (як-є а) (як-є х))
                        (сполучити (як-є б) (як-є у))))
              (список так (сполучити (як-є б) (як-є у)))) так)
  (так (перше (як-є ()))))

; Перший збіг: два записи з ключем а → береться перший (а . х).
(за-умовою
  ((однакові? (знайти-запис-із-наявністю
                (функція (ключ запис-ключ) (тотожне? ключ запис-ключ))
                (як-є а)
                (список (сполучити (як-є а) (як-є х))
                        (сполучити (як-є а) (як-є з))))
              (список так (сполучити (як-є а) (як-є х)))) так)
  (так (перше (як-є ()))))

; Не знайдено: порожній список → (ні ()).
(за-умовою
  ((однакові? (знайти-запис-із-наявністю
                (функція (ключ запис-ключ) (тотожне? ключ запис-ключ))
                (як-є а) (як-є ()))
              (список ні (як-є ()))) так)
  (так (перше (як-є ()))))

; D11: негативні контрприклади саме для форми alist, а не для
; співпадіння ключів. Булевий вердикт лишається у справжньому SENS.
; Правильне завершення і запис з D1 ні як даними є допустимими.
(за-умовою
  ((правильна-таблиця-асоціацій?
     (список (сполучити (як-є а) ні))) так)
  (так (перше (як-є ()))))

; Список записів не можна завершувати D1 ні замість D3 ().
(за-умовою
  ((хибне?
     (правильна-таблиця-асоціацій?
       (сполучити (сполучити (як-є а) ні) ні))) так)
  (так (перше (як-є ()))))

; Елемент алісту повинен бути парою; D1 ні сам по собі не запис.
(за-умовою
  ((хибне?
     (правильна-таблиця-асоціацій?
       (список (сполучити (як-є а) ні) ні))) так)
  (так (перше (як-є ()))))

; Повна перевірка не змінює правило першого збігу при оновленні.
(за-умовою
  ((однакові?
     (оновити-перший-запис
       тотожне? (як-є а) так
       (список
         (сполучити (як-є а) ні)
         (сполучити (як-є а) ні)))
     (список
       (сполучити (як-є а) так)
       (сполучити (як-є а) ні))) так)
  (так (перше (як-є ()))))

; Зібрані значення не втрачають ні D1 ні, ні структурне ().
(за-умовою
  ((однакові?
     (зібрати-значення-ключа
       тотожне? (як-є а)
       (список
         (сполучити (як-є а) ні)
         (сполучити (як-є б) так)
         (сполучити (як-є а) (як-є ()))))
     (список ні (як-є ()))) так)
  (так (перше (як-є ()))))
