; Принцип 5: символьний граф знань перевіряє той самий закон досяжності,
; що потрібен GC. Це нативні Lisp-закони, НЕ виклик фізичного collector.
; Комірки: (ідентичність ліве праве). Корінь атом?; цикл і спільна гілка.
; Живі: атом?, решта, сполучити, за-умовою. Вільні: хибне?, список.

(визначити корені-памяті (як-є (атом?)))
(визначити комірки-памяті
  (як-є ((атом? решта сполучити)
         (решта за-умовою ())
         (сполучити решта ())
         (за-умовою атом? ())
         (хибне? список ())
         (список () ()))))

(визначити звільнені-комірки
  (ядро1-повернути-память корені-памяті комірки-памяті))
(визначити досяжні-посилання
  (ядро1-позначити-все корені-памяті комірки-памяті))

(визначити довести-досяжність
  (функція (умова)
    (за-умовою
      ((хибне? умова) (перше (як-є ())))
      (так так))))

; Обидва сміттєві вузли визначаються точно та зберігають порядок.
(довести-досяжність
  (тотожне? (перше (перше звільнені-комірки)) (як-є хибне?)))
(довести-досяжність
  (тотожне? (перше (друге звільнені-комірки)) (як-є список)))
(довести-досяжність
  (порожній? (решта (решта звільнені-комірки))))

; Цикл за-умовою -> атом? завершується; загальний нащадок не дублюється.
(довести-досяжність
  (ядро1-позначена-комірка? (як-є атом?) досяжні-посилання))
(довести-досяжність
  (ядро1-позначена-комірка? (як-є за-умовою) досяжні-посилання))
(довести-досяжність
  (ядро1-позначена-комірка? (як-є решта) досяжні-посилання))
(довести-досяжність
  (хибне? (ядро1-позначена-комірка? (як-є хибне?) досяжні-посилання)))

; Без коренів усі комірки доступні до повернення, живі не зникають.
(довести-досяжність
  (тотожне?
    (перше (перше (ядро1-вільні-комірки комірки-памяті)))
    (як-є атом?)))
(довести-досяжність
  (тотожне?
    (перше (перше (ядро1-повернути-память (як-є ()) комірки-памяті)))
    (як-є атом?)))

; Повертається точна істина D1.
(атом? (як-є ()))
