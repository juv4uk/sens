; Принцип 5: символьний граф знань перевіряє той самий закон досяжності,
; що потрібен GC. Це нативні Lisp-закони, НЕ виклик фізичного collector.
; Комірки: (ідентичність ліве праве). Корінь атом?; цикл і спільна гілка.
; Живі: атом?, решта, сполучити, за-умовою. Вільні: хибне?, список.

(визначити корені-памяті (як-є (атом?)))
(визначити комірки-памяті
  (як-є ((атом? решта сполучити)
         (решта за-умовою ())
         (сполучити решта ())
         (за-умовою атом? ())
         (хибне? список ())
         (список хибне? ()))))

(визначити звільнені-комірки
  (ядро1-повернути-память корені-памяті комірки-памяті))
(визначити досяжні-посилання
  (ядро1-позначити-все корені-памяті комірки-памяті))

(визначити довести-досяжність
  (функція (умова)
    (за-умовою
      ((хибне? умова) (перше (як-є ())))
      (так так))))

; Недосяжна пара хибне?/список теж утворює цикл — обидва вузли можна повернути.
(довести-досяжність
  (тотожне? (перше (перше звільнені-комірки)) (як-є хибне?)))
(довести-досяжність
  (тотожне? (перше (друге звільнені-комірки)) (як-є список)))
(довести-досяжність
  (порожній? (решта (решта звільнені-комірки))))

; Цикл за-умовою -> атом? завершується; загальний нащадок не дублюється.
(довести-досяжність
  (ядро1-позначена-комірка? (як-є атом?) досяжні-посилання))
(довести-досяжність
  (ядро1-позначена-комірка? (як-є за-умовою) досяжні-посилання))
(довести-досяжність
  (ядро1-позначена-комірка? (як-є решта) досяжні-посилання))
(довести-досяжність
  (хибне? (ядро1-позначена-комірка? (як-є хибне?) досяжні-посилання)))

; Всі комірки стають досяжними з двох явних коренів.
(довести-досяжність
  (порожній?
    (ядро1-повернути-память (як-є (атом? хибне?)) комірки-памяті)))

; Неіснуючий корінь не створює уявної комірки.
(довести-досяжність
  (порожній?
    (ядро1-позначити-все (як-є (неіснуючий)) комірки-памяті)))

; Частковість D3 EQ: жоден складений root не прирівнюється
; до атомного імені, граф не виконує EQ(pair, atom) і не вигадує вузол.
(довести-досяжність
  (хибне?
    (ядро1-однакові-атоми? (як-є (атом?)) (як-є атом?))))
(довести-досяжність
  (порожній?
    (ядро1-позначити-все
      (як-є ((атом?))) комірки-памяті)))

; Єдине маркування породжує дві неперетинні частини.
; Механізм пам'яті може використати їх, але сам SENS не звільняє heap.
(визначити розділена-память
  (ядро1-розділити-память корені-памяті комірки-памяті))
(довести-досяжність
  (тотожне? (перше (перше (перше розділена-память))) (як-є атом?)))
(довести-досяжність
  (тотожне? (перше (перше (друге розділена-память))) (як-є хибне?)))
(довести-досяжність
  (порожній?
    (друге
      (ядро1-розділити-память
        (як-є (атом? хибне?)) комірки-памяті))))

; Ущільнення зберігає саме живий підграф (чотири записи), без
; перепризначення ідентичностей. Друге збирання нічого не вилучає.
(визначити ущільнені-комірки
  (ядро1-ущільнити-досяжне корені-памяті комірки-памяті))
(довести-досяжність
  (тотожне? (перше (перше ущільнені-комірки)) (як-є атом?)))
(довести-досяжність
  (тотожне? (перше (друге ущільнені-комірки)) (як-є решта)))
(довести-досяжність
  (тотожне? (перше (третє ущільнені-комірки)) (як-є сполучити)))
(довести-досяжність
  (порожній? (решта (решта (решта (решта ущільнені-комірки))))))
(довести-досяжність
  (порожній?
    (ядро1-повернути-память корені-памяті ущільнені-комірки)))
(довести-досяжність
  (порожній?
    (ядро1-ущільнити-досяжне (як-є ()) комірки-памяті)))

; Без коренів усі комірки доступні до повернення, живі не зникають.
(довести-досяжність
  (тотожне?
    (перше (перше (ядро1-вільні-комірки комірки-памяті)))
    (як-є атом?)))
(довести-досяжність
  (тотожне?
    (перше (перше (ядро1-повернути-память (як-є ()) комірки-памяті)))
    (як-є атом?)))

; Зміна оголошеного кореня змінює ТІЛЬКИ досяжність графа,
; а не закон чи фізичний тип адреси. Ізольована гілка стає живою.
(довести-досяжність
  (ядро1-позначена-комірка?
    (як-є список)
    (ядро1-позначити-все (як-є (хибне?)) комірки-памяті)))
(довести-досяжність
  (хибне?
    (ядро1-позначена-комірка?
      (як-є атом?)
      (ядро1-позначити-все (як-є (хибне?)) комірки-памяті))))
(довести-досяжність
  (тотожне?
    (перше (перше
      (ядро1-повернути-память (як-є (хибне?)) комірки-памяті)))
    (як-є атом?)))

; Порожнє оточення: перевіряємо власний D1-предикат стану
; «не знайдено», а не порівнюємо з текстовою міткою через D3 EQ.
; D3 EQ частковий і приймає тільки два допущені атоми.
; Словник двоелементних записів: (ключ значення).
; Значення повертається як одноелементний хвіст, тому беремо
; перший атом перед порівнянням знайденого значення.
(довести-досяжність
  (хибне?
    (ядро1-знайдено?
      (ядро1-знайти-в-оточенні (як-є атом?) (як-є ())))))
; Відсутність ключа не тотожна присутньому ключу з () payload.
; Обидва результати задаються структурою списку, а не Text7.
(довести-досяжність
  (ядро1-знайдено?
    (ядро1-знайти-в-оточенні
      (як-є атом?)
      (як-є ((атом?))))))
(довести-досяжність
  (порожній?
    (ядро1-значення-знайденого
      (ядро1-знайти-в-оточенні
        (як-є атом?)
        (як-є ((атом?)))))))

(довести-досяжність
  (тотожне?
    (перше
      (ядро1-значення-знайденого
        (ядро1-знайти-в-оточенні
          (як-є атом?)
          (як-є ((атом? перше) (решта сполучити))))))
    (як-є перше)))
(довести-досяжність
  (тотожне?
    (перше
      (ядро1-значення-знайденого
        (ядро1-знайти-в-оточенні
          (як-є атом?)
          (як-є ((решта сполучити) (атом? за-умовою))))))
    (як-є за-умовою)))

; Вкладений ключ не є атомом. Пошук пропускає його без помилки
; атомного порівняння і не приписує йому тотожності атома.
(довести-досяжність
  (хибне?
    (ядро1-знайдено?
      (ядро1-знайти-в-оточенні
        (як-є атом?)
        (як-є (((атом?) перше)))))))
; Вкладена назва пошуку також відхиляється до порівняння,
; навіть коли в оточенні є справжній атомний ключ.
(довести-досяжність
  (хибне?
    (ядро1-знайдено?
      (ядро1-знайти-в-оточенні
        (як-є (атом?))
        (як-є ((атом? перше)))))))

; Складений ключ сьомого домену порівнюється рекурсивно
; власними функціями СЕНС. Рівний список знаків має бути знайдений.
(довести-досяжність
  (ядро1-знайдено?
    (ядро1-знайти-в-оточенні
      (як-є (атом?))
      (як-є (((атом?) перше))))))
; Складені назви різної форми не стають тотожними.
(довести-досяжність
  (хибне?
    (ядро1-знайдено?
      (ядро1-знайти-в-оточенні
        (як-є (решта))
        (як-є (((атом?) перше)))))))
; Той самий структурний закон працює на однакових атомах.
(довести-досяжність
  (ядро1-назви-рівні? (як-є атом?) (як-є атом?)))
(довести-досяжність
  (хибне?
    (ядро1-назви-рівні? (як-є атом?) (як-є решта))))

; Повертається точна істина першого домену.
(атом? (як-є ()))
