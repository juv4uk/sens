; Семантика епістемічних посилань і логічних вимог — власність SENS.
; lib/epistemic.lisp та перевіряльник із fixtures завантажує фізичний прогін.
; Успішний іменований запис перевіряється самим Lisp і зводиться до точного D1.
; Якщо будь-яка внутрішня вимога не виконується, названий запис помилки
; лишається результатом, тому мовний закон не зможе пройти хибно.
(визначити епістемічний-вердикт
  (функція (висновок)
    (за-умовою
      ((однакові?
         висновок
         (список
           (як-є epistemic-authority-witness)
           (список (як-є status) (як-є pass))))
        (порожній? (як-є ())))
      ((атом? (як-є ())) висновок))))

(епістемічний-вердикт (свідок-епістеміки))
