; Семантика епістемічних посилань і логічних вимог — власність SENS.
; lib/epistemic.lisp та перевіряльник із fixtures завантажує фізичний прогін.
; Успіх має точну D1-відповідь на обох маршрутах. Текстові назви полів
; у прямому Lisp є поверхнями, а у фізичному SENS — канонічними D7-комірками.
; У разі невдачі повертаємо повний Lisp-запис із першою названою причиною.
(визначити епістемічний-вердикт
  (функція (висновок)
    (за-умовою
      ((однакові?
         висновок
         (список
           (як-є epistemic-authority-witness)
           (список (як-є status) (як-є pass))))
        (порожній? (як-є ())))
      ((атом? (як-є ())) висновок))))

(епістемічний-вердикт (свідок-епістеміки))
