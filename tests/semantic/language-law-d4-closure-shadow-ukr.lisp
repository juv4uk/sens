; Семантика D4: лексичне зв'язування, замикання та затінення параметра.
; Джерело істини — виконуваний український Lisp. Zig пакує в T5M,
; а фізичний SENS сам оцінює закон. Rust не містить таблиці істинності.
; Порушення будь-якого закону викликає недопустиме CAR порожнього списку.
; Лише фінальний D1:так є позитивним самовердиктом.

(визначити засвідчити-закон-замикання
  (функція (умова)
    (за-умовою
      ((хибне? умова) (перше (як-є ())))
      (так так))))

; Значення зовнішнього параметра не підміняється внутрішнім.
(засвідчити-закон-замикання
  (тотожне?
    ((функція (зовнішній)
       ((функція (внутрішній) зовнішній) (як-є антена)))
     (як-є радіо))
    (як-є радіо)))

; Функція, повернута з іншої функції, зберігає лексичний контекст.
(засвідчити-закон-замикання
  (тотожне?
    (((функція (захоплене)
        (функція (пізніше) захоплене))
      (як-є радіо))
     (як-є антена))
    (як-є радіо)))

; Контрприклад: результат замикання не стає пізнішим аргументом.
(засвідчити-закон-замикання
  (хибне?
    (тотожне?
      (((функція (захоплене)
          (функція (пізніше) захоплене))
        (як-є радіо))
       (як-є антена))
      (як-є антена))))

; Однакове ім'я внутрішнього параметра затінює зовнішній параметр.
(засвідчити-закон-замикання
  (тотожне?
    (((функція (значення)
        (функція (значення) значення))
      (як-є радіо))
     (як-є антена))
    (як-є антена)))

; Контрприклад до динамічного підхоплення зовнішньої змінної.
(засвідчити-закон-замикання
  (хибне?
    (тотожне?
      (((функція (значення)
          (функція (значення) значення))
        (як-є радіо))
       (як-є антена))
      (як-є радіо))))

; Цитована форма залишається даними навіть за невідомої голови.
(засвідчити-закон-замикання
  (тотожне?
    (перше (як-є (неіснуюча-операція аргумент)))
    (як-є неіснуюча-операція)))

; Умовна форма не виконує хибну гілку з недопустимим CAR.
(засвідчити-закон-замикання
  (за-умовою
    ((хибне? (атом? (як-є ()))) (перше (як-є ())))
    ((атом? (як-є ())) (атом? (як-є ())))))

; Фінальний однобітний вердикт для фізичного коридору.
(атом? (як-є ()))
