; Семантика D4: лексичне зв'язування, замикання та затінення параметрів.
; Український Lisp формулює всі закони, Zig переносить їх у T5M.
; SENS перевіряє їх без Rust/Python-оракула, без числових голів і літералів.
; Не порівнюємо складені дані через D3 тотожне?: EQ допускає лише атоми.
; Хибний D1-результат веде до забороненого CAR порожнього списку.

(визначити засвідчити-закон-замикання
  (функція (умова)
    (за-умовою
      ((хибне? умова) (перше (як-є ())))
      (так так))))

; Внутрішній виклик не підміняє захоплений зовнішній порожній атом.
(засвідчити-закон-замикання
  ((функція (зовнішній)
     ((функція (внутрішній) (атом? зовнішній))
      (сполучити (як-є ()) (як-є ()))))
   (як-є ())))

; Контрприклад: зовнішня пара не перетворюється на атом внутрішнім викликом.
(засвідчити-закон-замикання
  (хибне?
    ((функція (зовнішній)
       ((функція (внутрішній) (атом? зовнішній)) (як-є ())))
     (сполучити (як-є ()) (як-є ())))))

; Повернуте замикання зберігає тип захопленого зовнішнього значення.
(засвідчити-закон-замикання
  (((функція (захоплене)
      (функція (пізніше) (атом? захоплене)))
    (як-є ()))
   (сполучити (як-є ()) (як-є ()))))

; Негативний закон: захоплена пара залишається парою після повернення функції.
(засвідчити-закон-замикання
  (хибне?
    (((функція (захоплене)
        (функція (пізніше) (атом? захоплене)))
      (сполучити (як-є ()) (як-є ())))
     (як-є ()))))

; Однакове ім'я внутрішнього параметра затінює зовнішню пару.
(засвідчити-закон-замикання
  (((функція (значення)
      (функція (значення) (атом? значення)))
    (сполучити (як-є ()) (як-є ())))
   (як-є ())))

; Контрприклад: новий внутрішній параметр-пара не успадковує атом зовнішнього.
(засвідчити-закон-замикання
  (хибне?
    (((функція (значення)
        (функція (значення) (атом? значення)))
      (як-є ()))
     (сполучити (як-є ()) (як-є ())))))

; Хибна гілка COND не обчислює невизначене CAR.
(засвідчити-закон-замикання
  (за-умовою
    ((хибне? (атом? (як-є ()))) (перше (як-є ())))
    ((атом? (як-є ())) (атом? (як-є ())))))

; Кінцевий точний вердикт D1 для фізичного SENS.
(атом? (як-є ()))
