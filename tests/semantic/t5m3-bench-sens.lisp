; Вимірювання розміру кодування Т5М3 засобами СЕНС.
; Кількість трітів і байтів визначається мовними функціями,
; без зовнішньої моделі Python та без удаваного годинника.
; Числові очікування записані десятково й належать D24+.
; Структурні порівняння викликають ратифіковане D8 «однакові?».

(список
  ; довжина списку трітів одного слова "101" = 3
  (однакові? (довжина (т5-тріти-слова (список так ні так)))
          3)
  ; т5м3-у-байти(["1"]) → 3 байти (одна 15-трітова група)
  (однакові? (довжина (т5м3-у-байти (список (список так))))
          3)
  ; т5м3-у-байти(["101","11"]) → 3 байти (7 трітів + 8 пад = 15)
  (однакові? (довжина (т5м3-у-байти (список (список так ні так)
                                      (список так так))))
          3)
  ; т5м3-у-байти 6 слів по 5 біт → трітів 6*5+5=35 → 45 (кратне 15) → 9 байт
  (однакові? (довжина (т5м3-у-байти (список (список так так так так так)
                                      (список так так так так так)
                                      (список так так так так так)
                                      (список так так так так так)
                                      (список так так так так так)
                                      (список так так так так так))))
          9)
  ; round-trip: декод(код(слова)) дає той самий список слів
  (однакові? (т5м3-з-байтів (т5м3-у-байти (список (список так ні так)
                                           (список так так))))
          (список (список так ні так) (список так так)))
  ; негативний: 6×5біт НЕ дають 3 байти (це 9)
  (хибне? (однакові? (довжина (т5м3-у-байти (список (список так так так так так)
                                            (список так так так так так)
                                            (список так так так так так)
                                            (список так так так так так)
                                            (список так так так так так)
                                            (список так так так так так))))
                15)))
