; SENS: енергетичний бенчмарк виконується самою мовою.
; Rust дає тільки RAPL мікроджоулі; Zig переносить фізичні байти.
; Бібліотеки перед програмою: lib/бенчмарк.lisp.
; Нормування: 3000000 мкДж на 3000 форм => 1 Дж на 1000 форм.
; 128 незалежних викликів нормування: гаряче навантаження SENS.
; Позитивний вердикт — D1:так, обчислений SENS, не Rust/Python.

(визначити енергія-пакет
  (функція (залишилось сума)
    (за-умовою
      ((нуль? залишилось) сума)
      (так
        (енергія-пакет
          (відняти-1 залишилось)
          (додати сума (джоулів-на-тисячу-форм 3000000 3000)))))))

(за-умовою
  ((енергія-не-спадає? 1000 2000)
    (за-умовою
      ((хибне? (енергія-не-спадає? 2000 1000))
        (нуль? (відняти (енергія-пакет 128 0) 128)))
      (так ні)))
  (так ні))
