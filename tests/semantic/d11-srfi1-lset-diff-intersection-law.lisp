; Д11: перенесені перевірки DIFF та XOR виконуються як SENS-закон,
; не як побічні ефекти імпорту бібліотеки.
; Вхідні значення для законів створюються D4 СПИСОК або D3 СПОЛУЧИТИ.
; QUOTE над текстом (а б) може бути D7 Text7, а не D3-парним списком.
; Позитив: порядок та дублікати лівого списку збережено.
(за-умовою
  ((однакові?
     (різниця-та-перетин-за-порівнянням
       тотожне?
       (список так ні так (як-є ()))
       (список ні))
     (список (список так так (як-є ())) (список ні)))
   так)
  (так (перше (як-є ()))))

; Порожній правий список — уся ліва частина є різницею.
(за-умовою
  ((однакові?
     (різниця-та-перетин-за-порівнянням
       тотожне? (список так ні) (як-є ()))
     (список (список так ні) (як-є ())))
   так)
  (так (перше (як-є ()))))

; Порожній лівий список — обидві частини порожні.
(за-умовою
  ((однакові?
     (різниця-та-перетин-за-порівнянням
       тотожне? (як-є ()) (список так))
     (список (як-є ()) (як-є ())))
   так)
  (так (перше (як-є ()))))

; Д1 ні і структурне () — різні члени лівого списку.
(за-умовою
  ((однакові?
     (різниця-та-перетин-за-порівнянням
       тотожне?
       (список ні (як-є ()))
       (список ні))
     (список (список (як-є ())) (список ні)))
   так)
  (так (перше (як-є ()))))

; Негативний мутант: переставлені частини НЕ є рівним результатом.
(за-умовою
  ((хибне?
     (однакові?
       (різниця-та-перетин-за-порівнянням
         тотожне?
         (список так ні так (як-є ()))
         (список ні))
       (список (список ні) (список так так (як-є ())))))
   так)
  (так (перше (як-є ()))))



; Порівняння базових атомів D1 та структурного D3:000.
; Тут у різниці залишається саме (), а не D1:ні.
(за-умовою
  ((однакові?
     (різниця-та-перетин-за-порівнянням
       тотожне? (список (як-є ()) ні) (список ні))
     (список (список (як-є ())) (список ні)))
   так)
  (так (перше (як-є ()))))

; Обидва списки треба перевірити повністю, не дивлячись на ранній збіг.
(за-умовою
  ((хибне? (правильний-список-для-різниці?
             (сполучити ні так)))
   так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне? (правильний-список-для-різниці?
             (сполучити так (сполучити ні ні))))
   так)
  (так (перше (як-є ()))))

; Остаточний вердикт виконуваного SENS-файла: точний Д1 так.
(атом? (як-є ()))

; Д1:ні та структурне Д3:() — різні елементи множини.
; Спільне () відкидається; дублікати у лівій різниці зберігаються.
(за-умовою
  ((однакові?
     (симетрична-різниця-множин-за-порівнянням
       тотожне?
       (список так так (як-є ()))
       (список ні (як-є ())))
     (список так так ні))
   так)
  (так (перше (як-є ()))))

; Порожня ліва множина: результат точно дорівнює правій.
(за-умовою
  ((однакові?
     (симетрична-різниця-множин-за-порівнянням
       тотожне? (як-є ()) (список ні так))
     (список ні так))
   так)
  (так (перше (як-є ()))))

; Повністю еквівалентні списки, навіть із повторами, дають ().
(за-умовою
  ((порожній?
     (симетрична-різниця-множин-за-порівнянням
       тотожне? (список так так ні) (список ні так))
   ) так)
  (так (перше (як-є ()))))

; Живий контрприклад: зміна порядку частин не є нашим законом.
(за-умовою
  ((хибне?
     (однакові?
       (симетрична-різниця-множин-за-порівнянням
         тотожне? (список так так) (список ні))
       (список ні так так)))
   так)
  (так (перше (як-є ()))))

; Вихідний точний D1:так у фізичному SENS-виконанні.
(атом? (як-є ()))

; Незалежний фізичний закон з останнім точним D1-вердиктом.
; Д11 SRFI-1 LSET-DIFF+INTERSECTION: кожен лівий атом входить рівно в одну частину.
; Незалежний закон D1, не фальшиве підтвердження останнім (атом? ()).
; Входи — канонічні D1 та D3/D4-пари.
(однакові?
  (різниця-та-перетин-за-порівнянням
    тотожне?
    (список так ні так)
    (список ні))
  (список
    (список так так)
    (список ні)))
