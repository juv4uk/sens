; Власний мовний закон D4: рекурсивний розбір коректного списку.
; Логічний результат належить Lisp/SENS. Rust/Zig лише механізм і носій.
; Операнди — ратифіковані D1 і D3, без цифрових літералів чи старого SID8.

(визначити правильний-список
  (функція (послідовність)
    (за-умовою
      ((порожній? послідовність) так)
      ((атом? послідовність) ні)
      (так (правильний-список (решта послідовність))))))

(визначити цілком-коректний
  (сполучити (атом? (як-є ()))
    (сполучити (хибне? (атом? (як-є ())))
      (як-є ()))))

(визначити зіпсований-хвіст
  (сполучити (атом? (як-є ()))
    (сполучити (хибне? (атом? (як-є ())))
      (атом? (як-є ())))))

(за-умовою
  ((правильний-список (як-є ()))
   (за-умовою
     ((правильний-список цілком-коректний)
      (за-умовою
        ((хибне? (правильний-список зіпсований-хвіст))
         так)
        (так ні)))
     (так ні)))
  (так ні))
