; SENS_SOURCE=tests/semantic/d4-selector-width-law.lisp
; NATIVE_SENS_POSITIVE=NOT_VERIFIED
; NATIVE_SENS_NEGATIVE=NOT_VERIFIED
;
; Ширина селекторів D4: перше/решта розрізняють вкладені атоми.
; Ідентичність — форма SENS, квитанцій немає.

(за-умовою
  ((тотожне?
     (перше (сполучити так (сполучити ні (як-є ()))))
     так)
   (за-умовою
     ((тотожне?
        (перше (решта (сполучити так (сполучити ні (як-є ())))))
        ні)
      (за-умовою
        ((хибне?
           (тотожне?
             (перше (сполучити так (сполучити ні (як-є ()))))
             (перше (решта (сполучити так (сполучити ні (як-є ())))))))
         так)
        (так ні)))
     (так ні)))
  (так ні))
