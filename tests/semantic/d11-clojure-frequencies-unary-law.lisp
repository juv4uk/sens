; Д11: унарні частоти є чистим SENS-списком, не числами D24 чи Clojure map.
; Д3/Д4 обчислюють кожну форму; неправильний результат не може видати D1:так.

; Порожнє джерело має порожню кратність.
(за-умовою
  ((порожній? (побудувати-унарну-кратність (як-є ()))) так)
  (так (перше (як-є ()))))

; Три елементи породжують рівно три комірки "о" в початковому порядку.
(за-умовою
  ((однакові?
     (побудувати-унарну-кратність
       (список (як-є а) (як-є б) (як-є в)))
     (список (як-є о) (як-є о) (як-є о)))
   так)
  (так (перше (як-є ()))))

; Дві групи перетворюються на окремі унарні кратності без втрати ключа.
(за-умовою
  ((однакові?
     (перетворити-групи-на-частоти
       (список
         (список (як-є а) (список (як-є а) (як-є а)))
         (список (як-є б) (список (як-є б)))))
     (список
       (список (як-є а) (список (як-є о) (як-є о)))
       (список (як-є б) (список (як-є о)))))
   так)
  (так (перше (як-є ()))))

; Завершальний вердикт — точна істина D1.
так
