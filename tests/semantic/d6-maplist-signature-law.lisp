; D6:000101 MAPLIST: documented list/function order, exact D1 law.
(список
  (equal?
    (відобразити-залишки (список (як-є а) (як-є б))
      (функція (хвіст) хвіст))
    (список (список (як-є а) (як-є б)) (список (як-є б))))
  (equal?
    (maplist (список (як-є а) (як-є б))
      (функція (хвіст) (перше хвіст)))
    (список (як-є а) (як-є б)))
  (equal?
    (відобразити-залишки (як-є ())
      (функція (хвіст) хвіст))
    (як-є ())))
