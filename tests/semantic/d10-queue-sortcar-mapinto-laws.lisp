; Закони порожньої черги, упорядкування та відображення елементів.
; Вісім випадків перевіряють чинні українські викличні назви.
; Перевірка порожньої черги: повна проєкція «укр» Д10:0011000010.
; Перетворення списку та вектора тут лише локальні тотожні функції:
; їх не можна підміняти однойменними компактними поверхнями Д10.
; Математичні значення записуються десятково.
(визначити вектор-у-список
  (функція (значення) значення))
(визначити список-у-вектор
  (функція (значення) значення))
(список
  (перевірити-чи-черга-порожня? (як-є ()))
  (хибне? (перевірити-чи-черга-порожня? (список (як-є а))))
  (однакові? (сортувати-за-першим
            (список (список 2 (як-є б))
                  (список 1 (як-є а))))
          (список (список 1 (як-є а))
                (список 2 (як-є б))))
  (однакові? (відобразити-у
            (функція (значення) значення)
            (як-є ())
            (список (як-є а) (як-є б)))
          (список (як-є а) (як-є б)))
  (однакові? (вектор-у-список (список (як-є х)))
          (список (як-є х)))
  (однакові? (список-у-вектор (список (як-є у)))
          (список (як-є у)))
  (однакові? (вектор-у-список (як-є ()))
          (як-є ()))
  (перевірити-чи-черга-порожня? (список-у-вектор (як-є ()))))
