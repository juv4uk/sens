; SENS_SOURCE=tests/semantic/lisp-language-laws.lisp
;
; Закони мови SENS. Виконується інтерактивним REPL через Zig/T5M.
; Очікувана відповідь — ТАК. Будь-яке інше — регресія семантики.
;
; Імена взято з ратифікованого реєстру: D1 (так/ні), D3 (як-є, атом?,
; перше, решта, тотожне?), D4 (хибне?, порожній?, функція, визначити),
; D6 (довжина), D9 (результат-позначений?), D10 (числа-нерівні?).

(визначити двійка (як-є (а б)))
(визначити трійка (як-є (а б в)))
(визначити порожній (як-є ()))

(за-умовою
  ; D1+D4: порожність перевіряє D4-предикат, не D3 EQ на NIL
  ((порожній? порожній)
   (за-умовою
     ; D4: порожній? на порожньому
     ((порожній? порожній)
      (за-умовою
        ; D4: хибне? на непорожньому
        ((хибне? (порожній? двійка))
         (за-умовою
           ; D3: атом? на першому елементі
           ((атом? (перше двійка))
            (за-умовою
              ; D3: перше двійки — це а
              ((тотожне? (перше двійка) (як-є а))
               (за-умовою
                 ; Структуру пари перевіряємо розбором, не D3 EQ.
                 ((тотожне? (перше (решта двійка)) (як-є б))
                  (за-умовою
                    ((порожній? (решта (решта двійка)))
                     (за-умовою
                       ; D6: довжина трійки — три
                       ((тотожне? (довжина трійка) 3)
                        (за-умовою
                          ; D4: власна функція тотожності застосовується
                          ((тотожне?
                             (застосувати (функція (х) х) (як-є (б)))
                             (як-є б))
                           (за-умовою
                             ; D4 APPLY викликає також точну D3 identity як значення.
                             ((тотожне? (застосувати атом? (як-є (а))) так)
                              (за-умовою
                                ; D10: числа 1 і 2 нерівні
                                ((числа-нерівні? (як-є 1) (як-є 2))
                                 (за-умовою
                                   ; D9: порожній результат не позначений
                                   ((хибне? (результат-позначений? (як-є ())))
                                    так)
                                   (так ні)))
                                (так ні)))
                             (так ні)))
                          (так ні)))
                       (так ні)))
                    (так ні)))
                 (так ні)))
              (так ні)))
           (так ні)))
        (так ні)))
     (так ні)))
  (так ні))
