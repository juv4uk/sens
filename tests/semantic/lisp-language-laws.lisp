; SENS_SOURCE=tests/semantic/lisp-language-laws.lisp
;
; Закони мови SENS. Виконується інтерактивним REPL через Zig/T5M.
; Очікувана відповідь — ТАК. Будь-яке інше — регресія семантики.
;
; Імена взято з ратифікованого реєстру: D1 (так/ні), D3 (як-є, атом?,
; перше, решта, тотожне?), D4 (хибне?, порожній?, функція, визначити),
; D6 (довжина).

(визначити двійка (як-є (а б)))
(визначити трійка (як-є (а б в)))
(визначити порожній (як-є ()))

(за-умовою
  ; D1+D3: точна атомна тотожність; NIL окремо через предикат порожності
  ((тотожне? так так)
   (за-умовою
     ; D4: порожній? на порожньому
     ((порожній? порожній)
      (за-умовою
        ; D4: хибне? на непорожньому
        ((хибне? (порожній? двійка))
         (за-умовою
           ; D3: атом? на першому елементі
           ((атом? (перше двійка))
            (за-умовою
              ; D7 символ може бути структурою: D8 структурне порівняння
              ((однакові? (перше двійка) (як-є а))
               (за-умовою
                 ; D3: решта двійки — список з одного б (D8 структурне порівняння)
                 ((однакові? (решта двійка) (як-є (б)))
                  (за-умовою
                    ; D3: решта не атом
                    ((хибне? (атом? (решта двійка)))
                     (за-умовою
                       ; D6: довжина трійки — числове 3 (не D3 атомна EQ і не список)
                       ((рівне? (довжина трійка) 3)
                        (за-умовою
                          ; D4: застосування функції повертає символ б, а не список (б)
                          ((однакові?
                             (застосувати (функція (х) х) (як-є (б)))
                             (як-є б))
                           так)
                          (так ні)))
                       (так ні)))
                    (так ні)))
                 (так ні)))
              (так ні)))
           (так ні)))
        (так ні)))
     (так ні)))
  (так ні))
