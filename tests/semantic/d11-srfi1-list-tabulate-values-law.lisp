; Д11 LIST-TABULATE: значення D1:ні не є кінцем D3.
; Порожній список () як ЕЛЕМЕНТ теж не завершує зовнішній список.
(визначити табульовані-д1
  (табулювати-список число-два (функція (і) (нуль? і))))
(визначити табульовані-порожні
  (табулювати-список число-один (функція (і) (як-є ()))))
(за-умовою
  ((перше табульовані-д1)
   (за-умовою
     ((хибне? (друге табульовані-д1))
      (за-умовою
        ((порожній? (перше табульовані-порожні))
         (порожній? (решта табульовані-порожні)))
        (так ні)))
     (так ні)))
  (так ні))
