; Десять законів пошуку атома й перетворення наносекунд.
; Наносекунди та мілісекунди записані десятково.
(список
  (містить-атом? (як-є шукане) (як-є шукане))
  (містить-атом? (як-є шукане) (як-є (стороннє (шукане друге))))
  (хибне? (містить-атом? (як-є відсутнє) (як-є (стороннє (шукане друге)))))
  (містить-атом? (як-є шукане) (сполучити (як-є стороннє) (як-є шукане)))
  (хибне? (містить-атом? (як-є (шукане)) (як-є (шукане))))
  (хибне? (містить-атом? (як-є шукане) (як-є ())))
  (однакові? (мілісекунди-з-наносекунди 0) 0)
  (однакові? (мілісекунди-з-наносекунди 999999) 0)
  (однакові? (мілісекунди-з-наносекунди 1000000) 1)
  (однакові? (мілісекунди-з-наносекунди 2000000) 2))
