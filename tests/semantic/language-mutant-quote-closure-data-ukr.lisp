; Негативний мутант: замість захопленого атома читаємо пізніше передану пару.
; Сама SENS повинна повернути Д1:ні; QUOTE у двох файлах однаковий.
; Вкладена функція зберігає зовнішній порожній атом після передачі пари.
; Логічний результат визначає Lisp, а Zig/T5M переносить точні слова.
(визначити дані-цитати-замикання
  (як-є ((перше (як-є ())))))
(визначити цитата-не-виконана?
  (за-умовою
    ((порожній? (решта дані-цитати-замикання))
     (хибне? (атом? (перше дані-цитати-замикання))))
    (так ні)))
(визначити замикання-зберегло-зовнішнє?
  (((функція (захоплене)
      (функція (передане) (атом? передане)))
    (як-є ()))
   (сполучити (як-є ()) (як-є ()))))
(за-умовою
  (цитата-не-виконана? замикання-зберегло-зовнішнє?)
  (так ні))
