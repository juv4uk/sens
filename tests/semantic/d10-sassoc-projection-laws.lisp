; П'ятнадцять законів пошуку асоціацій та допоміжних операцій.
; Пошук порівнює значення структурно й викликає резервну дію без аргументів.
; Семантику перевіряє сам СЕНС, а не зовнішній скрипт.
(список
  (однакові? (пошук-асоціації
            (як-є а)
            (список (сполучити (як-є а) (як-є перше))
                  (сполучити (як-є б) (як-є друге)))
            (функція () (як-є немає)))
          (сполучити (як-є а) (як-є перше)))
  (однакові? (пошук-асоціації
            (як-є б)
            (список (сполучити (як-є а) (як-є перше))
                  (сполучити (як-є б) (як-є друге)))
            (як-є не-викликати))
          (сполучити (як-є б) (як-є друге)))
  (однакові? (пошук-асоціації
            (як-є відсутній)
            (список (сполучити (як-є а) (як-є перше)))
            (функція () (як-є резерв)))
          (як-є резерв))
  (однакові? (пошук-асоціації
            (як-є порожньо) (як-є ())
            (функція () (як-є порожній-резерв)))
          (як-є порожній-резерв))
  (однакові? (пошук-асоціації
            (список (як-є складений))
            (список (сполучити (список (як-є складений)) (як-є структурний-збіг)))
            (функція () (як-є немає)))
          (сполучити (список (як-є складений)) (як-є структурний-збіг)))
  (перевірити-чи-черга-порожня? (як-є ()))
  (хибне? (перевірити-чи-черга-порожня? (як-є (а))))
  (однакові? (сортувати-за-першим
            (список (список (довжина (як-є (а б))) (як-є друге))
                  (список (довжина (як-є (а))) (як-є перше))))
          (список (список (довжина (як-є (а))) (як-є перше))
                (список (довжина (як-є (а б))) (як-є друге))))
  (однакові? (кількість-результатів-спостереження (як-є (а б)))
          (довжина (як-є (а б))))
  (правильно-структурований-список-знань? (як-є (а б)))
  (хибне? (правильно-структурований-список-знань? (сполучити (як-є а) (як-є б))))
  (результат-є-правильним-списком? (як-є (а б)))
  (хибне? (результат-є-правильним-списком? (сполучити (як-є а) (як-є б))))
  (кожен-кандидат-задовольняє-умову?
    (функція (елемент) (хибне? (порожній? елемент)))
    (як-є (а б)))
  (хибне? (кожен-кандидат-задовольняє-умову?
          (функція (елемент) (порожній? елемент))
          (як-є (а б)))))

