; 15 фізичних D1-законів D10:0001100101 SASSOC та сімох en-проєкцій.
; SASSOC = MacLisp EQUAL + нульаргументна запасна дія (не ASSOC/2).
; Тільки процес SENS оцінює ці закони; зовнішні скрипти не визначають семантики.
(список
  (equal? (пошук-асоціації
            (як-є а)
            (список (сполучити (як-є а) (як-є перше))
                  (сполучити (як-є б) (як-є друге)))
            (функція () (як-є немає)))
          (сполучити (як-є а) (як-є перше)))
  (equal? (пошук-асоціації
            (як-є б)
            (список (сполучити (як-є а) (як-є перше))
                  (сполучити (як-є б) (як-є друге)))
            (як-є не-викликати))
          (сполучити (як-є б) (як-є друге)))
  (equal? (пошук-асоціації
            (як-є відсутній)
            (список (сполучити (як-є а) (як-є перше)))
            (функція () (як-є резерв)))
          (як-є резерв))
  (equal? (пошук-асоціації
            (як-є порожньо) (як-є ())
            (функція () (як-є порожній-резерв)))
          (як-є порожній-резерв))
  (equal? (пошук-асоціації
            (список (як-є складений))
            (список (сполучити (список (як-є складений)) (як-є структурний-збіг)))
            (функція () (як-є немає)))
          (сполучити (список (як-є складений)) (як-є структурний-збіг)))
  (перевірити-чи-черга-порожня? (як-є ()))
  (хибне? (перевірити-чи-черга-порожня? (як-є (а))))
  (equal? (сортувати-за-першим
            (список (список (довжина (як-є (а б))) (як-є друге))
                  (список (довжина (як-є (а))) (як-є перше))))
          (список (список (довжина (як-є (а))) (як-є перше))
                (список (довжина (як-є (а б))) (як-є друге))))
  (equal? (кількість-результатів-спостереження (як-є (а б)))
          (довжина (як-є (а б))))
  (правильно-структурований-список-знань? (як-є (а б)))
  (хибне? (правильно-структурований-список-знань? (сполучити (як-є а) (як-є б))))
  (результат-є-правильним-списком? (як-є (а б)))
  (хибне? (результат-є-правильним-списком? (сполучити (як-є а) (як-є б))))
  (кожен-кандидат-задовольняє-умову?
    (функція (x) (хибне? (порожній? x)))
    (як-є (а б)))
  (хибне? (кожен-кандидат-задовольняє-умову?
          (функція (x) (порожній? x))
          (як-є (а б)))))

; opt-in повна укр-поверхня: exact identity = lib/domains/d*.lisp; DEFINE-аліас, без нової диспетчеризації.
(визначити сполучити cons)
(визначити перевірити-чи-черга-порожня? empty-queue?)
(визначити кожен-кандидат-задовольняє-умову? forall-every-candidate-satisfies?)
(визначити правильно-структурований-список-знань? knowledge-proper-list?)
(визначити список list)
(визначити хибне? not?)
(визначити порожній? null?)
(визначити кількість-результатів-спостереження result-count)
(визначити результат-є-правильним-списком? result-proper-list?)
(визначити пошук-асоціації sassoc)
(визначити сортувати-за-першим sortcar)
