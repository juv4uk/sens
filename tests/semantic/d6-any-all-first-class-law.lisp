; Д6:111100 ANY та Д6:111101 ALL: виклик після живого DEFINE з Core4.
; Єдині визначення кванторів беруться з lib/core4-parts/core4-d6b.lisp.
; Цей файл містить лише мовні свідки, жодного дублювання механізмів.
; У першокласному виклику аргумент-квантор є значенням SENS.
; Передумова: дві прив'язки введено лише у кореневу сесію SENS.

(визначити вимагати-д1-так
  (функція (висновок)
    (за-умовою
      ((хибне? висновок) (перше (як-є ())))
      (так висновок))))

(визначити викликати-переданий-квантор
  (функція (квантор умова елементи)
    (квантор умова елементи)))

; ANY: у списку існує рівно один свідок Д1:НІ.
(вимагати-д1-так
  (викликати-переданий-квантор
    будь-яке?
    (функція (елемент) (хибне? елемент))
    (список так ні так)))

; ANY: свідка немає.
(вимагати-д1-так
  (хибне?
    (викликати-переданий-квантор
      будь-яке?
      (функція (елемент) (хибне? елемент))
      (список так так))))

; ALL: кожний елемент задовольняє вимогу.
(вимагати-д1-так
  (викликати-переданий-квантор
    усі?
    (функція (елемент) (хибне? елемент))
    (список ні ні)))

; ALL: перший елемент спростовує вимогу.
(вимагати-д1-так
  (хибне?
    (викликати-переданий-квантор
      усі?
      (функція (елемент) (хибне? елемент))
      (список так ні))))

; ANY на порожньому списку дає Д1 НІ.
(вимагати-д1-так
  (хибне?
    (викликати-переданий-квантор
      будь-яке?
      (функція (елемент) (перше (як-є ())))
      (як-є ()))))

; ALL на порожньому списку дає Д1 ТАК.
(вимагати-д1-так
  (викликати-переданий-квантор
    усі?
    (функція (елемент) (перше (як-є ())))
    (як-є ())))

; ANY зупиняється на першому успіху перед неправильним хвостом.
(вимагати-д1-так
  (викликати-переданий-квантор
    будь-яке?
    (функція (елемент) (хибне? елемент))
    (сполучити ні (як-є непридатний-хвіст))))

; ALL зупиняється на першій невдачі перед неправильним хвостом.
(вимагати-д1-так
  (хибне?
    (викликати-переданий-квантор
      усі?
      (функція (елемент) (хибне? елемент))
      (сполучити так (як-є непридатний-хвіст)))))

; Останній вердикт належить виконаному SENS, не хосту.
(атом? (як-є ()))
