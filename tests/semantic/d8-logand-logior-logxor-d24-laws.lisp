; Закони побітових операцій і, або та виключного або.
; Сім правильних рівностей і одне спростування.
(список
  (однакові? (побітове-і 6 3) 2)
  (однакові? (побітове-і 7 3) 3)
  (однакові? (побітове-і 0 7) 0)
  (однакові? (побітове-або 4 3) 7)
  (однакові? (побітове-або 1 2) 3)
  (однакові? (побітове-виключне-або 6 3) 5)
  (однакові? (побітове-виключне-або 3 3) 0)
  (хибне? (однакові? (побітове-виключне-або 6 3) 6)))
