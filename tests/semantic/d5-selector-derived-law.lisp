; Д5: перевірка канонічних похідних селекторів через D3 CAR/CDR/QUOTE/EQ/COND.
; Доказ — п'ять справжніх SENS-тверджень, результат рівно D1:так.
; Д5: третє = CAR(CDR(CDR)); решта-трьох = CDR^3;
; перше-двох-перших = CAR(CAR(CAR)); решта-двох-перших = CDR(CAR(CAR)).
; Жодного повторного визначення ратифікованих функцій або хостового оракула.

(за-умовою
  ((тотожне? (третє (як-є (а б в г))) (як-є в))
    (за-умовою
      ((тотожне? (перше (решта (решта (як-є (а б в г))))) (як-є в))
        (за-умовою
          ((тотожне? (перше (решта-трьох (як-є (а б в г)))) (як-є г))
            (за-умовою
              ((тотожне? (перше-двох-перших (як-є (((а б) в) г))) (як-є а))
                (за-умовою
                  ((тотожне? (перше (решта-двох-перших (як-є (((а б) в) г)))) (як-є б))
                    так)
                  (так ні)))
              (так ні)))
          (так ні)))
      (так ні)))
  (так ні))
