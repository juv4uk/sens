   (атом? (сполучити (як-є ()) (як-є ()))))
  ((це-рекурсивне-замикання? (як-є приклад))
   (атом? (сполучити (як-є ()) (як-є ()))))
  ((лямбда-має-параметр-залишку? (як-є ()))
   (атом? (сполучити (як-є ()) (як-є ()))))
  ((атом? (як-є ())) (атом? (як-є ()))))
