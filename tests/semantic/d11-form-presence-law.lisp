; Д11 FORM-PRESENCE: фізичні SENS-закони мають окремий носій.
; Нативний закон: визначення виявляється; те саме під цитуванням — дані.
; Обидва результати перевіряє СЕНС, а не зовнішній скрипт.
; Неправильне виконання завершується реальною помилкою ПЕРШЕ порожнього.
(за-умовою
  ((містить-форму-визначити? (як-є (визначити ікс (як-є ()))))
   (за-умовою
     ((хибне? (містить-форму-визначити?
                (як-є (як-є (визначити ікс (як-є ())))))) так)
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))

; Цитована неправильна пара лишається ДАНИМИ, а не вкладеним викликом.
(за-умовою
  ((хибне?
     (містить-форму-визначити?
       (список (як-є як-є) (сполучити так ні))))
   так)
  (так (перше (як-є ()))))

; Вкладена цитата може містити неправильну пару, але зовнішня форма
; DEFINE після повного D3-підтвердження лишається виконуваною формою.
(за-умовою
  ((містить-форму-визначити?
     (список (як-є визначити)
       (список (як-є як-є) (сполучити так ні))))
   так)
  (так (перше (як-є ()))))
