; Десять законів сховища вмісту з незмінною структурою.
; Перевіряються порожнє сховище, отримання значення та наявність адреси.
; Розміри записані математичними десятковими числами.
(список
  (однакові? (порожній-вміст-сховище) (як-є ()))
  (однакові? (вміст-сховище-розмір (порожній-вміст-сховище))
          0)
  (однакові? (вміст-сховище-розмір
            (список (сполучити (як-є адреса-а) (як-є значення-а))
                  (сполучити (як-є адреса-б) (як-є ()))))
          2)
  (вміст-сховище-містить?
    (список (сполучити (як-є адреса-а) (як-є значення-а))
          (сполучити (як-є адреса-б) (як-є ())))
    (як-є адреса-б))
  (хибне? (вміст-сховище-містить?
          (список (сполучити (як-є адреса-а) (як-є значення-а)))
          (як-є адреса-б)))
  (однакові? (вміст-сховище-отримати
            (список (сполучити (як-є адреса-а) (як-є значення-а)))
            (як-є адреса-а))
          (список (як-є значення-а)))
  (однакові? (вміст-сховище-отримати
            (список (сполучити (як-є адреса-б) (як-є ())))
            (як-є адреса-б))
          (список (як-є ())))
  (однакові? (вміст-сховище-отримати
            (список (сполучити (як-є адреса-а) (як-є значення-а)))
            (як-є адреса-б))
          (як-є ()))
  (хибне? (однакові? (вміст-сховище-отримати
                  (список (сполучити (як-є адреса-б) (як-є ())))
                  (як-є адреса-б))
                (як-є ())))
  (хибне? (вміст-сховище-містить?
          (порожній-вміст-сховище) (як-є адреса-а))))
