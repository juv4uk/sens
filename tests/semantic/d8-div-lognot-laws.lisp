; Закони одночасного обчислення частки й остачі та побітової операції.
; Вісім перевірок виконуються над точними десятковими математичними числами.
; Обчислення визначене мовними функціями без машинних викличних голів.

(визначити поділити-з-часткою-й-остачею
  (функція (ліве праве)
    (сполучити (частка ліве праве)
               (сполучити (модульна-остача ліве праве) (як-є ())))))
(визначити побітове-не
  (функція (число)
    (за-умовою
      ((нуль? число) 0)
      ((хибне? (нуль? число))
       (додати
         (за-умовою
           ((однакові? (модульна-остача число 2)
                    0)
            1)
           ((хибне?
              (однакові? (модульна-остача число 2)
                      0))
            0))
         (помножити
           2
           (побітове-не
             (частка число 2))))))))
(список
  (однакові? (поділити-з-часткою-й-остачею 10
                         3)
          (список 3
                1))
  (однакові? (поділити-з-часткою-й-остачею 8
                         2)
          (список 4
                0))
  (однакові? (побітове-не 0)
          0)
  (однакові? (побітове-не 1)
          0)
  (однакові? (побітове-не 2)
          1)
  (однакові? (побітове-не 5)
          2)
  (однакові? (поділити-з-часткою-й-остачею 7
                         2)
          (список 3
                1))
  (однакові? (побітове-не 7)
          0))
