; Закони одночасного обчислення частки й остачі та побітової операції.
; Вісім перевірок виконуються над точними десятковими математичними числами.
; Обчислення визначене мовними функціями без машинних викличних голів.

(визначити побітове-не
  (функція (число)
    (за-умовою
      ((нуль? число) (довжина (як-є ())))
      ((хибне? (нуль? число))
       (додати
         (за-умовою
           ((однакові? (модульна-остача число (довжина (як-є (а б))))
                    (довжина (як-є ())))
            (довжина (як-є (а))))
           ((хибне?
              (однакові? (модульна-остача число (довжина (як-є (а б))))
                      (довжина (як-є ()))))
            (довжина (як-є ()))))
         (помножити
           (довжина (як-є (а б)))
           (побітове-не
             (частка число (довжина (як-є (а б)))))))))))
(список
  (однакові? (поділити-з-часткою-й-остачею (довжина (як-є (а б в г ґ д е є ж з)))
                         (довжина (як-є (а б в))))
          (список (довжина (як-є (а б в)))
                (довжина (як-є (а)))))
  (однакові? (поділити-з-часткою-й-остачею (довжина (як-є (а б в г ґ д е є)))
                         (довжина (як-є (а б))))
          (список (довжина (як-є (а б в г)))
                (довжина (як-є ()))))
  (однакові? (побітове-не (довжина (як-є ())))
          (довжина (як-є ())))
  (однакові? (побітове-не (довжина (як-є (а))))
          (довжина (як-є ())))
  (однакові? (побітове-не (довжина (як-є (а б))))
          (довжина (як-є (а))))
  (однакові? (побітове-не (довжина (як-є (а б в г ґ))))
          (довжина (як-є (а б))))
  (однакові? (поділити-з-часткою-й-остачею (довжина (як-є (а б в г ґ д е)))
                         (довжина (як-є (а б))))
          (список (довжина (як-є (а б в)))
                (довжина (як-є (а)))))
  (однакові? (побітове-не (довжина (як-є (а б в г ґ д е))))
          (довжина (як-є ()))))
