; Мовний закон D3 COND: перша істинна гілка має пріоритет навіть при Д1:ні.
; Невибрані гілки не виконуються; невикличний CAR NIL у них безпечний.
; Lisp задає семантику; Zig/T5M лише переносить код до фізичного SENS.
; Пріоритет першої істинної гілки, навіть якщо її значення Д1:ні
(за-умовою
  ((тотожне? (за-умовою ((атом? (як-є ())) ні) (так так)) (хибне? (атом? (як-є ()))))
    ; Хибна умова пропускає небезпечну гілку й повертає Д1:ні
    (за-умовою
      ((тотожне? (за-умовою ((хибне? (атом? (як-є ()))) (перше (як-є ()))) (так ні)) (хибне? (атом? (як-є ()))))
        ; Хибна умова не виконує небезпечну гілку, друга дає Д1:так
        (за-умовою
          ((тотожне? (за-умовою ((хибне? (атом? (як-є ()))) (перше (як-є ()))) (так так)) (атом? (як-є ())))
            так)
          (так ні)))
      (так ні)))
  (так ні))
