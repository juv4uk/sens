; Закони округлення вгору, арифметичного зсуву та зсуву вправо.
; Усі індекси й математичні значення записано десятково.
; Вісім перевірок використовують визначення самою мовою СЕНС.

(визначити округлити-вгору
  (функція (ліве праве)
    (за-умовою
      ((нуль? (модульна-остача ліве праве)) (частка ліве праве))
      ((хибне? (нуль? (модульна-остача ліве праве)))
       (додати-1 (частка ліве праве))))))
(визначити арифметичний-зсув
  (функція (число кроки)
    (за-умовою
      ((нуль? кроки) число)
      ((хибне? (нуль? кроки))
       (помножити число (піднести-до-степеня (довжина (як-є (а б))) кроки))))))
(визначити зсунути-вправо
  (функція (число кроки)
    (за-умовою
      ((нуль? кроки) число)
      ((хибне? (нуль? кроки))
       (частка число (піднести-до-степеня (довжина (як-є (а б))) кроки))))))
(список
  (однакові? (округлити-вгору (довжина (як-є (а б в г ґ д е є ж з)))
                           (довжина (як-є (а б в))))
          (довжина (як-є (а б в г))))
  (однакові? (округлити-вгору (довжина (як-є (а б в г ґ д е є ж)))
                           (довжина (як-є (а б в))))
          (довжина (як-є (а б в))))
  (однакові? (арифметичний-зсув (довжина (як-є (а б в)))
                             (довжина (як-є (а))))
          (довжина (як-є (а б в г ґ д))))
  (однакові? (арифметичний-зсув (довжина (як-є (а б в г ґ)))
                             (довжина (як-є ())))
          (довжина (як-є (а б в г ґ))))
  (однакові? (зсунути-вправо (довжина (як-є (а б в г ґ д е є)))
                          (довжина (як-є (а))))
          (довжина (як-є (а б в г))))
  (однакові? (зсунути-вправо (довжина (як-є (а б в г ґ д е є)))
                          (довжина (як-є (а б))))
          (довжина (як-є (а б))))
  (однакові? (зсунути-вправо (довжина (як-є (а б в г ґ д е)))
                          (довжина (як-є (а))))
          (довжина (як-є (а б в))))
  (однакові? (округлити-вгору (довжина (як-є (а)))
                           (довжина (як-є (а))))
          (довжина (як-є (а)))))
