; Закони округлення вгору, арифметичного зсуву та зсуву вправо.
; Усі індекси й математичні значення записано десятково.
; Вісім перевірок використовують визначення самою мовою СЕНС.

(визначити округлити-вгору
  (функція (ліве праве)
    (за-умовою
      ((нуль? (модульна-остача ліве праве)) (частка ліве праве))
      ((хибне? (нуль? (модульна-остача ліве праве)))
       (додати-1 (частка ліве праве))))))
(визначити арифметичний-зсув
  (функція (число кроки)
    (за-умовою
      ((нуль? кроки) число)
      ((хибне? (нуль? кроки))
       (помножити число (піднести-до-степеня 2 кроки))))))
(визначити зсунути-вправо
  (функція (число кроки)
    (за-умовою
      ((нуль? кроки) число)
      ((хибне? (нуль? кроки))
       (частка число (піднести-до-степеня 2 кроки))))))
(список
  (однакові? (округлити-вгору 10
                           3)
          4)
  (однакові? (округлити-вгору 9
                           3)
          3)
  (однакові? (арифметичний-зсув 3
                             1)
          6)
  (однакові? (арифметичний-зсув 5
                             0)
          5)
  (однакові? (зсунути-вправо 8
                          1)
          4)
  (однакові? (зсунути-вправо 8
                          2)
          2)
  (однакові? (зсунути-вправо 7
                          1)
          3)
  (однакові? (округлити-вгору 1
                           1)
          1))
