; СЕНС · D5:10100/10101 · позитивний закон обернення.
; Для правильного списку REVERSE-ONTO(x,y) = APPEND(REVERSE(x),y).
; Порядок і кратність зберігаються; порожній вхід залишає акумулятор.

(за-умовою
  ((хибне?
     (однакові?
       (зворот-до
         (список так ні)
         (список так ні))
       (список ні так так ні)))
   ні)
  ((хибне?
     (однакові?
       (зворот-до
         (як-є ())
         (список ні так))
       (список ні так)))
   ні)
  ((хибне?
     (однакові?
       (зворот (список так ні))
       (список ні так)))
   ні)
  ((хибне?
     (порожній? (зворот (як-є ()))))
   ні)
  (так так))
