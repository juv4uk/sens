; Д11 SRFI-1 FILTER-MAP: тільки D1:ні відкидається.
; Відкидання всіх результатів зберігає саме структурний D3:().
; Ніяке значення D1:ні не стає елементом вихідного списку.
(за-умовою
  ((порожній?
     (відобразити-та-зберегти-нехибні
       (функція (значення) ні)
       (список так ні так)))
   так)
  (так (перше (як-є ()))))


; Структурний D3:() — значення, що лишається двічі і в тому ж порядку.
; Реальне SENS визначення підключається з lib/d11-srfi1-filter-map.lisp.
(за-умовою
  ((однакові?
     (відобразити-та-зберегти-нехибні
       (функція (значення)
         (за-умовою
           ((однакові? значення так) (як-є ()))
           (так ні)))
       (список так ні так))
     (список (як-є ()) (як-є ())))
   так)
  (так (перше (як-є ()))))

; D11_FILTER_MAP_PAIR_RESULT: після перетворення виходять D3-пари.
; D1:ні відкидається, але кожна непорожня пара лишається ДАНИМИ.
; Дві структури зберігають вхідний порядок; це виконує сам SENS.
(за-умовою
  ((однакові?
     (відобразити-та-зберегти-нехибні
       (функція (значення)
         (за-умовою
           ((тотожне? значення ні) ні)
           (так (сполучити значення (список ні)))))
       (список так ні так))
     (список
       (список так ні)
       (список так ні)))
   так)
  (так (перше (як-є ()))))
