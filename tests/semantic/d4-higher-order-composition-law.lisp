; D4: композиція двох функцій першого класу, без нового opcode або іменованого дубля.
; Після ATOM виконується NOT: порожній атом -> ні, CONS/цитована пара -> так.
; Усі твердження всередині української Lisp-програми; Zig/T5M лише носій.
((функція (складена)
   (за-умовою
     ((хибне? (складена (як-є ())))
      (за-умовою
        ((складена (сполучити (як-є ()) (як-є ())))
         (за-умовою
           ((складена (як-є (радіо антена))) так)
           (так ні)))
        (так ні)))
     (так ні)))
 ((функція (після до)
    (функція (значення)
      (після (до значення))))
  (функція (судження) (хибне? судження))
  (функція (елемент) (атом? елемент))))
