     (знайти-перший-хвіст-із-наявністю
       порожній?
       (список (як-є ()) так))
     (список так (список (як-є ()) так)))
   так)
  (так (перше (як-є ()))))

; Відсутність повертає D1:ні та окремий структурний D3:().
(за-умовою
  ((однакові?
     (знайти-перший-хвіст-із-наявністю
       (функція (елемент) (хибне? елемент))
       (список так так))
     (список ні (як-є ())))
   так)
  (так (перше (як-є ()))))

; Для порожнього входу несправний предикат навіть не обчислюється.
(за-умовою
  ((однакові?
     (знайти-перший-хвіст-із-наявністю
       (функція (елемент) (перше (як-є ())))
