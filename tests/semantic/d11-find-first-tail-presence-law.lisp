     (список ні (як-є ())))
   так)
  (так (перше (як-є ()))))

; Допоміжне маркування приймає лише точне D1:ні як відсутність.
(за-умовою
  ((однакові?
     (позначити-наявність-першого-хвоста ні)
     (список ні (як-є ())))
