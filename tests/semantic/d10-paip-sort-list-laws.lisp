; Закони стійкого впорядкування правильних списків за власним порівнянням.
; Усі математичні значення записані десятково, порядок рівних ключів збережено.

(список
  (однакові?
    (сортувати-список-за
      (функція (ліве праве) (менше? ліве праве))
      (список 3
            1
            2))
    (список 1
          2
          3))
  (однакові?
    (сортувати-список-за
      (функція (ліве праве) (менше? ліве праве))
      (список 3
            2
            1))
    (список 1
          2
          3))
  (однакові?
    (сортувати-список-за
      (функція (ліве праве) (менше? ліве праве))
      (як-є ()))
    (як-є ()))
  (однакові?
    (сортувати-список-за
      (функція (ліве праве) (менше? (перше ліве) (перше праве)))
      (список
        (список 2 (як-є а))
        (список 1 (як-є б))
        (список 2 (як-є в))))
    (список
      (список 1 (як-є б))
      (список 2 (як-є а))
      (список 2 (як-є в))))
  (однакові?
    ((функція (елементи)
       (список
         (сортувати-список-за
           (функція (ліве праве) (менше? ліве праве))
           елементи)
         елементи))
     (список 3
           1
           2))
    (список
      (список 1
            2
            3)
      (список 3
            1
            2))))
