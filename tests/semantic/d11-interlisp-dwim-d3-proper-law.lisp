; Д11 DWIM: структура кандидатів належить SENS D3/D4, не D7-рядку.
; Повторний однаковий кандидат рахується один раз; сторонній запис ігноруємо.
; Неповний і неоднозначний результат не підміняються автоматичним виправленням.
(за-умовою
  ((хибне?
     (однакові?
       (підказка-з-контексту
         (як-є хибне?)
         (список
           (список (як-є хибне?) (як-є атом?))
           (список (як-є інше) (як-є решта))
           (список (як-є хибне?) (як-є атом?))))
       (список (як-є пропозиція) (як-є хибне?) (як-є атом?))))
   ні)
  ((хибне?
     (однакові?
       (підказка-з-контексту
         (як-є хибне?)
         (список
           (список (як-є хибне?) (як-є атом?))
           (список (як-є хибне?) (як-є решта))))
       (список (як-є неоднозначно) (як-є хибне?))))
   ні)
  (так так))
