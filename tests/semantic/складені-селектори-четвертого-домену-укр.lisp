; Позитивне свідчення трьох селекторів четвертого домену.
; Негативне свідчення відрізняє хвіст першої пари від хвоста зовнішньої.
; Закон виконує сам обчислювач СЕНС, не зовнішній скрипт.

(визначити приклад-складених-селекторів
  (сполучити
    (сполучити
      (як-є ліве)
      (сполучити (як-є середина) (як-є ())))
    (сполучити (як-є праве) (як-є ()))))

(за-умовою
  ((тотожне? (перше-першого приклад-складених-селекторів) (як-є ліве))
   (за-умовою
     ((тотожне? (перше (решта-першого приклад-складених-селекторів))
                 (як-є середина))
      (за-умовою
        ((порожній? (решта-решти приклад-складених-селекторів))
         (за-умовою
           ((хибне?
              (тотожне?
                (перше (решта приклад-складених-селекторів))
                (як-є середина)))
            так)
           (так ні)))
        (так ні)))
     (так ні)))
  (так ні))
