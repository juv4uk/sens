; Д3: CAR(CONS(радіо, (антена)))=радіо, CAR(CDR(...))=антена.
; Обидві рівності перевіряє сам SENS на цитованих атомах.
(за-умовою
  ((тотожне?
     (перше (сполучити (як-є радіо) (як-є (антена))))
     (як-є радіо))
    (за-умовою
      ((тотожне?
         (перше (решта (сполучити (як-є радіо) (як-є (антена)))))
         (як-є антена))
       так)
      (так (перше (як-є ())))))
  (так (перше (як-є ()))))
