; Семантика довжини без числових літералів:
; порожній → порожній «лічильник»; інакше сполучити маркер і рекурсія.

(визначити накопичити-довжину
  (функція (залишок мітки)
    (за-умовою
      ((атом? залишок) мітки)
      (так (накопичити-довжину
             (решта залишок)
             (сполучити (як-є одиниця) мітки))))))

(визначити свідок-довжини
  (функція ()
    (нехай ((дві (сполучити (як-є а) (сполучити (як-є б) (як-є ()))))
            (мітки (накопичити-довжину дві (як-є ()))))
      (за-умовою
        ((тотожне? (перше мітки) (як-є одиниця))
         (за-умовою
           ((тотожне? (перше (решта мітки)) (як-є одиниця))
            (за-умовою
              ((атом? (решта (решта мітки)))
               (як-є (закон-довжина (status pass))))
              (так (як-є (закон-довжина (status fail))))))
           (так (як-є (закон-довжина (status fail))))))
        (так (як-є (закон-довжина (status fail))))))))

(свідок-довжини)
