; Семантика: довжина списку рекурсією на решта (без хост-лічильника).

(визначити довжина
  (функція (залишок)
    (за-умовою
      ((атом? залишок) 0)
      (так (додати 1 (довжина (решта залишок)))))))

(визначити свідок-довжини
  (функція ()
    (за-умовою
      ((тотожне?
         (довжина (сполучити (як-є а)
                    (сполучити (як-є б) (як-є ()))))
         2)
       (як-є (закон-довжина (status pass))))
      (так (як-є (закон-довжина (status fail)))))))

(свідок-довжини)
