; Д11 LIST=: спрямований порівнювач зберігає тотожність EQ.
; Для різних D1-аргументів істина залежить тільки від лівого.
(визначити порівнювати-ліворуч
  (функція (лівий правий)
    (за-умовою
      ((тотожне? лівий правий) так)
      (лівий так)
      (так ні))))
(за-умовою
  ((списки-рівні-за-порівнянням?
     порівнювати-ліворуч (список так) (список ні))
   (за-умовою
     ((хибне?
        (списки-рівні-за-порівнянням?
          порівнювати-ліворуч (список ні) (список так)))
      (за-умовою
        ((списки-рівні-за-порівнянням?
           порівнювати-ліворуч (список ні) (список ні))
         так)
        (так ні)))
     (так ні)))
  (так ні))
