; Негативний мовний свідок D3: перший COND повертає Д1:ні, не Д1:так.
; Єдина мутація — очікуваний результат першої гілки, фізичний код не змінюємо.
; Нативний SENS повинен обчислити точне Д1:ні.
; Пріоритет першої істинної гілки, навіть якщо її значення Д1:ні — навмисно хибне очікування
(за-умовою
  ((тотожне? (за-умовою ((атом? (як-є ())) ні) (так так)) (атом? (як-є ())))
    ; Хибна умова пропускає небезпечну гілку й повертає Д1:ні
    (за-умовою
      ((тотожне? (за-умовою ((хибне? (атом? (як-є ()))) (перше (як-є ()))) (так ні)) (хибне? (атом? (як-є ()))))
        ; Хибна умова не виконує небезпечну гілку, друга дає Д1:так
        (за-умовою
          ((тотожне? (за-умовою ((хибне? (атом? (як-є ()))) (перше (як-є ()))) (так так)) (атом? (як-є ())))
            так)
          (так ні)))
      (так ні)))
  (так ні))
