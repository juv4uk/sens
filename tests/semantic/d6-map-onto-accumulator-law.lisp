; Д6:101010 MAP-ONTO — закон SENS для правильних списків.
; Непорожній накопичувач розвертається, далі йдуть відображені елементи.
; Немає текстового D7 або числових проміжних значень: лише D1/D3.
; Дію не викликати на порожньому списку, дублікати не вилучати.

(за-умовою
  ((хибне?
     (однакові?
       (відобразити-до
         (функція (елемент) (хибне? елемент))
         (список так ні так)
         (список так ні))
       (список ні так ні так ні)))
   ні)
  ((хибне?
     (однакові?
       (відобразити-до
         (функція (елемент) (перше елемент))
         (як-є ())
         (список так ні))
       (список ні так)))
   ні)
  ((хибне?
     (однакові?
       (відобразити-до
         (функція (елемент) елемент)
         (список так так ні)
         (як-є ()))
       (список так так ні)))
   ні)
  (так так))
