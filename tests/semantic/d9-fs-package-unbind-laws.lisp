; D9:010101111 FS-PACKAGE-FIELD та D9:001100000 FS-UNBIND.
; 9 нативних D1 самосвідків; пакетні ключі — структурні атоми.
(список
  (equal?
    (фс-пакет-поле (як-є формат) (список (сполучити (як-є формат) (як-є корінь))))
    (як-є корінь))
  (equal?
    (фс-пакет-поле (як-є адреса)
      (список (сполучити (як-є формат) (як-є корінь))
            (сполучити (як-є адреса) (як-є мітка))))
    (як-є мітка))
  (порожній?
    (фс-пакет-поле (як-є відсутня)
      (список (сполучити (як-є формат) (як-є корінь)))))
  (порожній? (фс-пакет-поле (як-є формат) (як-є не-список)))
  (порожній?
    (фс-пакет-поле (як-є формат)
      (список (сполучити (список (як-є формат)) (як-є неправильно))
            (сполучити (як-є формат) (як-є корінь)))))
  (equal?
    (фс-розв'язати
      (список (як-є об'єкти) (список (список (як-є а) (як-є один)) (список (як-є б) (як-є два))) #d24:000000000000000000000000)
      (як-є а))
    (список (як-є об'єкти) (список (список (як-є б) (як-є два))) #d24:000000000000000000000001))
  (equal?
    (фс-розв'язати
      (список (як-є об'єкти) (список (список (як-є а) (як-є один))) #d24:000000000000000000000000)
      (як-є відсутня))
    (список (як-є об'єкти) (список (список (як-є а) (як-є один))) #d24:000000000000000000000001))
  (equal?
    (фс-розв'язати
      (список (як-є об'єкти) (список (список (як-є а) (як-є один))) #d24:000000000000000000000000)
      (як-є а))
    (список (як-є об'єкти) (як-є ()) #d24:000000000000000000000001))
  (equal?
    (фс-розв'язати
      (список (як-є об'єкти)
            (список (список (як-є а) (як-є один))
                  (список (як-є б) (як-є два))
                  (список (як-є а) (як-є три))) #d24:000000000000000000000000)
      (як-є а))
    (список (як-є об'єкти) (список (список (як-є б) (як-є два))) #d24:000000000000000000000001)))

