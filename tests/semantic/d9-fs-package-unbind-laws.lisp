; Дев'ять законів читання полів пакета та вилучення зв'язування.
; Пакетні ключі перевіряються як структурні атоми.
; Лічильник ревізії подано людськими десятковими числами.
(список
  (однакові?
    (фс-пакет-поле (як-є формат) (список (сполучити (як-є формат) (як-є корінь))))
    (як-є корінь))
  (однакові?
    (фс-пакет-поле (як-є адреса)
      (список (сполучити (як-є формат) (як-є корінь))
            (сполучити (як-є адреса) (як-є мітка))))
    (як-є мітка))
  (порожній?
    (фс-пакет-поле (як-є відсутня)
      (список (сполучити (як-є формат) (як-є корінь)))))
  (порожній? (фс-пакет-поле (як-є формат) (як-є не-список)))
  (порожній?
    (фс-пакет-поле (як-є формат)
      (список (сполучити (список (як-є формат)) (як-є неправильно))
            (сполучити (як-є формат) (як-є корінь)))))
  (однакові?
    (фс-розв'язати
      (список (як-є об'єкти) (список (список (як-є а) (як-є один)) (список (як-є б) (як-є два))) 0)
      (як-є а))
    (список (як-є об'єкти) (список (список (як-є б) (як-є два))) 1))
  (однакові?
    (фс-розв'язати
      (список (як-є об'єкти) (список (список (як-є а) (як-є один))) 0)
      (як-є відсутня))
    (список (як-є об'єкти) (список (список (як-є а) (як-є один))) 1))
  (однакові?
    (фс-розв'язати
      (список (як-є об'єкти) (список (список (як-є а) (як-є один))) 0)
      (як-є а))
    (список (як-є об'єкти) (як-є ()) 1))
  (однакові?
    (фс-розв'язати
      (список (як-є об'єкти)
            (список (список (як-є а) (як-є один))
                  (список (як-є б) (як-є два))
                  (список (як-є а) (як-є три))) 0)
      (як-є а))
    (список (як-є об'єкти) (список (список (як-є б) (як-є два))) 1)))
