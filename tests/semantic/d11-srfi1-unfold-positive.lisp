; Д11 SRFI-1 UNFOLD: закон семантичного виконання тільки в SENS.
; Ратифіковані D3/D4/D5: СПОЛУЧИТИ, ПЕРШЕ, РЕШТА, ПОРОЖНІЙ?, ФУНКЦІЯ.
; Фізичний mint/paired SENS завантажує DEFINE як binding-source: lib/d11-srfi1-unfold.lisp.
; Відмовний шлях — недопустиме ПЕРШЕ від порожнього списку, не host assert.
;
; UNFOLD зберігає лівий-порядок значень.
(за-умовою
  ((однакові?
     (розгорнути-список-зі-стану
       (функція (стан) (порожній? стан))
       (функція (стан) (перше стан))
       (функція (стан) (решта стан))
       (список так ні)
       (функція (стан) (як-є ())))
     (список так ні))
   так)
  (так (перше (як-є ()))))

; Зупинка негайна: ані генератор елемента, ані наступний стан
; НЕ можуть викликатися після істинного предиката завершення.
(за-умовою
  ((однакові?
     (розгорнути-список-зі-стану
       (функція (стан) (порожній? стан))
       (функція (стан) (перше (як-є ())))
       (функція (стан) (перше (як-є ())))
       (як-є ())
       (функція (стан) (список ні)))
     (список ні))
   так)
  (так (перше (як-є ()))))

; Непорожній завершальний D3-хвіст приєднується після усіх елементів.
; D1:ні всередині результату не є D3:() і не зупиняє UNFOLD.
(за-умовою
  ((однакові?
     (розгорнути-список-зі-стану
       (функція (стан) (порожній? стан))
       (функція (стан) (перше стан))
       (функція (стан) (решта стан))
       (список ні так)
       (функція (стан) (список ні)))
     (список ні так ні))
   так)
  (так (перше (як-є ()))))

; UNFOLD-RIGHT переносить елементи зліва направо у зворотний список;
; початковий кінець передається явним значенням.
(за-умовою
  ((однакові?
     (розгорнути-список-праворуч-зі-стану
       (функція (стан) (порожній? стан))
       (функція (стан) (перше стан))
       (функція (стан) (решта стан))
       (список так ні)
       (список так))
     (список ні так так))
   так)
  (так (перше (як-є ()))))

; Праворуч, порожній вхід: хвіст повертається незмінним.
(за-умовою
  ((однакові?
     (розгорнути-список-праворуч-зі-стану
       (функція (стан) (порожній? стан))
       (функція (стан) (перше (як-є ())))
       (функція (стан) (перше (як-є ())))
       (як-є ())
       (список так))
     (список так))
   так)
  (так (перше (як-є ()))))

; Д11: порожній D3-елемент усередині списку — дані, не кінець.
(за-умовою
  ((однакові?
     (розгорнути-список-зі-стану
       (функція (стан) (порожній? стан))
       (функція (стан) (перше стан))
       (функція (стан) (решта стан))
       (список (як-є ()))
       (функція (стан) (список ні)))
     (список (як-є ()) ні))
   так)
  (так (перше (як-є ()))))

; Д11 UNFOLD-RIGHT: порядок змінюється, але D3:() як дані не зникає.
(за-умовою
  ((однакові?
     (розгорнути-список-праворуч-зі-стану
       (функція (стан) (порожній? стан))
       (функція (стан) (перше стан))
       (функція (стан) (решта стан))
       (список (як-є ()) так)
       (список ні))
     (список так (як-є ()) ні))
   так)
  (так (перше (як-є ()))))
