; Закон (з бенчмарка): зберегти лише атоми верхнього рівня, порядок збережено.

(визначити лише-атоми
  (функція (залишок)
    (за-умовою
      ((атом? залишок) (як-є ()))
      ((атом? (перше залишок))
       (сполучити (перше залишок) (лише-атоми (решта залишок))))
      (так (лише-атоми (решта залишок))))))

(визначити свідок-лише-атоми
  (функція ()
    (нехай ((вхід (сполучити (як-є а)
                     (сполучити (сполучити (як-є б) (як-є ()))
                       (сполучити (як-є в) (як-є ())))))
            (вихід (лише-атоми вхід)))
      (за-умовою
        ((тотожне? (перше вихід) (як-є а))
         (за-умовою
           ((тотожне? (перше (решта вихід)) (як-є в))
            (за-умовою
              ((атом? (решта (решта вихід)))
               (як-є (закон-лише-атоми (status pass))))
              (так (як-є (закон-лише-атоми (status fail))))))
           (так (як-є (закон-лише-атоми (status fail))))))
        (так (як-є (закон-лише-атоми (status fail))))))))

(свідок-лише-атоми)
