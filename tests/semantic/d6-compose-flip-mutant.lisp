; Негативний закон D6: COMPOSE f g = f(g(x)), не g(f(x)).
; D4 APPLY приймає замикання та готовий список аргументів SENS.
(визначити результат-композиції
  (застосувати
    (скласти-функції
      (функція (значення) (перше значення))
      (функція (значення) (решта значення)))
    (список (сполучити так (сполучити ні (як-є ()))))))

(за-умовою
  ((атом? результат-композиції)
   (тотожне? результат-композиції так))
  (так ні))
