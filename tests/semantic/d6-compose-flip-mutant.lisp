; Мутант D6: помилкова гіпотеза COMPOSE f g = g(f(x)).
; Правий закон f(g(x)) тут повертає D1:ні, а не D1:так.
; EQ допустиме тільки після перевірки атомності першого аргументу.

(визначити результат-композиції
  ((скласти-функції
     (функція (значення) (перше значення))
     (функція (значення) (решта значення)))
   (сполучити так (сполучити ні (як-є ())))))

(за-умовою
  ((атом? результат-композиції)
   (тотожне? результат-композиції так))
  (так ні))
