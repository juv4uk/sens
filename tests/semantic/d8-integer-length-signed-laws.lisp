; D8 INTEGER-LENGTH — 8 SENS/D1 identity and falsifier witnesses.
; Only qualified D24 integer values; negative values are two's complement.
(list
  (equal? (бітова-довжина-цілого #d24:000000000000000000000000) #d24:000000000000000000000000)
  (equal? (бітова-довжина-цілого #d24:000000000000000000000001) #d24:000000000000000000000001)
  (equal? (бітова-довжина-цілого #d24:000000000000000000000010) #d24:000000000000000000000010)
  (equal? (бітова-довжина-цілого #d24:000000000000000000000111) #d24:000000000000000000000011)
  (equal? (бітова-довжина-цілого #d24:000000000000000000001000) #d24:000000000000000000000100)
  (equal? (бітова-довжина-цілого (змінити-знак #d24:000000000000000000000001)) #d24:000000000000000000000000)
  (equal? (бітова-довжина-цілого (змінити-знак #d24:000000000000000000000010)) #d24:000000000000000000000001)
  (not? (equal? (бітова-довжина-цілого (змінити-знак #d24:000000000000000000000011)) #d24:000000000000000000000001)))
