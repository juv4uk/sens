; Мовний Д3/Д4 закон форми логічної змінної.
; Назва var є цитованими даними; вирішує власний Lisp-предикат.
; Завантажувати разом із lib/unify.lisp та виконувати через Zig/T5M.
(за-умовою
  ((змінна? (список (як-є var) (як-є вузол)))
   (за-умовою
     ((хибне? (змінна? (список (як-є дерево) (список (як-є var) (як-є вузол)))))
      (за-умовою
        ((хибне? (змінна? (список (як-є var) (як-є вузол) (як-є зайве))))
         (за-умовою
           ((хибне? (змінна? (сполучити (як-є var) (як-є вузол)))) так)
           (так ні)))
        (так ні)))
     (так ні)))
  (так ні))
