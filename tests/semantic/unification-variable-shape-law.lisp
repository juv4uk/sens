; Мовний Д3/Д4 закон форми логічної змінної.
; Назва var є цитованими даними; вирішує власний Lisp-предикат.
; Завантажувати разом із lib/unify.lisp та виконувати через Zig/T5M.
(за-умовою
  ((змінна? (як-є (var вузол)))
   (за-умовою
     ((хибне? (змінна? (як-є (дерево (var вузол))))) так)
     (так ні)))
  (так ні))
