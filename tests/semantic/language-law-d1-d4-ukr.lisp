; Нативні мовні закони D1/D3/D4 — лише українська Lisp-проєкція.
; D3 EQ частковий: він приймає лише атоми, а не складені D7 дані.
; Будь-який хибний D1 самовердикт переходить у недопустимий CAR NIL.
(визначити довести-мовний-закон
  (функція (умова)
    (за-умовою
      ((хибне? умова) (перше (як-є ())))
      (так так))))

; D3 NIL є атомом, CONS — структурою, а QUOTE не виконує список.
(довести-мовний-закон (атом? (як-є ())))
(довести-мовний-закон
  (хибне? (атом? (сполучити (як-є ()) (як-є ())))))
(довести-мовний-закон
  (хибне? (атом? (як-є (альфа бета)))))

; D3 CAR/CDR повертають порожній атом із двох різних позицій.
(довести-мовний-закон
  (тотожне?
    (перше (сполучити (як-є ()) (як-є ())))
    (як-є ())))
(довести-мовний-закон
  (тотожне?
    (перше
      (решта
        (сполучити (як-є (альфа бета))
          (сполучити (як-є ()) (як-є ())))))
    (як-є ())))

; D3 EQ не зливає два протилежні точні предикати D1.
(довести-мовний-закон
  (хибне?
    (тотожне?
      (атом? (як-є ()))
      (атом? (сполучити (як-є ()) (як-є ()))))))

; D3 COND пропускає хибну умову і повертає NIL із другої гілки.
(довести-мовний-закон
  (атом?
    (за-умовою
      ((хибне? (атом? (як-є ())))
       (сполучити (як-є ()) (як-є ())))
      ((атом? (як-є ())) (як-є ())))))

; D4 LAMBDA: внутрішній параметр не підміняє зовнішнє зв'язування.
(довести-мовний-закон
  ((функція (зовнішній)
     ((функція (внутрішній) (атом? зовнішній))
      (сполучити (як-є ()) (як-є ()))))
   (як-є ())))
(довести-мовний-закон
  (хибне?
    ((функція (зовнішній)
       ((функція (внутрішній) (атом? зовнішній))
        (як-є ())))
     (сполучити (як-є ()) (як-є ())))))

; Вихід — лише точний D1:YES. Shell не обчислює мовні закони.
(атом? (як-є ()))
