; Самоперевірка законів мови: D1, D3, D4 без числових голів і літералів.
; Очікування належать SENS. За хибного закону обчислення потрапляє
; у неприйнятний CAR порожнього списку, а не в host-assert.
; Єдина успішна кінцева відповідь — точна D1 істина.
(визначити довести-мовний-закон
  (функція (умова)
    (за-умовою
      ((хибне? умова) (перше (як-є ())))
      (так так))))

; D3: NIL атомний; CONS створює складений об'єкт.
(довести-мовний-закон (атом? (як-є ())))
(довести-мовний-закон
  (хибне? (атом? (сполучити (як-є альфа) (як-є ())))))

; D3: CAR/CDR працюють із реальною парою, а QUOTE не виконує дані.
(довести-мовний-закон
  (тотожне? (перше (сполучити (як-є альфа) (як-є ()))) (як-є альфа)))
(довести-мовний-закон
  (тотожне?
    (перше (решта (сполучити (як-є альфа)
                             (сполучити (як-є бета) (як-є ())))))
    (як-є бета)))
(довести-мовний-закон
  (тотожне? (перше (як-є (альфа бета))) (як-є альфа)))

; D3 EQ не ототожнює два різні атоми.
(довести-мовний-закон
  (хибне? (тотожне? (як-є альфа) (як-є бета))))

; D3 COND має пропустити хибну гілку й обрати другу істинну.
(довести-мовний-закон
  (тотожне?
    (за-умовою
      ((хибне? (атом? (як-є ()))) (як-є неправильна-гілка))
      ((атом? (як-є ())) (як-є правильна-гілка)))
    (як-є правильна-гілка)))

; D4 LAMBDA: внутрішній параметр не підміняє зовнішнього зв'язування.
(довести-мовний-закон
  (тотожне?
    ((функція (зовнішній)
       ((функція (внутрішній) зовнішній) (як-є бета)))
     (як-є альфа))
    (як-є альфа)))
(довести-мовний-закон
  (хибне?
    (тотожне?
      ((функція (зовнішній)
         ((функція (внутрішній) зовнішній) (як-є альфа)))
       (як-є бета))
      (як-є альфа))))

; Точна D1 істина, а не хостове T або числовий літерал.
(атом? (як-є ()))
