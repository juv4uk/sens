; Д5/D24+ — закон восьми точних чисел і стабільного відбору.
; Виконати після чинного lib/залишити-точні-числа.lisp, не як автономний файл.
; D1:так означає, що перевірено саме числову величину, не лише NUMBERP.
(за-умовою
  ((хибне? (точні-числа-рівні? точні-числа-значення-нуль число-нуль)) ні)
  ((хибне? (точні-числа-рівні? точні-числа-значення-один число-один)) ні)
  ((хибне? (точні-числа-рівні? точні-числа-значення-два число-два)) ні)
  ((хибне? (точні-числа-рівні? точні-числа-значення-три число-три)) ні)
  ((хибне? (точні-числа-рівні? точні-числа-значення-чотири число-чотири)) ні)
  ((хибне? (точні-числа-рівні? точні-числа-значення-п'ять число-п'ять)) ні)
  ((хибне? (точні-числа-рівні?
             точні-числа-значення-шість (додати число-п'ять число-один))) ні)
  ((хибне? (точні-числа-рівні? точні-числа-значення-сім число-сім)) ні)
  ((хибне? (точні-числа-рівні? (перше відібране) число-сім)) ні)
  ((хибне? (точні-числа-рівні?
             (друге відібране) (частка число-сім число-два))) ні)
  ((хибне? (точні-числа-рівні?
             (третє відібране) число-нуль)) ні)
  ((хибне? (порожній? (решта (решта (решта відібране))))) ні)
  ; Відмінні способи побудови одного D12+ числового значення.
  ((хибне? (точні-числа-рівні?
             (додати число-три число-чотири)
             точні-числа-значення-сім)) ні)
  ((хибне? (точні-числа-рівні?
             (відняти точні-числа-значення-сім число-сім)
             число-нуль)) ні)
  (так так))
