; Логіка: дизюнкція через за-умовою.

(визначити або
  (функція (ліве праве)
    (за-умовою
      (ліве так)
      (так праве))))

(визначити свідок-дизюнкції
  (функція ()
    (за-умовою
      ((тотожне?
         (або (тотожне? (як-є а) (як-є б)) (тотожне? (як-є а) (як-є а)))
         так)
       (як-є (закон-дизюнкція (status pass))))
      (так (як-є (закон-дизюнкція (status fail)))))))

(свідок-дизюнкції)
