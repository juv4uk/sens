; Мовні закони СЕНС: семантичні очікування написані українською проєкцією.
; Rust та Zig можуть переносити, запускати й спостерігати, але не визначають EQ/CAR/CDR/COND/LAMBDA.
; Успіх кожного самосвідка — точна істина Д1. Порушення переходить до
; навмисно помилкового (перше (як-є ())) та не маскується хостовим assert.
; Цитований виклик є даними: він НЕ виконується.

; Д3: складання пари, проєкції першого й решти, інертність цитати;
; різні атоми не можуть стати тотожними, а хибна гілка умов не виконується.
(за-умовою
  ((тотожне?
     (перше (сполучити (як-є ліве) (як-є праве)))
     (як-є ліве))
   (за-умовою
     ((тотожне?
        (решта (сполучити (як-є ліве) (як-є праве)))
        (як-є праве))
      (за-умовою
        ((тотожне?
           (перше (як-є (сполучити (як-є ліве) (як-є праве))))
           (як-є сполучити))
         (за-умовою
           ((тотожне? (як-є ліве) (як-є праве))
            (перше (як-є ())))
           ((атом? (як-є ()))
            (атом? (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))

; Д4: вкладена функція захоплює зовнішнє лексичне зв'язування.
; Дві різні аргументні позиції не зливаються; результат — істина Д1.
(за-умовою
  ((((функція (захоплено)
       (функція (передано)
         (за-умовою
           ((тотожне? захоплено (як-є зовнішнє))
            (тотожне? передано (як-є внутрішнє)))
           ((атом? (як-є ())) (перше (як-є ()))))))
     (як-є зовнішнє))
    (як-є внутрішнє))
   (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
