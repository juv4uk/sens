; Три закони відображення залишків списку справа.
; Перевіряється порядок префіксів, порожній список і відмінність
; від звичайного обходу перевернутого джерела.
(список
  (однакові?
    (залишки-справа
      (список (як-є а) (як-є б) (як-є в))
      (функція (хвіст) хвіст))
    (список
      (список (як-є а) (як-є б) (як-є в))
      (список (як-є а) (як-є б))
      (список (як-є а))))
  (однакові?
    (залишки-справа (список) (функція (хвіст) хвіст))
    (список))
  (однакові?
    (залишки-справа
      (список (як-є а) (як-є б))
      (функція (хвіст) хвіст))
    (відобразити-залишки
      (зворот (список (як-є а) (як-є б)))
      (функція (хвіст) хвіст))))
