; Д3: CONS зберігає порядок двох різних ратифікованих атомів.
; Перше, друге й порожній хвіст доводить лише український Lisp/SENS.
; Коректний порядок, два атоми й порожній хвіст — Д1:так.
; Кожна гілка COND має рівно тест і вираз, без тричастинних форм.
(за-умовою
  ((хибне? (тотожне? (перше (сполучити (як-є атом?) (сполучити (як-є решта) (як-є ())))) (як-є атом?))) ні)
  ((хибне? (тотожне? (перше (решта (сполучити (як-є атом?) (сполучити (як-є решта) (як-є ()))))) (як-є решта))) ні)
  ((порожній? (решта (решта (сполучити (як-є атом?) (сполучити (як-є решта) (як-є ())))))) так)
  (так ні))
