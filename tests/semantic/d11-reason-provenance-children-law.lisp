; D11: листковий факт та вкладений доказ мають різне походження.
(визначити листок-походження
  (список (як-є proved) (як-є мета) (як-є правило) (як-є ())))
(визначити вузол-походження
  (список (як-є proved) (як-є мета) (як-є правило)
    (список листок-походження)))
(за-умовою
  ((однакові? (джерело-вузла-доказу листок-походження) (як-є fact))
   (однакові? (джерело-вузла-доказу вузол-походження) (як-є rule)))
  (так ні))
