; D9 WORLD?/WORLD-MODULE-EVENTS/WORLD-MODULE-KNOWN? — дев'ять рідних D1-законів.
; Одна канонічна форма, три хибні форми, відфільтрований незмінний журнал.
(список
  (світ? (порожній-світ))
  (світ? (світ-запис (порожній-світ) (як-є (tell альфа факт-а))))
  (хибне? (світ? (як-є world)))
  (хибне? (світ? (як-є (не-світ батько журнал метадані))))
  (хибне? (світ? (як-є (world батько журнал))))
  (хибне? (світ? (як-є (world батько журнал метадані зайве))))
  ; Два відібрані записи перевіряємо точно на рівні D3-атомів,
  ; включно з порядком, усіма полями та відсутністю третьої події.
  ; Жодного невизначеного Text7 EQUAL і жодного EQ над парою.
  (нехай ((події
           (світ-модуль-події
             (створити-світ (як-є ())
               (список (як-є (tell альфа факт-а))
                       (як-є (retract бета факт-б))
                       (як-є (tell альфа факт-в)))
               (як-є ()))
             (як-є альфа))))
    (за-умовою
      ((атом? події) ні)
      ((атом? (решта події)) ні)
      ((хибне? (тотожне? (перше (перше події)) (як-є tell))) ні)
      ((хибне? (тотожне? (друге (перше події)) (як-є альфа))) ні)
      ((хибне? (тотожне? (третє (перше події)) (як-є факт-а))) ні)
      ((хибне? (порожній? (решта (решта (решта (перше події)))))) ні)
      ((хибне? (тотожне? (перше (перше (решта події))) (як-є tell))) ні)
      ((хибне? (тотожне? (друге (перше (решта події))) (як-є альфа))) ні)
      ((хибне? (тотожне? (третє (перше (решта події))) (як-є факт-в))) ні)
      ((хибне? (порожній? (решта (решта (решта (перше (решта події))))))) ні)
      ((порожній? (решта (решта події))) так)
      (так ні)))
  (світ-модуль-відомий? (створити-світ (як-є ()) (список (як-є (tell альфа факт-а)) (як-є (retract бета факт-б)) (як-є (tell альфа факт-в))) (як-є ())) (як-є альфа))
  (хибне? (світ-модуль-відомий? (створити-світ (як-є ()) (список (як-є (tell альфа факт-а)) (як-є (retract альфа факт-а))) (як-є ())) (як-є бета))))
