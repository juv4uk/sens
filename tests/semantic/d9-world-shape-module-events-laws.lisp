; D9 WORLD?/WORLD-MODULE-EVENTS/WORLD-MODULE-KNOWN? — дев'ять рідних D1-законів.
; Одна канонічна форма, три хибні форми, відфільтрований незмінний журнал.
(список
  (світ? (порожній-світ))
  (світ? (світ-запис (порожній-світ) (як-є (tell альфа факт-а))))
  (хибне? (світ? (як-є world)))
  (хибне? (світ? (як-є (не-світ батько журнал метадані))))
  (хибне? (світ? (як-є (world батько журнал))))
  (хибне? (світ? (як-є (world батько журнал метадані зайве))))
  ; Джерело lib/world.lisp тепер порівнює D7-імена структурним
  ; власним законом, тож перевіряємо повний журнал, не тільки довжину.
  ; Вбудований D3 EQ використовується тільки для атомних листків.
  (внутрішня-рівність-версій
    (світ-модуль-події
      (створити-світ (як-є ())
        (список (як-є (tell альфа факт-а))
                (як-є (retract бета факт-б))
                (як-є (tell альфа факт-в)))
        (як-є ()))
      (як-є альфа))
    (список (як-є (tell альфа факт-а))
            (як-є (tell альфа факт-в))))
  (світ-модуль-відомий? (створити-світ (як-є ()) (список (як-є (tell альфа факт-а)) (як-є (retract бета факт-б)) (як-є (tell альфа факт-в))) (як-є ())) (як-є альфа))
  (хибне? (світ-модуль-відомий? (створити-світ (як-є ()) (список (як-є (tell альфа факт-а)) (як-є (retract альфа факт-а))) (як-є ())) (як-є бета))))
