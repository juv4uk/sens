; D10:0001100010 MEMQ + D10:0001011001 SASSQ.
; All eight returns are exact D1:1; negative tests are separate.
(list
  (equal? (memq (quote б)
            (list (quote а) (quote б) (quote в)))
          (list (quote б) (quote в)))
  (equal? (memq (quote а)
            (list (quote а) (quote б)))
          (list (quote а) (quote б)))
  (null? (memq (quote немає)
           (list (quote а) (quote б))))
  (null? (memq (quote а) (quote ())))
  (equal? (sassq (quote ключ-б)
            (list (cons (quote ключ-а) (quote знач-а))
                  (cons (quote ключ-б) (quote знач-б)))
            (lambda () (quote не-знайдено)))
          (cons (quote ключ-б) (quote знач-б)))
  (equal? (sassq (quote ключ-а)
            (list (cons (quote ключ-а) (quote знач-а)))
            (lambda () (quote не-знайдено)))
          (cons (quote ключ-а) (quote знач-а)))
  (equal? (sassq (quote немає)
            (list (cons (quote ключ-а) (quote знач-а)))
            (lambda () (quote резерв)))
          (quote резерв))
  (equal? (sassq (quote немає)
            (quote ())
            (lambda () (quote порожньо)))
          (quote порожньо)))
