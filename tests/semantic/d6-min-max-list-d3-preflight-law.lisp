                    число-нуль)
                  так)
                 (так (перше (як-є ())))))
              (так (перше (як-є ())))))
           (так (перше (як-є ())))))
        (так (перше (як-є ())))))
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))
