; D8:11110101 AND, D8:11111100 OR, D9:110110101 FIFTH.
; Вісім незалежних D1:YES законів у фізичному SENS процесі.
; Три фальсифікатори відхиляють неправильні результати.
(list
  (та (equal? (як-є а) (як-є а)) (equal? (як-є б) (як-є б)))
  (not? (та (equal? (як-є а) (як-є а)) (equal? (як-є а) (як-є б))))
  (або (equal? (як-є а) (як-є б)) (equal? (як-є а) (як-є а)))
  (not? (або (equal? (як-є а) (як-є б)) (equal? (як-є б) (як-є а))))
  (або (equal? (як-є а) (як-є а)) (equal? (як-є а) (як-є б)))
  (equal? (п'ятий (list (як-є а) (як-є б) (як-є в) (як-є г) (як-є д))) (як-є д))
  (equal? (п'ятий (list (як-є а) (як-є б) (як-є в) (як-є г) (як-є д) (як-є е))) (як-є д))
  (not? (equal? (п'ятий (list (як-є а) (як-є б) (як-є в) (як-є г) (як-є д))) (як-є г))))
