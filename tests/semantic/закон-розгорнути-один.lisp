; Закон (з бенчмарка): розгорнути вкладеність; перевірка першого після нормалізації.

(визначити перевернути-н
  (функція (залишок накопичувач)
    (за-умовою
      ((атом? залишок) накопичувач)
      (так (перевернути-н (решта залишок)
                         (сполучити (перше залишок) накопичувач))))))

(визначити розгорнути
  (функція (залишок накопичувач)
    (за-умовою
      ((атом? залишок) накопичувач)
      ((атом? (перше залишок))
       (розгорнути (решта залишок)
                   (сполучити (перше залишок) накопичувач)))
      (так (розгорнути (решта залишок)
                       (розгорнути (перше залишок) накопичувач))))))

(визначити свідок-розгорнути
  (функція ()
    (нехай ((вхід (сполучити (як-є а)
                     (сполучити (сполучити (як-є б) (як-є ()))
                       (як-є ()))))
            (плоский (перевернути-н (розгорнути вхід (як-є ())) (як-є ()))))
      (за-умовою
        ((тотожне? (перше плоский) (як-є а))
         (за-умовою
           ((тотожне? (перше (решта плоский)) (як-є б))
            (як-є (закон-розгорнути (status pass))))
           (так (як-є (закон-розгорнути (status fail))))))
        (так (як-є (закон-розгорнути (status fail))))))))

(свідок-розгорнути)
