; Десять законів масштабування, відображення та обходу списку.
; Математичні числа записані десятково, а помилкові результати відхиляються.
(список
  (однакові? (масштабувати 2
                        3)
          6)
  (однакові? (масштабувати 0
                        3)
          0)
  (однакові? (масштабувати 3
                        2)
          6)
  (хибне? (однакові? (масштабувати 2
                              3)
                5))
  (порожній? (перевідобразити
           (функція (елемент) (збільшити-на-1 елемент))
           (як-є ())))
  (однакові? (перевідобразити
            (функція (елемент) (збільшити-на-1 елемент))
            (список 1
                  2))
          (список 2
                3))
  (однакові? (перевідобразити
            (функція (елемент)
              (масштабувати елемент 2))
            (список 1
                  2))
          (список 2
                4))
  (хибне? (однакові? (перевідобразити
                  (функція (елемент) (збільшити-на-1 елемент))
                  (список 1))
                (список 1)))
  (порожній? (для-кожного-елемента
           (функція (елемент) (збільшити-на-1 елемент))
           (як-є ())))
  (порожній? (для-кожного-елемента
           (функція (елемент) (збільшити-на-1 елемент))
           (список 1
                 2))))
