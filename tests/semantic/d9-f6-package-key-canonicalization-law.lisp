; D9/F6: лише десять закритих ключів протоколу мають канонічний D8 READ-проєктор.
; Вихід — точний D1. Тест виконується разом із lib/lisp-fs.lisp у фізичному T5M-runner.
(за-умовою
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є format) (текст-у-символ "format")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є version) (текст-у-символ "version")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є revision) (текст-у-символ "revision")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є bindings) (текст-у-символ "bindings")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є objects) (текст-у-символ "objects")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є address) (текст-у-символ "address")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є value) (текст-у-символ "value")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є op) (текст-у-символ "op")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є name) (текст-у-символ "name")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є root) (текст-у-символ "root")))
   ні)
  ; Невідомий ключ не стає псевдонімом жодної протокольної назви.
  ((фс-пакет-однаковий-ключ?
     (як-є format) (текст-у-символ "sens-unknown-key"))
   ні)
  ; Невідомий ключ НЕ отримує нової протокольної координати.
  ; Але буквальна тотожність із собою залишається чинним законом D8.
  ((хибне?
     (однакові?
       (фс-канонічний-ключ (як-є sens-unknown-key))
       (як-є sens-unknown-key)))
   ні)
  ((хибне?
     (однакові?
       (фс-канонічний-ключ (текст-у-символ "sens-unknown-key"))
       (текст-у-символ "sens-unknown-key")))
   ні)
  ; Порівняння двох невідомих різних назв не породжує псевдоніма.
  ((фс-пакет-однаковий-ключ?
     (як-є sens-unknown-key) (текст-у-символ "another-unknown-key"))
   ні)
  ; Всі допустимі носії ключа: атом або одне з десяти D7-імен.
  ; Вкладена довільна пара НЕ стає новим іменем протоколу.
  ((хибне? (фс-пакет-ключ-допустимий? (як-є format))) ні)
  ; Реальний ключ після серіалізації кореня та READ зберігає
  ; канонічне D7-подання протокольної назви й має лишатися допустимим.
  ((хибне?
     (фс-пакет-ключ-допустимий?
       (перше
         (перше
           (прочитати
             (значення-у-текст
               (фс-корінь-пакет (фс-порожній))))))))
   ні)
  ; Структурні імена мають проходити явно, раніше атомарного
  ; WRITE→SYMBOL. Це регресійний закон порядку гілок F6.
  ((хибне? (фс-пакет-ключ-допустимий? (як-є version))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (як-є revision))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (як-є bindings))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (як-є objects))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (текст-у-символ "format"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (текст-у-символ "version"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (текст-у-символ "revision"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (текст-у-символ "bindings"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (текст-у-символ "objects"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (текст-у-символ "address"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (текст-у-символ "value"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (текст-у-символ "op"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (текст-у-символ "name"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (текст-у-символ "root"))) ні)
  ; WRITE→READ D7-слово кожного ключа канонізується назад у точний D8-символ.
  ((хибне?
     (однакові?
       (фс-канонічний-ключ (прочитати "format"))
       (як-є format))) ні)
  ((хибне?
     (однакові?
       (фс-канонічний-ключ (прочитати "version"))
       (як-є version))) ні)
  ((хибне?
     (однакові?
       (фс-канонічний-ключ (прочитати "revision"))
       (як-є revision))) ні)
  ((хибне?
     (однакові?
       (фс-канонічний-ключ (прочитати "bindings"))
       (як-є bindings))) ні)
  ((хибне?
     (однакові?
       (фс-канонічний-ключ (прочитати "objects"))
       (як-є objects))) ні)
  ((хибне?
     (однакові?
       (фс-канонічний-ключ (прочитати "address"))
       (як-є address))) ні)
  ((хибне?
     (однакові?
       (фс-канонічний-ключ (прочитати "value"))
       (як-є value))) ні)
  ((хибне?
     (однакові?
       (фс-канонічний-ключ (прочитати "op"))
       (як-є op))) ні)
  ((хибне?
     (однакові?
       (фс-канонічний-ключ (прочитати "name"))
       (як-є name))) ні)
  ((хибне?
     (однакові?
       (фс-канонічний-ключ (прочитати "root"))
       (як-є root))) ні)
  ; Невідоме D7-слово лишається даними, не псевдонімом протоколу.
  ((однакові?
     (фс-канонічний-ключ (прочитати "sens-unknown-key"))
     (як-є format)) ні)
  ; Власне поле format має знайтися після повного кореневого WRITE→READ.
  ((хибне?
     (фс-пакет-єдине-поле?
       (як-є format)
       (прочитати
         (значення-у-текст
           (фс-корінь-пакет (фс-порожній))))))
   ні)
  ; Фізичний READ має ті самі десять дозволених ключів.
  ((хибне? (фс-пакет-ключ-допустимий? (прочитати "format"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (прочитати "version"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (прочитати "revision"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (прочитати "bindings"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (прочитати "objects"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (прочитати "address"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (прочитати "value"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (прочитати "op"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (прочитати "name"))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (прочитати "root"))) ні)
  ; Фізичний READ невідомого ключа так само відхиляється.
  ((фс-пакет-ключ-допустимий? (прочитати "sens-unknown-key")) ні)
  ; Невідомий багатоклітинний D7-ключ зберігає ідентичність,
  ; але не одержує псевдоніма чи координати закритого протоколу.
  ((хибне?
     (однакові?
       (фс-канонічний-ключ (текст-у-символ "sens-unregistered"))
       (текст-у-символ "sens-unregistered")))
   ні)
  ; Структурний payload не передається до D3 атомної тотожності.
  ((хибне?
     (однакові?
       (фс-канонічний-ключ (список (як-є unknown)))
       (список (як-є unknown))))
   ні)
  ; Невідомий D7-ключ ніколи не стає допустимим D8-розширенням.
  ((фс-пакет-ключ-допустимий? (текст-у-символ "sens-unknown-key")) ні)
  ((фс-пакет-ключ-допустимий? (список (як-є format))) ні)
  ((фс-пакет-ключ-допустимий? (як-є ())) ні)
  ; D7 формат припустимий у реальному F3/F6 списку полів.
  ((хибне?
     (фс-журнал-список-пар?
       (список (сполучити (як-є format) (як-є ()))))) ні)
  ((хибне?
     (фс-пакет-унікальні-ключі?
       (список (сполучити (як-є format) (як-є ()))))) ні)
  ; Невідома вкладена структура відхиляється раніше за порівняння.
  ((фс-пакет-унікальні-ключі?
     (список
       (сполучити (список (як-є format)) (як-є ()))))
   ні)
  ; D7-ключ і D8 READ-символ одного закритого імені — дубль, не поле.
  ((фс-пакет-єдине-поле?
     (як-є format)
     (список
       (сполучити (як-є format) (як-є wsm-fs-root))
       (сполучити
         (текст-у-символ "format")
         (текст-у-символ "wsm-fs-root"))))
   ні)
  ; Відсутність ключа не дорівнює присутньому ключу зі значенням ().
  ((фс-пакет-єдине-поле?
     (як-є value)
     (список (сполучити (як-є format) (як-є wsm-fs-root))))
   ні)
  ((хибне?
     (фс-пакет-єдине-поле?
       (як-є value)
       (список (сполучити (як-є value) (як-є ())))))
   ні)
  ; Пошкоджений запис і хвіст мають відхилятися, навіть після знайденого ключа.
  ((фс-пакет-єдине-поле? (як-є format) (список (як-є broken-field)))
   ні)
  ((фс-пакет-єдине-поле?
     (як-є format)
     (список
       (сполучити (як-є format) (як-є wsm-fs-root))
       (як-є broken-tail)))
   ні)
  ; Навіть якщо фізичний lookup поверне D3:(), він не стає форматом.
  ((фс-формат-кореня? (як-є ())) ні)
  ((фс-формат-об'єкта? (як-є ())) ні)
  ; READ фізичного запису повертає SENS-значення, а не хостове ім'я.
  ; Мітки об'єкта і кореня — тільки дві точні дозволені назви.
  ((хибне?
     (фс-формат-кореня? (прочитати "wsm-fs-root")))
   ні)
  ((хибне?
     (фс-формат-об'єкта? (прочитати "wsm-fs-object")))
   ні)
  ((фс-формат-кореня? (прочитати "wsm-fs-object")) ні)
  ((фс-формат-об'єкта? (прочитати "wsm-fs-root")) ні)
  ((фс-формат-кореня? (прочитати "wsm-fs-unknown")) ні)
  ((фс-формат-об'єкта? (прочитати "wsm-fs-unknown")) ні)
  ; Фізичний текстовий carrier канонічної мітки має залишатися допустимим.
  ((хибне?
     (фс-формат-кореня?
       (значення-у-текст (прочитати "wsm-fs-root"))))
   ні)
  ((хибне?
     (фс-формат-об'єкта?
       (значення-у-текст (прочитати "wsm-fs-object"))))
   ні)
  ; Текстовий carrier невідомої або перехресної мітки залишається відхиленим.
  ((фс-формат-кореня?
     (значення-у-текст (прочитати "wsm-fs-unknown"))) ні)
  ((фс-формат-об'єкта?
     (значення-у-текст (прочитати "wsm-fs-unknown"))) ні)
  ((фс-формат-кореня?
     (значення-у-текст (прочитати "wsm-fs-object"))) ні)
  ((фс-формат-об'єкта?
     (значення-у-текст (прочитати "wsm-fs-root"))) ні)
  ; D9/F6: це реальний WRITE→READ повного кореневого й об'єктового пакета,
  ; а не READ окремої людиночитної назви або пряме значення перед серіалізацією.
  ((хибне?
     (фс-формат-кореня?
       (фс-пакет-поле (як-є format)
         (прочитати
           (фс-серіалізувати-корінь (фс-порожній))))))
   ні)
  ((хибне?
     (фс-формат-об'єкта?
       (фс-пакет-поле (як-є format)
         (прочитати
           (фс-серіалізувати-об'єкт (як-є ()))))))
   ні)
  ((хибне?
     (однакові?
       (перше
         (фс-десеріалізувати-корінь
           (фс-серіалізувати-корінь (фс-порожній))))
       (як-є accepted)))
   ні)
  ((хибне?
     (однакові?
       (перше
         (фс-десеріалізувати-об'єкт
           (фс-серіалізувати-об'єкт (як-є ()))))
       (як-є accepted)))
   ні)
  ; Перехресна мітка з реально розібраного пакета не є дозволеним форматом.
  ((фс-формат-кореня?
     (фс-пакет-поле (як-є format)
       (прочитати (фс-серіалізувати-об'єкт (як-є ())))))
   ні)
  ((фс-формат-об'єкта?
     (фс-пакет-поле (як-є format)
       (прочитати (фс-серіалізувати-корінь (фс-порожній)))))
   ні)
  (так так))
