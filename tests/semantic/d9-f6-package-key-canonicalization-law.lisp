; D9/F6: лише десять закритих ключів протоколу мають канонічний D8 READ-проєктор.
; Вихід — точний D1. Тест виконується разом із lib/lisp-fs.lisp у фізичному T5M-runner.
(за-умовою
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є format) (текст-у-символ "format")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є version) (текст-у-символ "version")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є revision) (текст-у-символ "revision")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є bindings) (текст-у-символ "bindings")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є objects) (текст-у-символ "objects")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є address) (текст-у-символ "address")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є value) (текст-у-символ "value")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є op) (текст-у-символ "op")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є name) (текст-у-символ "name")))
   ні)
  ((хибне?
     (фс-пакет-однаковий-ключ? (як-є root) (текст-у-символ "root")))
   ні)
  ; Невідомий ключ не стає псевдонімом жодної протокольної назви.
  ((фс-пакет-однаковий-ключ?
     (як-є format) (текст-у-символ "sens-unknown-key"))
   ні)
  ; Невідомий ключ НЕ отримує нової протокольної координати.
  ; Але буквальна тотожність із собою залишається чинним законом D8.
  ((хибне?
     (однакові?
       (фс-канонічний-ключ (як-є sens-unknown-key))
       (як-є sens-unknown-key)))
   ні)
  ((хибне?
     (однакові?
       (фс-канонічний-ключ (текст-у-символ "sens-unknown-key"))
       (текст-у-символ "sens-unknown-key")))
   ні)
  ; Порівняння двох невідомих різних назв не породжує псевдоніма.
  ((фс-пакет-однаковий-ключ?
     (як-є sens-unknown-key) (текст-у-символ "another-unknown-key"))
   ні)
  ; Всі допустимі носії ключа: атом або одне з десяти D7-імен.
  ; Вкладена довільна пара НЕ стає новим іменем протоколу.
  ((хибне? (фс-пакет-ключ-допустимий? (як-є format))) ні)
  ((хибне? (фс-пакет-ключ-допустимий? (текст-у-символ "format"))) ні)
  ((фс-пакет-ключ-допустимий? (список (як-є format))) ні)
  ((фс-пакет-ключ-допустимий? (як-є ())) ні)
  ; D7 формат припустимий у реальному F3/F6 списку полів.
  ((хибне?
     (фс-журнал-список-пар?
       (список (сполучити (як-є format) (як-є ()))))) ні)
  ((хибне?
     (фс-пакет-унікальні-ключі?
       (список (сполучити (як-є format) (як-є ()))))) ні)
  ; Невідома вкладена структура відхиляється раніше за порівняння.
  ((фс-пакет-унікальні-ключі?
     (список
       (сполучити (список (як-є format)) (як-є ()))))
   ні)
  ; D7-ключ і D8 READ-символ одного закритого імені — дубль, не поле.
  ((фс-пакет-єдине-поле?
     (як-є format)
     (список
       (сполучити (як-є format) (як-є wsm-fs-root))
       (сполучити
         (текст-у-символ "format")
         (текст-у-символ "wsm-fs-root"))))
   ні)
  ; Відсутність ключа не дорівнює присутньому ключу зі значенням ().
  ((фс-пакет-єдине-поле?
     (як-є value)
     (список (сполучити (як-є format) (як-є wsm-fs-root))))
   ні)
  ((хибне?
     (фс-пакет-єдине-поле?
       (як-є value)
       (список (сполучити (як-є value) (як-є ())))))
   ні)
  ; Пошкоджений запис і хвіст мають відхилятися, навіть після знайденого ключа.
  ((фс-пакет-єдине-поле? (як-є format) (список (як-є broken-field)))
   ні)
  ((фс-пакет-єдине-поле?
     (як-є format)
     (список
       (сполучити (як-є format) (як-є wsm-fs-root))
       (як-є broken-tail)))
   ні)
  (так так))
