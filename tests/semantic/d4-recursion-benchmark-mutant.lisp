; Д4 негатив: хибно вважаємо атомний хвіст завершеним списком.
; Свідок виконується разом із бібліотекою; не самостійно.
; Структурна рівність D8 для D7-даних; частковий D3 EQ тут недопустимий.
(за-умовою
  ((однакові? (обійти (як-є ())) (як-є завершено))
   (за-умовою
     ((однакові? (обійти (як-є (радіо антена))) (як-є завершено))
      (за-умовою
        ((однакові? (обійти (як-є пошкоджений-хвіст))
                    (як-є завершено))
         (хибне? (однакові?
                   (обійти (як-є пошкоджений-хвіст))
                   (як-є завершено))))
        (так ні)))
     (так ні)))
  (так ні))
