; Д4 негатив: хибно вважаємо атомний хвіст завершеним списком.
; Свідок виконується разом із бібліотекою; не самостійно.
; Порожній та правильний список завершуються, атомний хвіст — помилка.
(за-умовою
  ((тотожне? (обійти (як-є ())) (як-є завершено))
   (за-умовою
     ((тотожне? (обійти (як-є (радіо антена))) (як-є завершено))
      (за-умовою
        ((тотожне? (обійти (як-є пошкоджений-хвіст))
                    (як-є завершено))
         (хибне? (тотожне?
                   (обійти (як-є пошкоджений-хвіст))
                   (як-є завершено))))
        (так ні)))
     (так ні)))
  (так ні))
