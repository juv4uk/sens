; Д6 ZIP/UNZIP та Д8 ZIP-swapped/UNZIP-swapped — одна композиція SENS.
; Порядок та D3-пари зберігаються, без тексту і проміжних чисел.
(за-умовою
  ((хибне?
    (однакові?
      (спарувати-послідовності-навпаки
        (список так ні) (список ні так))
      (список (сполучити ні так) (сполучити так ні))))
   ні)
  ((хибне?
    (однакові?
      (розпарувати-пари
        (спарувати-послідовності
          (список так ні) (список ні так)))
      (список (список так ні) (список ні так))))
   ні)
  ((хибне?
    (однакові?
      (розпарувати-пари-навпаки
        (спарувати-послідовності
          (список так ні) (список ні так)))
      (список (список ні так) (список так ні))))
   ні)
