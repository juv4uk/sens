; D8:00011101 LIST*, 00111110 LENGTH-LIST, 01001111 LIST-LENGTH.
; Вісім явних D1-контролів, структурна пара ≠ правильний список.
(список
  (equal? (неправильний-список (як-є а) (як-є б))
          (сполучити (як-є а) (як-є б)))
  (equal? (неправильний-список (як-є а) (як-є б) (як-є в))
          (сполучити (як-є а) (сполучити (як-є б) (як-є в))))
  (equal? (неправильний-список (як-є а) (як-є ()))
          (список (як-є а)))
  (equal? (неправильний-список (як-є а)) (як-є а))
  (equal? (довжина-списку (як-є ()))
          #d24:000000000000000000000000)
  (equal? (довжина-списку (список (як-є а) (як-є б)))
          #d24:000000000000000000000010)
  (equal? (список-довжина (як-є ()))
          #d24:000000000000000000000000)
  (equal? (список-довжина (список (як-є а)))
          #d24:000000000000000000000001))

