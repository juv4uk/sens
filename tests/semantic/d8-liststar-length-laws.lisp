; Закони побудови неправильної пари й довжини правильного списку.
; Вісім перевірок порівнюють структури або десяткові довжини.
(список
  (однакові? (неправильний-список (як-є а) (як-є б))
    (сполучити (як-є а) (як-є б)))
  (однакові? (неправильний-список (як-є а) (як-є б) (як-є в))
    (сполучити (як-є а) (сполучити (як-є б) (як-є в))))
  (однакові? (неправильний-список (як-є а) (як-є ()))
    (список (як-є а)))
  (однакові? (неправильний-список (як-є а)) (як-є а))
  (однакові? (довжина-списку (як-є ())) 0)
  (однакові? (довжина-списку (список (як-є а) (як-є б))) 2)
  (однакові? (список-довжина (як-є ())) 0)
  (однакові? (список-довжина (список (як-є а))) 1))
