; Перевірка визначення функції засобами самої мови.
; Функція повертає цитований атом через свій параметр.
; Логічні значення керують лише умовами, а помилка виражається структурно.
((функція (одержано)
   (за-умовою
     ((атом? одержано)
      (за-умовою
        ((тотожне? (тотожне? одержано (як-є мітка)) ні) так)
        (так (ні))))
     (так одержано)))
 (решта
   (репл-крок
     (прочитати "(перевірити (як-є мітка))")
     (репл-визначити-функцію
       (як-є перевірити)
       (прочитати "(значення)")
       (прочитати "значення")
       (репл-почати (як-є ()))))))
