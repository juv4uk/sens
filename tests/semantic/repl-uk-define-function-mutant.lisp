; D4 0010/0011: SENS сама складає та визначає функцію.
; Лише справжній D1:YES є позитивом; структурний error-пару
; передаємо НЕЗМІННОЮ, щоб не приховати причину помилки.
((0010 (одержано)
   (110
     ((010 одержано)
      (110
        ((101 одержано #d1:0) #d1:1)
        (#d1:1 (#d1:0))))
     (#d1:1 одержано)))
 (011
   (репл-крок
     (прочитати "(перевірити (атом? (як-є ())))")
     (репл-визначити-функцію
       (001 перевірити)
       (прочитати "(значення)")
       (прочитати "значення")
       (репл-почати (001 ()))))))
