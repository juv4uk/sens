; Д11: остання наявність НЕ є істинністю самого знайденого значення.
; Кожний закон обчислюється тільки SENS; неправда дає D3 CAR Type.
(за-умовою
  ((однакові?
     (знайти-останнє-значення-із-наявністю
       хибне? (список ні так ні))
     (список так ні))
   так)
  (так (перше (як-є ()))))
; Знайдений D3:() — справжній збіг, а не відсутність.
(за-умовою
  ((однакові?
     (знайти-останнє-значення-із-наявністю
       порожній? (список (як-є ()) так (як-є ())))
     (список так (як-є ())))
   так)
  (так (перше (як-є ()))))
; Немає збігів навіть за непорожнього входу.
(за-умовою
  ((однакові?
     (знайти-останнє-значення-із-наявністю
       хибне? (список так так))
     (список ні (як-є ())))
   так)
  (так (перше (як-є ()))))
; Порожній D3 список: предикат не викликається навіть якщо він спричинив би Type.
(за-умовою
  ((однакові?
     (знайти-останнє-значення-із-наявністю
       (функція (елемент) (перше (як-є ())))
       (як-є ()))
     (список ні (як-є ())))
   так)
  (так (перше (як-є ()))))
; Останній збіг із двох структурно правильних D1 атомів повертає D1:так.
(за-умовою
  ((однакові?
     (знайти-останнє-значення-із-наявністю
       атом? (список ні так))
     (список так так))
   так)
  (так (перше (як-є ()))))
; Доказ завершення всіх законів — точний D1:так.
(атом? (як-є ()))
