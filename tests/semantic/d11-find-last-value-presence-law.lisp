; Д11: остання наявність НЕ є істинністю самого знайденого значення.
; Кожний закон обчислюється тільки SENS; неправда дає D3 CAR Type.
(за-умовою
  ((однакові?
     (знайти-останнє-значення-із-наявністю
       хибне? (список ні так ні))
     (список так ні))
   так)
  (так (перше (як-є ()))))
; Знайдений D3:() — справжній збіг, а не відсутність.
(за-умовою
  ((однакові?
     (знайти-останнє-значення-із-наявністю
       порожній? (список (як-є ()) так (як-є ())))
     (список так (як-є ())))
   так)
  (так (перше (як-є ()))))
; Немає збігів навіть за непорожнього входу.
(за-умовою
  ((однакові?
     (знайти-останнє-значення-із-наявністю
       хибне? (список так так))
     (список ні (як-є ())))
   так)
  (так (перше (як-є ()))))
; Порожній D3 список: предикат не викликається навіть якщо він спричинив би Type.
(за-умовою
  ((однакові?
     (знайти-останнє-значення-із-наявністю
       (функція (елемент) (перше (як-є ())))
       (як-є ()))
     (список ні (як-є ())))
   так)
  (так (перше (як-є ()))))
; Останній збіг із двох структурно правильних D1 атомів повертає D1:так.
(за-умовою
  ((однакові?
     (знайти-останнє-значення-із-наявністю
       атом? (список ні так))
     (список так так))
   так)
  (так (перше (як-є ()))))

; D11: знайдене D1:ні не замінюється резервним D1:так.
(за-умовою
  ((тотожне?
     (знайти-останнє-значення-або
       хибне? (список ні так ні) так)
     ні)
   так)
  (так (перше (як-є ()))))

; D11: знайдене D3:() не замінюється резервним D1:ні.
(за-умовою
  ((однакові?
     (знайти-останнє-значення-або
       порожній? (список (як-є ()) так (як-є ())) ні)
     (як-є ()))
   так)
  (так (перше (як-є ()))))

; D11: коли збігів немає, повертаємо складене запасне без зміни структури.
(за-умовою
  ((однакові?
     (знайти-останнє-значення-або
       хибне? (список так так) (список ні так))
     (список ні так))
   так)
  (так (перше (як-є ()))))

; D11: на порожньому вході не викликаємо предикат, який кидає D3 CAR Type.
(за-умовою
  ((тотожне?
     (знайти-останнє-значення-або
       (функція (елемент) (перше (як-є ())))
       (як-є ())
       так)
     так)
   так)
  (так (перше (як-є ()))))

; D11: повертається останній збіг, а не перший, навіть коли запасне D1:ні.
(за-умовою
  ((тотожне?
     (знайти-останнє-значення-або
       атом? (список ні так) ні)
     так)
   так)
  (так (перше (як-є ()))))

; Доказ завершення всіх законів — точний D1:так.
(атом? (як-є ()))
