; Ратифікований код Д3 ATOM як значення: передана операція викликається.
; Порівнюємо виклик через аргумент із прямим викликом того самого закону.

(визначити застосувати-одномісну
  (функція (операція значення)
    (операція значення)))

(визначити свідок-першокласного
  (функція ()
    (за-умовою
      ((тотожне?
         (застосувати-одномісну атом? (як-є ядро))
         (атом? (як-є ядро)))
       (як-є (закон-першокласний (status pass))))
      (так (як-є (закон-першокласний (status fail)))))))

(свідок-першокласного)
