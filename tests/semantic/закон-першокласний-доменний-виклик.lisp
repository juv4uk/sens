; Код домену як значення: переданий додати виконується як функція.

(визначити застосувати-двомісну
  (функція (операція ліве праве)
    (операція ліве праве)))

(визначити свідок-першокласного
  (функція ()
    (за-умовою
      ((тотожне? (застосувати-двомісну додати 2 3) 5)
       (як-є (закон-першокласний (status pass))))
      (так (як-є (закон-першокласний (status fail)))))))

(свідок-першокласного)
