; Ратифікований код Д3 ATOM як значення: передана операція викликається.
; Один гліф D7 є атомом у фізичному SENS; багатогліфова назва у T5M — D2-список гліфів.
; Незалежні очікування D1:1 для атома та D1:0 для пари.
; Це ловить хибний застосовувач, який завжди повертає один і той самий біт.

(визначити застосувати-одномісну
  (функція (операція значення)
    (операція значення)))

(визначити свідок-першокласного
  (функція ()
    (за-умовою
      ((тотожне?
         (застосувати-одномісну атом? (як-є а))
         так)
       (за-умовою
         ((тотожне?
            (застосувати-одномісну атом? (сполучити так (як-є ())))
            ні)
          так)
         (так ні)))
      (так ні))))

(свідок-першокласного)
