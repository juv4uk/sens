; Код домену як значення: передана операція викликається.
; Без числових літералів у законі — лише структурна тотожність.

(визначити застосувати-одномісну
  (функція (операція значення)
    (операція значення)))

(визначити тотожність
  (функція (значення)
    значення))

(визначити свідок-першокласного
  (функція ()
    (за-умовою
      ((тотожне?
         (застосувати-одномісну тотожність (як-є ядро))
         (як-є ядро))
       (як-є (закон-першокласний (status pass))))
      (так (як-є (закон-першокласний (status fail)))))))

(свідок-першокласного)
