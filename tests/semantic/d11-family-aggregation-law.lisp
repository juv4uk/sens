; Виконуваний закон СІМЕЙСТВА АГРЕГАЦІЇ Д11 (d11-family-aggregation).
;
; Мовний семантичний свідок на НАЯВНІЙ функції lib/d11-clojure-frequencies-unary.lisp.
; Закон: частоти зберігають порядок першої появи ключа; кратність = кількість
; входжень; порожній вхід → порожній результат.

; Порожній вхід.
(за-умовою
  ((однакові? (частоти-елементів-унарно (як-є ())) (як-є ())) так)
  (так (перше (як-є ()))))

; Один елемент.
(за-умовою
  ((однакові? (частоти-елементів-унарно (як-є (а))) (як-є ((а (о))))) так)
  (так (перше (як-є ()))))

; Порядок першої появи: а раніше за б; кратність збережена.
(за-умовою
  ((однакові? (частоти-елементів-унарно (як-є (а б а)))
              (як-є ((а (о о)) (б (о))))) так)
  (так (перше (як-є ()))))
