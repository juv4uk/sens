; Д11 list=: незалежний позитив структури правильних D3-списків.
(визначити закон-правильних-списків?
  (за-умовою
      ((правильний-список-для-рівності? (як-є ()))
       (за-умовою
         ((правильний-список-для-рівності? (список (як-є ()) (список (як-є а)) (як-є б)))
          (за-умовою
            ((хибне?
               (правильний-список-для-рівності?
                 (сполучити (як-є а) ні)))
             (за-умовою
               ((правильні-списки-для-рівності?
                  (список (як-є ()) (список (як-є а) (як-є б)) (список (як-є а))))
                (за-умовою
                  ((хибне?
                     (правильні-списки-для-рівності?
                       (список
                         (список (як-є а))
                         (сполучити (як-є а) ні))))
                   (за-умовою
                     ((хибне?
                        (правильні-списки-для-рівності?
                          (сполучити (список (як-є а)) ні)))
                      так)
                     (так ні)))
                  (так ні)))
               (так ні)))
            (так ні)))
         (так ні)))
      (так ні)))

(за-умовою
  (закон-правильних-списків? так)
  (так ні))

; D11: D1:ні як цілий список або весь зовнішній ланцюг
; НЕ є структурним D3:(). Позитив має повернути тільки D1:так.
; Для порожнього D3:() обидва валідатори мусять лишатися істинними.
(за-умовою
  ((хибне? (правильний-список-для-рівності? ні))
   (за-умовою
     ((хибне? (правильні-списки-для-рівності? ні))
      (за-умовою
        ((правильний-список-для-рівності? (як-є ()))
         (правильні-списки-для-рівності? (як-є ())))
        (так ні)))
     (так ні)))
  (так ні))
