; Самоперевірка бібліотеки тверджень M1.
; SENS_SOURCE=tests/semantic/твердження-самотест-law.lisp
; NATIVE_SENS_POSITIVE=NOT_VERIFIED
; NATIVE_SENS_NEGATIVE=NOT_VERIFIED
;
; Калібрування: тавтології мають дати так, суперечності — ні.
; Жодних SID8/Sens8, жодних числових літералів у семантиці.
; Визначення з lib/твердження.lisp розгорнуті тут, щоб law був автономним.

(визначити рівне?
  (функція (очікуване фактичне)
    (тотожне? очікуване фактичне)))

(визначити зібрати-пройшли
  (функція (тести)
    (за-умовою
      ((порожній? тести) (як-є ()))
      (так
        (за-умовою
          ((перше тести)
           (сполучити (перше тести) (зібрати-пройшли (решта тести))))
          (так (зібрати-пройшли (решта тести))))))))

(визначити зібрати-впали
  (функція (тести)
    (за-умовою
      ((порожній? тести) (як-є ()))
      (так
        (за-умовою
          ((хибне? (перше тести))
           (сполучити (перше тести) (зібрати-впали (решта тести))))
          (так (зібрати-впали (решта тести))))))))

(визначити звіт
  (функція (тести)
    (сполучити (зібрати-пройшли тести) (зібрати-впали тести))))

(визначити усі-пройшли?
  (функція (тести)
    (порожній? (зібрати-впали тести))))

(визначити суперечність?
  (функція (свідок)
    (хибне? свідок)))

(визначити тавтологія?
  (функція (свідок)
    (рівне? свідок так)))

; --- калібрувальні свідки ---
; 1. порожні списки тотожні
; 2. так тотожне так
; 3. так не тотожне ні
; 4. порожній набір тестів — усі пройшли
; 5. суперечність (ні) розпізнана
; 6. тавтологія (так) розпізнана
; 7. звіт: один так і один ні → пройшли не порожні, впали не порожні
; 8. усі-пройшли? на (так так) → так

(за-умовою
  ((рівне? (як-є ()) (як-є ()))
   (за-умовою
     ((рівне? так так)
      (за-умовою
        ((хибне? (рівне? так ні))
         (за-умовою
           ((усі-пройшли? (як-є ()))
            (за-умовою
              ((суперечність? ні)
               (за-умовою
                 ((тавтологія? так)
                  (за-умовою
                    ((хибне?
                       (порожній?
                         (перше
                           (звіт (сполучити так (сполучити ні (як-є ())))))))
                     (за-умовою
                       ((хибне?
                          (порожній?
                            (решта
                              (звіт (сполучити так (сполучити ні (як-є ())))))))
                        (за-умовою
                          ((усі-пройшли? (сполучити так (сполучити так (як-є ()))))
                           так)
                          (так (ні))))
                       (так (ні))))
                    (так (ні))))
                 (так (ні))))
              (так (ні))))
           (так (ні))))
        (так (ні))))
     (так (ні))))
  (так (ні)))
