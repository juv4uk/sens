; Д11: позитивна SENS-атестація першокласного TAKE-WHILE.
; Кожний список створюється D4 СПИСОК, не D7 текстовою цитатою.
; Хибний мовний закон завершується D3 CAR Type.
(за-умовою
  ((однакові?
     (взяти-поки-умова
       (функція (елемент) (хибне? елемент))
       (список ні ні так ні))
     (список ні ні))
   так)
  (так (перше (як-є ()))))

; Порожній D3 () як елемент зберігається; це не кінець зовнішнього списку.
(за-умовою
  ((однакові?
     (взяти-поки-умова порожній?
       (список (як-є ()) (як-є ()) так (як-є ())))
     (список (як-є ()) (як-є ())))
   так)
  (так (перше (як-є ()))))

; Перший хибний D1-предикат створює порожній префікс.
(за-умовою
  ((порожній?
     (взяти-поки-умова
       (функція (елемент) (хибне? елемент))
       (список так ні)))
   так)
  (так (перше (як-є ()))))

; На порожньому вході умову викликати заборонено.
(за-умовою
  ((порожній?
     (взяти-поки-умова
       (функція (елемент) (перше (як-є ())))
       (як-є ())))
   так)
  (так (перше (як-є ()))))

(атом? (як-є ()))
