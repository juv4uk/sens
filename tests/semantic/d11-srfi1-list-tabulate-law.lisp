; Д11 LIST-TABULATE: нуль, індекси й незнищуваність елементів D1:ні / D3:().
; Один обов'язковий D1 вердикт для всіх гілок, без host-оракула.
(визначити індекси
  (табулювати-список число-три (функція (номер) номер)))
(за-умовою
  ((порожній?
     (табулювати-список
       число-нуль
       (функція (номер) (перше (як-є ())))))
   (за-умовою
     ((нуль? (перше індекси))
      (за-умовою
        ((нуль? (відняти (друге індекси) число-один))
         (за-умовою
           ((нуль? (відняти
                     (перше (решта (решта індекси)))
                     число-два))
            (за-умовою
              ((порожній? (решта (решта (решта індекси))))
               (за-умовою
                 ((хибне?
                    (перше
                      (табулювати-список
                        число-один
                        (функція (номер) ні))))
                  (за-умовою
                    ((порожній?
                       (решта
                         (табулювати-список
                           число-один
                           (функція (номер) ні))))
                     (за-умовою
                       ((порожній?
                          (перше
                            (табулювати-список
                              число-один
                              (функція (номер) (як-є ())))))
                        (порожній?
                          (решта
                            (табулювати-список
                              число-один
                              (функція (номер) (як-є ()))))))
                       (так ні)))
                    (так ні)))
                 (так ні)))
              (так ні)))
           (так ні)))
        (так ні)))
     (так ні)))
  (так ні))
