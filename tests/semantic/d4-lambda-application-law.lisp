; Закон Д4: застосування, захоплення та затінення параметрів функції.
; Умови й остаточний Д1:так обчислює Lisp/SENS; Zig/T5M лише переносить слова.
; Значення Д1 отримуємо через чинні предикати, без текстових символів D7.
; Застосування тотожної функції не змінює значення.
(за-умовою
  ((тотожне?
     ((функція (значення) значення) (атом? (як-є ())))
     (атом? (як-є ())))
   (за-умовою
     ; Замикання зберігає зовнішню істину попри внутрішню підміну на хибу.
     ((тотожне?
        (((функція (захоплене)
            (функція (підміна) захоплене))
          (атом? (як-є ())))
         (хибне? (атом? (як-є ()))))
        (атом? (як-є ())))
      (за-умовою
        ; Однакове ім'я внутрішнього параметра затінює зовнішній.
        ((тотожне?
           (((функція (значення)
               (функція (значення) значення))
             (хибне? (атом? (як-є ()))))
            (атом? (як-є ())))
           (атом? (як-є ())))
         так)
        (так ні)))
     (так ні)))
  (так ні))
