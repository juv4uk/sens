; SENS_SOURCE: M1 — бібліотека тверджень і рекурсивного запуску.
; NATIVE_SENS_POSITIVE: assertion-library-law.lisp через Zig/T5M.
; NATIVE_SENS_NEGATIVE: assertion-library-mutant.lisp та malformed D3 хвіст.
; Семантичний вердикт є D1; хост тільки запускає SENS і читає receipt.

(визначити твердження-однаковості
  (функція (очікуване фактичне)
    (однакові? очікуване фактичне)))

; Звіт має чотири поля: всього, успішно, провалено, імена-провалів.
(визначити зібрати-звіт-тверджень
  (функція (всього успішно провалено імена-провалів)
    (список всього успішно провалено імена-провалів)))

; Кожний запис — (ім'я тестове-замикання); кожне замикання повертає D1.
; Єдиний правильний кінець набору — D3:(). Інший атом викликає D3 Type.
(визначити обійти-твердження
  (функція (тести всього успішно провалено імена-провалів)
    (за-умовою
      ((порожній? тести)
       (зібрати-звіт-тверджень всього успішно провалено імена-провалів))
      ((атом? тести) (перше тести))
      (так
       (за-умовою
         ((однакові? ((друге (перше тести))) (атом? (як-є ())))
          (обійти-твердження
            (решта тести)
            (додати всього 1)
            (додати успішно 1)
            провалено
            імена-провалів))
         (так
          (обійти-твердження
            (решта тести)
            (додати всього 1)
            успішно
            (додати провалено 1)
            (сполучити (перше (перше тести)) імена-провалів))))))))

(визначити запустити-твердження
  (функція (тести)
    (обійти-твердження тести 0 0 0 (як-є ()))))
