; SENS_SOURCE: M1 — самокалібрувальна бібліотека тверджень.
; NATIVE_SENS_POSITIVE: law перевіряє істину/хибу та структурну рівність.
; NATIVE_SENS_NEGATIVE: mutant і неправильний D3-хвіст проходять fail-closed.
; Лічильники — списки ID: їхня довжина є кількістю; жодної D6-арифметики.
; Семантичний вердикт належить SENS, оболонка лише транспортує джерело.

; Рекурсивна рівність. Тотожність застосовується лише до атомів;
; структури порівнюються рекурсивно через ратифіковані D3 CAR/CDR.
(визначити рівне?
  (функція (очікуване фактичне)
    (за-умовою
      ((атом? очікуване)
       (за-умовою
         ((атом? фактичне) (тотожне? очікуване фактичне))
         (так ні)))
      ((атом? фактичне) ні)
      (так
        (за-умовою
          ((рівне? (перше очікуване) (перше фактичне))
           (рівне? (решта очікуване) (решта фактичне)))
          (так ні)))))

(визначити твердження-однаковості
  (функція (очікуване фактичне)
    (рівне? очікуване фактичне)))

; Звіт має чотири списки: всі ID, PASS ID, FAIL ID, ERROR ID.
; Кожен список водночас є структурним лічильником без host arithmetic.
(визначити зібрати-звіт-тверджень
  (функція (всі-ід успішні-ід провалені-ід помилкові-ід)
    (список всі-ід успішні-ід провалені-ід помилкові-ід))))

; Запис тесту — (ID замикання). Кожне замикання мусить повернути D1:так/ні.
; Невідомий хвіст або неправильний запис не перетворюється на успішний EOF.
; Один тестовий запис: замикання виконується РІВНО ОДИН раз.
; Вердикт передається як значення SENS, а не повторно обчислюється в COND.
(визначити обробити-запис-твердження
  (функція (запис вердикт решта-тестів всі-ід успішні-ід провалені-ід помилкові-ід)
    (за-умовою
      ((тотожне? вердикт так)
       (обійти-твердження
         решта-тестів
         (сполучити (перше запис) всі-ід)
         (сполучити (перше запис) успішні-ід)
         провалені-ід помилкові-ід))
      ((тотожне? вердикт ні)
       (обійти-твердження
         решта-тестів
         (сполучити (перше запис) всі-ід)
         успішні-ід
         (сполучити (перше запис) провалені-ід)
         помилкові-ід))
      (так
       (обійти-твердження
         решта-тестів
         (сполучити (перше запис) всі-ід)
         успішні-ід провалені-ід
         (сполучити (перше запис) помилкові-ід))))))

(визначити обійти-твердження
  (функція (тести всі-ід успішні-ід провалені-ід помилкові-ід)
    (за-умовою
      ((порожній? тести)
       (зібрати-звіт-тверджень всі-ід успішні-ід провалені-ід помилкові-ід))
      ((атом? тести) (перше тести))
      (так
       (обробити-запис-твердження
         (перше тести)
         ((друге (перше тести)))
         (решта тести)
         всі-ід успішні-ід провалені-ід помилкові-ід)))))

(визначити запустити-твердження
  (функція (тести)
    (обійти-твердження тести (як-є ()) (як-є ()) (як-є ()) (як-є ()))))
