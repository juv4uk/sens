; Самостійні мовні закони Д3/Д4: інертна цитата та лексичне захоплення.
; SENS визначає Д1-вердикт, Zig лише кодує T5M, Rust — лише механізми.
; Не викликаємо частковий Д3 тотожне? на складених даних і D7-формах.
; Невірний позитив переходить до невикличного CAR порожнього списку.

; Цитований виклик не виконується: решта одноелементного списку порожня,
; але його перший елемент не є порожнім списком.
(за-умовою
  ((порожній? (решта (як-є ((ні)))))
   (за-умовою
     ((хибне? (порожній? (перше (як-є ((ні))))))
      (атом? (як-є ())))
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))

; Повернене замикання утримує зовнішню пару, а внутрішній атом не затінює її.
; Дзеркальний приклад: захоплений порожній атом не перетворюється на пару.
(за-умовою
  ((((функція (захоплено)
       (функція (передано)
         (за-умовою
           ((хибне? (атом? захоплено))
            (атом? передано))
           (так (перше (як-є ()))))))
     (сполучити (як-є ()) (як-є ())))
    (як-є ()))
   (за-умовою
     ((((функція (захоплено)
          (функція (передано)
            (за-умовою
              ((атом? захоплено)
               (хибне? (атом? передано)))
              (так (перше (як-є ()))))))
        (як-є ()))
       (сполучити (як-є ()) (як-є ())))
      (атом? (як-є ())))
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))
