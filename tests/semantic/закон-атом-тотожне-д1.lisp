; Семантика Д1: атом? і тотожне? — закон мови, не механізм носія.

(визначити свідок-атом-тотожне
  (функція ()
    (за-умовою
      ((атом? (як-є ()))
       (за-умовою
         ((тотожне? (як-є а) (як-є а))
          (за-умовою
            ((тотожне? (атом? (список (як-є а))) ні)
             (як-є (закон-атом-тотожне (status pass))))
            (так (як-є (закон-атом-тотожне (status fail))))))
         (так (як-є (закон-атом-тотожне (status fail))))))
      (так (як-є (закон-атом-тотожне (status fail)))))))

(свідок-атом-тотожне)
