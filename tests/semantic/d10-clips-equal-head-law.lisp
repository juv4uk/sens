; Д10 CLIPS: рівність голів структурних цитованих форм — D8 EQUAL, не D3 EQ.
; Потрібні чинні DEFINE з lib/core4.lisp. Очікування: точне D1:так.
; SENS_SOURCE=tests/semantic/d10-clips-equal-head-law.lisp
(за-умовою
  ((твердження-кліпс? (як-є (assert а)))
   (за-умовою
     ((виведення-кліпс? (як-є (printout а)))
      (за-умовою
        ((хибне? (твердження-кліпс? (як-є ((assert) а))))
         (за-умовою
           ((хибне? (виведення-кліпс? (як-є ((printout) а)))) так)
           (так (перше (як-є ())))))
        (так (перше (як-є ())))))
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))

; Д10 ALL-ASSERTS приймає справжній порожній D3 список;
; DROP-PRINTOUTS відкидає printout, але зберігає порядок assert.
(за-умовою
  ((усі-твердження-кліпс? (як-є ()))
   (за-умовою
     ((усі-твердження-кліпс? (як-є ((assert а) (assert б))))
      (за-умовою
        ((однакові?
           (прибрати-виведення-кліпс
             (як-є ((assert а) (printout б) (assert в))))
           (як-є ((assert а) (assert в))))
         так)
        (так (перше (як-є ())))))
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))
