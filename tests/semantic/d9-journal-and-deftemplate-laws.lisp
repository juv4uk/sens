; Додаткові дев'ять незалежних SENS D1 свідків D9/FS та CLIPS.
(список
  (однакові? (фс-журнал-додати (як-є ()) (як-є подія-а))
          (список (як-є подія-а)))
  (однакові? (фс-журнал-додати (список (як-є подія-а)) (як-є подія-б))
          (список (як-є подія-а) (як-є подія-б)))
  (однакові? (фс-журнал-додати (список (як-є подія-а) (як-є подія-б))
                            (як-є подія-в))
          (список (як-є подія-а) (як-є подія-б) (як-є подія-в)))
  (однакові? (фс-журнал-додати (як-є ()) (список (як-є write) (як-є документ)))
          (список (список (як-є write) (як-є документ))))
  (кліпс-визначити-шаблон-форма? (як-є (deftemplate питання)))
  (хибне? (кліпс-визначити-шаблон-форма? (як-є (deffacts питання))))
  (хибне? (кліпс-визначити-шаблон-форма? (як-є ())))
  (хибне? (кліпс-визначити-шаблон-форма? (як-є ((deftemplate) питання))))
  (хибне? (кліпс-визначити-шаблон-форма? (як-є не-форма))))

