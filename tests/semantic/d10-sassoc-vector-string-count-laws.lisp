; Вісім виконуваних законів ратифікованих функцій D10.
; Перевіряємо пошук асоціації з трьома аргументами, зокрема
; резервну дію, яку викликаємо лише за відсутності ключа.
; Кількість результатів та правильність списків мають власні
; мовні визначення у lib/core4.lisp.
; Історичні функції перетворення векторів і рядків тут не
; підміняємо тотожними заглушками: ці операції потребують
; окремої справжньої реалізації за ратифікованим законом D10.
; Значення всередині «як-є» є даними, а не викличними головами.

(список
  (однакові?
    (пошук-асоціації
      (як-є ключ)
      (список (сполучити (як-є ключ) (як-є значення)))
      (функція () (як-є не-знайдено)))
    (сполучити (як-є ключ) (як-є значення)))
  (однакові?
    (пошук-асоціації
      (як-є відсутній)
      (список (сполучити (як-є ключ) (як-є значення)))
      (функція () (як-є запасне-значення)))
    (як-є запасне-значення))
  (однакові?
    (кількість-результатів-спостереження
      (список (як-є а) (як-є б) (як-є в)))
    3)
  (однакові?
    (кількість-результатів-спостереження (як-є ()))
    0)
  (правильно-структурований-список-знань?
    (список (як-є а) (як-є б)))
  (хибне?
    (правильно-структурований-список-знань?
      (сполучити (як-є а) (як-є б))))
  (результат-є-правильним-списком?
    (список (як-є результат)))
  (хибне?
    (результат-є-правильним-списком?
      (сполучити (як-є результат) (як-є хвіст)))))
