; D11 SRFI-1: семантика рівності списків належить тільки Lisp/SENS.
; Виконуємо реальний чинний lib/d11-srfi1-list-equality.lisp через Zig/T5M.
; Істина і хиба утворені D1-предикатами, без цифрових літералів.
(визначити порівнювати-атоми
  (функція (лівий правий) (тотожне? лівий правий)))
(визначити доказ-істина (атом? (як-є ())))
(визначити доказ-хиба (хибне? (атом? (як-є ()))))
(визначити доказ-перелік
  (сполучити доказ-істина (сполучити доказ-хиба (як-є ()))))
(визначити доказ-перестановка
  (сполучити доказ-хиба (сполучити доказ-істина (як-є ()))))
; Новий закон: розрізняємо D3:000 та сторонній атом на вході.
; Перевірки виконуються тільки SENS. Хибний випадок повертає D1:ні.
(визначити закон-правильних-списків?
  (функція ()
    (за-умовою
      ((правильний-список-для-рівності? (як-є ()))
       (за-умовою
         ((правильний-список-для-рівності? (як-є (() (а) б)))
          (за-умовою
            ((хибне?
               (правильний-список-для-рівності?
                 (сполучити (як-є а) (як-є сторонній-хвіст))))
             (за-умовою
               ((правильні-списки-для-рівності?
                  (як-є (() (а б) (а))))
                (за-умовою
                  ((хибне?
                     (правильні-списки-для-рівності?
                       (список
                         (як-є (а))
                         (сполучити (як-є а) (як-є сторонній-хвіст)))))
                   (за-умовою
                     ((хибне?
                        (правильні-списки-для-рівності?
                          (сполучити (як-є (а)) (як-є сторонній-хвіст))))
                      так)
                     (так ні)))
                  (так ні)))
               (так ні)))
            (так ні)))
         (так ні)))
      (так ні))))

(за-умовою
  ((закон-правильних-списків?)
   (за-умовою
     ((списки-рівні-за-порівнянням?
        порівнювати-атоми (як-є ()) (як-є ()))
      (за-умовою
        ((списки-рівні-за-порівнянням?
           порівнювати-атоми доказ-перелік доказ-перелік)
         (за-умовою
           ((хибне? (списки-рівні-за-порівнянням?
                       порівнювати-атоми доказ-перелік доказ-перестановка))
            (за-умовою
              ((хибне? (списки-рівні-за-порівнянням?
                          порівнювати-атоми доказ-перелік (як-є ())))
               (за-умовою
                 ((усі-списки-рівні-за-порівнянням?
                    (функція (ліве праве) (перше (як-є ())))
                    (як-є ()))
                  так)
                 (так ні)))
              (так ні)))
           (так ні)))
        (так ні)))
     (так ні)))
  (так ні))
