; Закон (з бенчмарка map): унарна функція на кожен атом; першокласний виклик.

(визначити перевернути-м
  (функція (залишок накопичувач)
    (за-умовою
      ((атом? залишок) накопичувач)
      (так (перевернути-м (решта залишок)
                         (сполучити (перше залишок) накопичувач))))))

(визначити відобразити
  (функція (операція залишок накопичувач)
    (за-умовою
      ((атом? залишок) накопичувач)
      (так (відобразити операція (решта залишок)
             (сполучити (операція (перше залишок)) накопичувач))))))

(визначити обгорнути
  (функція (значення)
    (сполучити значення (як-є ()))))

(визначити свідок-відобразити
  (функція ()
    (нехай ((вхід (сполучити (як-є а) (сполучити (як-є б) (як-є ()))))
            (вихід (відобразити обгорнути вхід (як-є ())))
            (норм (перевернути-м вихід (як-є ()))))
      (за-умовою
        ((тотожне? (перше (перше норм)) (як-є а))
         (за-умовою
           ((тотожне? (перше (перше (решта норм))) (як-є б))
            (як-є (закон-відобразити (status pass))))
           (так (як-є (закон-відобразити (status fail))))))
        (так (як-є (закон-відобразити (status fail))))))))

(свідок-відобразити)
