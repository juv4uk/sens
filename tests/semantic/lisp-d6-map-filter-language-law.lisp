; Мовні закони D6: відобразити / відсіяти / довжина.
; Очікування й вердикт належать Lisp/SENS, а не Rust/Zig/JSON.
; D7-назви — лише цитовані дані, числових голів та літералів немає.

(визначити залишити-назву
  (функція (назва) назва))
(визначити лише-радіо
  (функція (назва) (тотожне? назва (як-є радіо))))

(за-умовою
  ; Тотожне відображення не змінює порядок елементів.
  ((однакові?
     (відобразити залишити-назву (як-є (радіо антена сигнал)))
     (як-є (радіо антена сигнал)))
   (за-умовою
     ; Відсіювання залишає усі та лише потрібні елементи, у тому ж порядку.
     ((однакові?
        (відсіяти лише-радіо (як-є (антена радіо сигнал радіо)))
        (як-є (радіо радіо)))
      (за-умовою
        ; Без збігів отримуємо структурно порожній список.
        ((порожній? (відсіяти лише-радіо (як-є (антена сигнал))))
         (за-умовою
           ; Відображення зберігає довжину, у тому числі порожню.
           ((однакові?
              (довжина (відобразити залишити-назву
                         (як-є (радіо антена сигнал))))
              (довжина (як-є (радіо антена сигнал))))
            (за-умовою
              ((порожній? (відобразити залишити-назву (як-є ())))
               (за-умовою
                 ; Перестановка не є тотожним відображенням.
                 ((хибне? (однакові?
                             (відобразити залишити-назву
                               (як-є (радіо антена)))
                             (як-є (антена радіо))))
                  так)
                 (так ні)))
              (так ні)))
           (так ні)))
        (так ні)))
     (так ні)))
  (так ні))
