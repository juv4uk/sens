; D9/D10: реальні визначення викликаються у спільній Core4-сесії.
; Кожна позиція — окрема D1-відповідь, щоб помилковий виклик було видно.
(список
  ; D9: форма порожнього світу, журнал, батько та проєкція вмісту.
  (світ? (порожній-світ))
  (однакові? (порожній-світ) (як-є (world () () ())))
  (однакові?
    (світ-журнал (світ-запис (порожній-світ) (як-є подія-а)))
    (список (як-є подія-а)))
  (однакові?
    (світ-батько (світ-запис (порожній-світ) (як-є подія-а)))
    (порожній-світ))
  (однакові?
    (світ-адреса-вміст (порожній-світ))
    (як-є (world-history () ())))
  ; D10: черга, епістемічні конструктори/доступори та останній елемент.
  (черга-порожня? (як-є ()))
  (хибне? (черга-порожня? (список (як-є елемент))))
  (однакові?
    (отримати-джерело-спостереження
      (створити-спостереження (як-є телескоп) (як-є зоря)))
    (як-є телескоп))
  (однакові?
    (отримати-необхідні-можливості-наміру
      (створити-намір (як-є спостереження) (як-є (дозвіл))
                      (як-є стоп) (як-є результат)))
    (як-є (дозвіл)))
  (однакові?
    (останній (список (як-є перший) (як-є останній)))
    (як-є останній)))
