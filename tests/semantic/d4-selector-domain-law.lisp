; Закон мови для трьох селекторів у повній українській проєкції.
; Результат визначає SENS. Хибний селектор навмисно веде до недопустимого доступу.
; Файл не тестує парсер чи кодувальник: це семантичний свідок Lisp.
(за-умовою
  ((однакові?
     (перше-першого
       (список
         (список (як-є внутрішній) (як-є сусід))
         (як-є зовнішній)))
     (як-є внутрішній))
   (за-умовою
     ((однакові?
        (друге
          (список (як-є перший) (як-є ціль) (як-є третій)))
        (як-є ціль))
      (за-умовою
        ((однакові?
           (решта-решти
             (список (як-є перший) (як-є другий) (як-є хвіст)))
           (як-є (хвіст)))
         (атом? (як-є ())))
        (так (перше (як-є ())))))
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))
