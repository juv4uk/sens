; Закон: останній елемент непорожнього списку.

(визначити свідок-останнього
  (функція ()
    (нехай ((с (сполучити (як-є а) (сполучити (як-є б) (як-є ())))))
      (за-умовою
        ((тотожне? (останній с) (як-є б))
         (як-є (закон-останній (status pass))))
        (так (як-є (закон-останній (status fail))))))))

(свідок-останнього)
