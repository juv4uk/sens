; Закон приєднання: хвіст після префікса зберігає останній елемент.

(визначити свідок-приєднати
  (функція ()
    (нехай ((результат
             (приєднати
               (сполучити (як-є а) (як-є ()))
               (сполучити (як-є б) (як-є ())))))
      (за-умовою
        ((тотожне? (перше результат) (як-є а))
         (за-умовою
           ((тотожне? (перше (решта результат)) (як-є б))
            (як-є (закон-приєднати (status pass))))
           (так (як-є (закон-приєднати (status fail))))))
        (так (як-є (закон-приєднати (status fail))))))))

(свідок-приєднати)
