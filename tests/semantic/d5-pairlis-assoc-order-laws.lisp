; Д5:11110 PAIRLIS + Д5:11100 ASSOC + Д5:11101 MEMBER.
; Мовний свідок чинних функцій, не новий доменний примітив.
; Ратифіковані викличні імена з lib/domains/d3.lisp, d4.lisp, d5.lisp.
; Усі умови — саме Д1. Zig відповідає лише за фізичні байти T5M.
;
; Закон: СПАРУВАТИ додає ключі/значення перед старим асоціативним хвостом.
; ЗНАЙТИ-ЗА-КЛЮЧЕМ повертає ПЕРШУ пару з повторним ключем,
; не останню, і не змінює порядок чи значення інших пар.
; ЗНАЧЕННЯ-У-СПИСКУ? перевіряється на позитивному й негативному випадках.
; Передумова: обидва списки в СПАРУВАТИ правильні та однакової довжини.
; Невизначену поведінку різних довжин не легітимізуємо як мовний закон.

(визначити свідок-д5-пошук-після-спарування
  (функція (ключ ключі значення хвіст)
    (знайти-за-ключем ключ (спарувати ключі значення хвіст))))

; Складаємо точні Д1-результати: жодний негатив не має бути замінений
; на структурне (), яке не тотожне Д1:0.
(визначити свідок-д5-всі-умови
  (функція (умови)
    (за-умовою
      ((порожній? умови) так)
      ((перше умови) (свідок-д5-всі-умови (решта умови)))
      (так ні))))

(визначити свідок-д5-старі-пари
  (сполучити
    (сполучити (як-є ключ) (як-є старе))
    (як-є ())))

(визначити свідок-д5-ключі
  (список (як-є ключ) (як-є інший)))

(визначити свідок-д5-значення
  (список (як-є нове) (як-є друге-значення)))

(визначити свідок-д5-всі-пари
  (спарувати
    свідок-д5-ключі
    свідок-д5-значення
    свідок-д5-старі-пари))

; Позитивні й негативні закони виконуються самим SENS.
; Останній результат файлу — Д1:1 тільки коли ВСІ закони істинні.
(свідок-д5-всі-умови
  (список
    ; Перший запис має нове, а не затінене старе значення.
    (тотожне?
      (перше (знайти-за-ключем (як-є ключ) свідок-д5-всі-пари))
      (як-є ключ))
    (тотожне?
      (решта (знайти-за-ключем (як-є ключ) свідок-д5-всі-пари))
      (як-є нове))
    (хибне?
      (тотожне?
        (решта (знайти-за-ключем (як-є ключ) свідок-д5-всі-пари))
        (як-є старе)))
    ; Друга пара лишається на своєму місці.
    (тотожне?
      (перше (перше (решта свідок-д5-всі-пари)))
      (як-є інший))
    (тотожне?
      (решта (знайти-за-ключем (як-є інший) свідок-д5-всі-пари))
      (як-є друге-значення))
    ; Стара пара лишається третьою, без копіювання значень.
    (тотожне?
      (решта (перше (решта (решта свідок-д5-всі-пари))))
      (як-є старе))
    (порожній? (решта (решта (решта свідок-д5-всі-пари))))
    ; Невідомий ключ повинен повернути саме відсутність.
    (порожній?
      (знайти-за-ключем (як-є відсутній) свідок-д5-всі-пари))
    ; Закон порожнього PAIRLIS та збереження початкового хвоста.
    (порожній?
      (спарувати (як-є ()) (як-є ()) (як-є ())))
    (тотожне?
      (решта (перше
        (спарувати (як-є ()) (як-є ()) свідок-д5-старі-пари)))
      (як-є старе))
    ; Перевірка композиції окремим викличним свідком.
    (тотожне?
      (решта (свідок-д5-пошук-після-спарування
        (як-є ключ)
        свідок-д5-ключі
        свідок-д5-значення
        свідок-д5-старі-пари))
      (як-є нове))
    ; MEMBER: позитив на справжній парі, негатив на іншій парі.
    (значення-у-списку?
      (перше свідок-д5-всі-пари)
      свідок-д5-всі-пари)
    (хибне?
      (значення-у-списку?
        (сполучити (як-є ключ) (як-є старе))
        (список (перше свідок-д5-всі-пари))))
    ; Старий хвіст є видимим лише коли нових відповідників немає.
    (порожній?
      (свідок-д5-пошук-після-спарування
        (як-є відсутній)
        свідок-д5-ключі
        свідок-д5-значення
        свідок-д5-старі-пари))))
