; #1968: часткова дія над коренем АТОМ, не генератор усіх біджа.
; Цей закон має точну область: EQ викликається ЛИШЕ після АТОМ? = Д1:1.
; Жодного нового мешканця Д4/Д11, сід8, Д7-функції або хост-семантики.
; Усі позитиви та негативи виконує сам СЕНС; CAR NIL на порушенні.

(визначити уточнити-атом-до-порожнього?
 (функція (значення)
  (за-умовою
   ((атом? значення) (тотожне? значення (як-є ())))
   (так ні))))

; Типізоване уточнення АТОМ -> ПОРОЖНІЙ: позитив тільки на ().
(за-умовою
 ((уточнити-атом-до-порожнього? (як-є ())) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (уточнити-атом-до-порожнього? (як-є атом?))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (уточнити-атом-до-порожнього?
           (сполучити (як-є атом?) (як-є ())))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (уточнити-атом-до-порожнього?
           (список (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (уточнити-атом-до-порожнього?
           (список (список (як-є атом?))))) так)
 (так (перше (як-є ()))))

; Незалежний наявний Д4 ПОРОЖНІЙ? погоджується на цій області.
(за-умовою
 ((порожній? (як-є ())) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (порожній? (як-є атом?))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (порожній? (список (як-є атом?)))) так)
 (так (перше (як-є ()))))

; Контрприклад до хибного правила АТОМ(x) => ПОРОЖНІЙ(x):
; непорожній атом має АТОМ? = так і ПОРОЖНІЙ? = ні.
(за-умовою
 ((атом? (як-є атом?))
  (за-умовою
   ((хибне? (порожній? (як-є атом?))) так)
   (так (перше (як-є ())))))
 (так (перше (як-є ()))))

; Пара конструктора СПОЛУЧИТИ має два незалежні проєктори.
; Для фізичного T5M цитовані текстові мітки — D7 glyph-списки,
; а EQ допускає тільки атоми. Беремо різні ратифіковані D3-слова
; ATOM і CDR як атомні дані, без перетворення D7 списку на атом.
(визначити біджа-пара
 (сполучити (як-є атом?) (як-є решта)))

; Фізичні операнди EQ повинні лишатися саме двома D3-атомами:
; спершу незалежний ATOM-свідок обох проєкторів, потім їх відмінність.
(за-умовою
 ((атом? (перше біджа-пара))
  (за-умовою
   ((атом? (решта біджа-пара)) так)
   (так (перше (як-є ())))))
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (тотожне? (як-є атом?) (як-є решта))) так)
 (так (перше (як-є ()))))

(за-умовою
 ((тотожне? (перше біджа-пара) (як-є атом?))
  (за-умовою
   ((тотожне? (решта біджа-пара) (як-є решта)) так)
   (так (перше (як-є ())))))
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (тотожне? (перше біджа-пара) (як-є решта))) так)
 (так (перше (як-є ()))))

; ЯК-Є захищає вкладений небезпечний виклик як дані; це НЕ доказ
; відновлення QUOTE із селекторів, лише живий семантичний кордон.
(за-умовою
 ((хибне? (атом? (як-є (перше (як-є ()))))) так)
 (так (перше (як-є ()))))

; Підсумок — фактичний біт істини першого домену.
(атом? (як-є ()))
