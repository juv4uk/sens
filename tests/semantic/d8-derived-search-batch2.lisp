; Закони пошуку елемента за предикатом, точної рівності та вилучення останнього.
; Перевіряємо десять позитивних і негативних випадків на правильних списках.

(список
  (однакові? (знайти-елемент-якщо
            (функція (значення) (атом? значення))
            (список (сполучити (як-є а) (як-є б)) (як-є в)))
          (як-є в))
  (порожній? (знайти-елемент-якщо
              (функція (значення) (атом? значення))
              (список (сполучити (як-є а) (як-є б)))))
  (хибне? (однакові? (знайти-елемент-якщо
                  (функція (значення) (атом? значення))
                  (список (сполучити (як-є а) (як-є б)) (як-є в)))
                (сполучити (як-є а) (як-є б))))
  (тотожне-значення? (як-є а) (як-є а))
  (хибне? (тотожне-значення? (як-є а) (як-є б)))
  (однакові? (без-останнього (як-є ())) (як-є ()))
  (однакові? (без-останнього (список (як-є а))) (як-є ()))
  (однакові? (без-останнього (список (як-є а) (як-є б) (як-є в)))
          (список (як-є а) (як-є б)))
  (хибне? (однакові? (без-останнього (список (як-є а) (як-є б)))
                (список (як-є б))))
  (однакові? (без-останнього (список (як-є а) (як-є б)))
          (список (як-є а))))
