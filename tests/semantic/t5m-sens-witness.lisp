; T5M (3 байти) — SENS-самосвідок. Точні D24-слова, жодних десяткових голів.
; Перевіряє НАШІ SENS-функції (т5м-у-байти, т5м-з-байтів) — не Python-модель.
; Вектори збігаються з scripts/sens_t5_codec.py (5-тріт) і 3-байтовою моделлю.
(list
  ; т5-накопичити: 0*3+1 = 1
  (equal? (т5-накопичити #d24:000000000000000000000000 #d24:000000000000000000000001)
          #d24:000000000000000000000001)
  ; т5-трійкове([1,0,1]) зліва-направо = 1*9+0*3+1 = 10
  (equal? (т5-трійкове (list #d24:000000000000000000000001
                             #d24:000000000000000000000000
                             #d24:000000000000000000000001))
          #d24:000000000000000000001010)
  ; т5-трійкове([1,0,1,1]) = 1*27+0*9+1*3+1 = 31
  (equal? (т5-трійкове (list #d24:000000000000000000000001
                             #d24:000000000000000000000000
                             #d24:000000000000000000000001
                             #d24:000000000000000000000001))
          #d24:000000000000000000011111)
  ; т5м-три-байти(161) = [161,0,0]
  (equal? (т5м-три-байти #d24:000000000000000010100001)
          (list #d24:000000000000000010100001
                #d24:000000000000000000000000
                #d24:000000000000000000000000))
  ; нсд-списку([12,18]) = 6
  (equal? (нсд-списку (list #d24:000000000000000000001100 #d24:000000000000000000010010))
          #d24:000000000000000000000110)
  ; нсд-трьох(12,18,24) = 6
  (equal? (нсд-трьох #d24:000000000000000000001100 #d24:000000000000000000010010 #d24:000000000000000000011000)
          #d24:000000000000000000000110)
  ; негативний фальсифікатор: нсд([12,18]) ≠ 7
  (not? (equal? (нсд-списку (list #d24:000000000000000000001100 #d24:000000000000000000010010))
                #d24:000000000000000000000111)))
