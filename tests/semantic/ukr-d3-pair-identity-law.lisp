; Виконуваний закон Д3: сполучити/перше/решта/тотожне?/атом?.
; Тільки чинні українські голови з ратифікованої драбини доменів.
; Успіх — точний Д1:так. Кожний хибний закон веде до невикличного (ні).
; Цей вердикт визначає SENS, а не Rust, Zig, Python чи оболонка.

(за-умовою
  ((тотожне? (перше (сполучити (як-є радіо) (як-є (антена))))
             (як-є радіо))
   (за-умовою
     ((тотожне? (перше (решта (сполучити (як-є радіо) (як-є (антена)))))
                (як-є антена))
      (за-умовою
        ((хибне? (атом? (сполучити (як-є радіо) (як-є ()))))
         (атом? (як-є ())))
        (так (ні))))
     (так (ні))))
  (так (ні)))
