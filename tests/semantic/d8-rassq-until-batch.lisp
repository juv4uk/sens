; D8:11011100 RASSQ — D3 EQ над CDR, не над ключем.
; D8:11011101 UNTIL — дуальність D6 WHILE під D4 NOT.
; 8 точних відповідей D1:YES; негативні значення мають лишатися NO.
(список
  (equal?
    (асоціація-решта (quote значення-б)
      (список (сполучити (quote ключ-а) (quote значення-а))
            (сполучити (quote ключ-б) (quote значення-б))))
    (сполучити (quote ключ-б) (quote значення-б)))
  (порожній? (асоціація-решта (quote ключ-б)
           (список (сполучити (quote ключ-б) (quote значення-б)))))
  (порожній? (асоціація-решта (quote значення-а) (quote ())))
  (equal?
    (асоціація-решта (quote значення-а)
      (список (сполучити (quote ключ-а) (quote значення-а))
            (сполучити (quote ключ-б) (quote значення-б))))
    (сполучити (quote ключ-а) (quote значення-а)))
  (equal?
    (поки-не
      (lambda (s) (порожній? (решта s)))
      (lambda (s) (решта s))
      (список (quote а) (quote б) (quote в)))
    (список (quote в)))
  (equal?
    (поки-не (lambda (s) (порожній? s))
             (lambda (s) (решта s))
             (quote ()))
    (quote ()))
  (equal?
    (поки-не (lambda (s) (порожній? s))
             (lambda (s) (решта s))
             (список (quote а) (quote б)))
    (quote ()))
  (хибне? (equal?
    (поки-не
      (lambda (s) (порожній? (решта s)))
      (lambda (s) (решта s))
      (список (quote а) (quote б) (quote в)))
    (список (quote а) (quote б) (quote в)))))

