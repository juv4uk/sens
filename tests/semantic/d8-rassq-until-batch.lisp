; Одинадцять законів пошуку асоціації за значенням та циклу до виконання умови.
; Запит і хвіст мають бути атомними до D3 EQ; пара не породжує EQ-помилку.
; Пара як шукане значення не викликає атомне порівняння.
; Після remint Core4 має бути перебудований, щоб цей свідок читав новий вбудований носій.
; Порівняння асоціацій виконується за хвостом пари, а не за ключем.
; Перевірено позитивні випадки та заперечення хибної рівності.
(список
  ; Після пропуску парного cdr знайдено атомні ключ і значення.
  (тотожне? (перше (знайти-асоціацію-за-рештою (як-є б)
    (список
      (сполучити (як-є ґ) (сполучити (як-є б) (як-є ())))
      (сполучити (як-є а) (як-є в))
      (сполучити (як-є г) (як-є б))))) (як-є г))
  (тотожне? (решта (знайти-асоціацію-за-рештою (як-є б)
    (список
      (сполучити (як-є ґ) (сполучити (як-є б) (як-є ())))
      (сполучити (як-є а) (як-є в))
      (сполучити (як-є г) (як-є б))))) (як-є б))
  ; Парний cdr пропускається, а відсутній атомний збіг дає порожній результат.
  (порожній? (знайти-асоціацію-за-рештою (як-є а)
    (список
      (сполучити (як-є ґ) (сполучити (як-є б) (як-є ())))
      (сполучити (як-є в) (як-є г)))))
  (порожній? (знайти-асоціацію-за-рештою (як-є значення-а) (як-є ())))
  ; Пара як шукане значення не передається до атомного D3 EQ.
  (порожній? (знайти-асоціацію-за-рештою
    (сполучити (як-є б) (як-є ()))
    (список (сполучити (як-є г) (як-є б)))))
  ; За двох атомних збігів повертається перший запис.
  (тотожне? (перше (знайти-асоціацію-за-рештою (як-є б)
    (список (сполучити (як-є а) (як-є б))
            (сполучити (як-є г) (як-є б))))) (як-є а))
  (тотожне? (решта (знайти-асоціацію-за-рештою (як-є б)
    (список (сполучити (як-є а) (як-є б))
            (сполучити (як-є г) (як-є б))))) (як-є б))
  (однакові?
    (поки-не
      (функція (залишок) (порожній? (решта залишок)))
      (функція (залишок) (решта залишок))
      (список (як-є а) (як-є б) (як-є в)))
    (список (як-є в)))
  (однакові?
    (поки-не (функція (залишок) (порожній? залишок))
             (функція (залишок) (решта залишок))
             (як-є ()))
    (як-є ()))
  (однакові?
    (поки-не (функція (залишок) (порожній? залишок))
             (функція (залишок) (решта залишок))
             (список (як-є а) (як-є б)))
    (як-є ()))
  (хибне? (однакові?
    (поки-не
      (функція (залишок) (порожній? (решта залишок)))
      (функція (залишок) (решта залишок))
      (список (як-є а) (як-є б) (як-є в)))
    (список (як-є а) (як-є б) (як-є в)))))
