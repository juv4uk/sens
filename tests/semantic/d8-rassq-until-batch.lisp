; Вісім законів пошуку асоціації за значенням та циклу до виконання умови.
; Порівняння асоціацій виконується за хвостом пари, а не за ключем.
; Перевірено позитивні випадки та заперечення хибної рівності.
(список
  (однакові?
    (знайти-асоціацію-за-рештою (як-є значення-б)
      (список (сполучити (як-є ключ-структурний) (як-є (значення-б)))
            (сполучити (як-є ключ-а) (як-є значення-а))
            (сполучити (як-є ключ-б) (як-є значення-б))))
    (сполучити (як-є ключ-б) (як-є значення-б)))
  (порожній? (знайти-асоціацію-за-рештою (як-є значення-б)
           (список (сполучити (як-є ключ-структурний) (як-є (значення-б))))))
  (порожній? (знайти-асоціацію-за-рештою (як-є значення-а) (як-є ())))
  (однакові?
    (знайти-асоціацію-за-рештою (як-є значення-а)
      (список (сполучити (як-є ключ-а) (як-є значення-а))
            (сполучити (як-є ключ-б) (як-є значення-б))))
    (сполучити (як-є ключ-а) (як-є значення-а)))
  (однакові?
    (поки-не
      (функція (залишок) (порожній? (решта залишок)))
      (функція (залишок) (решта залишок))
      (список (як-є а) (як-є б) (як-є в)))
    (список (як-є в)))
  (однакові?
    (поки-не (функція (залишок) (порожній? залишок))
             (функція (залишок) (решта залишок))
             (як-є ()))
    (як-є ()))
  (однакові?
    (поки-не (функція (залишок) (порожній? залишок))
             (функція (залишок) (решта залишок))
             (список (як-є а) (як-є б)))
    (як-є ()))
  (хибне? (однакові?
    (поки-не
      (функція (залишок) (порожній? (решта залишок)))
      (функція (залишок) (решта залишок))
      (список (як-є а) (як-є б) (як-є в)))
    (список (як-є а) (як-є б) (як-є в)))))
