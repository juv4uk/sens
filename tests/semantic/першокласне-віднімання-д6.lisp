; Позитивна семантика першокласного доменного коду доводиться самою мовою.
; Кожний невірний результат викликає помилку нативного СЕНС, а не Python/JSON.
; Д7 — лише українська поверхня, математика — Д24+.
(визначити виконати-одномісну-доменну
  (функція (операція значення)
    (операція значення)))
(визначити довести-точне-віднімання-д6
  (функція (результат)
    (за-умовою
      ((менше? 40 результат)
       (за-умовою
         ((менше? результат 42) результат)
         (так (перше (як-є ())))))
      (так (перше (як-є ()))))))
; 42 - 1 = 41: Д6:001111 ВІДНЯТИ-1 викликається як передане значення.
(довести-точне-віднімання-д6
  (виконати-одномісну-доменну відняти-1 42))
