; Мовний SENS-свідок українського REPL: стан зберігає D1:YES
; між двома верхніми формами. Не запускайте без завантаження
; lib/meta-eval.lisp і lib/repl-core.lisp у цьому порядку.
; Сам SENS вибирає D1:YES або навмисний невикличний D1:NO.


; Хибні керівні форми REPL відхиляє сам SENS, без host-eval.
(визначити репл-хибна-команда-відхилена?
  (функція (форма)
    (тотожне?
      (перше
        (решта
          (репл-крок-поверхні
            форма
            (репл-почати (як-є ()))
            (як-є ук)
            (як-є ()))))
      (як-є неправильна-команда-репл))))

; Перемикання шести ратифікованих поверхонь — саме Lisp-стан,
; не зміна доменних бітів і не реєстр у Zig/Rust.
(визначити репл-усі-мови-закон?
  (функція (назви)
    (за-умовою
      ((атом? назви) (тотожне? назви (як-є ())))
      (так
       ((функція (перехід)
          (за-умовою
            ((тотожне?
               (решта (перше перехід))
               (перше назви))
             (репл-усі-мови-закон? (решта назви)))
            (так ні)))
        (репл-перехід-поверхні
          (сполучити
            (як-є репл-мова)
            (сполучити (перше назви) (як-є ())))
          (репл-почати (як-є ()))
          (як-є ук)
          (як-є ())))))))

(за-умовою
  ((репл-усі-мови-закон? (як-є (ук укр san en LISP sym)))
   (за-умовою
     ((репл-хибна-команда-відхилена? (як-є (репл-код д4)))
      (за-умовою
        ((репл-хибна-команда-відхилена? (як-є (репл-слово д10)))
         (за-умовою
           ((репл-хибна-команда-відхилена? (як-є (репл-проєкція д3 як-є)))
            (за-умовою
              ((репл-хибна-команда-відхилена? (як-є (репл-мова ук укр)))
               (за-умовою
                 ((репл-хибна-команда-відхилена? (як-є (репл-завершити зайве)))
                  (за-умовою
                    ((репл-команда-коду? (як-є (репл-код д4 функція)))
                     (за-умовою
                       ((тотожне?
                          (решта
                            (репл-виконати
                              (як-є
                                ((визначити відповідь так)
                                 відповідь))
                              (репл-почати (як-є ()))))
                          ні)
                        (за-умовою
                          ((тотожне?
                             (решта (репл-почати (як-є ())))
                             (як-є ()))
                           так)
                          (так (ні))))
                       (так (ні))))
                    (так (ні))))
                 (так (ні))))
              (так (ні))))
           (так (ні))))
        (так (ні))))
     (так (ні))))
  (так (ні)))
