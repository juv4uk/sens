; M3 · медіана / впорядкування · самокалібрування.
; SENS_SOURCE=tests/semantic/бенчмарк-медіана-law.lisp
; NATIVE_SENS_POSITIVE=NOT_VERIFIED
; NATIVE_SENS_NEGATIVE=NOT_VERIFIED
;
; Структурні «числа»: () = 0, (так) = 1, (так так) = 2, ...
; Медіана відомих наборів перевіряється тотожністю.
; Жодних SID8, сирих цифр, Python/JS.

(визначити рівне?
  (функція (а б)
    (тотожне? а б)))

(визначити бенч-довжина
  (функція (список)
    (за-умовою
      ((порожній? список) (як-є ()))
      (так (сполучити так (бенч-довжина (решта список)))))))

(визначити коротший?
  (функція (а б)
    (за-умовою
      ((порожній? а)
       (за-умовою
         ((порожній? б) ні)
         (так так)))
      (так
        (за-умовою
          ((порожній? б) ні)
          (так (коротший? (решта а) (решта б))))))))

(визначити вставити-впорядковано
  (функція (значення впорядкований)
    (за-умовою
      ((порожній? впорядкований) (сполучити значення (як-є ())))
      (так
        (за-умовою
          ((коротший? значення (перше впорядкований))
           (сполучити значення впорядкований))
          (так
            (сполучити
              (перше впорядкований)
              (вставити-впорядковано значення (решта впорядкований)))))))))

(визначити впорядкувати-виміри
  (функція (виміри)
    (за-умовою
      ((порожній? виміри) (як-є ()))
      (так
        (вставити-впорядковано
          (перше виміри)
          (впорядкувати-виміри (решта виміри)))))))

(визначити відкинути
  (функція (скільки список)
    (за-умовою
      ((порожній? скільки) список)
      (так
        (за-умовою
          ((порожній? список) (як-є ()))
          (так (відкинути (решта скільки) (решта список))))))))

(визначити половина-індекс
  (функція (розмір)
    (за-умовою
      ((порожній? розмір) (як-є ()))
      (так
        (за-умовою
          ((порожній? (решта розмір)) (як-є ()))
          (так (сполучити так (половина-індекс (решта (решта розмір))))))))))

(визначити середина-списку
  (функція (впорядкований)
    (за-умовою
      ((порожній? впорядкований) (як-є ()))
      (так
        (перше
          (відкинути
            (половина-індекс (бенч-довжина впорядкований))
            впорядкований))))))

(визначити медіана
  (функція (виміри)
    (середина-списку (впорядкувати-виміри виміри))))

(визначити н0 (як-є ()))
(визначити н1 (сполучити так (як-є ())))
(визначити н2 (сполучити так (сполучити так (як-є ()))))
(визначити н3 (сполучити так (сполучити так (сполучити так (як-є ())))))

; 1. коротший? н1 н2 → так
; 2. коротший? н2 н1 → ні
; 3. впорядкувати (н2 н0 н1) → перший = н0
; 4. медіана (н0 н1 н2) → н1
; 5. медіана (н2 н0 н1) → н1
; 6. медіана (н1) → н1

; M3 negative witness: a false median claim must return D1:ні.
(рівне? (медіана (сполучити н0 (сполучити н1 (сполучити н2 (як-є ()))))) н2)
