; Д5: DEFINE зберігає лексичне замикання між окремими формами.
; Виклик під однойменним локальним параметром не змінює захопленого NIL.
; Семантичний висновок формує тільки Lisp/SENS після Zig/T5M.
(визначити створити-лексичний-свідок
  (функція (захоплене)
    (функція (передане) (атом? захоплене))))
(визначити збережений-свідок
  (створити-лексичний-свідок (як-є ())))
((функція (захоплене)
   (збережений-свідок (сполучити (як-є ()) (як-є ()))))
 (сполучити (як-є ()) (як-є ())))
