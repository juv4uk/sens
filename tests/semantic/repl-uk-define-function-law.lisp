; Закон мовного визначення функції через читач та обчислювач СЕНС.
; Функція отримує один аргумент і повертає його як значення.
; Успіх визначається точною тотожністю цитованого атома.
; Помилку читання або обчислення не маскуємо новим значенням.
((функція (одержано)
   (за-умовою
     ((атом? одержано)
      (за-умовою
        ((тотожне? (тотожне? одержано (як-є мітка)) так) так)
        (так (ні))))
     (так одержано)))
 (решта
   (репл-крок
     (прочитати "(перевірити (як-є мітка))")
     (репл-визначити-функцію
       (як-є перевірити)
       (прочитати "(значення)")
       (прочитати "значення")
       (репл-почати (як-є ()))))))
