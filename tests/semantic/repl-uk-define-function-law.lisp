; D4:0010 ФУНКЦІЯ та D4:0011 ВИЗНАЧИТИ складаються самою SENS.
; Лише D3 коди викликів, цитовані поверхні залишаються даними,
; без переведення D4-кодів у десятковий формат або нового host parser.
; SENS сама створює визначення значення та визначення функції.
((0010 (після-значення)
   ((0010 (після-функції)
      (110
        ((101
           (011 (репл-крок (001 (перевірити)) після-функції))
           #d1:1)
         (110
           ((101
              (011 (репл-крок (001 назване-значення) після-функції))
              #d1:1)
            #d1:1)
           (#d1:1 (#d1:0))))
        (#d1:1 (#d1:0))))
    (репл-визначити-функцію
      (001 перевірити)
      (001 ())
      (001 (атом? (як-є ())))
      після-значення)))
 (репл-визначити
   (001 назване-значення)
   (001 #d1:1)
   (репл-почати (001 ()))))
