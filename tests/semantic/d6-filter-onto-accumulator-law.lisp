; Д6:101011 FILTER-ONTO · SENS закон для непорожнього акумулятора.
; Початковий накопичувач зберігається в ОБЕРНЕНОМУ порядку.
; Фільтр зберігає порядок і кратність вибраних елементів.
; Порожній ввід не повинен обчислювати тіло предиката.

(за-умовою
  ((хибне?
     (однакові?
       (відсіяти-до
         (функція (елемент) (тотожне? елемент (як-є а)))
         (список (як-є а) (як-є б) (як-є а))
         (список (як-є лівий) (як-є правий)))
       (список (як-є правий) (як-є лівий) (як-є а) (як-є а))))
   ні)
  ((хибне?
     (однакові?
       (відсіяти-до
         (функція (елемент) (перше елемент))
         (як-є ())
         (список (як-є лівий) (як-є правий)))
       (список (як-є правий) (як-є лівий))))
   ні)
  (так так))
