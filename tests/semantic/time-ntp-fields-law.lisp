; Закон мови: тлумачення полів NTP і сирих даних часу належить SENS, не хосту.
; Результат визначає сам SENS; хибна гілка веде до невикликного виразу.
(за-умовою
  ((однакові? (тлумачити-поля-відповіді-часу "clock.example" 4 1 2208988800 1073741824) (як-є (accepted "clock.example" 0 250000000)))
  (за-умовою
    ((однакові? (тлумачити-поля-відповіді-часу "clock.example" 5 15 2208988801 2147483648) (як-є (accepted "clock.example" 1 500000000)))
    (за-умовою
      ((однакові? (тлумачити-поля-відповіді-часу "clock.example" 4 1 2208988801 4294967295) (як-є (accepted "clock.example" 1 999999999)))
      (за-умовою
        ((однакові? (тлумачити-поля-відповіді-часу "clock.example" 3 1 2208988800 0) (як-є (rejected invalid-response)))
        (за-умовою
          ((однакові? (тлумачити-поля-відповіді-часу "clock.example" 4 0 2208988800 0) (як-є (rejected invalid-response)))
          (за-умовою
            ((однакові? (тлумачити-поля-відповіді-часу "clock.example" 4 1 2208988799 0) (як-є (rejected invalid-epoch)))
            (за-умовою
              ((однакові? (перетворити-сирі-дані-часу-на-спостереження (список (як-є ntp-fields) "clock.example" 4 1 2208988801 2147483648)) (як-є (accepted "clock.example" 1 500000000)))
              (за-умовою
                ((однакові? (перетворити-сирі-дані-часу-на-спостереження (список (як-є ntp-fields) "clock.example" 3 1 2208988800 0)) (як-є (rejected invalid-response)))
                (за-умовою
                  ((однакові? (перетворити-сирі-дані-часу-на-спостереження (як-є (rejected receive-failed))) (як-є (rejected receive-failed)))
                  (як-є (time-ntp-fields-law (status pass) (projection ukr))))
                  (так (перше (як-є ())))))
                (так (перше (як-є ())))))
              (так (перше (як-є ())))))
            (так (перше (як-є ())))))
          (так (перше (як-є ())))))
        (так (перше (як-є ())))))
      (так (перше (як-є ())))))
    (так (перше (як-є ())))))
  (так (перше (як-є ()))))
