; Д11 LIST-INDEX: шість самодостатніх SENS-законів.
; Прапорець наявності Д1, індекс Д24+ — не одне і те саме.

; Перший елемент: нульовий індекс є наявним збігом.
(визначити індекс-перша-позиція
  (знайти-індекс-із-наявністю
    хибне? (список ні так)))
(за-умовою
  ((перше індекс-перша-позиція)
   (за-умовою
     ((нуль? (друге індекс-перша-позиція)) так)
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))

; Пізніший збіг: два кроки точного числового накопичувача.
(визначити індекс-третя-позиція
  (знайти-індекс-із-наявністю
    хибне? (список так так ні так)))
(за-умовою
  ((перше індекс-третя-позиція)
   (за-умовою
     ((нуль? (відняти (друге індекс-третя-позиція) число-два))
      так)
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))

; Жодного збігу: не переплутати з наявним індексом нуль.
(за-умовою
  ((однакові?
     (знайти-індекс-із-наявністю
       хибне? (список так так))
     (список ні (як-є ()))) так)
  (так (перше (як-є ()))))

; Порожній список: callback, який впав би, не викликається.
(за-умовою
  ((однакові?
     (знайти-індекс-із-наявністю
       (функція (значення) (решта (як-є ())))
       (як-є ()))
     (список ні (як-є ()))) так)
  (так (перше (як-є ()))))

; Два списки: порівнюємо синхронно, перший збіг у другій парі.
(визначити індекс-збігу-пари
  (знайти-індекс-пари-із-наявністю
    (функція (лівий правий)
      (за-умовою
        ((тотожне? лівий ні) (тотожне? правий так))
        (так ні)))
    (список так ні так)
    (список ні так)))
(за-умовою
  ((перше індекс-збігу-пари)
   (за-умовою
     ((нуль? (відняти (друге індекс-збігу-пари) число-один))
      так)
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))

; Порожній лівий: правий правильний, callback не виконується.
(за-умовою
  ((однакові?
     (знайти-індекс-пари-із-наявністю
       (функція (лівий правий) (решта (як-є ())))
       (як-є ())
       (список ні так))
     (список ні (як-є ()))) так)
  (так (перше (як-є ()))))

; D1:ні — дані першого елемента, не кінець D3 списку.
; Пошук вкладеного D3:() на другій позиції має дати D24 один.
(за-умовою
  ((нуль?
     (відняти
       (друге
         (знайти-індекс-із-наявністю
           порожній? (список ні (як-є ()))))
       число-один))
   так)
  (так (перше (як-є ()))))

; Вкладене D3:() у першій позиції — елемент, не кінець
; зовнішнього списку; присутній D24 індекс нуль.
(за-умовою
  ((нуль?
     (друге
       (знайти-індекс-із-наявністю
         порожній? (список (як-є ()) ні))))
   так)
  (так (перше (як-є ()))))
