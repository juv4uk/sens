; Мовні закони SPAN/BREAK SRFI-1 українською проєкцією Lisp/SENS.
; Усі дані — D1 PredicateBit та структурні D3/D4 списки, не багатогліфові D7.
; Перевіряємо точну поведінку префікса/суфікса і коротке замикання предиката.
; Позитивна й негативна семантика визначаються Lisp/SENS, Zig/T5M лише переносить.

(визначити спан-правда (атом? (як-є ())))
(визначити спан-хиба (хибне? спан-правда))
(визначити спан-дані (сполучити спан-правда (сполучити спан-хиба (сполучити спан-правда (як-є ())))))
(визначити спан-вкладена-зупинка (сполучити спан-хиба (як-є ())))

; Кожен закон зобов'язаний бути D1:YES; інакше виникає конкретна помилка CAR.
(визначити довести-спан-закон
  (функція (закон)
    (за-умовою
      ((хибне? закон) (перше (як-є ())))
      ((порожній? (як-є ())) спан-правда))))

; Предикат приймає лише D1-біти. Якщо він отримає вкладений список, хибне? відхилить тип.
(визначити спан-бітова-умова
  (функція (значення)
    (за-умовою
      ((хибне? значення) спан-хиба)
      ((порожній? (як-є ())) спан-правда))))
(визначити спан-завжди-так (функція (значення) спан-правда))
(визначити спан-завжди-ні (функція (значення) спан-хиба))

; 1–2. Порожній вхід дає порожні префікс і суфікс.
(довести-спан-закон
  (порожній? (перше
    (розділити-поки-умова спан-завжди-так (як-є ())))))
(довести-спан-закон
  (порожній? (решта
    (розділити-поки-умова спан-завжди-так (як-є ())))))

; 3–5. Безумовний YES зберігає всі три елементи і порядок.
(довести-спан-закон
  (перше (перше (розділити-поки-умова спан-завжди-так спан-дані))))
(довести-спан-закон
  (хибне? (порожній? (решта
    (перше (розділити-поки-умова спан-завжди-так спан-дані))))))
(довести-спан-закон
  (порожній? (решта (решта (решта
    (перше (розділити-поки-умова спан-завжди-так спан-дані)))))))

; 6–9. Предикат-біт зупиняється перед першим NO; префікс і суфікс точні.
(довести-спан-закон
  (хибне? (порожній? (решта
    (розділити-поки-умова спан-бітова-умова спан-дані)))))
(довести-спан-закон
  (хибне? (перше (решта
    (розділити-поки-умова спан-бітова-умова спан-дані)))))
(довести-спан-закон
  (перше (решта (решта
    (розділити-поки-умова спан-бітова-умова спан-дані)))))
(довести-спан-закон
  (порожній? (решта (решта (решта
    (розділити-поки-умова спан-бітова-умова спан-дані))))))

; 10–12. Без збігів префікс порожній, суфікс зберігає весь вхід.
(довести-спан-закон
  (порожній? (перше
    (розділити-поки-умова спан-завжди-ні спан-дані))))
(довести-спан-закон
  (перше (решта
    (розділити-поки-умова спан-завжди-ні спан-дані))))
(довести-спан-закон
  (порожній? (решта (решта (решта (решта
    (розділити-поки-умова спан-завжди-ні спан-дані)))))))

; 13–15. Вкладений список — звичайні структурні дані; його біт не порівнюється через D3 EQ.
(довести-спан-закон
  (перше (перше
    (розділити-поки-умова спан-завжди-так
      (сполучити спан-правда (сполучити спан-вкладена-зупинка (сполучити спан-правда (як-є ()))))))))
(довести-спан-закон
  (хибне? (порожній? (перше (решта (перше
    (розділити-поки-умова спан-завжди-так
      (сполучити спан-правда (сполучити спан-вкладена-зупинка (сполучити спан-правда (як-є ())))))))))))
(довести-спан-закон
  (хибне? (перше (перше (решта (перше
    (розділити-поки-умова спан-завжди-так
      (сполучити спан-правда (сполучити спан-вкладена-зупинка (сполучити спан-правда (як-є ())))))))))))

; 16–17. BREAK на порожньому вході повертає порожні префікс і суфікс.
(довести-спан-закон
  (порожній? (перше
    (розділити-перед-умовою спан-бітова-умова (як-є ())))))
(довести-спан-закон
  (порожній? (решта
    (розділити-перед-умовою спан-бітова-умова (як-є ())))))

; 18. BREAK проходить NO і зупиняється перед YES.
(довести-спан-закон
  (хибне? (перше (перше
    (розділити-перед-умовою спан-бітова-умова
      (сполучити спан-хиба (сполучити спан-правда (сполучити спан-хиба (як-є ())))))))))
(довести-спан-закон
  (перше (решта
    (розділити-перед-умовою спан-бітова-умова
      (сполучити спан-хиба (сполучити спан-правда (сполучити спан-хиба (як-є ()))))))))

; 19. SPAN не викликає предикат для елементів після першого NO.
(довести-спан-закон
  (хибне? (перше (решта
    (розділити-поки-умова спан-бітова-умова
      (сполучити спан-правда (сполучити спан-хиба (сполучити (сполучити спан-хиба (як-є ())) (як-є ())))))))))
(довести-спан-закон
  (хибне? (порожній? (перше (решта (решта
    (розділити-поки-умова спан-бітова-умова
      (сполучити спан-правда (сполучити спан-хиба (сполучити (сполучити спан-хиба (як-є ())) (як-є ())))))))))))

; 20. BREAK не викликає предикат для елементів після першого YES.
(довести-спан-закон
  (перше (решта
    (розділити-перед-умовою спан-бітова-умова
      (сполучити спан-хиба (сполучити спан-правда (сполучити (сполучити спан-хиба (як-є ())) (як-є ()))))))))
(довести-спан-закон
  (хибне? (порожній? (перше (решта (решта
    (розділити-перед-умовою спан-бітова-умова
      (сполучити спан-хиба (сполучити спан-правда (сполучити (сполучити спан-хиба (як-є ())) (як-є ())))))))))))

; Точний завершальний D1:YES після виконання всіх законів.
(атом? (як-є ()))
