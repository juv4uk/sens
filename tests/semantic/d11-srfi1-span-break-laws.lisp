; Мовні закони SPAN/BREAK SRFI-1 українською проєкцією Lisp/SENS.
; Усі дані — D1 PredicateBit та структурні D3/D4 списки, не багатогліфові D7.
; Перевіряємо точну поведінку префікса/суфікса і коротке замикання предиката.
; Позитивна й негативна семантика визначаються Lisp/SENS, Zig/T5M лише переносить.

(визначити спан-правда (атом? (як-є ())))
(визначити спан-хиба (хибне? спан-правда))
(визначити спан-дані (сполучити спан-правда (сполучити спан-хиба (сполучити спан-правда (як-є ())))))
(визначити спан-вкладена-зупинка (сполучити спан-хиба (як-є ())))

; Кожен закон зобов'язаний бути D1:YES; інакше виникає конкретна помилка CAR.
(визначити довести-спан-закон
  (функція (закон)
    (за-умовою
      ((хибне? закон) (перше (як-є ())))
      ((порожній? (як-є ())) спан-правда))))

; Предикат приймає лише D1-біти. Якщо він отримає вкладений список, хибне? відхилить тип.
(визначити спан-бітова-умова
  (функція (значення)
    (за-умовою
      ((хибне? значення) спан-хиба)
      ((порожній? (як-є ())) спан-правда))))
(визначити спан-завжди-так (функція (значення) спан-правда))
(визначити спан-завжди-ні (функція (значення) спан-хиба))

; 1–2. Порожній вхід дає порожні префікс і суфікс.
(довести-спан-закон
  (порожній? (перше
    (розділити-поки-умова спан-завжди-так (як-є ())))))
(довести-спан-закон
  (порожній? (решта
    (розділити-поки-умова спан-завжди-так (як-є ())))))

; 3–5. Безумовний YES зберігає всі три елементи і порядок.
(довести-спан-закон
  (перше (перше (розділити-поки-умова спан-завжди-так спан-дані))))
(довести-спан-закон
  (хибне? (порожній? (решта
    (перше (розділити-поки-умова спан-завжди-так спан-дані))))))
(довести-спан-закон
  (порожній? (решта (решта (решта
    (перше (розділити-поки-умова спан-завжди-так спан-дані)))))))

; 6–9. Предикат-біт зупиняється перед першим NO; префікс і суфікс точні.
(довести-спан-закон
  (хибне? (порожній? (решта
    (розділити-поки-умова спан-бітова-умова спан-дані)))))
(довести-спан-закон
  (хибне? (перше (решта
    (розділити-поки-умова спан-бітова-умова спан-дані)))))
(довести-спан-закон
  (перше (решта (решта
    (розділити-поки-умова спан-бітова-умова спан-дані)))))
(довести-спан-закон
  (порожній? (решта (решта (решта
    (розділити-поки-умова спан-бітова-умова спан-дані))))))

; 10–12. Без збігів префікс порожній, суфікс зберігає весь вхід.
(довести-спан-закон
  (порожній? (перше
    (розділити-поки-умова спан-завжди-ні спан-дані))))
(довести-спан-закон
  (перше (решта
    (розділити-поки-умова спан-завжди-ні спан-дані))))
(довести-спан-закон
  (порожній? (решта (решта (решта (решта
    (розділити-поки-умова спан-завжди-ні спан-дані)))))))

; 13–16. ATOM зупиняє SPAN перед вкладеною парою та зберігає її суфікс.
(визначити спан-атомна-умова
  (функція (значення) (атом? значення)))
(визначити спан-вкладені-дані
  (сполучити спан-правда
    (сполучити спан-вкладена-зупинка
      (сполучити спан-правда (як-є ())))))
(довести-спан-закон
  (атом? (перше (перше
    (розділити-поки-умова спан-атомна-умова спан-вкладені-дані)))))
(довести-спан-закон
  (порожній? (решта (перше
    (розділити-поки-умова спан-атомна-умова спан-вкладені-дані)))))
(довести-спан-закон
  (хибне? (атом? (перше (решта
    (розділити-поки-умова спан-атомна-умова спан-вкладені-дані))))))
(довести-спан-закон
  (атом? (перше (решта (решта
    (розділити-поки-умова спан-атомна-умова спан-вкладені-дані))))))

; 16–17. BREAK на порожньому вході повертає порожні префікс і суфікс.
(довести-спан-закон
  (порожній? (перше
    (розділити-перед-умовою спан-бітова-умова (як-є ())))))
(довести-спан-закон
  (порожній? (решта
    (розділити-перед-умовою спан-бітова-умова (як-є ())))))

; 18. BREAK проходить NO і зупиняється перед YES.
(довести-спан-закон
  (хибне? (перше (перше
    (розділити-перед-умовою спан-бітова-умова
      (сполучити спан-хиба (сполучити спан-правда (сполучити спан-хиба (як-є ())))))))))
(довести-спан-закон
  (перше (решта
    (розділити-перед-умовою спан-бітова-умова
      (сполучити спан-хиба (сполучити спан-правда (сполучити спан-хиба (як-є ()))))))))

; 19. SPAN не викликає предикат для елементів після першого NO.
(довести-спан-закон
  (хибне? (перше (решта
    (розділити-поки-умова спан-бітова-умова
      (сполучити спан-правда (сполучити спан-хиба (сполучити (сполучити спан-хиба (як-є ())) (як-є ())))))))))
(довести-спан-закон
  (хибне? (порожній? (перше (решта (решта
    (розділити-поки-умова спан-бітова-умова
      (сполучити спан-правда (сполучити спан-хиба (сполучити (сполучити спан-хиба (як-є ())) (як-є ())))))))))))

; 20. BREAK не викликає предикат для елементів після першого YES.
(довести-спан-закон
  (перше (решта
    (розділити-перед-умовою спан-бітова-умова
      (сполучити спан-хиба (сполучити спан-правда (сполучити (сполучити спан-хиба (як-є ())) (як-є ()))))))))
(довести-спан-закон
  (хибне? (порожній? (перше (решта (решта
    (розділити-перед-умовою спан-бітова-умова
      (сполучити спан-хиба (сполучити спан-правда (сполучити (сполучити спан-хиба (як-є ())) (як-є ())))))))))))

; 21. BREAK залишає вкладену пару в префіксі й зупиняється перед наступним атомом.
(довести-спан-закон
  (хибне? (атом? (перше (перше
    (розділити-перед-умовою спан-атомна-умова
      (сполучити спан-вкладена-зупинка
        (сполучити спан-правда (як-є ())))))))))
(довести-спан-закон
  (атом? (перше (решта
    (розділити-перед-умовою спан-атомна-умова
      (сполучити спан-вкладена-зупинка
        (сполучити спан-правда (як-є ()))))))))

; 23–24. BREAK зупиняється на першому атомі, залишаючи його на початку суфікса.
(довести-спан-закон
  (порожній? (перше
    (розділити-перед-умовою спан-атомна-умова
      (сполучити спан-правда
        (сполучити спан-вкладена-зупинка (як-є ())))))))
(довести-спан-закон
  (тотожне?
    (перше (решта
      (розділити-перед-умовою спан-атомна-умова
        (сполучити спан-правда
          (сполучити спан-вкладена-зупинка (як-є ()))))))
    спан-правда))

; Д11 TAKE-UNTIL/DROP-UNTIL: префікс перед першим D1:так, суфікс від нього.
(визначити до-умови-предикат
  (функція (елемент) (хибне? елемент)))
; Перший збіг усередині D1-списку: префікс завершується ДО ні.
(довести-спан-закон
  (однакові?
    (взяти-до-умови до-умови-предикат (список так ні так))
    (список так)))
; Суфікс включає збіжне ні, а після нього — решту даних.
(довести-спан-закон
  (однакові?
    (відкинути-до-умови до-умови-предикат (список так ні так))
    (список ні так)))
; Мутант включення збіжного елемента в префікс є D1:ні.
(довести-спан-закон
  (хибне?
    (однакові?
      (взяти-до-умови до-умови-предикат (список так ні так))
      (список так ні))))
; Немає збігів: весь вхід зберігається у префіксі.
(довести-спан-закон
  (однакові?
    (взяти-до-умови спан-завжди-ні спан-дані)
    спан-дані))
; Немає збігів: суфікс — структурне D3 ().
(довести-спан-закон
  (порожній?
    (відкинути-до-умови спан-завжди-ні спан-дані)))
; Збіг на початку — порожній префікс.
(довести-спан-закон
  (порожній?
    (взяти-до-умови спан-завжди-так спан-дані)))
; Збіг на початку — суфікс тотожний повному входу.
(довести-спан-закон
  (однакові?
    (відкинути-до-умови спан-завжди-так спан-дані)
    спан-дані))
; Порожній вхід: предикат, який породив би Type, не викликається.
(довести-спан-закон
  (порожній?
    (взяти-до-умови
      (функція (елемент) (перше (як-є ())))
      (як-є ()))))
(довести-спан-закон
  (порожній?
    (відкинути-до-умови
      (функція (елемент) (перше (як-є ())))
      (як-є ()))))
; D3 () всередині D3-списку залишається звичайним елементом.
(довести-спан-закон
  (однакові?
    (взяти-до-умови порожній?
      (список так (як-є ()) ні))
    (список так)))
(довести-спан-закон
  (однакові?
    (відкинути-до-умови порожній?
      (список так (як-є ()) ні))
    (список (як-є ()) ні)))

; Точний завершальний D1:YES після виконання всіх законів.
(атом? (як-є ()))
