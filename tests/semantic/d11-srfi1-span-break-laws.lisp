; Мовні закони SPAN/BREAK (SRFI-1) українською проєкцією Lisp/SENS.
; Завантажити чинні DEFINE з lib/d11-srfi1-span-break.lisp.
; Умова, очікуваний результат і контрприклад обчислюються самою SENS.
; D7-текстові атоми не є парою D3-атомів: їх порівнює чинна D8
; структурна ОДНАКОВІ?, а D3 ТОТОЖНЕ? залишається тільки атомною.
; Хибний закон приводить до недопустимого CAR порожнього списку.

; span-empty-prefix: ствердження, пряма Д4-порожнеча замість D8-рівності.
(за-умовою
  ((порожній? (перше (розділити-поки-умова (функція (х) (атом? х)) (як-є ())))) так)
  (так (перше (як-є ()))))

; span-empty-suffix: ствердження, пряма Д4-порожнеча замість D8-рівності.
(за-умовою
  ((порожній? (решта (розділити-поки-умова (функція (х) (атом? х)) (як-є ())))) так)
  (так (перше (як-є ()))))

; span-all-prefix: звичайні D7-текстові дані, не викличні голови.
; Предикат безумовно повертає D1:YES: цей закон не припускає, що D7-текст
; має ту саму ATOM-класифікацію, що й структурні D3-значення.
(за-умовою
  ((однакові? (перше (розділити-поки-умова (функція (х) (атом? (як-є ()))) (як-є (альфа бета гамма)))) (як-є (альфа бета гамма))) так)
  (так (перше (як-є ()))))

; span-all-suffix: за безумовного D1:YES усі елементи у префіксі, суфікс порожній.
(за-умовою
  ((однакові? (решта (розділити-поки-умова (функція (х) (атом? (як-є ()))) (як-є (альфа бета гамма)))) (як-є ())) так)
  (так (перше (як-є ()))))

; span-stops-prefix: ствердження.
(за-умовою
  ((однакові? (перше (розділити-поки-умова (функція (х) (однакові? х (як-є а))) (як-є (а б а)))) (як-є (а))) так)
  (так (перше (як-є ()))))

; span-stops-suffix: ствердження.
(за-умовою
  ((однакові? (решта (розділити-поки-умова (функція (х) (однакові? х (як-є а))) (як-є (а б а)))) (як-є (б а))) так)
  (так (перше (як-є ()))))

; span-not-partition: спростування.
(за-умовою
  ((хибне? (однакові? (перше (розділити-поки-умова (функція (х) (однакові? х (як-є а))) (як-є (а б а)))) (як-є (а а)))) так)
  (так (перше (як-є ()))))

; span-no-match-prefix: ствердження.
(за-умовою
  ((однакові? (перше (розділити-поки-умова (функція (х) (однакові? х (як-є а))) (як-є (б а)))) (як-є ())) так)
  (так (перше (як-є ()))))

; span-no-match-suffix: ствердження.
(за-умовою
  ((однакові? (решта (розділити-поки-умова (функція (х) (однакові? х (як-є а))) (як-є (б а)))) (як-є (б а))) так)
  (так (перше (як-є ()))))

; span-compound-stops: D8-структурна умова зупиняється на вкладеному списку.
; Не виводимо тип D7-тексту з D3 ATOM; порівнюємо конкретну структуру.
(за-умовою
  ((однакові?
     (решта
       (розділити-поки-умова
         (функція (х) (хибне? (однакові? х (як-є (бета)))))
         (як-є (альфа (бета) гамма)))
     (як-є ((бета) гамма)))
   так)
  (так (перше (як-є ()))))

; break-empty-prefix: ствердження.
(за-умовою
  ((однакові? (перше (розділити-перед-умовою (функція (х) (однакові? х (як-є б))) (як-є ()))) (як-є ())) так)
  (так (перше (як-є ()))))

; break-empty-suffix: ствердження.
(за-умовою
  ((однакові? (решта (розділити-перед-умовою (функція (х) (однакові? х (як-є б))) (як-є ()))) (як-є ())) так)
  (так (перше (як-є ()))))

; break-first-prefix: ствердження.
(за-умовою
  ((однакові? (перше (розділити-перед-умовою (функція (х) (однакові? х (як-є б))) (як-є (б а)))) (як-є ())) так)
  (так (перше (як-є ()))))

; break-first-suffix: ствердження.
(за-умовою
  ((однакові? (решта (розділити-перед-умовою (функція (х) (однакові? х (як-є б))) (як-є (б а)))) (як-є (б а))) так)
  (так (перше (як-є ()))))

; break-second-prefix: ствердження.
(за-умовою
  ((однакові? (перше (розділити-перед-умовою (функція (х) (однакові? х (як-є б))) (як-є (а б а)))) (як-є (а))) так)
  (так (перше (як-є ()))))

; break-second-suffix: ствердження.
(за-умовою
  ((однакові? (решта (розділити-перед-умовою (функція (х) (однакові? х (як-є б))) (як-є (а б а)))) (як-є (б а))) так)
  (так (перше (як-є ()))))

; break-no-match-prefix: ствердження.
(за-умовою
  ((однакові? (перше (розділити-перед-умовою (функція (х) (однакові? х (як-є б))) (як-є (а в)))) (як-є (а в))) так)
  (так (перше (як-є ()))))

; break-no-match-suffix: ствердження.
(за-умовою
  ((однакові? (решта (розділити-перед-умовою (функція (х) (однакові? х (як-є б))) (як-є (а в)))) (як-є ())) так)
  (так (перше (як-є ()))))

; span-do-not-visit-tail: ствердження.
(за-умовою
  ((однакові? (решта (розділити-поки-умова (функція (х) (за-умовою ((однакові? х (як-є небезпека)) (перше (як-є ()))) ((атом? (як-є ())) (однакові? х (як-є а))))) (як-є (а б небезпека)))) (як-є (б небезпека))) так)
  (так (перше (як-є ()))))

; break-do-not-visit-tail: ствердження.
(за-умовою
  ((однакові? (решта (розділити-перед-умовою (функція (х) (за-умовою ((однакові? х (як-є небезпека)) (перше (як-є ()))) ((атом? (як-є ())) (однакові? х (як-є б))))) (як-є (а б небезпека)))) (як-є (б небезпека))) так)
  (так (перше (як-є ()))))

; Завершальний D1:YES доступний лише після всіх перевірок.
(атом? (як-є ()))
