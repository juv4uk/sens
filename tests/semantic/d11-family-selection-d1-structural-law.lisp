; Д11 · позитивний SENS-закон стабільного відбору, тільки точні D1/D3.
; Списки створено чинним D4 СПИСОК, не W7 QUOTE над текстовою послідовністю.
; Це не додаткова координата D11: уся семантика належить lib/d11-family-selection.lisp.
; Очікування визначає сам SENS; неправильний результат веде до D3 Type.

; Обрані D1:ні двічі, зберігається кратність.
(за-умовою
  ((однакові?
     (фільтрувати
       (функція (елемент) (хибне? елемент))
       (список так ні так ні))
     (список ні ні))
   так)
  (так (перше (як-є ()))))

; Відкинуті D1:так двічі, порядок вхідних елементів не перевертається.
(за-умовою
  ((однакові?
     (відкинути-за-предикатом
       (функція (елемент) (хибне? елемент))
       (список так ні так ні))
     (список так так))
   так)
  (так (перше (як-є ()))))

; Обидва розділи — правильні списки з D3:() наприкінці.
; Один мовний предикат класифікує кожен вхідний D1 елемент.
(за-умовою
  ((однакові?
     (розділити
       (функція (елемент) (хибне? елемент))
       (список так ні ні так ні))
     (список (список ні ні ні) (список так так)))
   так)
  (так (перше (як-є ()))))

; На порожньому вході предикат не можна викликати.
(за-умовою
  ((однакові?
     (розділити
       (функція (елемент) (перше (як-є ())))
       (як-є ()))
     (список (як-є ()) (як-є ())))
   так)
  (так (перше (як-є ()))))

; Успішний фінальний вирок — точний D1.
(атом? (як-є ()))
