; Перевірка самого SENS: українські рядки, стан, команда завершення.
; Справжній семантичний вердикт — D1:YES, хибні гілки невикличні.
(за-умовою
  ((репл-завершення? (як-є (репл-завершити)))
   (за-умовою
     ((репл-завершення? (як-є (репл-завершити зайве)))
      (#d1:0))
     (#d1:1
      (за-умовою
        ((репл-завершення? (як-є репл-завершити))
         (#d1:0))
        (#d1:1
         ((функція (після-визначення)
            ((функція (після-виклику)
               (за-умовою
                 ((тотожне? (011 після-виклику) #d1:1)
                  #d1:1)
                 (#d1:1 (#d1:0))))
             (репл-обробити-рядок "відповідь" після-визначення)))
          (репл-обробити-рядок
            "(визначити відповідь (як-є #d1:1))"
            (репл-почати (як-є ())))))))))
  (#d1:1 (#d1:0)))
