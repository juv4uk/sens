; Д6:101110 REDUCE — ліве згортання через чинні D3/D4.
; Згорток з CONS попереду показує порядок кроків та повторів:
; fold(CONS-LEFT, (), (так ні ні)) = (ні ні так).
; Для порожнього списку операція не викликається.

(за-умовою
  ((хибне?
     (однакові?
       (згорнути
         (функція (стан елемент)
           (сполучити елемент стан))
         (як-є ())
         (список так ні ні))
       (список ні ні так)))
   ні)
  ((хибне?
     (однакові?
       (згорнути
         (функція (стан елемент)
           (сполучити елемент стан))
         (список так)
         (список ні так ні))
       (список ні так ні так)))
   ні)
  ((хибне?
     (однакові?
       (згорнути
         (функція (стан елемент) (перше елемент))
         (список так ні)
         (як-є ()))
       (список так ні)))
   ні)
  (так так))
