; Д11: розділити перед останнім, а не першим, D1:ні.
(за-умовою
  ((однакові?
     (розділити-перед-останнім-збігом
       (функція (елемент) (хибне? елемент))
       (список ні так ні так))
     (список так (список (список ні так) (список ні так))))
   так)
  (так (перше (як-є ()))))

; Структурне () всередині D3-списку залишається елементом.
(за-умовою
  ((однакові?
     (розділити-перед-останнім-збігом
       порожній? (список (як-є ()) так (як-є ())))
     (список так (список (список (як-є ()) так) (список (як-є ())))))
   так)
  (так (перше (як-є ()))))

; Немає збігу: весь вхід лишається префіксом.
(за-умовою
  ((однакові?
     (розділити-перед-останнім-збігом
       (функція (елемент) (хибне? елемент))
       (список так так))
     (список ні (список (список так так) (як-є ()))))
   так)
  (так (перше (як-є ()))))

; На порожньому вході предикат не викликається.
(за-умовою
  ((однакові?
     (розділити-перед-останнім-збігом
       (функція (елемент) (перше (як-є ())))
       (як-є ()))
     (список ні (список (як-є ()) (як-є ()))))
   так)
  (так (перше (як-є ()))))

(атом? (як-є ()))
