; Вісім законів часткового застосування і спільного хвоста.
; Кожне твердження є окремою перевіркою мовної семантики.
(однакові?
  ((частково-застосувати-префікс
    (функція (лівий правий) (сполучити лівий правий)) (як-є а))
    (список (як-є б)))
  (список (як-є а) (як-є б)))
(однакові?
  ((частково-застосувати-префікс
    (функція (лівий правий) (список лівий правий)) (як-є а)) (як-є б))
  (список (як-є а) (як-є б)))
(спільний-хвіст? (як-є (б в)) (як-є (а б в)))
(спільний-хвіст? (як-є ()) (як-є (а б)))
(хибне? (спільний-хвіст? (як-є (б г)) (як-є (а б в))))
(хибне? (спільний-хвіст? (як-є (а)) (як-є ())))
(однакові? (додати-на-початок (як-є а) (як-є (б в))) (як-є (а б в)))
(однакові? (зняти-з-початку (як-є (а б в))) (як-є (б в)))
