; Закони часткового застосування та належності хвоста списку.
; Кожна форма перевіряє конкретну поведінку без прихованих псевдонімів.
; Пара з одним елементом хвоста утворює правильний двоелементний список.
(однакові?
  ((частково-застосувати-префікс
     (функція (ліве праве) (сполучити ліве праве))
     (як-є а))
   (список (як-є б)))
  (список (як-є а) (як-є б)))
; Звичайне повернення двох аргументів також зберігає порядок.
(однакові?
  ((частково-застосувати-префікс
     (функція (ліве праве) (список ліве праве))
     (як-є а))
   (як-є б))
  (список (як-є а) (як-є б)))
; Хвіст має бути спільним за структурою, а не за частковим збігом.
(спільний-хвіст? (як-є (б в)) (як-є (а б в)))
(спільний-хвіст? (як-є ()) (як-є (а б)))
(хибне? (спільний-хвіст? (як-є (б г)) (як-є (а б в))))
(хибне? (спільний-хвіст? (як-є (а)) (як-є ())))
; Додавання і зняття голови зберігають правильний порядок.
(однакові?
  (додати-на-початок (як-є а) (як-є (б в)))
  (як-є (а б в)))
(однакові?
  (зняти-з-початку (як-є (а б в)))
  (як-є (б в)))
