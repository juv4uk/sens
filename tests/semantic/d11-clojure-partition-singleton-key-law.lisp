; Д11: singleton мусить застосувати першокласну функцію-ключ.
; Правильна група складається з одного одноелементного D3-списку.
; Порожній список не повинен викликати навіть отруйну ключову функцію.
(за-умовою
  ((хибне?
     (однакові?
       (групувати-суміжні-за-ключем
         (функція (елемент) (хибне? елемент))
         (список ні))
       (список (список ні))))
   ні)
  ((хибне?
     (порожній?
       (групувати-суміжні-за-ключем
         (функція (елемент) (перше (як-є ())))
         (як-є ()))))
   ні)
  ; Прямий D11 helper: singleton з переданим ключем — одна група.
  ((хибне?
     (однакові?
       (розділити-суміжні-за-ключем
         (функція (перший-ключ суфікс) суфікс)
         (функція (елемент) елемент)
         (список так) так)
       (список (список так))))
   ні)
  ; Два суміжних D1:так — група; D1:ні як елемент залишається в суфіксі.
  ((хибне?
     (однакові?
       (розділити-суміжні-за-ключем
         (функція (перший-ключ суфікс) суфікс)
         (функція (елемент) елемент)
         (список так так ні) так)
       (сполучити (список так так) (список ні))))
   ні)
  (так так))
