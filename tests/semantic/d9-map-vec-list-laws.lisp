; Закони спискової проєкції мапи та вектора дев'ятого домену.
; Усі імена локальних визначень, змінні та дані українською.
; Вісім перевірок зберігають порядок елементів і результатів.
(визначити вектор-елемент-за-індексом елемент-списку-за-індексом)
(список
  (однакові? (мапа-порожній) (як-є ()))
  (однакові? (вектор-порожній) (як-є ()))
  (мапа-містить? (як-є к)
                 (список (список (як-є к) (як-є значення))))
  (хибне? (мапа-містить? (як-є відсутнє)
                       (список (список (як-є к) (як-є значення)))))
  (однакові? (мапа-отримати (як-є к)
                         (список (список (як-є к) (як-є значення))))
          (список (як-є значення)))
  (однакові? (мапа-список (список (список (як-є а) (як-є 1))))
          (список (список (як-є а) (як-є 1))))
  (однакові? (вектор-кількість (список (як-є а) (як-є б) (як-є в)))
          3)
  (однакові? (вектор-елемент-за-індексом 1
                        (список (як-є а) (як-є б) (як-є в)))
          (як-є б)))
