; Логічний закон: occurs-check відкидає нескінченну самопосилальну структуру.
; Змінна не може бути зв'язана з термом, що містить цю саму змінну.
; D7-мітки та списки порівнюються структурною D8-рівністю, не D3 EQ.
; Усі чотири закони зведено до одного fail-closed SENS-вердикту:
; рівні списки рівні, різна довжина нерівна, () не дорівнює списку,
; самопосилальна уніфікація повертає fail. Rust/Zig не задають очікування.
(за-умовою
  ((уніфікація-рівні?
     (сполучити (як-є а) (сполучити (як-є б) (як-є ())))
     (сполучити (як-є а) (сполучити (як-є б) (як-є ())))
   )
   (за-умовою
     ((хибне?
        (уніфікація-рівні?
          (сполучити (як-є а) (сполучити (як-є б) (як-є ())))
          (сполучити (як-є а) (як-є ()))))
      (за-умовою
        ((хибне?
           (уніфікація-рівні?
             (як-є ())
             (сполучити (як-є а) (як-є ()))))
         (за-умовою
           ((однакові?
              (уніфікувати
                (сполучити (як-є var) (сполучити (як-є вузол) (як-є ())))
                (сполучити (як-є дерево)
                  (сполучити
                    (сполучити (як-є var) (сполучити (як-є вузол) (як-є ())))
                    (як-є ())))
                (як-є ()))
              (як-є fail))
            (атом? (як-є ())))
           (так (перше (як-є ())))))
        (так (перше (як-є ())))))
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))
