; Вісім законів піднесення до степеня, списку значень та підстановки.
; Математичні операнди і результати записані десятково.
; Один із законів заперечує навмисно неправильну рівність.

(список
  (однакові? (піднести-до-степеня 2 0) 1)
  (однакові? (піднести-до-степеня 2 1) 2)
  (однакові? (піднести-до-степеня 2 3) 8)
  (однакові? (піднести-до-степеня 3 2) 9)
  (хибне? (однакові? (піднести-до-степеня 2 2) 8))
  (однакові? (значення-списком (як-є ())) (як-є ()))
  (однакові? (значення-списком (список (як-є а) (як-є б))) (список (як-є а) (як-є б)))
  (однакові? (застосувати-підстановка (як-є нове) (як-є старе) (список (як-є старе) (як-є х))) (список (як-є нове) (як-є х))))
