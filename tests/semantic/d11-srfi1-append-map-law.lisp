; D11 APPEND-MAP із суворою перевіркою: не другий D10 MAPPEND.
; Залежність: lib/core4-parts/core4-language.lisp і
; lib/d11-srfi1-append-map.lisp.
; Доказові вирази — мовою SENS, без хостової істини.

; Кратність і порядок D1:ні у даних.
(за-умовою
  ((однакові?
     (відобразити-та-приєднати-списки
       (функція (елемент) (список елемент елемент))
       (список ні так))
     (список ні ні так так))
   так)
  (так (перше (як-є ()))))

; Порожній підсписок не породжує елемент.
(за-умовою
  ((порожній?
     (відобразити-та-приєднати-списки
       (функція (елемент) (як-є ()))
       (список ні так)))
   так)
  (так (перше (як-є ()))))

; Вкладений D3-об'єкт зберігається як один елемент.
(за-умовою
  ((однакові?
     (відобразити-та-приєднати-списки
       (функція (елемент) (список (список елемент)))
       (список ні))
     (список (список ні)))
   так)
  (так (перше (як-є ()))))

; На порожньому вході отруйний callback не викликається.
(за-умовою
  ((порожній?
     (відобразити-та-приєднати-списки
       (функція (елемент) (перше (як-є ())))
       (як-є ())))
   так)
  (так (перше (як-є ()))))

; Підтверджена композиція збігається з чинним D10 MAPPEND.
(за-умовою
  ((однакові?
     (відобразити-та-приєднати-списки
       (функція (елемент) (список елемент))
       (список так ні))
     (відобразити-й-додати
       (функція (елемент) (список елемент))
       (список так ні)))
   так)
  (так (перше (як-є ()))))

(атом? (як-є ()))
