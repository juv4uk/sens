; D11 APPEND-MAP: SENS-закони, залежності
; lib/list-append-general.lisp і lib/d11-srfi1-append-map.lisp.
; Усі перевірки виконують SENS функції, а не хостовий assert.

; Кратність та порядок, включно з D1:ні у даних.
(за-умовою
  ((однакові?
     (відобразити-та-приєднати-списки
       (функція (елемент) (список елемент елемент))
       (список ні так))
     (список ні ні так так))
   так)
  (так (перше (як-є ()))))

; Результати () законно зникають, а не стають елементами списку.
(за-умовою
  ((порожній?
     (відобразити-та-приєднати-списки
       (функція (елемент) (як-є ()))
       (список ні так)))
   так)
  (так (перше (як-є ()))))

; Вкладений D3-об'єкт зберігається як один елемент.
(за-умовою
  ((однакові?
     (відобразити-та-приєднати-списки
       (функція (елемент) (список (список елемент)))
       (список ні))
     (список (список ні)))
   так)
  (так (перше (як-є ()))))

; Для порожнього входу користувацька функція не викликається.
(за-умовою
  ((порожній?
     (відобразити-та-приєднати-списки
       (функція (елемент) (перше (як-є ())))
       (як-є ())))
   так)
  (так (перше (як-є ()))))

; Композиція збігається з чинним SENS APPEND.
(за-умовою
  ((однакові?
     (відобразити-та-приєднати-списки
       (функція (елемент) (список елемент))
       (список так ні))
     (приєднати-два-списки
       (список так) (список ні)))
   так)
  (так (перше (як-є ()))))

(атом? (як-є ()))
