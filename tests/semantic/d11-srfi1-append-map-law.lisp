; Д11 APPEND-MAP: одне fail-closed обчислення п'яти SENS законів.
; 1. Кратність і порядок D1:ні; 2. порожні підсписки;
; 3. вкладений D3; 4. порожній вхід без callback;
; 5. тотожність композиції з ратифікованим D10 MAPPEND.
; При першому порушенні: точна помилка D3 CAR Type, без host-оракула.
(за-умовою
  ((однакові?
        (відобразити-та-приєднати-списки
          (функція (елемент) (список елемент елемент))
          (список ні так))
        (список ні ні так так))
   (за-умовою
     ((порожній?
           (відобразити-та-приєднати-списки
             (функція (елемент) (як-є ()))
             (список ні так)))
      (за-умовою
        ((однакові?
              (відобразити-та-приєднати-списки
                (функція (елемент) (список (список елемент)))
                (список ні))
              (список (список ні)))
         (за-умовою
           ((порожній?
                 (відобразити-та-приєднати-списки
                   (функція (елемент) (перше (як-є ())))
                   (як-є ())))
            (за-умовою
              ((однакові?
                    (відобразити-та-приєднати-списки
                      (функція (елемент) (список елемент))
                      (список так ні))
                    (відобразити-й-додати
                      (функція (елемент) (список елемент))
                      (список так ні)))
               так)
              (так (перше (як-є ())))))
           (так (перше (як-є ())))))
        (так (перше (як-є ())))))
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))
