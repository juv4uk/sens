; Самодоказ законів Д5: порядок, зворот, підстановка та негативні випадки.
; Семантичні передумови й результат визначає тільки Lisp/SENS.
; Zig кодує точні слова у фізичний T5M, Rust не обчислює закони.
; Джерело не містить числових голів, літералів або SID8-проєкцій.

(визначити довести-закон-списку-д5
  (функція (умова)
    (за-умовою
      ((хибне? умова) (перше (як-є ())))
      (так так))))

(визначити початковий-список-д5
  (список (як-є альфа) (як-є бета) (як-є гамма)))

; Два звороти відновлюють вихідну структуру.
(довести-закон-списку-д5
  (однакові?
    (зворот (зворот початковий-список-д5))
    початковий-список-д5))

; Один зворот змінює несиметричний список.
(довести-закон-списку-д5
  (хибне?
    (однакові?
      (зворот початковий-список-д5)
      початковий-список-д5)))

; Порожній список після звороту залишається порожнім.
(довести-закон-списку-д5
  (порожній? (зворот (як-є ()))))

; Селектор першого елемента після звороту повертає останній атом.
(довести-закон-списку-д5
  (тотожне?
    (перше (зворот початковий-список-д5))
    (як-є гамма)))

; Підстановка змінює лише знайдені атоми та зберігає порядок.
(довести-закон-списку-д5
  (однакові?
    (замінити (як-є дельта) (як-є бета) початковий-список-д5)
    (список (як-є альфа) (як-є дельта) (як-є гамма))))

; Негатив: результат підстановки не дорівнює початковому списку.
(довести-закон-списку-д5
  (хибне?
    (однакові?
      (замінити (як-є дельта) (як-є бета) початковий-список-д5)
      початковий-список-д5)))

; Пошук відсутнього атома не має змінювати дані.
(довести-закон-списку-д5
  (однакові?
    (замінити (як-є дельта) (як-є відсутній) початковий-список-д5)
    початковий-список-д5))

; Точна D1-істина: оболонка перевіряє лише фізичний вивід, не семантику.
(атом? (як-є ()))
