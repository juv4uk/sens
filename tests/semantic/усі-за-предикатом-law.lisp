; Закон D6:111101 «усі?» — квантор для правильних списків.
; Тестуємо чинну мовну реалізацію; не перевизначаємо ім'я драбини.
; Логічні очікування й контрприклади описані лише мовою Lisp/SENS.

; Кожний атом у правильному списку задовольняє АТОМ? — Д1:так.
(за-умовою
 ((усі? (функція (елемент) (атом? елемент))
        (сполучити (як-є а) (сполучити (як-є б) (як-є ()))))
  (порожній? (як-є ())))
 ((порожній? (як-є ())) (перше (як-є ()))))

; Вакуумна загальність: усі? на порожньому списку — Д1:так.
(за-умовою
 ((усі? (функція (елемент) (атом? елемент)) (як-є ()))
  (порожній? (як-є ())))
 ((порожній? (як-є ())) (перше (як-є ()))))

; Вкладений список не є атомом, тож універсальна умова — Д1:ні.
(за-умовою
 ((хибне? (усі? (функція (елемент) (атом? елемент))
                 (сполучити (як-є а) (сполучити (сполучити (як-є б) (як-є ())) (як-є ())))))
  (порожній? (як-є ())))
 ((порожній? (як-є ())) (перше (як-є ()))))

; Коротке замикання: перший складений елемент уже спростовує закон,
; тому неправильний хвіст не можна читати чи трактувати як список.
(за-умовою
 ((хибне? (усі? (функція (елемент) (атом? елемент))
                 (сполучити (сполучити (як-є б) (як-є ())) (як-є хвіст))))
  (порожній? (як-є ())))
 ((порожній? (як-є ())) (перше (як-є ()))))

; Остання форма — точний мовний свідок D1:так.
(атом? (як-є ()))
