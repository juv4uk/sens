; Д11: останній відповідний суфікс має правильний порядок і D1 прапорець.
; Всі списки побудовані через D4 СПИСОК; D7 не кодує спискові дані.
(за-умовою
  ((однакові?
     (знайти-останній-хвіст-із-наявністю
       (функція (елемент) (хибне? елемент))
       (список ні так ні так))
     (список так (список ні так)))
   так)
  (так (перше (як-є ()))))

; Вкладене D3:() — повноцінний елемент та може завершувати список.
(за-умовою
  ((однакові?
     (знайти-останній-хвіст-із-наявністю
       порожній? (список (як-є ()) так (як-є ())))
     (список так (список (як-є ()))))
   так)
  (так (перше (як-є ()))))

; Немає збігу: прапорець D1:ні, порожній структурний суфікс.
(за-умовою
  ((однакові?
     (знайти-останній-хвіст-із-наявністю
       (функція (елемент) (хибне? елемент))
       (список так так))
     (список ні (як-є ())))
   так)
  (так (перше (як-є ()))))

; Порожній вхід не викликає жодного предиката.
(за-умовою
  ((однакові?
     (знайти-останній-хвіст-із-наявністю
       (функція (елемент) (перше (як-є ())))
       (як-є ()))
     (список ні (як-є ())))
   так)
  (так (перше (як-є ()))))

(атом? (як-є ()))
