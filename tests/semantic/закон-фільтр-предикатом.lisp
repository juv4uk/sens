; Закон: відібрати за предикатом зберігає лише збіги.

(визначити відібрати
  (функція (предикат залишок)
    (за-умовою
      ((атом? залишок) (як-є ()))
      ((предикат (перше залишок))
       (сполучити (перше залишок) (відібрати предикат (решта залишок))))
      (так (відібрати предикат (решта залишок))))))

(визначити є-а?
  (функція (значення)
    (тотожне? значення (як-є а))))

(визначити свідок-фільтра
  (функція ()
    (нехай ((с (сполучити (як-є а) (сполучити (як-є б) (сполучити (як-є а) (як-є ())))))
            (р (відібрати є-а? с)))
      (за-умовою
        ((тотожне? (перше р) (як-є а))
         (за-умовою
           ((тотожне? (перше (решта р)) (як-є а))
            (за-умовою
              ((атом? (решта (решта р)))
               (як-є (закон-фільтр (status pass))))
              (так (як-є (закон-фільтр (status fail))))))
           (так (як-є (закон-фільтр (status fail))))))
        (так (як-є (закон-фільтр (status fail))))))))

(свідок-фільтра)
