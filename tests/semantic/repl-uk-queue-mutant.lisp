; Негативний свідок REPL: переставлені та дубльовані поля відхилено.
; D1-предикат перевіряємо через хибне?, не через D3 тотожне? над бітом.
; Джерельні голови — тільки ратифікована українська проєкція D3–D5.

; Порівняння структурних полів виконує сам СЕНС: Д3 тотожне? лише для атомів.
; Вкладені значення не можна безпосередньо віддавати атомній рівності.
(визначити рівні-репл-поля?
  (функція (ліве праве)
    (за-умовою
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (тотожне? ліве праве))
         (так ні)))
      ((атом? праве) ні)
      ((рівні-репл-поля? (перше ліве) (перше праве))
       (рівні-репл-поля? (решта ліве) (решта праве)))
      (так ні))))

(визначити поля-правильні?
  (функція (рядок очікувані)
    (за-умовою
      ((атом? очікувані) (атом? рядок))
      ((атом? рядок) ні)
      ((атом? (перше рядок)) ні)
      ((рівні-репл-поля? (перше (перше рядок)) (перше очікувані))
       (поля-правильні? (решта рядок) (решта очікувані)))
      (так ні))))

(визначити свідок-репл-мутант
  (функція ()
    (за-умовою
      ((хибне?
         (поля-правильні?
           (список (список (як-є укр) (як-є як-є))
                   (список (як-є ук) (як-є як-є)))
           (список (як-є ук) (як-є укр))))
       (за-умовою
         ((хибне?
            (поля-правильні?
              (список (список (як-є ук) (як-є як-є))
                      (список (як-є ук) (як-є як-є)))
              (список (як-є ук) (як-є укр))))
          (як-є (репл-мутант (status pass))))
         (так (як-є (репл-мутант (status fail))))))
      (так (як-є (репл-мутант (status fail)))))))

(свідок-репл-мутант)
