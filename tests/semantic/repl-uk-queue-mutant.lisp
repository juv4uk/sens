; Негативний свідок REPL: переставлені та дубльовані поля відхилено.
; D1-предикат перевіряємо через хибне?; хибне рішення падає у справжньому SENS.
; Джерельні голови — тільки ратифікована українська проєкція D3–D5.

; Порівняння структурних полів виконує сам СЕНС: Д7-назва є Text7,
; але атомна Д3 ТОТОЖНЕ? не допускає її як два EQ-атоми.
; Точний дротовий образ Д8 ЗНАЧЕННЯ-У-ТЕКСТ порівнює Д8 ТЕКСТ-РІВНИЙ?.
; Для пар зберігається власна рекурсія ПЕРШЕ/РЕШТА без стороннього оракула.
(визначити рівні-репл-поля?
  (функція (ліве праве)
    (за-умовою
      ((атом? ліве)
       (за-умовою
         ((атом? праве)
          (текст-рівний?
            (значення-у-текст ліве)
            (значення-у-текст праве)))
         (так ні)))
      ((атом? праве) ні)
      ((рівні-репл-поля? (перше ліве) (перше праве))
       (рівні-репл-поля? (решта ліве) (решта праве)))
      (так ні))))

(визначити поля-правильні?
  (функція (рядок очікувані)
    (за-умовою
      ((атом? очікувані) (атом? рядок))
      ((атом? рядок) ні)
      ((атом? (перше рядок)) ні)
      ((рівні-репл-поля? (перше (перше рядок)) (перше очікувані))
       (поля-правильні? (решта рядок) (решта очікувані)))
      (так ні))))

(визначити свідок-репл-мутант
  (функція ()
    (за-умовою
      ((хибне?
         (поля-правильні?
           (список (список (як-є укр) (як-є як-є))
                   (список (як-є ук) (як-є як-є)))
           (список (як-є ук) (як-є укр))))
       (за-умовою
         ((хибне?
            (поля-правильні?
              (список (список (як-є ук) (як-є як-є))
                      (список (як-є ук) (як-є як-є)))
              (список (як-є ук) (як-є укр))))
          (як-є (репл-мутант (status pass))))
         (так (перше (як-є ())))))
      (так (перше (як-є ()))))))

(свідок-репл-мутант)
