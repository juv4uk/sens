; Нативний закон Д3 QUOTE: цитована форма є даними, а не прихованим викликом.
; (перше ()) при обчисленні є помилкою; всередині як-є вона не виконується.
; Перевіряє тільки сама мова СЕНС, без Rust/Python-обчислювача.
; Жодних цифрових голів, SID8/Sens8 або числових літералів.

(визначити цитована-помилкова-форма (як-є (перше ())))

(визначити перевірити-закон-цитування-д3
  (функція ()
    (за-умовою
      ((тотожне? (перше цитована-помилкова-форма) (як-є перше))
       (за-умовою
         ((порожній? (перше (решта цитована-помилкова-форма)))
          (за-умовою
            ((атом? цитована-помилкова-форма) (перше (як-є ())))
            (так так)))
         (так (перше (як-є ())))))
      (так (перше (як-є ()))))))

(перевірити-закон-цитування-д3)
