; NATIVE_SENS_POSITIVE=NOT_VERIFIED
; NATIVE_SENS_NEGATIVE=NOT_VERIFIED
;
; Пара D3: перше/решта/сполучити. Ідентичність — форма, без квитанцій.

(за-умовою
  ((тотожне? (перше (сполучити так ні)) так)
   (за-умовою
     ((тотожне? (решта (сполучити так ні)) ні)
      (за-умовою
        ((хибне? (атом? (сполучити так ні)))
         так)
        (так (ні))))
     (так (ні))))
  (так (ні)))
