; Двадцять два закони похідних функцій КЛІПС десятого домену.
; Протокольні команди в цитуванні лишаються незмінними.
; Позитивні та негативні випадки мають повертати так або ні.
(твердження-кліпс? (як-є (assert (факт))))
(хибне? (твердження-кліпс? (як-є (printout повідомлення))))
(хибне? (твердження-кліпс? (як-є ((assert) факт))))
(хибне? (твердження-кліпс? (як-є ())))
(хибне? (твердження-кліпс? (як-є assert)))
(твердження-кліпс? (як-є (assert (один) (два))))
(виведення-кліпс? (як-є (printout повідомлення)))
(хибне? (виведення-кліпс? (як-є (assert (факт)))))
(хибне? (виведення-кліпс? (як-є ((printout) повідомлення))))
(хибне? (виведення-кліпс? (як-є ())))
(виведення-кліпс? (як-є (printout)))
(однакові? (прибрати-виведення-кліпс (як-є ())) (як-є ()))
(однакові? (прибрати-виведення-кліпс (як-є ((printout а) (assert (один))))) (як-є ((assert (один)))))
(однакові? (прибрати-виведення-кліпс (як-є ((assert (один)) (printout а) (assert (два))))) (як-є ((assert (один)) (assert (два)))))
(однакові? (прибрати-виведення-кліпс (як-є ((assert (один)) (printout а)))) (як-є ((assert (один)))))
(однакові? (прибрати-виведення-кліпс (як-є ((printout а) (printout б)))) (як-є ()))
(однакові? (прибрати-виведення-кліпс (як-є ((retract (факт)) (printout а)))) (як-є ((retract (факт)))))
(усі-твердження-кліпс? (як-є ()))
(усі-твердження-кліпс? (як-є ((assert (один)) (assert (два)))))
