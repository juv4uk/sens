(хибне? (усі-твердження-кліпс? (як-є ((printout повідомлення)))))
(однакові? (прибрати-виведення-кліпс (як-є ((assert (один)) (printout б) (assert (два)) (printout в) (retract (три))))) (як-є ((assert (один)) (assert (два)) (retract (три)))))
