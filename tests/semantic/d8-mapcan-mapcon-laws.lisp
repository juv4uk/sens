; Закони збирання результатів відображення елементів і залишків списку.
; Перший спосіб передає елемент, другий передає цілий поточний хвіст.

(список
  (порожній? (відобразити-й-склеїти (функція (елемент) (список елемент)) (як-є ())))
  (порожній? (відобразити-залишки-й-склеїти (функція (хвіст) (список хвіст)) (як-є ())))
  (однакові? (відобразити-й-склеїти
            (функція (елемент) (список елемент))
            (список (як-є а) (як-є б)))
          (список (як-є а) (як-є б)))
  (однакові? (відобразити-й-склеїти
            (функція (елемент) (список елемент елемент))
            (список (як-є а) (як-є б)))
          (список (як-є а) (як-є а) (як-є б) (як-є б)))
  (порожній? (відобразити-й-склеїти
            (функція (елемент) (як-є ()))
            (список (як-є а) (як-є б))))
  (однакові? (відобразити-залишки-й-склеїти
            (функція (хвіст) (список хвіст))
            (список (як-є а) (як-є б)))
          (список (список (як-є а) (як-є б)) (список (як-є б))))
  (хибне? (однакові? (відобразити-залишки-й-склеїти
                  (функція (хвіст) (список хвіст))
                  (список (як-є а) (як-є б)))
                (список (список (як-є б)) (список (як-є а) (як-є б)))))
  (хибне? (однакові? (відобразити-й-склеїти
                  (функція (елемент) (список елемент))
                  (список (як-є а) (як-є б)))
                (список (як-є б) (як-є а)))))
