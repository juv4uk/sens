; Мовний закон Д4: MAP/FILTER як рекурсивні Lisp-функції.
; D6 MAP/FILTER не викликаються: механізм задають Д3/Д4.
; Елементи — значення-предикати Д1: їх тестують як біти, не через D3 EQ.
; Кожна проєкція доходить через Zig/T5M до нативного SENS.

(визначити перевірне-відобразити
  (функція (дія елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      (так
        (сполучити
          (дія (перше елементи))
          (перевірне-відобразити дія (решта елементи)))))))

(визначити перевірне-відсіяти
  (функція (умова елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((умова (перше елементи))
       (сполучити
         (перше елементи)
         (перевірне-відсіяти умова (решта елементи))))
      (так (перевірне-відсіяти умова (решта елементи))))))

(визначити тотожна-дія (функція (елемент) елемент))
(визначити вибрати-істину
  (функція (елемент) елемент))
(визначити початкові
  (список
    (атом? (як-є ()))
    (хибне? (атом? (як-є ())))
    (атом? (як-є ()))))
(визначити переписані (перевірне-відобразити тотожна-дія початкові))
(визначити вибрані (перевірне-відсіяти вибрати-істину початкові))

(за-умовою
  ((перше переписані)
   (за-умовою
     ((хибне? (перше (решта переписані)))
      (за-умовою
        ((перше вибрані)
         (за-умовою
           ((перше (решта вибрані))
            (порожній? (решта (решта вибрані))))
           (так ні)))
        (так ні)))
     (так ні)))
  (так ні))
