; Самоперевірка D4 рекурсії та функцій вищого порядку мовою Lisp/SENS.
; НЕ є доказом допуску D6 MAP/FILTER: недопущені коди D6 тут не викликаємо.
; Всі перевірні функції визначаються мовою через D3/D4, не механізмом Rust.

(визначити перевірне-відобразити
  (функція (дія елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      (так
        (сполучити
          (дія (перше елементи))
          (перевірне-відобразити дія (решта елементи)))))))

(визначити перевірне-відсіяти
  (функція (умова елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((умова (перше елементи))
       (сполучити
         (перше елементи)
         (перевірне-відсіяти умова (решта елементи))))
      (так (перевірне-відсіяти умова (решта елементи))))))

(визначити тотожна-дія (функція (назва) назва))
(визначити вибрати-радіо
  (функція (назва) (тотожне? назва (як-є радіо))))

(визначити переписані
  (перевірне-відобразити тотожна-дія (як-є (антена радіо))))
(визначити вибрані
  (перевірне-відсіяти вибрати-радіо (як-є (антена радіо сигнал радіо))))

; Точні результати — лише D1:так або D1:ні, без числових літералів.
(за-умовою
  ((тотожне? (перше переписані) (як-є антена)) (за-умовою
  ((тотожне? (перше (решта переписані)) (як-є радіо)) (за-умовою
  ((порожній? (решта (решта переписані))) (за-умовою
  ((тотожне? (перше вибрані) (як-є радіо)) (за-умовою
  ((тотожне? (перше (решта вибрані)) (як-є радіо)) (за-умовою
  ((порожній? (решта (решта вибрані))) (за-умовою
  ((порожній? (перевірне-відобразити тотожна-дія (як-є ()))) (за-умовою
  ((порожній? (перевірне-відсіяти вибрати-радіо (як-є (антена сигнал)))) так)
  (так ні)))
  (так ні)))
  (так ні)))
  (так ні)))
  (так ні)))
  (так ні)))
  (так ні)))
  (так ні))
