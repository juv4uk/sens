; Закони лівого зсуву, повернення списку значень і цілочисельної частки.
; Перевіряємо вісім випадків із десятковими математичними числами.

(список
  (однакові? (зсунути-вліво 3
                         1)
          6)
  (однакові? (зсунути-вліво 5
                         0)
          5)
  (однакові? (зсунути-вліво 1
                         2)
          4)
  (однакові? (значення-списком (список (як-є а) (як-є б)))
          (список (як-є а) (як-є б)))
  (однакові? (значення-списком (як-є ()))
          (як-є ()))
  (однакові? (частка 10
                  2)
          5)
  (однакові? (частка 7
                  3)
          2)
  (однакові? (зсунути-вліво 2
                         3)
          16))
