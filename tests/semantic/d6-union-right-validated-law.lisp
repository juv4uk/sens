; Д6:111011 UNION: основа зберігає правильний правий список без копії.
; Дублікати, присутні у правому аргументі, не змінюються новим guard.
(за-умовою
  ((хибне?
     (однакові?
       (об'єднання (як-є ()) (список ні так ні))
       (список ні так ні)))
   ні)
  ((хибне?
     (однакові?
       (об'єднання (список так ні) (список ні))
       (список так ні)))
   ні)
  ((хибне?
     (однакові?
       (об'єднання (список так) (як-є ()))
       (список так)))
   ні)
  (так так))
