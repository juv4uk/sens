; Закони похідного зсуву й копіювання структур.
; Вісім перевірок охоплюють правильні й неправильні результати.
; Проміжні визначення користуються чинними українськими назвами.
(визначити копіювати-структуру копіювати-список)
(список
  (однакові? (арифметично-зсунути 3
                               1)
          6)
  (однакові? (арифметично-зсунути 5
                               0)
          5)
  (однакові? (копіювати-структуру (список (як-є а) (як-є б)))
          (список (як-є а) (як-є б)))
  (однакові? (копіювати-структуру (як-є ()))
          (як-є ()))
  (однакові? (копіювати-структуру (список (список (як-є х))))
          (список (список (як-є х))))
  (хибне? (однакові? (копіювати-структуру (список (як-є а)))
                (список (як-є б))))
  (однакові? (арифметично-зсунути 1
                               2)
          4)
  (однакові? (арифметично-зсунути 2
                               3)
          16))
