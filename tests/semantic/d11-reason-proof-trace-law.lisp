; D11 F11-PROOF-TRACE: правильний скінченний список доказів.
; Завантажити чинні визначення SENS: lib/unify.lisp, lib/reason.lisp.
; Це свідок бібліотечного закону, а не новий D11 opcode.
(визначити доказ-не-одержано
  (список (як-є proved-not) (як-є мета)))
(визначити один-запис-походження
  (походження-списку (список доказ-не-одержано)))

; Вкладений успіх: листковий факт і правило висновку є двома використаннями.
; Подання чисел не вигадуємо — беремо корінь з чинної мови SENS Reason.
(визначити доказ-листа
  (список (як-є proved) (як-є відоме) (як-є правило-факту) (як-є ())))
(визначити доказ-кореня
  (список (як-є proved) (як-є виведено) (як-є правило-кореня)
    (список доказ-листа)))
(визначити еталонне-походження-кореня
  (список
    (як-є statement)
    (як-є виведено)
    (список (як-є source) (як-є rule))
    (список (як-є rule) (як-є правило-кореня))
    (список (як-є derived-from)
      (список
        (список
          (як-є statement)
          (як-є відоме)
          (список (як-є source) (як-є fact))
          (список (як-є rule) (як-є правило-факту))
          (список (як-є derived-from) (як-є ())))))))
(визначити еталонне-використання-правил
  (список
    (сполучити (як-є правило-факту) довідка-число-один)
    (сполучити (як-є правило-кореня) довідка-число-один)))

(за-умовою
  ((порожній? (походження-списку (як-є ())))
   (за-умовою
     ((хибне? (порожній? один-запис-походження))
      (за-умовою
        ((порожній? (решта один-запис-походження))
         (за-умовою
           ((порожній?
              (порахувати-використання-списку
                (список доказ-не-одержано)))
            (порожній?
              (порахувати-правила-у-дереві-доказу
                доказ-не-одержано)))
           (так ні)))
        (так ні)))
     (так ні)))
  ; Позитивний закон: вузли не загублені, fact/rule розмежовані,
  ; а гістограма має рівно два адресні записи з числом-один.
  ((хибне?
     (уніфікація-рівні?
       (побудувати-походження-вузла доказ-кореня)
       еталонне-походження-кореня))
   ні)
  ((хибне?
     (уніфікація-рівні?
       (порахувати-використання-списку (список доказ-кореня))
       еталонне-використання-правил))
   ні)
  (так так))
