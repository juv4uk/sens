; D9/F6: кожне зв'язування — пара, а не довільне значення D1.
; Багатосимвольний D7-носій сам є D3-парою, тому не свідчить про атомність.
; Виявити D1-запис після коректної пари та неправильний D1-хвіст.
; Негативний пакет відхилити семантикою SENS як invalid-bindings.
(за-умовою
  ((хибне? (фс-зв'язки-правильні? (як-є ()))) ні)
  ((хибне?
     (фс-зв'язки-правильні?
       (список (сполучити (як-є a) (як-є адреса))))) ні)
  ((фс-зв'язки-правильні? (список так)) ні)
  ((фс-зв'язки-правильні?
     (список (сполучити (як-є a) (як-є адреса)) так)) ні)
  ((фс-зв'язки-правильні?
     (сполучити (сполучити (як-є a) (як-є адреса)) ні)) ні)
  ((усі-адреси-зв'язувань-у-файловій-системі-наявні?
     (список так) (як-є ())) ні)
  ((хибне?
     (однакові?
       (друге
         (рішення-щодо-кореневого-пакета-файлової-системи
           (список
             (сполучити (як-є format) (як-є wsm-fs-root))
             (сполучити (як-є version) *версія-формату-фс*)
             (сполучити (як-є revision) фс-число-нуль)
             (сполучити
               (як-є bindings)
               (список
                 (сполучити (як-є a) (як-є адреса))
                 так))
             (сполучити (як-є objects) (як-є ())))))
       (як-є invalid-bindings))) ні)
  ; Непорожнє складене ім'я D7 зберігається як допустимий ключ binding.
  ((фс-зв'язки-правильні?
     (список
       (сполучити
         (список (як-є a) (як-є b))
         (як-є адреса)))) так)
  ; Порожнє ім'я binding відхиляється.
  ((фс-зв'язки-правильні?
     (список (сполучити (як-є ()) (як-є адреса)))) ні)
  ; Порожнє ім'я відхиляється й після коректного зв'язування.
  ((фс-зв'язки-правильні?
     (список
       (сполучити (як-є a) (як-є адреса))
       (сполучити (як-є ()) (як-є адреса)))) ні)
  (так так))
