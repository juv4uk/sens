; Закон Д4: предикат передається як значення іншій функції.
; Два різні входи — атом і CONS-пара — перевіряє лише виконавець SENS.
; Жодної семантики у Rust/Zig чи числових голів у Lisp.
(за-умовою
  (((функція (перевірка)
        (перевірка (як-є ())))
      (функція (значення) (атом? значення)))
    (за-умовою
      ((хибне?
         ((функція (перевірка)
            (перевірка (сполучити (як-є ()) (як-є ()))))
          (функція (значення) (атом? значення))))
       (атом? (як-є ())))
      (так (хибне? (атом? (як-є ()))))))
  (так (хибне? (атом? (як-є ())))))
