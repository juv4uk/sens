; M2 · негативні свідки · самокалібрування.
; SENS_SOURCE=tests/semantic/твердження-негативні-law.lisp
; NATIVE_SENS_POSITIVE=NOT_VERIFIED
; NATIVE_SENS_NEGATIVE=NOT_VERIFIED
;
; Успіх негативного свідка = результат ні (очікувана відмова).
; Якщо негативний набір раптом дає так — це регресія судді, не «зелений» тест.
; Жодних SID8/Sens8, числових літералів, Python/JS.

(визначити рівне?
  (функція (очікуване фактичне)
    (тотожне? очікуване фактичне)))

(визначити зібрати-пройшли
  (функція (тести)
    (за-умовою
      ((порожній? тести) (як-є ()))
      (так
        (за-умовою
          ((перше тести)
           (сполучити (перше тести) (зібрати-пройшли (решта тести))))
          (так (зібрати-пройшли (решта тести))))))))

(визначити зібрати-впали
  (функція (тести)
    (за-умовою
      ((порожній? тести) (як-є ()))
      (так
        (за-умовою
          ((хибне? (перше тести))
           (сполучити (перше тести) (зібрати-впали (решта тести))))
          (так (зібрати-впали (решта тести))))))))

(визначити суперечність?
  (функція (свідок)
    (хибне? свідок)))

(визначити очікувана-відмова?
  (функція (свідок)
    (суперечність? свідок)))

(визначити усі-відхилені?
  (функція (тести)
    (порожній? (зібрати-пройшли тести))))

(визначити негативний-набір-валідний?
  (функція (тести)
    (усі-відхилені? тести)))

; --- калібрування негативного шляху ---
; 1. ні є очікуваною відмовою
; 2. так НЕ є очікуваною відмовою
; 3. порожній негативний набір — валідний
; 4. набір (ні ні) — усі відхилені
; 5. набір (ні так) — НЕ усі відхилені
; 6. суперечність? на (рівне? так ні) → так

(за-умовою
  ((очікувана-відмова? ні)
   (за-умовою
     ((хибне? (очікувана-відмова? так))
      (за-умовою
        ((негативний-набір-валідний? (як-є ()))
         (за-умовою
           ((усі-відхилені? (сполучити ні (сполучити ні (як-є ()))))
            (за-умовою
              ((хибне?
                 (усі-відхилені?
                   (сполучити ні (сполучити так (як-є ())))))
               (за-умовою
                 ((суперечність? (рівне? так ні))
                  так)
                 (так (ні))))
              (так (ні))))
           (так (ні))))
        (так (ні))))
     (так (ні))))
  (так (ні)))
