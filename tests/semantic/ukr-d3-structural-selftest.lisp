; Д3: нативний Lisp-закон ATOM, CONS, CAR, CDR, EQ та COND.
; EQ працює тільки з атомами; складену пару перевіряємо через ATOM.
; Помилкова умова мусить привести до недопустимого CAR NIL.
; Ні Rust, ні Zig не встановлюють відповідь мовного закону.
(за-умовою
  ((атом? (як-є ()))
   (за-умовою
     ((атом? (сполучити (як-є ()) (як-є ())))
      (перше (як-є ())))
     (так
       (за-умовою
         ((тотожне?
            (перше (сполучити (як-є ()) (як-є ())))
            (як-є ()))
          (за-умовою
            ((тотожне?
               (решта (сполучити (як-є ()) (як-є ())))
               (як-є ()))
             (атом? (як-є ())))
            (так (перше (як-є ())))))
         (так (перше (як-є ())))))))
  (так (перше (як-є ()))))
