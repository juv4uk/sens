; Самоперевірка структурного закону Д3 українським Lisp.
; CAR(CDR(CONS(... CONS((), ())))) повертає структурний порожній список.
; Порожнечу перевіряємо «порожній?», не частковим Д3 EQ.
; Будь-яке порушення закону веде до недопустимого CAR NIL.

(за-умовою
  ((атом? (як-є ()))
   (за-умовою
     ((порожній?
        (перше
          (решта
            (сполучити (як-є (альфа бета))
              (сполучити (як-є ()) (як-є ()))))))
      так)
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))
