; Виконувана перевірка мовних законів Д3, а не тест механізму Rust/Zig.
; Результат визначає SENS: правильний шлях повертає названий атом;
; порушення будь-якого закону веде до недопустимого доступу до порожньої пари.
; Жодних цифрових голів, сирих кодів SID8/Sens8 або числових літералів.

(за-умовою
  ((атом? (як-є радіо))
   (за-умовою
     ((атом? (як-є (радіо антена))) (перше (як-є ())))
     (так
      (за-умовою
        ((тотожне?
           (перше (сполучити (як-є радіо) (як-є антена)))
           (як-є радіо))
         (за-умовою
           ((тотожне?
              (решта (сполучити (як-є радіо) (як-є антена)))
              (як-є антена))
            (за-умовою
              ((тотожне? (як-є радіо) (як-є антена))
               (перше (як-є ())))
              (так (як-є мовний-закон-виконано))))
           (так (перше (як-є ())))))
        (так (перше (як-є ())))))))
  (так (перше (як-є ()))))
