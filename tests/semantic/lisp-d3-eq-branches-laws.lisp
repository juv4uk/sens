; Д3 EQ приймає два допущені атоми: тотожні назви й різні назви.
; Д3 COND відкидає хибну гілку; D3 () перевіряє окремий предикат.
; Логічний оракул — Lisp/SENS, а не Rust або Zig.

(за-умовою
  ((тотожне? (як-є атом?) (як-є решта))
   (перше (як-є ())))
  ((тотожне? (як-є атом?) (як-є атом?))
   (за-умовою
     ((порожній? (як-є ())) так)
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))
