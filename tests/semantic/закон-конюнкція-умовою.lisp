; Логіка: конюнкція через за-умовою (обидві гілки істинні).

(визначити і
  (функція (ліве праве)
    (за-умовою
      (ліве праве)
      (так ні))))

(визначити свідок-конюнкції
  (функція ()
    (за-умовою
      ((тотожне?
         (і (тотожне? (як-є а) (як-є а)) (тотожне? (як-є б) (як-є б)))
         так)
       (за-умовою
         ((тотожне?
            (і (тотожне? (як-є а) (як-є а)) (тотожне? (як-є а) (як-є б)))
            ні)
          (як-є (закон-конюнкція (status pass))))
         (так (як-є (закон-конюнкція (status fail))))))
      (так (як-є (закон-конюнкція (status fail)))))))

(свідок-конюнкції)
