; D11 REASON INDEX: стабільний порядок кошиків і лінійний fallback.
; Виконання тільки через SENS із lib/unify.lisp і lib/reason.lisp.
; Однолітерні ключі p/q є D7 атомами; довгі D7-імена лишаються
; консервативно на лінійному шляху до окремого доказу індексації.
(визначити правила-доказового-індексу
  (як-є (((p а)) ((q б)) ((p в)))))
(визначити підготовлений-доказовий-індекс
  (побудувати-індекс-міркування правила-доказового-індексу))
(за-умовою
  ; Релізний свідок: прямий факт D7 має доводитися без журналу модулів.
  ; Якщо це не пара доказів, регресія у самому SENS-міркуванні.
  ((атом?
     (міркувати
       (як-є (людина сократ))
       (як-є (((людина сократ))))))
   ні)
  ; Вже створений індекс мусить лишатися індексом, а не правилами.
  ((хибне? (індекс-міркування? підготовлений-доказовий-індекс))
   ні)
  ; Неповний заголовок, зайве поле та D1-хвіст не є індексом.
  ((індекс-міркування? (як-є (reason-index-1))) ні)
  ((індекс-міркування? (як-є (reason-index-1 indexed))) ні)
  ((індекс-міркування? (як-є (reason-index-1 indexed ()))) ні)
  ((індекс-міркування? (як-є (reason-index-1 indexed () () зайве))) ні)
  ((індекс-міркування?
     (сполучити (як-є reason-index-1)
       (сполучити (як-є indexed)
         (сполучити (як-є ()) ні))))
   ні)
  ((індекс-міркування?
     (сполучити (як-є reason-index-1) ні))
   ні)
  ((хибне?
     (уніфікація-рівні?
       (міркування-зворот (як-є (а б а в)))
       (як-є (в а б а))))
   ні)
  ((хибне?
     (однакові?
       (режим-індексу-міркування підготовлений-доказовий-індекс)
       (як-є indexed)))
   ні)
  ((хибне?
     (уніфікація-рівні?
       (кандидати-індексу-міркування
         (як-є (p запит))
         підготовлений-доказовий-індекс)
       (як-є (((p а)) ((p в))))))
   ні)
  ((хибне?
     (уніфікація-рівні?
       (кандидати-індексу-міркування
         (як-є (var вільне))
         підготовлений-доказовий-індекс)
       правила-доказового-індексу))
   ні)
  ; Багатосимвольний D7-предикат не стає небезпечним ключем кошика.
  ((хибне?
     (однакові?
       (режим-індексу-міркування
         (побудувати-індекс-міркування
           (як-є (((мета а)) ((інша б))))))
       (як-є linear)))
   ні)
  (так так))
