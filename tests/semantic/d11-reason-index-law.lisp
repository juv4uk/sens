; D11 REASON INDEX: стабільний порядок кошиків і лінійний fallback.
; Виконання тільки через SENS із lib/unify.lisp і lib/reason.lisp.
(визначити правила-доказового-індексу
  (як-є (((мета а)) ((інша б)) ((мета в)))))
(визначити підготовлений-доказовий-індекс
  (побудувати-індекс-міркування правила-доказового-індексу))
(за-умовою
  ((хибне?
     (уніфікація-рівні?
       (міркування-зворот (як-є (а б а в)))
       (як-є (в а б а))))
   ні)
  ((хибне?
     (тотожне?
       (режим-індексу-міркування підготовлений-доказовий-індекс)
       (як-є indexed)))
   ні)
  ((хибне?
     (уніфікація-рівні?
       (кандидати-індексу-міркування
         (як-є (мета запит))
         підготовлений-доказовий-індекс)
       (як-є (((мета а)) ((мета в))))))
   ні)
  ((хибне?
     (уніфікація-рівні?
       (кандидати-індексу-міркування
         (як-є (var вільне))
         підготовлений-доказовий-індекс)
       правила-доказового-індексу))
   ні)
  (так так))
