; Д11 LIST=: N-арна рівність порівнює сусідні списки, не лише перший.
(визначити порівнювати-ліворуч
  (функція (лівий правий)
    (за-умовою
      ((тотожне? лівий правий) так)
      (лівий так)
      (так ні))))
(за-умовою
  ((усі-списки-рівні-за-порівнянням?
     порівнювати-ліворуч
     (список (список так) (список так) (список ні)))
   (за-умовою
     ((хибне?
        (усі-списки-рівні-за-порівнянням?
          порівнювати-ліворуч
          (список (список так) (список ні) (список так))))
      так)
     (так ні)))
  (так ні))
