; D4: закон лексичного захоплення та затінення параметра.
; SENS перевіряє точні D1-предикати, а не порівнює текстові D7-атоми через EQ.
; Позитивний закон дає D1:так; мутант змінює один аргумент і дає D1:ні.
(за-умовою
  ((((функція (зовнішній)
       (функція (внутрішній) зовнішній))
     (хибне? (атом? (як-є ()))))
    (хибне? (атом? (як-є ()))))
   (за-умовою
     ((((функція (зовнішній)
          (функція (зовнішній) зовнішній))
        (хибне? (атом? (як-є ()))))
       (атом? (як-є ())))
      так)
     (так ні)))
  (так ні))
