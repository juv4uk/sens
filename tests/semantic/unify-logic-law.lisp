; Виконуваний закон ЛОГІКИ мови СЕНС — структурна рівність і уніфікація.
;
; Це мовний семантичний свідок, а не оракул хост-мови: очікуваної відповіді
; в Rust/Python/shell НЕМАЄ. Самовердикт: хибний факт веде в (перше (як-є ())) —
; CAR порожнього, тобто невикличний вираз, і SENS сам відкидає свідок.
;
; Перевіряємо ядро lib/unify.lisp укр-проєкцією:
;   уніфікація-рівні?, змінна?, логічна-змінна, підстановка-позначає-невдачу?,
;   входить-перевірити? (occurs-check), уніфікувати.

; Рівність: символ рівний собі.
(за-умовою
  ((тотожне? (уніфікація-рівні? (як-є a) (як-є a)) так) так)
  (так (перше (як-є ()))))

; Рівність: різні символи не рівні.
(за-умовою
  ((тотожне? (уніфікація-рівні? (як-є a) (як-є b)) ні) так)
  (так (перше (як-є ()))))

; Рівність: однакові списки рівні.
(за-умовою
  ((тотожне? (уніфікація-рівні? (як-є (a b)) (як-є (a b))) так) так)
  (так (перше (як-є ()))))

; Рівність: списки з різним хвостом не рівні.
(за-умовою
  ((тотожне? (уніфікація-рівні? (як-є (a b)) (як-є (a c))) ні) так)
  (так (перше (як-є ()))))

; Змінна: (var x) є логічною змінною.
(за-умовою
  ((тотожне? (змінна? (як-є (var x))) так) так)
  (так (перше (як-є ()))))

; Змінна: символ не є логічною змінною.
(за-умовою
  ((тотожне? (змінна? (як-є a)) ні) так)
  (так (перше (як-є ()))))

; Невдача: символ fail позначає невдачу підстановки.
(за-умовою
  ((тотожне? (підстановка-позначає-невдачу? (як-є fail)) так) так)
  (так (перше (як-є ()))))

; Невдача: порожній список не позначає невдачу.
(за-умовою
  ((тотожне? (підстановка-позначає-невдачу? (як-є ())) ні) так)
  (так (перше (як-є ()))))

; Occurs-check: змінна x входить у терм (f x).
(за-умовою
  ((тотожне? (входить-перевірити? (як-є (var x)) (як-є (f (var x))) (як-є ())) так) так)
  (так (перше (як-є ()))))

; Уніфікація: різні атоми дають невдачу.
(за-умовою
  ((тотожне? (підстановка-позначає-невдачу? (уніфікувати (як-є a) (як-є b) (як-є ()))) так) так)
  (так (перше (як-є ()))))

; Уніфікація: однакові атоми не дають невдачі.
(за-умовою
  ((тотожне? (підстановка-позначає-невдачу? (уніфікувати (як-є a) (як-є a) (як-є ()))) ні) так)
  (так (перше (як-є ()))))
