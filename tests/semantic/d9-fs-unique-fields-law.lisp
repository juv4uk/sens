; D9 F6: обов'язкові поля мають єдиний ключ.
; SENS підтверджує правильні пакети та відмовляє дублікатам.
(визначити свідок-кореня-д9
  (фс-корінь-пакет (фс-порожній)))
(визначити свідок-об'єкта-д9
  (фс-об'єкт-пакет (як-є а)))
(визначити свідок-дубля-кореня-д9
  (сполучити
    (сполучити (як-є format) (як-є wsm-fs-root))
    свідок-кореня-д9))
(визначити свідок-дубля-об'єкта-д9
  (сполучити
    (сполучити (як-є version) *версія-формату-фс*)
    свідок-об'єкта-д9))
(за-умовою
  ((однакові?
     (перше (рішення-щодо-кореневого-пакета-файлової-системи
               свідок-кореня-д9))
     (як-є accepted))
   (за-умовою
     ((однакові?
        (перше (рішення-щодо-пакета-об'єкта-файлової-системи
                  свідок-об'єкта-д9))
        (як-є accepted))
      (за-умовою
        ((однакові?
           (перше (рішення-щодо-кореневого-пакета-файлової-системи
                     свідок-дубля-кореня-д9))
           (як-є rejected))
         (однакові?
           (перше (рішення-щодо-пакета-об'єкта-файлової-системи
                     свідок-дубля-об'єкта-д9))
           (як-є rejected)))
        (так ні)))
     (так ні)))
  (так ні))
