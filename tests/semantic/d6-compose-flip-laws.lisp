; D6:001011 COMPOSE and D6:101101 FLIP are Lisp-owned D4 LAMBDA derivations.
; These are callable ordinary SENS functions, not direct native D6 opcodes.
; Eight positive/falsifier laws: exact D1:YES iff the order is right.
(list
  ; COMPOSE(f,g)(x) = f(g(x)); CDR then CAR yields the second item.
  (тотожне? ((скласти-функції
          (функція (x) (перше x))
          (функція (x) (решта x)))
        (як-є (ліве праве)))
       (як-є праве))
  (not? (тотожне? ((скласти-функції
                (функція (x) (перше x))
                (функція (x) (решта x)))
              (як-є (ліве праве)))
            (як-є ліве)))
  ; The composed closure captures independently supplied f and g.
  (тотожне? ((скласти-функції
          (функція (x) (перше x))
          (функція (x) (сполучити x (як-є ()))))
        (як-є значення))
       (як-є значення))
  (not? (тотожне? ((скласти-функції
                (функція (x) (перше x))
                (функція (x) (сполучити x (як-є ()))))
              (як-є значення))
            (як-є інше)))
  ; FLIP(f)(a,b) = f(b,a); result is the reversed two-element list.
  (тотожне? (перше ((поміняти-аргументи
               (функція (a b) (сполучити a (сполучити b (як-є ())))))
             (як-є ліве) (як-є праве)))
       (як-є праве))
  (тотожне? (перше (решта ((поміняти-аргументи
                    (функція (a b) (сполучити a (сполучити b (як-є ())))))
                  (як-є ліве) (як-є праве)))
       (як-є ліве)))
  (not? (тотожне? (перше ((поміняти-аргументи
                     (функція (a b) (сполучити a (сполучити b (як-є ())))))
                   (як-є ліве) (як-є праве)))
             (як-є ліве)))
  (not? (тотожне? (перше (решта ((поміняти-аргументи
                          (функція (a b) (сполучити a (сполучити b (як-є ())))))
                        (як-є ліве) (як-є праве)))
              (як-є праве)))))
