; Шість законів вибору складників незмінного сховища.
; Позитивні перевірки повертають правильний складник.
; Негативні перевірки відхиляють неправильно вибрані складники.

(список
  (однакові? (фс-об'єкти (список (як-є сховище) (як-є відповідності) (як-є версія)))
          (як-є сховище))
  (однакові? (фс-зв'язки (список (як-є сховище) (як-є відповідності) (як-є версія)))
          (як-є відповідності))
  (однакові? (фс-ревізія (список (як-є сховище) (як-є відповідності) (як-є версія)))
          (як-є версія))
  (однакові? (фс-об'єкти (список (список (як-є а) (як-є б))
                            (список (як-є шлях) (як-є адреса)) (як-є версія)))
          (список (як-є а) (як-є б)))
  (хибне? (однакові? (фс-зв'язки (список (як-є сховище) (як-є відповідності) (як-є версія)))
                (як-є сховище)))
  (хибне? (однакові? (фс-ревізія (список (як-є сховище) (як-є відповідності) (як-є версія)))
                (як-є відповідності))))
