; Живий SENS/D8 закон: десять точних символів і текстових порівнянь.
; Замість host Unicode-рядків джерело користується ратифікованою D7
; клавіатурою: QUOTE символа → D8 SYMBOL->STRING. Unicode не транспортується.
; Порожній текст — результат дійсного D9 STRING-REST односимвольного.
; Кожна умова має справжній D1 позитив і негатив, без списку «можливо».
(визначити текст-а (символ-у-текст (як-є а)))
(визначити текст-б (символ-у-текст (як-є б)))
(визначити текст-абв (символ-у-текст (як-є абв)))
(визначити текст-абг (символ-у-текст (як-є абг)))
(визначити порожній-текст (рядок-решта текст-а))
(за-умовою
  ((символ-менший? текст-а текст-б)
   (за-умовою
     ((хибне? (символ-менший? текст-б текст-а))
      (за-умовою
        ((символ-більший? текст-б текст-а)
         (за-умовою
           ((хибне? (символ-більший? текст-а текст-б))
            (за-умовою
              ((символ-рівний? текст-а текст-а)
               (за-умовою
                 ((хибне? (символ-рівний? текст-а текст-б))
                  (за-умовою
                    ((текст-рівний? текст-абв текст-абв)
                     (за-умовою
                       ((хибне? (текст-рівний? текст-абв текст-абг))
                        (за-умовою
                          ((хибне? (текст-рівний? текст-абг текст-абв))
                           (за-умовою
                             ((текст-рівний? порожній-текст порожній-текст)
                              (атом? (як-є ())))
                             ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                          ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                       ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                    ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                 ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
              ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
           ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
        ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
     ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
