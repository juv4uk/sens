; D6 MAPLIST: послідовні суфікси; порожня структура не запускає callback.
(за-умовою
  ((однакові?
     (відобразити-залишки
       (список так ні)
       (функція (хвіст) (перше хвіст)))
     (список так ні))
   (за-умовою
     ((порожній?
        (відобразити-залишки
          (як-є ())
          (функція (хвіст) (решта (як-є ())))))
      так)
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))
