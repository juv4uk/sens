; Закони відображення й відсіювання у шостому домені.
; Перевіряємо збереження порядку та неправильні перестановки і предикати.

(визначити проба-відобразити
  (функція (елемент) (сполучити (як-є м) елемент)))
(визначити проба-відсіяти
  (функція (елемент) (тотожне? елемент (як-є б))))
(список
  (однакові? (відобразити проба-відобразити (список (як-є а) (як-є б)))
          (список (сполучити (як-є м) (як-є а)) (сполучити (як-є м) (як-є б))))
  (хибне? (однакові? (відобразити проба-відобразити (список (як-є а) (як-є б)))
                (список (сполучити (як-є м) (як-є б)) (сполучити (як-є м) (як-є а)))))
  (однакові? (відсіяти проба-відсіяти (список (як-є а) (як-є б) (як-є в)))
          (список (як-є б)))
  (хибне? (однакові? (відсіяти проба-відсіяти (список (як-є а) (як-є б) (як-є в)))
                (список (як-є а))))
  (однакові? (відобразити проба-відобразити (як-є ())) (як-є ()))
  (однакові? (відсіяти проба-відсіяти (як-є ())) (як-є ())))
