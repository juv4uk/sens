; D8:01000111 MAP-ANY — похідний D1-закон короткого замикання через D6 ANY.
; 8 точних D1 результатів; порожні та асиметричні списки, негатив результату.
(список
  (хибне? (відобразити-доки-істина (lambda (x) (тотожне? x (quote є))) (quote ())))
  (відобразити-доки-істина (lambda (x) (тотожне? x (quote є)))
                           (список (quote нема) (quote є)))
  (хибне? (відобразити-доки-істина (lambda (x) (тотожне? x (quote є)))
                                 (список (quote нема) (quote ні))))
  (відобразити-доки-істина (lambda (x) (тотожне? x (quote є)))
                           (список (quote є) (quote нема)))
  (equal? (відобразити-доки-істина (lambda (x) (тотожне? x (quote є)))
                                    (список (quote є)))
          (будь-яке? (lambda (x) (тотожне? x (quote є))) (список (quote є))))
  (equal? (відобразити-доки-істина (lambda (x) (тотожне? x (quote є))) (quote ()))
          (будь-яке? (lambda (x) (тотожне? x (quote є))) (quote ())))
  (хибне? (відобразити-доки-істина (lambda (x) (тотожне? x (quote є)))
                                 (список (quote ні) (quote ні))))
  (відобразити-доки-істина (lambda (x) (тотожне? x (quote є)))
                           (список (quote ні) (quote є) (quote ні))))

