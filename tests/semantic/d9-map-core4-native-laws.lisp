; Вісім перевірок незмінної мапи з чинного ядра СЕНС.
; Третя відповідь навмисно хибна, бо ключ відсутній.
; Прямі визначення ратифікованих функцій не дублюються.

(список
  (однакові? (мапа-порожній) (як-є ()))
  (мапа-містить? (як-є ключ)
    (список (список (як-є ключ) (як-є значення))))
  (мапа-містить? (як-є відсутній)
    (список (список (як-є ключ) (як-є значення))))
  (однакові?
    (мапа-отримати (як-є ключ) (список (список (як-є ключ) (як-є значення))))
    (список (як-є значення)))
  (порожній?
    (мапа-отримати (як-є відсутній)
      (список (список (як-є ключ) (як-є значення)))))
  (однакові?
    (мапа-список (список (список (як-є ключ) (як-є значення))))
    (список (список (як-є ключ) (як-є значення))))
  (однакові?
    (мапа-отримати (як-є ключ) (список (список (як-є ключ) (як-є значення))))
    (список (як-є значення)))
  (однакові? (мапа-список (мапа-порожній)) (як-є ())))
