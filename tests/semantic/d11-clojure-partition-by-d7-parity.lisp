; Д7: закони Clojure partition-by для текстових символів.
; Одногліфові D7-значення є елементами даних; усі D2-обрамлення будуємо
; явним СПИСОК, щоб фізичний T5M не мусив вгадувати цитовану Text7-структуру.
; Позитив перевіряє атомну суміжність; негатив забороняє злити атоми через пару.

; предикат-атомність: закон.
(за-умовою
  ((однакові?
     (групувати-суміжні-за-ключем
       (функція (елемент) (атом? елемент))
       (список
         (як-є а)
         (як-є б)
         (список (як-є в))
         (список (як-є г))
         (як-є д)))
     (список
       (список (як-є а) (як-є б))
       (список (список (як-є в)) (список (як-є г)))
       (список (як-є д))))
   (порожній? (як-є ())))
  ((порожній? (як-є ())) (перше (як-є ()))))

; предикат-атомність-негатив: атоми по різні боки пари не суміжні.
; Очікування навмисно хибне: воно об'єднує перший і останній атом,
; хоча між ними стоїть окрема структурна серія.
(за-умовою
  ((хибне?
     (однакові?
       (групувати-суміжні-за-ключем
         (функція (елемент) (атом? елемент))
         (список (як-є а) (список (як-є в)) (як-є б)))
       (список
         (список (як-є а) (як-є б))
         (список (список (як-є в))))))
   (порожній? (як-є ())))
  ((порожній? (як-є ())) (перше (як-є ()))))

(атом? (як-є ()))
