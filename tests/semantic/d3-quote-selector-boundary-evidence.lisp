; #1968 / #2011 / #2016: живі обмежені свідки, НЕ ратифікація T0/T1.
; D3 QUOTE зберігає конкретний атом/список: без payload закон не породжує дані.
; CAR/CDR: позитивний контроль композиції з точних атомів та пар.
; Усі вердикти породжує сам SENS. Хибний закон => справжній CAR NIL.

; QUOTE атома — атом; QUOTE пари — не атом. Людський напис не є семантикою.
(за-умовою
 ((атом? (як-є атом?)) (атом? (як-є ())))
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (атом? (як-є (атом? решта)))) (атом? (як-є ())))
 (так (перше (як-є ()))))

; Однаковий QUOTE-оператор на різних payload не ототожнює атоми.
(за-умовою
 ((хибне? (тотожне? (як-є атом?) (як-є решта))) (атом? (як-є ())))
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (як-є атом?) (як-є атом?)) (атом? (як-є ())))
 (так (перше (як-є ()))))

; CAR(CONS(a,b)) = a та CDR(CONS(a,b)) = b для атомних результатів.
(за-умовою
 ((тотожне?
    (перше (сполучити (як-є атом?) (як-є решта)))
    (як-є атом?)) (атом? (як-є ())))
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
    (решта (сполучити (як-є атом?) (як-є решта)))
    (як-є решта)) (атом? (як-є ())))
 (так (перше (як-є ()))))

; CAR(CDR(CONS(a,CONS(b,NIL)))) = b: селекторна композиція діє.
(за-умовою
 ((тотожне?
    (перше (решта (сполучити (як-є атом?)
      (сполучити (як-є решта) (як-є ())))))
    (як-є решта)) (атом? (як-є ())))
 (так (перше (як-є ()))))

; Глибша композиція CDR(CDR(...)) повертає NIL, а не D1 і не D24 нуль.
(за-умовою
 ((тотожне?
    (решта (решта (сполучити (як-є атом?)
      (сполучити (як-є решта) (як-є ())))))
    (як-є ())) (атом? (як-є ())))
 (так (перше (як-є ()))))

; Останнє значення — обчислена в самому SENS однобітна істина.
(атом? (як-є ()))
