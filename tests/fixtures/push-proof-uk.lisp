; Доказ пушу реального виконуваного джерела.

; Точні числа D24+ отримуємо із довжини списків.
(визначити доказ-число-два (довжина (як-є (а б))))
(визначити доказ-число-чотири (довжина (як-є (а б в г))))

(визначити доказ-пушу
  (функція ()
    (за-умовою
      ((тотожне? (додати доказ-число-два доказ-число-два) доказ-число-чотири)
       (як-є (push-proof (status pass))))
      (так (як-є (push-proof (status fail)))))))

(доказ-пушу)
