; Свідок післяядрового матеріалізування проєкцій #469.
; Мовне джерело семантики — ратифіковані таблиці драбини Д1–Д10.
; Власні визначення, локальні зв'язування та рекурсивні виклики українською.
; Статуси, читання реєстру, зовнішній механізм та пробні назви проєкцій
; залишаються такими, як їх визначає початковий протокол свідчень.
;
(завантажити-файл "lib/surface/semantic-registry-api.lisp")

(визначити післяядрова-форма-джерела
  (прочитати-семантичний-реєстр))

(визначити післяядрові-рядки-джерела післяядрова-форма-джерела)

(визначити післяядровий-стан-наявності
  (функція (шукане елементи)
    (за-умовою
      ((атом? елементи) (як-є absent))
      (так
       (за-умовою
         ((тотожне? шукане (перше елементи)) (як-є present))
         (так (післяядровий-стан-наявності шукане (решта елементи))))))))

(визначити післяядровий-знайти-рядок-джерела
  (функція (семантична-ідентичність рядки)
    (за-умовою
      ((атом? рядки) (як-є ()))
      (так
       (нехай ((рядок (перше рядки)))
         (за-умовою
           ((однакові? семантична-ідентичність (перше рядок)) рядок)
           (так (післяядровий-знайти-рядок-джерела семантична-ідентичність (решта рядки)))))))))

(визначити післяядрові-проєкції-зі-станом-до
  (функція (стан проєкції накопичувач)
    (за-умовою
      ((атом? проєкції) (реверс накопичувач))
      (так
       (нехай ((проєкція (перше проєкції))
              (назва (друге проєкція))
              (стан-проєкції (третє проєкція)))
         (за-умовою
           ((тотожне? стан-проєкції стан)
            (за-умовою
              ((тотожне? назва (як-є —))
               (післяядрові-проєкції-зі-станом-до стан (решта проєкції) накопичувач))
              (так
               (за-умовою
                 ((тотожне? (післяядровий-стан-наявності назва накопичувач) (як-є present))
                  (післяядрові-проєкції-зі-станом-до стан (решта проєкції) накопичувач))
                 ((тотожне? (післяядровий-стан-наявності назва накопичувач) (як-є absent))
                  (післяядрові-проєкції-зі-станом-до
                    стан (решта проєкції) (сполучити назва накопичувач)))))))
           (так (післяядрові-проєкції-зі-станом-до стан (решта проєкції) накопичувач))))))))

(визначити післяядрові-проєкції-зі-станом
  (функція (стан рядок-реєстру)
    (за-умовою
      ((атом? рядок-реєстру) (як-є ()))
      (так (післяядрові-проєкції-зі-станом-до стан (решта рядок-реєстру) (як-є ()))))))

(визначити післяядрова-помилка-свідка
  (функція (випадок фактичне очікуване)
    (список
      (як-є postcore-peer-materialization-witness)
      (як-є (status fail))
      (список (як-є case) випадок)
      (список (як-є actual) фактичне)
      (список (як-є expected) очікуване))))

(визначити післяядрові-перевірити-рядки
  (функція (рядки)
    (за-умовою
      ((атом? рядки)
       (як-є (postcore-peer-materialization-witness (status pass))))
      (так
       (нехай ((рядок (перше рядки)))
         (за-умовою
           ((однакові? (друге рядок) (третє рядок))
            (післяядрові-перевірити-рядки (решта рядки)))
           (так
            (післяядрова-помилка-свідка
              (перше рядок)
              (друге рядок)
              (третє рядок)))))))))

(визначити післяядрова-перша-фаза
  (післяядрові-перевірити-рядки
    (список
      (список
        (як-є українська-та-англійська-проєкції)
        (ідентичність-у-семантичному-реєстрі
          післяядрові-рядки-джерела (як-є узгоджений-час-з-юнікс))
        (ідентичність-у-семантичному-реєстрі
          післяядрові-рядки-джерела (як-є utc-from-unix)))
      (список
        (як-є чинний-домен-часу)
        (перше
          (ідентичність-у-семантичному-реєстрі
            післяядрові-рядки-джерела (як-є узгоджений-час-з-юнікс)))
        (як-є д9))
      (список
        (як-є нератифікована-проєкція-відхилена)
        (атом?
          (ідентичність-у-семантичному-реєстрі
            післяядрові-рядки-джерела
            (як-є всесвітній-координований-час-із-часу-юнікс)))
        (атом? (як-є ()))))))
; Сумісні історичні зв'язування до тих самих мовних значень.
(визначити postcore-authority-form післяядрова-форма-джерела)
(визначити postcore-authority-rows післяядрові-рядки-джерела)
(визначити postcore-member-status післяядровий-стан-наявності)
(визначити postcore-find-authority-row післяядровий-знайти-рядок-джерела)
(визначити postcore-surfaces-with-status-onto післяядрові-проєкції-зі-станом-до)
(визначити postcore-surfaces-with-status післяядрові-проєкції-зі-станом)
(визначити postcore-witness-failure післяядрова-помилка-свідка)
(визначити postcore-check-rows післяядрові-перевірити-рядки)
(визначити postcore-phase-one післяядрова-перша-фаза)

післяядрова-перша-фаза
