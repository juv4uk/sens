; Свідчення #1096: чинні Д5-функції через українську проєкцію.
; Історична назва файла є адресою тесту, не восьмибітним кодом.
; Два різні шляхи до одного числа і відмінний негативний результат.
; Обчислення здійснює СЕНС, а не Python/JSON або старий SID8.

(визначити сума-за-чинним-законом (додати 2 3))
(визначити сума-через-інший-ланцюг-д5
  (відняти (додати 3 4) 2))
(визначити відмінний-результат
  (відняти (додати 3 4) 1))

(за-умовою
  ((хибне? (тотожне?
             сума-за-чинним-законом
             сума-через-інший-ланцюг-д5))
   (як-є (bare-sid-literal-witness
           (status fail)
           (reason d5-sum-equivalence))))
  ((тотожне? сума-за-чинним-законом відмінний-результат)
   (як-є (bare-sid-literal-witness
           (status fail)
           (reason d5-negative-collision))))
  (так
   (як-є (bare-sid-literal-witness (status pass)))))
