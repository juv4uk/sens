; #220/#287 — епістемічні відношення та закони структури належать Lisp.
; Rust виконує свідка й читає його іменований статус, але не визначає
; семантичний очікуваний результат структурної рівності й тотожності.
;
; Рядки зберігають закони, раніше приховані перевірками Rust `== "t"`:
; підтверджувальний-доказ повертає конкретний відповідний запис; канонічні
; епістемічні записи зберігають точну тотожність при D3 CAR/CDR/CONS.
; JSON false/null — окрема Rust-механічна межа parse_json; вона не є
; частиною цього Lisp-свідка, бо D9 JSON-PARSE ще не має викличного SENS-механізму.

; D1/D8-закони лишаються у Lisp; текстовий READ/WRITE не є двійковим
; транспортом доменних тотожностей. Його перевіряємо лише для даних D7.
; Повний Lisp → Zig/T5M → SENS roundtrip звіряє фізичний CI.
; Довгий D6 LET/LET* більше не є передумовою виконання свідка.
(визначити епістемічні-рядки-зі-значень
  (функція
    (просте-посилання-на-твердження простий-доказ
     структурне-посилання-на-твердження структурний-доказ
     спостереження твердження доказ намір)
      (список
        (список
          (як-є supporting-evidence-simple)
          (однакові? (підтверджувальний-доказ простий-доказ просте-посилання-на-твердження) простий-доказ)
          епістеміка--так)
        (список
          (як-є supporting-evidence-structural)
          (однакові? (підтверджувальний-доказ структурний-доказ структурне-посилання-на-твердження) структурний-доказ)
          епістеміка--так)
        (список
          (як-є observation-cons-inverse)
          (однакові? (сполучити (перше спостереження) (решта спостереження)) спостереження)
          епістеміка--так)
        (список
          (як-є claim-cons-inverse)
          (однакові? (сполучити (перше твердження) (решта твердження)) твердження)
          епістеміка--так)
        (список
          (як-є evidence-cons-inverse)
          (однакові? (сполучити (перше доказ) (решта доказ)) доказ)
          епістеміка--так)
        (список
          (як-є intent-cons-inverse)
          (однакові? (сполучити (перше намір) (решта намір)) намір)
          епістеміка--так)
        ; D8:11110100 WRITE-TO-STRING будує канонічну текстову проєкцію,
        ; а не оборотний транспорт точних D7-тотожностей. Цитований
        ; текстовий літерал є D2-структурою D7-гліфів; WRITE подає її
        ; людським поданням, а D8:11101010 READ проєкції повертає числа,
        ; не ті самі D7-координати. Точний закон тут — межа:
        ; READ∘WRITE НЕ відновлює точну D7-структуру.
        ; Оборотність канонічного носія окремо доводить порожній D3-список.
        (список
          (як-є d7-text-read-write-boundary)
          (хибне?
            (однакові?
              (прочитати (значення-у-текст (як-є "sha256:abc")))
              (як-є "sha256:abc")))
          епістеміка--так)
        (список
          (як-є empty-list-round-trip)
          (однакові? (прочитати (значення-у-текст (як-є ()))) (як-є ()))
          епістеміка--так)
        ; D1 — контекстний предикат, не значення для WRITE-TO-STRING.
        ; Його серіалізація має дати Type (окремий негативний свідок).
        ; Тут окремо доводимо точну істину/хибність самої мови.
        (список
          (як-є eq-result-exact-d1)
          (однакові? (тотожне? (як-є а) (як-є а))
            (порожній? (як-є ())))
          епістеміка--так)
        ; У мінімальному корпусі доступна точна D24+ одиниця;
        ; двійку будуємо додаванням, без неімпортованого Time і D6 LENGTH.
        (список
          (як-є exact-less-false-d1)
          (однакові?
            (менше? (додати число-один число-один) число-один)
            (хибне? (порожній? (як-є ()))))
          епістеміка--так)
        (список
          (як-є exact-less-true-d1)
          (однакові?
            (менше? число-один (додати число-один число-один))
            (порожній? (як-є ())))
          епістеміка--так)
        ; Перевірка форми посилання — виконуваний семантичний контракт.
        (список (як-є source-ref-digest-valid)
          (це-належне-посилання-на-джерело? (список (як-є digest) (як-є packet)))
          епістеміка--так)
        (список (як-є source-ref-proof-valid)
          (це-належне-посилання-на-джерело? (список (як-є proof) (як-є packet)))
          епістеміка--так)
        (список (як-є source-ref-unknown-tag-rejected)
          (це-належне-посилання-на-джерело? (список (як-є unknown) (як-є packet)))
          епістеміка--ні)
        (список (як-є source-ref-nested-head-rejected)
          (це-належне-посилання-на-джерело? (список (список (як-є digest)) (як-є packet)))
          епістеміка--ні)
        (список (як-є source-ref-empty-rejected)
          (це-належне-посилання-на-джерело? (як-є ()))
          епістеміка--ні)
        (список (як-є source-ref-extra-field-rejected)
          (це-належне-посилання-на-джерело? (список (як-є digest) (як-є packet) (як-є extra)))
          епістеміка--ні)
        (список (як-є source-ref-dotted-tail-rejected)
          (це-належне-посилання-на-джерело? (сполучити (як-є digest)
            (сполучити (як-є packet) (атом? (як-є ())))))
          епістеміка--ні)
        (список (як-є claim-ref-valid)
          (епістеміка--посилання-на-твердження? (список (як-є claim-ref) (як-є packet)))
          епістеміка--так)
        (список (як-є claim-ref-unknown-tag-rejected)
          (епістеміка--посилання-на-твердження? (список (як-є other-ref) (як-є packet)))
          епістеміка--ні)
        (список (як-є claim-ref-extra-field-rejected)
          (епістеміка--посилання-на-твердження? (список (як-є claim-ref) (як-є packet) (як-є extra)))
          епістеміка--ні)
        (список (як-є claim-ref-dotted-tail-rejected)
          (епістеміка--посилання-на-твердження? (сполучити (як-є claim-ref)
            (сполучити (як-є packet) (атом? (як-є ())))))
          епістеміка--ні)
        (список (як-є claim-ref-empty-rejected)
          (епістеміка--посилання-на-твердження? (список (як-є claim-ref)))
          епістеміка--ні)
        ; Логічні вимоги перевіряють весь список, а не тільки першу комірку.
        (список (як-є requirements-empty-is-satisfied)
          (епістеміка--усі-вимоги-наявні? (як-є ()) (як-є ()))
          епістеміка--так)
        (список (як-є requirements-present-is-satisfied)
          (епістеміка--усі-вимоги-наявні? (список (як-є читання)) (список (як-є читання)))
          епістеміка--так)
        (список (як-є requirements-missing-is-not-satisfied)
          (епістеміка--усі-вимоги-наявні? (список (як-є читання)) (список (як-є запис)))
          епістеміка--ні)
        (список (як-є requirements-atomic-tail-is-rejected)
          (епістеміка--усі-вимоги-наявні? (атом? (як-є ())) (список (як-є читання)))
          епістеміка--ні)
        (список (як-є requirements-dotted-tail-is-rejected)
          (епістеміка--усі-вимоги-наявні? (сполучити (як-є читання) (атом? (як-є ()))) (список (як-є читання)))
          епістеміка--ні)
        ; Рівність вкладених посилань розрізняє значення та форму.
        (список (як-є nested-reference-equal)
          (епістеміка--рівні-посилання? (список (як-є а) (список (як-є б) (як-є в))) (список (як-є а) (список (як-є б) (як-є в))))
          епістеміка--так)
        (список (як-є nested-reference-different-leaf)
          (епістеміка--рівні-посилання? (список (як-є а) (список (як-є б) (як-є в))) (список (як-є а) (список (як-є б) (як-є г))))
          епістеміка--ні)
        (список (як-є nested-reference-shape-mismatch)
          (епістеміка--рівні-посилання? (список (як-є а) (список (як-є б))) (список (як-є а) (як-є б)))
          епістеміка--ні)
        (список (як-є nested-reference-empty-equal)
          (епістеміка--рівні-посилання? (як-є ()) (як-є ()))
          епістеміка--так))))

; D1/D3: негативний закон для атомарного переліку вимог використовує
; точне значення АТОМ?, бо багатогліфне цитоване ім'я в D7 є послідовністю
; кодів, а не атомом. Крапкова пара також має точний атомарний хвіст D1.

; Незалежні входи зв'язує D4 виклик; залежні докази виникають у Lisp.
(визначити епістемічні-рядки-зі-джерел
  (функція
    (просте-посилання-на-твердження структурне-посилання-на-твердження
     спостереження твердження доказ намір)
    (епістемічні-рядки-зі-значень
      просте-посилання-на-твердження
      (створити-доказ
        просте-посилання-на-твердження
        (як-є live-test)
        (як-є supports)
        (список (як-є digest) (як-є "d")))
      структурне-посилання-на-твердження
      (створити-доказ
        структурне-посилання-на-твердження
        (як-є live-test)
        (як-є supports)
        (список (як-є digest) (як-є "d")))
      спостереження твердження доказ намір)))

(визначити епістемічні-рядки
  (функція ()
    (епістемічні-рядки-зі-джерел
      (список (як-є claim-ref) (як-є cml-build-available))
      (список (як-є claim-ref) (список (як-є claim) (список (як-є statement) (список (як-є build) (як-є cml) (як-є succeeds))) (список (як-є source) (список (як-є observation) (як-є local-run))) (список (як-є review) (як-є proposed))))
      (створити-спостереження
        (список (як-є digest) (як-є "sha256:abc"))
        (список (як-є build) (як-є cml) (як-є succeeds)))
      (створити-твердження
        (список (як-є build) (як-є cml) (як-є succeeds))
        (список (як-є observation) (як-є local-run))
        (як-є proposed))
      (створити-доказ
        (список (як-є claim-ref) (як-є cml-build-available))
        (як-є live-test)
        (як-є supports)
        (список (як-є test) (список (як-є fixture) (як-є conformance.my)) (список (як-є case) (як-є exact-rational-division))))
      (створити-намір
        (список (як-є build) (як-є cml))
        (список (як-є process:cargo) (як-є tcp-client))
        (список (як-є missing-capability))
        (список (як-є build-artifact) (як-є cml))))))

; Перевірка одного рядка — звичайна D4-функція, не тимчасовий D6 LET.
; Так SENS отримує дані рядка явним аргументом, без додаткового
; макророзгортання і без хостового семантичного оракула.
(визначити перевірити-один-епістемічний-рядок
  (функція (рядок решта-рядків)
    (за-умовою
      ((свідок-рівні? (друге рядок) (третє рядок))
       (перевірити-епістемічні-рядки решта-рядків))
      ((хибне? (свідок-рівні? (друге рядок) (третє рядок)))
       (список
         (як-є epistemic-authority-witness)
         (список (як-є status) (як-є fail))
         (список (як-є case) (перше рядок))
         (список (як-є actual) (друге рядок))
         (список (як-є expected) (третє рядок)))))))

(визначити перевірити-епістемічні-рядки
  (функція (рядки)
    (за-умовою
      ((порожній? рядки)
       (список (як-є epistemic-authority-witness) (список (як-є status) (як-є pass))))
      ((атом? рядки)
       (список
         (як-є epistemic-authority-witness)
         (список (як-є status) (як-є fail))
         (список (як-є case) (як-є malformed-row-tail))
         (список (як-є actual) рядки)))
      ((хибне? (атом? рядки))
       (перевірити-один-епістемічний-рядок
         (перше рядки) (решта рядки))))))

(визначити свідок-епістеміки
  (функція ()
    (перевірити-епістемічні-рядки (епістемічні-рядки))))
