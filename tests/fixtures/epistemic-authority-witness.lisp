; #220/#287 — епістемічні відношення та перевірки зворотного читання належать Lisp.
; Rust виконує свідка й читає його іменований статус, але не визначає
; семантичний очікуваний результат структурної рівності й тотожності.
;
; Рядки зберігають закони, раніше приховані перевірками Rust `== "t"`:
; підтверджувальний-доказ повертає конкретний відповідний запис; канонічні
; епістемічні записи й результати ядра переживають запис/читання; зовнішнє
; JSON Bool(false) лишається відмінним від прочитаного назад ().

(визначити епістемічні-рядки
  (функція ()
    (нехай-послідовно ((просте-посилання-на-твердження (як-є (claim-ref cml-build-available)))
           (простий-доказ
             (створити-доказ
               просте-посилання-на-твердження
               (як-є live-test)
               (як-є supports)
               (як-є (digest "d"))))
           (структурне-посилання-на-твердження
             (як-є
               (claim-ref
                 (claim
                   (statement (build cml succeeds))
                   (source (observation local-run))
                   (review proposed)))))
           (структурний-доказ
             (створити-доказ
               структурне-посилання-на-твердження
               (як-є live-test)
               (як-є supports)
               (як-є (digest "d"))))
           (спостереження
             (створити-спостереження
               (як-є (digest "sha256:abc"))
               (як-є (build cml succeeds))))
           (твердження
             (створити-структуроване-твердження
               (як-є (build cml succeeds))
               (як-є (observation local-run))
               (як-є proposed)))
           (доказ
             (створити-доказ
               (як-є (claim-ref cml-build-available))
               (як-є live-test)
               (як-є supports)
               (як-є (test (fixture conformance.my) (case exact-rational-division)))))
           (намір
             (створити-намір
               (як-є (build cml))
               (як-є (process:cargo tcp-client))
               (як-є (missing-capability))
               (як-є (build-artifact cml)))))
      (список
        (список
          (як-є supporting-evidence-simple)
          (однакові? (підтверджувальний-доказ простий-доказ просте-посилання-на-твердження) простий-доказ)
          епістеміка--так)
        (список
          (як-є supporting-evidence-structural)
          (однакові? (підтверджувальний-доказ структурний-доказ структурне-посилання-на-твердження) структурний-доказ)
          епістеміка--так)
        (список
          (як-є observation-round-trip)
          (однакові? (прочитати (значення-у-текст спостереження)) спостереження)
          епістеміка--так)
        (список
          (як-є claim-round-trip)
          (однакові? (прочитати (значення-у-текст твердження)) твердження)
          епістеміка--так)
        (список
          (як-є evidence-round-trip)
          (однакові? (прочитати (значення-у-текст доказ)) доказ)
          епістеміка--так)
        (список
          (як-є intent-round-trip)
          (однакові? (прочитати (значення-у-текст намір)) намір)
          епістеміка--так)
        (список
          (як-є empty-list-round-trip)
          (однакові? (прочитати (значення-у-текст (як-є ()))) (як-є ()))
          епістеміка--так)
        (список
          (як-є eq-result-round-trip)
          (однакові? (прочитати (значення-у-текст (тотожне? (як-є а) (як-є а))))
            (тотожне? (як-є а) (як-є а)))
          епістеміка--так)
        (список
          (як-є exact-less-false-round-trip)
          (однакові? (прочитати (значення-у-текст епістеміка--ні)) епістеміка--ні)
          епістеміка--так)
        (список
          (як-є exact-less-true-round-trip)
          (однакові? (прочитати (значення-у-текст епістеміка--так)) епістеміка--так)
          епістеміка--так)
        (список
          (як-є external-json-false-remains-distinct)
          (однакові?
            (прочитати (значення-у-текст (формат-обміну-даними-розібрати "false")))
            (формат-обміну-даними-розібрати "false"))
          епістеміка--ні)
        ; Перевірка форми посилання — виконуваний семантичний контракт.
        (список (як-є source-ref-digest-valid)
          (це-належне-посилання-на-джерело? (як-є (digest packet)))
          епістеміка--так)
        (список (як-є source-ref-proof-valid)
          (це-належне-посилання-на-джерело? (як-є (proof packet)))
          епістеміка--так)
        (список (як-є source-ref-unknown-tag-rejected)
          (це-належне-посилання-на-джерело? (як-є (unknown packet)))
          епістеміка--ні)
        (список (як-є source-ref-nested-head-rejected)
          (це-належне-посилання-на-джерело? (як-є ((digest) packet)))
          епістеміка--ні)
        (список (як-є source-ref-empty-rejected)
          (це-належне-посилання-на-джерело? (як-є ()))
          епістеміка--ні)
        (список (як-є source-ref-extra-field-rejected)
          (це-належне-посилання-на-джерело? (як-є (digest packet extra)))
          епістеміка--ні)
        (список (як-є source-ref-dotted-tail-rejected)
          (це-належне-посилання-на-джерело? (як-є (digest packet . пошкоджений-хвіст)))
          епістеміка--ні)
        (список (як-є claim-ref-valid)
          (епістеміка--посилання-на-твердження? (як-є (claim-ref packet)))
          епістеміка--так)
        (список (як-є claim-ref-unknown-tag-rejected)
          (епістеміка--посилання-на-твердження? (як-є (other-ref packet)))
          епістеміка--ні)
        (список (як-є claim-ref-extra-field-rejected)
          (епістеміка--посилання-на-твердження? (як-є (claim-ref packet extra)))
          епістеміка--ні)
        (список (як-є claim-ref-dotted-tail-rejected)
          (епістеміка--посилання-на-твердження? (як-є (claim-ref packet . пошкоджений-хвіст)))
          епістеміка--ні)
        (список (як-є claim-ref-empty-rejected)
          (епістеміка--посилання-на-твердження? (як-є (claim-ref)))
          епістеміка--ні)
        ; Логічні вимоги перевіряють весь список, а не тільки першу комірку.
        (список (як-є requirements-empty-is-satisfied)
          (епістеміка--усі-вимоги-наявні? (як-є ()) (як-є ()))
          епістеміка--так)
        (список (як-є requirements-present-is-satisfied)
          (епістеміка--усі-вимоги-наявні? (як-є (читання)) (як-є (читання)))
          епістеміка--так)
        (список (як-є requirements-missing-is-not-satisfied)
          (епістеміка--усі-вимоги-наявні? (як-є (читання)) (як-є (запис)))
          епістеміка--ні)
        (список (як-є requirements-atomic-tail-is-rejected)
          (епістеміка--усі-вимоги-наявні? (як-є хибний-хвіст) (як-є (читання)))
          епістеміка--ні)
        (список (як-є requirements-dotted-tail-is-rejected)
          (епістеміка--усі-вимоги-наявні? (як-є (читання . хибний-хвіст)) (як-є (читання)))
          епістеміка--ні)
        ; Рівність вкладених посилань розрізняє значення та форму.
        (список (як-є nested-reference-equal)
          (епістеміка--рівні-посилання? (як-є (а (б в))) (як-є (а (б в))))
          епістеміка--так)
        (список (як-є nested-reference-different-leaf)
          (епістеміка--рівні-посилання? (як-є (а (б в))) (як-є (а (б г))))
          епістеміка--ні)
        (список (як-є nested-reference-shape-mismatch)
          (епістеміка--рівні-посилання? (як-є (а (б))) (як-є (а б)))
          епістеміка--ні)
        (список (як-є nested-reference-empty-equal)
          (епістеміка--рівні-посилання? (як-є ()) (як-є ()))
          епістеміка--так)))))

(визначити перевірити-епістемічні-рядки
  (функція (рядки)
    (за-умовою
      ((порожній? рядки)
       (як-є (epistemic-authority-witness (status pass))))
      ((атом? рядки)
       (список
         (як-є epistemic-authority-witness)
         (список (як-є status) (як-є fail))
         (список (як-є case) (як-є malformed-row-tail))
         (список (як-є actual) рядки)))
      ((хибне? (атом? рядки))
       (нехай ((рядок (перше рядки)))
         (за-умовою
           ((свідок-рівні? (друге рядок) (третє рядок))
            (перевірити-епістемічні-рядки (решта рядки)))
           ((хибне? (свідок-рівні? (друге рядок) (третє рядок)))
            (список
              (як-є epistemic-authority-witness)
              (список (як-є status) (як-є fail))
              (список (як-є case) (перше рядок))
              (список (як-є actual) (друге рядок))
              (список (як-є expected) (третє рядок))))))))))

(визначити свідок-епістеміки
  (функція ()
    (перевірити-епістемічні-рядки (епістемічні-рядки))))
