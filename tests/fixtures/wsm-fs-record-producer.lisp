; Дані для двох записів формує мовна бібліотека ФС.
; Зовнішній процес передає лише серіалізовані записи.
(нехай-послідовно
  ((значення (як-є (hello world)))
   (записане (фс-записати (фс-порожній) "code" значення))
   (фс (перше записане))
   (корінь (фс-корінь-пакет фс))
   (об'єкт (фс-об'єкт-пакет значення))
   (відновлене (фс-відновити-корінь корінь (список об'єкт))))
  (за-умовою
    ((хибне? (однакові? (перше відновлене) (як-є accepted)))
     (як-є reconstruction-rejected))
    ((хибне? (однакові? (друге (фс-читати (друге відновлене) "code")) значення))
     (як-є reconstruction-mismatch))
    (так
     (список (фс-серіалізувати-корінь фс)
             (фс-серіалізувати-об'єкт значення)))))
