; SENS_PAIR_REGEN: повторно карбувати producer після P0 виправлення CDR адреси крапкового зв'язування (#6183 b326db55).
; #6183 COORDINATED: this source change deliberately triggers physical producer remint.
; F6: повне власне виконання SENS без прямого D6 LET*.
; Вхід і вихід ті самі, що в канонічному свідку:
; серіалізовані два фізичні записи або явна причина відхилення.
; Zig переносить T5M; Rust передає лише два однорядкові записи.

(визначити фс-фізичний-вирок
  (функція (система значення відновлене)
    (за-умовою
      ; Перевірити форму результату ДО CAR/CDR.
      ; Порожній або атомний результат не можна читати як (accepted fs).
      ; NIL у SENS не проходить атомну гілку: відсікаємо його до CAR.
      ((внутрішня-рівність-версій відновлене (як-є ()))
       (як-є reconstruction-empty-result))
      ((атом? відновлене)
       (як-є reconstruction-non-list-result))
      ; Статус відповіді — протокольний атом; пару не передаємо в D3 EQ.
      ((хибне? (атом? (перше відновлене)))
       (як-є reconstruction-non-atomic-status))
      ((хибне? (однакові? (перше відновлене) (як-є accepted)))
       (як-є reconstruction-rejected))
      ((атом? (решта відновлене))
       (за-умовою
         ((порожній? (решта відновлене))
          (як-є reconstruction-missing-state))
         (так (як-є reconstruction-invalid-state-tail))))
      (так
       (нехай ((читання-коду (фс-читати (друге відновлене) "code")))
         (за-умовою
           ; READ may reject or return malformed data; never SELECT before
           ; proving that both the response and its value field are present.
           ((атом? читання-коду)
            (за-умовою
              ((порожній? читання-коду) (як-є reconstruction-code-empty))
              (так (як-є reconstruction-code-non-list))))
           ((атом? (решта читання-коду))
            (за-умовою
              ((порожній? (решта читання-коду)) (як-є reconstruction-code-missing-value))
              (так (як-є reconstruction-code-improper-tail))))
           ((хибне? (внутрішня-рівність-версій (друге читання-коду) значення))
            (як-є reconstruction-mismatch))
           (так
            (нехай ((кореневий-текст (фс-серіалізувати-корінь система))
                    (об'єктний-текст (фс-серіалізувати-об'єкт значення)))
              (за-умовою
                ((хибне? (текст? кореневий-текст))
                 (як-є корінь-серіалізатор-не-рядок))
                ((хибне? (текст? об'єктний-текст))
                 (як-є об'єкт-серіалізатор-не-рядок))
                (так (список кореневий-текст об'єктний-текст)))))))))))

; F6: п'ять обов'язкових полів кореня, чотири поля об'єкта.
; Немає ототожнення «немає ключа» з «ключ присутній, дані D3:()».
; Жодного обчислення семантики у Rust, Zig чи зовнішньому тестовому хості.
(визначити фс-корінь-без-об'єктів
  (функція (пакет)
    (список
      (перше пакет)
      (друге пакет)
      (третє пакет)
      (перше (решта (решта (решта пакет)))))))

(визначити фс-корінь-без-зв'язків
  (функція (пакет)
    (список
      (перше пакет)
      (друге пакет)
      (третє пакет)
      (перше (решта (решта (решта (решта пакет))))))))

; F6: точний доказ проєкції ключів пакета після D8 READ.
; Вхід фіксований, жодне стороннє ім'я не стає семантикою SENS.
(визначити фс-перевірити-ключі-після-читання
  (функція (корінь)
    (за-умовою
      ((хибне? (фс-пакет-єдине-поле?
                  (як-є format)
                  (прочитати (значення-у-текст корінь))))
       (як-є f6-format-key-lost))
      ((хибне? (фс-пакет-єдине-поле?
                  (як-є version)
                  (прочитати (значення-у-текст корінь))))
       (як-є f6-version-key-lost))
      ((фс-пакет-єдине-поле?
         (як-є format)
         (список
           (сполучити (як-є format) (як-є а))
           (сполучити (текст-у-символ "format") (як-є б))))
       (як-є f6-mixed-duplicate-accepted))
      ((фс-пакет-єдине-поле?
         (як-є format)
         (список (сполучити (як-є version) (як-є а))))
       (як-є f6-missing-format-accepted))
      (так (як-є ready)))))

(визначити фс-доказ-наявних-полів
  (функція (корінь значення)
    (за-умовою
      ((хибне?
         (внутрішня-рівність-версій
           (фс-перевірити-ключі-після-читання корінь)
           (як-є ready)))
       (фс-перевірити-ключі-після-читання корінь))
      ; Поле формату може бути D8-атомом або його точним фізичним D7-носієм.
      ; Перевірка формату сама розрізняє їх до будь-якого атомного EQ.
      ((хибне?
         (фс-формат-кореня?
           (фс-пакет-поле (як-є format) корінь)))
       (як-є root-format-not-symbol))
      ((хибне?
         (фс-формат-об'єкта?
           (фс-пакет-поле
             (як-є format) (фс-об'єкт-пакет значення))))
       (як-є object-format-not-symbol))
      ((хибне?
         (внутрішня-рівність-версій
           (перше (рішення-щодо-кореневого-пакета-файлової-системи корінь))
           (як-є accepted)))
       (як-є valid-root-rejected))
      ; Оберненість перевіряє сам SENS: WRITE → READ → той самий F6-закон.
      ((хибне?
         (внутрішня-рівність-версій
           (перше
             (фс-десеріалізувати-корінь
               (значення-у-текст корінь)))
           (як-є accepted)))
       (як-є serialized-root-rejected))
      ((хибне?
         (внутрішня-рівність-версій
           (перше
             (фс-десеріалізувати-об'єкт
               (значення-у-текст
                 (фс-об'єкт-пакет значення))))
           (як-є accepted)))
       (як-є serialized-object-rejected))
      ((хибне?
         (внутрішня-рівність-версій
           (перше
             (рішення-щодо-кореневого-пакета-файлової-системи
               (фс-корінь-пакет (фс-порожній))))
           (як-є accepted)))
       (як-є empty-root-rejected))
      ((хибне?
         (внутрішня-рівність-версій
           (перше
             (рішення-щодо-пакета-об'єкта-файлової-системи
               (фс-об'єкт-пакет (як-є ()))))
           (як-є accepted)))
       (як-є empty-value-rejected))
      ((хибне?
         (внутрішня-рівність-версій
           (перше
             (рішення-щодо-кореневого-пакета-файлової-системи
               (фс-корінь-без-об'єктів корінь)))
           (як-є rejected)))
       (як-є missing-objects-accepted))
      ((хибне?
         (внутрішня-рівність-версій
           (перше
             (рішення-щодо-кореневого-пакета-файлової-системи
               (фс-корінь-без-зв'язків корінь)))
           (як-є rejected)))
       (як-є missing-bindings-accepted))
      ((хибне?
         (внутрішня-рівність-версій
           (перше
             (рішення-щодо-пакета-об'єкта-файлової-системи
               (список
                 (перше (фс-об'єкт-пакет значення))
                 (друге (фс-об'єкт-пакет значення))
                 (третє (фс-об'єкт-пакет значення)))))
           (як-є rejected)))
       (як-є missing-value-accepted))
      (так (як-є ready)))))

(визначити фс-фізичний-після-перевірки-полів
  (функція (записане значення допуск)
    (за-умовою
      ((внутрішня-рівність-версій допуск (як-є ready))
       (фс-фізичний-вирок
         (перше записане)
         значення
         (фс-відновити-корінь
           (фс-корінь-пакет (перше записане))
           (список (фс-об'єкт-пакет значення)))))
      (так допуск))))

(визначити фс-фізичний-після-запису
  (функція (записане значення)
    (фс-фізичний-після-перевірки-полів
      записане значення
      (фс-доказ-наявних-полів
        (фс-корінь-пакет (перше записане))
        значення))))


(фс-фізичний-після-запису
  (фс-записати-із-адресою
    (фс-порожній)
    "code"
    (як-є (hello world))
    (знання-вміст-адреса (як-є (hello world))))
  (як-є (hello world)))
