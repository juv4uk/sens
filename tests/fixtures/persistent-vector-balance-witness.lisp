; #305. Закон АВЛ-рівноваги незмінного вектора належить СЕНС.
; Вставлення ключів за зростанням у порожній вектор має створювати
; збалансоване дерево, висота якого менша за 15 для 500 елементів.
; Визначення, виклики й локальні змінні записано українською.
; Цитовані маркери результатів залишаються даними протоколу.

(load "lib/core.lisp")
(load "lib/persistent-vector.lisp")

(визначити список-діапазону
  (функція (число накопичувач)
    (за-умовою
      ((менше? число 0) накопичувач)
      (так (список-діапазону (відняти число 1)
                            (сполучити число накопичувач))))))

(визначити перевірити-рівновагу-сталого-вектора
  (функція ()
    (нехай ((вектор (вектор-з-список (список-діапазону 499 (як-є ()))))
           (висота (вектор-вузол-висота (отримати-дерево-вектора вектор))))
      (за-умовою
        ((менше? висота 15)
         (як-є (persistent-vector-balance-witness (status pass))))
        (так
         (список
           (як-є persistent-vector-balance-witness)
           (як-є (status fail))
           (список (як-є height) висота)))))))

(перевірити-рівновагу-сталого-вектора)
