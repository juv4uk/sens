; Д9 F6: усі ключі пакета мають бути атомами.
; Невідомий додатковий ключ-список має викликати rejected.
; Валідні кореневий і об'єктовий пакети лишаються accepted.
(визначити еталон-кореня-д9
  (фс-корінь-пакет (фс-порожній)))
(визначити еталон-об'єкта-д9
  (фс-об'єкт-пакет (як-є вміст)))
(визначити некоректний-корінь-д9
  (сполучити
    (сполучити (список (як-є сторонній)) (як-є значення))
    еталон-кореня-д9))
(визначити некоректний-об'єкт-д9
  (сполучити
    (сполучити (список (як-є сторонній)) (як-є значення))
    еталон-об'єкта-д9))
(за-умовою
  ((однакові?
     (перше (рішення-щодо-кореневого-пакета-файлової-системи
               еталон-кореня-д9))
     (як-є accepted))
   (за-умовою
     ((однакові?
        (перше (рішення-щодо-пакета-об'єкта-файлової-системи
                  еталон-об'єкта-д9))
        (як-є accepted))
      (за-умовою
        ((однакові?
           (перше (рішення-щодо-кореневого-пакета-файлової-системи
                     некоректний-корінь-д9))
           (як-є rejected))
         (однакові?
           (перше (рішення-щодо-пакета-об'єкта-файлової-системи
                     некоректний-об'єкт-д9))
           (як-є rejected)))
        (так ні)))
     (так ні)))
  (так ні))
