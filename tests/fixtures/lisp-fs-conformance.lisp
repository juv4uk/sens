; Детермінована перевірка прототипу файлової системи WSM.
; Викличні голови — повна ратифікована українська проєкція D9.

(нехай-похідне ((хибне-рішення
                  (фс-журнал-повторити (список (список (як-є broken))))))
  (за-умовою
    ((тотожне? (перше хибне-рішення) (як-є rejected))
     (за-умовою
       ((тотожне? (друге хибне-рішення) (як-є invalid-event))
         (нехай-похідне ((порожня-файлова-система (фс-порожній)))
           (нехай-похідне ((перший-запис (фс-записати порожня-файлова-система "notes/today" (як-є (hello world)))))
             (нехай-похідне ((старий-корінь (перше перший-запис))
                   (другий-запис (фс-записати (перше перший-запис) "notes/empty" (як-є ()))))
               (нехай-похідне ((новий-корінь (перше другий-запис)))
                 (список
                   (фс-читати старий-корінь "notes/today")
                   (фс-читати старий-корінь "notes/empty")
                   (фс-читати новий-корінь "notes/empty")
                   (фс-читати новий-корінь "missing")
                   (вміст-сховище-розмір (фс-об'єкти новий-корінь))
                   (фс-ревізія старий-корінь)
                   (фс-ревізія новий-корінь)))))))
       (так (як-є wrong-rejection-reason))))
    (так (як-є malformed-event-accepted))))
