; Свідчення #216: закон точного порівняння чисел визначає СЕНС.
; Локальні зв'язування й параметри записано українською.
; Основні викличні імена українські. Поля результату — дані протоколу.
; Історичне зовнішнє ім'я збережене як аліас для чинного Rust-споживача.

(визначити поле-двійкової-математики
  (функція (рядок поле)
    (нехай ((знайдене (знайти-за-ключем поле рядок)))
      (за-умовою
        ((атом? знайдене) (як-є ()))
        (так (решта знайдене))))))

(визначити висновок-двійкової-математики
  (функція (рядок фактичний-вид фактичний-запис)
    (за-умовою
      ((хибне? (однакові? (поле-двійкової-математики рядок (як-є expected-kind)) фактичний-вид))
       (список (як-є binary-math-result)
             (список (як-є status) (як-є fail))
             (список (як-є detail)
                   (список (як-є kind)
                         (поле-двійкової-математики рядок (як-є expected-kind))
                         фактичний-вид))))
      ((хибне? (однакові? (поле-двійкової-математики рядок (як-є expected-render)) фактичний-запис))
       (список (як-є binary-math-result)
             (список (як-є status) (як-є fail))
             (список (як-є detail)
                   (список (як-є render)
                         (поле-двійкової-математики рядок (як-є expected-render))
                         фактичний-запис))))
      (так
       (список (як-є binary-math-result)
             (список (як-є status) (як-є pass))
             (список (як-є detail) (поле-двійкової-математики рядок (як-є decision))))))))

; Перехідна назва потрібна чинному свідку crates/my-lisp/tests/binary_math_contract.rs.
; Це те саме замикання, не окрема семантична функція.
(визначити binary-math-verdict висновок-двійкової-математики)
