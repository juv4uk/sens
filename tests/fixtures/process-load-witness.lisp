; #771 — свідок чинного процесного модуля СЕНС після завантаження ядра.
; Перевіряємо український механізм оброблення коду завершення, а не
; тотожність із застарілою латинською назвою чи випадковий виклик хоста.
; Порожній код стає -1, точний код 0 не змінюється.
; Побічних ефектів і запуску зовнішніх процесів тут немає.
; Поля відповіді збережено як незмінні дані протоколу.

(визначити свідок-завантаження-процесу
  (функція ()
    (за-умовою
      ((тотожне? (процес-публічний-вихід-код (як-є ())) -1)
       (за-умовою
         ((тотожне? (процес-публічний-вихід-код 0) 0)
          (як-є (process-load-witness (status pass))))
         (так
          (як-є (process-load-witness (status fail))))))
      (так
       (як-є (process-load-witness (status fail)))))))

(свідок-завантаження-процесу)
