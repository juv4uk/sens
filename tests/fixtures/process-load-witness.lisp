; #771 — свідок процесного модуля; українські голови; без рядкових шляхів.

(визначити свідок-завершення-коду
  (функція (код)
    (за-умовою
      ((тотожне? код (як-є ())) (як-є -1))
      ((тотожне? код 0) 0)
      (так код))))

(список
  (свідок-завершення-коду (як-є ()))
  (свідок-завершення-коду 0)
  (свідок-завершення-коду 1))
