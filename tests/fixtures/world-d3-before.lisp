;; Незмінний світ — українські визначення Д3, без застарілих голів виклику.
;; (world батько журнал-знань-від-нових-до-старих метадані)

(визначити д3-створити-світ
  (функція (батько журнал метадані)
    (список (як-є world) батько журнал метадані)))

(визначити д3-порожній-світ
  (функція ()
    (д3-створити-світ (як-є ()) (як-є ()) (як-є ()))))

(визначити д3-світ?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((тотожне? (перше значення) (як-є world)) так)
      (так ні))))

(визначити д3-батько-світу (функція (світ) (друге світ)))
(визначити д3-журнал-світу (функція (світ) (третє світ)))
(визначити д3-метадані-світу (функція (світ) (четверте світ)))

(визначити д3-запис-світу
  (функція (вид вміст)
    (список вид вміст)))

(визначити д3-повідомити-світу
  (функція (світ клауза)
    (д3-створити-світ світ
                (сполучити (д3-запис-світу (як-є tell) клауза)
                          (д3-журнал-світу світ))
                (д3-метадані-світу світ))))

(визначити д3-відкликати-зі-світу
  (функція (світ клауза)
    (д3-створити-світ світ
                (сполучити (д3-запис-світу (як-є retract) клауза)
                          (д3-журнал-світу світ))
                (д3-метадані-світу світ))))

(визначити д3-події-модуля
  (функція (світ)
    (д3-журнал-світу світ)))

(визначити д3-вилучити-перше
  (функція (шукане елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((однакові? (перше елементи) шукане) (решта елементи))
      (так (сполучити (перше елементи)
                     (д3-вилучити-перше шукане (решта елементи)))))))

(визначити д3-застосувати-подію
  (функція (клаузи подія)
    (нехай ((вид (перше подія))
          (вміст (друге подія)))
      (за-умовою
        ((тотожне? вид (як-є tell))
         (сполучити вміст клаузи))
        ((тотожне? вид (як-є retract))
         (д3-вилучити-перше вміст клаузи))
        (так клаузи)))))

(визначити д3-модуль-відомий?
  (функція (світ)
    (хибне? (атом? (д3-журнал-світу світ)))))

(визначити д3-модуль-відсутній?
  (функція (світ)
    (атом? (д3-журнал-світу світ))))

(визначити д3-клаузи-світу
  (функція (світ)
    (нехай ((події (зворот (д3-журнал-світу світ))))
      (нехай ((цикл (функція (події-що-лишились накопичувач)
                     (за-умовою
                       ((атом? події-що-лишились) накопичувач)
                       (так (цикл (решта події-що-лишились)
                                  (д3-застосувати-подію накопичувач (перше події-що-лишились))))))))
        (цикл події (як-є ()))))))

(визначити д3-міркувати-у-світі
  (функція (світ ціль)
    (міркувати-за-індексом ціль (д3-клаузи-світу світ))))

(визначити д3-вивести-вперед-у-світі
  (функція (світ правила)
    (запустити правила (д3-клаузи-світу світ))))

(визначити д3-глибина-світу
  (функція (світ)
    (за-умовою
      ((атом? (д3-батько-світу світ)) 0)
      (так (додати 1 (д3-глибина-світу (д3-батько-світу світ)))))))

(визначити д3-світ-на-глибині
  (функція (світ глибина)
    (за-умовою
      ((тотожне? (д3-глибина-світу світ) глибина) світ)
      ((атом? (д3-батько-світу світ)) світ)
      (так (д3-світ-на-глибині (д3-батько-світу світ) глибина)))))

(визначити д3-адреса-вмісту-світу
  (функція (світ)
    (значення-у-текст (список (як-є world-history)
                (д3-журнал-світу світ)
                (д3-метадані-світу світ)))))

(визначити д3-свідок-світу-до
  (функція ()
    (нехай ((світ0 (д3-порожній-світ))
          (світ1 (д3-повідомити-світу світ0 (як-є (fact a))))
          (світ2 (д3-повідомити-світу світ1 (як-є (fact b)))))
      (за-умовою
        ((д3-світ? світ2)
         (за-умовою
           ((тотожне? (д3-батько-світу світ2) світ1)
            (як-є (world-d3-before-witness (status pass))))
           (так (як-є (world-d3-before-witness (status fail parent))))))
        (так (як-є (world-d3-before-witness (status fail not-world))))))))

(д3-свідок-світу-до)
