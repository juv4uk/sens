; Україномовна програма для перевірки рівноправності мов.
; Всі викличні голови мають ратифіковані українські назви.

; Іменовані математичні D24+ значення, без цифрових source-токенів.
(визначити рівноправність-число-двадцять-один
  (помножити (довжина (як-є (а б в))) (довжина (як-є (а б в г ґ д е)))))
(визначити рівноправність-число-сорок-два
  (додати рівноправність-число-двадцять-один рівноправність-число-двадцять-один))

(визначити подвоїти
  (функція (число)
    (додати число число)))

(за-умовою
  ((тотожне? (подвоїти рівноправність-число-двадцять-один) рівноправність-число-сорок-два) (як-є гаразд))
  (так (як-є помилка)))
