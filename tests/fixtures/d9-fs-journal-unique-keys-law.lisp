; Д9 F3: правильний запис може мати порожнє D3 значення.
; Два поля з однаковим іменем недопустимі незалежно від їхнього вмісту.
(визначити подія-ф3-зразок
  (фс-журнал-записати-подія (як-є назва) (як-є ())))
(визначити подія-ф3-дубль-формату
  (сполучити
    (сполучити (як-є format) (як-є wsm-fs-event))
    подія-ф3-зразок))
(визначити подія-ф3-дубль-імені
  (сполучити
    (сполучити (як-є name) (як-є інша))
    подія-ф3-зразок))
(за-умовою
  ((однакові?
     (перше (рішення-щодо-події-журналу-файлової-системи
               подія-ф3-зразок))
     (як-є accepted))
   (за-умовою
     ((однакові?
        (перше (рішення-щодо-події-журналу-файлової-системи
                  подія-ф3-дубль-формату))
        (як-є rejected))
      (за-умовою
        ((однакові?
           (перше (рішення-щодо-події-журналу-файлової-системи
                     подія-ф3-дубль-імені))
           (як-є rejected))
         так)
        (так ні)))
     (так ні)))
  (так ні))
