; Свідок першого домену для наукової розмірності СЕНС.
; Ратифіковані Д1 «так» і «ні» використовуються без обхідних порівнянь пар.
; Послідовне зв'язування гарантує, що результат бачить розмірність.
; Імена схем та підсумкові поля — цитовані протокольні дані.

(завантажити-файл "lib/core.lisp")
(завантажити-файл "lib/quantity.lisp")

(визначити свідок-розмірності-д1
  (функція ()
    (нехай-послідовно
      ((розмірність (створити-розмірність (як-є metre) 1))
       (результат (розмірність? розмірність)))
      (за-умовою
        (результат
         (як-є (quantity-d1
                (status pass)
                (d1-true (атом? (як-є ())))
                (dimension-schema dimension/1)
                (axiom width-equals-address))))
        (так
         (як-є (quantity-d1 (status fail) (dimension? not-d1))))))))

(свідок-розмірності-д1)
