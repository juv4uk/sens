; Свідок першого домену для наукової розмірності.
; Точні відповіді Д1 не підмінюються істинністю зовнішнього виконавця.
; Українські виклики конструктора й предиката беруться з lib/quantity.lisp.
; Назви схем і маркери результату — цитовані дані протоколу.

(завантажити-файл "lib/core.lisp")
(завантажити-файл "lib/quantity.lisp")

(визначити істина-д1 (атом? (як-є ())))
(визначити хиба-д1 (тотожне? (як-є (0)) (як-є (1))))

(визначити свідок-розмірності-д1
  (функція ()
    (нехай ((розмірність (створити-розмірність (як-є metre) 1))
            (результат (розмірність? розмірність)))
      (за-умовою
        ((тотожне? результат істина-д1)
         (як-є (quantity-d1
                (status pass)
                (d1-true (атом? (як-є ())))
                (dimension-schema dimension/1)
                (axiom width-equals-address))))
        ((атом? (як-є ()))
         (як-є (quantity-d1 (status fail) (dimension? not-d1))))))))

(свідок-розмірності-д1)
