; Свідок Д1 для розмірності — без рядкових шляхів (фізичний SENS).
; Точна істина/хиба Д1; без завантажити-файл.

(визначити альтернатива-має-значення-д1?
  (функція ()
    (за-умовою
      ((тотожне? (як-є no) (як-є yes)) ні)
      (так так))))

(визначити свідок-розмірності-д1
  (функція ()
    (за-умовою
      ((альтернатива-має-значення-д1?)
       (як-є (quantity-d1
              (status pass)
              (d1-true (атом? (як-є ())))
              (axiom width-equals-address))))
      (так
       (як-є (quantity-d1 (status fail) (cond-else not-d1)))))))

(свідок-розмірності-д1)
