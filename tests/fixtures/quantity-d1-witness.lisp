; Свідок Д1 для розмірності — самодостатній, без SID8.

(визначити альтернатива-має-значення-д1?
  (функція ()
    (за-умовою
      ((тотожне? (як-є ні) (як-є так)) ні)
      (так так))))

(визначити свідок-розмірності-д1
  (функція ()
    (за-умовою
      ((альтернатива-має-значення-д1?)
       (як-є (свідок-розмірності-д1 (status pass))))
      (так (як-є (свідок-розмірності-д1 (status fail)))))))

(свідок-розмірності-д1)
