; Свідок історичних механізмів таблиці функцій у проєкції українською.
; Це перевірка історичних SID, не твердження про тотожність із чинними Д8.
; Розмірність і координати належать старому формату; семантику визначає СЕНС.
; Виконувані допоміжні імена українські, маркери вихідного протоколу незмінні.
; Перевіряємо носії відповіді Д1, історичні координати, чотири маршрути
; додавання й джерело семантичних повноважень у реєстрі.

(завантажити-файл "lib/core.lisp")

(визначити істина-д1 (атом? (як-є ())))
(визначити хиба-д1 (тотожне? (як-є (0)) (як-є (1))))

; Exact coordinates (bit pattern = identity), decimal presentation
(визначити історичний-сід-цитування 1)
(визначити історичний-сід-атома 2)
(визначити історичний-сід-тотожності 3)
(визначити історичний-сід-сполучення 4)
(визначити історичний-сід-першого 5)
(визначити історичний-сід-решти 6)
(визначити історичний-сід-умови 7)
(визначити історичний-сід-функції 8)
(визначити історичний-сід-визначення 9)
(визначити історичний-сід-додавання 12)
(визначити історичний-сід-реєстру-ядра3 168)

(визначити історичні-сід-тотожні?
  (функція (ліве праве)
    (за-умовою
      ((тотожне? ліве праве) істина-д1)
      ((атом? (як-є ())) хиба-д1))))

(визначити чотири-острови-додавання
  (як-є
    ((12 common-lisp)
     (12 prolog)
     (12 clips)
     (12 datalog))))

(визначити єдина-ідентичність-додавання?
  (функція (рядки)
    (за-умовою
      ((атом? рядки) істина-д1)
      (так
       (за-умовою
         ((тотожне? (перше (перше рядки)) історичний-сід-додавання)
          (єдина-ідентичність-додавання? (решта рядки)))
         ((атом? (як-є ())) хиба-д1))))))

(визначити свідок-механізмів-історичного-сід8
  (функція ()
    (за-умовою
      ((тотожне? (історичні-сід-тотожні? історичний-сід-цитування 1) істина-д1)
       (за-умовою
         ((тотожне? (історичні-сід-тотожні? історичний-сід-умови 7) істина-д1)
          (за-умовою
            ((тотожне? (історичні-сід-тотожні? історичний-сід-додавання 12) істина-д1)
             (за-умовою
               ((тотожне? (єдина-ідентичність-додавання? чотири-острови-додавання) істина-д1)
                (за-умовою
                  ((тотожне? (історичні-сід-тотожні? історичний-сід-реєстру-ядра3 168) істина-д1)
                   (як-є (function-table-mechanisms-sid8
                          (status pass)
                          (sid-width 8)
                          (plus-islands 4)
                          (plus-sid 12)
                          (authority semantic-registry)
                          (axiom width-equals-address))))
                  ((атом? (як-є ()))
                   (як-є (function-table-mechanisms-sid8
                          (status fail) (core3-reg mismatch))))))
               ((атом? (як-є ()))
                (як-є (function-table-mechanisms-sid8
                       (status fail) (plus-islands non-uniform))))))
            ((атом? (як-є ()))
             (як-є (function-table-mechanisms-sid8
                    (status fail) (plus-sid mismatch))))))
         ((атом? (як-є ()))
          (як-є (function-table-mechanisms-sid8
                 (status fail) (cond-sid mismatch))))))
      ((атом? (як-є ()))
       (як-є (function-table-mechanisms-sid8
              (status fail) (quote-sid mismatch)))))))

; Сумісний вхід для історичних викликів свідка.
(визначити function-table-mechanisms-sid8-witness свідок-механізмів-історичного-сід8)

(свідок-механізмів-історичного-сід8)
