; СЕНС: нативний свідок таблиці функцій через першокласні коди Д3.
; Історична назва файла лишається адресою попередніх тестів, не кодом.
; Д3 АТОМ?, ПЕРШЕ та СПОЛУЧИТИ передаються як значення функцій.
; Позитивний і негативний закон перевіряє сам СЕНС, не Python/JSON.

(визначити виконати-одномісний-код-домену
  (функція (дія предмет)
    (дія предмет)))

(визначити виконати-двомісний-код-домену
  (функція (дія ліве праве)
    (дія ліве праве)))

(визначити свідок-механізмів
  (функція ()
    (за-умовою
      ((виконати-одномісний-код-домену атом? (як-є ()))
       (за-умовою
         ((хибне?
            (виконати-одномісний-код-домену
              атом?
              (виконати-двомісний-код-домену
                сполучити (як-є атом?) (як-є ()))))
          (за-умовою
            ((тотожне?
               (виконати-одномісний-код-домену
                 перше
                 (виконати-двомісний-код-домену
                   сполучити (як-є атом?) (як-є ())))
               (як-є атом?))
             (як-є (function-table (status pass))))
            (так (перше (як-є ())))))
         (так (перше (як-є ())))))
      (так (перше (як-є ()))))))

(свідок-механізмів)
