; Свідок розрядності регістрів x86-64 #491.
; Один фізичний код регістра може відповідати різним розрядностям,
; але типізовані операнди gpr8 та gpr64 не можна ототожнювати.
; Власні функції, параметри й локальні назви українською.
; Байтові еталони, регістрові позначки та зовнішні x86-механізми незмінні.

(завантажити-файл "lib/core.lisp")
(завантажити-файл "lib/machine/encoding/x86-64.lisp")
(завантажити-файл "lib/machine/operands/x86-64.lisp")

(визначити рядки-перевірки-розрядності-регістрів
  (функція ()
    (список
      (список (як-є gpr64-rax)
            (машинний-регістр-64 (як-є rax))
            (як-є (gpr64 rax)))
      (список (як-є gpr64-r8)
            (машинний-регістр-64 (як-є r8))
            (як-є (gpr64 r8)))
      (список (як-є gpr64-reject-al)
            (машинний-регістр-64 (як-є al))
            (як-є (rejected machine-operand gpr64 al)))
      (список (як-є gpr64-reject-r8b)
            (машинний-регістр-64 (як-є r8b))
            (як-є (rejected machine-operand gpr64 r8b)))
      (список (як-є gpr8-al)
            (машинний-регістр-8 (як-є al))
            (як-є (gpr8 al)))
      (список (як-є gpr8-spl)
            (машинний-регістр-8 (як-є spl))
            (як-є (gpr8 spl)))
      (список (як-є gpr8-r8b)
            (машинний-регістр-8 (як-є r8b))
            (як-є (gpr8 r8b)))
      (список (як-є gpr8-reject-rax)
            (машинний-регістр-8 (як-є rax))
            (як-є (rejected machine-operand gpr8 rax)))
      (список (як-є setz-al-bytes)
            (машина-кодувати-байт-за-нульовим-результатом (значення-машинного-регістра-8 (машинний-регістр-8 (як-є al))))
            (як-є (15 148 192)))
      (список (як-є setz-spl-rex-bytes)
            (машина-кодувати-байт-за-нульовим-результатом (значення-машинного-регістра-8 (машинний-регістр-8 (як-є spl))))
            (як-є (64 15 148 196)))
      (список (як-є setz-r8b-rex-bytes)
            (машина-кодувати-байт-за-нульовим-результатом (значення-машинного-регістра-8 (машинний-регістр-8 (як-є r8b))))
            (як-є (65 15 148 192))))))

(визначити перевірити-розрядність-регістрів
  (функція (рядки)
    (за-умовою
      ((атом? рядки)
       (як-є (machine-register-width-witness (status pass))))
      (так
       (нехай ((рядок (перше рядки))
              (назва (перше рядок))
              (фактичне (друге рядок))
              (очікуване (третє рядок)))
         (за-умовою
           ((однакові? фактичне очікуване)
            (перевірити-розрядність-регістрів (решта рядки)))
           (так
            (список
              (як-є machine-register-width-witness)
              (як-є (status fail))
              (список (як-є case) назва)
              (список (як-є expected) очікуване)
              (список (як-є actual) фактичне)))))))))

; Українські визначення рядків та перевірки використовуються безпосередньо.
; Відсутні сторонні споживачі історичних допоміжних псевдонімів.

(перевірити-розрядність-регістрів (рядки-перевірки-розрядності-регістрів))
