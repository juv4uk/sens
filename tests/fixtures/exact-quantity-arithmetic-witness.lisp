  ((функція (частота-цезію)
    ((функція (енергія)
      ((функція (одна-секунда)
        ((функція (швидкість)
          ((функція (відстань)
            ((функція (відновлена-швидкість)
              (список
                      (список
                        (як-є planck-cesium-energy-shape)
                        (однакові?
                          енергія
                          (як-є
                            (quantity/1
                              121822045942277331/20000000000000000000000000000000000000000
