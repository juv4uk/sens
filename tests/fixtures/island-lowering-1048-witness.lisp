; Свідчення #1048/#1169: чесне пониження викликів між островами.
; СЕМАНТИКУ визначає СЕНС, а транспорт переносить лише аргументи.
; Виконувані виклики й локальні зв'язування наведено українською.
; Людські десяткові D24+ — не старі текстові літерали #q2.
; Всі чотири острови мають той самий перевірюваний протокол.

(завантажити-файл "lib/core.lisp")
(завантажити-файл "lib/surface/semantic-registry-api.lisp")
(завантажити-файл "lib/mechanism-selector.lisp")
(завантажити-файл "lib/island-lowering.lisp")

(визначити свідок-пониження-островів-1048
  (функція ()
    (нехай ((ідентичність-додавання (як-є додати))
           (результат-загального-ліспу (острів-знизити-двійковий-вираз ідентичність-додавання (як-є common-lisp) 2 3))
           (результат-прологу (острів-знизити-двійковий-вираз ідентичність-додавання (як-є prolog) 2 3))
           (результат-кліпс (острів-знизити-двійковий-вираз ідентичність-додавання (як-є clips) 2 3))
           (результат-даталогу (острів-знизити-двійковий-вираз ідентичність-додавання (як-є datalog) 2 3)))
      (за-умовою
        ((однакові?
           результат-загального-ліспу
           (список (як-є island-lowering-result)
                 ідентичність-додавання
                 (як-є common-lisp)
                 (як-є bounded-exact-add)
                 "2 3"))
         (за-умовою
           ((однакові?
              результат-прологу
              (список (як-є island-lowering-result)
                    ідентичність-додавання
                    (як-є prolog)
                    (як-є bounded-exact-add)
                    "2 3"))
            (за-умовою
              ((однакові?
                 результат-даталогу
                 (список (як-є island-lowering-result)
                       ідентичність-додавання
                       (як-є datalog)
                       (як-є bounded-exact-add)
                       "2 3"))
               (за-умовою
                 ((однакові?
                    результат-кліпс
                    (список (як-є island-lowering-result)
                          ідентичність-додавання
                          (як-є clips)
                          (як-є bounded-exact-add)
                          "2 3"))
                  (як-є (island-lowering-1048 (status pass) (executable-payloads 4) (clips admitted-direct))))
                 (так (перше (як-є ())))))
              (так (перше (як-є ())))))
           (так (перше (як-є ())))))
        (так (перше (як-є ())))))))

(свідок-пониження-островів-1048)
