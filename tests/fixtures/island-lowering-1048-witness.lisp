; Свідок #1048: механізм обирає СЕНС, Zig переносить точні дані.
; Залежності — чинні DEFINE з lib/mechanism-selector.lisp та
; lib/island-lowering.lisp, завантажені нативним SENS як binding-source.
; Ні файлового host LOAD, ні недопущеного Д6 НЕХАЙ, ні рядкових
; сурогатів для двох математичних Д24+ операндів.
(визначити ідентичність-додавання (як-є додати))

(визначити результат-загального-ліспу
  (острів-знизити-двійковий-вираз
    ідентичність-додавання (як-є common-lisp) 2 3))
(визначити результат-прологу
  (острів-знизити-двійковий-вираз
    ідентичність-додавання (як-є prolog) 2 3))
(визначити результат-кліпс
  (острів-знизити-двійковий-вираз
    ідентичність-додавання (як-є clips) 2 3))
(визначити результат-даталогу
  (острів-знизити-двійковий-вираз
    ідентичність-додавання (як-є datalog) 2 3))

; Кожний маршрут — окремий живий Д1-закон, без проміжного списку
; предикатних результатів. Д1 не мусить ставати текстом Д7 чи CAR-даними.
; Негатив є реальною помилкою ПЕРШЕ порожнього списку в самому СЕНС.
(за-умовою
 ((механізм-однакові? результат-загального-ліспу
   (список (як-є island-lowering-result)
     ідентичність-додавання (як-є common-lisp)
     (як-є bounded-exact-add) (список 2 3))) так)
 (так (перше (як-є ()))))

(за-умовою
 ((механізм-однакові? результат-прологу
   (список (як-є island-lowering-result)
     ідентичність-додавання (як-є prolog)
     (як-є bounded-exact-add) (список 2 3))) так)
 (так (перше (як-є ()))))

(за-умовою
 ((механізм-однакові? результат-кліпс
   (список (як-є island-lowering-result)
     ідентичність-додавання (як-є clips)
     (як-є bounded-exact-add) (список 2 3))) так)
 (так (перше (як-є ()))))

(за-умовою
 ((механізм-однакові? результат-даталогу
   (список (як-є island-lowering-result)
     ідентичність-додавання (як-є datalog)
     (як-є bounded-exact-add) (список 2 3))) так)
 (так (перше (як-є ()))))

(як-є (island-lowering-1048 (status pass) (executable-payloads 4) (clips admitted-direct)))
