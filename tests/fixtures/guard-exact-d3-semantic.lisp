; Власник логічних законів Guard — виключно SENS.
; Host лише завантажує цей файл і перевіряє фінальний D1-біт.
; Українська проєкція: без SID8 call-heads і без #d1: тегів.

(визначити сторожа--ні?
  (функція (біт)
    (за-умовою
      (біт ні)
      (так так))))

(визначити сторожа--усі?
  (функція (свідки)
    (за-умовою
      ((атом? свідки) так)
      ((перше свідки) (сторожа--усі? (решта свідки)))
      (так ні))))

(визначити сторожа--поле
  (функція (ключ рядки)
    (за-умовою
      ((атом? рядки) (як-є ()))
      ((тотожне? ключ (перше (перше рядки))) (перше (решта (перше рядки))))
      (так (сторожа--поле ключ (решта рядки))))))

(визначити сторожа--рішення
  (функція (знахідка)
    (сторожа--поле (як-є decision) (решта знахідка))))

(визначити сторожа--статус
  (функція (знахідка)
    (сторожа--поле (як-є evidence-status) (решта знахідка))))

(визначити сторожа--містить?
  (функція (значення дерево)
    (за-умовою
      ((сторожа--рівні? значення дерево) так)
      ((атом? дерево) ні)
      ((сторожа--містить? значення (перше дерево)) так)
      (так (сторожа--містить? значення (решта дерево))))))

(визначити сторожа--закон
  (функція ()
    (сторожа--усі?
      (список
        (сторожа--рівні? (як-є ()) (як-є ()))
        (сторожа--рівні? (як-є сигнал) (як-є сигнал))
        (сторожа--ні? (сторожа--рівні? (як-є сигнал) (як-є шум)))
        (сторожа--ні? (сторожа--рівні? (як-є сигнал) (як-є (сигнал))))
        (сторожа--ні? (сторожа--рівні? (як-є (сигнал)) (як-є сигнал)))
        (сторожа--рівні? (як-є (a (b c))) (як-є (a (b c))))
        (сторожа--ні? (сторожа--рівні? (як-є (a (b c))) (як-є (a (b d)))))
        (сторожа--ні? (сторожа--рівні? (як-є (a b)) (як-є (a b c))))
        (сторожа--рівні? (як-є (D3 "001")) (як-є (D3 "001")))
        (сторожа--ні? (сторожа--рівні? (як-є (D3 "001")) (як-є (D4 "0001"))))
        (сторожа--ні? (сторожа--рівні? (як-є (D3 "001")) (як-є (D3 "000"))))
        (guard-decision? (як-є allow))
        (guard-decision? (як-є warn))
        (guard-decision? (як-є reject))
        (guard-decision? (як-є unknown))
        (сторожа--ні? (guard-decision? (як-є unauthorized)))
        (guard-evidence-status? (як-є confirmed))
        (guard-evidence-status? (як-є partial))
        (guard-evidence-status? (як-є unresolved))
        (guard-evidence-status? (як-є broken))
        (сторожа--ні? (guard-evidence-status? (як-є invented)))
        (тотожне?
          (сторожа--рішення
            (make-guard-finding
              (як-є warn) (як-є confirmed) (як-є task)
              (як-є old) (як-є target) (як-є delta)
              (як-є impact) (як-є reconcile) (як-є evidence)))
          (як-є warn))
        (тотожне?
          (сторожа--статус
            (make-guard-finding
              (як-є warn) (як-є confirmed) (як-є task)
              (як-є old) (як-є target) (як-є delta)
              (як-є impact) (як-є reconcile) (як-є evidence)))
          (як-є confirmed))
        (тотожне?
          (сторожа--рішення
            (guard-unknown (як-є source) (як-є missing) (як-є inspect)))
          (як-є unknown))
        (тотожне?
          (сторожа--статус
            (guard-unknown (як-є source) (як-є missing) (як-є inspect)))
          (як-є unresolved))
        (тотожне?
          (сторожа--рішення
            (guard-compare
              (як-є logic) (як-є (one (zero)))
              (як-є (one (zero))) (як-є (proof))))
          (як-є allow))
        (тотожне?
          (сторожа--рішення
            (guard-compare
              (як-є logic) (як-є (one (zero)))
              (як-є (one (one))) (як-є (proof))))
          (як-є warn))
        (тотожне?
          (сторожа--рішення
            (guard-compare
              (як-є logic) (як-є (one (zero)))
              (як-є one) (як-є (proof))))
          (як-є warn))
        (тотожне?
          (сторожа--рішення
            (guard-sync-window
              (як-є open) (як-є completed) (як-є recorded) (як-є proof)))
          (як-є reject))
        (тотожне?
          (сторожа--рішення
            (guard-sync-window
              (як-є frozen) (як-є pending) (як-є recorded) (як-є proof)))
          (як-є warn))
        (тотожне?
          (сторожа--рішення
            (guard-sync-window
              (як-є frozen) (як-є completed) (як-є absent) (як-є proof)))
          (як-є warn))
        (тотожне?
          (сторожа--рішення
            (guard-sync-window
              (як-є frozen) (як-є completed) (як-є recorded) (як-є proof)))
          (як-є allow))
        (сторожа--містить? (як-є ask-owner) (guard-unknown-routes))
        (сторожа--містить? (як-є ask-agent) (guard-unknown-routes))
        (сторожа--містить? (як-є research-web) (guard-unknown-routes))))))

(сторожа--закон)
