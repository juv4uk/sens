; Живий свідок української проєкції чинних Д3/Д4.
; Ні стара SID8/Sens8-таблиця, ні однаковий із собою текст не є доказом.
; Точні ідентичності читаємо з ратифікованих таблиць, без власного реєстру.
; Негативний випадок перевіряє відмову для неіснуючої проєкції.

(завантажити-файл "lib/surface/semantic-registry-api.lisp")

(визначити збігається-точна-ідентичність?
  (функція (рядки назва домен слово)
    (однакові?
      (ідентичність-у-семантичному-реєстрі рядки назва)
      (список домен слово))))

(визначити свідок-реєстру
  (функція ()
    (нехай ((рядки-д3
              (прочитати-рядки-домену (як-є д3) "lib/domains/d3.lisp"))
            (рядки-д4
              (прочитати-рядки-домену (як-є д4) "lib/domains/d4.lisp")))
      (за-умовою
        ((хибне? (збігається-точна-ідентичність?
                    рядки-д3 (як-є як-є) (як-є д3) (як-є 001)))
         (як-є (semantic-registry (status fail))))
        ((хибне? (збігається-точна-ідентичність?
                    рядки-д3 (як-є атом?) (як-є д3) (як-є 010)))
         (як-є (semantic-registry (status fail))))
        ((хибне? (збігається-точна-ідентичність?
                    рядки-д4 (як-є функція) (як-є д4) (як-є 0010)))
         (як-є (semantic-registry (status fail))))
        ((хибне? (збігається-точна-ідентичність?
                    рядки-д4 (як-є визначити) (як-є д4) (як-є 0011)))
         (як-є (semantic-registry (status fail))))
        ((хибне? (порожній?
                   (ідентичність-у-семантичному-реєстрі
                     рядки-д3 (як-є немає-такої-проєкції))))
         (як-є (semantic-registry (status fail))))
        (так (як-є (semantic-registry (status pass))))))))

(свідок-реєстру)
