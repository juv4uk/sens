; #509 — диференційний свідок рівності нативного виконання й обчислювача СЕНС.
; Незалежні очікувані значення у корпусі не дозволяють виконавцю
; й обчислювачу взаємно підміняти еталон закону.

(завантажити-файл "lib/core.lisp")
(завантажити-файл "lib/machine/encoding/x86-64.lisp")
(завантажити-файл "lib/machine/layout/pair-x86-64.lisp")
(завантажити-файл "lib/machine/operands/x86-64.lisp")
(завантажити-файл "lib/machine/admission/x86-64.lisp")
(завантажити-файл "lib/machine/lowering/semantic-x86-64.lisp")
(завантажити-файл "lib/machine/dispatch/native-first.lisp")
(завантажити-файл "lib/machine/dispatch/native-first-execute.lisp")
(завантажити-файл "lib/machine/dispatch/native-first-parity.lisp")

(визначити нативний-паритет-корпус
  (як-є
    ((car-cons-u64-zero
       (перше (сполучити 0 1))
       0
       pure
       not-applicable)
     (car-cons-u64-small
       (перше (сполучити 2 3))
       2
       pure
       not-applicable)
     (car-cons-u64-independent-fields
       (перше (сполучити 42 99))
       42
       pure
       not-applicable)
     (car-cons-u64-max-exact-result
       (перше (сполучити 9007199254740991 7))
       9007199254740991
       pure
       not-applicable))))

(визначити нативний-паритет-вердикти
  (нативний-паритет-перевірити-корпус нативний-паритет-корпус))

(визначити нативний-паритет-свідок
  (функція ()
    (за-умовою
      ((однакові? (нативний-паритет-усі-вердикти-успішні? нативний-паритет-вердикти) так)
       (список
         (як-є нативний-паритет-свідок)
         (як-є (status pass))
         (список (як-є cases) (довжина нативний-паритет-корпус))))
      (так
       (список
         (як-є нативний-паритет-свідок)
         (як-є (status fail))
         (список (як-є verdicts) нативний-паритет-вердикти))))))

(нативний-паритет-свідок)