; Диференційний свідок: перше/решта/сполучити — укр проєкція, без SID8.

(визначити свідок-парності-нативного
  (функція ()
    (нехай ((пара (сполучити (як-є а) (сполучити (як-є б) (як-є ())))))
      (за-умовою
        ((тотожне? (перше пара) (як-є а))
         (за-умовою
           ((тотожне? (перше (решта пара)) (як-є б))
            (як-є (свідок-парності (status pass))))
           (так (як-є (свідок-парності (status fail))))))
        (так (як-є (свідок-парності (status fail))))))))

(свідок-парності-нативного)
