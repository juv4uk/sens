; Свідчення #305: проєкція наукової константи в базу знань.
; Значення належить бібліотекам СЕНС, а не історичному перевіряльнику Rust.
; Швидкість світла породжує рівно сім клауз, які приймає чинна
; перевірка бази знань. Проєкція не змінює глобального журналу.
; Викличні голови звірено з ратифікованими українськими назвами
; доменів Д9 і Д10. Протокольні маркери залишено незмінними.

; Шляхи залежностей записано українськими клавішами ратифікованої Д7.
; Їхні координати відповідають точним байтам назв на диску, а Д8
; перетворює символ на текст. Перевірка T5M та запуск СЕНС обов'язкові.

(завантажити-файл (символ-у-текст (як-є дши.сщкуюдшіз)))
(завантажити-файл (символ-у-текст (як-є дши.гтшанюдшіз)))
(завантажити-файл (символ-у-текст (як-є дши.куфіщтюдшіз)))
(завантажити-файл (символ-у-текст (як-є дши.ащкцфквюдшіз)))
(завантажити-файл (символ-у-текст (як-є дши.лтщцдувпуюдшіз)))
(завантажити-файл (символ-у-текст (як-є дши.куігде-іефегіюдшіз)))
(завантажити-файл (символ-у-текст (як-є дши.йгфтешенюдшіз)))
(завантажити-файл (символ-у-текст (як-є дши.ішюдшіз)))

(визначити спостерегти-проєкцію-наукової-константи
  (функція ()
    (нехай ((журнал-до (поточний-журнал-знань))
           (клаузи
             (науковий-константа-клаузи
               сі:визначальна-швидкість-світла))
           (кількість (довжина клаузи))
           (допущено (клаузи-бази-знань-коректні? клаузи))
           (журнал-незмінний
             (однакові? журнал-до (поточний-журнал-знань))))
      (список кількість допущено журнал-незмінний))))

(визначити перевірити-проєкцію-наукової-константи
  (функція ()
    (нехай ((спостереження
            (спостерегти-проєкцію-наукової-константи)))
      (за-умовою
        ((однакові?
           спостереження
           (як-є (7 так (1))))
         (як-є
           (scientific-constant-knowledge-projection-witness
             (status pass))))
        (так
         (список
           (як-є scientific-constant-knowledge-projection-witness)
           (як-є (status fail))
           (список (як-є actual) спостереження)
           (як-є
             (expected
               (7 так (1))))))))))

(перевірити-проєкцію-наукової-константи)
