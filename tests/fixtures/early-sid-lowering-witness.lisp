; Виконуваний свідок #1115 раннього пониження семантичної ідентичності.
; Семантичний пошук здійснює канонічний API реєстру СЕНС.
; Власні імена визначень, внутрішні виклики та параметри українською.
; Позначки SID і назви проєкцій — цитовані історичні дані свідка.
; Зовнішньому виконавцю передаються точна ідентичність, аргументи й договір.
;
(визначити раннє-пониження-запит-виконавцю?
  (функція (запит)
    (за-умовою
      ((атом? запит) (як-є no))
      (так
       (нехай ((перше-поле (перше запит)))
         (за-умовою
           ((атом? перше-поле) (як-є no))
           (так
            (за-умовою
              ((тотожне? (перше перше-поле) (як-є sid))
               (як-є yes))
              (так (як-є no))))))))))

(визначити раннє-пониження-ідентичності
  (функція (реєстр проєкція аргументи договір)
    (нехай ((ідентичність (ідентичність-у-семантичному-реєстрі реєстр проєкція)))
      (за-умовою
        ((атом? ідентичність) (як-є rejected))
        (так
         (список
           (сполучити (як-є sid) ідентичність)
           (сполучити (як-є arguments) аргументи)
           (сполучити (як-є contract) договір)))))))

(визначити раннє-пониження-перевірити-проєкції
  (функція (реєстр перша-проєкція друга-проєкція третя-проєкція четверта-проєкція)
    (нехай ((перша-ідентичність (ідентичність-у-семантичному-реєстрі реєстр перша-проєкція))
          (друга-ідентичність (ідентичність-у-семантичному-реєстрі реєстр друга-проєкція))
          (третя-ідентичність (ідентичність-у-семантичному-реєстрі реєстр третя-проєкція))
          (четверта-ідентичність (ідентичність-у-семантичному-реєстрі реєстр четверта-проєкція)))
      (за-умовою
        ((тотожне? перша-ідентичність друга-ідентичність)
         (за-умовою
           ((тотожне? друга-ідентичність третя-ідентичність)
            (за-умовою
              ((тотожне? третя-ідентичність четверта-ідентичність)
               (список (як-є same) перша-ідентичність))
              (так (як-є distinct))))
           (так (як-є distinct))))
        (так (як-є distinct))))))

(визначити раннє-пониження-свідок
  (функція (джерело-реєстру)
    (нехай ((реєстр (прочитати-джерело-семантичного-реєстру джерело-реєстру)))
      (нехай ((атом-англійською (ідентичність-у-семантичному-реєстрі реєстр (як-є atom?)))
            (атом-українською (ідентичність-у-семантичному-реєстрі реєстр (як-є атом?)))
            (атом-повна-українська (ідентичність-у-семантичному-реєстрі реєстр (як-є атом?)))
            (атом-санскритом (ідентичність-у-семантичному-реєстрі реєстр (як-є aṇu)))
            (атом-символом (ідентичність-у-семантичному-реєстрі реєстр (як-є .?))))
        (список
          (раннє-пониження-перевірити-проєкції
            реєстр
            (як-є atom?) (як-є атом?) (як-є aṇu) (як-є .?))
          (раннє-пониження-запит-виконавцю?
            (раннє-пониження-ідентичності
              реєстр
              (як-є atom?)
              (як-є (x))
              (як-є (portable-result-domain structural-relation))))
          (раннє-пониження-запит-виконавцю?
            (як-є (surface atom?)))
          (тотожне? атом-англійською атом-українською)
          (тотожне? атом-англійською атом-повна-українська)
          (тотожне? атом-англійською атом-санскритом)
          (тотожне? атом-англійською атом-символом)
          (ідентичність-у-семантичному-реєстрі реєстр (як-є not-admitted-by-language)))))))

; Історичні назви — сумісні прив'язки до українських визначень.
(визначити early-sid-lowering-backend-request? раннє-пониження-запит-виконавцю?)
(визначити early-sid-lower раннє-пониження-ідентичності)
(визначити early-sid-lowering-peer-check раннє-пониження-перевірити-проєкції)
(визначити early-sid-lowering-witness раннє-пониження-свідок)
