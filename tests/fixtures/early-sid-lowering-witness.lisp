; СЕНС: читати ратифіковані Д3-координати з повною проєкцією «укр».
; Історичний SID8 тут НЕ є ключем: тотожність = (домен точні-біти).
; Доменні таблиці — єдине джерело. Зовнішній виконавець одержує
; вже встановлений код та аргументи; він не обирає семантику за ім'ям.
; Публічні назви свідка збережено для його наявних споживачів.
;
(визначити раннє-пониження-запит-виконавцю?
  (функція (запит)
    (за-умовою
      ((атом? запит) ні)
      (так
       (нехай ((перше-поле (перше запит)))
         (за-умовою
           ((атом? перше-поле) ні)
           (так
            (за-умовою
              ((тотожне? (перше перше-поле) (як-є доменний-код))
               (за-умовою
                 ((атом? (решта перше-поле)) ні)
                 ((атом? (друге перше-поле)) ні)
                 ((тотожне? (перше (друге перше-поле)) (як-є д3)) так)
                 (так ні)))
              (так ні)))))))))

(визначити раннє-пониження-ідентичності
  (функція (реєстр проєкція аргументи договір)
    (нехай ((ідентичність (ідентичність-у-семантичному-реєстрі реєстр проєкція)))
      (за-умовою
        ((порожній? ідентичність) (як-є відхилено))
        (так
         (список
           (список (як-є доменний-код) ідентичність)
           (список (як-є аргументи) аргументи)
           (список (як-є договір) договір)))))))

; Порівнюємо обидва поля точного коду, не D3 EQ на парі.
; Недопущені/неоднозначні проєкції не можуть бути тотожними.
(визначити раннє-пониження-однаковий-доменний-код?
  (функція (лівий правий)
    (за-умовою
      ((порожній? лівий) ні)
      ((порожній? правий) ні)
      ((атом? лівий) ні)
      ((атом? правий) ні)
      ((хибне? (тотожне? (перше лівий) (перше правий))) ні)
      ((тотожне? (друге лівий) (друге правий)) так)
      (так ні))))

(визначити раннє-пониження-перевірити-проєкції
  (функція (реєстр перша-проєкція друга-проєкція третя-проєкція четверта-проєкція)
    (нехай ((перша-ідентичність (ідентичність-у-семантичному-реєстрі реєстр перша-проєкція))
          (друга-ідентичність (ідентичність-у-семантичному-реєстрі реєстр друга-проєкція))
          (третя-ідентичність (ідентичність-у-семантичному-реєстрі реєстр третя-проєкція))
          (четверта-ідентичність (ідентичність-у-семантичному-реєстрі реєстр четверта-проєкція)))
      (за-умовою
        ((раннє-пониження-однаковий-доменний-код? перша-ідентичність друга-ідентичність)
         (за-умовою
           ((раннє-пониження-однаковий-доменний-код? друга-ідентичність третя-ідентичність)
            (за-умовою
              ((раннє-пониження-однаковий-доменний-код? третя-ідентичність четверта-ідентичність)
               (список (як-є same) перша-ідентичність))
              (так (як-є distinct))))
           (так (як-є distinct))))
        (так (як-є distinct))))))

(визначити раннє-пониження-свідок
  (функція (джерело-реєстру)
    (нехай ((реєстр
              (прочитати-рядки-домену
                (як-є д3) "lib/domains/d3.lisp")))
      (нехай ((атом-англійською (ідентичність-у-семантичному-реєстрі реєстр (як-є atom?)))
            (атом-українською (ідентичність-у-семантичному-реєстрі реєстр (як-є атом?)))
            (атом-повна-українська (ідентичність-у-семантичному-реєстрі реєстр (як-є атом?)))
            (атом-санскритом (ідентичність-у-семантичному-реєстрі реєстр (як-є aṇu)))
            (атом-символом (ідентичність-у-семантичному-реєстрі реєстр (як-є .?))))
        (список
          (раннє-пониження-перевірити-проєкції
            реєстр
            (як-є atom?) (як-є атом?) (як-є aṇu) (як-є .?))
          (раннє-пониження-запит-виконавцю?
            (раннє-пониження-ідентичності
              реєстр
              (як-є atom?)
              (як-є (x))
              (як-є (домен-результату д1))))
          (раннє-пониження-запит-виконавцю?
            (як-є (surface atom?)))
          (раннє-пониження-однаковий-доменний-код? атом-англійською атом-українською)
          (раннє-пониження-однаковий-доменний-код? атом-англійською атом-повна-українська)
          (раннє-пониження-однаковий-доменний-код? атом-англійською атом-санскритом)
          (раннє-пониження-однаковий-доменний-код? атом-англійською атом-символом)
          (ідентичність-у-семантичному-реєстрі реєстр (як-є not-admitted-by-language)))))))

