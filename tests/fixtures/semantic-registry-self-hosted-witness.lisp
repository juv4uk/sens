; Виконуваний СЕНС-свідок чинної драбини Д3, не історичної таблиці SID8.
; Джерело українських назв — lib/domains/d3.lisp, точна пара (домен код).
; Публічні точки входу залишено для чинних споживачів свідка.
; Переданий раніше зовнішній текст є даними, а не правом змінювати домен.
; Ні BINARY-PRINT, ні SOURCE-DIGEST, ні байтовий lookup не визначають істину.

(визначити свідок-д3-укр-координата?
  (функція (рядки українська слово)
    (нехай ((ідентичність
              (ідентичність-у-семантичному-реєстрі рядки українська)))
      (за-умовою
        ((порожній? ідентичність) ні)
        ((хибне? (тотожне? (перше ідентичність) (як-є д3))) ні)
        ((хибне? (тотожне? (друге ідентичність) слово)) ні)
        ((хибне?
           (тотожне?
             (назва-проєкції-реєстру
               (як-є укр)
               (рядок-у-семантичному-реєстрі рядки ідентичність))
             українська))
         ні)
        (так так)))))

(визначити свідок-самостійного-семантичного-реєстру
  (функція (джерело)
    (нехай ((рядки
              (прочитати-рядки-домену
                (як-є д3) "lib/domains/d3.lisp")))
      (за-умовою
        ((хибне? (свідок-д3-укр-координата?
                    рядки (як-є як-є) (як-є 001)))
         (перше (як-є ())))
        ((хибне? (свідок-д3-укр-координата?
                    рядки (як-є атом?) (як-є 010)))
         (перше (як-є ())))
        ((хибне? (свідок-д3-укр-координата?
                    рядки (як-є решта) (як-є 011)))
         (перше (як-є ())))
        ((хибне? (свідок-д3-укр-координата?
                    рядки (як-є перше) (як-є 100)))
         (перше (як-є ())))
        ((хибне? (свідок-д3-укр-координата?
                    рядки (як-є тотожне?) (як-є 101)))
         (перше (як-є ())))
        ((хибне? (свідок-д3-укр-координата?
                    рядки (як-є за-умовою) (як-є 110)))
         (перше (як-є ())))
        ((хибне? (свідок-д3-укр-координата?
                    рядки (як-є сполучити) (як-є 111)))
         (перше (як-є ())))
        (так так)))))

(визначити свідок-передавання-семантичного-реєстру
  (функція (джерело)
    (нехай ((рядки
              (прочитати-рядки-домену
                (як-є д3) "lib/domains/d3.lisp")))
      (за-умовою
        ((хибне? (свідок-самостійного-семантичного-реєстру джерело))
         (перше (як-є ())))
        (так
         (список
           (як-є ratified-domain-handoff)
           (список (як-є домен) (як-є д3))
           (список (як-є проєкція) (як-є укр))
           (сполучити (як-є рядки) рядки)))))))
