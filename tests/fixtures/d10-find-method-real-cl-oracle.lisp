;;;; Real Common Lisp witness; an independent CLHS implementation, not SENS runtime.
(defparameter *d10-fm-method-executions* 0)
(defclass d10-fm-base () ())
(defclass d10-fm-child (d10-fm-base) ())
(defgeneric d10-fm-proof (x))
(defmethod d10-fm-proof ((x d10-fm-base))
  (incf *d10-fm-method-executions*)
  :called-primary)
(defmethod d10-fm-proof :before ((x d10-fm-base))
  (incf *d10-fm-method-executions*))
(let* ((base (find-class 'd10-fm-base))
       (child (find-class 'd10-fm-child))
       (primary (find-method #'d10-fm-proof '() (list base) nil))
       (before (find-method #'d10-fm-proof '(:before) (list base) nil)))
  (assert primary)
  (assert before)
  (assert (not (eq primary before)))
  (assert (null (find-method #'d10-fm-proof '() (list child) nil)))
  (assert (null (find-method #'d10-fm-proof '(:after) (list base) nil)))
  (let ((absent-error nil) (arity-error nil))
    (handler-case (find-method #'d10-fm-proof '() (list child))
      (error () (setf absent-error t)))
    (handler-case (find-method #'d10-fm-proof '() '() nil)
      (error () (setf arity-error t)))
    (assert absent-error)
    (assert arity-error))
  (assert (= 0 *d10-fm-method-executions*))
  (format t "D10-FIND-METHOD-REAL-CLOS-ORACLE PASS~%"))
