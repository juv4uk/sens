; Свідчення #1047: добір механізму належить семантиці СЕНС.

; D6 НЕХАЙ не має допущеного механізму фізичного виклику.
; Послідовні мовні D4 DEFINE зберігають ті самі значення без host-eval.
; Канонічні об'єкти Д3:010 та Д5:01010 — без старих SID8-чисел.
; Структурний закон Д3 перше/решта визначений у binding source
; lib/mechanism-selector.lisp: не викликати непідв'язане однакові?.
(визначити ідентичність-атома
  (як-є атом?))

(визначити ідентичність-додавання
  (як-є додати))

(визначити обраний-механізм
  (вибрати-механізм ідентичність-атома (як-є evaluator)))

(визначити додавання-у-пролозі
  (вибрати-механізм ідентичність-додавання (як-є prolog)))

(визначити відсутній-механізм
  (вибрати-механізм ідентичність-атома (як-є prolog)))

(визначити маршрут-відсутній
  (вибрати-механізм (як-є повернути) (як-є evaluator)))

(визначити свідок-вибору-механізму-1047
  (функція ()
    (за-умовою
      ((механізм-однакові?
         обраний-механізм
         (список (як-є mechanism-selected) ідентичність-атома (як-є evaluator) (як-є atom-primitive)))
       (за-умовою
         ((механізм-однакові?
            додавання-у-пролозі
            (список (як-є mechanism-selected) ідентичність-додавання (як-є prolog) (як-є bounded-exact-add)))
          (за-умовою
            ((механізм-однакові?
               відсутній-механізм
               (список (як-є mechanism-unavailable) ідентичність-атома (як-є prolog)))
             (за-умовою
               ((механізм-однакові?
                  маршрут-відсутній
                  (список (як-є mechanism-selection-failure)
                          (як-є доменного-коду-немає-в-таблиці)
                          (як-є повернути)))
                (як-є (mechanism-selector-1047 (status pass))))
               ((атом? (як-є ())) (як-є (mechanism-selector-1047 (status fail))))))
            ((атом? (як-є ())) (як-є (mechanism-selector-1047 (status fail))))))
         ((атом? (як-є ())) (як-є (mechanism-selector-1047 (status fail))))))
      ((атом? (як-є ())) (як-є (mechanism-selector-1047 (status fail)))))))


; Негатив: структурний список з надрукованою назвою функції
; не є першокласним кодом Д3 і не має права обирати механізм.
; Д7-написання не дає жодної нової доменної адреси.
(за-умовою
  ((механізм-однакові?
     (вибрати-механізм (як-є (атом?)) (як-є common-lisp))
     (список
       (як-є mechanism-selection-failure)
       (як-є доменного-коду-немає-в-таблиці)
       (як-є (атом?))))
   (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

(свідок-вибору-механізму-1047)
