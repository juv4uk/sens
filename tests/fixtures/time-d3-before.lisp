; Обчислення календарної дати й узгодженого часу WSM мовою СЕНС.
; Функції ратифіковано в Д10 «грегоріанська-дата-з-числа-днів»
; та Д9 «узгоджений-час-з-юнікс»; внутрішні змінні — українські.
; Числовий алгоритм і рядкові ключі полів результату не змінено.

(визначити грегоріанська-дата-з-числа-днів
  (функція (дні)
    (нехай ((дні-від-епохи (додати дні 719468))
           (ера (поділити дні-від-епохи 146097))
           (день-ери (відняти дні-від-епохи (помножити ера 146097)))
           (рік-ери (поділити (відняти (додати день-ери (поділити день-ери 36524))
                              (додати (поділити день-ери 1460) (поділити день-ери 146096)))
                           365))
           (обчислений-рік (додати рік-ери (помножити ера 400)))
           (день-року (відняти день-ери (додати (помножити 365 рік-ери)
                           (відняти (поділити рік-ери 4) (поділити рік-ери 100)))))
           (зсунутий-місяць (поділити (додати (помножити 5 день-року) 2) 153))
           (день (додати (відняти день-року (поділити (додати (помножити 153 зсунутий-місяць) 2) 5)) 1))
           (місяць (додати зсунутий-місяць
                    (за-умовою
                      ((менше? зсунутий-місяць 10) 3)
                      ((атом? (як-є ())) -9))))
           (рік (додати обчислений-рік
                   (за-умовою
                     ((більше? місяць 2) 1)
                     ((атом? (як-є ())) 0)))))
      (список рік місяць день))))

(визначити узгоджений-час-з-юнікс
  (функція (секунди наносекунда)
    (нехай ((дні (поділити секунди 86400))
           (секунди-доби (залишок секунди 86400))
           (дата (грегоріанська-дата-з-числа-днів дні))
           (година (поділити секунди-доби 3600))
           (хвилина (поділити (залишок секунди-доби 3600) 60))
           (секунда (залишок секунди-доби 60)))
      (список
        (сполучити (як-є year) (перше дата))
        (сполучити (як-є month) (друге дата))
        (сполучити (як-є day) (третє дата))
        (сполучити (як-є hour) година)
        (сполучити (як-є minute) хвилина)
        (сполучити (як-є second) секунда)
        (сполучити (як-є nanosecond) наносекунда)))))

; Зовнішні історичні назви — ті самі функціональні значення.
(визначити civil-from-days грегоріанська-дата-з-числа-днів)
(визначити utc-from-unix узгоджений-час-з-юнікс)
