; Свідчення першого домену для спостереження уніфікації.
; Ширина доменної адреси є частиною тотожності значення.
; Зовнішній обчислювач не ухвалює семантичних рішень.
; Двопольовий умовний вибір використовує безпосередньо «так» і «ні» Д1.
; Позначка невдачі є мовними даними, а не булевим значенням хоста.
; Історичні назви результатів залишаються цитованими.

(завантажити-файл "lib/core.lisp")
(завантажити-файл "lib/unify-observe.lisp")

(визначити альтернатива-має-значення-д1?
  (функція ()
    (за-умовою
      ((тотожне? (як-є no) (як-є yes)) ні)
      (так так))))

(визначити свідок-спостереження-уніфікації-д1
  (функція ()
    (за-умовою
      ((альтернатива-має-значення-д1?)
       (як-є (unify-observe-d1
              (status pass)
              (d1-true (атом? (як-є ())))
              (cond-else exact-d1)
              (unify surface once)
              (axiom width-equals-address))))
      (так
       (як-є (unify-observe-d1 (status fail) (cond-else not-d1)))))))

(свідок-спостереження-уніфікації-д1)
