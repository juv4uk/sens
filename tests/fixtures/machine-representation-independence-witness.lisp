; #211 — свідок незалежності семантики від машинного представлення.
; Еталоном є додавання, уже визначене самою мовою СЕНС.
; Машинний механізм обчислює ті самі значення двома маршрутами:
; через канонічне обмежене пониження з допоміжним RCX і
; через інший допущений регістр R8. Виконувані функції українські;
; назви регістрів та машинні інструкції залишаються даними ISA.

(завантажити-файл "lib/core.lisp")
(завантажити-файл "lib/machine/encoding/x86-64.lisp")
(завантажити-файл "lib/machine/admission/x86-64.lisp")
(завантажити-файл "lib/machine/lowering/semantic-x86-64.lisp")

(визначити еталон-машинного-подання (додати 2 3))

(визначити машинне-подання-основне
  (викликати-допущену-машинну-програму
    (машина-знизити-додавання-беззнакових-64-до-форм 2 3)
    0))

(визначити машинне-подання-альтернативне
  (викликати-допущену-машинну-програму
    (як-є
      ((mov-r64-imm64 rax 2)
       (mov-r64-imm64 r8 3)
       (add-r64-r64 rax r8)
       (ret)))
    0))

(визначити свідок-незалежності-машинного-подання
  (функція ()
    (за-умовою
      ((тотожне?
         машинне-подання-основне
         еталон-машинного-подання)
       (за-умовою
         ((тотожне?
            машинне-подання-альтернативне
            еталон-машинного-подання)
          (як-є (machine-representation-independence-witness (status pass))))
         (так
          (список
            (як-є machine-representation-independence-witness)
            (як-є (status fail))
            (список (як-є case) (як-є alternate-register))
            (список (як-є semantic) еталон-машинного-подання)
            (список (як-є actual) машинне-подання-альтернативне)))))
      (так
       (список
         (як-є machine-representation-independence-witness)
         (як-є (status fail))
         (список (як-є case) (як-є canonical-register))
         (список (як-є semantic) еталон-машинного-подання)
         (список (як-є actual) машинне-подання-основне))))))

(свідок-незалежності-машинного-подання)
