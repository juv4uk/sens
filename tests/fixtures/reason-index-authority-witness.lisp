; Свідчення #305: семантика індексованого міркування належить СЕНС.
; Замість історичних перевірок Rust тут порівнюються мовні результати
; індексованого й лінійного виведення, нерухомість підготовленого знімка,
; рекурсивні правила та явне заперечення.
; Виконувані назви й локальні зв'язування — українською.
; Цитовані правила, цілі та мітки звіту залишаються незмінними.

(завантажити-файл "lib/unify.lisp")
(завантажити-файл "lib/reason.lisp")

(визначити свідок-індексованого-міркування
  (функція ()
    (нехай ((правила-паритету
             (як-є
               (((seed a))
                ((noise one))
                ((path (var x) left) (seed (var x)))
                ((noise two))
                ((path (var x) right) (seed (var x)))
                ((reachable (var x)) (path (var x) (var side))))))
           (індексований-результат (міркувати-за-індексом (як-є (reachable a)) правила-паритету))
           (лінійний-результат
             (міркувати-лінійно
               (як-є (reachable a))
               правила-паритету
               (як-є ())
               (лінійний-індекс-міркування правила-паритету)
               0))
           (паритет-збережено? (однакові? індексований-результат лінійний-результат))

           (попередні-правила
             (як-є
               (((seed a))
                ((reachable (var x)) (seed (var x))))))
           (підготовлений-індекс (побудувати-індекс-міркування попередні-правила))
           (новіші-правила
             (додати-в-кінець попередні-правила (як-є (((later yes))))))
           (знімок-збережено?
             (однакові?
               (міркувати-за-індексом (як-є (reachable a)) попередні-правила)
               (міркувати-за-індексом (як-є (reachable a)) підготовлений-індекс)))
           (старий-знімок-без-нового?
             (однакові? (міркувати-за-індексом (як-є (later yes)) підготовлений-індекс) (як-є ())))
           (оновлений-знімок-містить-нове?
             (однакові? (довжина (міркувати-за-індексом (як-є (later yes)) новіші-правила)) 1))

           (рекурсивні-правила
             (як-є
               (((parent alice bob))
                ((parent bob carol))
                ((ancestor (var x) (var y)) (parent (var x) (var y)))
                ((ancestor (var x) (var y))
                  (parent (var x) (var z))
                  (ancestor (var z) (var y)))
                ((safe (var x)) (not? (blocked (var x))))
                ((noise irrelevant)))))
           (мета (як-є (ancestor alice carol)))
           (рекурсивно-індексований-результат (міркувати-за-індексом мета рекурсивні-правила))
           (рекурсивно-лінійний-результат
             (міркувати-лінійно
               мета
               рекурсивні-правила
               (як-є ())
               (лінійний-індекс-міркування рекурсивні-правила)
               0))
           (рекурсивний-паритет? (однакові? рекурсивно-індексований-результат рекурсивно-лінійний-результат))
           (заперечна-мета (як-є (safe alice)))
           (індексоване-заперечення (міркувати-за-індексом заперечна-мета рекурсивні-правила))
           (лінійне-заперечення
             (міркувати-лінійно
               заперечна-мета
               рекурсивні-правила
               (як-є ())
               (лінійний-індекс-міркування рекурсивні-правила)
               0))
           (паритет-заперечення? (однакові? індексоване-заперечення лінійне-заперечення)))
      (за-умовою
        (паритет-збережено?
          (за-умовою
            (знімок-збережено?
              (за-умовою
                (старий-знімок-без-нового?
                  (за-умовою
                    (оновлений-знімок-містить-нове?
                      (за-умовою
                        (рекурсивний-паритет?
                          (за-умовою
                            (паритет-заперечення?
                              (як-є (reason-index-authority-witness
                                      (status pass)
                                      (laws
                                        indexed-linear-parity
                                        prepared-snapshot-preserves-old-result
                                        prepared-snapshot-is-immutable
                                        rebuilt-snapshot-sees-new-rule
                                        recursive-parity
                                        negation-parity))))
                            (так (як-є (reason-index-authority-witness
                                        (status fail)
                                        (law negation-parity))))))
                        (так (як-є (reason-index-authority-witness
                                    (status fail)
                                    (law recursive-parity))))))
                    (так (як-є (reason-index-authority-witness
                                (status fail)
                                (law rebuilt-snapshot-sees-new-rule))))))
                (так (як-є (reason-index-authority-witness
                            (status fail)
                            (law prepared-snapshot-is-immutable))))))
            (так (як-є (reason-index-authority-witness
                        (status fail)
                        (law prepared-snapshot-preserves-old-result))))))
        (так (як-є (reason-index-authority-witness
                    (status fail)
                    (law indexed-linear-parity))))))))

; Історична назва залишається прив'язкою до тієї самої функції.
(визначити reason-index-authority-witness свідок-індексованого-міркування)

(свідок-індексованого-міркування)
