;; Кандидат української проєкції Д3: журнал знань і пакетні операції.
;; Викличні голови й локальні імена українські; протокольні дані незмінні.
;; Історичний файл before лишається окремим свідченням до переходу.

(визначити д3-створити-пакет
  (функція (назва клаузи метадані)
    (список (як-є knowledge-package) назва клаузи метадані)))

(визначити д3-пакет?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((тотожне? (перше значення) (як-є knowledge-package)) так)
      (так ні))))

(визначити д3-назва-пакета (функція (пакет) (друге пакет)))
(визначити д3-клаузи-пакета (функція (пакет) (третє пакет)))
(визначити д3-метадані-пакета (функція (пакет) (четверте пакет)))

(визначити д3-повідомити-знання
  (функція (пакет клауза)
    (д3-створити-пакет
      (д3-назва-пакета пакет)
      (сполучити клауза (д3-клаузи-пакета пакет))
      (д3-метадані-пакета пакет))))

(визначити д3-відкликати-знання
  (функція (пакет клауза)
    (д3-створити-пакет
      (д3-назва-пакета пакет)
      (вилучити клауза (д3-клаузи-пакета пакет))
      (д3-метадані-пакета пакет))))

(визначити д3-містить-клаузу?
  (функція (клауза клаузи)
    (за-умовою
      ((атом? клаузи) ні)
      ((однакові? клауза (перше клаузи)) так)
      (так (д3-містить-клаузу? клауза (решта клаузи))))))

(визначити д3-об'єднати-клаузи
  (функція (ліві праві)
    (за-умовою
      ((атом? праві) ліві)
      ((д3-містить-клаузу? (перше праві) ліві)
       (д3-об'єднати-клаузи ліві (решта праві)))
      (так (д3-об'єднати-клаузи (сполучити (перше праві) ліві) (решта праві))))))

(визначити д3-перевірити-кандидата
  (функція ()
    (нехай-послідовно ((пакет0 (д3-створити-пакет (як-є demo) (як-є ()) (як-є ())))
          (пакет1 (д3-повідомити-знання пакет0 (як-є (fact a))))
          (пакет2 (д3-повідомити-знання пакет1 (як-є (fact b)))))
      (за-умовою
        ((д3-пакет? пакет2)
         (за-умовою
           ((д3-містить-клаузу? (як-є (fact a)) (д3-клаузи-пакета пакет2))
            (як-є (knowledge-d3-candidate-witness (status pass))))
           (так (як-є (knowledge-d3-candidate-witness (status fail member))))))
        (так (як-є (knowledge-d3-candidate-witness (status fail not-package))))))))

(д3-перевірити-кандидата)
