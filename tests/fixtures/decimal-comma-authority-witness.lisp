; Свідок: українська десяткова кома — скінченні дроби, без показника степеня.

(визначити свідок-десяткової-коми
  (функція ()
    (за-умовою
      ((тотожне? 12,455 12,455)
       (за-умовою
         ((тотожне? -0,25 -0,25)
          (за-умовою
            ((тотожне? (додати 1,5 2,5) 4)
             (як-є (decimal-comma (status pass))))
            (так (як-є (decimal-comma (status fail))))))
         (так (як-є (decimal-comma (status fail))))))
      (так (як-є (decimal-comma (status fail)))))))

(свідок-десяткової-коми)
