; Свідок #220: українські виклики перевірки десяткової коми.
; Семантика чисел належить СЕНС, а не зовнішньому виконавцю.
; Людські десяткові літерали залишено як у чинному джерелі.
; Цитовані протокольні маркери не перекладаються.

(визначити рядки-перевірки-десяткової-коми
  (функція ()
    (список
      (список (як-є comma-dot-exact)
            (тотожне? 12,455 12.455)
            (як-є (1)))
      (список (як-є comma-dot-negative-exact)
            (тотожне? -0,25 -0.25)
            (як-є (1)))
      (список (як-є comma-exponent-exact)
            (тотожне? 1,5e3 1500)
            (як-є (1)))
      (список (як-є comma-arithmetic-exact)
            (тотожне? (додати 1,5 2,5) 4)
            (як-є (1))))))

(визначити перевірити-рядки-десяткової-коми
  (функція (рядки)
    (за-умовою
      ((атом? рядки)
       (як-є (decimal-comma-authority-witness (status pass))))
      (так
       (нехай ((рядок (перше рядки)))
         (за-умовою
           ((тотожне? (друге рядок) (третє рядок))
            (перевірити-рядки-десяткової-коми (решта рядки)))
           (так
            (список
              (як-є decimal-comma-authority-witness)
              (список (як-є status) (як-є fail))
              (список (як-є case) (перше рядок))
              (список (як-є actual) (друге рядок))
              (список (як-є expected) (третє рядок))))))))))

(визначити свідок-закону-десяткової-коми
  (функція ()
    (перевірити-рядки-десяткової-коми (рядки-перевірки-десяткової-коми))))

; Виконувані рядки та їхню перевірку викликаємо українськими назвами.
; Історична назва потрібна лише для зовнішнього Rust-споживача.
(визначити decimal-comma-authority-witness свідок-закону-десяткової-коми)
