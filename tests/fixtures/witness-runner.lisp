; Протокол перевірки семантичних свідчень належить Lisp СЕНС.
; Всі власні функції та параметри — українською.
; Значення свідчень, коди статусів і назви полів — незмінні дані.
;
(визначити свідок-д1-ні
  (функція ()
    (тотожне? (як-є witness-no-left) (як-є witness-no-right))))

(визначити свідок-д1-ні?
  (функція (значення)
    (тотожне? значення (свідок-д1-ні))))

(визначити свідок-знайти-запис
  (функція (ключ список-пар)
    (за-умовою
      ((атом? список-пар)
       (як-є ()))
      ((тотожне? (перше (перше список-пар)) ключ)
       (перше список-пар))
      ((атом? (як-є ())) (свідок-знайти-запис ключ (решта список-пар))))))

(визначити свідок-поле
  (функція (ключ список-пар)
    (нехай ((запис (свідок-знайти-запис ключ список-пар)))
      (за-умовою
        ((атом? запис) (як-є ()))
        ((атом? (як-є ())) (решта запис))))))

(визначити свідок-поле-наявне?
  (функція (ключ список-пар)
    (нехай ((запис (свідок-знайти-запис ключ список-пар)))
      (за-умовою
        ((атом? запис) (свідок-д1-ні))
        ((атом? (як-є ())) (атом? (як-є ())))))))

(визначити свідок-перевірити-рядок
  (функція (рядок)
    (нехай ((фактичне (свідок-поле (як-є actual) рядок))
          (очікуване (свідок-поле (як-є expected) рядок)))
      (за-умовою
        ((свідок-рівні? фактичне очікуване) (як-є (status pass)))
        ((атом? (як-є ())) (список (як-є status) (як-є fail) (як-є actual) фактичне (як-є expected) очікуване))))))

(визначити свідок-перевірити-рядки
  (функція (рядки)
    (за-умовою
      ((атом? рядки)
       (як-є (witness-runner (status pass))))
      ((атом? (як-є ()))
       (нехай ((результат (свідок-перевірити-рядок (перше рядки))))
         (за-умовою
           ((тотожне? (перше результат) (як-є status))
            (за-умовою
              ((тотожне? (друге результат) (як-є pass))
               (свідок-перевірити-рядки (решта рядки)))
              ((атом? (як-є ())) результат)))
           ((атом? (як-є ())) результат)))))))


; Очікування та фактичне значення — Lisp-дані; семантичний
; висновок обчислюється в СЕНС, а Rust лише передає спостереження.
(визначити свідок-рівні?
  (функція (ліве праве)
    (тотожне?
      (однакові? ліве праве)
      (однакові? (як-є тотожний) (як-є тотожний)))))

(визначити свідок-висновок
  (функція (рядок фактичне)
    (за-умовою
      ((свідок-поле-наявне? (як-є expected) рядок)
       (за-умовою
         ((свідок-поле-наявне? (як-є error) рядок)
          (як-є (witness-result (status malformed))))
         ((свідок-рівні?
            фактичне
            (список (як-є value) (свідок-поле (як-є expected) рядок)))
          (як-є (witness-result (status pass))))
         ((атом? (як-є ()))
          (як-є (witness-result (status fail))))))
      ((свідок-поле-наявне? (як-є error) рядок)
       (за-умовою
         ((свідок-рівні?
            фактичне
            (список (як-є error) (свідок-поле (як-є error) рядок)))
          (як-є (witness-result (status pass))))
         ((атом? (як-є ()))
          (як-є (witness-result (status fail))))))
      ((атом? (як-є ()))
       (як-є (witness-result (status malformed)))))))

(визначити свідок-статус
  (функція (висновок)
    (друге (друге висновок))))

(визначити свідок-проходить?
  (функція (висновок)
    (тотожне? (свідок-статус висновок) (як-є pass))))

(визначити свідок-мета-показаний-вихід
  (функція (обчислене відображене)
    (список (як-є value) відображене)))
