; #178 — Lisp-owned composition witness for current admitted register forms.
; Ukrainian projection only. Encoder/admission owns machine facts;
; atoms own typed composition only.

(load "lib/core.lisp")
(load "lib/machine/block.lisp")
(load "lib/machine/encoding/x86-64.lisp")
(load "lib/machine/operands/x86-64.lisp")
(load "lib/machine/admission/x86-64.lisp")
(load "lib/machine/atoms/x86-64.lisp")

(визначити рядки-атомів-поточних-машинних-регістрів
  (функція ()
    (список
      (список (як-є mov-r64-r64)
            (машинна-команда-перемістити-значення-регістра-64 (як-є r8) (як-є r15))
            (як-є (mov-r64-r64 r8 r15)))
      (список (як-є test-r64-r64)
            (машинна-команда-перевірити-регістри-64 (як-є rax) (як-є rcx))
            (як-є (test-r64-r64 rax rcx)))
      (список (як-є imul-r64-r64)
            (машинна-команда-множити-зі-знаком-регістри-64 (як-є rax) (як-є rcx))
            (як-є (imul-r64-r64 rax rcx)))
      (список (як-є cqo) (машинна-команда-розширити-знак-числа) (як-є (cqo)))
      (список (як-є idiv-r64)
            (машинна-команда-ділити-зі-знаком-на-регістр-64 (як-є r10))
            (як-є (idiv-r64 r10)))
      (список (як-є setz-r8)
            (машинна-команда-встановити-байт-за-нульового-результату (як-є r8b))
            (як-є (setz-r8 r8b)))
      (список (як-є movzx-r64-r8)
            (машинна-команда-розширити-байт-нулями-до-64 (як-є rax) (як-є r8b))
            (як-є (movzx-r64-r8 rax r8b)))
      (список (як-є nop) (машинна-команда-без-дії) (як-є (nop)))
      (список (як-є reject-setcc-gpr64)
            (машинна-команда-встановити-байт-за-нульового-результату (як-є rax))
            (як-є (rejected machine-operand gpr8 rax)))
      (список (як-є typed-rejection)
            (машинна-команда-множити-зі-знаком-регістри-64 (як-є xmm0) (як-є rax))
            (як-є (rejected machine-operand gpr64 xmm0))))))

(визначити перевірити-рядки-поточних-машинних-регістрів
  (функція (рядки)
    (за-умовою
      ((атом? рядки) (як-є pass))
      (так
       (нехай ((рядок (перше рядки))
              (назва (перше рядок))
              (фактичне (друге рядок))
              (очікуване (третє рядок)))
         (за-умовою
           ((однакові? фактичне очікуване)
            (перевірити-рядки-поточних-машинних-регістрів (решта рядки)))
           (так (список (як-є fail) назва очікуване фактичне))))))))

(визначити виконати-поточну-машинну-програму
  (функція (форми)
    (викликати-допущену-машинну-програму форми 0)))

(визначити рядки-виконання-поточних-машинних-регістрів
  (функція ()
    (список
      (список
        (як-є imul)
        (виконати-поточну-машинну-програму
          (список (машинна-команда-завантажити-64-розрядне-число (як-є rax) 6)
                (машинна-команда-завантажити-64-розрядне-число (як-є rcx) 7)
                (машинна-команда-множити-зі-знаком-регістри-64 (як-є rax) (як-є rcx))
                (машинна-команда-повернення)))
        42)
      (список
        (як-є idiv)
        (виконати-поточну-машинну-програму
          (список (машинна-команда-завантажити-64-розрядне-число (як-є rax) 84)
                (машинна-команда-розширити-знак-числа)
                (машинна-команда-завантажити-64-розрядне-число (як-є rcx) 2)
                (машинна-команда-ділити-зі-знаком-на-регістр-64 (як-є rcx))
                (машинна-команда-повернення)))
        42)
      (список
        (як-є nop)
        (виконати-поточну-машинну-програму
          (список (машинна-команда-завантажити-64-розрядне-число (як-є rax) 42)
                (машинна-команда-без-дії)
                (машинна-команда-повернення)))
        42))))

(визначити свідок-поточних-машинних-регістрів
  (функція ()
    (нехай ((стан-форм
            (перевірити-рядки-поточних-машинних-регістрів
              (рядки-атомів-поточних-машинних-регістрів))))
      (за-умовою
        ((тотожне? стан-форм (як-є pass))
         (нехай ((стан-машини
                 (перевірити-рядки-поточних-машинних-регістрів
                   (рядки-виконання-поточних-машинних-регістрів))))
           (за-умовою
             ((тотожне? стан-машини (як-є pass))
              (як-є (machine-current-gpr-atoms-witness (status pass))))
             (так
              (список (як-є machine-current-gpr-atoms-witness)
                    (як-є (status fail))
                    (список (як-є native) стан-машини))))))
        (так
         (список (як-є machine-current-gpr-atoms-witness)
               (як-є (status fail))
               (список (як-є forms) стан-форм)))))))

(свідок-поточних-машинних-регістрів)

; Історичні викличні імена свідка залишаються зовнішніми посиланнями.
(визначити machine-current-gpr-atom-rows рядки-атомів-поточних-машинних-регістрів)
(визначити machine-current-gpr-check-rows перевірити-рядки-поточних-машинних-регістрів)
(визначити machine-native виконати-поточну-машинну-програму)
(визначити machine-current-gpr-native-rows рядки-виконання-поточних-машинних-регістрів)
(визначити machine-current-gpr-witness свідок-поточних-машинних-регістрів)
