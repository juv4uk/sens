; Свідок тотожності макроса четвертого домену в українській проєкції.
; Ширина, домен і точний закон разом визначають тотожність.
; Перевіряються значення Д1, форми «функція» та «визначити» з Д4,
; двопольовий умовний вибір і точна безумовна гілка Д1.
; Цитовані поля результатів належать протоколу свідків, а не викликам.
; Зовнішнє «load» збережено до доведеного українського відповідника.

(load "lib/core.lisp")
(load "lib/macro.lisp")

(визначити предикат-так (атом? (як-є ())))
(визначити предикат-ні (тотожне? (як-є (0)) (як-є (1))))

; Назви поверхні Д4, без історичних чотирибітних голів виклику.
(визначити голова-функція (як-є функція))
(визначити голова-визначити (як-є визначити))

(визначити тотожність-голови-функції?
  (функція (значення)
    (за-умовою
      ((тотожне? значення голова-функція) предикат-так)
      ((атом? (як-є ())) предикат-ні))))

(визначити тотожність-голови-визначити?
  (функція (значення)
    (за-умовою
      ((тотожне? значення голова-визначити) предикат-так)
      ((атом? (як-є ())) предикат-ні))))

(визначити гілка-так-є-предикатом-д1?
  (функція ()
    (за-умовою
      ((тотожне? (як-є no) (як-є yes)) предикат-ні)
      ((атом? (як-є ())) предикат-так))))

(визначити свідок-тотожності-макроса-д4
  (функція ()
    (за-умовою
      ((тотожне? (тотожність-голови-функції? (як-є функція)) предикат-так)
       (за-умовою
         ((тотожне? (тотожність-голови-визначити? (як-є визначити)) предикат-так)
          (за-умовою
            ((тотожне? (гілка-так-є-предикатом-д1?) предикат-так)
             (як-є (macro-d4-identity
                    (status pass)
                    (d4-lambda функція)
                    (d4-define визначити)
                    (d1-true (атом? (як-є ())))
                    (cond-else exact-d1))))
            ((атом? (як-є ()))
             (як-є (macro-d4-identity (status fail) (cond-else not-d1))))))
         ((атом? (як-є ()))
          (як-є (macro-d4-identity (status fail) (d4-define mismatch))))))
      ((атом? (як-є ()))
       (як-є (macro-d4-identity (status fail) (d4-lambda mismatch)))))))

; Сумісна зовнішня назва посилається на той самий свідок.
(визначити macro-d4-identity-witness свідок-тотожності-макроса-д4)

(свідок-тотожності-макроса-д4)
