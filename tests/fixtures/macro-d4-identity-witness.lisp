; Свідок тотожності форм Д4: функція, визначити; гілка Д1.
; Без SID8/Sens8, без латинських голів виклику.

(визначити предикат-так (атом? (як-є ())))
(визначити предикат-ні (тотожне? (як-є (0)) (як-є (1))))

(визначити тотожність-голови-функції?
  (функція (значення)
    (за-умовою
      ((тотожне? значення (як-є функція)) предикат-так)
      (так предикат-ні))))

(визначити тотожність-голови-визначити?
  (функція (значення)
    (за-умовою
      ((тотожне? значення (як-є визначити)) предикат-так)
      (так предикат-ні))))

(визначити гілка-так-є-предикатом-д1?
  (функція ()
    (за-умовою
      ((тотожне? (як-є ні) (як-є так)) предикат-ні)
      (так предикат-так))))

(визначити свідок-тотожності-макроса-д4
  (функція ()
    (за-умовою
      ((тотожне? (тотожність-голови-функції? (як-є функція)) предикат-так)
       (за-умовою
         ((тотожне? (тотожність-голови-визначити? (як-є визначити)) предикат-так)
          (за-умовою
            ((тотожне? (гілка-так-є-предикатом-д1?) предикат-так)
             (як-є (свідок-макроса-д4 (status pass))))
            (так (як-є (свідок-макроса-д4 (status fail))))))
         (так (як-є (свідок-макроса-д4 (status fail))))))
      (так (як-є (свідок-макроса-д4 (status fail)))))))

(свідок-тотожності-макроса-д4)
