; Випробування аналізатора Lisp: розмір, вкладеність, складність,
; побічні дії, вільні імена та граничні значення.
; Історичні назви def, lambda, let та cond лишаються лише цитованими
; випробувальними даними аналізу синтаксичного дерева.
; Випробування побічних дій використовують сучасні українські назви.

(
  (expr . "(аналіз-розмір 5)")
  (expected . "1")
)
(
  (expr . "(аналіз-розмір (як-є (a b)))")
  (expected . "5")
)
(
  (expr . "(аналіз-вкладеність (як-є (a (b c) d)))")
  (expected . "2") ; Вкладений список (b c) додає один рівень.
  ; Список (a) має рівень вкладеності 1, атом a — рівень 0.
  ; Правильний список (a b) теж має максимальний рівень 1.
  ; У (a (b c) d) внутрішній (b c) сам має рівень 1.
  ; Він є першим елементом вкладеного хвоста: 1 + 1 = 2.
)
(
  (expr . "(аналіз-складність (як-є (за-умовою (a b) (c d))))")
  (expected . "2")
)
(
  (expr . "(аналіз-складність (як-є (визначити перевірна (функція (x) (за-умовою (x 1) (так 2))))))")
  (expected . "2")
)
(
  (expr . "(аналіз-ефекти (як-є (визначити перевірна (функція () (друкувати \"привіт\")))))")
  (expected . "((друкувати \"привіт\"))")
)
(
  (expr . "(аналіз-глобальні (як-є (функція (x y) (додати x y z))))")
  (expected . "(z)")
)
(
  (expr . "(аналіз-глобальні (як-є (нехай-послідовно ((x 1) (y x)) (додати x y z))))")
  (expected . "(z)")
)
(
  (expr . "(аналіз-глобальні (як-є (letrec ((even? (lambda (n) (odd? n))) (odd? (lambda (n) (even? n)))) (even? z))))")
  (expected . "(z)")
)
(
  (expr . "(аналіз-глобальні (як-є (нехай цикл ((n 10)) (за-умовою ((= n 0) z) (t (цикл (- n 1)))))))")
  (expected . "(z)")
)
(
  (expr . "(аналіз-глобальні (як-є (defmacro m (a b) (+ a b c))))")
  (expected . "(c)")
)
(
  (expr . "(взяти-межу (як-є max-size) (як-є ((max-size . 50))) 99)")
  (expected . "50")
)
(
  (expr . "(взяти-межу (як-є max-nesting) (як-є ((max-size . 50))) 99)")
  (expected . "99")
)
(
  (expr . "(аналіз-перевірити (як-є (визначити перевірна (функція (x y) (за-умовою (x 1) (так 2))))) (як-є ((max-complexity . 1) (max-nesting . 10))))")
  (expected . "((complexity-exceeded 2))")
)
(
  (expr . "(аналіз-перевірити (як-є (визначити перевірна (функція (x y) (додати x y z)))) (як-є ((max-globals . 0))))")
  (expected . "((globals-exceeded (z)))")
)
(
  (expr . "(аналіз-перевірити (як-є (визначити перевірна (функція () (друкувати \"привіт\")))) (як-є ((max-effects . 0))))")
  (expected . "((effects-exceeded ((друкувати \"привіт\"))))")
)
(
  (expr . "(аналіз-перевірити (як-є (визначити перевірна (функція (x) x))) (як-є ((max-size . 1))))")
  (expected . "((size-exceeded 15))")
)
(
  (expr . "(аналіз-перевірити (як-є (визначити перевірна (функція (x) x))) (як-є ((max-size . 15) (max-complexity . 5) (max-nesting . 5) (max-globals . 0) (max-effects . 0))))")
  (expected . "()")
)

; Перевірки українських викличних голів при збереженні старого діалекту.
(
  (expr . "(аналіз-складність (як-є (за-умовою (так 1) (так 2))))")
  (expected . "2")
)
(
  (expr . "(аналіз-глобальні (як-є (функція (x) (додати x z))))")
  (expected . "(z)")
)
(
  (expr . "(аналіз-глобальні (як-є (як-є (x y))))")
  (expected . "()")
)

; Побічні дії української поверхні, без виконання зовнішніх механізмів.
(
  (expr . "(аналіз-ефекти (як-є (записати-файл \"звіт.txt\" \"дані\")))")
  (expected . "((записати-файл \"звіт.txt\" \"дані\"))")
)
(
  (expr . "(аналіз-ефекти (як-є (процес-запустити (як-є перевірка))))")
  (expected . "((процес-запустити (як-є перевірка)))")
)
(
  (expr . "(аналіз-ефекти (як-є (показати \"повідомлення\")))")
  (expected . "((показати \"повідомлення\"))")
)
(
  (expr . "(аналіз-ефекти (як-є (повідомити-знання (як-є модуль) (як-є факт))))")
  (expected . "((повідомити-знання (як-є модуль) (як-є факт)))")
)

; Українські закони аналізу: цитування не виконує прихованих дій.
(
  (expr . "(аналіз-ефекти (як-є (як-є (друкувати 1))))")
  (expected . "()")
)
(
  (expr . "(аналіз-ефекти (як-є (список (як-є (записати-файл 1 2)) (показати 3))))")
  (expected . "((показати 3))")
)
(
  (expr . "(аналіз-ефекти (як-є (quote (процес-запустити 1))))")
  (expected . "()")
)

; Чинне визначення макроса і функції: вільні змінні лишаються помітними.
(
  (expr . "(аналіз-глобальні (як-є (визначити-макрос назва (перший другий) (додати перший другий зовнішня))))")
  (expected . "(зовнішня)")
)
(
  (expr . "(аналіз-глобальні (як-є (визначити нова (функція (параметр) (додати параметр вільна)))))")
  (expected . "(вільна)")
)
