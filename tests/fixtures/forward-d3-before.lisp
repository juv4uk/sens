; Рушій прямого виведення СЕНС із правилами у стилі CLIPS.
; Українські викличні назви та змінні; цитовані факти збережено.

(завантажити-файл "lib/unify.lisp")

(визначити *робоча-пам'ять* (як-є ()))

(визначити застосувати-правило
  (функція (правило факт)
    (нехай ((зразок (перше правило))
          (дія (друге правило))
          (підстановка (уніфікувати зразок факт (як-є ()))))
      (за-умовою
        ((атом? підстановка) (як-є ()))
        (так (застосувати-підстановку дія підстановка))))))

(визначити застосувати-правило-до-фактів
  (функція (правило факти)
    (за-умовою
      ((атом? факти) (як-є ()))
      (так
       (нехай ((результат (застосувати-правило правило (перше факти))))
         (за-умовою
           ((атом? результат)
            (застосувати-правило-до-фактів правило (решта факти)))
           (так (сполучити результат
                          (застосувати-правило-до-фактів правило (решта факти))))))))))

(визначити застосувати-правило-до-робочої-пам'яті
  (функція (правило)
    (застосувати-правило-до-фактів правило *робоча-пам'ять*)))

(визначити застосувати-правила-до-фактів
  (функція (правила факти)
    (за-умовою
      ((атом? правила) (як-є ()))
      (так
       (додати-в-кінець
         (застосувати-правило-до-фактів (перше правила) факти)
         (застосувати-правила-до-фактів (решта правила) факти))))))

(визначити застосувати-правила-до-робочої-пам'яті
  (функція (правила)
    (застосувати-правила-до-фактів правила *робоча-пам'ять*)))

(визначити ствердити-факт
  (функція (факт)
    (за-умовою
      ((член? факт *робоча-пам'ять*) *робоча-пам'ять*)
      (так
       (визначити *робоча-пам'ять*
         (сполучити факт *робоча-пам'ять*))
       *робоча-пам'ять*))))

(визначити відкликати-факт
  (функція (факт)
    (визначити *робоча-пам'ять*
      (вилучити факт *робоча-пам'ять*))
    *робоча-пам'ять*))

(визначити очистити-робочу-пам'ять
  (функція ()
    (визначити *робоча-пам'ять* (як-є ()))
    *робоча-пам'ять*))

(визначити пряме-виведення
  (функція (правила факти)
    (нехай ((повторити-виведення (функція (пам'ять)
                   (нехай ((виведені (застосувати-правила-до-фактів правила пам'ять))
                         (об'єднані (зчепити пам'ять виведені)))
                     (за-умовою
                       ((більше-або-рівне? (довжина об'єднані) (довжина пам'ять))
                        (за-умовою
                          ((тотожне? (довжина об'єднані) (довжина пам'ять)) пам'ять)
                          (так (повторити-виведення об'єднані))))
                       (так пам'ять))))))
      (повторити-виведення факти))))

(визначити свідок-прямого-виведення-д3-до
  (функція ()
    (нехай ((правила
            (як-є
              ((((parent ?x ?y)) ((ancestor ?x ?y)))
               (((ancestor ?x ?y) (parent ?y ?z)) ((ancestor ?x ?z))))))
          (факти
            (як-є ((parent alice bob) (parent bob carol))))
          (результат (пряме-виведення правила факти)))
      (за-умовою
        ((член? (як-є (ancestor alice carol)) результат)
         (як-є (forward-d3-before-witness (status pass))))
        (так (як-є (forward-d3-before-witness (status fail))))))))

(свідок-прямого-виведення-д3-до)
