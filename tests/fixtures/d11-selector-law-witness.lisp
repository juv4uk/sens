; D11: дослідний селекторний закон, НЕ ратифікація нової функції.
; Батько: D10:0110000000 = CDAAAAAAAR, сім CAR і один CDR.
; Дитина-кандидат: D11:01100000000 = CDAAAAAAAAR, вісім CAR і один CDR.
; Закон: дитина(x) = батько(CAR(x)); мутант батько(CDR(x)) має відрізнятися.
; Усі виконувані голови — ратифіковані D3/D4, а відповідь — точний D1 біт.
; На асиметричному зразку очікується D1:1; протилежна гілка дає D1:0.
; Немає D11 виклику, SID8, D7 заміни чи транспортного допуску Zig.

(0011 селектор-обгортка-сім
  (0010 (значення)
    (111 (111 (111 (111 (111 (111 (111 значення (001 ())) (001 ())) (001 ())) (001 ())) (001 ())) (001 ())) (001 ()))))

(0011 селектор-батько
  (0010 (вхід)
    (011 (100 (100 (100 (100 (100 (100 (100 вхід))))))))))

(0011 селектор-дитина
  (0010 (вхід)
    (011 (100 (100 (100 (100 (100 (100 (100 (100 вхід)))))))))))

(0011 селектор-мутант
  (0010 (вхід)
    (селектор-батько (011 вхід))))

(0011 селектор-зразок
  (0010 ()
    (111
      (селектор-обгортка-сім (111 (001 ознака) (001 правильно)))
      (селектор-обгортка-сім (111 (001 ознака) (001 неправильно))))))

(0011 селектор-перевірити
  (0010 (вхід)
    (110
      ((101 (селектор-дитина вхід) (селектор-батько (100 вхід)))
       (110
         ((101 (селектор-дитина вхід) (001 правильно))
          (110
            ((101 (селектор-мутант вхід) (001 неправильно)) #d1:1)
            (#d1:1 #d1:0)))
         (#d1:1 #d1:0)))
      (#d1:1 #d1:0))))

(селектор-перевірити (селектор-зразок))
