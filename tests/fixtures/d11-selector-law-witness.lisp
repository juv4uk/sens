; D11: дві дослідні гілки закону селекторів, НЕ виклики D11.
; D10:0110000000 = CDAAAAAAAR (7 CAR + CDR).
; D11:01100000000 = CDAAAAAAAAR -> батько(CAR x).
; D11:01100000001 = CDAAAAAAADR -> батько(CDR x).
; Композиція через батька як Lisp-функцію перевіряється проти явних D3-ланцюгів.
; Відмінні дані перевіряють обидва напрямки і негативне злиття гілок.
; Фактичні executable heads: тільки D3/ D4; verdict D1:1 або D1:0.
; Сама наявність рядка D11 у коментарі не дає callability/T5 admission.

(0011 селектор-обгортка-сім
  (0010 (значення)
    (111 (111 (111 (111 (111 (111 (111 значення (001 ())) (001 ())) (001 ())) (001 ())) (001 ())) (001 ())) (001 ()))))

(0011 селектор-батько
  (0010 (вхід)
    (011 (100 (100 (100 (100 (100 (100 (100 вхід))))))))))

(0011 селектор-скласти-перше
  (0010 (батько вхід)
    (батько (100 вхід))))

(0011 селектор-скласти-решта
  (0010 (батько вхід)
    (батько (011 вхід))))

(0011 селектор-дитина-перше
  (0010 (вхід)
    (011 (100 (100 (100 (100 (100 (100 (100 (100 вхід)))))))))))

(0011 селектор-дитина-решта
  (0010 (вхід)
    (011 (100 (100 (100 (100 (100 (100 (100 (011 вхід)))))))))))

(0011 селектор-зразок
  (0010 (лівий правий)
    (111
      (селектор-обгортка-сім (111 (001 ознака) лівий))
      (селектор-обгортка-сім (111 (001 ознака) правий)))))

(0011 селектор-перевірити
  (0010 (вхід очікуване-перше очікувана-решта)
    (110
      ((101 (селектор-дитина-перше вхід) (селектор-скласти-перше селектор-батько вхід))
       (110
      ((101 (селектор-дитина-решта вхід) (селектор-скласти-решта селектор-батько вхід))
       (110
      ((101 (селектор-дитина-перше вхід) очікуване-перше)
       (110
      ((101 (селектор-дитина-решта вхід) очікувана-решта)
       (110
      ((101 (селектор-дитина-перше вхід) (селектор-дитина-решта вхід)) #d1:0)
      (#d1:1 #d1:1)))
      (#d1:1 #d1:0)))
      (#d1:1 #d1:0)))
      (#d1:1 #d1:0)))
      (#d1:1 #d1:0))))

(110
  ((селектор-перевірити
     (селектор-зразок (001 правильно) (001 неправильно))
     (001 правильно) (001 неправильно))
   (селектор-перевірити
     (селектор-зразок (001 неправильно) (001 правильно))
     (001 неправильно) (001 правильно)))
  (#d1:1 #d1:0))
