; D11: дві дослідні гілки закону селекторів, НЕ виклики D11.
; D10:0110000000 = CDAAAAAAAR (7 CAR + CDR).
; D11:01100000000 = CDAAAAAAAAR -> батько(CAR x).
; D11:01100000001 = CDAAAAAAADR -> батько(CDR x).
; Композиція через батька як Lisp-функцію перевіряється проти явних D3-ланцюгів.
; Відмінні дані перевіряють обидва напрямки і негативне злиття гілок.
; Фактичні executable heads: D3/D4 у ратифікованій українській проєкції (назви, не коди);
; verdict — так/ні (D1). Коди заборонено в новому текстовому Lisp (guard).
; Сама наявність рядка D11 у коментарі не дає callability/T5 admission.

(визначити селектор-обгортка-сім
  (функція (значення)
    (сполучити (сполучити (сполучити (сполучити (сполучити (сполучити (сполучити значення (як-є ())) (як-є ())) (як-є ())) (як-є ())) (як-є ())) (як-є ())) (як-є ()))))

(визначити селектор-батько
  (функція (вхід)
    (решта (перше (перше (перше (перше (перше (перше (перше вхід))))))))))

(визначити селектор-скласти-перше
  (функція (батько вхід)
    (батько (перше вхід))))

(визначити селектор-скласти-решта
  (функція (батько вхід)
    (батько (решта вхід))))

(визначити селектор-дитина-перше
  (функція (вхід)
    (решта (перше (перше (перше (перше (перше (перше (перше (перше вхід)))))))))))

(визначити селектор-дитина-решта
  (функція (вхід)
    (решта (перше (перше (перше (перше (перше (перше (перше (решта вхід)))))))))))

(визначити селектор-зразок
  (функція (лівий правий)
    (сполучити
      (селектор-обгортка-сім (сполучити (як-є ознака) лівий))
      (селектор-обгортка-сім (сполучити (як-є ознака) правий)))))

(визначити селектор-перевірити
  (функція (вхід очікуване-перше очікувана-решта)
    (за-умовою
      ((тотожне? (селектор-дитина-перше вхід) (селектор-скласти-перше селектор-батько вхід))
       (за-умовою
      ((тотожне? (селектор-дитина-решта вхід) (селектор-скласти-решта селектор-батько вхід))
       (за-умовою
      ((тотожне? (селектор-дитина-перше вхід) очікуване-перше)
       (за-умовою
      ((тотожне? (селектор-дитина-решта вхід) очікувана-решта)
       (за-умовою
      ((тотожне? (селектор-дитина-перше вхід) (селектор-дитина-решта вхід)) ні)
      (так так)))
      (так ні)))
      (так ні)))
      (так ні)))
      (так ні))))

(за-умовою
  ((селектор-перевірити
     (селектор-зразок (як-є правильно) (як-є неправильно))
     (як-є правильно) (як-є неправильно))
   (селектор-перевірити
     (селектор-зразок (як-є неправильно) (як-є правильно))
     (як-є неправильно) (як-є правильно)))
  (так ні))
