; Свідок Д1 для уніфікації — без рядкових шляхів.

(визначити альтернатива-має-значення-д1?
  (функція ()
    (за-умовою
      ((тотожне? (як-є no) (як-є yes)) ні)
      (так так))))

(визначити свідок-уніфікації-д1
  (функція ()
    (за-умовою
      ((альтернатива-має-значення-д1?)
       (як-є (unify-d1
              (status pass)
              (d1-true (атом? (як-є ())))
              (cond-else exact-d1)
              (axiom width-equals-address))))
      (так
       (як-є (unify-d1 (status fail) (cond-else not-d1)))))))

(свідок-уніфікації-д1)
