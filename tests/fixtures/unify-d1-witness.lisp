; Свідок Д1 уніфікації — самодостатній.

(визначити альтернатива-має-значення-д1?
  (функція ()
    (за-умовою
      ((тотожне? (як-є no) (як-є yes)) ні)
      (так так))))

(визначити свідок-уніфікації-д1
  (функція ()
    (за-умовою
      ((альтернатива-має-значення-д1?)
       (як-є (unify-d1 (status pass) (d1-true (атом? (як-є ()))) (axiom width-equals-address))))
      (так (як-є (unify-d1 (status fail)))))))

(свідок-уніфікації-д1)
