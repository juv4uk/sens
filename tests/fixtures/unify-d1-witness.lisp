; Свідчення першого домену для уніфікації СЕНС.
; Ширина адреси визначає семантичну тотожність.
; Точну істину й хибу обчислює СЕНС, не Python і не Rust.
; Безумовна гілка використовує істину Д1.
; Ратифіковані маркери свідчення залишаються цитованими даними.

(завантажити-файл "lib/core.lisp")
(завантажити-файл "lib/unify.lisp")

(визначити істина-д1 (атом? (як-є ())))
(визначити хиба-д1 (тотожне? (як-є (0)) (як-є (1))))

(визначити альтернатива-має-значення-д1?
  (функція ()
    (за-умовою
      ((тотожне? (як-є no) (як-є yes)) хиба-д1)
      ((атом? (як-є ())) істина-д1))))

(визначити свідок-уніфікації-д1
  (функція ()
    (за-умовою
      ((тотожне? (альтернатива-має-значення-д1?) істина-д1)
       (як-є (unify-d1
              (status pass)
              (d1-true (атом? (як-є ())))
              (cond-else exact-d1)
              (surfaces var? lookup-subst unify occurs-check)
              (axiom width-equals-address))))
      ((атом? (як-є ()))
       (як-є (unify-d1 (status fail) (cond-else not-d1)))))))

(свідок-уніфікації-д1)
