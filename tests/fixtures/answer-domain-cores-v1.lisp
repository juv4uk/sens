; #1663 — спільна фістура домену відповіді для ядер Core1–Core4.
;
; Один закон, одна фікстура, чотири профілі:
;   так = 1, ні = 0. Більше ніщо відповіддю бути не може.
;
; Дві незалежні виміри, бо закон і носій — різні речі:
;   «очікуване» — ЗНАЧЕННЯ відповіді: 1 (так) або 0 (ні).
;   «носій»     — як значення сповнене: список бітів (1)/(0) чи скаляр 1/0.
;                 Ратифікований носій задає окремий договір проєкцій, тому
;                 ключ «носій» є лише там, де він ратифікований. Де ключа
;                 немає — носій відкритий, і спостерігач його не асертить,
;                 а друкує як UNRESOLVED.
;
; Усі ключі та символи-дані — літери української розкладки
; (а б в г ґ д е є ж з и і ї й к л м н о п р с т у ф х ц ч ш щ ь ю я).
; Ідентифікація функцій — лише восьмибітним кодом СЕНС, ніколи іменем.
;   00000001 — quote
;   00000010 — перевірка «атом чи ні»
;   00000011 — перевірка «те саме чи різне»
;   00011010 — перевірка «менше за»
;
; Ключ «ядра» — вимір профілю, якого стосується рядок.
; Ключ «статус» — «спільний» (асертиться), «розширення» або
; «носій-відкритий» (лише друкується як доказ, не асертиться).

; --- спільний закон: значення відповіді = 1 або 0 ---

((ід . "атом-так")
 (вираз . "(00000010 (00000001 а))")
 (очікуване . "1")
 (носій . "(1)")
 (ядра . (1 2 3 4))
 (статус . "спільний"))

((ід . "атом-ні")
 (вираз . "(00000010 (00000001 (1 2)))")
 (очікуване . "0")
 (носій . "(0)")
 (ядра . (1 2 3 4))
 (статус . "спільний"))

((ід . "рівність-те-саме")
 (вираз . "(00000011 (00000001 а) (00000001 а))")
 (очікуване . "1")
 (носій . "(1)")
 (ядра . (1 2 3 4))
 (статус . "спільний"))

((ід . "рівність-різні")
 (вираз . "(00000011 (00000001 а) (00000001 б))")
 (очікуване . "0")
 (носій . "(0)")
 (ядра . (1 2 3 4))
 (статус . "спільний"))

; --- спільний закон, але носій ще не ратифікований для цього коду ---

((ід . "менше-так")
 (вираз . "(00011010 1 2)")
 (очікуване . "1")
 (ядра . (1 2 3 4))
 (статус . "носій-відкритий"))

((ід . "менше-ні")
 (вираз . "(00011010 2 1)")
 (очікуване . "0")
 (ядра . (1 2 3 4))
 (статус . "носій-відкритий"))

((ід . "менше-дорівнює-ні")
 (вираз . "(00011010 1 1)")
 (очікуване . "0")
 (ядра . (1 2 3 4))
 (статус . "носій-відкритий"))

; --- розширення: третій стан, поза спільним законом ---

((ід . "порожній-список")
 (вираз . "(00000010 (00000001 ()))")
 (очікуване . "")
 (носій . "()")
 (ядра . (1 2 3 4))
 (статус . "розширення"))
