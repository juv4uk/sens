; #1663 — спільна фікстура домену відповіді для ядер Core1–Core4.
;
; Закон буквально, без вимірок і винятків:
;   так = 1, ні = 0. Відповіддю є рівно 1 або рівно 0.
;   (1), (0), (), t, T, nil — не є відповіддю «так» і не є відповіддю «ні».
;
; Усі ключі та символи-дані — літери української розкладки
; (а б в г ґ д е є ж з и і ї й к л м н о п р с т у ф х ц ч ш щ ь ю я).
; Числа, дужки та пробіли від розкладки не залежать.
;
; Ідентифікація кожної функції — лише восьмибітним кодом СЕНС, ніколи
; іменем. Основа тотожності — самі вісім бітів.
;   00000001 — quote
;   00000010 — перевірка «атом чи ні»
;   00000011 — перевірка «те саме чи різне»
;   00011010 — перевірка «менше за»
;
; Ключ «ядра» — вимір профілю, якого стосується рядок.

((ід . "атом-так")
 (вираз . "(00000010 (00000001 а))")
 (очікуване . "1")
 (ядра . (1 2 3 4)))

((ід . "атом-ні")
 (вираз . "(00000010 (00000001 (1 2)))")
 (очікуване . "0")
 (ядра . (1 2 3 4)))

((ід . "рівність-те-саме")
 (вираз . "(00000011 (00000001 а) (00000001 а))")
 (очікуване . "1")
 (ядра . (1 2 3 4)))

((ід . "рівність-різні")
 (вираз . "(00000011 (00000001 а) (00000001 б))")
 (очікуване . "0")
 (ядра . (1 2 3 4)))

((ід . "менше-так")
 (вираз . "(00011010 1 2)")
 (очікуване . "1")
 (ядра . (1 2 3 4)))

((ід . "менше-ні")
 (вираз . "(00011010 2 1)")
 (очікуване . "0")
 (ядра . (1 2 3 4)))

((ід . "менше-дорівнює-ні")
 (вираз . "(00011010 1 1)")
 (очікуване . "0")
 (ядра . (1 2 3 4)))

; Порожній список. Закон вимагає 0. Фактично ядро 2 дає 1, а ядра 3 і 4
; дають () — обидва порушення, обидва зафіксовані як такі.
((ід . "порожній-список")
 (вираз . "(00000010 (00000001 ()))")
 (очікуване . "0")
 (ядра . (1 2 3 4)))
