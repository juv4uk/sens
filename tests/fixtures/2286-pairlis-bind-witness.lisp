; Свідчення #2286: історичне спарювання параметрів і аргументів.
; Рекурсивна побудова з історичної PAIRLIS і порівняння
; з українською функцією «спарувати» зберігають той самий закон.
; Цитовані імена змінних та дані оточення навмисно не перекладено.

(визначити історичне-спарювання
  (функція (параметри аргументи оточення)
    (за-умовою
      ((тотожне? параметри (як-є ())) оточення)
      (так
       (сполучити
         (сполучити (перше параметри) (перше аргументи))
         (історичне-спарювання
           (решта параметри) (решта аргументи) оточення))))))

(історичне-спарювання
  (як-є (X Y))
  (як-є (1 2))
  (як-є ((OLD . ENV))))

(спарувати
  (як-є (X Y))
  (як-є (1 2))
  (як-є ((OLD . ENV))))

(знайти-за-ключем
  (як-є X)
  (історичне-спарювання
    (як-є (X X))
    (як-є (FIRST SECOND))
    (як-є ())))

(знайти-за-ключем
  (як-є X)
  (спарувати
    (як-є (X X))
    (як-є (FIRST SECOND))
    (як-є ())))

(спарувати
  (як-є ())
  (як-є ())
  (як-є ((OLD . ENV))))

(спарувати
  (як-є (X))
  (як-є (1 2))
  (як-є ()))

(спарувати
  (як-є (X Y))
  (як-є (1))
  (як-є ()))
