; Свідчення точності ширини доменів у людській проєкції СЕНС.
; Аксіома: ширина двійкового слова входить до його доменної адреси.
; Д1 має два однобітні ключі, Д2 — чотири двобітні;
; кожна наступна ширина визначає власний простір адрес.
; Семантику засвідчує СЕНС; предикати повертають точні «так»/«ні» Д1.
; Некоректний атом замість списку ключів тепер дає «ні», а не успіх.
; Цитовані маркери результату й ключі таблиці не змінюються.

(завантажити-файл "lib/core.lisp")

; Перший домен має рівно два ключі шириною один біт.
(визначити ключі-д1
  (як-є ((0) (1))))

(визначити перевірити-ширину-ключів-д1?
  (функція (ключі)
    (за-умовою
      ((порожній? ключі) так)
      ((атом? ключі) ні)
      (так
       (за-умовою
         ((тотожне? (перше (перше ключі)) (як-є 0))
          (перевірити-ширину-ключів-д1? (решта ключі)))
         ((тотожне? (перше (перше ключі)) (як-є 1))
          (перевірити-ширину-ключів-д1? (решта ключі)))
         (так ні))))))

; Другий домен має чотири ключі шириною два біти.
(визначити ключі-д2
  (як-є ((00) (01) (10) (11))))

(визначити перевірити-бітність-доменів
  (функція ()
    (за-умовою
      ((перевірити-ширину-ключів-д1? ключі-д1)
       (як-є (domain-bitness
               (status pass)
               (d1-width 1)
               (d1-rows 2)
               (d2-width 2)
               (d2-rows 4)
               (axiom width-equals-address))))
      (так
       (як-є (domain-bitness (status fail) (d1-width mismatch)))))))

(перевірити-бітність-доменів)
