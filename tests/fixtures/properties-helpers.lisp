; Допоміжні функції для перевірок властивостей СЕНС.
; Власні визначення, параметри та викличні голови українською.
; Історичні назви з текстових властивостей залишено лише як псевдоніми.

(визначити побудувати-мапу
  (функція (ключі мапа)
    (за-умовою
      ((атом? ключі) мапа)
      (так (побудувати-мапу
             (решта ключі)
             (спарувати (перше ключі) (перше ключі) мапа))))))

(визначити ключі-мапи-впорядковані?
  (функція (список-ключів)
    (за-умовою
      ((атом? список-ключів) так)
      ((атом? (решта список-ключів)) так)
      ((менше? (перше (перше (решта список-ключів)))
               (перше (перше список-ключів)))
       (як-є ()))
      (так (ключі-мапи-впорядковані? (решта список-ключів))))))

(визначити число-фібоначчі
  (функція (число)
    (за-умовою
      ((менше? число 2) число)
      (так (додати
             (число-фібоначчі (додати число -1))
             (число-фібоначчі (додати число -2)))))))

(визначити побудувати-світ
  (функція (події світ)
    (за-умовою
      ((атом? події) світ)
      (так (побудувати-світ
             (решта події)
             (світ-повідомити світ "mod" (перше події)))))))

(визначити повідомити-всі-події
  (функція (події)
    (за-умовою
      ((атом? події) так)
      (так (нехай ((пропущене
                     (визначити-модуль "mod" (список (перше події)))))
             (повідомити-всі-події (решта події)))))))

; Сумісні зовнішні імена, на які посилаються старі текстові властивості.
; Вони не визначають нових функцій чи машинних координат.
(визначити build-map побудувати-мапу)
(визначити map-keys-sorted? ключі-мапи-впорядковані?)
(визначити fib число-фібоначчі)
(визначити build-world побудувати-світ)
(визначити tell-all-events повідомити-всі-події)
