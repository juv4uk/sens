; Єдиний семантичний оракул — SENS. Rust лише завантажує, виконує та спостерігає D1.
; Усі виконувані вбудовані голови мають точні D3:001/010/011/100/101/110/111,
; D4:0010/0011/1110. Приватні імена — Lisp-owned зв'язування, не нові резиденти.
; D1:0 і D1:1 — бітові проєкції, не числа і не структурне ().
; Хибний закон переходить до свідомо невикличної D1:0 голови.

(0011 уніфікація--ні?
  (0010 (біт)
    (110
      (біт #d1:0)
      (#d1:1 #d1:0))))

(0011 уніфікація--всі?
  (0010 (свідки)
    (110
      ((010 свідки) #d1:1)
      ((100 свідки) (уніфікація--всі? (011 свідки)))
      (#d1:1 (#d1:0)))))

(0011 уніфікація--закон-d1
  (0010 ()
    (уніфікація--всі?
      (1110
        ; D3 EQ застосовується тільки після перевірки атомності.
        (unify-equal? (001 ()) (001 ()))
        (unify-equal? (001 а) (001 а))
        (уніфікація--ні? (unify-equal? (001 а) (001 б)))
        (уніфікація--ні? (unify-equal? (001 а) (001 (а))))
        (уніфікація--ні? (unify-equal? (001 (а)) (001 а)))
        (unify-equal? (001 (а (б в))) (001 (а (б в))))
        (уніфікація--ні? (unify-equal? (001 (а (б в))) (001 (а (б г)))))
        (уніфікація--ні? (unify-equal? (001 (а)) (001 (а б))))
        ; Приклади D1:0 у var? не можуть повертати () або Number 0.
        (var? (001 (var x)))
        (уніфікація--ні? (var? (001 (інше x))))
        (уніфікація--ні? (var? (001 x)))
        ; Fail marker — атом, порожня підстановка — окремий об'єкт D3:000.
        (failed-subst? (001 fail))
        (уніфікація--ні? (failed-subst? (001 ())))))))

(уніфікація--закон-d1)
