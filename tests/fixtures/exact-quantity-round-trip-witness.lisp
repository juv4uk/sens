; Свідок точної оборотної арифметики наукових величин СЕНС.
; Добуток швидкості світла на одну секунду дає точну відстань.
; Ділення на цю секунду відновлює початкову швидкість.
; Усі виконувані імена — українською, з чинних проєкцій Д1–Д9.
; Перевірка використовує Д1 без застарілих трипольових умов.
; Значення схем quantity/1, unit/1, dimension/1 та назви випадків
; є цитованими даними; вони зберігають історичний протокол свідка.

(визначити рядки-кругової-перевірки-точних-величин
  (функція ()
    (нехай-послідовно
      ((одна-секунда
         (створити-величина
           1
           (створити-одиниця
             (список (створити-розмірність (як-є second) 1)))))
       (швидкість
         (науковий-константа-величина сі:визначальна-швидкість-світла))
       (відстань
         (величина-добуток швидкість одна-секунда))
       (відновлена-швидкість
         (величина-частка відстань одна-секунда)))
      (список
        (список
          (як-є distance-shape)
          (однакові?
            відстань
            (як-є
              (quantity/1
                299792458
                (unit/1 (dimension/1 metre 1))))))
        (список
          (як-є recovered-speed-shape)
          (однакові?
            відновлена-швидкість
            (як-є
              (quantity/1
                299792458
                (unit/1
                  (dimension/1 metre 1)
                  (dimension/1 second -1))))))
        (список
          (як-є quotient-inverse)
          (однакові? відновлена-швидкість швидкість))))))

; Кожен рядок містить назву випадку та точну відповідь Д1.
; Умови мають лише дві частини: предикат і результат.
; Відхилення зберігає назву випадку та фактичну відповідь.
(визначити перевірити-кругове-обчислення-точних-величин
  (функція (рядки)
    (за-умовою
      ((атом? рядки)
       (за-умовою
         ((тотожне? рядки (як-є ()))
          (як-є (exact-quantity-round-trip-witness (status pass))))
         (так
          (список
            (як-є exact-quantity-round-trip-witness)
            (список (як-є status) (як-є fail))
            (список (як-є case) (як-є malformed-row-tail))
            (список (як-є actual) рядки)))))
      (так
       ((функція (рядок)
          (за-умовою
            ((атом? рядок)
             (список
               (як-є exact-quantity-round-trip-witness)
               (список (як-є status) (як-є fail))
               (список (як-є case) (як-є malformed-row))))
            ((друге рядок)
             (перевірити-кругове-обчислення-точних-величин
               (решта рядки)))
            (так
             (список
               (як-є exact-quantity-round-trip-witness)
               (список (як-є status) (як-є fail))
               (список (як-є case) (перше рядок))
               (список (як-є actual) (друге рядок))
               (список (як-є expected) так)))))
        (перше рядки))))))

(визначити свідок-кругового-обчислення-точних-величин
  (функція ()
    (перевірити-кругове-обчислення-точних-величин
      (рядки-кругової-перевірки-точних-величин))))
