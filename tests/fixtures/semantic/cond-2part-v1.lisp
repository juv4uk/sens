; tests/fixtures/semantic/cond-2part-v1.lisp — #1709, закон #1713.
; Умовний вибір допускає лише пари «умова — вираз»:
;   умова = 1 → обчислити й повернути вираз;
;   умова = 0 → перейти до наступної гілки;
;   усі умови = 0 → повернути структурний порожній список ();
;   інша форма гілки → відхилити як недопустиму.
;
; Порожній список, який повертає вичерпаний умовний вибір,
; є звичайним структурним значенням, а НЕ відповіддю предиката.
; Тому заборона третього стану відповіді Д1 його не скасовує.
; Виконувані вирази нині користуються Д3 ЗА-УМОВОЮ та Д8 ОДНАКОВІ?.
; SID8/Sens8 не є мовним інтерфейсом; історія збережена в Git.

((expect . expect-value)
 (expr . "(за-умовою ((однакові? число-один число-один) (як-є обрана-гілка)))")
 (expected . (value обрана-гілка))
 (active . t)
 (name . "COND: test 1 вибирає клаузу")
 (semantic-id . "D3:110")
 (governs . "#1713")
 (note . "Точний біт 1 select -> значення виразу 7."))

((expect . expect-value)
 (expr . "(за-умовою ((однакові? число-один (додати число-один число-один)) (як-є обрана-гілка)))")
 (expected . (value ()))
 (active . t)
 (name . "COND: test 0 пропускає, вичерпання дає структурне ()")
 (semantic-id . "D3:110")
 (governs . "#1713")
 (note . "Точний біт 0 skip -> (), де () — вичерпання, а не відповідь предиката."))

((expect . expect-value)
 (expr . "(за-умовою ((однакові? число-один (додати число-один число-один)) (як-є не-ця-гілка)) ((однакові? число-один число-один) (як-є обрана-гілка)))")
 (expected . (value обрана-гілка))
 (active . t)
 (name . "COND: skip 0 продовжує до наступної клаузи з 1")
 (semantic-id . "D3:110")
 (governs . "#1713")
 (note . "0 пропускається, наступний 1 вибирає 9 — не перший ненулльовий."))

; Негативне свідчення: історична тричастинна гілка
; «запит — очікувана відповідь — вираз» не відповідає закону #1713.
; Ряд залишено неактивним за історичним станом міграції #1713/#1714:
; тодішній читач ще допускав таку форму, а обчислювач повертав
; UnsatisfiedConditional замість відхилення безпосередньо читачем.
; Не слід приписувати цей історичний стан теперішньому main без перевірки.
((expect . expect-rejected)
 (expr . "(за-умовою (ні сім вісім))")
 (expected . (rejected "(за-умовою (ні сім вісім))"))
 (active . ())
 (name . "COND: тричастинна клауза не допускається читачем")
 (semantic-id . "D3:110")
 (governs . "#1713 #1714")
 (note . "Неактивний: main ще приймає 3-частинну форму. Порожній cond (InvalidForm) має нерatifікований закон — ряд свідомо не додано."))
