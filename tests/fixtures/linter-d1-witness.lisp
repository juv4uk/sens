; Свідок логіки Д1 для аналізатора форм СЕНС.
; Точна ширина домену визначає адресу й тотожність.
; Значення істини обчислює СЕНС; зовнішні механізми їх не підмінюють.
; Цитовані назви полів і очікуваних результатів залишаються даними.

(завантажити-файл "lib/core.lisp")
(завантажити-файл "lib/linter.lisp")

(визначити істина-д1 (атом? (як-є ())))
(визначити хиба-д1 (тотожне? (як-є (0)) (як-є (1))))

(визначити альтернатива-має-значення-д1?
  (функція ()
    (за-умовою
      ((тотожне? (як-є no) (як-є yes)) хиба-д1)
      ((атом? (як-є ())) істина-д1))))

(визначити свідок-аналізатора-д1
  (функція ()
    (за-умовою
      ((тотожне? (альтернатива-має-значення-д1?) істина-д1)
       (як-є (linter-d1
              (status pass)
              (d1-true (атом? (як-є ())))
              (cond-else exact-d1)
              (surfaces lint-form-head lint-head lint-size)
              (axiom width-equals-address))))
      ((атом? (як-є ()))
       (як-є (linter-d1 (status fail) (cond-else not-d1)))))))

(свідок-аналізатора-д1)
