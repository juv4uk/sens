;; Свідок знань Д3: актуальна українська проєкція без дублювання псевдонімів.
;; Протокольні позначки та клаузи залишено незмінними.

(визначити д3-створити-пакет
  (функція (назва клаузи метадані)
    (список (як-є knowledge-package) назва клаузи метадані)))

(визначити д3-пакет?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((тотожне? (перше значення) (як-є knowledge-package)) так)
      (так ні))))

(визначити д3-назва-пакета (функція (пакет) (друге пакет)))
(визначити д3-клаузи-пакета (функція (пакет) (третє пакет)))
(визначити д3-метадані-пакета (функція (пакет) (четверте пакет)))

(визначити д3-додати-клаузу
  (функція (пакет клауза)
    (д3-створити-пакет
      (д3-назва-пакета пакет)
      (сполучити клауза (д3-клаузи-пакета пакет))
      (д3-метадані-пакета пакет))))

(визначити д3-відкликати-клаузу
  (функція (пакет клауза)
    (д3-створити-пакет
      (д3-назва-пакета пакет)
      (вилучити клауза (д3-клаузи-пакета пакет))
      (д3-метадані-пакета пакет))))

(визначити д3-клауза-існує?
  (функція (клауза клаузи)
    (за-умовою
      ((атом? клаузи) ні)
      ((однакові? клауза (перше клаузи)) так)
      (так (д3-клауза-існує? клауза (решта клаузи))))))

(визначити д3-об'єднати-клаузи
  (функція (ліве праве)
    (за-умовою
      ((атом? праве) ліве)
      ((д3-клауза-існує? (перше праве) ліве)
       (д3-об'єднати-клаузи ліве (решта праве)))
      (так (д3-об'єднати-клаузи (сполучити (перше праве) ліве) (решта праве))))))

(визначити свідок-знань-д3-до
  (функція ()
    (нехай ((пакет0 (д3-створити-пакет (як-є demo) (як-є ()) (як-є ())))
          (пакет1 (д3-додати-клаузу пакет0 (як-є (fact a))))
          (пакет2 (д3-додати-клаузу пакет1 (як-є (fact b)))))
      (за-умовою
        ((д3-пакет? пакет2)
         (за-умовою
           ((д3-клауза-існує? (як-є (fact a)) (д3-клаузи-пакета пакет2))
            (як-є (knowledge-d3-before-witness (status pass))))
           (так (як-є (knowledge-d3-before-witness (status fail member))))))
        (так (як-є (knowledge-d3-before-witness (status fail not-package))))))))

(свідок-знань-д3-до)
