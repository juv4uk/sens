; Початкова бібліотека Ліспу: похідна поведінка належить самій мові.
; Українська проєкція. Без SID8 call-heads.

(визначити тотожність (функція (значення) значення))
(визначити identity тотожність)

(визначити binary
  (функція (ширина)
    (список (як-є binary) ширина)))

(визначити список (функція аргументи аргументи))
(визначити list список)

(визначити хибне?
  (функція (значення)
    (за-умовою
      (значення (як-є ()))
      (t t))))
(визначити not хибне?)

(визначити пара
  (функція (лівий правий)
    (сполучити лівий (сполучити правий (як-є ())))))
(визначити pair пара)

(визначити друге
  (функція (значення)
    (перше (решта значення))))
(визначити second друге)

(визначити третє
  (функція (значення)
    (перше (решта (решта значення)))))
(визначити third третє)

(визначити четверте
  (функція (значення)
    (перше (решта (решта (решта значення))))))
(визначити fourth четверте)
(визначити cadddr четверте)

(визначити п'ятий
  (функція (значення)
    (перше (решта (решта (решта (решта значення)))))))
(визначити fifth п'ятий)

(визначити перше-першого
  (функція (значення)
    (перше (перше значення))))
(визначити caar перше-першого)
(визначити cadr друге)

(визначити решта-решти
  (функція (значення)
    (решта (решта значення))))
(визначити cddr решта-решти)

(визначити довжина-до
  (функція (значення накопичувач)
    (за-умовою
      ((атом? значення) накопичувач)
      (t (довжина-до (решта значення) (зчепити накопичувач 1))))))
(визначити length-onto довжина-до)

(визначити довжина
  (функція (значення)
    (довжина-до значення 0)))
(визначити length довжина)

(визначити зворот-до
  (функція (значення накопичувач)
    (за-умовою
      ((атом? значення) накопичувач)
      (t (зворот-до (решта значення) (сполучити (перше значення) накопичувач))))))
(визначити reverse-onto зворот-до)

(визначити зворот
  (функція (значення)
    (зворот-до значення (як-є ()))))
(визначити reverse зворот)

(визначити приєднати
  (функція (лівий правий)
    (зворот-до (зворот лівий) правий)))
(визначити append приєднати)

(визначити відобразити-до
  (функція (перетворення значення накопичувач)
    (за-умовою
      ((атом? значення) (зворот накопичувач))
      (t (відобразити-до перетворення (решта значення)
            (сполучити (перетворення (перше значення)) накопичувач))))))
(визначити map-onto відобразити-до)

(визначити відобразити
  (функція (перетворення значення)
    (відобразити-до перетворення значення (як-є ()))))
(визначити map відобразити)

(визначити відсіяти-до
  (функція (предикат значення накопичувач)
    (за-умовою
      ((атом? значення) (зворот накопичувач))
      ((предикат (перше значення))
       (відсіяти-до предикат (решта значення)
         (сполучити (перше значення) накопичувач)))
      (t (відсіяти-до предикат (решта значення) накопичувач)))))
(визначити filter-onto відсіяти-до)

(визначити відсіяти
  (функція (предикат значення)
    (відсіяти-до предикат значення (як-є ()))))
(визначити filter відсіяти)

(визначити згорнути
  (функція (операція накопичувач значення)
    (за-умовою
      ((атом? значення) накопичувач)
      (t (згорнути операція (операція накопичувач (перше значення)) (решта значення))))))
(визначити reduce згорнути)

(визначити однакові?
  (функція (ліве праве)
    (за-умовою
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (тотожне? ліве праве))
         (t (як-є ()))))
      ((атом? праве) (як-є ()))
      ((однакові? (перше ліве) (перше праве))
       (однакові? (решта ліве) (решта праве)))
      (t (як-є ())))))
(визначити equal? однакові?)

(визначити racket-boot-core-ready
  (функція ()
    (як-є (racket-boot-core (status pass) (projection ukr)))))
