; Початкова бібліотека Ліспу: похідна поведінка належить самій мові.
; Лише повні українські викличні назви; без латинських alias чи плоских кодів.
; Істина та хиба — точний D1, а не host t чи порожній список.
; Для всіх обходів тільки структурне D3 () завершує правильний список.
; Інший атом — SENS Type через D3 ПЕРШЕ над ().

(визначити тотожність (функція (значення) значення))

(визначити двійковий-опис
  (функція (ширина)
    (список (як-є binary) ширина)))

(визначити список (функція аргументи аргументи))

(визначити хибне?
  (функція (значення)
    (за-умовою
      (значення ні)
      ((атом? (як-є ())) так))))

(визначити пара
  (функція (лівий правий)
    (сполучити лівий (сполучити правий (як-є ())))))

(визначити друге
  (функція (значення)
    (перше (решта значення))))

(визначити третє
  (функція (значення)
    (перше (решта (решта значення)))))

(визначити четверте
  (функція (значення)
    (перше (решта (решта (решта значення))))))

(визначити п'ятий
  (функція (значення)
    (перше (решта (решта (решта (решта значення)))))))

(визначити перше-першого
  (функція (значення)
    (перше (перше значення))))

(визначити решта-решти
  (функція (значення)
    (решта (решта значення))))

(визначити довжина-до
  (функція (значення накопичувач)
    (за-умовою
      ((атом? значення)
       (за-умовою
         ((тотожне? значення (як-є ())) накопичувач)
         (так (перше (як-є ())))))
      (так (довжина-до (решта значення) (додати накопичувач число-один))))))

(визначити довжина
  (функція (значення)
    (довжина-до значення число-нуль)))

(визначити зворот-до
  (функція (значення накопичувач)
    (за-умовою
      ((атом? значення)
       (за-умовою
         ((тотожне? значення (як-є ())) накопичувач)
         (так (перше (як-є ())))))
      (так (зворот-до (решта значення) (сполучити (перше значення) накопичувач))))))

(визначити зворот
  (функція (значення)
    (зворот-до значення (як-є ()))))

(визначити приєднати
  (функція (лівий правий)
    (зворот-до (зворот лівий) правий)))

(визначити відобразити-до
  (функція (перетворення значення накопичувач)
    (за-умовою
      ((атом? значення)
       (за-умовою
         ((тотожне? значення (як-є ())) (зворот накопичувач))
         (так (перше (як-є ())))))
      (так (відобразити-до перетворення (решта значення) (сполучити (перетворення (перше значення)) накопичувач))))))

(визначити відобразити
  (функція (перетворення значення)
    (відобразити-до перетворення значення (як-є ()))))

(визначити відсіяти-до
  (функція (предикат значення накопичувач)
    (за-умовою
      ((атом? значення)
       (за-умовою
         ((тотожне? значення (як-є ())) (зворот накопичувач))
         (так (перше (як-є ())))))
      ((предикат (перше значення))
       (відсіяти-до предикат (решта значення)
         (сполучити (перше значення) накопичувач)))
      (так
       (відсіяти-до предикат (решта значення) накопичувач)))))

(визначити відсіяти
  (функція (предикат значення)
    (відсіяти-до предикат значення (як-є ()))))

(визначити згорнути
  (функція (операція накопичувач значення)
    (за-умовою
      ((атом? значення)
       (за-умовою
         ((тотожне? значення (як-є ())) накопичувач)
         (так (перше (як-є ())))))
      (так (згорнути операція (операція накопичувач (перше значення)) (решта значення))))))

(визначити однакові?
  (функція (ліве праве)
    (за-умовою
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (тотожне? ліве праве))
         ((атом? (як-є ())) ні)))
      ((атом? праве) ні)
      ((однакові? (перше ліве) (перше праве))
       (однакові? (решта ліве) (решта праве)))
      ((атом? (як-є ())) ні))))

(визначити готовність-ядра-ракет
  (функція ()
    (як-є (racket-boot-core (status pass) (projection ukr)))))
