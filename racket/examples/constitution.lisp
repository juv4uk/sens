; Конституція: чинна українська виконувана проєкція СЕНС.
; Первісні цитовані символи й математичні значення збережено.
; Виклики — ратифіковані українські імена; істина/хиба — точний D1.
; Це програма СЕНС, а не історичний модуль хостового Racket.

(друкувати (поділити 5 336))
(друкувати (поділити 5.0 2))

(друкувати (як-є constitution))
(друкувати (атом? (як-є x)))
(друкувати (атом? (як-є (x))))
(друкувати (тотожне? (як-є a) (як-є a)))
(друкувати (тотожне? (як-є a) (як-є b)))
(друкувати (перше (як-є (a b))))
(друкувати (решта (як-є (a b))))
(друкувати (сполучити (як-є a) (як-є (b))))
(друкувати
  (за-умовою
    ((тотожне? (як-є a) (як-є b)) (як-є ні))
    ((атом? (як-є ())) (як-є так))))

; Початкове «коли» містило один фактичний виклик.
; Його коротке обчислення подано чинною умовною формою D3,
; без історичного макроса та подвійної семантики.
(за-умовою
  ((тотожне? (як-є лісп) (як-є лісп))
   (друкувати (як-є лісп-працює)))
  ((атом? (як-є ())) ні))

; Нативний контроль Д1 після дванадцяти друків.
; Не плутати хибу TOTОЖНЕ? зі структурним порожнім списком.
; CAR(CONS a b) = a; EQ(a,b) = ні для різних ратифікованих символів.
(за-умовою
  ((тотожне? (перше (сполучити (як-є а) (як-є (б)))) (як-є а))
   (хибне? (тотожне? (як-є а) (як-є б))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
