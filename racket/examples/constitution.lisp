; Конституція: чинна українська виконувана проєкція СЕНС.
; Первісні цитовані символи й математичні значення збережено.
; Виклики — ратифіковані українські імена; істина/хиба — точний D1.
; Це програма СЕНС, а не історичний модуль хостового Racket.

; Первісні дванадцять обчислень стають значеннями SENS-списку.
; Друк є зовнішньою IO-межею, тому не маскуємо відсутній
; виконавчий механізм «друкувати» фальшивою функцією тотожності.
; Кожний елемент обчислює SENS; D3 CONS зберігає результат як дані.
(визначити результати-конституції
  (список
    (поділити 5 336)
    (поділити 5.0 2)
    (як-є constitution)
    (атом? (як-є x))
    (атом? (як-є (x)))
    (тотожне? (як-є a) (як-є a))
    (тотожне? (як-є a) (як-є b))
    (перше (як-є (a b)))
    (решта (як-є (a b)))
    (сполучити (як-є a) (як-є (b)))
    (за-умовою
      ((тотожне? (як-є a) (як-є b)) (як-є ні))
      ((атом? (як-є ())) (як-є так)))
    (за-умовою
      ((тотожне? (як-є лісп) (як-є лісп))
       (як-є лісп-працює))
      ((атом? (як-є ())) (як-є ())))))
  
; Нативний D1-свідок: два числа обчислено, третій з 12 результатів
; лишився точним символом, а EQ різних цитованих даних дає хибу.
; Усе перевіряє SENS, не зовнішній скрипт.
(за-умовою
  ((тотожне? (перше (решта (решта результати-конституції))) (як-є constitution))
   (хибне? (тотожне? (як-є а) (як-є б))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
