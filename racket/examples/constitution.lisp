; Конституція: чинна українська виконувана проєкція СЕНС.
; Цитовані дані лишаються D7, арифметичні операнди — D24+.
; Виклики — ратифіковані українські імена; істина/хиба — точний D1.
; Це програма СЕНС, а не історичний модуль хостового Racket.

; Первісні дванадцять обчислень стають значеннями SENS-списку.
; Друк є зовнішньою IO-межею, тому не маскуємо відсутній
; виконавчий механізм «друкувати» фальшивою функцією тотожності.
; Кожний елемент обчислює SENS; D3 CONS зберігає результат як дані.
; Знаменник у точному D24+: шість × сім × вісім = триста тридцять шість.
; Числа надходять з іменованих прив'язок ядра, без source-літералів.
(визначити конституція-число-триста-тридцять-шість
  (помножити
    (помножити (додати число-п'ять число-один) число-сім)
    число-вісім))

(визначити результати-конституції
  (список
    (частка число-п'ять конституція-число-триста-тридцять-шість)
    (частка число-п'ять число-два)
    (як-є constitution)
    (атом? (як-є атом?))
    (атом? (як-є (x)))
    (тотожне? (як-є атом?) (як-є атом?))
    (тотожне? (як-є атом?) (як-є тотожне?))
    (перше (як-є (a b)))
    (решта (як-є (a b)))
    (сполучити (як-є a) (як-є (b)))
    (за-умовою
      ((тотожне? (як-є атом?) (як-є тотожне?)) (як-є ні))
      ((атом? (як-є ())) (як-є так)))
    (за-умовою
      ((тотожне? (як-є атом?) (як-є атом?))
       (сполучити (як-є лісп)
         (сполучити (як-є лісп-працює) (як-є ()))))
      ((атом? (як-є ())) (як-є ())))))
  
; Нативний D1-свідок: два числа обчислено, третє D7-значення
; зберегло свою структуру, а EQ двох різних ратифікованих атомів дає хибу.
; Усе перевіряє SENS, не зовнішній скрипт.
(за-умовою
  ((хибне? (атом? (перше (решта (решта результати-конституції)))))
   (хибне? (тотожне? (як-є атом?) (як-є тотожне?))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
