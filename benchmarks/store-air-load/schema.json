{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sens-store-air-load/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fixture_id",
    "fixture_kind",
    "representation",
    "repo",
    "git_sha",
    "contract_version",
    "semantic_identity_digest",
    "identity_proof",
    "semantic_word_count",
    "expected_semantic_bits",
    "semantic_payload_bits",
    "framing_bits",
    "integrity_bits",
    "profile_overhead_bits",
    "tail_unused_bits",
    "carrier_mode",
    "carrier_payload_bits",
    "storage_container_bits",
    "total_wire_bits",
    "physical_container_bytes",
    "payload_utilization",
    "text_surface_bytes",
    "packed_vs_text_ratio",
    "bitrate_bps",
    "ideal_airtime_seconds",
    "decode_i_refs",
    "parse_i_refs",
    "lower_i_refs",
    "ready_i_refs",
    "cold_total_i_refs",
    "warm_incremental_i_refs",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "sens-store-air-load/v1"
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_kind": {
      "enum": [
        "mechanical",
        "paired-program"
      ]
    },
    "representation": {
      "enum": [
        "canonical-packed",
        "text-surface"
      ]
    },
    "repo": {
      "const": "juv4uk/sens"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "semantic_identity_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity_proof": {
      "enum": [
        "mechanical-exact-word-sequence",
        "paired-lowered-trace"
      ]
    },
    "semantic_payload_bits": {
      "type": "integer",
      "minimum": 1
    },
    "framing_bits": {
      "type": "integer",
      "minimum": 0
    },
    "tail_unused_bits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "total_wire_bits": {
      "type": "integer",
      "minimum": 1
    },
    "physical_container_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "text_surface_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "packed_vs_text_ratio": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "bitrate_bps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "ideal_airtime_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "decode_i_refs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "parse_i_refs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "lower_i_refs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "ready_i_refs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cold_total_i_refs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "warm_incremental_i_refs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "provenance": {
      "type": "object"
    },
    "carrier_mode": {
      "enum": [
        "exact-bitstream",
        "byte-container",
        "text-bytes"
      ]
    },
    "carrier_payload_bits": {
      "type": "integer",
      "minimum": 1
    },
    "storage_container_bits": {
      "type": "integer",
      "minimum": 8
    },
    "semantic_word_count": {
      "type": "integer",
      "minimum": 1
    },
    "expected_semantic_bits": {
      "type": "integer",
      "minimum": 1
    },
    "integrity_bits": {
      "type": "integer",
      "minimum": 0
    },
    "profile_overhead_bits": {
      "type": "integer",
      "minimum": 0
    },
    "payload_utilization": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  }
}
