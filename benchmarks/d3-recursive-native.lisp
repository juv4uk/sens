; Нативний SENS-бенчмарк рекурсивного проходу Д3.
; Джерело — український Lisp; Zig/T5M лише переносить фізичні байти.
; Rust і Zig не визначають мовної істини. Результат — точне Д1:так.
; Три позитивні розміри й негативний атомний хвіст; жодних числових голів.

(визначити бенчмарк-д3-правильний-список?
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) так)
      ((атом? елементи) ні)
      ((хибне? (атом? елементи))
       (бенчмарк-д3-правильний-список? (решта елементи))))))

(за-умовою
  ((бенчмарк-д3-правильний-список? (як-є ()))
   (за-умовою
     ((бенчмарк-д3-правильний-список? (як-є (())))
      (за-умовою
        ((бенчмарк-д3-правильний-список?
           (як-є (() () () () () () () () () () () ())))
         (хибне? (бенчмарк-д3-правильний-список? (як-є атом?))))
        (так ні)))
     (так ні)))
  (так ні))
