; Конкурс: компактний варіант повного розгортання зі зворотним порядком.
; Лише ратифіковані українські голови Д3-Д4; Д7 для локальних назв.
; Змінні входи, Т5М-оберненість і виконання доводить нативний суд.
(визначити р
  (функція (с а)
    (за-умовою
      ((атом? с) а)
      ((порожній? (перше с)) (р (решта с) а))
      ((атом? (перше с)) (р (решта с) (сполучити (перше с) а)))
      (так (р (решта с) (р (перше с) а))))))
(р (список 1 (список 2 3) 4) (як-є ()))
