; Конкурс: центроване трикутне число 1+3*н*(н-1)/2.
; Д6 додати-1 і відняти-1 замість двох бінарних операцій з одиницею.
; Нуль, одиниця, змінні входи й негативний мутант — нативний суд СЕНС.
(визначити ц
  (функція (н)
    (додати-1 (частка (помножити (довжина (як-є (а б в))) (помножити н (відняти-1 н))) (довжина (як-є (а б)))))))
(ц (довжина (як-є (а б в г ґ д е є ж з))))
