; Конкурс: сума трикутних чисел від 1 до н.
; Той самий закон н*(н+1)*(н+2)/6 без нового числового літерала 2.
; Ніяких SID8/Sens8: Д6 приріст і чинна Д24+ арифметика СЕНС.
; Справжній суд перевіряє незалежні змінні входи та T5M-оберненість.
(визначити с
  (функція (н)
    (частка
      (помножити
        (помножити н (додати-1 н))
        (додати-1 (додати-1 н)))
      (довжина (як-є (а б в г ґ д))))))
(с (довжина (як-є (а б в г ґ д е є ж з))))
