; Точна арифметика, результат перевіряє рідний виконавець.
(визначити с
  (функція (н)
    (частка (помножити н (відняти (помножити (довжина (як-є (а б в г ґ))) н) (довжина (як-є (а б в))))) (довжина (як-є (а б))))))
(с (довжина (як-є (а б в г ґ д е є ж з))))
