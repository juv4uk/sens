; Конкурс незалежних точних законів: H7(н)=н+5*T(н-1), T(н-1)=н(н-1)/2.
; Програма виконується СЕНС на змінних математичних D24+ входах.
; Це альтернативний алгоритм, не підміна результату числом 235.
(визначити с
 (функція (н)
  (додати н
   (частка
    (помножити 5 (помножити н (відняти н 1)))
    2))))
(с 10)
