; Той самий закон кількість(н,2) = кількість(н-1,2)+(н-1), незалежний конкурент.
; Нуль та одиниця не створюють пар; точна Д24+ арифметика.
; Порівняти з прямою формулою за реальним СЕНС та Зіг і Т5М.
(визначити п
  (функція (н)
    (за-умовою
      ((менше? н 2) 0)
      (так (додати (відняти н 1) (п (відняти н 1)))))))
(п 10)
