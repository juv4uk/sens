; Конкурс: один зовнішній аргумент Фібоначчі, лінійний хвостовий обхід.
; На відміну від двогілкової рекурсії, кожен крок обчислюється один раз.
; Тільки український СЕНС та точна арифметика Д24+.
(визначити фіб-крок
  (функція (н а б)
    (за-умовою
      ((тотожне? н 0) а)
      (так (фіб-крок (відняти н 1) б (додати а б))))))
(визначити ф
  (функція (н)
    (фіб-крок н 0 1)))
(ф 10)
