; Конкурс СЕНС: сума четвертих степенів з єдиним квадратом на крок.
; Квадрат н*н обчислюється один раз, далі квадрат*квадрат.
; Хвостова рекурсія: жодного раннього посилання на пізній DEFINE,
; анонімної викличної голови, Д6 НЕХАЙ, SID8 або хостового обчислення.
; Чинна математика Д24+; Zig пакує T5M, SENS виконує всі кроки.
(визначити додати-четвертий-за-квадратом
  (функція (підсумок квадрат)
    (додати підсумок (помножити квадрат квадрат))))
(визначити сума-четвертих-накопичити
  (функція (н підсумок)
    (за-умовою
      ((нуль? н) підсумок)
      (так
        (сума-четвертих-накопичити
          (відняти-1 н)
          (додати-четвертий-за-квадратом
            підсумок (помножити н н)))))))
(визначити сума-четвертих-із-квадратом
  (функція (н)
    (сума-четвертих-накопичити н 0)))
(сума-четвертих-із-квадратом 10)
