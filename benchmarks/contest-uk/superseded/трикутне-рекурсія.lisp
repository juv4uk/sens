; Конкурс СЕНС: незалежна рекурсія T(0)=0, T(н)=н+T(н−1).
; Хвостовий акумулятор замість незавершеного ланцюга додавань.
; Конкурсу належить порівняти реальні T5M, AST і відвідування, не обіцяти виграш.
; Тільки українські першокласні доменні функції, математика Д24+.
(визначити т-накопичити
  (функція (н сума)
    (за-умовою
      ((нуль? н) сума)
      (так
        (т-накопичити
          (відняти-1 н)
          (додати сума н))))))
(визначити т
  (функція (н)
    (т-накопичити н 0)))
(т 10)
