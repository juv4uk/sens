; Конкурс: точна формула суми четвертих степенів без рекурсії.
; С(н) = н(н+1)(2н+1)(3н(н+1)-1) поділити на 30.
; Не множимо повний чисельник: уже на н=20 він розширюється за Д24
; і старе ділення змішує ширини, що справжній СЕНС правильно відхиляє.
; Ділимо парний н(н+1) на 2, а добуток р - на частку і залишок за 15.
; р*с і 15 = (р і 15)*с + ((р - (р і 15)*15)*с) і 15,
; де  і  - цілочислова частка, а останнє ділення точне.
; Д24+ достатньо на всіх конкурсних змінних входах 0..20.
; Значення обчислює лише СЕНС, Зіг пакує фізичний Т5М.

(визначити ч4-точне-ділення
 (функція (добуток множник)
  (додати
   (помножити (частка добуток 15) множник)
   (частка
    (помножити
     (відняти добуток (помножити (частка добуток 15) 15))
     множник)
    15))))

(визначити ч4-горнер
 (функція (н)
  (ч4-точне-ділення
   (помножити
    (частка (помножити н (додати-1 н)) 2)
    (додати-1 (помножити 2 н)))
   (відняти
    (помножити 3 (помножити н (додати-1 н)))
    1))))

(ч4-горнер 10)
