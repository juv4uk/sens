; Конкурс: S4(н) = н(н+1)(2н+1)(3н(н+1)-1)/30.
; Чинний SENS забороняє змішувати D48 чисельник та D24 дільник.
; Спочатку точна частка н(н+1)/30 у D24 (може бути дробовою),
; потім множимо: це зберігає формулу та уникає зайвого D48
; на всіх змінних входах н=0..30 нативного конкурсу.
; Арифметика належить SENS D24+, Zig транспортує лише T5M.
(визначити с
  (функція (н)
    (помножити
      (помножити
        (частка
          (помножити н (додати-1 н))
          30)
        (додати-1 (помножити 2 н)))
      (відняти-1
        (помножити 3 (помножити н (додати-1 н)))))))
(с 10)
