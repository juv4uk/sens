; Конкурс: залишити лише атоми зі списку.

(визначити лише-атоми
  (функція (залишок акумулятор)
    (за-умовою
      ((порожній? залишок) акумулятор)
      ((атом? залишок) акумулятор)
      ((порожній? (перше залишок))
       (лише-атоми (решта залишок) акумулятор))
      ((атом? (перше залишок))
       (сполучити (перше залишок) (лише-атоми (решта залишок) акумулятор)))
      (так (лише-атоми (решта залишок) акумулятор)))))

(лише-атоми (список 1 (список 2) 3) (як-є ()))
