; Конкурс: перевірка атома перед порожнечею, менше перевірок вкладених пар.
; Точна українська проєкція, правильні списки та незмінний порядок атомів.
(визначити л
  (функція (з а)
    (за-умовою
      ((атом? з) а)
      ((атом? (перше з))
       (за-умовою
         ((порожній? (перше з)) (л (решта з) а))
         (так (сполучити (перше з) (л (решта з) а)))))
      (так (л (решта з) а)))))
(л (список 1 (список 2) 3) (як-є ()))
