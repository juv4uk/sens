; Сума четвертих степенів через замкнений закон Фаульгабера.
; S = [н(н+1)(2н+1)/6] * [3н²+3н−1] /5.
; Проміжна частка на 6 є цілою для кожного цілого н,
; запобігає підвищенню бітності чисельника понад D24 для н=20.
; Той самий точний результат S(10)=25333, незалежні змінні свідки.
(визначити ч
 (функція (н)
  (частка
   (помножити
    (частка
     (помножити
      (помножити н (додати н 1))
      (додати (помножити 2 н) 1))
     6)
    (відняти
     (додати
      (помножити 3 (помножити н н))
      (помножити 3 н))
     1))
   5)))
(ч 10)
