; Незалежна рекурсія кількість(н,3)=кількість(н-1,3)+кількість(н-1,2).
; Нульовий результат на н менше 3, арифметика тільки через СЕНС Д24+.
(визначити т
  (функція (н)
    (за-умовою
      ((менше? н 3) 0)
      (так (додати (т (відняти н 1))
                   (частка (помножити (відняти н 1) (відняти н 2)) 2))))))
(т 10)
