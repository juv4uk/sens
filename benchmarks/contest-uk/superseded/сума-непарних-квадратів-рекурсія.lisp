; Незалежна рекурсія суми квадратів перших н непарних чисел.
; С(0)=0, С(н)=С(н-1)+(2н-1)*(2н-1).
(визначити с
  (функція (н)
    (за-умовою
      ((тотожне? н 0) 0)
      (так
        (додати
          (с (відняти н 1))
          (помножити
            (відняти (помножити 2 н) 1)
            (відняти (помножити 2 н) 1)))))))
(с 10)
