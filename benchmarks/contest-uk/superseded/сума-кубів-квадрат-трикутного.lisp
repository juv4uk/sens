; Конкурс СЕНС: сума перших н кубів як квадрат трикутного числа.
; Закон: 1³ + ... + н³ = (1 + ... + н)²; жодної втрати точності.
; Відмінний від формульних кандидатів: взагалі не використовує ЧАСТКА,
; тому немає примусового змішування доменів D24/D48 на межі ділення.
; Один Д24+ добуток після хвостового обчислення трикутного числа.
; Власні Д5-функції СЕНС, ніякого SID8, анонімної голови, Python чи JSON.
(визначити трикутне-накопичити
  (функція (н сума)
    (за-умовою
      ((нуль? н) сума)
      (так
        (трикутне-накопичити
          (відняти-1 н)
          (додати сума н))))))
(визначити кв
  (функція (т)
    (помножити т т)))
(визначити к
  (функція (н)
    (кв (трикутне-накопичити н 0))))
(к 10)
