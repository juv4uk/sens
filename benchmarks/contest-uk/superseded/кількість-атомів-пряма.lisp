; Конкурс: кількість атомарних елементів зовнішнього списку.
; Вкладена пара рахується як один складений елемент і не додає одиницю.
; Хвостова рекурсія Д3-Д5; числа - математичні Д24+.
(визначити лічити-атоми
 (функція (залишок лічильник)
  (за-умовою
   ((порожній? залишок) лічильник)
   ((атом? залишок) лічильник)
   ((атом? (перше залишок))
    (лічити-атоми (решта залишок) (додати лічильник 1)))
   (так (лічити-атоми (решта залишок) лічильник)))))
(лічити-атоми (список 1 (список 2 3) 4) 0)
