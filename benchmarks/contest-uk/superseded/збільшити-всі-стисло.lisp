; Конкурс: один хвостовий обхід списку, Д3-Д5 та Д24.
; Окремий стислий учасник того самого закону: значення + 1,
; відповідь у зворотному порядку перед початковим акумулятором.
; Результат доводить незалежний нативний СЕНС і Зіг. на шести входах.
(визначити р
  (функція (с а)
    (за-умовою
      ((атом? с) а)
      (так (р (решта с) (сполучити (додати (перше с) 1) а))))))
(р (список 1 2 3) (як-є ()))
