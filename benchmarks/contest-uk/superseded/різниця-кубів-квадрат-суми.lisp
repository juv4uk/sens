; Конкурс українського СЕНС: а* - б* = (а - б) ((а + б)* - аб).
; Три множення замість чотирьох у розкладі через а* + аб + б*.
; Відсутні зовнішні обчислювачі, джейсон та підстановка очікуваної константи.
(визначити р
  (функція (а б)
    (помножити
      (відняти а б)
      (відняти
        (помножити (додати а б) (додати а б))
        (помножити а б)))))
(р 7 4)
