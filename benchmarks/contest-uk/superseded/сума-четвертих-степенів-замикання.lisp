; Конкурс СЕНС: S(н) = сума к^4, 1 <= к <= н.
; Попередня анонімна функція у викличній голові не є допущеним
; першокласним синтаксисом поточного фізичного reader.
; Нативна хвостова композиція без D48/D24 ділення:
; для конкурсних н <= 30 і сума, і кожен к^4 точно вміщаються в D24.
; Той самий закон виконується SENS, Zig перевозить лише T5M.
(визначити ч-накопичити
  (функція (н підсумок)
    (за-умовою
      ((нуль? н) підсумок)
      (так
        (ч-накопичити
          (відняти-1 н)
          (додати підсумок
            (помножити (помножити н н) (помножити н н))))))))
(визначити ч
  (функція (н)
    (ч-накопичити н 0)))
(ч 10)
