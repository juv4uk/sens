; Конкурс: сума перших н парних чисел 2 + 4 + ... + 2н.
; Хвостова рекурсія з явним акумулятором; нативний суд перевіряє різні входи.
(визначити сума-парних
  (функція (н сума)
    (за-умовою
      ((тотожне? н 0) сума)
      ((атом? (як-є ())) (сума-парних (відняти н 1) (додати сума (додати н н)))))))
(сума-парних 100 0)
