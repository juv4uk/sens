; Конкурс СЕНС: фільтр атомів за один прохід.
; Один параметр і лише дві семантичні гілки понад термінальну.
; O(n) викликів і O(k) CONS для k атомів; без обернення акумулятора.
; Точні Д3/Д4 коди, українська проєкція; без SID8 чи Python-обчислення.
(визначити л
  (функція (с)
    (за-умовою
      ((атом? с) (як-є ()))
      ((порожній? (перше с)) (л (решта с)))
      ((атом? (перше с))
        (сполучити (перше с) (л (решта с))))
      (так (л (решта с))))))
(л (список 1 (список 2) 3))
