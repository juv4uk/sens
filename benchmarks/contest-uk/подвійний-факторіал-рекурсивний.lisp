; Подвійний факторіал н!! = н*(н-2)*... для невід'ємних цілих Д24+.
; Два незалежні базові випадки 0!!=1 і 1!!=1; жодного хостового оракула.
; Порівняння оптимізацій: Зіг і Т5М байти, структура, реальні СЕНС відвідувань.
(визначити п
  (функція (н)
    (за-умовою
      ((менше? н (довжина (як-є (а б)))) (довжина (як-є (а))))
      (так (помножити н (п (відняти н (довжина (як-є (а б))))))))))
(п (довжина (як-є (а б в г ґ д е є ж))))
