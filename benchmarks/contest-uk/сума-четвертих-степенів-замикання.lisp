; Конкурс: сума четвертих степенів, спільний результат т = н(н+1).
; Компактний кандидат Д24+ без дубльованого обчислення т.
(визначити ч
 (функція (н)
  ((функція (т)
     (частка
      (помножити
       (помножити т (додати н (додати-1 н)))
       (відняти-1 (помножити 3 т)))
      30))
   (помножити н (додати-1 н)))))
(ч 10)
