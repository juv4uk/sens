; Той самий Евклід за відніманням: компактна Д7-назва локальної функції.
; Входи лише невід'ємні точні цілі Д24+, без недопущеної Д6 ОСТАЧА.
; Базу Евкліда перевіряє математичний Д5/Д6 нуль?, не атомна Д3 ТОТОЖНЕ?.
; Порівняти реальні байти Зіг і Т5М, структура та СЕНС відвідувань з довгим іменем.
(визначити е
  (функція (а б)
    (за-умовою
      ((нуль? б) а)
      ((менше? а б) (е б а))
      (так (е (відняти а б) б)))))
(е
  (помножити
    (довжина (як-є (а б в г ґ д е є ж з и і ї й)))
    (довжина (як-є (а б в г ґ д е є ж з и і ї й к л м н))))
  (помножити
    (довжина (як-є (а б в г ґ д е)))
    (довжина (як-є (а б в г ґ д е є ж з и і ї й о)))))
