; Конкурс: структурна тотожність двох дерев, лише Д3.
; Змінні входи; T5M-оберненість доводить нативний суд.
(визначити д
  (функція (л п)
    (за-умовою
      ((атом? л) (тотожне? л п))
      ((атом? п) ні)
      ((д (перше л) (перше п)) (д (решта л) (решта п)))
      (так ні))))
(д (як-є (радіо (антена) сигнал)) (як-є (радіо (антена) сигнал)))
