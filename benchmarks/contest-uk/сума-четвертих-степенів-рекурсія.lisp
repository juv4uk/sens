; Незалежна SENS-рекурсія четвертих степенів: S(0)=0.
; S(н)=S(н−1)+н^4. Один проміжний квадрат на крок;
; без зовнішнього Python/JSON і без хостової оцінки істинності.
(визначити ч
 (функція (н)
  (за-умовою
   ((тотожне? н 0) 0)
   (так
    (додати
     (ч (відняти н 1))
     ((функція (к) (помножити к к))
      (помножити н н)))))))
(ч 10)
