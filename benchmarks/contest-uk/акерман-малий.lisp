; Конкурс: точний Акерман A(3,н) для невід'ємного цілого.
; A(3,0)=5; A(3,н)=2*A(3,н-1)+3. Отже A(3,3)=61.
; Д24+ числа є людськими десятковими значеннями, не кодами функцій.

(визначити ак3
  (функція (н)
    (за-умовою
      ((тотожне? н 0) 5)
      (так (додати (помножити 2 (ак3 (відняти-1 н))) 3)))))

(ак3 3)
