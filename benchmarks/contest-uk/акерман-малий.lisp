; Конкурс: точний Акерман А(3,н) для невід'ємного цілого.
; А(3,0)=5; А(3,н)=2*А(3,н-1)+3. Отже А(3,3)=61.
; Д24+ числа є людськими десятковими значеннями, не кодами функцій.

(визначити ак3
  (функція (н)
    (за-умовою
      ((нуль? н) (довжина (як-є (а б в г ґ))))
      (так (додати (помножити (довжина (як-є (а б))) (ак3 (відняти-1 н))) (довжина (як-є (а б в))))))))

(ак3 (довжина (як-є (а б в))))
