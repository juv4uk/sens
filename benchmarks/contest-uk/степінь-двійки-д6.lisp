; Конкурс СЕНС: 2^н за O(log н) замість н рекурсивних множень.
; Точне цілочисельне Д24+: Д5 ЧАСТКА є точною раціональною: перед діленням прибираємо остачу. PARNE? є
; функцією Д6:010000, визначеною мовою у Core4.
; Половинний степінь обчислюється РІВНО ОДИН раз у СЕНС;
; анонімне замикання лишається першокласним значенням, не Python/JSON.
; Вхід невід'ємний, конкурс судить реальні змінні аргументи.
(визначити с
  (функція (н)
    (за-умовою
      ((нуль? н) 1)
      (так
        ((функція (півстепінь)
           (за-умовою
             ((парне? н) (помножити півстепінь півстепінь))
             (так (помножити 2 (помножити півстепінь півстепінь)))))
         (с (частка (відняти н (модульна-остача н 2)) 2)))))))
(с 10)
