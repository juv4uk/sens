; Конкурс: факторіал через чинний Д6 "відняти-1".
; Єдина рекурсія; без старих сід8 і сенс8, машинних літералів і зовнішні-обчислень.
; Той самий закон Д24+, що й у факторіал-нуль, менше вузлів джерела.
(визначити ф
 (функція (н)
  (за-умовою
   ((нуль? н) (довжина (як-є (а))))
   (так (помножити н (ф (відняти-1 н)))))))
(ф (довжина (як-є (а б в г ґ д е є ж з))))
