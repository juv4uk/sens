; Сума четвертих степенів 1..н у точній числовій D24+ арифметиці.
; Т = н(н+1), U = Т(2н+1)/6 (точне ціле).
; S = U(3Т−1)/5. Ділимо ДО великого множення: для н=20
; попереднє обчислення чисельника /30 переходило у більший Dn
; та викликало справжній Type RED у native SENS --t5m-pair.
(визначити ч
 (функція (н)
  ((функція (т)
    (частка
     (помножити
      (частка
       (помножити т (додати (помножити 2 н) 1))
       6)
      (відняти (помножити 3 т) 1))
     5))
   (помножити н (додати н 1)))))
(ч 10)
