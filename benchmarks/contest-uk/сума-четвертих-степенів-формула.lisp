; Сума четвертих степенів: точний D24 закон S4 = S2*(3н²+3н-1)/5.
; Замість проміжного н(н+1)(2н+1)(3н²+3н-1), який на н=20
; міняв розрядність до ділення і ламав same-Dn, спершу обчислити
; цілу суму квадратів S2=н(н+1)(2н+1)/6.
; Обидва етапи ділення виконуються самим SENS; свідки не послаблюємо.
(визначити ч
 (функція (н)
  (частка
   (помножити
    (частка
     (помножити
      (помножити н (додати н 1))
      (додати (помножити 2 н) 1))
     6)
    (відняти
     (додати (помножити 3 (помножити н н)) (помножити 3 н))
     1))
   5)))
(ч 10)
