; СЕНС: сума четвертих степенів 1^4 + ... + н^4.
; Один точний вираз D24+, без обходу колекцій:
; S(н)=н(н+1)(2н+1)(3н²+3н−1)/30.
; Конкурс судить не текстову формулу, а реальне SENS/Zig T5M виконання.
(визначити ч
 (функція (н)
  (частка
   (помножити
    (помножити н (додати н 1))
    (помножити
     (додати (помножити 2 н) 1)
     (відняти
      (додати (помножити 3 (помножити н н)) (помножити 3 н))
      1)))
   30)))
(ч 10)
