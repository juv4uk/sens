; Конкурс: максимум списку атомів.

(визначити максимум
  (функція (залишок най)
    (за-умовою
      ((атом? залишок) най)
      ((тотожне? (менше? най (перше залишок)) так)
       (максимум (решта залишок) (перше залишок)))
      (так (максимум (решта залишок) най)))))

(максимум (список 3 1 4 1 5) 0)
