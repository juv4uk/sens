; Конкурс: усі елементи — непорожні атоми (першокласний предикат).
(визначити у
  (функція (п с)
    (за-умовою
      ((атом? с) так)
      ((п (перше с)) (у п (решта с)))
      (так ні))))
(визначити а?
  (функція (значення)
    (за-умовою
      ((атом? значення)
       (за-умовою ((тотожне? значення (як-є ())) ні) (так так)))
      (так ні))))
(у а? (як-є (радіо антена сигнал)))
