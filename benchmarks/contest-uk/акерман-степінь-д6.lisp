; Конкурс СЕНС: А(3,н) = 2^(н+3)-3 для невід'ємного н.
; Раніше прямий виклик Д6:010111 не мав механізму й зупиняв нативний суд.
; Мовна рекурсія обчислює той самий закон: А(3,0)=5, А(3,н+1)=2А(3,н)+3.
; Тут тільки викличні українські голови, точні числа Д24+ й Д6 відняти-1.
(визначити а-накопичити
  (функція (н накопичене)
    (за-умовою
      ((нуль? н) накопичене)
      (так (а-накопичити (відняти-1 н)
             (додати (помножити 2 накопичене) 3))))))
(визначити а
  (функція (н)
    (а-накопичити н 5)))
(а 3)
