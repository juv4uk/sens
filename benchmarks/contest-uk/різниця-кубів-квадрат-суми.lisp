; Конкурс українського SENS: а³ − б³ = (а − б) ((а + б)² − аб).
; Три множення замість чотирьох у розкладі через а² + аб + б².
; Відсутні зовнішні обчислювачі, JSON та підстановка очікуваної константи.
(визначити р
  (функція (а б)
    (помножити
      (відняти а б)
      (відняти
        (помножити (додати а б) (додати а б))
        (помножити а б)))))
(р 7 4)
