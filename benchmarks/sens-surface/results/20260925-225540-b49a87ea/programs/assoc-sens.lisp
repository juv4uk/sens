(визначити mkal (функція (n acc)
  (за-умовою ((тотожне? n 0) acc)
        (t (mkal (відняти n 1) (сполучити (сполучити n (додати n n)) acc))))))
(визначити look (функція (k al)
  (за-умовою ((атом? al) 0)
        ((тотожне? k (перше (перше al))) (решта (перше al)))
        (t (look k (решта al))))))
(визначити sumall (функція (k al acc)
  (за-умовою ((тотожне? k 0) acc)
        (t (sumall (відняти k 1) al (додати acc (look k al)))))))
(print (sumall 400 (mkal 400 (як-є ())) 0))
