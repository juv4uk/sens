(def mk (lambda (d)
  (cond ((eq d 0) (quote leaf))
        (t (cons (mk (- d 1)) (mk (- d 1)))))))
(def len (lambda (xs n)
  (cond ((atom xs) n)
        (t (len (cdr xs) (+ n 1))))))
(def flat (lambda (x acc)
  (cond ((atom x) (cons x acc))
        (t (flat (car x) (flat (cdr x) acc))))))
(print (len (flat (mk 15) (quote ())) 0))
