(def build (lambda (n acc)
  (cond ((eq n 0) acc)
        (t (build (- n 1) (cons n acc))))))
(def mem (lambda (x xs)
  (cond ((atom xs) 0)
        ((eq x (car xs)) 1)
        (t (mem x (cdr xs))))))
(def xs (build 100 (quote ())))
(def work (lambda (r hits)
  (cond ((eq r 0) hits)
        (t (work (- r 1) (+ hits (mem 100 xs)))))))
(print (work 50 0))
