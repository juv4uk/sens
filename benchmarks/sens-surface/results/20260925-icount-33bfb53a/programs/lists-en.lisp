(def build (lambda (n acc)
  (cond ((eq n 0) acc)
        (t (build (- n 1) (cons n acc))))))
(def len (lambda (xs n)
  (cond ((atom xs) n)
        (t (len (cdr xs) (+ n 1))))))
(def rev (lambda (xs acc)
  (cond ((atom xs) acc)
        (t (rev (cdr xs) (cons (car xs) acc))))))
(def work (lambda (r total)
  (cond ((eq r 0) total)
        (t (work (- r 1) (+ total (len (rev (build 200 (quote ())) (quote ())) 0)))))))
(print (work 10 0))
