(визначити build (функція (n acc)
  (за-умовою ((тотожне? n 0) acc)
        (t (build (відняти n 1) (сполучити n acc))))))
(визначити mem (функція (x xs)
  (за-умовою ((атом? xs) 0)
        ((тотожне? x (перше xs)) 1)
        (t (mem x (решта xs))))))
(визначити xs (build 100 (як-є ())))
(визначити work (функція (r hits)
  (за-умовою ((тотожне? r 0) hits)
        (t (work (відняти r 1) (додати hits (mem 100 xs)))))))
(print (work 5000 0))
