(def my-eq (lambda (a b) (eq a b)))
(def my-atom (lambda (a) (atom a)))
(def my-cons (lambda (a b) (cons a b)))
(def my-car (lambda (a) (car a)))
(def my-cdr (lambda (a) (cdr a)))
(def my-add (lambda (a b) (+ a b)))
(def my-sub (lambda (a b) (- a b)))
(def build (lambda (n acc)
  (cond ((my-eq n 0) acc)
        (t (build (my-sub n 1) (my-cons n acc))))))
(def rev (lambda (xs acc)
  (cond ((my-atom xs) acc)
        (t (rev (my-cdr xs) (my-cons (my-car xs) acc))))))
(def len (lambda (xs n)
  (cond ((my-atom xs) n)
        (t (len (my-cdr xs) (my-add n 1))))))
(def work (lambda (r total)
  (cond ((my-eq r 0) total)
        (t (work (my-sub r 1) (my-add total (len (rev (build 1000 (quote ())) (quote ())) 0)))))))
(print (work 120 0))
