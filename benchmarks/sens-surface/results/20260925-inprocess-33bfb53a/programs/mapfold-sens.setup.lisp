(визначити build (функція (n acc)
  (за-умовою ((тотожне? n 0) acc)
        (t (build (відняти n 1) (сполучити n acc))))))
(визначити mymap (функція (f xs)
  (за-умовою ((атом? xs) xs)
        (t (сполучити (f (перше xs)) (mymap f (решта xs)))))))
(визначити myfold (функція (f acc xs)
  (за-умовою ((атом? xs) acc)
        (t (myfold f (f acc (перше xs)) (решта xs))))))
(визначити work (функція (r total)
  (за-умовою ((тотожне? r 0) total)
        (t (work (відняти r 1)
                 (додати total (myfold (функція (a b) (додати a b)) 0
                                   (mymap (функція (x) (додати x x)) (build 1000 (як-є ()))))))))))
