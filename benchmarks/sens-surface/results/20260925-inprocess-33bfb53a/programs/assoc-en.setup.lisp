(def mkal (lambda (n acc)
  (cond ((eq n 0) acc)
        (t (mkal (- n 1) (cons (cons n (+ n n)) acc))))))
(def look (lambda (k al)
  (cond ((atom al) 0)
        ((eq k (car (car al))) (cdr (car al)))
        (t (look k (cdr al))))))
(def sumall (lambda (k al acc)
  (cond ((eq k 0) acc)
        (t (sumall (- k 1) al (+ acc (look k al)))))))
