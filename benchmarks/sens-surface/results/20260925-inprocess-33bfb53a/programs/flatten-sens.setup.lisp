(визначити mk (функція (d)
  (за-умовою ((тотожне? d 0) (як-є leaf))
        (t (сполучити (mk (відняти d 1)) (mk (відняти d 1)))))))
(визначити len (функція (xs n)
  (за-умовою ((атом? xs) n)
        (t (len (решта xs) (додати n 1))))))
(визначити flat (функція (x acc)
  (за-умовою ((атом? x) (сполучити x acc))
        (t (flat (перше x) (flat (решта x) acc))))))
