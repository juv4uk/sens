(визначити build (функція (n acc)
  (за-умовою ((тотожне? n 0) acc)
        (t (build (відняти n 1) (сполучити n acc))))))
(визначити rev (функція (xs acc)
  (за-умовою ((атом? xs) acc)
        (t (rev (решта xs) (сполучити (перше xs) acc))))))
(визначити len (функція (xs n)
  (за-умовою ((атом? xs) n)
        (t (len (решта xs) (додати n 1))))))
(визначити work (функція (r total)
  (за-умовою ((тотожне? r 0) total)
        (t (work (відняти r 1) (додати total (len (rev (build 1000 (як-є ())) (як-є ())) 0)))))))
(print (work 120 0))
