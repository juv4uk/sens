; Випробування швидкодії читача вкладених виразів.
; Перевіряються українські символи (зокрема з апострофом) та вкладені списки.
; Текстовий літерал тут не має допущеного оборотного T5M-представлення:
; замість нього тестуємо точні українські символи як цитовані дані.
; Точний дріб обчислює ратифікована частка D5 над десятковими числами D24+,
; а не дробовий source-літерал без доведеного шляху виконання.

; Іменовані точні аргументи D24+ без числових токенів у проєкції.
(визначити читач-число-п'ять (довжина (як-є (а б в г ґ))))
(визначити читач-число-шість (довжина (як-є (а б в г ґ д))))
(визначити читач-число-сім (довжина (як-є (а б в г ґ д е))))
(визначити читач-число-вісім (довжина (як-є (а б в г ґ д е є))))

(визначити повернути-значення (функція (значення) значення))
(повернути-значення (як-є (альфа бета гама дельта епсилон)))
(повернути-значення (як-є (радіо антена сигнал потужність частота)))
(повернути-значення (як-є (один (два три) (чотири (п'ятірка шістка)))))
(повернути-значення (як-є (українська абетка ґрунт їжак)))
(повернути-значення
  (частка
    (частка
      (частка читач-число-п'ять читач-число-шість)
      читач-число-вісім)
    читач-число-сім))
