; Перевірка швидкодії точної арифметики мови.
; Викличні слова узгоджені з ратифікованими доменами.
; Десяткові числа належать людській математичній проєкції.
; У програмі немає закодованих викликів і застарілих кодів.

; Точні математичні значення D24+ утворюємо зі списків у SENS.
(визначити поліном-число-два (довжина (як-є (а б))))
(визначити поліном-число-три (довжина (як-є (а б в))))
(визначити поліном-число-сім (довжина (як-є (а б в г ґ д е))))
(визначити поліном-число-десять (довжина (як-є (а б в г ґ д е є ж з))))
(визначити поліном-число-сто
  (помножити поліном-число-десять поліном-число-десять))
(визначити поліном-число-двадцять
  (помножити поліном-число-два поліном-число-десять))
(визначити поліном-число-сто-двадцять-три
  (додати
    (додати поліном-число-сто поліном-число-двадцять)
    поліном-число-три))

(визначити поліном
  (функція (значення)
    ; Чинне D5/D24+ додавання композиційно двоаргументне:
    ; не подавати три значення одному виклику.
    (додати
      (додати
        (помножити значення значення)
        (помножити поліном-число-три значення))
      поліном-число-сім)))

(поліном поліном-число-сто-двадцять-три)
