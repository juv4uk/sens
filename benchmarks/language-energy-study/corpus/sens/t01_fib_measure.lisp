; T01 — наївна рекурсія Фібоначчі мовою SENS, MEASURE_SIZE=24.
; Числовий аргумент і всі пороги будуються з однієї SENS-константи
; число-один через допущене Dn-додавання, без десяткового літерала.
; Це усуває змішування числових доменів у першій спробі main@821df8da.
; Не використовуємо довжина: GitHub Actions 40719408352 довів RED
; "domain identity is not callable under its ratified law: D6 000000".
; Контракт мови не змінено. Стан — перевіряється фізичним паритетом.
; Це тест MEASURE_SIZE=24, а не MEASURE_SIZE=24.

(визначити фіб-один число-один)
(визначити фіб-два (додати фіб-один фіб-один))
(визначити фіб-чотири (додати фіб-два фіб-два))
(визначити фіб-вісім (додати фіб-чотири фіб-чотири))
(визначити фіб-дванадцять (додати фіб-вісім фіб-чотири))
(визначити фіб-двадцять-чотири (додати фіб-дванадцять фіб-дванадцять))

(визначити фіб
  (функція (к)
    (за-умовою
      ((менше? к фіб-два) к)
      ((атом? (як-є ()))
        (додати (фіб (відняти к фіб-один))
                (фіб (відняти к фіб-два)))))))

