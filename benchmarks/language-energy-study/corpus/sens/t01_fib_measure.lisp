; T01 MEASURE_SIZE — наївна рекурсія Фібоначчі мовою SENS, n=24 (маніфест).
; Той самий алгоритм, що VERIFY (t01_fib.lisp) і parity_check.ref_T01.
; Числа будуються з число-один через Dn-додавання, без десяткових літералів
; (див. GitHub Actions 40719408352 / main@821df8da).
; Очікуваний exact результат: 46368.
; Енергія не вимірюється цим файлом — ENERGY_NOT_MEASURED до RAPL.

(визначити фіб-один число-один)
(визначити фіб-два (додати фіб-один фіб-один))
(визначити фіб-чотири (додати фіб-два фіб-два))
(визначити фіб-вісім (додати фіб-чотири фіб-чотири))
(визначити фіб-шістнадцять (додати фіб-вісім фіб-вісім))
(визначити фіб-двадцять-чотири (додати фіб-шістнадцять фіб-вісім))

(визначити фіб
  (функція (к)
    (за-умовою
      ((менше? к фіб-два) к)
      ((атом? (як-є ()))
        (додати (фіб (відняти к фіб-один))
                (фіб (відняти к фіб-два)))))))

; T01 MEASURE: n=24, очікуваний точний результат 46368.
(фіб фіб-двадцять-чотири)
