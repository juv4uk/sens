; ENERGY-02 / T02: точні раціональні числа SENS, незалежний native witness.
; Перевірний розмір n=20; у сценарії вимірювання завершальний виклик
; замінюється лише на n=400, визначений нижче з тих самих D5-чисел.
; Арифметика виконується SENS; зовнішній інструмент тільки звіряє
; фактично надрукований результат з окремим міжмовним еталоном.
(визначити число-двадцять
  (помножити (помножити число-два число-два) число-п'ять))
(визначити число-чотириста
  (помножити число-двадцять число-двадцять))

(визначити гармонійна-сума
  (функція (к)
    (за-умовою
      ((менше? к число-один) число-нуль)
      ((атом? (як-є ()))
        (додати (обернене к)
                (гармонійна-сума (відняти к число-один)))))))

(гармонійна-сума число-двадцять)
