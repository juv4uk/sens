; T01 — наївна рекурсія Фібоначчі в SENS, паритетний VERIFY_SIZE=12.
; Чинний висновок: обидва аргументи Dn-порівняння мають бути одним числовим доменом.
; Усі числові константи утворені SENS-операцією довжина — за взірцем
; benchmarks/cross-language/sens-vs-python/sens/fib.setup.lisp.
; Жодного хостового числового оракула чи нового мовного закону.
; Цей файл НЕ є варіантом для MEASURE_SIZE=24 без окремої перевірки.
;
; ВЕРІФІКОВАНО: ні. Потрібен фізичний PARITY_OK на GitHub-hosted runner.

(визначити фіб-нуль (довжина (як-є ())))
(визначити фіб-один (довжина (як-є (а))))
(визначити фіб-два (довжина (як-є (а б))))
(визначити фіб-дванадцять (довжина (як-є (а б в г ґ д е є ж з и і))))

(визначити фіб
  (функція (к)
    (за-умовою
      ((менше? к фіб-один) фіб-нуль)
      ((менше? к фіб-два) фіб-один)
      ((атом? (як-є ()))
        (додати (фіб (відняти к фіб-один))
                (фіб (відняти к фіб-два)))))))

; T01 VERIFY_SIZE n=12 (завжди один і той самий вхід)
(фіб фіб-дванадцять)
