; Д10: нативне SENS-навантаження для T5M бенчмарку.
; Уся перевірка семантики належить SENS. Ні Python, ні JSON, ні SHA-256.
; Зовнішній вимірювач рахує лише час фізичного виконання.
; Для повторних прогонів SENS перевіряє незмінність результату.
(визначити перевірити-чергу
  (функція (черга)
    (хибне? (черга-порожня? черга))))
(визначити перевірити-три-черги
  (функція (порожня одна дві три)
    (за-умовою
      ((черга-порожня? порожня)
       (за-умовою
         ((перевірити-чергу одна)
          (за-умовою
            ((перевірити-чергу дві)
             (перевірити-чергу три))
            (так ні)))
         (так ні)))
      (так ні))))
(визначити прогін-черг
  (функція ()
    (перевірити-три-черги
      (як-є ())
      (список так)
      (список так ні)
      (список так ні так))))
; Додатковий SENS-закон: вкладений елемент не змінює непорожність черги.
(визначити перевірити-вкладену-чергу
  (функція ()
    (хибне? (черга-порожня? (список (список так ні))))))
; Самотест бенчмаркового оракула: відомі істина для порожньої
; черги й хиба для непорожньої мають бути правильними ДО вимірювання.
(визначити перевірити-контракт-черги
  (функція ()
    (за-умовою
      ((черга-порожня? (як-є ()))
       (за-умовою
         ((хибне? (черга-порожня? (список так))) так)
         (так ні)))
      (так ні))))
; SENS-закон: навіть коли єдиний елемент є порожнім списком,
; сама черга містить елемент і тому не є порожньою.
(визначити перевірити-чергу-з-порожнім-елементом
  (функція ()
    (хибне? (черга-порожня? (список (як-є ()))))))
; SENS-контроль повторів: кожен прогін повинен повернути D1:так.
(визначити перевірити-повтори
  (функція ()
    (за-умовою
      ((прогін-черг)
       (за-умовою
         ((прогін-черг)
          (прогін-черг))
         (так ні)))
      (так ні))))
; Відмова до прогону, якщо відомі відповіді черги неправильні.
(за-умовою
  ((перевірити-контракт-черги)
   (за-умовою
     ((перевірити-вкладену-чергу)
      (за-умовою
        ((перевірити-чергу-з-порожнім-елементом) (перевірити-повтори))
        (так ні)))
     (так ні)))
  (так ні))
