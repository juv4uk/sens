; SENS-навантаження для вимірювання зовнішнім T5M runner.
; Вимірювач має запускати саме SENS; цей файл не містить host-оракула.
; Повторні обчислення над чергами різної довжини повертають D1:так.
(визначити перевірити-чергу
  (функція (черга)
    (хибне? (черга-порожня? черга))))
(за-умовою
  ((черга-порожня? (як-є ()))
   (за-умовою
     ((перевірити-чергу (список так))
      (за-умовою
        ((перевірити-чергу (список так ні))
         (за-умовою
           ((перевірити-чергу (список так ні так))
            так)
           (так ні)))
        (так ні)))
     (так ні)))
  (так ні))
