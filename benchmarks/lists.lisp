; Випробування швидкодії обробки списку.
; У списку рівно десять символічних значень.
; Порожня структура D3 NIL і сторонній атом — не те саме.
; Лише порожній список дає числовий нуль D24+; пошкоджений
; хвіст не можна мовчки приймати за завершення списку.

; Іменовані точні значення D24+, отримані самою мовою зі списків.
(визначити довжина-число-нуль (довжина (як-є ())))
(визначити довжина-число-один (довжина (як-є (а))))

(визначити порахувати-елементи
  (функція (значення)
    (за-умовою
      ((порожній? значення) (додати довжина-число-нуль довжина-число-нуль))
      ((атом? значення) (як-є помилка-не-список))
      ((хибне? (атом? значення))
        (додати довжина-число-один (порахувати-елементи (решта значення)))))))

(порахувати-елементи
  (як-є (радіо антена сигнал батарея екран кодувальник динамік мікрофон кабель годинник)))
