; Випробування двійкових дерев із глибиною десять.
; Визначення використовують українські викличні назви.
; Усі математичні операнди записуються десятковими числами.
; Гілки за замовчуванням повертають справжній предикат D1, не незв'язане «так».

(визначити створити-дерево
  (функція (глибина)
    (за-умовою
      ((менше? глибина 1) (як-є ()))
      ((атом? (як-є ()))
        (сполучити
          (створити-дерево (відняти глибина 1))
          (створити-дерево (відняти глибина 1)))))))

; Числове «один» створює саме математика D24+/D5, не голий D1:1.
; Базовий результат зберігає числовий тип для рекурсивного додавання.
; Листок є канонічним D3 NIL (); довільний D7-текст «листок» — це список
; текстових комірок і не задовольняє D3 ATOM.
(визначити перевірити-дерево
  (функція (дерево)
    (за-умовою
      ((атом? дерево) (додати 0 1))
      ((атом? (як-є ()))
        (додати
          1
          (додати
            (перевірити-дерево (перше дерево))
            (перевірити-дерево (решта дерево))))))))

(визначити повторити-дерева
  (функція (глибина повторень підсумок)
    (за-умовою
      ((менше? повторень 1) підсумок)
      ((атом? (як-є ()))
        (повторити-дерева
          глибина
          (відняти повторень 1)
          (додати підсумок
            (перевірити-дерево (створити-дерево глибина))))))))
