; Результати перевірки двійкових дерев.
; Порядок перевірок відповідає початковому випробуванню.

(сполучити
  (перевірити-дерево (створити-дерево дерево-число-одинадцять))
  (сполучити
    (повторити-дерева дерево-число-чотири дерево-число-тисяча-двадцять-чотири дерево-число-нуль)
    (сполучити
      (повторити-дерева дерево-число-шість дерево-число-двісті-п'ятдесят-шість дерево-число-нуль)
      (сполучити
        (повторити-дерева дерево-число-вісім дерево-число-шістдесят-чотири дерево-число-нуль)
        (сполучити
          (повторити-дерева дерево-число-десять дерево-число-шістнадцять дерево-число-нуль)
          (сполучити
            (перевірити-дерево (створити-дерево дерево-число-десять))
            (як-є ())))))))
