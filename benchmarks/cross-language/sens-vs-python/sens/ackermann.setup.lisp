; Ackermann-Péter recurrence; the nested call is intentional.
(0011 ackermann
  (0010 (m n)
    (110
      ((101 m #d24:000000000000000000000000)
        (01010 n #d24:000000000000000000000001))
      ((101 n #d24:000000000000000000000000)
        (ackermann
          (01011 m #d24:000000000000000000000001)
          #d24:000000000000000000000001))
      (#d1:1
        (ackermann
          (01011 m #d24:000000000000000000000001)
          (ackermann m (01011 n #d24:000000000000000000000001)))))))
