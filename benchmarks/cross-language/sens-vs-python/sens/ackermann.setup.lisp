; Функція Аккермана з вкладеним рекурсивним викликом.
; Для першого нульового аргументу повертається наступне число.
; Другий базовий випадок зменшує перший аргумент.
; Решта випадків обчислюють вкладену рекурсію.
; Числові операнди надходять з іменованих точних прив'язок D24+.
; Рекурсивна одиниця належить D24+ через D5-додавання; D1 — тільки перевірка.

; Іменовані точні математичні значення D24+ без числових літералів.
(визначити аккерман-число-нуль (довжина (як-є ())))
(визначити аккерман-число-один (довжина (як-є (а))))
(визначити аккерман-число-три (довжина (як-є (а б в))))

(визначити аккерман
  (функція (перший другий)
    (за-умовою
      ((менше? перший аккерман-число-один)
        (додати другий аккерман-число-один))
      ((менше? другий аккерман-число-один)
        (аккерман
          (відняти перший аккерман-число-один)
          (додати аккерман-число-нуль аккерман-число-один)))
      ((атом? (як-є ()))
        (аккерман
          (відняти перший аккерман-число-один)
          (аккерман перший (відняти другий аккерман-число-один)))))))
