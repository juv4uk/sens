; #1422 — породження механічної проєкції допуску механізмів Core×SENS.
;
; Єдине джерело істини — розділ profile-routes у
; lib/function-table-mechanisms.lisp. Rust отримує тільки координати й вид
; маршруту. Він не визначає мовних законів, поверхонь, синтаксису ядер,
; семантики результатів чи незалежних правил допуску.
;
; Запуск із кореня репозиторію:
;   cargo run -p sens-cli -- scripts/generate-rust-profile-mechanism-routes.lisp
; Перевірка без перезапису породженого файла:
;   cargo run -p sens-cli -- scripts/generate-rust-profile-mechanism-routes.lisp --check

(визначити шлях-джерела "lib/function-table-mechanisms.lisp")
(визначити шлях-виходу "crates/sens/src/eval/profile_mechanisms_generated.rs")

(визначити рядок+
  (функція аргументи
    (згорнути (функція (накопичувач с) (рядок-додати накопичувач с)) "" аргументи)))

(визначити метадані
  (перше (читати-всі (читати-файл шлях-джерела))))

(визначити знайти-розділ
  (функція (назва розділи)
    (за-умовою
      ((атом? розділи) (як-є ()))
      ((хибне? (атом? розділи))
       (за-умовою
         ((тотожне? (перше (перше розділи)) назва)
          (перше розділи))
         ((хибне? (тотожне? (перше (перше розділи)) назва))
          (знайти-розділ назва (решта розділи))))))))

(визначити рядки-профілю
  (решта (знайти-розділ (як-є profile-routes) метадані)))

(визначити профіль-для-русту
  (функція (профіль)
    (за-умовою
      ((тотожне? профіль (як-є core3))
       "CoreProfile::Core3")
      ((атом? (як-є ())) (перше (як-є ()))))))

(визначити вид-маршруту-для-русту
  (функція (механізм)
    (за-умовою
      ((тотожне? механізм (як-є registered-host-mechanism))
       "ProfileMechanismRouteKind::RegisteredHostMechanism")
      ((атом? (як-є ())) (перше (як-є ()))))))

(визначити відрендерити-рядок
  (функція (рядок)
    (нехай-послідовно ((профіль (профіль-для-русту (перше рядок)))
           (ід (друге рядок))
           (вид (вид-маршруту-для-русту (третє рядок))))
      (за-умовою
        ((однакові? профіль (як-є ())) "")
        ((однакові? вид (як-є ())) "")
        ((атом? (як-є ()))
         (рядок+
           "    ProfileMechanismRoute { profile: "
           профіль
           ", sens: crate::sens!("
           (значення-у-текст ід)
           "), kind: "
           вид
           " },\n"))))))

(визначити відрендерити-рядки
  (функція (рядки)
    (за-умовою
      ((атом? рядки) "")
      ((хибне? (атом? рядки))
       (рядок+ (відрендерити-рядок (перше рядки))
             (відрендерити-рядки (решта рядки)))))))

(визначити заголовок
  (рядок+
    "// GENERATED — DO NOT EDIT BY HAND.\n"
    "// Authority: lib/function-table-mechanisms.lisp (profile-routes)\n"
    "// Generator: scripts/generate-rust-profile-mechanism-routes.lisp\n\n"
    "use crate::{CoreProfile, CoreDomainIdentity};\n\n"
    "#[derive(Clone, Copy, Debug, Eq, PartialEq)]\n"
    "#[allow(dead_code)]\n"
    "pub(crate) enum ProfileMechanismRouteKind {\n"
    "    RegisteredHostMechanism,\n"
    "}\n\n"
    "#[derive(Clone, Copy, Debug, Eq, PartialEq)]\n"
    "struct ProfileMechanismRoute {\n"
    "    profile: CoreProfile,\n"
    "    sens: CoreDomainIdentity,\n"
    "    kind: ProfileMechanismRouteKind,\n"
    "}\n\n"
    "const PROFILE_MECHANISM_ROUTES: &[ProfileMechanismRoute] = &[\n"))

(визначити підвал
  (рядок+
    "];\n\n"
    "pub(crate) fn profile_mechanism_route(\n"
    "    profile: CoreProfile,\n"
    "    sens: CoreDomainIdentity,\n"
    ") -> Option<ProfileMechanismRouteKind> {\n"
    "    PROFILE_MECHANISM_ROUTES\n"
    "        .iter()\n"
    "        .find(|row| row.profile == profile && row.sens == sens)\n"
    "        .map(|row| row.kind)\n"
    "}\n"))

(визначити згенероване
  (рядок+ заголовок (відрендерити-рядки рядки-профілю) підвал))

; Актуальна умовна форма СЕНС: кожна гілка має умову й одне тіло.
; Параметр --check залишається незмінним зовнішнім інтерфейсом.
; Звичайний режим записує похідний файл; перевірка нічого не змінює.
(за-умовою
  ((атом? *argv*)
   (друге (список
     (записати-файл шлях-виходу згенероване)
     (друкувати "Проєкцію механізмів профілю Rust записано"))))
  ((однакові? (перше *argv*) "--check")
   (нехай ((поточне (читати-файл шлях-виходу)))
     (за-умовою
       ((однакові? поточне згенероване)
        (друкувати "Проєкція механізмів профілю Rust актуальна"))
       ((атом? (як-є ()))
        (друге (список
          (друкувати "Проєкція механізмів профілю Rust застаріла")
          (перше (як-є ()))))))))
  ((атом? (як-є ()))
   (друге (список
     (записати-файл шлях-виходу згенероване)
     (друкувати "Проєкцію механізмів профілю Rust записано")))))
