; #333 — вимірювання етапів читання файлу та перетворення Юнікоду мовою SENS.
; Жодних скорочень семантики: послідовно вимірюємо наявні механізми,
; щоб установити реальну вартість кожної ланки перед оптимізацією.
;
; Спостережуваний шлях:
;   читання байтів → перевірка UTF-8 → декодування й обертання списку
;   → перетворення скалярів Юнікоду на рядок → синтаксичне читання.
; Назви полів eco-lisp-script-perf/* у виводі — протокольні дані.

(визначити шлях-для-вимірювання "lib/surface/semantic-registry.lisp")

(визначити початок-вимірювання (монотонний-наносекунди))
(визначити прочитані-байти (read-file-bytes шлях-для-вимірювання))
(визначити після-читання-байтів (монотонний-наносекунди))

; Декодер UTF-8 спочатку перевіряє весь вхід. Цей прохід вимірюємо окремо.
(визначити байти-правильні?
  (усі-елементи-є-байтами-кодування-юнікод-8? прочитані-байти))
(визначити після-перевірки-байтів (монотонний-наносекунди))

; Реєстр зберігається у правильному UTF-8. Виклик внутрішнього декодера
; після перевірки не підраховує її двічі. Вимір включає нагромадження
; скалярів та завершальне обертання списку.
(визначити декодовані-байти (кодування-юнікод-8-декодувати-до прочитані-байти (як-є ())))
(визначити після-декодування (монотонний-наносекунди))
(визначити скаляри-юнікоду (друге декодовані-байти))

; Зі списку скалярів створюємо один текстовий рядок.
(визначити декодований-текст (юнікод-скаляри-рядок скаляри-юнікоду))
(визначити після-створення-рядка (монотонний-наносекунди))

; Синтаксичне читання вимірюємо окремо від текстового декодування.
(визначити корінь-реєстру (перше (читати-всі декодований-текст)))
(визначити після-синтаксичного-читання (монотонний-наносекунди))

(друкувати
  (список
    (як-є eco-lisp-script-perf/read-file-stages)
    (список (як-є read-file-bytes-ns)
          (відняти після-читання-байтів початок-вимірювання))
    (список (як-є validation-ns)
          (відняти після-перевірки-байтів після-читання-байтів))
    (список (як-є decode-plus-reverse-ns)
          (відняти після-декодування після-перевірки-байтів))
    (список (як-є string-assembly-ns)
          (відняти після-створення-рядка після-декодування))
    (список (як-є read-all-ns)
          (відняти після-синтаксичного-читання після-створення-рядка))
    (список (як-є total-ns)
          (відняти після-синтаксичного-читання початок-вимірювання))
    (список (як-є validation-result) байти-правильні?)
    (список (як-є decode-tag) (перше декодовані-байти))
    (список (як-є root) корінь-реєстру)))

; Перехідні прив'язки наявних механізмів; не нові доменні ідентичності.
(визначити монотонний-наносекунди mono-ns)
(визначити читати-всі read-all)
(визначити юнікод-скаляри-рядок unicode-scalars->string)
(визначити усі-елементи-є-байтами-кодування-юнікод-8? utf8-all-bytes?)
