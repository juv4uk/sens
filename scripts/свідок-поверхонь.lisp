; Свідок контракту поверхонь рушія (WebSurface).
;
; Першопричина: JS-перевірка помилок порівнювала поверхню лише з "ук", але
; рушій віддає для повної української код "укр" (UkrainianFull). Гілка була
; МЕРТВОЮ: українські помилки завжди отримували англійський префікс.
; Контракт нижче фіксує код КОЖНОЇ поверхні та множину українських кодів,
; щоб перевірка не могла знову звузитися до одного рядка.
;
; Чистий контракт: без I/O, без стану. Коди взяті з crates/sens-wasm/src/lib.rs
; (code(): core|en|ук|укр|sa; дефолт — UkrainianFull).

(визначити коди-поверхонь
  (як-є (
    (як-є (ядро "core"))
    (як-є (англійська "en"))
    (як-є (українська "ук"))
    (як-є (українська-повна "укр"))
    (як-є (санскрит "sa"))
  )))

(визначити українські-коди
  (як-є ("ук" "укр")))

(визначити українська-поверхня?
  (функція (код)
    (належить? код українські-коди)))

(визначити належить?
  (функція (елемент множина)
    (за-умовою
      ((порожній? множина) ні)
      ((тотожне? елемент (перший множина)) так)
      (так (належить? елемент (решта множина))))))

(визначити порожній?
  (функція (множина)
    (тотожне? множина (як-є ()))))

(визначити перший
  (функція (множина)
    (голова множини)))

(визначити решта
  (функція (множина)
    (хвіст множини)))

; Незалежний контроль на всіх п'яти кодах.
(українська-поверхня? "ук")
(українська-поверхня? "укр")
(українська-поверхня? "en")
