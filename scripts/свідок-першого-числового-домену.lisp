; Свідок закону першого числового домену (D12-first).
;
; Першопричина: tests/test_stage_two_projections.py перелічував ширину 12
; серед ВІДХИЛЕНИХ, тоді як contracts/numeric-domains-ratification.lisp
; (owner-ratified 2026-10-24, schema numeric-d12-start-extension-1) робить
; D12 ПЕРШИМ числовим доменом: D(12 * 2^n), n >= 0. Той самий закон уже
; виконував _current_word_pattern (scripts/stage-two-projections.py:38), який
; вимагає початок [12, 24, 48, 96, 192]. Тобто код був правий, а тест пінив
; застарілий D24-first закон — і тому був ЧЕРВОНИЙ на main.
;
; Інваріант:
;   перший числовий домен = 12; наступна ширина = подвоєння; кожна ширина
;   кратна 12 і є 12 * степінь-двійки. D11 НЕ числовий домен (це каталог).
;
; Чистий контракт: без I/O, без стану.

(визначити перший-числовий-домен 12)

(визначити ратифіковані-ширини
  (як-є (12 24 48 96 192)))

(визначити починається-з-d12?
  (функція (ширини)
    (тотожне? (перший ширини) перший-числовий-домен)))

(визначити подвоюється?
  (функція (ширини)
    (за-умовою
      ((порожній? (решта ширини)) так)
      ((тотожне? (друга ширини) (подвоєне (перший ширини)))
       (подвоюється? (решта ширини)))
      (так ні))))

(визначити d11-числовий?
  (функція (ширина)
    (тотожне? ширина 11)))

(визначити друга
  (функція (м) (голова (хвіст м))))

(визначити подвоєне
  (функція (n) (помножити n 2)))

(визначити перший
  (функція (м) (голова м)))

(визначити решта
  (функція (м) (хвіст м)))

(визначити порожній?
  (функція (м) (тотожне? м (як-є ()))))

; Незалежний контроль: ратифікований початок проходить, старий D24-first — ні,
; і D11 не є числовим доменом.
(починається-з-d12? ратифіковані-ширини)
(починається-з-d12? (як-є (24 48 96 192)))
(d11-числовий? 11)
