; #604 — структурна перевірка покриття машинного кодера, яким керує СЕНС.
; Перевіряє згенеровані вхідні дані, свідок міграції попередньої підмножини
; та кожен зафіксований рядок покриття без формування повного рядка звіту.
; Кількості обчислюються наскрізно через BinaryNumber; перевірка не повинна
; відновлювати неявне перетворення між Number і BinaryNumber.

(завантажити-файл "lib/core.lisp")
(завантажити-файл "lib/machine/encoding/coverage-generator.lisp")

(визначити форма-покриття-кодувальника
  (перше
    (читати-всі
      (читати-файл
        "lib/machine/encoding/coverage.lisp"))))

(за-умовою
  ((покриття-кодувальника-індекс-коректний?)
   (за-умовою
     ((покриття-кодувальника-проєкція-коректна?
        форма-покриття-кодувальника)
      (як-є
        (encoder-coverage-check
          (status pass))))
     (так
      (як-є (encoder-coverage-check (status fail) (reason projection-mismatch))))))
  (так
   (список
     (як-є encoder-coverage-check)
     (як-є (status fail))
     (як-є (reason invalid-coverage-input-projection))
     (сполучити (як-є checks) (покриття-кодувальника-перевірки-індексу)))))
