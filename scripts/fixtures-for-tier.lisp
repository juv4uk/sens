; Вибір прикладів визначеного рівня з tests/fixtures/conformance.lisp.
; Корпус лишається одним файлом, а цей скрипт друкує тільки записи
; потрібного рівня, зберігаючи їхній порядок і вміст.
;
; Запуск:
;   cargo run -p sens-cli --bin sens -- scripts/fixtures-for-tier.lisp 1
; У *argv* рівень передається текстом. Поле tier у прикладі є
; частиною незмінної схеми даних, а не виконуваною функцією.

; Три рівні конституційного корпусу задані самим контрактом.
; Поточний SENS CLI ще не зв'язує загальний «прочитати» для argv:
; зіставляємо тільки припустимі значення, не вигадуючи host-парсер.
; Рівні — іменовані точні числові значення, виведені самою мовою.
(визначити конституційний-рівень-один (довжина (як-є (а))))
(визначити конституційний-рівень-два (довжина (як-є (а б))))
(визначити конституційний-рівень-три (довжина (як-є (а б в))))

(визначити потрібний-рівень
  (за-умовою
    ((атом? *argv*) (бракує-аргументу-рівня))
    ((тотожне? (перше *argv*) "1") конституційний-рівень-один)
    ((тотожне? (перше *argv*) "2") конституційний-рівень-два)
    ((тотожне? (перше *argv*) "3") конституційний-рівень-три)
    ((атом? (як-є ())) (невідомий-рівень-конституції))))

; бракує-аргументу-рівня навмисно не визначене: відсутній
; аргумент породжує штатну помилку невідомого символу.
; Викличні голови «атом?», «як-є» та «перше» перенесено за ратифікованими
; координатами Д3: 010, 001 та 100, без зміни структури умови.

; Поле tier — крапкова пара (tier . 1). D3 «решта» повертає
; значення, а не одноелементний список; «друге» тут не застосовувати.
(визначити рівень-прикладу
  (функція (приклад)
    (за-умовою
      ; Не брати решта від відсутнього поля або атомарного запису.
      ((атом? приклад) (як-є ()))
      ((атом? (знайти-за-ключем (як-є tier) приклад)) (як-є ()))
      ((атом? (як-є ()))
        (решта (знайти-за-ключем (як-є tier) приклад))))))

; Відбір числового tier за законом D24+ через Д5: менше?/більше?.
; EQ(D3) для атомів та EQUAL для списків не доводять математичної рівності.
(визначити відібрати-приклади-за-рівнем
  (функція (залишок рівень)
    (за-умовою
      ((атом? залишок) (як-є ()))
      ((атом? (перше залишок))
       (відібрати-приклади-за-рівнем (решта залишок) рівень))
      ((атом? (знайти-за-ключем (як-є tier) (перше залишок)))
       (відібрати-приклади-за-рівнем (решта залишок) рівень))
      ((менше? (рівень-прикладу (перше залишок)) рівень)
       (відібрати-приклади-за-рівнем (решта залишок) рівень))
      ((більше? (рівень-прикладу (перше залишок)) рівень)
       (відібрати-приклади-за-рівнем (решта залишок) рівень))
      ((атом? (як-є ()))
       (сполучити
         (перше залишок)
         (відібрати-приклади-за-рівнем (решта залишок) рівень))))))

; SENS CLI відображає значення останнього виразу. Вивід не
; потребує неоголошеного D9 «друкувати» і не додає побічних дій
; до чистого українського D3/D5 відбору. Тут лишаються відсутні
; читати-всі/читати-файл: до їх реального допуску повний запуск
; повинен явно відмовляти, а не створювати уявний успіх.
(відібрати-приклади-за-рівнем
  (читати-всі (читати-файл "tests/fixtures/conformance.lisp"))
  потрібний-рівень)
