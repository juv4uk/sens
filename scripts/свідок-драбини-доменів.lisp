; Свідок цілісності доменної драбини D1..D11.
;
; Першопричина: STATUS.md описував D11 як «43 нератифіковані тестові
; позначення», тоді як чинне дерево містить 512 математично виведених
; селекторних похідних (256 батьків D10 × 2). Документація описувала
; ВІДХИЛЕНИЙ стан — тобто брехала про власний проєкт. А чекер
; check-domain-ladder-identity.py покривав лише D1..D10 — D11 не охоронявся
; взагалі.
;
; Інваріант драбини:
;   Dn (1 <= n <= 10) має рівно 2^n рядків — по одному на кожну n-бітну
;   координату. D11 має ВЛАСНИЙ закон: рівно 256 батьків × 2 похідні = 512,
;   і кожен батько несе обидва суфікси (0 = перше, 1 = решта).
;
; Чистий контракт: без I/O, без стану.

(визначити очікуваний-розмір
  (функція (n)
    (за-умовою
      ((тотожне? n 1) 2)
      ((тотожне? n 2) 4)
      ((тотожне? n 3) 8)
      ((тотожне? n 4) 16)
      ((тотожне? n 5) 32)
      ((тотожне? n 6) 64)
      ((тотожне? n 7) 128)
      ((тотожне? n 8) 256)
      ((тотожне? n 9) 512)
      ((тотожне? n 10) 1024)
      (так 0))))

(визначити драбина-повна?
  (функція (n фактично)
    (тотожне? (очікуваний-розмір n) фактично)))

; Закон D11: 256 батьків × 2 суфікси = 512.
(визначити d11-закон-виконано?
  (функція (батьків похідних)
    (і (тотожне? батьків 256)
       (тотожне? похідних 512))))

(визначити і
  (функція (а б)
    (за-умовою
      (а б)
      (так ні))))

; Незалежний контроль: справжні розміри проходять, вигадані — ні.
(драбина-повна? (як-є 10) (як-є 1024))
(драбина-повна? (як-є 10) (як-є 43))
(d11-закон-виконано? (як-є 256) (як-є 512))
(d11-закон-виконано? (як-є 43) (як-є 43))
