; Класифікація залежностей кожного конституційного прикладу.
; Приклади з tests/fixtures/conformance.lisp зіставляються з
; tests/fixtures/inventory.lisp позиційно, один до одного, як у
; scripts/oracle-batch.lisp. Для кожного визначаємо потрібні шари:
; ядро (особливі форми та вбудовані засоби Rust),
; створення й застосування замикань, точні числа, рядки й читач,
; стандартну бібліотеку lib/core.lisp або інші бібліотеки lib/*.lisp
; та можливості хоста (tcp-*, файлове введення-виведення,
; load, process-run). Останні входять до категорії
; «міркування/Світ або можливості хоста» за умовами
; WSM-CONSTITUTION-DEPENDENCY-CLASSIFICATION.
;
; Метод: справжній читач розбирає текст кожного прикладу.
; Самописний розпізнавач не застосовується — помилку цього класу
; раніше встановлено й виправлено в R1. Обхід дерева форм
; збирає символи в позиціях викличних голів лише тих підформ,
; що виконуються та не цитуються. Потім зіставляє їх із
; таблицями відомих імен. Локально зв'язані параметри lambda,
; let, let* або defmacro відкидаються: це змінні користувача,
; а не зовнішні залежності. Невідомі назви лишаються в явній
; категорії UNKNOWN, без вгадування.
;
; Таблиці особливих форм ядра, вбудованих функцій і можливостей
; хоста наведено явно: наразі джерела визначені в Rust,
; зокрема evaluate_list у crates/my-lisp/src/eval/mod.rs,
; crates/my-lisp/src/eval/builtins.rs та register_capability
; у crates/my-lisp-host/src/lib.rs.
; Натомість таблиці для lib/core.lisp і решти lib/*.lisp
; утворюються під час запуску: read-dir/read-file/read-all
; читають файли й збирають верхньорівневі def/defmacro.
; Це запобігає застаріванню вручну скопійованих переліків.
;
; Для категорії «точні числа» немає окремого предиката типу
; під час виконання. Історичний my-lisp не має примітивів
; rational?/exact?, а пошук раціональних літералів самописним
; аналізатором повторив би помилку R1. Натомість беремо
; підтверджені відомості із самих конституційних прикладів:
; кожен запис conformance.lisp перелічує аксіоми; позначка S1
; відповідає забороні непомітно наближати точне число
; неточним. Отже, приклад S1 перевіряє семантику точних чисел.
; Це менш точне свідчення, ніж справжня перевірка типу.
; Тому виводимо окрему позначку axiom-tagged-s1 і не прирівнюємо
; її до безпосередніх збігів таблиці символів інших категорій.
; Водночас позначка походить із реального джерела, а не припущення.
;
; Запуск: my-lisp scripts/build-dependency-classification.lisp > tests/fixtures/dependency-classification.lisp

; ---------------------------------------------------------------------
; Явні таблиці зовнішніх механізмів Rust, для яких немає джерела мовою СЕНС.
; ---------------------------------------------------------------------

; Гілки вибору evaluate_list з crates/my-lisp/src/eval/mod.rs.
(визначити ядрові-спеціальні-форми
  (як-є (quote lambda def defmacro cond print princ write-to-string read
          eval string-append string<? read-all string? symbol->string
          string->symbol string-first string-rest sha256-hex json-parse)))

; Реєстрації environment.define з crates/my-lisp/src/eval/builtins.rs.
; Похідні часові дії mono-ms, utc-now, internet-time-sync та
; timezone-detect тут навмисно не наведено: вони визначені
; в lib/time.lisp. Хостові дії повертають лише спостереження:
; mono-ns, unix-time-now, ntp-query-raw, timezone-declarations-raw.
(визначити ядрові-вбудовані
  (як-є (* + - / < = > abs atom car cdr cons env eq f32 f32-buffer i32
          i32-buffer make-vector max max-list min min-list mono-ns
          ntp-query-raw numeric-buffer-length numeric-buffer-map
          numeric-buffer-ref numeric-buffer-type numeric-buffer? string-slice
          timezone-declarations-raw unix-time-now vector vector-length vector-ref
          vector-set!)))

; Виклики register_capability у crates/my-lisp-host/src/lib.rs.
(визначити хостові-здатності
  (як-є (load process-run read-dir read-file read-file-bytes tcp-accept
          tcp-close tcp-connect tcp-listen tcp-read tcp-write write-file
          записати-байти-файла)))

; Дії для рядків і читача, виокремлені з двох попередніх
; таблиць в окрему категорію «strings/reader».
(визначити підмножина-рядки-читач
  (як-є (write-to-string read read-all string-append string<? string?
          symbol->string string->symbol string-first string-rest
          string-slice string-contains? string-empty? string-length
          string-prefix? взяти-десятковий-символ number->string number->string-onto)))

; ---------------------------------------------------------------------
; Похідні таблиці: читаємо справжні бібліотечні файли, не копіюємо вручну.
; ---------------------------------------------------------------------

(визначити верхньорівневі-імена-визначень
  (функція (форми)
    (за-умовою ((атом? форми) (як-є ())) ((атом? (як-є ())) (нехай-послідовно ((форма (перше форми))
                (залишок (верхньорівневі-імена-визначень (решта форми))))
           (за-умовою
             ((атом? форма) залишок)
             
             ((тотожне? (перше форма) (як-є def)) (сполучити (перше (решта форма)) залишок))
             ((тотожне? (перше форма) (як-є defmacro)) (сполучити (перше (решта форма)) залишок))
             ((атом? (як-є ())) залишок)))))))

(визначити імена-символів-з-файлу
  (функція (шлях)
    (верхньорівневі-імена-визначень (читати-всі (читати-файл шлях)))))

(визначити ядрові-мої-символи
  (імена-символів-з-файлу "lib/core.lisp"))

; Для кожного файла в lib/, крім core.lisp та кешу .fasl,
; записуємо всі визначені символи як асоціацію
; (назва-файла . (символи...)).
(визначити таблиці-інших-бібліотек
  (функція ()
    (нехай-послідовно ((записи (read-dir "lib"))
           (доречні (відсіяти
                       (функція (назва)
                         (та (рядок-префікс? ".lisp" (рядок-зріз назва (відняти (рядок-довжина назва) 3) (рядок-довжина назва)))
                              (хибне? (однакові? назва "core.lisp"))))
                       записи)))
      (відобразити (функція (назва)
             (сполучити назва (імена-символів-з-файлу (рядок-додати "lib/" назва))))
           доречні))))

; ---------------------------------------------------------------------
; The walker: collect every symbol used in executed head position,
; excluding locally-bound names, tagging %uses-lambda / %uses-let-family
; as it goes past lambda/let/let*/defmacro.
; ---------------------------------------------------------------------

; the constitutional fixture set deliberately includes malformed special
; forms (a lambda missing its body, a defmacro missing its parameter
; list, a let-binding missing its value expression) to test the real
; evaluator's own Arity errors -- crates/my-lisp/tests exercises the
; same class at conformance.lisp:113/134 (lambda/defmacro arity fixtures).
; The real evaluator rejects these at eval time; this classifier only
; needs to not crash while walking them, so every destructuring step
; below that assumes a minimum shape uses these instead of raw car/cdr,
; degrading a missing piece to () rather than erroring.
(визначити безпечне-перше
  (функція (елементи) (за-умовою ((атом? елементи) (як-є ())) ((атом? (як-є ())) (перше елементи)))))
(визначити безпечна-решта
  (функція (елементи) (за-умовою ((атом? елементи) (як-є ())) ((атом? (як-є ())) (решта елементи)))))

(визначити зібрати-символи-лист
  (функція (форма)
    (за-умовою
      ((символ? форма) (список форма))
      ((атом? форма) (як-є ()))
      
      ((атом? (як-є ())) (приєднати (зібрати-символи-лист (перше форма)) (зібрати-символи-лист (решта форма)))))))

(визначити зібрати-голови-кожного
  (функція (форми звязані)
    (за-умовою ((атом? форми) (як-є ())) ((атом? (як-є ())) (приєднати (зібрати-голови (перше форми) звязані)
                 (зібрати-голови-кожного (решта форми) звязані))))))

(визначити зібрати-голови-за-умовою-клаузи
  (функція (клаузи звязані)
    (за-умовою ((атом? клаузи) (як-є ())) ((атом? (як-є ())) (нехай-послідовно ((клауза (перше клаузи))
                (форма-умови (безпечне-перше клауза))
                (форма-тіла (безпечне-перше (безпечна-решта клауза)))
                (залежності-умови (зібрати-голови форма-умови звязані))
                (залежності-тіла (зібрати-голови форма-тіла звязані))
                (залежності-залишку (зібрати-голови-за-умовою-клаузи (решта клаузи) звязані)))
           (приєднати залежності-умови (приєднати залежності-тіла залежності-залишку)))))))

(визначити зібрати-голови-нехай-послідовно-послід
  (функція (звязки тіло звязані)
    (за-умовою ((атом? звязки) (зібрати-голови тіло звязані)) ((атом? (як-є ())) (нехай-послідовно ((звязка (перше звязки))
                (назва (безпечне-перше звязка))
                (форма-значення (безпечне-перше (безпечна-решта звязка)))
                (залежності-значення (зібрати-голови форма-значення звязані))
                (нові-звязані (сполучити назва звязані))
                (залежності-залишку (зібрати-голови-нехай-послідовно-послід (решта звязки) тіло нові-звязані)))
           (приєднати залежності-значення залежності-залишку))))))

(визначити зібрати-голови
  (функція (форма звязані)
    (за-умовою
      ((атом? форма) (як-є ()))
      
      ((атом? (як-є ())) (нехай ((голова (перше форма)))
           (за-умовою
             ((та (символ? голова) (тотожне? голова (як-є quote)))
              (як-є ()))
             ((та (символ? голова) (тотожне? голова (як-є lambda)))
              (нехай-послідовно ((параметри (безпечне-перше (безпечна-решта форма)))
                     (тіло (безпечна-решта (безпечна-решта форма)))
                     (імена-параметрів (зібрати-символи-лист параметри))
                     (нові-звязані (приєднати імена-параметрів звязані)))
                (сполучити (як-є %uses-lambda) (зібрати-голови-кожного тіло нові-звязані))))
             ((та (символ? голова) (тотожне? голова (як-є let)))
              (нехай-послідовно ((звязки (безпечне-перше (безпечна-решта форма)))
                     (тіло (безпечне-перше (безпечна-решта (безпечна-решта форма))))
                     (імена (відобразити (функція (зв) (безпечне-перше зв)) звязки))
                     (форми-значень (відобразити (функція (зв) (безпечне-перше (безпечна-решта зв))) звязки))
                     (залежності-значення (зібрати-голови-кожного форми-значень звязані))
                     (нові-звязані (приєднати імена звязані))
                     (залежності-тіла (зібрати-голови тіло нові-звязані)))
                (сполучити (як-є %uses-lambda)
                      (сполучити (як-є %uses-let-family) (приєднати залежності-значення залежності-тіла)))))
             ((та (символ? голова) (тотожне? голова (як-є let*)))
              (нехай-послідовно ((звязки (безпечне-перше (безпечна-решта форма)))
                     (тіло (безпечне-перше (безпечна-решта (безпечна-решта форма)))))
                (сполучити (як-є %uses-lambda)
                      (сполучити (як-є %uses-let-family)
                            (зібрати-голови-нехай-послідовно-послід звязки тіло звязані)))))
             ((та (символ? голова) (тотожне? голова (як-є def)))
              (нехай-послідовно ((назва (безпечне-перше (безпечна-решта форма)))
                     (форма-значення (безпечне-перше (безпечна-решта (безпечна-решта форма))))
                     ; def's own name is visible inside its own value-expr:
                     ; the evaluator shares one lexical frame between a def
                     ; and the closure it defines, so a self-referential
                     ; (def f (lambda (x) ... (f ...))) genuinely resolves
                     ; at call time even though f isn't bound yet when the
                     ; closure is created (crates/my-lisp/src/eval/special_forms/core.rs
                     ; evaluate_definition's own comment documents this).
                     (нові-звязані (сполучити назва звязані)))
                (зібрати-голови форма-значення нові-звязані)))
             ((та (символ? голова) (тотожне? голова (як-є defmacro)))
              (нехай-послідовно ((параметри (безпечне-перше (безпечна-решта (безпечна-решта форма))))
                     (тіло (безпечна-решта (безпечна-решта (безпечна-решта форма))))
                     (імена-параметрів (зібрати-символи-лист параметри))
                     (нові-звязані (приєднати імена-параметрів звязані)))
                (сполучити (як-є %uses-lambda) (зібрати-голови-кожного тіло нові-звязані))))
             ((та (символ? голова) (тотожне? голова (як-є cond)))
              (зібрати-голови-за-умовою-клаузи (решта форма) звязані))
             ((атом? (як-є ()))
              (нехай-послідовно ((залежність-голови (за-умовою
                                  ((хибне? (символ? голова)) (як-є ()))
                                  ((значення-у-списку? голова звязані) (як-є ()))
                                  ((атом? (як-є ())) (список голова))))
                     (рекурсія-голови (за-умовою ((атом? голова) (як-є ())) ((атом? (як-є ())) (зібрати-голови голова звязані))))
                     (залежності-аргументів (зібрати-голови-кожного (решта форма) звязані)))
                (приєднати залежність-голови (приєднати рекурсія-голови залежності-аргументів))))))))))

(визначити зібрати-залежності-однієї
  (функція (форма звязані)
    (за-умовою
      ((символ? форма) (за-умовою ((значення-у-списку? форма звязані) (як-є ())) ((атом? (як-є ())) (список форма))))
      ((атом? (як-є ())) (зібрати-голови форма звязані)))))

; a fixture's expr text can hold MORE than one top-level form (e.g.
; "(def count-down (lambda ...)) (count-down 100000)" -- a def followed
; by a call, exactly like a real script). read-all captures every form;
; a top-level def/defmacro extends the bound-set for the forms that
; follow it in the SAME fixture, matching how they'd actually be
; evaluated in one shared environment.
(визначити зібрати-залежності-верх-послід
  (функція (форми звязані)
    (за-умовою ((атом? форми) (як-є ())) ((атом? (як-є ())) (нехай-послідовно ((форма (перше форми))
                (залежності (зібрати-залежності-однієї форма звязані))
                (нові-звязані (за-умовою
                             ((атом? форма) звязані)
                             
                             ((та (символ? (перше форма)) (тотожне? (перше форма) (як-є def)))
                              (сполучити (перше (решта форма)) звязані))
                             ((та (символ? (перше форма)) (тотожне? (перше форма) (як-є defmacro)))
                              (сполучити (перше (решта форма)) звязані))
                             ((атом? (як-є ())) звязані))))
           (приєднати залежності (зібрати-залежності-верх-послід (решта форми) нові-звязані)))))))

(визначити зібрати-залежності-верх
  (функція (форми)
    (зібрати-залежності-верх-послід форми (як-є ()))))

; ---------------------------------------------------------------------
; Classification of one fixture's collected raw head-symbol list against
; the known tables.
; ---------------------------------------------------------------------

(визначити маркер?
  (функція (с)
    (або (тотожне? с (як-є %uses-lambda)) (тотожне? с (як-є %uses-let-family)))))

(визначити унікальні-у
  (функція (елементи накопичувач)
    (за-умовою
      ((атом? елементи) накопичувач)
      
      ((значення-у-списку? (перше елементи) накопичувач) (унікальні-у (решта елементи) накопичувач))
      ((атом? (як-є ())) (унікальні-у (решта елементи) (сполучити (перше елементи) накопичувач))))))

(визначити унікальні (функція (елементи) (унікальні-у елементи (як-є ()))))

(визначити бібліотека-власник
  (функція (симв таблиці)
    (за-умовою
      ((атом? таблиці) (як-є ()))
      
      ((значення-у-списку? симв (решта (перше таблиці))) (перше (перше таблиці)))
      ((атом? (як-є ())) (бібліотека-власник симв (решта таблиці))))))

; classify one real (non-marker) symbol; returns (bucket-tag . library-or-())
(визначити класифікувати-символ
  (функція (симв інші-таблиці)
    (за-умовою
      ((значення-у-списку? симв ядрові-спеціальні-форми) (сполучити (як-є core) (як-є ())))
      ((значення-у-списку? симв ядрові-вбудовані) (сполучити (як-є core) (як-є ())))
      ((значення-у-списку? симв хостові-здатності) (сполучити (як-є reasoning-world-or-host) симв))
      ((значення-у-списку? симв ядрові-мої-символи) (сполучити (як-є macro-expanded-core) (як-є ())))
      ((атом? (як-є ())) (нехай ((бібліотека (бібліотека-власник симв інші-таблиці)))
           (за-умовою
             ((однакові? бібліотека (як-є ())) (сполучити (як-є unknown) (як-є ())))
             ((атом? (як-є ())) (сполучити (як-є reasoning-world-or-host) бібліотека))))))))

; my-lisp has no try/catch: a fixture whose own point is that its source
; text exceeds the reader's decimal-literal exponent resource bound
; (crates/my-lisp/src/value.rs's MAX_DECIMAL_LITERAL_EXPONENT_MAGNITUDE,
