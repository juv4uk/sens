; Свідок узгодженості веб-шва: каталог збірки WASM == каталог бандлера == .gitignore.
;
; Першопричина: бандлер читає wasm/sens_wasm.js і wasm/sens_wasm_bg.wasm відносно
; каталогу вхідного HTML (public/), а wasm-pack спершу збирав у
; packaging/web/pkg. Розбіжність давала ENOENT, а fail-closed перевірки
; бандлера лишались недосяжними — тихе пошкодження замість гучної відмови.
;
; Інваріант: усі три каталоги тотожні. Чиста функція, без I/O і стану.

(визначити веб-шов-узгоджений?
  (функція (каталог-збірки каталог-бандлера каталог-gitignore)
    (і (тотожне? каталог-збірки каталог-бандлера)
       (тотожне? каталог-бандлера каталог-gitignore))))

(визначити і
  (функція (а б)
    (за-умовою
      (а б)
      (так ні))))

; Незалежний контроль на трьох станах.
(веб-шов-узгоджений? (як-є public/wasm) (як-є public/wasm) (як-є public/wasm))
(веб-шов-узгоджений? (як-є packaging/web/pkg) (як-є public/wasm) (як-є public/wasm))
