; Оновлює розділи docs/FUNCTIONS.md для відстежуваних файлів lib/:
; «### файл (N)» і перелік визначених назв. Заміна `cargo xtask
; gen-functions-md` (Rust) — тепер мовою.
;
; Визначення читаються як дані засобами СЕНС, а не пошуком рядків.
; Первинна виклична голова — «визначити» (ратифікований D4:0011).
; Історичні def/define більше не приймаються як визначення бібліотеки.
;
; Запуск:
;   sens scripts/generate-functions-md.lisp          — оновити довідник
;   sens scripts/generate-functions-md.lisp --check  — перевірити без запису

(визначити відстежувані-файли
  (як-є ("result-status.lisp" "narrate.lisp" "translation.lisp" "quantity.lisp" "si.lisp")))

(визначити шлях-довідника "docs/FUNCTIONS.md")

(визначити сполучити-текст
  (функція аргументи
    (згорнути (функція (накопичувач рядок) (рядок-додати накопичувач рядок)) "" аргументи)))

(визначити голова-визначення?
  (функція (голова)
    (за-умовою
      ((хибне? (атом? голова)) (атом? (як-є (()))))
      ((тотожне? голова (як-є визначити)) (атом? (як-є ())))
      ((атом? (як-є ())) (атом? (як-є (())))))))

(визначити назви-визначень
  (функція (форми)
    (за-умовою
      ((атом? форми) (як-є ()))
      ((атом? (перше форми))
       (назви-визначень (решта форми)))
      ((голова-визначення? (перше (перше форми)))
       (сполучити
         (символ-у-текст (друге (перше форми)))
         (назви-визначень (решта форми))))
      ((атом? (як-є ())) (назви-визначень (решта форми))))))

; Числа задаються засобами мови, а не десятковими літералами.
(визначити генератор-число-нуль (довжина (як-є ())))
(визначити генератор-число-один (довжина (як-є (а))))
(визначити генератор-число-десять (довжина (як-є (а б в г ґ д е є ж з))))
(визначити генератор-число-сто (помножити генератор-число-десять генератор-число-десять))
(визначити генератор-число-тисяча (помножити генератор-число-сто генератор-число-десять))
(визначити генератор-число-мільйон (помножити генератор-число-тисяча генератор-число-тисяча))
(визначити генератор-межа-документа (помножити генератор-число-мільйон генератор-число-тисяча))
(визначити генератор-число-мінус-один (відняти генератор-число-нуль генератор-число-один))

(визначити кількість-елементів
  (функція (елементи)
    (за-умовою
      ((атом? елементи) генератор-число-нуль)
      ((атом? (як-є ())) (додати генератор-число-один (кількість-елементів (решта елементи)))))))

; Кількість у довіднику — людське десяткове число, не машинний код.
; Текст створює наявний мовний перетворювач без повторної арифметики.
(визначити десятковий-підрахунок-у-рядок-дописати
  (функція (кількість накопичувач)
    (рядок-додати (значення-у-текст кількість) накопичувач)))

(визначити десятковий-підрахунок-у-рядок
  (функція (кількість)
    (десятковий-підрахунок-у-рядок-дописати кількість "")))

(визначити об'єднати-назви-лапками
  (функція (назви)
    (за-умовою
      ((атом? назви) "")
      ((атом? (решта назви))
       (сполучити-текст "`" (перше назви) "`"))
      ((атом? (як-є ()))
       (сполучити-текст "`" (перше назви) "`, "
         (об'єднати-назви-лапками (решта назви)))))))

(визначити створити-розділ
  (функція (файл)
    (нехай ((назви (назви-визначень (читати-всі (читати-файл (сполучити-текст "lib/" файл))))))
      (сполучити-текст "### " файл " (" (десятковий-підрахунок-у-рядок (кількість-елементів назви)) ")\n\n"
            (об'єднати-назви-лапками назви) "\n"))))

; Позиція першого входження позначки, починаючи з поточного індексу.
; Відсутність позначки — числове -1, не однобітна хиба.
(визначити позиція-підрядка
  (функція (рядок позначка позиція)
    (за-умовою
      ((рядок-порожній? рядок) генератор-число-мінус-один)
      ((рядок-префікс? позначка рядок) позиція)
      ((атом? (як-є ()))
       (позиція-підрядка
         (рядок-решта рядок) позначка (додати позиція генератор-число-один))))))

; Довжину великого документа не обчислюємо рекурсивно.
; Зріз обмежується фактичним кінцем рядка.
(визначити межа-зрізу генератор-межа-документа)

(визначити зріз-від
  (функція (рядок позиція)
    (рядок-зріз рядок позиція межа-зрізу)))

; Замінює розділ файлу: від «### файл (» до наступного «\n### » (або кінця).
(визначити замінити-розділ
  (функція (документ файл)
    (нехай ((позначка (сполучити-текст "### " файл " (")))
      (нехай ((початок (позиція-підрядка документ позначка генератор-число-нуль)))
        (за-умовою
          ((менше? початок генератор-число-нуль) (перше (як-є ())))
          ((атом? (як-є ()))
           (нехай ((після-початку (додати початок (рядок-довжина позначка))))
             (нехай
               ((зміщення (позиція-підрядка
                            (зріз-від документ після-початку) "\n### " генератор-число-нуль)))
               (нехай
                 ((кінець (за-умовою
                            ((менше? зміщення генератор-число-нуль) межа-зрізу)
                            ((атом? (як-є ())) (додати після-початку зміщення)))))
                 (сполучити-текст
                   (рядок-зріз документ генератор-число-нуль початок)
                   (створити-розділ файл)
                   (зріз-від документ кінець)))))))))))

(визначити замінити-всі-розділи
  (функція (документ файли)
    (за-умовою
      ((атом? файли) документ)
      ((атом? (як-є ()))
       (замінити-всі-розділи
         (замінити-розділ документ (перше файли))
         (решта файли))))))

(визначити поточний-вміст (читати-файл шлях-довідника))
(визначити згенерований-вміст (замінити-всі-розділи поточний-вміст відстежувані-файли))

; Прапорець --check є рядком зовнішнього інтерфейсу, не функцією.
(за-умовою
  ((атом? *argv*)
   (друге (список
     (записати-файл шлях-довідника згенерований-вміст)
     (друкувати "Оновлено розділи docs/FUNCTIONS.md"))))
  ((однакові? (перше *argv*) "--check")
   (за-умовою
     ((однакові? поточний-вміст згенерований-вміст)
      (друкувати "Розділи docs/FUNCTIONS.md актуальні"))
     ((атом? (як-є ())) (друге (список
       (друкувати "Розділи docs/FUNCTIONS.md потребують оновлення")
       (перше (як-є ())))))))
  ((атом? (як-є ())) (друге (список
     (записати-файл шлях-довідника згенерований-вміст)
     (друкувати "Оновлено розділи docs/FUNCTIONS.md")))))

