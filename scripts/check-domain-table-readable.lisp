; Виконуваний свідок приймання #3946.
; Кожна доменна таблиця є окремим файлом Lisp. Звичайний читач має
; зберігати точну ширину першого ключа кожного файла без цитування.

(визначити завантажити-домен
  (функція (шлях)
    (перше
      (читати-всі
        (читати-файл шлях)))))

(визначити рядки-домену
  (функція (форма)
    (решта форма)))

(визначити текст-першого-ключа
  (функція (форма)
    (значення-у-текст
      (перше
        (елемент-списку-за-індексом 0 (рядки-домену форма))))))

(визначити д1 (завантажити-домен "lib/domains/d1.lisp"))
(визначити д2 (завантажити-домен "lib/domains/d2.lisp"))
(визначити д3 (завантажити-домен "lib/domains/d3.lisp"))
(визначити д4 (завантажити-домен "lib/domains/d4.lisp"))
(визначити д5 (завантажити-домен "lib/domains/d5.lisp"))
(визначити д6 (завантажити-домен "lib/domains/d6.lisp"))
(визначити д8 (завантажити-домен "lib/domains/d8.lisp"))

(за-умовою
  ((тотожне? (перше д1) (як-є domain-table/1))
   (за-умовою
     ((тотожне? (довжина (рядки-домену д1)) 2)
      (за-умовою
        ((тотожне? (довжина (рядки-домену д2)) 4)
         (за-умовою
           ((тотожне? (довжина (рядки-домену д3)) 8)
            (за-умовою
              ((тотожне? (довжина (рядки-домену д4)) 16)
               (за-умовою
                 ((тотожне? (довжина (рядки-домену д5)) 32)
                  (за-умовою
                    ((тотожне? (довжина (рядки-домену д6)) 64)
                     (за-умовою
                       ((тотожне? (довжина (рядки-домену д8)) 256)
                        (за-умовою
                       ((тотожне? (текст-першого-ключа д1) "0")
                        (за-умовою
                          ((тотожне? (текст-першого-ключа д2) "00")
                           (за-умовою
                             ((тотожне? (текст-першого-ключа д3) "000")
                              (за-умовою
                                ((тотожне? (текст-першого-ключа д4) "0000")
                                 (за-умовою
                                   ((тотожне? (текст-першого-ключа д5) "00000")
                                    (за-умовою
                                      ((тотожне? (текст-першого-ключа д6) "000000")
                                       (за-умовою
                                         ((тотожне? (текст-першого-ключа д8) "00000000")
                                          (друкувати "DOMAIN-TABLE-READ: PASS files=7 rows=382 widths=1..6,8"))
                                         (так (domain-table-width-loss-d8))))
                                      (так (domain-table-width-loss-d6))))
                                   (так (domain-table-width-loss-d5))))
                                (так (domain-table-width-loss-d4))))
                             (так (domain-table-width-loss-d3))))
                          (так (domain-table-width-loss-d2))))
                       (так (domain-table-width-loss-d1))))
                          (так (domain-table-d8-count-failure))))
                    (так (domain-table-d6-count-failure))))
                 (так (domain-table-d5-count-failure))))
              (так (domain-table-d4-count-failure))))
           (так (domain-table-d3-count-failure))))
        (так (domain-table-d2-count-failure))))
     (так (domain-table-d1-count-failure))))
  (так (domain-table-schema-failure)))
