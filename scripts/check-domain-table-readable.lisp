; Виконуваний свідок приймання #3946.
; Кожна доменна таблиця є окремим файлом Lisp. Звичайний читач має
; зберігати точну ширину першого ключа кожного файла без цитування.

(визначити завантажити-домен
  (функція (шлях)
    (перше
      (читати-всі
        (читати-файл шлях)))))

(визначити рядки-домену
  (функція (форма)
    (решта форма)))

(визначити текст-першого-ключа
  (функція (форма)
    (значення-у-текст
      (перше
        (елемент-списку-за-індексом 0 (рядки-домену форма))))))

; Д3 тотожне? порівнює точні атомарні ідентичності, не числові величини.
; Довжина таблиці є математичним значенням Д24+; рівність одержуємо
; двома перевірками порядку Д5 без неявного перетворення у бітовий атом.
(визначити однакова-кількість?
  (функція (ліва права)
    (за-умовою
      ((менше? ліва права) ні)
      ((більше? ліва права) ні)
      (так так))))

; Текстові ключі перевіряємо через однакові? з урахуванням усіх нулів,
; а не атомарною тотожністю Д3.

(визначити д1 (завантажити-домен "lib/domains/d1.lisp"))
(визначити д2 (завантажити-домен "lib/domains/d2.lisp"))
(визначити д3 (завантажити-домен "lib/domains/d3.lisp"))
(визначити д4 (завантажити-домен "lib/domains/d4.lisp"))
(визначити д5 (завантажити-домен "lib/domains/d5.lisp"))
(визначити д6 (завантажити-домен "lib/domains/d6.lisp"))
(визначити д8 (завантажити-домен "lib/domains/d8.lisp"))

(за-умовою
  ((тотожне? (перше д1) (як-є domain-table/1))
   (за-умовою
     ((однакова-кількість? (довжина (рядки-домену д1)) 2)
      (за-умовою
        ((однакова-кількість? (довжина (рядки-домену д2)) 4)
         (за-умовою
           ((однакова-кількість? (довжина (рядки-домену д3)) 8)
            (за-умовою
              ((однакова-кількість? (довжина (рядки-домену д4)) 16)
               (за-умовою
                 ((однакова-кількість? (довжина (рядки-домену д5)) 32)
                  (за-умовою
                    ((однакова-кількість? (довжина (рядки-домену д6)) 64)
                     (за-умовою
                       ((однакова-кількість? (довжина (рядки-домену д8)) 256)
                        (за-умовою
                       ((однакові? (текст-першого-ключа д1) "0")
                        (за-умовою
                          ((однакові? (текст-першого-ключа д2) "00")
                           (за-умовою
                             ((однакові? (текст-першого-ключа д3) "000")
                              (за-умовою
                                ((однакові? (текст-першого-ключа д4) "0000")
                                 (за-умовою
                                   ((однакові? (текст-першого-ключа д5) "00000")
                                    (за-умовою
                                      ((однакові? (текст-першого-ключа д6) "000000")
                                       (за-умовою
                                         ((однакові? (текст-першого-ключа д8) "00000000")
                                          (друкувати "DOMAIN-TABLE-READ: PASS files=7 rows=382 widths=1..6,8"))
                                         (так (помилка-втрати-ширини-д8))))
                                      (так (помилка-втрати-ширини-д6))))
                                   (так (помилка-втрати-ширини-д5))))
                                (так (помилка-втрати-ширини-д4))))
                             (так (помилка-втрати-ширини-д3))))
                          (так (помилка-втрати-ширини-д2))))
                       (так (помилка-втрати-ширини-д1))))
                          (так (помилка-кількості-домену-д8))))
                    (так (помилка-кількості-домену-д6))))
                 (так (помилка-кількості-домену-д5))))
              (так (помилка-кількості-домену-д4))))
           (так (помилка-кількості-домену-д3))))
        (так (помилка-кількості-домену-д2))))
     (так (помилка-кількості-домену-д1))))
  (так (помилка-схеми-домену)))
