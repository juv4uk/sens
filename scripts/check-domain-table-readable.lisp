; Виконуваний свідок приймання #3946.
; Кожна доменна таблиця є окремим файлом Lisp. Звичайний читач має
; зберігати точну ширину першого ключа кожного файла без цитування.

; Розміри таблиць — математичні значення, побудовані засобами SENS.
(визначити таблиця-розмір-нуль (довжина (як-є ())))
(визначити таблиця-розмір-два (довжина (як-є (а б))))
(визначити таблиця-розмір-чотири (помножити таблиця-розмір-два таблиця-розмір-два))
(визначити таблиця-розмір-вісім (помножити таблиця-розмір-чотири таблиця-розмір-два))
(визначити таблиця-розмір-шістнадцять (помножити таблиця-розмір-вісім таблиця-розмір-два))
(визначити таблиця-розмір-тридцять-два (помножити таблиця-розмір-шістнадцять таблиця-розмір-два))
(визначити таблиця-розмір-шістдесят-чотири (помножити таблиця-розмір-тридцять-два таблиця-розмір-два))
(визначити таблиця-розмір-сто-двадцять-вісім (помножити таблиця-розмір-шістдесят-чотири таблиця-розмір-два))
(визначити таблиця-розмір-двісті-пʼятдесят-шість (помножити таблиця-розмір-сто-двадцять-вісім таблиця-розмір-два))
(визначити таблиця-розмір-пʼятсот-дванадцять (помножити таблиця-розмір-двісті-пʼятдесят-шість таблиця-розмір-два))
(визначити таблиця-розмір-тисяча-двадцять-чотири (помножити таблиця-розмір-пʼятсот-дванадцять таблиця-розмір-два))

(визначити завантажити-домен
  (функція (шлях)
    (перше
      (читати-всі
        (читати-файл шлях)))))

(визначити рядки-домену
  (функція (форма)
    (решта форма)))

(визначити текст-першого-ключа
  (функція (форма)
    (значення-у-текст
      (перше
        (елемент-списку-за-індексом таблиця-розмір-нуль (рядки-домену форма))))))

; Д3 тотожне? порівнює точні атомарні ідентичності, не числові величини.
; Довжина таблиці є математичним значенням Д24+; рівність одержуємо
; двома перевірками порядку Д5 без неявного перетворення у бітовий атом.
(визначити однакова-кількість?
  (функція (ліва права)
    (за-умовою
      ((менше? ліва права) (атом? (сполучити (як-є ()) (як-є ()))))
      ((більше? ліва права) (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (як-є ())) (атом? (як-є ()))))))

; Текстові ключі перевіряємо через однакові? з урахуванням усіх нулів,
; а не атомарною тотожністю Д3.

; Фізичний T5M не допускає сирих String-літералів шляхів.
; Шляхи D1–D10 є цитованими точними іменами D7;
; D8 символ-у-текст відновлює текст тільки на межі I/O.

(визначити д1 (завантажити-домен (символ-у-текст (як-є lib/domains/d1.lisp))))
(визначити д2 (завантажити-домен (символ-у-текст (як-є lib/domains/d2.lisp))))
(визначити д3 (завантажити-домен (символ-у-текст (як-є lib/domains/d3.lisp))))
(визначити д4 (завантажити-домен (символ-у-текст (як-є lib/domains/d4.lisp))))
(визначити д5 (завантажити-домен (символ-у-текст (як-є lib/domains/d5.lisp))))
(визначити д6 (завантажити-домен (символ-у-текст (як-є lib/domains/d6.lisp))))
(визначити д7 (завантажити-домен (символ-у-текст (як-є lib/domains/d7.lisp))))
(визначити д8 (завантажити-домен (символ-у-текст (як-є lib/domains/d8.lisp))))
(визначити д9 (завантажити-домен (символ-у-текст (як-є lib/domains/d9.lisp))))
(визначити д10 (завантажити-домен (символ-у-текст (як-є lib/domains/d10.lisp))))

; Те саме читання для новіших доменів: не плутати кількість
; математичних рядків з D3-атомарною тотожністю.
; Повертаємо обчислений D1 стан; помилки навмисно не визначено.
(визначити перевірити-розширений-домен?
  (функція (форма очікувана-кількість очікуваний-ключ)
    (за-умовою
      ((хибне? (тотожне? (перше форма) (як-є domain-table-1)))
       (помилка-схеми-розширеного-домену))
      ((хибне? (однакова-кількість? (довжина (рядки-домену форма)) очікувана-кількість))
       (помилка-кількості-розширеного-домену))
      ((хибне? (однакові? (текст-першого-ключа форма) очікуваний-ключ))
       (помилка-ширини-розширеного-домену))
      ((атом? (як-є ())) (атом? (як-є ()))))))

(за-умовою
  ((тотожне? (перше д1) (як-є domain-table-1))
   (за-умовою
     ((однакова-кількість? (довжина (рядки-домену д1)) таблиця-розмір-два)
      (за-умовою
        ((однакова-кількість? (довжина (рядки-домену д2)) таблиця-розмір-чотири)
         (за-умовою
           ((однакова-кількість? (довжина (рядки-домену д3)) таблиця-розмір-вісім)
            (за-умовою
              ((однакова-кількість? (довжина (рядки-домену д4)) таблиця-розмір-шістнадцять)
               (за-умовою
                 ((однакова-кількість? (довжина (рядки-домену д5)) таблиця-розмір-тридцять-два)
                  (за-умовою
                    ((однакова-кількість? (довжина (рядки-домену д6)) таблиця-розмір-шістдесят-чотири)
                     (за-умовою
                       ((однакова-кількість? (довжина (рядки-домену д8)) таблиця-розмір-двісті-пʼятдесят-шість)
                        (за-умовою
                       ((однакові? (текст-першого-ключа д1) "0")
                        (за-умовою
                          ((однакові? (текст-першого-ключа д2) "00")
                           (за-умовою
                             ((однакові? (текст-першого-ключа д3) "000")
                              (за-умовою
                                ((однакові? (текст-першого-ключа д4) "0000")
                                 (за-умовою
                                   ((однакові? (текст-першого-ключа д5) "00000")
                                    (за-умовою
                                      ((однакові? (текст-першого-ключа д6) "000000")
                                       (за-умовою
                                         ((однакові? (текст-першого-ключа д8) "00000000")
                                          (за-умовою
                                            ((перевірити-розширений-домен? д7 таблиця-розмір-сто-двадцять-вісім "0000000")
                                             (за-умовою
                                               ((перевірити-розширений-домен? д9 таблиця-розмір-пʼятсот-дванадцять "000000000")
                                                (за-умовою
                                                  ((перевірити-розширений-домен? д10 таблиця-розмір-тисяча-двадцять-чотири "0000000000")
                                                   (друкувати "DOMAIN-TABLE-READ: PASS files=10 rows=2046 widths=1..10"))
                                                  ((атом? (як-є ())) (помилка-таблиці-д10))))
                                               ((атом? (як-є ())) (помилка-таблиці-д9))))
                                            ((атом? (як-є ())) (помилка-таблиці-д7))))
                                         ((атом? (як-є ())) (помилка-втрати-ширини-д8))))
                                      ((атом? (як-є ())) (помилка-втрати-ширини-д6))))
                                   ((атом? (як-є ())) (помилка-втрати-ширини-д5))))
                                ((атом? (як-є ())) (помилка-втрати-ширини-д4))))
                             ((атом? (як-є ())) (помилка-втрати-ширини-д3))))
                          ((атом? (як-є ())) (помилка-втрати-ширини-д2))))
                       ((атом? (як-є ())) (помилка-втрати-ширини-д1))))
                          ((атом? (як-є ())) (помилка-кількості-домену-д8))))
                    ((атом? (як-є ())) (помилка-кількості-домену-д6))))
                 ((атом? (як-є ())) (помилка-кількості-домену-д5))))
              ((атом? (як-є ())) (помилка-кількості-домену-д4))))
           ((атом? (як-є ())) (помилка-кількості-домену-д3))))
        ((атом? (як-є ())) (помилка-кількості-домену-д2))))
     ((атом? (як-є ())) (помилка-кількості-домену-д1))))
  ((атом? (як-є ())) (помилка-схеми-домену)))
