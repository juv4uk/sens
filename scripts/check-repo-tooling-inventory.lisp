(визначити інструменти-репо-перевірити-вердикт
  (функція (фактичне очікуване)
    (за-умовою
      ((однакові? фактичне очікуване)
       (список (як-є repo-tooling-selftest-ok)))
      (так
       (нехай ((показане
               (друкувати
                 (список
                   (як-є repo-tooling-selftest-failed)
                   фактичне
                   очікуване))))
         (перше (як-є ())))))))

