(визначити інструменти-репо-рядки-інструментів
  (функція (форми)
    (за-умовою
      ((порожній? форми) (як-є ()))
      ((за-умовою ((атом? форми) (хибне? (порожній? форми))) (так ні)) (як-є ()))
      ((хибне? (атом? форми))
       (нехай ((форма (перше форми)))
         (за-умовою
           ((порожній? форма)
            (інструменти-репо-рядки-інструментів (решта форми)))
           ((за-умовою ((атом? форма) (хибне? (порожній? форма))) (так ні))
            (інструменти-репо-рядки-інструментів (решта форми)))
           ((хибне? (атом? форма))
            (за-умовою
              ((тотожне? (перше форма) (як-є tool))
               (сполучити форма (інструменти-репо-рядки-інструментів (решта форми))))
              ((хибне? (тотожне? (перше форма) (як-є tool)))
               (інструменти-репо-рядки-інструментів (решта форми)))))))))))

(визначити інструменти-репо-спостережені-скрипти
  (функція (записи)
