; #382 — Lisp-owned repository tooling inventory validator.
; Policy and inventory data are Lisp-owned. This checker never defines language semantics.

(визначити інструменти-репо-потрібні-поля
  (як-є (path kind language role lifecycle callers authority-source
               migration-issue replacement removal-condition)))

(визначити інструменти-репо-види
  (як-є (check generator migration benchmark deploy release helper other)))

(визначити інструменти-репо-мови
  (як-є (lisp python shell javascript powershell other)))

(визначити інструменти-репо-цикли-життя
  (як-є (active transitional legacy generated-helper archive-candidate)))

(визначити інструменти-репо-порушення
  (функція (вид подробиця)
    (список (як-є repo-tooling-violation) вид подробиця)))

(визначити інструменти-репо-поле-з
  (функція (назва поля)
    (за-умовою
      ((атом? поля) () (як-є missing))
      ((атом? поля) (1) (як-є missing))
      ((атом? поля) (0)
       (нехай ((поле (перше поля)))
         (за-умовою
           ((атом? поле) ()
            (інструменти-репо-поле-з назва (решта поля)))
           ((атом? поле) (1)
            (інструменти-репо-поле-з назва (решта поля)))
           ((атом? поле) (0)
            (за-умовою
              ((тотожне? (перше поле) назва) (1) (друге поле))
              ((тотожне? (перше поле) назва) (0)
               (інструменти-репо-поле-з назва (решта поля)))))))))))

(визначити інструменти-репо-поле
  (функція (назва рядок)
    (за-умовою
      ((атом? рядок) () (як-є missing))
      ((атом? рядок) (1) (як-є missing))
      ((атом? рядок) (0)
       (інструменти-репо-поле-з назва (решта рядок))))))

(визначити інструменти-репо-вердикт-стан-гаразд
  (функція (вердикт)
    (за-умовою
      ((однакові? вердикт (список (як-є repo-tooling-ok)))
       (1)
       (як-є yes))
      ((однакові? вердикт (список (як-є repo-tooling-ok)))
       (0)
       (як-є no)))))

(визначити інструменти-репо-поле-наявність
  (функція (значення)
    (за-умовою
      ((атом? значення) () (як-є present))
      ((атом? значення) (1)
       (за-умовою
         ((тотожне? значення (як-є missing)) (1) (як-є missing))
         ((тотожне? значення (як-є missing)) (0) (як-є present))))
      ((атом? значення) (0) (як-є present)))))

(визначити інструменти-репо-вердикт-потрібних-полів
  (функція (потрібні рядок)
    (за-умовою
      ((атом? потрібні) () (список (як-є repo-tooling-ok)))
      ((атом? потрібні) (1)
       (інструменти-репо-порушення (як-є malformed-required-field-list) потрібні))
      ((атом? потрібні) (0)
       (за-умовою
         ((тотожне? (інструменти-репо-поле-наявність
                (інструменти-репо-поле (перше потрібні) рядок))
              (як-є missing))
          (1)
          (інструменти-репо-порушення (як-є missing-field) (перше потрібні)))
         ((тотожне? (інструменти-репо-поле-наявність
                (інструменти-репо-поле (перше потрібні) рядок))
              (як-є missing))
          (0)
          (інструменти-репо-вердикт-потрібних-полів (решта потрібні) рядок)))))))

(визначити інструменти-репо-вердикт-потрібних-полів-рядка
  (функція (рядок)
    (за-умовою
      ((атом? рядок) ()
       (інструменти-репо-порушення (як-є malformed-row) рядок))
      ((атом? рядок) (1)
       (інструменти-репо-порушення (як-є malformed-row) рядок))
      ((атом? рядок) (0)
       (за-умовою
         ((тотожне? (перше рядок) (як-є tool)) (1)
          (інструменти-репо-вердикт-потрібних-полів інструменти-репо-потрібні-поля рядок))
         ((тотожне? (перше рядок) (як-є tool)) (0)
          (інструменти-репо-порушення (як-є malformed-row-kind) (перше рядок))))))))

(визначити інструменти-репо-вердикт-потрібних
  (функція (рядки)
    (за-умовою
      ((атом? рядки) () (список (як-є repo-tooling-ok)))
      ((атом? рядки) (1)
       (інструменти-репо-порушення (як-є malformed-inventory-list) рядки))
      ((атом? рядки) (0)
       (нехай ((вердикт-рядка (інструменти-репо-вердикт-потрібних-полів-рядка (перше рядки))))
         (за-умовою
           ((тотожне? (інструменти-репо-вердикт-стан-гаразд вердикт-рядка) (як-є yes))
            (1)
            (інструменти-репо-вердикт-потрібних (решта рядки)))
           ((тотожне? (інструменти-репо-вердикт-стан-гаразд вердикт-рядка) (як-є no))
            (1)
            вердикт-рядка)))))))

(визначити інструменти-репо-допуск-символу
  (функція (значення допущені)
    (за-умовою
      ((атом? допущені) () (як-є rejected))
      ((атом? допущені) (1) (як-є malformed-admitted-set))
      ((атом? допущені) (0)
       (за-умовою
         ((тотожне? значення (перше допущені)) (1) (як-є admitted))
         ((тотожне? значення (перше допущені)) (0)
          (інструменти-репо-допуск-символу значення (решта допущені))))))))

(визначити інструменти-репо-вердикт-переліку-рядка
  (функція (рядок)
    (нехай-послідовно ((вид (інструменти-репо-поле (як-є kind) рядок))
           (мова (інструменти-репо-поле (як-є language) рядок))
           (цикл-життя (інструменти-репо-поле (як-є lifecycle) рядок))
           (стан-виду (інструменти-репо-допуск-символу вид інструменти-репо-види)))
      (за-умовою
        ((тотожне? стан-виду (як-є admitted)) (1)
         (нехай ((стан-мови
                 (інструменти-репо-допуск-символу мова інструменти-репо-мови)))
           (за-умовою
             ((тотожне? стан-мови (як-є admitted)) (1)
              (нехай ((стан-циклу-життя
                      (інструменти-репо-допуск-символу цикл-життя інструменти-репо-цикли-життя)))
                (за-умовою
                  ((тотожне? стан-циклу-життя (як-є admitted)) (1)
                   (список (як-є repo-tooling-ok)))
                  ((тотожне? стан-циклу-життя (як-є rejected)) (1)
                   (інструменти-репо-порушення (як-є invalid-lifecycle) цикл-життя))
                  ((тотожне? стан-циклу-життя (як-є malformed-admitted-set))
                   (1)
                   (інструменти-репо-порушення
                     (як-є malformed-lifecycle-vocabulary)
                     цикл-життя)))))
             ((тотожне? стан-мови (як-є rejected)) (1)
              (інструменти-репо-порушення (як-є invalid-language) мова))
             ((тотожне? стан-мови (як-є malformed-admitted-set))
              (1)
              (інструменти-репо-порушення
                (як-є malformed-language-vocabulary)
                мова)))))
        ((тотожне? стан-виду (як-є rejected)) (1)
         (інструменти-репо-порушення (як-є invalid-kind) вид))
        ((тотожне? стан-виду (як-є malformed-admitted-set)) (1)
         (інструменти-репо-порушення (як-є malformed-kind-vocabulary) вид))))))

(визначити інструменти-репо-вердикт-переліку
  (функція (рядки)
    (за-умовою
      ((атом? рядки) () (список (як-є repo-tooling-ok)))
      ((атом? рядки) (1)
       (інструменти-репо-порушення (як-є malformed-inventory-list) рядки))
      ((атом? рядки) (0)
       (нехай ((вердикт-рядка (інструменти-репо-вердикт-переліку-рядка (перше рядки))))
         (за-умовою
           ((тотожне? (інструменти-репо-вердикт-стан-гаразд вердикт-рядка) (як-є yes))
            (1)
            (інструменти-репо-вердикт-переліку (решта рядки)))
           ((тотожне? (інструменти-репо-вердикт-стан-гаразд вердикт-рядка) (як-є no))
            (1)
            вердикт-рядка)))))))

(визначити інструменти-репо-стан-потреби-міграції-пайтон
  (функція (рядок)
    (нехай ((мова (інструменти-репо-поле (як-є language) рядок))
          (цикл-життя (інструменти-репо-поле (як-є lifecycle) рядок)))
      (за-умовою
        ((тотожне? мова (як-є python)) (1)
         (за-умовою
           ((тотожне? цикл-життя (як-є active)) (1) (як-є required))
           ((тотожне? цикл-життя (як-є active)) (0)
            (за-умовою
              ((тотожне? цикл-життя (як-є transitional))
               (1)
               (як-є required))
              ((тотожне? цикл-життя (як-є transitional))
               (0)
               (як-є not-required))))))
        ((тотожне? мова (як-є python)) (0)
         (як-є not-required))))))

(визначити інструменти-репо-стан-власника-міграції
  (функція (власник)
    (за-умовою
      ((атом? власник) () (як-є missing))
      ((атом? власник) (1)
       (за-умовою
         ((тотожне? власник (як-є missing)) (1) (як-є missing))
         ((тотожне? власник (як-є missing)) (0) (як-є present))))
      ((атом? власник) (0) (як-є present)))))

(визначити інструменти-репо-вердикт-міграції-пайтон-рядка
  (функція (рядок)
    (нехай ((стан-потреби (інструменти-репо-стан-потреби-міграції-пайтон рядок)))
      (за-умовою
        ((тотожне? стан-потреби (як-є not-required)) (1)
         (список (як-є repo-tooling-ok)))
        ((тотожне? стан-потреби (як-є required)) (1)
         (нехай-послідовно ((власник (інструменти-репо-поле (як-є migration-issue) рядок))
                (стан-власника (інструменти-репо-стан-власника-міграції власник)))
           (за-умовою
             ((тотожне? стан-власника (як-є present)) (1)
              (список (як-є repo-tooling-ok)))
             ((тотожне? стан-власника (як-є missing)) (1)
              (інструменти-репо-порушення
                (як-є python-migration-unowned)
                (інструменти-репо-поле (як-є path) рядок))))))))))

(визначити інструменти-репо-вердикт-міграції-пайтон
  (функція (рядки)
    (за-умовою
      ((атом? рядки) () (список (як-є repo-tooling-ok)))
      ((атом? рядки) (1)
       (інструменти-репо-порушення (як-є malformed-inventory-list) рядки))
      ((атом? рядки) (0)
       (нехай ((вердикт-рядка (інструменти-репо-вердикт-міграції-пайтон-рядка (перше рядки))))
         (за-умовою
           ((тотожне? (інструменти-репо-вердикт-стан-гаразд вердикт-рядка) (як-є yes))
            (1)
            (інструменти-репо-вердикт-міграції-пайтон (решта рядки)))
           ((тотожне? (інструменти-репо-вердикт-стан-гаразд вердикт-рядка) (як-є no))
            (1)
            вердикт-рядка)))))))

(визначити інструменти-репо-знайти-рядок-за-шляхом
  (функція (шлях рядки)
    (за-умовою
      ((атом? рядки) () (як-є ()))
      ((атом? рядки) (1) (як-є ()))
      ((атом? рядки) (0)
       (нехай ((рядок (перше рядки)))
         (за-умовою
           ((однакові? шлях (інструменти-репо-поле (як-є path) рядок))
            (1)
            рядок)
           ((однакові? шлях (інструменти-репо-поле (як-є path) рядок))
            (0)
            (інструменти-репо-знайти-рядок-за-шляхом шлях (решта рядки)))))))))

(визначити інструменти-репо-вердикт-дубля-шляху
  (функція (рядки)
    (за-умовою
      ((атом? рядки) () (список (як-є repo-tooling-ok)))
      ((атом? рядки) (1)
       (інструменти-репо-порушення (як-є malformed-inventory-list) рядки))
      ((атом? рядки) (0)
       (нехай-послідовно ((рядок (перше рядки))
              (шлях (інструменти-репо-поле (як-є path) рядок))
              (знайдене (інструменти-репо-знайти-рядок-за-шляхом шлях (решта рядки))))
         (за-умовою
           ((атом? знайдене) ()
            (інструменти-репо-вердикт-дубля-шляху (решта рядки)))
           ((атом? знайдене) (1)
            (інструменти-репо-порушення (як-є malformed-row) шлях))
           ((атом? знайдене) (0)
            (інструменти-репо-порушення (як-є duplicate-path) шлях))))))))

(визначити інструменти-репо-стан-спостереженого-шляху
  (функція (шлях спостережені)
    (за-умовою
      ((атом? спостережені) () (як-є absent))
      ((атом? спостережені) (1) (як-є malformed))
      ((атом? спостережені) (0)
       (нехай ((спостережений-шлях (рядок-додати "scripts/" (перше спостережені))))
         (за-умовою
           ((однакові? шлях спостережений-шлях) (як-є present))
           (так
            (інструменти-репо-стан-спостереженого-шляху шлях (решта спостережені)))))))))

(визначити інструменти-репо-вердикт-застарілого-шляху
  (функція (рядки спостережені)
    (за-умовою
      ((атом? рядки) () (список (як-є repo-tooling-ok)))
      ((атом? рядки) (1)
       (інструменти-репо-порушення (як-є malformed-inventory-list) рядки))
      ((атом? рядки) (0)
       (нехай-послідовно ((рядок (перше рядки))
              (шлях (інструменти-репо-поле (як-є path) рядок))
              (стан (інструменти-репо-стан-спостереженого-шляху шлях спостережені)))
         (за-умовою
           ((тотожне? стан (як-є present)) (1)
            (інструменти-репо-вердикт-застарілого-шляху (решта рядки) спостережені))
           ((тотожне? стан (як-є absent)) (1)
            (інструменти-репо-порушення (як-є stale-path) шлях))
           ((тотожне? стан (як-є malformed)) (1)
            (інструменти-репо-порушення (як-є malformed-observed-list) спостережені))))))))

(визначити інструменти-репо-вердикт-покриття-спостережених
  (функція (рядки спостережені)
    (за-умовою
      ((атом? спостережені) () (список (як-є repo-tooling-ok)))
      ((атом? спостережені) (1)
       (інструменти-репо-порушення (як-є malformed-observed-list) спостережені))
      ((атом? спостережені) (0)
       (нехай-послідовно ((назва (перше спостережені))
              (шлях (рядок-додати "scripts/" назва))
              (знайдене (інструменти-репо-знайти-рядок-за-шляхом шлях рядки)))
         (за-умовою
           ((атом? знайдене) ()
            (інструменти-репо-порушення (як-є unregistered-tool) шлях))
           ((атом? знайдене) (1)
            (інструменти-репо-порушення (як-є malformed-row) шлях))
           ((атом? знайдене) (0)
            (інструменти-репо-вердикт-покриття-спостережених рядки (решта спостережені)))))))))

(визначити інструменти-репо-вердикт-після-потрібних
  (функція (рядки спостережені)
    (нехай ((вердикт-переліку (інструменти-репо-вердикт-переліку рядки)))
      (за-умовою
        ((тотожне? (інструменти-репо-вердикт-стан-гаразд вердикт-переліку) (як-є yes))
         (1)
         (нехай ((вердикт-міграції (інструменти-репо-вердикт-міграції-пайтон рядки)))
           (за-умовою
             ((тотожне? (інструменти-репо-вердикт-стан-гаразд вердикт-міграції) (як-є yes))
              (1)
              (нехай ((вердикт-дубля (інструменти-репо-вердикт-дубля-шляху рядки)))
                (за-умовою
                  ((тотожне? (інструменти-репо-вердикт-стан-гаразд вердикт-дубля) (як-є yes))
                   (1)
                   (нехай ((вердикт-застарілого (інструменти-репо-вердикт-застарілого-шляху рядки спостережені)))
                     (за-умовою
                       ((тотожне? (інструменти-репо-вердикт-стан-гаразд вердикт-застарілого) (як-є yes))
                        (1)
                        (інструменти-репо-вердикт-покриття-спостережених рядки спостережені))
                       ((тотожне? (інструменти-репо-вердикт-стан-гаразд вердикт-застарілого) (як-є no))
                        (1)
                        вердикт-застарілого))))
                  ((тотожне? (інструменти-репо-вердикт-стан-гаразд вердикт-дубля) (як-є no))
                   (1)
                   вердикт-дубля))))
             ((тотожне? (інструменти-репо-вердикт-стан-гаразд вердикт-міграції) (як-є no))
              (1)
              вердикт-міграції))))
        ((тотожне? (інструменти-репо-вердикт-стан-гаразд вердикт-переліку) (як-є no))
         (1)
         вердикт-переліку)))))

(визначити інструменти-репо-вердикт
  (функція (рядки спостережені)
    (нехай ((вердикт-потрібних (інструменти-репо-вердикт-потрібних рядки)))
      (за-умовою
        ((тотожне? (інструменти-репо-вердикт-стан-гаразд вердикт-потрібних) (як-є yes))
         (1)
         (інструменти-репо-вердикт-після-потрібних рядки спостережені))
        ((тотожне? (інструменти-репо-вердикт-стан-гаразд вердикт-потрібних) (як-є no))
         (1)
         вердикт-потрібних)))))

