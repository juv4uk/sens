; ----- реальне спостереження репозиторію -----

(визначити інструменти-репо-рядки-інструментів
  (функція (форми)
    (за-умовою
      ((атом? форми) () (як-є ()))
      ((атом? форми) (1) (як-є ()))
      ((атом? форми) (0)
       (нехай ((форма (перше форми)))
         (за-умовою
           ((атом? форма) ()
            (інструменти-репо-рядки-інструментів (решта форми)))
           ((атом? форма) (1)
            (інструменти-репо-рядки-інструментів (решта форми)))
           ((атом? форма) (0)
            (за-умовою
              ((тотожне? (перше форма) (як-є tool)) (1)
               (сполучити форма (інструменти-репо-рядки-інструментів (решта форми))))
              ((тотожне? (перше форма) (як-є tool)) (0)
               (інструменти-репо-рядки-інструментів (решта форми)))))))))))

(визначити інструменти-репо-спостережені-скрипти
  (функція (записи)
    (за-умовою
      ((атом? записи) () (як-є ()))
      ((атом? записи) (1) (як-є ()))
      ((атом? записи) (0)
       (нехай ((назва (перше записи)))
         (за-умовою
           ((однакові? назва "tests")
            (інструменти-репо-спостережені-скрипти (решта записи)))
           (так
            (сполучити назва (інструменти-репо-спостережені-скрипти (решта записи))))))))))

