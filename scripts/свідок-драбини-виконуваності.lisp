; Свідок: виконуваність ⊆ ратифікований каталог — НА КОЖНОМУ щаблі.
;
; Першопричина: розділення «позиція ≠ виконуване» довели лише для D10. Для
; решти щаблів ніхто не звів машино-перевіреної межі, а джерело bindings
; існує лише для D5, D6, D9, D10. Щаблі без джерела (D1–D4, D7, D8, D11)
; легко прочитати як «усе виконуване» — хоча про них НЕВІДОМО.
;
; Інваріант:
;   1) виконувані ⊆ каталог (допуск не виходить за ратифіковану таблицю);
;   2) НЕЗАМАПЛЕНИЙ щабель НЕ є повністю виконуваним — про нього невідомо.
;
; Чистий контракт: без I/O, без стану.

(визначити виконувані-підмножина?
  (функція (каталог виконувані)
    (за-умовою
      ((порожній? виконувані) так)
      ((належить? (перший виконувані) каталог)
       (виконувані-підмножина? каталог (решта виконувані)))
      (так ні))))

(визначити незамаплений-є-виконуваним?
  (функція (замаплено?)
    ; Завжди НІ: брак джерела допуску не доводить виконуваності.
    ні))

(визначити належить?
  (функція (елемент множина)
    (за-умовою
      ((порожній? множина) ні)
      ((тотожне? елемент (перший множина)) так)
      (так (належить? елемент (решта множина))))))

(визначити перший (функція (м) (голова м)))
(визначити решта (функція (м) (хвіст м)))
(визначити порожній? (функція (м) (тотожне? м (як-є ()))))
(визначити ні хибно)

; Незалежний контроль: справжня підмножина проходить, чужа координата — ні,
; і незамаплений щабель НІКОЛИ не є виконуваним.
(виконувані-підмножина? (як-є (1 2 3)) (як-є (1 2)))
(виконувані-підмножина? (як-є (1 2 3)) (як-є (1 4)))
(незамаплений-є-виконуваним? так)
