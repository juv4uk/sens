; Перший repo-owned guard для майбутнього повністю українського source.
; Сам guard написано через українську Canon surface і має розширення .lisp.
;
; Тимчасові bootstrap-винятки нижче потрібні лише тому, що host/core helpers
; `read-file`, `read-all`, `print`, `member?`, `equal?`, `string?`, `length`,
; `list` ще не всі мають Canon-owned українські IDs. Вся логіка після цього
; працює українськими повними назвами. Після #75/#77 ці містки треба прибрати,
; а не перетворити на постійний англомовний fallback.

(визначити прочитати-файл
  (функція (шлях)
    (read-file шлях)))
(визначити прочитати-усе read-all)
(визначити надрукувати print)
(визначити значення-у-списку? member?)
(визначити однакові? equal?)
(визначити текст? string?)
(визначити довжина length)
(визначити список list)

(визначити друге-значення
  (функція (значення)
    (перше (решта значення))))

(визначити третє-значення
  (функція (значення)
    (перше (решта (решта значення)))))

(визначити четверте-значення
  (функція (значення)
    (перше (решта (решта (решта значення))))))

(визначити знайти-секцію
  (функція (ім'я секції)
    (за-умовою
      ((атом? секції) ())
      ((тотожне? (перше (перше секції)) ім'я)
       (перше секції))
      (t
       (знайти-секцію ім'я (решта секції))))))

(визначити ідентичності-з-реєстру
  (функція (рядки)
    (за-умовою
      ((атом? рядки) ())
      (t
       (сполучити
         (перше (перше рядки))
         (ідентичності-з-реєстру (решта рядки)))))))

(визначити ідентичності-з-профілю
  (функція (рядки)
    (за-умовою
      ((атом? рядки) ())
      (t
       (сполучити
         (перше (перше рядки))
         (ідентичності-з-профілю (решта рядки)))))))

(визначити бажані-назви
  (функція (рядки)
    (за-умовою
      ((атом? рядки) ())
      ((тотожне? (третє-значення (перше рядки)) (як-є —))
       (бажані-назви (решта рядки)))
      (t
       (сполучити
         (третє-значення (перше рядки))
         (бажані-назви (решта рядки)))))))

(визначити знайти-рядок-назви
  (функція (semantic-id рядки)
    (за-умовою
      ((атом? рядки) ())
      ((однакові? (перше (перше рядки)) semantic-id)
       (перше рядки))
      (t
       (знайти-рядок-назви semantic-id (решта рядки))))))

; Alias row schema: (аліас SOURCE-ID TARGET-ID).
; SOURCE залишається окремим inventory row, але його full-UK candidate
; свідомо належить тому самому значенню, що й canonical TARGET.
(визначити знайти-аліас
  (функція (semantic-id рядки-аліасів)
    (за-умовою
      ((атом? рядки-аліасів) ())
      ((однакові? (друге-значення (перше рядки-аліасів)) semantic-id)
       (перше рядки-аліасів))
      (t
       (знайти-аліас semantic-id (решта рядки-аліасів))))))

(визначити джерела-аліасів
  (функція (рядки-аліасів)
    (за-умовою
      ((атом? рядки-аліасів) ())
      (t
       (сполучити
         (друге-значення (перше рядки-аліасів))
         (джерела-аліасів (решта рядки-аліасів)))))))

; Для перевірки унікальності враховуємо лише canonical owners. Alias-row
; навмисно може повторювати повну назву свого target і не є другим власником.
(визначити канонічні-бажані-назви
  (функція (рядки рядки-аліасів)
    (за-умовою
      ((атом? рядки) ())
      ((тотожне? (третє-значення (перше рядки)) (як-є —))
       (канонічні-бажані-назви (решта рядки) рядки-аліасів))
      ((атом? (знайти-аліас (перше (перше рядки)) рядки-аліасів))
       (сполучити
         (третє-значення (перше рядки))
         (канонічні-бажані-назви (решта рядки) рядки-аліасів)))
      (t
       (канонічні-бажані-назви (решта рядки) рядки-аліасів)))))

(визначити є-дубль?
  (функція (значення)
    (за-умовою
      ((атом? значення) ())
      ((значення-у-списку? (перше значення) (решта значення)) t)
      (t (є-дубль? (решта значення))))))

(визначити зупинити-з-помилкою
  (функція (код значення)
    ; Перше обчислення друкує machine-readable причину, друге навмисно
    ; породжує помилку, щоб CLI/CI отримав ненульовий exit status.
    (сполучити
      (надрукувати (список (як-є помилка-українського-профілю) код значення))
      (перше ()))))

(визначити дозволені-стани
  (як-є (чинна
         кандидат-власника
         кандидат-повної-назви
         потребує-огляду
         кандидат-сумісності
         кандидат-нової-stable-назви)))

(визначити перевірити-рядок
  (функція (рядок реєстрові-ідентичності)
    (за-умовою
      ((значення-у-списку? (перше рядок) реєстрові-ідентичності)
       (за-умовою
         ((значення-у-списку? (четверте-значення рядок) дозволені-стани)
          (за-умовою
            ((тотожне? (четверте-значення рядок) (як-є чинна))
             (за-умовою
               ((однакові? (друге-значення рядок) (третє-значення рядок)) t)
               (t (зупинити-з-помилкою (як-є чинна-назва-не-збігається) рядок))))
            ((тотожне? (четверте-значення рядок) (як-є потребує-огляду))
             (за-умовою
               ((тотожне? (третє-значення рядок) (як-є —)) t)
               (t (зупинити-з-помилкою (як-є огляд-має-не-вгадувати-назву) рядок))))
            ((текст? (третє-значення рядок)) t)
            (t (зупинити-з-помилкою (як-є кандидат-потребує-текстової-назви) рядок))))
         (t (зупинити-з-помилкою (як-є невідомий-стан) рядок))))
      (t (зупинити-з-помилкою (як-є невідомий-semantic-id) рядок)))))

(визначити перевірити-рядки
  (функція (рядки реєстрові-ідентичності)
    (за-умовою
      ((атом? рядки) t)
      (t
       (сполучити
         (перевірити-рядок (перше рядки) реєстрові-ідентичності)
         (перевірити-рядки (решта рядки) реєстрові-ідентичності))))))

(визначити перевірити-аліас
  (функція (аліасний-рядок рядки-назв профільні-ідентичності рядки-аліасів)
    (за-умовою
      ((тотожне? (довжина аліасний-рядок) 3)
       (за-умовою
         ((тотожне? (перше аліасний-рядок) (як-є аліас))
          (за-умовою
            ((значення-у-списку? (друге-значення аліасний-рядок) профільні-ідентичності)
             (за-умовою
               ((значення-у-списку? (третє-значення аліасний-рядок) профільні-ідентичності)
                (за-умовою
                  ((однакові? (друге-значення аліасний-рядок) (третє-значення аліасний-рядок))
                   (зупинити-з-помилкою (як-є аліас-на-себе) аліасний-рядок))
                  ((атом? (знайти-аліас (третє-значення аліасний-рядок) рядки-аліасів))
                   (за-умовою
                     ((тотожне?
                        (третє-значення
                          (знайти-рядок-назви (друге-значення аліасний-рядок) рядки-назв))
                        (як-є —))
                      (зупинити-з-помилкою (як-є аліас-без-повної-назви) аліасний-рядок))
                     ((однакові?
                        (третє-значення
                          (знайти-рядок-назви (друге-значення аліасний-рядок) рядки-назв))
                        (третє-значення
                          (знайти-рядок-назви (третє-значення аліасний-рядок) рядки-назв)))
                      t)
                     (t
                      (зупинити-з-помилкою
                        (як-є аліас-має-іншу-повну-назву)
                        аліасний-рядок))))
                  (t
                   (зупинити-з-помилкою
                     (як-є ланцюжок-аліасів-заборонено)
                     аліасний-рядок))))
               (t
                (зупинити-з-помилкою
                  (як-є невідома-ціль-аліаса)
                  аліасний-рядок))))
            (t
             (зупинити-з-помилкою
               (як-є невідоме-джерело-аліаса)
               аліасний-рядок))))
         (t
          (зупинити-з-помилкою (як-є невідомий-тип-аліаса) аліасний-рядок))))
      (t
       (зупинити-з-помилкою (як-є неправильна-форма-аліаса) аліасний-рядок)))))

(визначити перевірити-аліаси
  (функція (рядки-аліасів рядки-назв профільні-ідентичності всі-аліаси)
    (за-умовою
      ((атом? рядки-аліасів) t)
      (t
       (сполучити
         (перевірити-аліас
           (перше рядки-аліасів)
           рядки-назв
           профільні-ідентичності
           всі-аліаси)
         (перевірити-аліаси
           (решта рядки-аліасів)
           рядки-назв
           профільні-ідентичності
           всі-аліаси))))))

(визначити реєстр
  (перше
    (прочитати-усе
      (прочитати-файл "lib/surface/semantic-registry.lisp"))))

(визначити профіль
  (перше
    (прочитати-усе
      (прочитати-файл "lib/surface/український-профіль-джерела.lisp"))))

(за-умовою
  ((тотожне? (перше реєстр) (як-є sr/2)) t)
  (t (зупинити-з-помилкою (як-є невідома-схема-реєстру) (перше реєстр))))

(за-умовою
  ((тотожне? (перше профіль) (як-є український-профіль-джерела/1)) t)
  (t (зупинити-з-помилкою (як-є невідома-схема-профілю) (перше профіль))))

(визначити секція-назв
  (знайти-секцію (як-є назви) (решта профіль)))

(визначити секція-аліасів
  (знайти-секцію (як-є аліаси-повних-назв) (решта профіль)))

(за-умовою
  ((атом? секція-назв)
   (зупинити-з-помилкою (як-є відсутня-секція-назв) профіль))
  (t t))

(за-умовою
  ((атом? секція-аліасів)
   (зупинити-з-помилкою (як-є відсутня-секція-аліасів-повних-назв) профіль))
  (t t))

(визначити рядки-назв (решта секція-назв))
(визначити рядки-аліасів (решта секція-аліасів))
(визначити реєстрові-ідентичності (ідентичності-з-реєстру (решта реєстр)))
(визначити профільні-ідентичності (ідентичності-з-профілю рядки-назв))
(визначити профільні-бажані-назви (бажані-назви рядки-назв))
(визначити профільні-канонічні-бажані-назви
  (канонічні-бажані-назви рядки-назв рядки-аліасів))
(визначити профільні-джерела-аліасів (джерела-аліасів рядки-аліасів))

(перевірити-рядки рядки-назв реєстрові-ідентичності)
(перевірити-аліаси
  рядки-аліасів
  рядки-назв
  профільні-ідентичності
  рядки-аліасів)

(за-умовою
  ((є-дубль? профільні-ідентичності)
   (зупинити-з-помилкою (як-є дубль-semantic-id) профільні-ідентичності))
  (t t))

(за-умовою
  ((є-дубль? профільні-джерела-аліасів)
   (зупинити-з-помилкою (як-є дубль-джерела-аліаса) профільні-джерела-аліасів))
  (t t))

(за-умовою
  ((є-дубль? профільні-канонічні-бажані-назви)
   (зупинити-з-помилкою
     (як-є дубль-канонічної-бажаної-назви)
     профільні-канонічні-бажані-назви))
  (t t))

(надрукувати
  (список
    (як-є український-профіль-джерела)
    (як-є гаразд)
    (список (як-є рядків) (довжина рядки-назв))
    (список (як-є semantic-id-перевірено) (довжина профільні-ідентичності))
    (список (як-є бажаних-назв) (довжина профільні-бажані-назви))
    (список (як-є аліасів-повних-назв) (довжина рядки-аліасів))))

(як-є ())