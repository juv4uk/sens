; Перший repo-owned guard для майбутнього повністю українського source.
; Сам guard написано через українську Canon surface і має розширення .lisp.
;
; Тимчасові bootstrap-винятки нижче потрібні лише тому, що host/core helpers
; `read-file`, `read-all`, `print`, `member?`, `equal?`, `string?`, `length`,
; `list` ще не всі мають Canon-owned українські IDs. Вся логіка після цього
; працює українськими повними назвами. Після #75/#77 ці містки треба прибрати,
; а не перетворити на постійний англомовний fallback.

(0011 прочитати-файл
  (0010 (шлях)
    (110110111 шлях)))
(0011 прочитати-усе read-all)
(0011 надрукувати print)
(0011 значення-у-списку? member?)
(0011 однакові? equal?)
(0011 текст? string?)
(0011 довжина length)
(0011 список list)

(0011 друге-значення
  (0010 (значення)
    (100 (011 значення))))

(0011 третє-значення
  (0010 (значення)
    (100 (011 (011 значення)))))

(0011 четверте-значення
  (0010 (значення)
    (100 (011 (011 (011 значення))))))

(0011 знайти-секцію
  (0010 (ім'я секції)
    (110
      ((010 секції) ())
      ((101 (100 (100 секції)) ім'я)
       (100 секції))
      (1
       (знайти-секцію ім'я (011 секції))))))

(0011 ідентичності-з-реєстру
  (0010 (рядки)
    (110
      ((010 рядки) ())
      (1
       (111
         (100 (100 рядки))
         (ідентичності-з-реєстру (011 рядки)))))))

(0011 ідентичності-з-профілю
  (0010 (рядки)
    (110
      ((010 рядки) ())
      (1
       (111
         (100 (100 рядки))
         (ідентичності-з-профілю (011 рядки)))))))

(0011 бажані-назви
  (0010 (рядки)
    (110
      ((010 рядки) ())
      ((101 (третє-значення (100 рядки)) (001 —))
       (бажані-назви (011 рядки)))
      (1
       (111
         (третє-значення (100 рядки))
         (бажані-назви (011 рядки)))))))

(0011 знайти-рядок-назви
  (0010 (semantic-id рядки)
    (110
      ((010 рядки) ())
      ((однакові? (100 (100 рядки)) semantic-id)
       (100 рядки))
      (1
       (знайти-рядок-назви semantic-id (011 рядки))))))

; Alias row schema: (аліас SOURCE-ID TARGET-ID).
; SOURCE залишається окремим inventory row, але його full-UK candidate
; свідомо належить тому самому значенню, що й canonical TARGET.
(0011 знайти-аліас
  (0010 (semantic-id рядки-аліасів)
    (110
      ((010 рядки-аліасів) ())
      ((однакові? (друге-значення (100 рядки-аліасів)) semantic-id)
       (100 рядки-аліасів))
      (1
       (знайти-аліас semantic-id (011 рядки-аліасів))))))

(0011 джерела-аліасів
  (0010 (рядки-аліасів)
    (110
      ((010 рядки-аліасів) ())
      (1
       (111
         (друге-значення (100 рядки-аліасів))
         (джерела-аліасів (011 рядки-аліасів)))))))

; Для перевірки унікальності враховуємо лише canonical owners. Alias-row
; навмисно може повторювати повну назву свого target і не є другим власником.
(0011 канонічні-бажані-назви
  (0010 (рядки рядки-аліасів)
    (110
      ((010 рядки) ())
      ((101 (третє-значення (100 рядки)) (001 —))
       (канонічні-бажані-назви (011 рядки) рядки-аліасів))
      ((010 (знайти-аліас (100 (100 рядки)) рядки-аліасів))
       (111
         (третє-значення (100 рядки))
         (канонічні-бажані-назви (011 рядки) рядки-аліасів)))
      (1
       (канонічні-бажані-назви (011 рядки) рядки-аліасів)))))

(0011 є-дубль?
  (0010 (значення)
    (110
      ((010 значення) ())
      ((значення-у-списку? (100 значення) (011 значення)) t)
      (1 (є-дубль? (011 значення))))))

(0011 зупинити-з-помилкою
  (0010 (код значення)
    ; Перше обчислення друкує machine-readable причину, друге навмисно
    ; породжує помилку, щоб CLI/CI отримав ненульовий exit status.
    (111
      (надрукувати (список (001 помилка-українського-профілю) код значення))
      (100 ()))))

(0011 дозволені-стани
  (001 (чинна
         кандидат-власника
         кандидат-повної-назви
         потребує-огляду
         кандидат-сумісності
         кандидат-нової-stable-назви)))

(0011 перевірити-рядок
  (0010 (рядок реєстрові-ідентичності)
    (110
      ((значення-у-списку? (100 рядок) реєстрові-ідентичності)
       (110
         ((значення-у-списку? (четверте-значення рядок) дозволені-стани)
          (110
            ((101 (четверте-значення рядок) (001 чинна))
             (110
               ((однакові? (друге-значення рядок) (третє-значення рядок)) t)
               (1 (зупинити-з-помилкою (001 чинна-назва-не-збігається) рядок))))
            ((101 (четверте-значення рядок) (001 потребує-огляду))
             (110
               ((101 (третє-значення рядок) (001 —)) t)
               (1 (зупинити-з-помилкою (001 огляд-має-не-вгадувати-назву) рядок))))
            ((текст? (третє-значення рядок)) t)
            (1 (зупинити-з-помилкою (001 кандидат-потребує-текстової-назви) рядок))))
         (1 (зупинити-з-помилкою (001 невідомий-стан) рядок))))
      (1 (зупинити-з-помилкою (001 невідомий-semantic-id) рядок)))))

(0011 перевірити-рядки
  (0010 (рядки реєстрові-ідентичності)
    (110
      ((010 рядки) t)
      (1
       (111
         (перевірити-рядок (100 рядки) реєстрові-ідентичності)
         (перевірити-рядки (011 рядки) реєстрові-ідентичності))))))

(0011 перевірити-аліас
  (0010 (аліасний-рядок рядки-назв профільні-ідентичності рядки-аліасів)
    (110
      ((101 (довжина аліасний-рядок) 3)
       (110
         ((101 (100 аліасний-рядок) (001 аліас))
          (110
            ((значення-у-списку? (друге-значення аліасний-рядок) профільні-ідентичності)
             (110
               ((значення-у-списку? (третє-значення аліасний-рядок) профільні-ідентичності)
                (110
                  ((однакові? (друге-значення аліасний-рядок) (третє-значення аліасний-рядок))
                   (зупинити-з-помилкою (001 аліас-на-себе) аліасний-рядок))
                  ((010 (знайти-аліас (третє-значення аліасний-рядок) рядки-аліасів))
                   (110
                     ((101
                        (третє-значення
                          (знайти-рядок-назви (друге-значення аліасний-рядок) рядки-назв))
                        (001 —))
                      (зупинити-з-помилкою (001 аліас-без-повної-назви) аліасний-рядок))
                     ((однакові?
                        (третє-значення
                          (знайти-рядок-назви (друге-значення аліасний-рядок) рядки-назв))
                        (третє-значення
                          (знайти-рядок-назви (третє-значення аліасний-рядок) рядки-назв)))
                      t)
                     (1
                      (зупинити-з-помилкою
                        (001 аліас-має-іншу-повну-назву)
                        аліасний-рядок))))
                  (1
                   (зупинити-з-помилкою
                     (001 ланцюжок-аліасів-заборонено)
                     аліасний-рядок))))
               (1
                (зупинити-з-помилкою
                  (001 невідома-ціль-аліаса)
                  аліасний-рядок))))
            (1
             (зупинити-з-помилкою
               (001 невідоме-джерело-аліаса)
               аліасний-рядок))))
         (1
          (зупинити-з-помилкою (001 невідомий-тип-аліаса) аліасний-рядок))))
      (1
       (зупинити-з-помилкою (001 неправильна-форма-аліаса) аліасний-рядок)))))

(0011 перевірити-аліаси
  (0010 (рядки-аліасів рядки-назв профільні-ідентичності всі-аліаси)
    (110
      ((010 рядки-аліасів) t)
      (1
       (111
         (перевірити-аліас
           (100 рядки-аліасів)
           рядки-назв
           профільні-ідентичності
           всі-аліаси)
         (перевірити-аліаси
           (011 рядки-аліасів)
           рядки-назв
           профільні-ідентичності
           всі-аліаси))))))

(0011 реєстр
  (100
    (прочитати-усе
      (прочитати-файл "lib/surface/semantic-registry.lisp"))))

(0011 профіль
  (100
    (прочитати-усе
      (прочитати-файл "lib/surface/український-профіль-джерела.lisp"))))

(110
  ((101 (100 профіль) (001 український-профіль-джерела/1)) t)
  (1 (зупинити-з-помилкою (001 невідома-схема-профілю) (100 профіль))))

(0011 секція-назв
  (знайти-секцію (001 назви) (011 профіль)))

(0011 секція-аліасів
  (знайти-секцію (001 аліаси-повних-назв) (011 профіль)))

(110
  ((010 секція-назв)
   (зупинити-з-помилкою (001 відсутня-секція-назв) профіль))
  (1 t))

(110
  ((010 секція-аліасів)
   (зупинити-з-помилкою (001 відсутня-секція-аліасів-повних-назв) профіль))
  (1 t))

(0011 рядки-назв (011 секція-назв))
(0011 рядки-аліасів (011 секція-аліасів))
(0011 реєстрові-ідентичності (ідентичності-з-реєстру (011 реєстр)))
(0011 профільні-ідентичності (ідентичності-з-профілю рядки-назв))
(0011 профільні-бажані-назви (бажані-назви рядки-назв))
(0011 профільні-канонічні-бажані-назви
  (канонічні-бажані-назви рядки-назв рядки-аліасів))
(0011 профільні-джерела-аліасів (джерела-аліасів рядки-аліасів))

(перевірити-рядки рядки-назв реєстрові-ідентичності)
(перевірити-аліаси
  рядки-аліасів
  рядки-назв
  профільні-ідентичності
  рядки-аліасів)

(110
  ((є-дубль? профільні-ідентичності)
   (зупинити-з-помилкою (001 дубль-semantic-id) профільні-ідентичності))
  (1 t))

(110
  ((є-дубль? профільні-джерела-аліасів)
   (зупинити-з-помилкою (001 дубль-джерела-аліаса) профільні-джерела-аліасів))
  (1 t))

(110
  ((є-дубль? профільні-канонічні-бажані-назви)
   (зупинити-з-помилкою
     (001 дубль-канонічної-бажаної-назви)
     профільні-канонічні-бажані-назви))
  (1 t))

(надрукувати
  (список
    (001 український-профіль-джерела)
    (001 гаразд)
    (список (001 рядків) (довжина рядки-назв))
    (список (001 semantic-id-перевірено) (довжина профільні-ідентичності))
    (список (001 бажаних-назв) (довжина профільні-бажані-назви))
    (список (001 аліасів-повних-назв) (довжина рядки-аліасів))))

(001 ())