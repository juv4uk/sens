; Перший repo-owned guard для майбутнього повністю українського source.
; Сам guard написано через українську Canon surface і має розширення .lisp.
; Позиційні селектори Д4–Д6 викликаються напряму, без дубльованих
; визначень «друге-значення», «третє-значення», «четверте-значення».
;
; Виклики читання, друку, структурної рівності, рядків, довжини
; та побудови списків спираються на чинні українські назви Д4–Д9.
; Повторні визначення старих латинських функцій вилучено:
; цей файл не створює іншої семантичної тотожності.

(визначити знайти-секцію
  (функція (ім'я секції)
    (за-умовою
      ((атом? секції) ())
      ((тотожне? (перше (перше секції)) ім'я)
       (перше секції))
      (1
       (знайти-секцію ім'я (решта секції))))))

(визначити ідентичності-з-реєстру
  (функція (рядки)
    (за-умовою
      ((атом? рядки) ())
      (1
       (сполучити
         (перше (перше рядки))
         (ідентичності-з-реєстру (решта рядки)))))))

(визначити ідентичності-з-профілю
  (функція (рядки)
    (за-умовою
      ((атом? рядки) ())
      (1
       (сполучити
         (перше (перше рядки))
         (ідентичності-з-профілю (решта рядки)))))))

(визначити бажані-назви
  (функція (рядки)
    (за-умовою
      ((атом? рядки) ())
      ((тотожне? (третє (перше рядки)) (як-є —))
       (бажані-назви (решта рядки)))
      (1
       (сполучити
         (третє (перше рядки))
         (бажані-назви (решта рядки)))))))

(визначити знайти-рядок-назви
  (функція (семантичний-ід рядки)
    (за-умовою
      ((атом? рядки) ())
      ((однакові? (перше (перше рядки)) семантичний-ід)
       (перше рядки))
      (1
       (знайти-рядок-назви семантичний-ід (решта рядки))))))

; Alias row schema: (аліас SOURCE-ID TARGET-ID).
; SOURCE залишається окремим inventory row, але його full-UK candidate
; свідомо належить тому самому значенню, що й canonical TARGET.
(визначити знайти-аліас
  (функція (семантичний-ід рядки-аліасів)
    (за-умовою
      ((атом? рядки-аліасів) ())
      ((однакові? (друге (перше рядки-аліасів)) семантичний-ід)
       (перше рядки-аліасів))
      (1
       (знайти-аліас семантичний-ід (решта рядки-аліасів))))))

(визначити джерела-аліасів
  (функція (рядки-аліасів)
    (за-умовою
      ((атом? рядки-аліасів) ())
      (1
       (сполучити
         (друге (перше рядки-аліасів))
         (джерела-аліасів (решта рядки-аліасів)))))))

; Для перевірки унікальності враховуємо лише canonical owners. Alias-row
; навмисно може повторювати повну назву свого target і не є другим власником.
(визначити канонічні-бажані-назви
  (функція (рядки рядки-аліасів)
    (за-умовою
      ((атом? рядки) ())
      ((тотожне? (третє (перше рядки)) (як-є —))
       (канонічні-бажані-назви (решта рядки) рядки-аліасів))
      ((атом? (знайти-аліас (перше (перше рядки)) рядки-аліасів))
       (сполучити
         (третє (перше рядки))
         (канонічні-бажані-назви (решта рядки) рядки-аліасів)))
      (1
       (канонічні-бажані-назви (решта рядки) рядки-аліасів)))))

(визначити є-дубль?
  (функція (значення)
    (за-умовою
      ((атом? значення) ())
      ((значення-у-списку? (перше значення) (решта значення)) так)
      (так (є-дубль? (решта значення))))))

(визначити зупинити-з-помилкою
  (функція (код значення)
    ; Перше обчислення друкує machine-readable причину, друге навмисно
    ; породжує помилку, щоб CLI/CI отримав ненульовий exit status.
    (сполучити
      (друкувати (список (як-є помилка-українського-профілю) код значення))
      (перше ()))))

(визначити дозволені-стани
  (як-є (чинна
         кандидат-власника
         кандидат-повної-назви
         потребує-огляду
         кандидат-сумісності
         кандидат-нової-stable-назви)))

(визначити перевірити-рядок
  (функція (рядок реєстрові-ідентичності)
    (за-умовою
      ((значення-у-списку? (перше рядок) реєстрові-ідентичності)
       (за-умовою
         ((значення-у-списку? (четверте рядок) дозволені-стани)
          (за-умовою
            ((тотожне? (четверте рядок) (як-є чинна))
             (за-умовою
               ((однакові? (друге рядок) (третє рядок)) так)
               (так (зупинити-з-помилкою (як-є чинна-назва-не-збігається) рядок))))
            ((тотожне? (четверте рядок) (як-є потребує-огляду))
             (за-умовою
               ((тотожне? (третє рядок) (як-є —)) так)
               (так (зупинити-з-помилкою (як-є огляд-має-не-вгадувати-назву) рядок))))
            ((рядок? (третє рядок)) так)
            (так (зупинити-з-помилкою (як-є кандидат-потребує-текстової-назви) рядок))))
         (так (зупинити-з-помилкою (як-є невідомий-стан) рядок))))
      (так (зупинити-з-помилкою (як-є невідомий-semantic-id) рядок)))))

(визначити перевірити-рядки
  (функція (рядки реєстрові-ідентичності)
    (за-умовою
      ((атом? рядки) так)
      (1
       (сполучити
         (перевірити-рядок (перше рядки) реєстрові-ідентичності)
         (перевірити-рядки (решта рядки) реєстрові-ідентичності))))))

(визначити перевірити-аліас
  (функція (аліасний-рядок рядки-назв профільні-ідентичності рядки-аліасів)
    (за-умовою
      ((тотожне? (довжина аліасний-рядок) 3)
       (за-умовою
         ((тотожне? (перше аліасний-рядок) (як-є аліас))
          (за-умовою
            ((значення-у-списку? (друге аліасний-рядок) профільні-ідентичності)
             (за-умовою
               ((значення-у-списку? (третє аліасний-рядок) профільні-ідентичності)
                (за-умовою
                  ((однакові? (друге аліасний-рядок) (третє аліасний-рядок))
                   (зупинити-з-помилкою (як-є аліас-на-себе) аліасний-рядок))
                  ((атом? (знайти-аліас (третє аліасний-рядок) рядки-аліасів))
                   (за-умовою
                     ((тотожне?
                        (третє
                          (знайти-рядок-назви (друге аліасний-рядок) рядки-назв))
                        (як-є —))
                      (зупинити-з-помилкою (як-є аліас-без-повної-назви) аліасний-рядок))
                     ((однакові?
                        (третє
                          (знайти-рядок-назви (друге аліасний-рядок) рядки-назв))
                        (третє
                          (знайти-рядок-назви (третє аліасний-рядок) рядки-назв)))
                      так)
                     (1
                      (зупинити-з-помилкою
                        (як-є аліас-має-іншу-повну-назву)
                        аліасний-рядок))))
                  (1
                   (зупинити-з-помилкою
                     (як-є ланцюжок-аліасів-заборонено)
                     аліасний-рядок))))
               (1
                (зупинити-з-помилкою
                  (як-є невідома-ціль-аліаса)
                  аліасний-рядок))))
            (1
             (зупинити-з-помилкою
               (як-є невідоме-джерело-аліаса)
               аліасний-рядок))))
         (1
          (зупинити-з-помилкою (як-є невідомий-тип-аліаса) аліасний-рядок))))
      (1
       (зупинити-з-помилкою (як-є неправильна-форма-аліаса) аліасний-рядок)))))

(визначити перевірити-аліаси
  (функція (рядки-аліасів рядки-назв профільні-ідентичності всі-аліаси)
    (за-умовою
      ((атом? рядки-аліасів) так)
      (1
       (сполучити
         (перевірити-аліас
           (перше рядки-аліасів)
           рядки-назв
           профільні-ідентичності
           всі-аліаси)
         (перевірити-аліаси
           (решта рядки-аліасів)
           рядки-назв
           профільні-ідентичності
           всі-аліаси))))))

(визначити реєстр
  (перше
    (читати-всі
      (читати-файл "lib/surface/semantic-registry.lisp"))))

(визначити профіль
  (перше
    (читати-всі
      (читати-файл "lib/surface/український-профіль-джерела.lisp"))))

(за-умовою
  ((тотожне? (перше профіль) (як-є український-профіль-джерела/1)) так)
  (так (зупинити-з-помилкою (як-є невідома-схема-профілю) (перше профіль))))

(визначити секція-назв
  (знайти-секцію (як-є назви) (решта профіль)))

(визначити секція-аліасів
  (знайти-секцію (як-є аліаси-повних-назв) (решта профіль)))

(за-умовою
  ((атом? секція-назв)
   (зупинити-з-помилкою (як-є відсутня-секція-назв) профіль))
  (так так))

(за-умовою
  ((атом? секція-аліасів)
   (зупинити-з-помилкою (як-є відсутня-секція-аліасів-повних-назв) профіль))
  (так так))

(визначити рядки-назв (решта секція-назв))
(визначити рядки-аліасів (решта секція-аліасів))
(визначити реєстрові-ідентичності (ідентичності-з-реєстру (решта реєстр)))
(визначити профільні-ідентичності (ідентичності-з-профілю рядки-назв))
(визначити профільні-бажані-назви (бажані-назви рядки-назв))
(визначити профільні-канонічні-бажані-назви
  (канонічні-бажані-назви рядки-назв рядки-аліасів))
(визначити профільні-джерела-аліасів (джерела-аліасів рядки-аліасів))

(перевірити-рядки рядки-назв реєстрові-ідентичності)
(перевірити-аліаси
  рядки-аліасів
  рядки-назв
  профільні-ідентичності
  рядки-аліасів)

(за-умовою
  ((є-дубль? профільні-ідентичності)
   (зупинити-з-помилкою (як-є дубль-semantic-id) профільні-ідентичності))
  (так так))

(за-умовою
  ((є-дубль? профільні-джерела-аліасів)
   (зупинити-з-помилкою (як-є дубль-джерела-аліаса) профільні-джерела-аліасів))
  (так так))

(за-умовою
  ((є-дубль? профільні-канонічні-бажані-назви)
   (зупинити-з-помилкою
     (як-є дубль-канонічної-бажаної-назви)
     профільні-канонічні-бажані-назви))
  (так так))

(друкувати
  (список
    (як-є український-профіль-джерела)
    (як-є гаразд)
    (список (як-є рядків) (довжина рядки-назв))
    (список (як-є semantic-id-перевірено) (довжина профільні-ідентичності))
    (список (як-є бажаних-назв) (довжина профільні-бажані-назви))
    (список (як-є аліасів-повних-назв) (довжина рядки-аліасів))))

(як-є ())
