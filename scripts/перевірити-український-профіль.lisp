; Перший repo-owned guard для майбутнього повністю українського source.
; Сам guard написано через українську Canon surface і має розширення .lisp.
;
; Тимчасові bootstrap-винятки нижче потрібні лише тому, що host/core helpers
; `read-file`, `read-all`, `print`, `member?`, `equal?`, `string?`, `length`,
; `list` ще не всі мають Canon-owned українські IDs. Вся логіка після цього
; працює українськими повними назвами. Після #75/#77 ці містки треба прибрати,
; а не перетворити на постійний англомовний fallback.

(00001001 прочитати-файл
  (00001000 (шлях)
    (10100110 шлях)))
(00001001 прочитати-усе read-all)
(00001001 надрукувати print)
(00001001 значення-у-списку? member?)
(00001001 однакові? equal?)
(00001001 текст? string?)
(00001001 довжина length)
(00001001 список list)

(00001001 друге-значення
  (00001000 (значення)
    (00000101 (00000110 значення))))

(00001001 третє-значення
  (00001000 (значення)
    (00000101 (00000110 (00000110 значення)))))

(00001001 четверте-значення
  (00001000 (значення)
    (00000101 (00000110 (00000110 (00000110 значення))))))

(00001001 знайти-секцію
  (00001000 (ім'я секції)
    (00000111
      ((00000010 секції) ())
      ((00000011 (00000101 (00000101 секції)) ім'я)
       (00000101 секції))
      (t
       (знайти-секцію ім'я (00000110 секції))))))

(00001001 ідентичності-з-реєстру
  (00001000 (рядки)
    (00000111
      ((00000010 рядки) ())
      (t
       (00000100
         (00000101 (00000101 рядки))
         (ідентичності-з-реєстру (00000110 рядки)))))))

(00001001 ідентичності-з-профілю
  (00001000 (рядки)
    (00000111
      ((00000010 рядки) ())
      (t
       (00000100
         (00000101 (00000101 рядки))
         (ідентичності-з-профілю (00000110 рядки)))))))

(00001001 бажані-назви
  (00001000 (рядки)
    (00000111
      ((00000010 рядки) ())
      ((00000011 (третє-значення (00000101 рядки)) (00000001 —))
       (бажані-назви (00000110 рядки)))
      (t
       (00000100
         (третє-значення (00000101 рядки))
         (бажані-назви (00000110 рядки)))))))

(00001001 знайти-рядок-назви
  (00001000 (semantic-id рядки)
    (00000111
      ((00000010 рядки) ())
      ((однакові? (00000101 (00000101 рядки)) semantic-id)
       (00000101 рядки))
      (t
       (знайти-рядок-назви semantic-id (00000110 рядки))))))

; Alias row schema: (аліас SOURCE-ID TARGET-ID).
; SOURCE залишається окремим inventory row, але його full-UK candidate
; свідомо належить тому самому значенню, що й canonical TARGET.
(00001001 знайти-аліас
  (00001000 (semantic-id рядки-аліасів)
    (00000111
      ((00000010 рядки-аліасів) ())
      ((однакові? (друге-значення (00000101 рядки-аліасів)) semantic-id)
       (00000101 рядки-аліасів))
      (t
       (знайти-аліас semantic-id (00000110 рядки-аліасів))))))

(00001001 джерела-аліасів
  (00001000 (рядки-аліасів)
    (00000111
      ((00000010 рядки-аліасів) ())
      (t
       (00000100
         (друге-значення (00000101 рядки-аліасів))
         (джерела-аліасів (00000110 рядки-аліасів)))))))

; Для перевірки унікальності враховуємо лише canonical owners. Alias-row
; навмисно може повторювати повну назву свого target і не є другим власником.
(00001001 канонічні-бажані-назви
  (00001000 (рядки рядки-аліасів)
    (00000111
      ((00000010 рядки) ())
      ((00000011 (третє-значення (00000101 рядки)) (00000001 —))
       (канонічні-бажані-назви (00000110 рядки) рядки-аліасів))
      ((00000010 (знайти-аліас (00000101 (00000101 рядки)) рядки-аліасів))
       (00000100
         (третє-значення (00000101 рядки))
         (канонічні-бажані-назви (00000110 рядки) рядки-аліасів)))
      (t
       (канонічні-бажані-назви (00000110 рядки) рядки-аліасів)))))

(00001001 є-дубль?
  (00001000 (значення)
    (00000111
      ((00000010 значення) ())
      ((значення-у-списку? (00000101 значення) (00000110 значення)) t)
      (t (є-дубль? (00000110 значення))))))

(00001001 зупинити-з-помилкою
  (00001000 (код значення)
    ; Перше обчислення друкує machine-readable причину, друге навмисно
    ; породжує помилку, щоб CLI/CI отримав ненульовий exit status.
    (00000100
      (надрукувати (список (00000001 помилка-українського-профілю) код значення))
      (00000101 ()))))

(00001001 дозволені-стани
  (00000001 (чинна
         кандидат-власника
         кандидат-повної-назви
         потребує-огляду
         кандидат-сумісності
         кандидат-нової-stable-назви)))

(00001001 перевірити-рядок
  (00001000 (рядок реєстрові-ідентичності)
    (00000111
      ((значення-у-списку? (00000101 рядок) реєстрові-ідентичності)
       (00000111
         ((значення-у-списку? (четверте-значення рядок) дозволені-стани)
          (00000111
            ((00000011 (четверте-значення рядок) (00000001 чинна))
             (00000111
               ((однакові? (друге-значення рядок) (третє-значення рядок)) t)
               (t (зупинити-з-помилкою (00000001 чинна-назва-не-збігається) рядок))))
            ((00000011 (четверте-значення рядок) (00000001 потребує-огляду))
             (00000111
               ((00000011 (третє-значення рядок) (00000001 —)) t)
               (t (зупинити-з-помилкою (00000001 огляд-має-не-вгадувати-назву) рядок))))
            ((текст? (третє-значення рядок)) t)
            (t (зупинити-з-помилкою (00000001 кандидат-потребує-текстової-назви) рядок))))
         (t (зупинити-з-помилкою (00000001 невідомий-стан) рядок))))
      (t (зупинити-з-помилкою (00000001 невідомий-semantic-id) рядок)))))

(00001001 перевірити-рядки
  (00001000 (рядки реєстрові-ідентичності)
    (00000111
      ((00000010 рядки) t)
      (t
       (00000100
         (перевірити-рядок (00000101 рядки) реєстрові-ідентичності)
         (перевірити-рядки (00000110 рядки) реєстрові-ідентичності))))))

(00001001 перевірити-аліас
  (00001000 (аліасний-рядок рядки-назв профільні-ідентичності рядки-аліасів)
    (00000111
      ((00000011 (довжина аліасний-рядок) 3)
       (00000111
         ((00000011 (00000101 аліасний-рядок) (00000001 аліас))
          (00000111
            ((значення-у-списку? (друге-значення аліасний-рядок) профільні-ідентичності)
             (00000111
               ((значення-у-списку? (третє-значення аліасний-рядок) профільні-ідентичності)
                (00000111
                  ((однакові? (друге-значення аліасний-рядок) (третє-значення аліасний-рядок))
                   (зупинити-з-помилкою (00000001 аліас-на-себе) аліасний-рядок))
                  ((00000010 (знайти-аліас (третє-значення аліасний-рядок) рядки-аліасів))
                   (00000111
                     ((00000011
                        (третє-значення
                          (знайти-рядок-назви (друге-значення аліасний-рядок) рядки-назв))
                        (00000001 —))
                      (зупинити-з-помилкою (00000001 аліас-без-повної-назви) аліасний-рядок))
                     ((однакові?
                        (третє-значення
                          (знайти-рядок-назви (друге-значення аліасний-рядок) рядки-назв))
                        (третє-значення
                          (знайти-рядок-назви (третє-значення аліасний-рядок) рядки-назв)))
                      t)
                     (t
                      (зупинити-з-помилкою
                        (00000001 аліас-має-іншу-повну-назву)
                        аліасний-рядок))))
                  (t
                   (зупинити-з-помилкою
                     (00000001 ланцюжок-аліасів-заборонено)
                     аліасний-рядок))))
               (t
                (зупинити-з-помилкою
                  (00000001 невідома-ціль-аліаса)
                  аліасний-рядок))))
            (t
             (зупинити-з-помилкою
               (00000001 невідоме-джерело-аліаса)
               аліасний-рядок))))
         (t
          (зупинити-з-помилкою (00000001 невідомий-тип-аліаса) аліасний-рядок))))
      (t
       (зупинити-з-помилкою (00000001 неправильна-форма-аліаса) аліасний-рядок)))))

(00001001 перевірити-аліаси
  (00001000 (рядки-аліасів рядки-назв профільні-ідентичності всі-аліаси)
    (00000111
      ((00000010 рядки-аліасів) t)
      (t
       (00000100
         (перевірити-аліас
           (00000101 рядки-аліасів)
           рядки-назв
           профільні-ідентичності
           всі-аліаси)
         (перевірити-аліаси
           (00000110 рядки-аліасів)
           рядки-назв
           профільні-ідентичності
           всі-аліаси))))))

(00001001 реєстр
  (00000101
    (прочитати-усе
      (прочитати-файл "lib/surface/semantic-registry.lisp"))))

(00001001 профіль
  (00000101
    (прочитати-усе
      (прочитати-файл "lib/surface/український-профіль-джерела.lisp"))))

(00000111
  ((00000011 (00000101 профіль) (00000001 український-профіль-джерела/1)) t)
  (t (зупинити-з-помилкою (00000001 невідома-схема-профілю) (00000101 профіль))))

(00001001 секція-назв
  (знайти-секцію (00000001 назви) (00000110 профіль)))

(00001001 секція-аліасів
  (знайти-секцію (00000001 аліаси-повних-назв) (00000110 профіль)))

(00000111
  ((00000010 секція-назв)
   (зупинити-з-помилкою (00000001 відсутня-секція-назв) профіль))
  (t t))

(00000111
  ((00000010 секція-аліасів)
   (зупинити-з-помилкою (00000001 відсутня-секція-аліасів-повних-назв) профіль))
  (t t))

(00001001 рядки-назв (00000110 секція-назв))
(00001001 рядки-аліасів (00000110 секція-аліасів))
(00001001 реєстрові-ідентичності (ідентичності-з-реєстру (00000110 реєстр)))
(00001001 профільні-ідентичності (ідентичності-з-профілю рядки-назв))
(00001001 профільні-бажані-назви (бажані-назви рядки-назв))
(00001001 профільні-канонічні-бажані-назви
  (канонічні-бажані-назви рядки-назв рядки-аліасів))
(00001001 профільні-джерела-аліасів (джерела-аліасів рядки-аліасів))

(перевірити-рядки рядки-назв реєстрові-ідентичності)
(перевірити-аліаси
  рядки-аліасів
  рядки-назв
  профільні-ідентичності
  рядки-аліасів)

(00000111
  ((є-дубль? профільні-ідентичності)
   (зупинити-з-помилкою (00000001 дубль-semantic-id) профільні-ідентичності))
  (t t))

(00000111
  ((є-дубль? профільні-джерела-аліасів)
   (зупинити-з-помилкою (00000001 дубль-джерела-аліаса) профільні-джерела-аліасів))
  (t t))

(00000111
  ((є-дубль? профільні-канонічні-бажані-назви)
   (зупинити-з-помилкою
     (00000001 дубль-канонічної-бажаної-назви)
     профільні-канонічні-бажані-назви))
  (t t))

(надрукувати
  (список
    (00000001 український-профіль-джерела)
    (00000001 гаразд)
    (список (00000001 рядків) (довжина рядки-назв))
    (список (00000001 semantic-id-перевірено) (довжина профільні-ідентичності))
    (список (00000001 бажаних-назв) (довжина профільні-бажані-назви))
    (список (00000001 аліасів-повних-назв) (довжина рядки-аліасів))))

(00000001 ())