; Чинна тримовна перевірка СЕНС за ратифікованою драбиною D1–D10.
; Первинний ключ — точна пара (домен, слово), не історичний SID8/Sens8.
; Повні «укр», en та san читаються безпосередньо з lib/domains/dN.lisp.
; Наявність назви не засвідчує допуск виклику, виконання або T5M roundtrip.
; D7 містить текстові координати, D2 — структурні; обидва не є callable.
; Це огляд поверхонь, не сертифікат готовності релізу.

(визначити джерела-тримовної-проєкції
  (як-є
    ((д1 "lib/domains/d1.lisp")
     (д2 "lib/domains/d2.lisp")
     (д3 "lib/domains/d3.lisp")
     (д4 "lib/domains/d4.lisp")
     (д5 "lib/domains/d5.lisp")
     (д6 "lib/domains/d6.lisp")
     (д7 "lib/domains/d7.lisp")
     (д8 "lib/domains/d8.lisp")
     (д9 "lib/domains/d9.lisp")
     (д10 "lib/domains/d10.lisp"))))

; Структуру domain-table-1 перевіряє сам СЕНС, а не сумісний W8-reader.
(визначити прочитати-тримовні-рядки-домену
  (функція (шлях)
    (нехай ((форма (перше (читати-всі (читати-файл шлях)))))
      (за-умовою
        ((тотожне? (перше форма) (як-є domain-table-1))
         (решта форма))
        ((атом? (як-є ()))
         (помилка-нечинної-таблиці-домену шлях))))))

; Не змішуємо бітові слова різних доменів. Рядок стає
; ((домен біти) (ук ...) (укр ...) (san ...) (en ...) ...).
(визначити позначити-тримовні-рядки
  (функція (домен рядки)
    (за-умовою
      ((порожній? рядки) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (сполучити
           (список домен (перше (перше рядки)))
           (решта (перше рядки)))
         (позначити-тримовні-рядки домен (решта рядки)))))))

(визначити зібрати-тримовні-рядки
  (функція (джерела)
    (за-умовою
      ((порожній? джерела) (як-є ()))
      ((атом? (як-є ()))
       (приєднати
         (позначити-тримовні-рядки
           (перше (перше джерела))
           (прочитати-тримовні-рядки-домену (друге (перше джерела))))
         (зібрати-тримовні-рядки (решта джерела)))))))

(визначити тримовні-рядки
  (зібрати-тримовні-рядки джерела-тримовної-проєкції))

; Поле () не є присутньою назвою; назви беруться лише з канону.
(визначити тримовна-назва-присутня?
  (функція (мова поля)
    (за-умовою
      ((порожній? поля) (хибне? (атом? (як-є ()))))
      ((тотожне? мова (перше (перше поля)))
       (хибне? (порожній? (друге (перше поля)))))
      ((атом? (як-є ()))
       (тримовна-назва-присутня? мова (решта поля))))))

; D3:000 — справжнє структурне порожнє значення, а не
; відсутній людський запис. Таблиця показує його як «()».
; Для решти резидентів () в колонці означає незаповнену поверхню.
(визначити тримовна-проєкція-рядка-присутня?
  (функція (мова рядок)
    (за-умовою
      ((однакові? (перше рядок) (як-є (д3 000)))
       (атом? (як-є ())))
      ((атом? (як-є ()))
       (тримовна-назва-присутня? мова (решта рядок))))))

(визначити порахувати-тримовні-назви
  (функція (мова рядки накопичувач)
    (за-умовою
      ((порожній? рядки) накопичувач)
      ((тримовна-проєкція-рядка-присутня? мова (перше рядки))
       (порахувати-тримовні-назви
         мова (решта рядки) (додати-1 накопичувач)))
      ((атом? (як-є ()))
       (порахувати-тримовні-назви мова (решта рядки) накопичувач)))))

(визначити порахувати-спільні-тримовні-рядки
  (функція (рядки накопичувач)
    (за-умовою
      ((порожній? рядки) накопичувач)
      ((тримовна-проєкція-рядка-присутня? (як-є укр) (перше рядки))
       (за-умовою
         ((тримовна-проєкція-рядка-присутня? (як-є en) (перше рядки))
          (за-умовою
            ((тримовна-проєкція-рядка-присутня? (як-є san) (перше рядки))
             (порахувати-спільні-тримовні-рядки
               (решта рядки) (додати-1 накопичувач)))
            ((атом? (як-є ()))
             (порахувати-спільні-тримовні-рядки
               (решта рядки) накопичувач))))
         ((атом? (як-є ()))
          (порахувати-спільні-тримовні-рядки
            (решта рядки) накопичувач))))
      ((атом? (як-є ()))
       (порахувати-спільні-тримовні-рядки (решта рядки) накопичувач)))))

(визначити тримовна-кількість-рядків (довжина тримовні-рядки))
(визначити тримовна-кількість-спільних
  (порахувати-спільні-тримовні-рядки тримовні-рядки 0))

(визначити тримовна-кількість
  (функція (назва)
    (порахувати-тримовні-назви назва тримовні-рядки 0)))

(визначити тримовне-покриття
  (функція (назва)
    (нехай ((наявні (тримовна-кількість назва)))
      (список назва
        (список (як-є наявні) наявні)
        (список (як-є порожні) (відняти тримовна-кількість-рядків наявні))))))

(визначити тримовний-підсумок
  (список
    (як-є trilingual-surface-report)
    (список (як-є точнодоменні-рядки) тримовна-кількість-рядків)
    (тримовне-покриття (як-є ук))
    (тримовне-покриття (як-є укр))
    (тримовне-покриття (як-є san))
    (тримовне-покриття (як-є en))
    (тримовне-покриття (як-є LISP))
    (тримовне-покриття (як-є sym))
    (список (як-є спільні-укр-en-san) тримовна-кількість-спільних)
    (список (як-є викличний-допуск) (як-є не-виміряно))
    (список (як-є виконання-SENS) (як-є не-виміряно))
    (список (як-є оберненість-T5M) (як-є не-виміряно))
    (список (як-є релізний-статус) (як-є не-встановлюється))))

(друкувати тримовний-підсумок)

; --require-complete перевіряє лише наявність поверхонь.
; Навіть повна таблиця не робить усі резиденти виконуваними.
(за-умовою
  ((порожній? *argv*) тримовний-підсумок)
  ((однакові? (перше *argv*) "--require-complete")
   (за-умовою
     ((менше? тримовна-кількість-спільних тримовна-кількість-рядків)
      (помилка-неповних-людських-проєкцій тримовна-кількість-спільних))
     ((атом? (як-є ())) тримовний-підсумок)))
  ((атом? (як-є ())) (помилка-невідомого-режиму-тримовної-проєкції *argv*)))
