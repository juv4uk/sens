; #549 / #76 — мовна заміна scripts/check_trilingual_surface.py.
; Це перевірка правил супроводу, не джерело семантичних законів.
; Авторитетом залишається lib/surface/semantic-registry.lisp.
;
; Перевіряємо канонічний реєстр як структуру даних: стани української,
; англійської та санскритської проєкцій, повноту й унікальність полів.
; За неправильної форми або відсутньої проєкції повертаємо відмову.
; Параметр --require-complete зберігає історичне правило допуску випуску.
; Усі виконувані розгалуження тепер двопольові, а структурні
; розрізнення виконують ратифіковані «порожній?», «атом?», «хибне?».
; Мітки yes/no, stable/candidate, uk/en/sa/sym — лише зовнішні дані.

(визначити тримовні-стани
  (як-є (stable candidate missing compatibility-only)))

(визначити тримовні-людські-проєкції
  (як-є (uk en sa)))

(визначити тримовна-помилка
  (функція (вид деталі)
    (нехай ((надруковане
            (друкувати
              (список
                (як-є trilingual-surface-error)
                вид
                деталі))))
      ; Навмисно невизначений виклик: командний виконавець повертає ненульовий код.
      (trilingual-surface-check-failed вид деталі))))

(визначити тримовний-стан-належності
  (функція (значення значення-списку)
    (за-умовою
      ((порожній? значення-списку) (як-є absent))
      ((та (атом? значення-списку) (хибне? (порожній? значення-списку))) (як-є malformed))
      ((хибне? (атом? значення-списку))
       (за-умовою
         ((однакові? значення (перше значення-списку))
          (як-є present))
         ((хибне? (однакові? значення (перше значення-списку)))
          (тримовний-стан-належності значення (решта значення-списку))))))))

(визначити тримовний-стан-трійки
  (функція (значення)
    (за-умовою
      ((порожній? значення) (як-є no))
      ((та (атом? значення) (хибне? (порожній? значення))) (як-є no))
      ((хибне? (атом? значення))
       (нехай ((залишок-перший (решта значення)))
         (за-умовою
           ((хибне? (атом? залишок-перший))
            (нехай ((залишок-другий (решта залишок-перший)))
              (за-умовою
                ((хибне? (атом? залишок-другий))
                 (нехай ((залишок-третій (решта залишок-другий)))
                   (за-умовою
                     ((порожній? залишок-третій) (як-є yes))
                     ((та (атом? залишок-третій) (хибне? (порожній? залишок-третій))) (як-є no))
                     ((хибне? (атом? залишок-третій)) (як-є no)))))
                ((порожній? залишок-другий) (як-є no))
                ((та (атом? залишок-другий) (хибне? (порожній? залишок-другий))) (як-є no)))))
           ((порожній? залишок-перший) (як-є no))
           ((та (атом? залишок-перший) (хибне? (порожній? залишок-перший))) (як-є no))))))))

(визначити тримовний-стан-цитованого-символу
  (функція (поле)
    (за-умовою
      ((однакові?
         поле
         (список (як-є sym) (список (як-є quote) (як-є stable))))
       (як-є yes))
      ((хибне? (однакові?
         поле
         (список (як-є sym) (список (як-є quote) (як-є stable)))))
       (як-є no)))))

(визначити тримовна-мова-поля
  (функція (поле)
    (нехай ((спеціальна-змінна (тримовний-стан-цитованого-символу поле)))
      (за-умовою
        ((тотожне? спеціальна-змінна (як-є yes)) (як-є sym))
        ((хибне? (тотожне? спеціальна-змінна (як-є yes))) (перше поле))))))

(визначити тримовний-стан-поля
  (функція (поле)
    (нехай ((спеціальна-змінна (тримовний-стан-цитованого-символу поле)))
      (за-умовою
        ((тотожне? спеціальна-змінна (як-є yes)) (як-є stable))
        ((хибне? (тотожне? спеціальна-змінна (як-є yes))) (третє поле))))))

(визначити тримовне-перевірити-звичайне-поле
  (функція (поле)
    (нехай ((форма (тримовний-стан-трійки поле)))
      (за-умовою
        ((хибне? (тотожне? форма (як-є yes)))
         (тримовна-помилка (як-є malformed-surface) поле))
        ((тотожне? форма (як-є yes))
         (нехай-послідовно ((мова (перше поле))
                (назва (друге поле))
                (стан (третє поле)))
           (за-умовою
             ((та (атом? мова) (хибне? (порожній? мова)))
              (за-умовою
                ((та (атом? назва) (хибне? (порожній? назва)))
                 (за-умовою
                   ((та (атом? стан) (хибне? (порожній? стан)))
                    (нехай ((поточний-стан (тримовний-стан-належності стан тримовні-стани)))
                      (за-умовою
                        ((тотожне? поточний-стан (як-є present))
                         (як-є valid))
                        ((хибне? (тотожне? поточний-стан (як-є present)))
                         (тримовна-помилка (як-є unknown-status) поле))))
                   ((порожній? стан)
                    (тримовна-помилка (як-є malformed-status) поле))
                   ((хибне? (атом? стан))
                    (тримовна-помилка (як-є malformed-status) поле))))
                ((порожній? назва)
                 (тримовна-помилка (як-є malformed-name) поле))
                ((хибне? (атом? назва))
                 (тримовна-помилка (як-є malformed-name) поле))))
             ((порожній? мова)
              (тримовна-помилка (як-є malformed-surface-name) поле))
             ((хибне? (атом? мова))
              (тримовна-помилка (як-є malformed-surface-name) поле))))))))))

(визначити тримовне-вимагати-людські-проєкції
  (функція (побачені)
    (нехай ((стан-ук (тримовний-стан-належності (як-є uk) побачені)))
      (за-умовою
        ((хибне? (тотожне? стан-ук (як-є present)))
         (тримовна-помилка (як-є missing-human-surface) (як-є uk)))
        ((тотожне? стан-ук (як-є present))
         (нехай ((стан-англ (тримовний-стан-належності (як-є en) побачені)))
           (за-умовою
             ((хибне? (тотожне? стан-англ (як-є present)))
              (тримовна-помилка (як-є missing-human-surface) (як-є en)))
             ((тотожне? стан-англ (як-є present))
              (нехай ((стан-санскрит (тримовний-стан-належності (як-є sa) побачені)))
                (за-умовою
                  ((хибне? (тотожне? стан-санскрит (як-є present)))
                   (тримовна-помилка (як-є missing-human-surface) (як-є sa)))
                  ((тотожне? стан-санскрит (як-є present))
                   (як-є valid))))))))))))

(визначити тримовне-перевірити-поля
  (функція (поля побачені)
    (за-умовою
      ((порожній? поля)
       (тримовне-вимагати-людські-проєкції побачені))
      ((та (атом? поля) (хибне? (порожній? поля)))
       (тримовна-помилка (як-є malformed-field-tail) поля))
      ((хибне? (атом? поля))
       (нехай-послідовно ((поле (перше поля))
              (спеціальна-змінна (тримовний-стан-цитованого-символу поле)))
         (за-умовою
           ((тотожне? спеціальна-змінна (як-є yes))
            (нехай ((дублікат (тримовний-стан-належності (як-є sym) побачені)))
              (за-умовою
                ((тотожне? дублікат (як-є present))
                 (тримовна-помилка (як-є duplicate-surface) (як-є sym)))
                ((хибне? (тотожне? дублікат (як-є present)))
                 (тримовне-перевірити-поля
                   (решта поля)
                   (сполучити (як-є sym) побачені))))))
           ((хибне? (тотожне? спеціальна-змінна (як-є yes)))
            (нехай ((перевірене-поле (тримовне-перевірити-звичайне-поле поле)))
              (нехай-послідовно ((мова (тримовна-мова-поля поле))
                     (дублікат (тримовний-стан-належності мова побачені)))
                (за-умовою
                  ((тотожне? дублікат (як-є present))
                   (тримовна-помилка (як-є duplicate-surface) мова))
                  ((хибне? (тотожне? дублікат (як-є present)))
                   (тримовне-перевірити-поля
                     (решта поля)
                     (сполучити мова побачені)))))))))))))

(визначити тримовне-перевірити-рядок
  (функція (рядок)
    (за-умовою
      ((порожній? рядок)
       (тримовна-помилка (як-є malformed-entry) рядок))
      ((та (атом? рядок) (хибне? (порожній? рядок)))
       (тримовна-помилка (як-є malformed-entry) рядок))
      ((хибне? (атом? рядок))
       (нехай ((тотожність (перше рядок)))
         (за-умовою
           ((та (атом? тотожність) (хибне? (порожній? тотожність)))
            (нехай ((перевірені-поля (тримовне-перевірити-поля (решта рядок) (як-є ()))))
              тотожність))
           ((порожній? тотожність)
            (тримовна-помилка (як-є malformed-identity) рядок))
           ((хибне? (атом? тотожність))
            (тримовна-помилка (як-є malformed-identity) рядок))))))))

(визначити тримовне-перевірити-рядки
  (функція (рядки побачені-тотожності)
    (за-умовою
      ((порожній? рядки)
       (за-умовою
         ((порожній? побачені-тотожності)
          (тримовна-помилка (як-є empty-registry) (як-є ())))
         ((хибне? (атом? побачені-тотожності))
          (як-є valid))
         ((та (атом? побачені-тотожності) (хибне? (порожній? побачені-тотожності)))
          (тримовна-помилка (як-є malformed-seen-identities) побачені-тотожності))))
      ((та (атом? рядки) (хибне? (порожній? рядки)))
       (тримовна-помилка (як-є malformed-entry-tail) рядки))
      ((хибне? (атом? рядки))
       (нехай-послідовно ((тотожність (тримовне-перевірити-рядок (перше рядки)))
              (дублікат (тримовний-стан-належності тотожність побачені-тотожності)))
         (за-умовою
           ((тотожне? дублікат (як-є present))
            (тримовна-помилка (як-є duplicate-semantic-id) тотожність))
           ((хибне? (тотожне? дублікат (як-є present)))
            (тримовне-перевірити-рядки
              (решта рядки)
              (сполучити тотожність побачені-тотожності)))))))))

(визначити тримовний-стан-проєкції
  (функція (поля очікуване)
    (за-умовою
      ((порожній? поля) (як-є ()))
      ((та (атом? поля) (хибне? (порожній? поля))) (як-є ()))
      ((хибне? (атом? поля))
       (нехай-послідовно ((поле (перше поля))
              (мова (тримовна-мова-поля поле)))
         (за-умовою
           ((тотожне? мова очікуване)
            (тримовний-стан-поля поле))
           ((хибне? (тотожне? мова очікуване))
            (тримовний-стан-проєкції (решта поля) очікуване))))))))

(визначити тримовний-стан-усіх-статусів
  (функція (поля мови очікуване)
    (за-умовою
      ((порожній? мови) (як-є all))
      ((та (атом? мови) (хибне? (порожній? мови))) (як-є not-all))
      ((хибне? (атом? мови))
       (нехай ((поточне
               (тримовний-стан-проєкції поля (перше мови))))
         (за-умовою
           ((тотожне? поточне очікуване)
            (тримовний-стан-усіх-статусів
              поля
              (решта мови)
              очікуване))
           ((хибне? (тотожне? поточне очікуване))
            (як-є not-all))))))))

(визначити тримовний-публічний-вид
  (функція (рядок)
    (нехай ((поточний-стан
            (тримовний-стан-усіх-статусів
              (решта рядок)
              тримовні-людські-проєкції
              (як-є compatibility-only))))
      (за-умовою
        ((тотожне? поточний-стан (як-є all))
         (як-є compatibility-only))
        ((хибне? (тотожне? поточний-стан (як-є all)))
         (як-є public))))))

(визначити тримовний-стабільний-вид
  (функція (рядок)
    (нехай ((поточний-стан
            (тримовний-стан-усіх-статусів
              (решта рядок)
              тримовні-людські-проєкції
              (як-є stable))))
      (за-умовою
        ((тотожне? поточний-стан (як-є all))
         (як-є all-stable))
        ((хибне? (тотожне? поточний-стан (як-є all)))
         (як-є not-all-stable))))))

(визначити тримовна-наявність-проєкції
  (функція (поля очікуване)
    (нехай ((значення (тримовний-стан-проєкції поля очікуване)))
      (за-умовою
        ((порожній? значення) (як-є absent))
        ((та (атом? значення) (хибне? (порожній? значення))) (як-є present))
        ((хибне? (атом? значення)) (як-є present))))))

(визначити тримовне-порахувати-статуси
  (функція (рядки мова очікуване накопичувач)
    (за-умовою
      ((порожній? рядки) накопичувач)
      ((та (атом? рядки) (хибне? (порожній? рядки))) накопичувач)
      ((хибне? (атом? рядки))
       (нехай ((стан
               (тримовний-стан-проєкції (решта (перше рядки)) мова)))
         (за-умовою
           ((тотожне? стан очікуване)
            (тримовне-порахувати-статуси (решта рядки) мова очікуване (додати накопичувач 1)))
           ((хибне? (тотожне? стан очікуване))
            (тримовне-порахувати-статуси (решта рядки) мова очікуване накопичувач))))))))

(визначити тримовне-порахувати-публічні
  (функція (рядки накопичувач)
    (за-умовою
      ((порожній? рядки) накопичувач)
      ((та (атом? рядки) (хибне? (порожній? рядки))) накопичувач)
      ((хибне? (атом? рядки))
       (нехай ((вид (тримовний-публічний-вид (перше рядки))))
         (за-умовою
           ((тотожне? вид (як-є public))
            (тримовне-порахувати-публічні (решта рядки) (додати накопичувач 1)))
           ((хибне? (тотожне? вид (як-є public)))
            (тримовне-порахувати-публічні (решта рядки) накопичувач))))))))

(визначити тримовне-порахувати-символьні
  (функція (рядки накопичувач)
    (за-умовою
      ((порожній? рядки) накопичувач)
      ((та (атом? рядки) (хибне? (порожній? рядки))) накопичувач)
      ((хибне? (атом? рядки))
       (нехай ((поточний-стан
               (тримовна-наявність-проєкції
                 (решта (перше рядки))
                 (як-є sym))))
         (за-умовою
           ((тотожне? поточний-стан (як-є present))
            (тримовне-порахувати-символьні (решта рядки) (додати накопичувач 1)))
           ((хибне? (тотожне? поточний-стан (як-є present)))
            (тримовне-порахувати-символьні (решта рядки) накопичувач))))))))

(визначити тримовне-порахувати-спільні-стабільні
  (функція (рядки накопичувач)
    (за-умовою
      ((порожній? рядки) накопичувач)
      ((та (атом? рядки) (хибне? (порожній? рядки))) накопичувач)
      ((хибне? (атом? рядки))
       (нехай ((публічний (тримовний-публічний-вид (перше рядки))))
         (за-умовою
           ((хибне? (тотожне? публічний (як-є public)))
            (тримовне-порахувати-спільні-стабільні (решта рядки) накопичувач))
           ((тотожне? публічний (як-є public))
            (нехай ((стабільність-проєкцій (тримовний-стабільний-вид (перше рядки))))
              (за-умовою
                ((тотожне? стабільність-проєкцій (як-є all-stable))
                 (тримовне-порахувати-спільні-стабільні (решта рядки) (додати накопичувач 1)))
                ((хибне? (тотожне? стабільність-проєкцій (як-є all-stable)))
                 (тримовне-порахувати-спільні-стабільні (решта рядки) накопичувач)))))))))))

(визначити тримовний-стан-випуску
  (функція (рядки)
    (за-умовою
      ((порожній? рядки) (як-є confirmed))
      ((та (атом? рядки) (хибне? (порожній? рядки))) (як-є open))
      ((хибне? (атом? рядки))
       (нехай ((публічний (тримовний-публічний-вид (перше рядки))))
         (за-умовою
           ((хибне? (тотожне? публічний (як-є public)))
            (тримовний-стан-випуску (решта рядки)))
           ((тотожне? публічний (як-є public))
            (нехай ((стабільність-проєкцій (тримовний-стабільний-вид (перше рядки))))
              (за-умовою
                ((тотожне? стабільність-проєкцій (як-є all-stable))
                 (тримовний-стан-випуску (решта рядки)))
                ((хибне? (тотожне? стабільність-проєкцій (як-є all-stable)))
                 (як-є open)))))))))))

(визначити тримовний-режим
  (функція (аргументи)
    (за-умовою
      ((порожній? аргументи) (як-є report))
      ((та (атом? аргументи) (хибне? (порожній? аргументи)))
       (тримовна-помилка (як-є malformed-argv) аргументи))
      ((хибне? (атом? аргументи))
       (нехай ((залишок (решта аргументи)))
         (за-умовою
           ((порожній? залишок)
            (за-умовою
              ((однакові? (перше аргументи) "--require-complete")
               (як-є require-complete))
              ((хибне? (однакові? (перше аргументи) "--require-complete"))
               (тримовна-помилка (як-є unknown-argument) (перше аргументи)))))
           ((та (атом? залишок) (хибне? (порожній? залишок)))
            (тримовна-помилка (як-є malformed-argv) аргументи))
           ((хибне? (атом? залишок))
            (тримовна-помилка (як-є too-many-arguments) аргументи))))))))

(визначити тримовна-форма-реєстру
  (перше
    (читати-всі
      (читати-файл "lib/surface/semantic-registry.lisp"))))

(визначити тримовні-рядки
  (за-умовою
    ((порожній? тримовна-форма-реєстру)
     (тримовна-помилка (як-є malformed-registry-root) тримовна-форма-реєстру))
    ((та (атом? тримовна-форма-реєстру) (хибне? (порожній? тримовна-форма-реєстру)))
     (тримовна-помилка (як-є malformed-registry-root) тримовна-форма-реєстру))
    ((хибне? (атом? тримовна-форма-реєстру))
     (за-умовою
       ((тотожне? (перше тримовна-форма-реєстру) (як-є sr/1))
        (решта тримовна-форма-реєстру))
       ((хибне? (тотожне? (перше тримовна-форма-реєстру) (як-є sr/1)))
        (тримовна-помилка
          (як-є malformed-registry-root)
          (перше тримовна-форма-реєстру)))))))

(визначити тримовний-підсумок-перевірки
  (тримовне-перевірити-рядки тримовні-рядки (як-є ())))

(визначити тримовна-кількість-публічних
  (тримовне-порахувати-публічні тримовні-рядки 0))

(визначити тримовна-кількість-символьних
  (тримовне-порахувати-символьні тримовні-рядки 0))

(визначити тримовна-кількість-спільних-стабільних
  (тримовне-порахувати-спільні-стабільні тримовні-рядки 0))

(визначити тримовний-випуск
  (тримовний-стан-випуску тримовні-рядки))

(визначити тримовний-звіт
  (список
    (як-є trilingual-surface-report)
    (список (як-є entries) (довжина тримовні-рядки))
    (список (як-є public-semantic-identities) тримовна-кількість-публічних)
    (список (як-є shared-symbolic-identities) тримовна-кількість-символьних)
    (список
      (як-є uk)
      (список (як-є stable)
            (тримовне-порахувати-статуси тримовні-рядки (як-є uk) (як-є stable) 0))
      (список (як-є candidate)
            (тримовне-порахувати-статуси тримовні-рядки (як-є uk) (як-є candidate) 0))
      (список (як-є missing)
            (тримовне-порахувати-статуси тримовні-рядки (як-є uk) (як-є missing) 0))
      (список (як-є compatibility-only)
            (тримовне-порахувати-статуси
              тримовні-рядки
              (як-є uk)
              (як-є compatibility-only)
              0)))
    (список
      (як-є en)
      (список (як-є stable)
            (тримовне-порахувати-статуси тримовні-рядки (як-є en) (як-є stable) 0))
      (список (як-є candidate)
            (тримовне-порахувати-статуси тримовні-рядки (як-є en) (як-є candidate) 0))
      (список (як-є missing)
            (тримовне-порахувати-статуси тримовні-рядки (як-є en) (як-є missing) 0))
      (список (як-є compatibility-only)
            (тримовне-порахувати-статуси
              тримовні-рядки
              (як-є en)
              (як-є compatibility-only)
              0)))
    (список
      (як-є sa)
      (список (як-є stable)
            (тримовне-порахувати-статуси тримовні-рядки (як-є sa) (як-є stable) 0))
      (список (як-є candidate)
            (тримовне-порахувати-статуси тримовні-рядки (як-є sa) (як-є candidate) 0))
      (список (як-є missing)
            (тримовне-порахувати-статуси тримовні-рядки (як-є sa) (як-є missing) 0))
      (список (як-є compatibility-only)
            (тримовне-порахувати-статуси
              тримовні-рядки
              (як-є sa)
              (як-є compatibility-only)
              0)))
    (список
      (як-є trilingual-stable-identities)
      тримовна-кількість-спільних-стабільних
      тримовна-кількість-публічних)
    (список (як-є release-parity) тримовний-випуск)))

(визначити тримовний-надрукований-звіт
  (друкувати тримовний-звіт))

(визначити тримовний-вибраний-режим
  (тримовний-режим *argv*))

(за-умовою
  ((тотожне? тримовний-вибраний-режим (як-є require-complete))
   (за-умовою
     ((тотожне? тримовний-випуск (як-є confirmed))
      тримовний-звіт)
     ((хибне? (тотожне? тримовний-випуск (як-є confirmed)))
      (тримовна-помилка (як-є release-parity-open) тримовний-звіт))))
  ((хибне? (тотожне? тримовний-вибраний-режим (як-є require-complete)))
   тримовний-звіт))

