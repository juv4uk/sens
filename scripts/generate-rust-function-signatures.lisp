; Генератор української проєкції сигнатур функцій у вихідний код Раст.
; Джерело метаданих: lib/surface/function-signatures.lisp.
; Вихідний файл: crates/sens/src/function_signatures_generated.rs.
; Викликати з кореня репозиторію:
;   sens scripts/generate-rust-function-signatures.lisp
;   sens scripts/generate-rust-function-signatures.lisp --check
; Генератор не створює семантичних законів; записує похідну таблицю.
; У виконуваному Lisp локальні функції та змінні українською.
; Рядки вихідного коду Раст і протокольні ключі залишаються незмінними.

(визначити шлях-джерела "lib/surface/function-signatures.lisp")
(визначити шлях-результату "crates/sens/src/function_signatures_generated.rs")

(визначити зчепити-всі-рядки
  (функція аргументи
    (згорнути (функція (накопичувач фрагмент) (рядок-додати накопичувач фрагмент)) "" аргументи)))

; Поля кількості аргументів у Rust — машинна проєкція,
; а не людське числове представлення. Перетворення числа
; в рядок навмисно дає канонічний транспорт #q2:<біти>/1.
; Кількість аргументів є невід'ємним цілим: беремо її
; двійковий чисельник і формуємо рівнозначний літерал Rust.
(визначити дописати-біти-точного-цілого
  (функція (залишок накопичувач)
    (за-умовою
      ((однакові? (рядок-перший залишок) "/") накопичувач)
      (так
       (дописати-біти-точного-цілого
         (рядок-решта залишок)
         (рядок-додати накопичувач (рядок-перший залишок)))))))

(визначити подати-натуральне-для-раст
  (функція (число)
    (нехай ((фізичний-запис (число-рядок число)))
      (за-умовою
        ((рядок-префікс? "#q2:" фізичний-запис)
         (зчепити-всі-рядки
           "0b"
           (дописати-біти-точного-цілого
             (рядок-решта (рядок-решта (рядок-решта (рядок-решта фізичний-запис))))
             "")))
        (так (перше (як-є ())))))))

(визначити рядки-сигнатур (перше (читати-всі (читати-файл шлях-джерела))))

(визначити поле-сигнатури
  (функція (ключ рядок)
    (друге (знайти-за-ключем ключ (решта рядок)))))

(визначити поле-сигнатури-наявне?
  (функція (ключ рядок)
    (за-умовою
      ((атом? (знайти-за-ключем ключ (решта рядок))) (як-є ()))
      (так так))))

(визначити подати-вид-функції
  (функція (вид)
    (за-умовою
      ((тотожне? вид (як-є builtin)) "LanguageItemKind::Builtin")
      ((тотожне? вид (як-є syntax)) "LanguageItemKind::SyntaxForm")
      ((тотожне? вид (як-є macro)) "LanguageItemKind::Macro")
      (так (перше (як-є ()))))))

(визначити подати-арність
  (функція (арність)
    (за-умовою
      ((атом? арність)
       (зчепити-всі-рядки "Arity::Exact(" (подати-натуральне-для-раст арність) ")"))
      (так
       (за-умовою
         ((однакові? (перше арність) (як-є at-least))
          (зчепити-всі-рядки "Arity::AtLeast(" (подати-натуральне-для-раст (друге арність)) ")"))
         ((однакові? (перше арність) (як-є between))
          (зчепити-всі-рядки "Arity::Between { min: " (подати-натуральне-для-раст (друге арність))
                ", max: " (подати-натуральне-для-раст (третє арність)) " }"))
         (так (перше (як-є ()))))))))

(визначити подати-допуск-проєкцій
  (функція (рядок)
    (за-умовою
      ((тотожне? (поле-сигнатури (як-є surfaces) рядок) (як-є admitted)) "true")
      (так "false"))))

(визначити подати-рядок-сигнатури
  (функція (рядок)
    (зчепити-всі-рядки
      "    FunctionSignature { semantic_id: 0b"
      (значення-у-текст (перше рядок))
      ", kind: " (подати-вид-функції (поле-сигнатури (як-є kind) рядок))
      ", arity: " (подати-арність (поле-сигнатури (як-є arity) рядок))
      ", admitted_surfaces: " (подати-допуск-проєкцій рядок)
      ", signature: " (значення-у-текст (поле-сигнатури (як-є sig) рядок))
      ", documentation: " (значення-у-текст (поле-сигнатури (як-є doc) рядок))
      " },\n")))

(визначити подати-рядки-сигнатур
  (функція (залишок)
    (за-умовою
      ((атом? залишок) "")
      (так
       (зчепити-всі-рядки (подати-рядок-сигнатури (перше залишок)) (подати-рядки-сигнатур (решта залишок)))))))

(визначити заголовок-згенерованого
  (зчепити-всі-рядки
    "// GENERATED — DO NOT EDIT BY HAND.\n"
    "// Authority: lib/surface/function-signatures.lisp\n"
    "// Generator: scripts/generate-rust-function-signatures.lisp\n\n"
    "use crate::language_items::{Arity, LanguageItemKind};\n\n"
    "#[derive(Clone, Copy, Debug)]\n"
    "pub(crate) struct FunctionSignature {\n"
    "    pub(crate) semantic_id: u8,\n"
    "    pub(crate) kind: LanguageItemKind,\n"
    "    pub(crate) arity: Arity,\n"
    "    pub(crate) admitted_surfaces: bool,\n"
    "    pub(crate) signature: &'static str,\n"
    "    pub(crate) documentation: &'static str,\n"
    "}\n\n"
    "pub(crate) const FUNCTION_SIGNATURES: &[FunctionSignature] = &[\n"))

(визначити згенерований-вміст
  (зчепити-всі-рядки заголовок-згенерованого (подати-рядки-сигнатур рядки-сигнатур) "];\n"))

; Прапорець --check та рядки звіту залишаються даними інтерфейсу.
(за-умовою
  ((атом? *argv*)
   (друге
     (список
       (записати-файл шлях-результату згенерований-вміст)
       (друкувати "Проєкцію сигнатур функцій Rust записано"))))
  ((однакові? (перше *argv*) "--check")
   (за-умовою
     ((однакові? (читати-файл шлях-результату) згенерований-вміст)
      (друкувати "Проєкція сигнатур функцій Rust актуальна"))
     (так
      (друге
        (список
          (друкувати "Проєкція сигнатур функцій Rust застаріла")
          (перше (як-є ())))))))
  (так
   (друге
     (список
       (записати-файл шлях-результату згенерований-вміст)
       (друкувати "Проєкцію сигнатур функцій Rust записано")))))
