; #1134 — виконуваний свідок контракту полегшеного профілю третього ядра.
; Виклики залишаються українськими; назви виконавців і стани yes/no
; усередині цитування — дані протоколу, а не назви функцій.

(завантажити-файл "lib/core4.lisp")
(завантажити-файл "lib/surface/semantic-registry-api.lisp")
(завантажити-файл "lib/mechanism-selector.lisp")
(завантажити-файл "lib/core3.lisp")

(визначити ідентичність-плюса
  (отримати-ідентичність-семантичного-реєстру (як-є +)))

(визначити маршрут-працює?
  (функція (виконавець)
    (нехай ((вибір-механізму (ядро3-маршрут ідентичність-плюса виконавець)))
      (за-умовою
        ((хибне? (атом? вибір-механізму))
         (за-умовою
           ((тотожне? (перше вибір-механізму) (як-є mechanism-selected))
            (як-є yes))
           ((атом? (як-є ())) (як-є no))))
        ((атом? (як-є ())) (як-є no))))))

(визначити усі-маршрути-працюють?
  (функція ()
    (за-умовою
      ((тотожне? (маршрут-працює? (як-є common-lisp)) (як-є yes))
       (за-умовою
         ((тотожне? (маршрут-працює? (як-є prolog)) (як-є yes))
          (за-умовою
            ((тотожне? (маршрут-працює? (як-є clips)) (як-є yes))
             (за-умовою
               ((тотожне? (маршрут-працює? (як-є datalog)) (як-є yes))
                (як-є yes))
               ((атом? (як-є ())) (як-є no))))
            ((атом? (як-є ())) (як-є no))))
         ((атом? (як-є ())) (як-є no))))
      ((атом? (як-є ())) (як-є no)))))

(за-умовою
  ((тотожне? (усі-маршрути-працюють?) (як-є yes))
   (як-є (core3-profile-contract-ok (routes 4) (canon-round-trip pending-992) (clips-result available))))
  ((атом? (як-є ()))
   (як-є (core3-profile-contract-violation))))
