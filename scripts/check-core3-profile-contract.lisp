; Живий локальний зріз структурного профілю ядра СЕНС.
; Не видає перевірку зовнішніх маршрутів (CLIPS/Prolog) за доведену:
; тут доводяться лише власні D1/D3/D5 закони порожнечі, пари та селекторів.
; Якщо хоч один закон хибний, сам SENS виконує перше від порожнечі.

(визначити перевірити-профіль-ядра
  (функція ()
    (нехай ((пара (сполучити (як-є ()) (як-є ()))))
      (за-умовою
        ((хибне? (атом? (як-є ()))) (перше (як-є ())))
        ((атом? пара) (перше (як-є ())))
        ((хибне? (порожній? (перше пара))) (перше (як-є ())))
        ((хибне? (порожній? (решта пара))) (перше (як-є ())))
        (так (атом? (як-є ())))))))

(перевірити-профіль-ядра)
