#!/usr/bin/env bash
set -euo pipefail

# Перевіряє явно передані файли, або застейджені файли без аргументів.
# Свідомо не стверджує, що весь наявний борг локалізації закритий --
# перевіряє лише те, що торкається цей коміт.
if (($#)); then
  files=("$@")
else
  mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMRT)
fi

# Виявлення української кирилиці. ripgrep (rg) переважно, якщо є;
# інакше GNU grep -P (rg відсутній у деяких пісочницях агентів, і без
# фолбеку guard хибно позначав кожен файл як англомовний на таких хостах).
has_cyrillic() {
  if command -v rg >/dev/null 2>&1; then
    rg -q '[А-Яа-яІіЇїЄєҐґ]' "$1"
  else
    grep -qP '[А-Яа-яІіЇїЄєҐґ]' "$1"
  fi
}

# Номер першого рядка зі "справжнім" українським контентом -- кирилиця
# ПОЗА markdown-посиланнями. Наївний пошук кирилиці будь-де хибно
# спрацьовує на TOC-рядках на кшталт
# "[English](#english) · [Українська](#українська)", де кирилиця є
# лише в тексті посилання, не в реальній прозі. AWK: для кожного рядка
# прибрати всі `[текст](url)` конструкції, тоді перевірити кирилицю в
# тому, що лишилось.
first_real_cyrillic_line() {
  awk '
    { line = $0
      gsub(/\[[^]]*\]\([^)]*\)/, "", line)
      if (line ~ /[А-Яа-яІіЇїЄєҐґ]/) { print NR; exit }
    }
  ' "$1"
}

# Мовні заголовки для перевірки порядку секцій: Deutsch → Українська → English.
# Мова позначається секцією лише тоді, коли є явний markdown-заголовок.
# Інші документи можуть залишатися україномовними без перекладів.
first_language_heading_line() {
  local file="$1" names="$2"
  grep -n -m 1 -i -E "^#{1,6}[[:space:]]*($names)([[:space:][:punct:]]|$)" "$file" 2>/dev/null \
    | cut -d: -f1 || true
}

# Кількість СИМВОЛІВ кирилиці (не рядків -- рядок ваговито не рівний
# рядку: короткий трилінгвальний заголовок на кшталт "## Quick try ·
# Швидко спробувати · Schnell ausprobieren" важить як один "рядок з
# кирилицею", хоча реального українського тексту там на пів фрази,
# тоді як повний абзац прози важить так само "один рядок" -- рахунок
# по рядках підробний тест сплутав; символи -- чесніший proxy обсягу.
# ДО заданого рядка і ПІСЛЯ (включно), поза markdown-посиланнями.
cyrillic_chars_before_after() {
  local file="$1" split_line="$2"
  awk -v split_line="$split_line" '
    { line = $0
      gsub(/\[[^]]*\]\([^)]*\)/, "", line)
      n = gsub(/[А-Яа-яІіЇїЄєҐґ]/, "", line)
      if (NR < split_line) before += n
      else after += n
    }
    END { printf "%d %d", before+0, after+0 }
  ' "$file"
}

failed=0
for file in "${files[@]}"; do
  [[ -f "$file" ]] || continue
  case "$file" in
    *.uk.md) continue ;;
    AGENTS.md|README*.md|memory/*.md|docs/*.md|docs/**/*.md|plans/*.md|plans/**/*.md) ;;
    *) continue ;;
  esac

  directory=${file%/*}
  name=${file##*/}
  stem=${name%.md}
  [[ "$directory" == "$file" ]] && directory=.
  sibling="$directory/$stem.uk.md"
  has_sibling=0
  [[ -f "$sibling" ]] && has_cyrillic "$sibling" && has_sibling=1

  if ! has_cyrillic "$file"; then
    if ((has_sibling)); then
      continue # ok -- окремий український sibling-файл несе зміст
    fi
    printf 'Немає українського змісту в документації: %s (очікується український текст або %s)\n' \
      "$file" "$sibling" >&2
    failed=1
    continue
  fi

  ((has_sibling)) && continue # sibling-форма не має внутрішньої структури для порівняння

  # Порядок мовних секцій не дорівнює пріоритету мов.
  # Українська лишається основною: німецька може стояти перед нею
  # у документації, англійська — після неї. Відсутні мови не вимагаються.
  de_line=$(first_language_heading_line "$file" "deutsch|german")
  uk_section_line=$(first_language_heading_line "$file" "Українська|українська|УКРАЇНСЬКА|ukrainian")
  en_line=$(first_language_heading_line "$file" "english")
  uk_line=$(first_real_cyrillic_line "$file")

  if [[ -n "$de_line" && -n "$uk_section_line" ]] && (( de_line >= uk_section_line )); then
    printf 'Порядок мов: Deutsch має передувати Українській: %s (DE:%s UK:%s)\n' "$file" "$de_line" "$uk_section_line" >&2
    failed=1
  fi
  if [[ -n "$uk_section_line" && -n "$en_line" ]] && (( uk_section_line >= en_line )); then
    printf 'Порядок мов: Українська має передувати English: %s (UK:%s EN:%s)\n' "$file" "$uk_section_line" "$en_line" >&2
    failed=1
  fi
  if [[ -n "$de_line" && -n "$en_line" ]] && (( de_line >= en_line )); then
    printf 'Порядок мов: Deutsch має передувати English: %s (DE:%s EN:%s)\n' "$file" "$de_line" "$en_line" >&2
    failed=1
  fi

  # За відсутності явного заголовка Української її проза все одно
  # має бути між німецькою та англійською секціями (якщо є обидві).
  if [[ -n "$de_line" && -n "$en_line" && -z "$uk_section_line" ]]; then
    if ! awk -v de="$de_line" -v en="$en_line" '
      NR > de && NR < en {
        line = $0
        gsub(/\[[^]]*\]\([^)]*\)/, "", line)
        if (line ~ /[А-Яа-яІіЇїЄєҐґ]/) found=1
      }
      END { exit !found }
    ' "$file"; then
      printf 'Немає українського змісту між Deutsch і English: %s\n' "$file" >&2
      failed=1
    fi
  fi

  # Англійська секція не може випереджати весь український зміст.
  if [[ -n "$en_line" ]] && { [[ -z "$uk_line" ]] || (( uk_line >= en_line )); }; then
    printf 'Порядок мов: український зміст має передувати English: %s\n' "$file" >&2
    failed=1
  fi

  # За явної німецької секції український зміст не може весь
  # передувати їй, якщо окремої секції Української немає.
  if [[ -n "$de_line" && -z "$uk_section_line" && -n "$uk_line" ]] && (( uk_line < de_line )); then
    printf 'Порядок мов: Deutsch має передувати українському тексту: %s\n' "$file" >&2
    failed=1
  fi

  # Для неструктурованих текстів зберігаємо старий сигнал слабкої
  # української присутності, але не вимагаємо її в першій половині,
  # якщо документ має німецьку секцію на початку.
  total_lines=$(wc -l < "$file")
  if (( total_lines >= 10 )); then
    uk_line=$(first_real_cyrillic_line "$file")
    if [[ -z "$de_line" && -n "$uk_line" ]] && (( uk_line * 2 > total_lines )); then
      printf 'Ukrainian content only in back half of file: %s (first real Cyrillic at line %s of %s) -- expected Ukrainian-primary prose near the start, per language-policy.lisp\n' \
        "$file" "$uk_line" "$total_lines" >&2
      failed=1
    fi
  fi
done

exit "$failed"
