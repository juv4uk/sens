; Свідок узгодженості історичної спроможності резолвера.
;
; Першопричина, яку закриває цей свідок: порожній історичний індекс НЕ
; тотожний «історичних даних немає». Після виведення SID-реєстру індекс
; порожній, і резолвер раніше впевнено звітував виконаний історичний прохід,
; маючи нуль знання. Це прихований fallback — заборонено.
;
; Інваріант: спроможність або ЖИВА (є рядки), або ВИВЕДЕНА (явний маркер),
; але ніколи не «тихо порожня». Функція чиста: жодного I/O, жодного стану.
;
; Повне розгортання:
;   (визначити назва (функція (рядки виведено?) ...))

(визначити історична-спроможність-узгоджена?
  (функція (рядки виведено?)
    (за-умовою
      ((і-виведено-з-рядками? рядки виведено?) (як-є суперечність))
      ((і-тихо-порожньо? рядки виведено?) (як-є прихований-fallback))
      ((порожній? рядки) (як-є виведено))
      (так (як-є жива)))))

(визначити і-виведено-з-рядками?
  (функція (рядки виведено?)
    (за-умовою
      (виведено? (хибне? (порожній? рядки)))
      (так ні))))

(визначити і-тихо-порожньо?
  (функція (рядки виведено?)
    (за-умовою
      ((хибне? виведено?) (порожній? рядки))
      (так ні))))

(визначити хибне?
  (функція (значення)
    (за-умовою
      (значення ні)
      (так так))))

(визначити порожній?
  (функція (рядки)
    (тотожне? рядки (як-є ()))))

; Незалежний контроль: три реальні стани + один заборонений.
; Жива спроможність — є рядки, не виведено.
(історична-спроможність-узгоджена? (як-є (рядок-один)) ні)
; Виведена спроможність — немає рядків, є маркер.
(історична-спроможність-узгоджена? (як-є ()) так)
