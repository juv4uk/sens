; Перевірка законів семантики та логіки двійкової мови SENS.
; Семантику визначає сам SENS. Кожен закон — один рядок, пласко й прозоро:
; жодної вкладеної драбини, жодного зовнішнього інструмента. Точні коди:
;
;   D3  100=перше 011=решта 111=сполучити 010=атом? 101=тотожне? 001=як-є 110=за-умовою
;   D4  0100=хибне? 0101=порожній? 1110=список 0010=функція 0011=визначити
;   D5  01010=додати 11010=менше? 11011=більше?
;   D6  000000=довжина 001000=нехай
;   D8  11110111=однакові? 11011011=друкувати
;   D9  110110111=читати-файл 110101001=читати-всі
;
; Символи порівнює тотожне? (D3 101); числа — порядкові предикати
; менше?/більше? (lib/utf8.lisp). Рівність 2+3=5 виражено як
; «не (2+3 < 5) і не (2+3 > 5)». Успіх -> друк PASS. Невдача -> названий,
; спостережуваний провал (аксіома S2): навмисний незв'язаний символ
; помилка-закону-доменної-логіки → ненульовий код виходу.

(визначити перевірити-закон
  (функція (назва-закону результат-перевірки)
    (за-умовою
      (результат-перевірки (як-є ()))
      ((атом? (як-є ())) (помилка-закону-доменної-логіки назва-закону)))))

(визначити закон-нуль (довжина (як-є ())))
(визначити закон-один (довжина (як-є (а))))
(визначити закон-два (довжина (як-є (а б))))
(визначити закон-три (довжина (як-є (а б в))))
(визначити закон-пʼять (довжина (як-є (а б в г ґ))))
(визначити закон-шість (довжина (як-є (а б в г ґ д))))

; D3 — пара
(перевірити-закон (як-є car-of-cons)      (тотожне? (перше (сполучити (як-є a) (як-є b))) (як-є a)))
(перевірити-закон (як-є cdr-of-cons)      (тотожне? (решта (сполучити (як-є a) (як-є b))) (як-є b)))
(перевірити-закон (як-є atom-of-symbol)   (атом? (як-є a)))
(перевірити-закон (як-є not-atom-of-pair) (хибне? (атом? (сполучити (як-є a) (як-є b)))))
(перевірити-закон (як-є eq-reflexive)     (тотожне? (як-є a) (як-є a)))
(перевірити-закон (як-є eq-distinct)      (хибне? (тотожне? (як-є a) (як-є b))))
(перевірити-закон (як-є null-of-empty)    (порожній? (як-є ())))
(перевірити-закон (як-є list-car)         (тотожне? (перше (список (як-є a) (як-є b))) (як-є a)))

; D5 — порядок і арифметика
(перевірити-закон (як-є lessp-2-3)           (менше? закон-два закон-три))
(перевірити-закон (як-є greaterp-3-2)        (більше? закон-три закон-два))
(перевірити-закон (як-є not-lessp-3-2)       (хибне? (менше? закон-три закон-два)))
(перевірити-закон (як-є not-greaterp-2-3)    (хибне? (більше? закон-два закон-три)))
(перевірити-закон (як-є sum-2-3-not-less)    (хибне? (менше? (додати закон-два закон-три) закон-пʼять)))
(перевірити-закон (як-є sum-2-3-not-greater) (хибне? (більше? (додати закон-два закон-три) закон-пʼять)))

; D4 — приєднання списків
(перевірити-закон (як-є append-empty)
  (тотожне? (перше (приєднати (як-є ()) (список (як-є a)))) (як-є a)))

; D5 — добуток і частка
(перевірити-закон (як-є times-2-3-not-greater) (хибне? (більше? (помножити закон-два закон-три) закон-шість)))
(перевірити-закон (як-є quotient-6-2-not-less) (хибне? (менше? (частка закон-шість закон-два) закон-три)))

; D5 — членство у списку
(перевірити-закон (як-є member-found) (значення-у-списку? (як-є a) (список (як-є a) (як-є b))))

; D6 — відображення й згортання
(перевірити-закон (як-є map-head-not-less)    (хибне? (менше? (перше (відобразити (функція (значення) (додати значення закон-один)) (список закон-два закон-три))) закон-три)))
(перевірити-закон (як-є map-head-not-greater) (хибне? (більше? (перше (відобразити (функція (значення) (додати значення закон-один)) (список закон-два закон-три))) закон-три)))
(перевірити-закон (як-є reduce-sum-not-less)    (хибне? (менше? (згорнути додати закон-нуль (список закон-два закон-три)) закон-пʼять)))
(перевірити-закон (як-є reduce-sum-not-greater) (хибне? (більше? (згорнути додати закон-нуль (список закон-два закон-три)) закон-пʼять)))

; D6 — зв'язування й довжина
(перевірити-закон (як-є let-sum-not-less)    (хибне? (менше? (нехай ((ліве закон-два) (праве закон-три)) (додати ліве праве)) закон-пʼять)))
(перевірити-закон (як-є let-sum-not-greater) (хибне? (більше? (нехай ((ліве закон-два) (праве закон-три)) (додати ліве праве)) закон-пʼять)))
(перевірити-закон (як-є length-of-list-2)    (менше? закон-один (довжина (список (як-є a) (як-є b)))))

; D8 — структурна рівність
(перевірити-закон (як-є equal-list-self)     (однакові? (список (як-є a) (як-є b)) (список (як-є a) (як-є b))))
(перевірити-закон (як-є equal-nested-list-self) (однакові? (список (як-є a) (список (як-є b) (як-є c))) (список (як-є a) (список (як-є b) (як-є c)))))
(перевірити-закон (як-є equal-empty-not-pair) (хибне? (однакові? (як-є ()) (список (як-є a)))))
(перевірити-закон (як-є equal-different-list-length) (хибне? (однакові? (список (як-є a)) (список (як-є a) (як-є b)))))

; D9 — читання файла (IO) і ідентичність схеми
(перевірити-закон (як-є read-file-schema)
  (тотожне? (перше (читати-всі (читати-файл "lib/domains/d1.lisp"))) (як-є domain-table-1)))

; Визначення та використання зв'язаного імені
(перевірити-закон (як-є define-then-use) (менше? закон-два закон-три))

(друкувати "DOMAIN-LOGIC-LAWS: PASS d3=8 d5=7 d6=7 d8=4 define=1")
