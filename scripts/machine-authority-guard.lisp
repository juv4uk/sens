; #150/#211/#4057 — executable one-way machine authority + anti-hybrid guard.
; Admitted authority direction remains semantic-to-machine; reverse authority is RED.
; Current semantic authority is Contract 11.8 + ratified exact-domain laws.
; Every bounded machine capability must name an independent exact-domain
; semantic witness. Native/host results may realize meaning but may never
; become their own answer key.

(визначити друге (функція (х) (перше (решта х))))
(визначити третє (функція (х) (перше (решта (решта х)))))

(визначити ребра-авторитету
  (читати-всі (читати-файл "tests/machine-authority-edges.lisp")))

(визначити походження-машинної-здатності
  (читати-всі (читати-файл "lib/machine/capability-provenance.lisp")))

(визначити потрібні-поля-походження-машини
  (як-є
    (name
     semantic-authority
     admitted-form
     lowering-owner
     machine-witness
     reverse-edge
     independent-semantic-witness)))

(визначити поле-походження-машини-з
  (функція (назва поля)
    (за-умовою
      ((атом? поля) () (як-є missing))
      ((атом? поля) (1) (як-є missing))
      ((атом? поля) (0)
       (нехай ((поле (перше поля)))
         (за-умовою
           ((атом? поле) ()
            (поле-походження-машини-з назва (решта поля)))
           ((атом? поле) (1)
            (поле-походження-машини-з назва (решта поля)))
           ((атом? поле) (0)
            (за-умовою
              ((тотожне? (перше поле) назва) (1)
               (друге поле))
              ((тотожне? (перше поле) назва) (0)
               (поле-походження-машини-з назва (решта поля)))))))))))

(визначити поле-походження-машини
  (функція (назва рядок)
    (за-умовою
      ((атом? рядок) () (як-є missing))
      ((атом? рядок) (1) (як-є missing))
      ((атом? рядок) (0)
       (поле-походження-машини-з назва (решта рядок))))))

(визначити стан-потрібних-полів-машини
  (функція (потрібні рядок)
    (за-умовою
      ((атом? потрібні) () (як-є complete))
      ((атом? потрібні) (1) (як-є malformed))
      ((атом? потрібні) (0)
       (нехай ((значення (поле-походження-машини (перше потрібні) рядок)))
         (за-умовою
           ((однакові? значення (як-є missing)) (так)
            (як-є missing))
           ((однакові? значення (як-є missing)) (ні)
            (стан-потрібних-полів-машини (решта потрібні) рядок))))))))

(визначити стан-незалежного-свідка-точного-домену
  (функція (свідок)
    (за-умовою
      ((атом? свідок) () (як-є rejected))
      ((атом? свідок) (1) (як-є rejected))
      ((атом? свідок) (0)
       (за-умовою
         ((тотожне? (перше свідок) (як-є exact-domain-expression))
          (1)
          (як-є admitted))
         ((тотожне? (перше свідок) (як-є exact-domain-expression))
          (0)
          (за-умовою
            ((тотожне? (перше свідок) (як-є exact-domain-corpus))
             (1)
             (як-є admitted))
            ((тотожне? (перше свідок) (як-є exact-domain-corpus))
             (0)
             (як-є rejected)))))))))

(визначити стан-дозволеного-машинного-ребра
  (функція (рядок)
    (за-умовою
      ((атом? рядок) () (як-є denied))
      ((атом? рядок) (1) (як-є denied))
      ((атом? рядок) (0)
       (за-умовою
         ((тотожне? (перше рядок) (як-є authority-edge)) (1)
          (за-умовою
            ((тотожне? (друге рядок) (як-є semantic)) (1)
             (за-умовою
               ((тотожне? (третє рядок) (як-є machine)) (1)
                (як-є allowed))
               ((тотожне? (третє рядок) (як-є machine)) (0)
                (як-є denied))))
            ((тотожне? (друге рядок) (як-є semantic)) (0)
             (як-є denied))))
         ((тотожне? (перше рядок) (як-є authority-edge)) (0)
          (як-є denied)))))))

; Deliberately unbound diagnostic symbols make fail-closed violations visible
; even when stdout is buffered. CI requires the exact diagnostic name.
(визначити провал-машинної-авторитетності
  (функція (рядок)
    (machine-authority-boundary-violation рядок)))

(визначити провал-машинного-гібриду
  (функція (рядок)
    (machine-semantic-hybrid-violation рядок)))

(визначити перевірити-машинні-ребра
  (функція (рядки)
    (за-умовою
      ((атом? рядки) () (як-є machine-authority-ok))
      ((атом? рядки) (1) (провал-машинної-авторитетності рядки))
      ((атом? рядки) (0)
       (нехай ((стан (стан-дозволеного-машинного-ребра (перше рядки))))
         (за-умовою
           ((тотожне? стан (як-є allowed)) (1)
            (перевірити-машинні-ребра (решта рядки)))
           ((тотожне? стан (як-є allowed)) (0)
            (провал-машинної-авторитетності (перше рядки)))))))))

(визначити стан-безпеки-рядка-походження-машини
  (функція (рядок)
    (за-умовою
      ((атом? рядок) () (як-є rejected))
      ((атом? рядок) (1) (як-є rejected))
      ((атом? рядок) (0)
       (за-умовою
         ((тотожне? (перше рядок) (як-є capability-provenance)) (1)
          (нехай ((стан-потрібних
                  (стан-потрібних-полів-машини
                    потрібні-поля-походження-машини
                    рядок)))
            (за-умовою
              ((тотожне? стан-потрібних (як-є complete)) (1)
               (нехай-послідовно ((семантична-авторитетність
                        (поле-походження-машини
                          (як-є semantic-authority)
                          рядок))
                      (зворотне-ребро
                        (поле-походження-машини
                          (як-є reverse-edge)
                          рядок))
                      (машинний-свідок
                        (поле-походження-машини
                          (як-є machine-witness)
                          рядок))
                      (незалежний-свідок
                        (поле-походження-машини
                          (як-є independent-semantic-witness)
                          рядок))
                      (незалежний-стан
                        (стан-незалежного-свідка-точного-домену
                          незалежний-свідок)))
                 (за-умовою
                   ((тотожне? семантична-авторитетність (як-є language-contract.lisp+ratified-domain-laws))
                    (1)
                    (за-умовою
                      ((тотожне? зворотне-ребро (як-є forbidden))
                       (1)
                       (за-умовою
                         ((тотожне? незалежний-стан (як-є admitted))
                          (1)
                          (за-умовою
                            ((однакові? незалежний-свідок машинний-свідок)
                             (1)
                             (як-є rejected))
                            ((однакові? незалежний-свідок машинний-свідок)
                             (0)
                             (як-є admitted))))
                         ((тотожне? незалежний-стан (як-є admitted))
                          (0)
                          (як-є rejected))))
                      ((тотожне? зворотне-ребро (як-є forbidden))
                       (0)
                       (як-є rejected))))
                   ((тотожне? семантична-авторитетність (як-є language-contract.lisp+ratified-domain-laws))
                    (0)
                    (як-є rejected)))))
              ((тотожне? стан-потрібних (як-є complete)) (0)
               (як-є rejected)))))
         ((тотожне? (перше рядок) (як-є capability-provenance)) (0)
          (як-є rejected)))))))

(визначити перевірити-походження-машинної-здатності
  (функція (рядки)
    (за-умовою
      ((атом? рядки) () (як-є machine-anti-hybrid-ok))
      ((атом? рядки) (1) (провал-машинного-гібриду рядки))
      ((атом? рядки) (0)
       (нехай ((стан (стан-безпеки-рядка-походження-машини (перше рядки))))
         (за-умовою
           ((тотожне? стан (як-є admitted)) (1)
            (перевірити-походження-машинної-здатності (решта рядки)))
           ((тотожне? стан (як-є admitted)) (0)
            (провал-машинного-гібриду (перше рядки)))))))))

(перевірити-машинні-ребра ребра-авторитету)
(перевірити-походження-машинної-здатності походження-машинної-здатності)
