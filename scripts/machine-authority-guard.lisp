; #150/#211/#4057 — виконуваний захист односторонніх машинних
; повноважень і заборона змішування шарів.
; Дозволений напрямок — від семантики до машини; зворотний заборонено.
; Джерело семантики — Контракт 11.8 і ратифіковані закони доменів.
; Кожна обмежена машинна можливість повинна мати незалежний
; семантичний доказ з точною доменною тотожністю.
; Результат зовнішнього виконавця може реалізувати значення,
; але не може слугувати сам собі еталоном.
; Другий і третій селектори надходять із ратифікованих Д4 і Д5;
; повторних локальних реалізацій не створюємо.
; Застарілі трьохпольові стани атома, пари й порожнього списку
; переведено на точні українські предикати Д1 та двопольові умови.
; Протокольні позначки порушення й незалежних доказів незмінні.


(визначити ребра-авторитету
  (читати-всі (читати-файл "tests/machine-authority-edges.lisp")))

(визначити походження-машинної-здатності
  (читати-всі (читати-файл "lib/machine/capability-provenance.lisp")))

(визначити потрібні-поля-походження-машини
  (як-є
    (name
     semantic-authority
     admitted-form
     lowering-owner
     machine-witness
     reverse-edge
     independent-semantic-witness)))

(визначити поле-походження-машини-з
  (функція (назва поля)
    (за-умовою
      ((порожній? поля) (як-є missing))
      ((за-умовою ((атом? поля) (хибне? (порожній? поля))) (так ні)) (як-є missing))
      ((хибне? (атом? поля))
       (нехай ((поле (перше поля)))
         (за-умовою
           ((порожній? поле)
            (поле-походження-машини-з назва (решта поля)))
           ((за-умовою ((атом? поле) (хибне? (порожній? поле))) (так ні))
            (поле-походження-машини-з назва (решта поля)))
           ((хибне? (атом? поле))
            (за-умовою
              ((тотожне? (перше поле) назва)
               (друге поле))
              ((хибне? (тотожне? (перше поле) назва))
               (поле-походження-машини-з назва (решта поля)))))))))))

(визначити поле-походження-машини
  (функція (назва рядок)
    (за-умовою
      ((порожній? рядок) (як-є missing))
      ((за-умовою ((атом? рядок) (хибне? (порожній? рядок))) (так ні)) (як-є missing))
      ((хибне? (атом? рядок))
       (поле-походження-машини-з назва (решта рядок))))))

(визначити стан-потрібних-полів-машини
  (функція (потрібні рядок)
    (за-умовою
      ((порожній? потрібні) (як-є complete))
      ((за-умовою ((атом? потрібні) (хибне? (порожній? потрібні))) (так ні)) (як-є malformed))
      ((хибне? (атом? потрібні))
       (нехай ((значення (поле-походження-машини (перше потрібні) рядок)))
         (за-умовою
           ((однакові? значення (як-є missing))
            (як-є missing))
           ((хибне? (однакові? значення (як-є missing)))
            (стан-потрібних-полів-машини (решта потрібні) рядок))))))))

(визначити стан-незалежного-свідка-точного-домену
  (функція (свідок)
    (за-умовою
      ((порожній? свідок) (як-є rejected))
      ((за-умовою ((атом? свідок) (хибне? (порожній? свідок))) (так ні)) (як-є rejected))
      ((хибне? (атом? свідок))
       (за-умовою
         ((тотожне? (перше свідок) (як-є exact-domain-expression))
          (як-є admitted))
         ((хибне? (тотожне? (перше свідок) (як-є exact-domain-expression)))
          (за-умовою
            ((тотожне? (перше свідок) (як-є exact-domain-corpus))
             (як-є admitted))
            ((хибне? (тотожне? (перше свідок) (як-є exact-domain-corpus)))
             (як-є rejected)))))))))

(визначити стан-дозволеного-машинного-ребра
  (функція (рядок)
    (за-умовою
      ((порожній? рядок) (як-є denied))
      ((за-умовою ((атом? рядок) (хибне? (порожній? рядок))) (так ні)) (як-є denied))
      ((хибне? (атом? рядок))
       (за-умовою
         ((тотожне? (перше рядок) (як-є authority-edge))
          (за-умовою
            ((тотожне? (друге рядок) (як-є semantic))
             (за-умовою
               ((тотожне? (третє рядок) (як-є machine))
                (як-є allowed))
               ((хибне? (тотожне? (третє рядок) (як-є machine)))
                (як-є denied))))
            ((хибне? (тотожне? (друге рядок) (як-є semantic)))
             (як-є denied))))
         ((хибне? (тотожне? (перше рядок) (як-є authority-edge)))
          (як-є denied)))))))

; Навмисно незв'язані діагностичні символи показують відмови
; навіть за буферизованого стандартного виводу.
; Автоматична перевірка вимагає точного імені діагностики.
(визначити провал-машинної-авторитетності
  (функція (рядок)
    (machine-authority-boundary-violation рядок)))

(визначити провал-машинного-гібриду
  (функція (рядок)
    (machine-semantic-hybrid-violation рядок)))

(визначити перевірити-машинні-ребра
  (функція (рядки)
    (за-умовою
      ((порожній? рядки) (як-є machine-authority-ok))
      ((за-умовою ((атом? рядки) (хибне? (порожній? рядки))) (так ні)) (провал-машинної-авторитетності рядки))
      ((хибне? (атом? рядки))
       (нехай ((стан (стан-дозволеного-машинного-ребра (перше рядки))))
         (за-умовою
           ((тотожне? стан (як-є allowed))
            (перевірити-машинні-ребра (решта рядки)))
           ((хибне? (тотожне? стан (як-є allowed)))
            (провал-машинної-авторитетності (перше рядки)))))))))

(визначити стан-безпеки-рядка-походження-машини
  (функція (рядок)
    (за-умовою
      ((порожній? рядок) (як-є rejected))
      ((за-умовою ((атом? рядок) (хибне? (порожній? рядок))) (так ні)) (як-є rejected))
      ((хибне? (атом? рядок))
       (за-умовою
         ((тотожне? (перше рядок) (як-є capability-provenance))
          (нехай ((стан-потрібних
                  (стан-потрібних-полів-машини
                    потрібні-поля-походження-машини
                    рядок)))
            (за-умовою
              ((тотожне? стан-потрібних (як-є complete))
               (нехай-послідовно ((семантична-авторитетність
                        (поле-походження-машини
                          (як-є semantic-authority)
                          рядок))
                      (зворотне-ребро
                        (поле-походження-машини
                          (як-є reverse-edge)
                          рядок))
                      (машинний-свідок
                        (поле-походження-машини
                          (як-є machine-witness)
                          рядок))
                      (незалежний-свідок
                        (поле-походження-машини
                          (як-є independent-semantic-witness)
                          рядок))
                      (незалежний-стан
                        (стан-незалежного-свідка-точного-домену
                          незалежний-свідок)))
                 (за-умовою
                   ((тотожне? семантична-авторитетність (як-є language-contract.lisp+ratified-domain-laws))
                    (за-умовою
                      ((тотожне? зворотне-ребро (як-є forbidden))
                       (за-умовою
                         ((тотожне? незалежний-стан (як-є admitted))
                          (за-умовою
                            ((однакові? незалежний-свідок машинний-свідок)
                             (як-є rejected))
                            ((хибне? (однакові? незалежний-свідок машинний-свідок))
                             (як-є admitted))))
                         ((хибне? (тотожне? незалежний-стан (як-є admitted)))
                          (як-є rejected))))
                      ((хибне? (тотожне? зворотне-ребро (як-є forbidden)))
                       (як-є rejected))))
                   ((хибне? (тотожне? семантична-авторитетність (як-є language-contract.lisp+ratified-domain-laws)))
                    (як-є rejected)))))
              ((хибне? (тотожне? стан-потрібних (як-є complete)))
               (як-є rejected)))))
         ((хибне? (тотожне? (перше рядок) (як-є capability-provenance)))
          (як-є rejected)))))))

(визначити перевірити-походження-машинної-здатності
  (функція (рядки)
    (за-умовою
      ((порожній? рядки) (як-є machine-anti-hybrid-ok))
      ((за-умовою ((атом? рядки) (хибне? (порожній? рядки))) (так ні)) (провал-машинного-гібриду рядки))
      ((хибне? (атом? рядки))
       (нехай ((стан (стан-безпеки-рядка-походження-машини (перше рядки))))
         (за-умовою
           ((тотожне? стан (як-є admitted))
            (перевірити-походження-машинної-здатності (решта рядки)))
           ((хибне? (тотожне? стан (як-є admitted)))
            (провал-машинного-гібриду (перше рядки)))))))))

(перевірити-машинні-ребра ребра-авторитету)
(перевірити-походження-машинної-здатності походження-машинної-здатності)
