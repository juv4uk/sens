; #76 — проєкція мета-семантичного реєстру, якою володіє Lisp СЕНС, із канонічного семантичного реєстру.
;
; Авторитет лишається в lib/surface/semantic-registry.lisp.
; Цей скрипт володіє лише механікою проєкції: читає реєстр як
; звичайні дані my-lisp і ніколи не перерозбирає вихідний текст хостовим regex.
;
; Рядки реєстру:
;   ("SID" (простір-імен поверхня) ...)
; Порожні поверхні опускаються. Апостроф, який споживає лише читач,
; представлено рядком і опущено, бо читач споживає його як синтаксис цитати.
; Кожен інший допущений символ проєктується в порядку реєстру.

(визначити слово-поверхні
  (функція (поверхня)
    (перше (решта поверхня))))

(визначити простір-імен-поверхні
  (функція (поверхня)
    (перше поверхня)))

(визначити поверхня-включена?
  (функція (поверхня)
    (за-умовою
      ((атом? поверхня) ())
      
      ((однакові? (слово-поверхні поверхня) (як-є ())) ())
      ((однакові? (слово-поверхні поверхня) "'") ())
      (так так))))

(визначити зібрати-поверхні
  (функція (ід поверхні рядки)
    (за-умовою
      ((атом? поверхні) рядки)
      
      (так
       (нехай ((поверхня (перше поверхні)))
         (за-умовою
           ((поверхня-включена? поверхня)
            (зібрати-поверхні
              ід
              (решта поверхні)
              (сполучити
                (список
                  (слово-поверхні поверхня)
                  ід
                  (простір-імен-поверхні поверхня))
                рядки)))
           (так
            (зібрати-поверхні ід (решта поверхні) рядки))))))))

(визначити зібрати-записи
  (функція (записи рядки)
    (за-умовою
      ((атом? записи) рядки)
      
      (так
       (нехай ((запис (перше записи)))
         (зібрати-записи
           (решта записи)
           (зібрати-поверхні (перше запис) (решта запис) рядки)))))))

(визначити рядок+
  (функція аргументи
    (згорнути
      (функція (накопичувач частина)
        (рядок-додати накопичувач частина))
      ""
      аргументи)))

(визначити відрендерити-рядок
  (функція (рядок)
    (рядок+
      "    ("
      (значення-у-текст (перше рядок))
      " "
      (значення-у-текст (друге рядок))
      ") ; "
      (значення-у-текст (третє рядок))
      "\n")))

(визначити зєднати-рядки
  (функція (рядки)
    (згорнути
      (функція (накопичувач рядок)
        (рядок-додати накопичувач (відрендерити-рядок рядок)))
      ""
      рядки)))

(визначити відрендерити-проєкцію
  (функція (рядки)
    (рядок+
      "; ЗГЕНЕРОВАНИЙ ФАЙЛ — НЕ РЕДАГУВАТИ.\n"
      "; Джерело влади: lib/surface/semantic-registry.lisp\n"
      "; Генератор: scripts/generate-meta-semantic-registry.lisp\n"
      "; Поверхні реєстру; порожні й лише-читальні апостроф-поверхні пропущено.\n\n"
      "(00001001 my-semantic-surface-registry\n"
      "  (00000001 (\n"
      (зєднати-рядки (зворот рядки))
      "  )))\n\n"
      "(00001001 my-semantic-id-for-surface\n"
      "  (00001000 (name)\n"
      "    (10011100 ((entry (00101101 name my-semantic-surface-registry)))\n"
      "      (00000111\n"
      "        ((00000010 entry) () (00000001 ()))\n"
      "        ((00000010 entry) (0) (00101111 entry))))))\n")))

(визначити форма-реєстру
  (перше (читати-всі (читати-файл "lib/surface/semantic-registry.lisp"))))

(визначити рядки-проєкції
  (зібрати-записи
    форма-реєстру
    (як-є ())))

(визначити згенероване
  (відрендерити-проєкцію рядки-проєкції))

(визначити шлях-виходу "lib/generated/meta-semantic-registry.lisp")

(за-умовою
  ((атом? *argv*) (друге
     (список
       (записати-файл шлях-виходу згенероване)
       (друкувати "Мета-семантичний реєстр записано"))))
  
  ((тотожне? (перше *argv*) "--check")
   (нехай ((поточне (читати-файл шлях-виходу)))
     (за-умовою
       ((тотожне? поточне згенероване)
        (друкувати "Проєкція мета-семантичного реєстру актуальна"))
       (так
        (друге
          (список
            (друкувати "Проєкція мета-семантичного реєстру застаріла")
            (перше (як-є ()))))))))
  (так
   (друге
     (список
       (записати-файл шлях-виходу згенероване)
       (друкувати "Мета-семантичний реєстр записано")))))
