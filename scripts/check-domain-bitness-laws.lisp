; Виконуваний SENS-свідок ємності доменів. Жодної зовнішньої семантики.
; Властивість: кількість рядків Dn = 2^n, а крайні адреси мають точно n біт.
; D11 — окрема розріджена тестова лексика з 43 адрес.
;
; D3: 001 QUOTE, 010 ATOM, 011 CDR, 100 CAR, 101 EQ, 110 COND, 111 CONS.
; D4: 0010 LAMBDA, 0011 DEFINE.
; Механізми читання: 110110111 READ-FILE, 110101001 READ-ALL.
; D8: 11011011 PRINT (лише відображення результату).
;
; Немає десяткових 2, 4, ... 1024 як семантичних операндів і немає
; Rust/Python-таблиці «очікуваної істини». 2^n будує сама мова списками.
; Негативний свідок подвоєної адреси теж оцінює сам SENS.
; Кодова ширина Dn відрізняється від числового значення: нулі істотні.
;
; Обмеження цього конкретного вузького тесту: він перевіряє потужність,
; крайні точні координати та негативний зайвий рядок; НЕ доводить,
; що ВСІ внутрішні координати мають n біт чи всі попарно різні.
; Для цього існують окремі свідки ідентичності драбини.

(визначити load-domain
  (функція (path)
    (решта (перше (читати-всі (читати-файл path))))))

; Побудова унарного свідка потужності: кожна комірка = (001 0).
; Жоден 0 усередині QUOTE не є D24 числом або виконуваною функцією.
(визначити witness-copy
  (функція (left right)
    (за-умовою
      ((атом? left) right)
      ((атом? (як-є ()))
       (сполучити (перше left) (witness-copy (решта left) right))))))

(визначити witness-double
  (функція (cells)
    (witness-copy cells cells)))

; Два списки мають однакову потужність тоді й лише тоді, коли
; одночасно вичерпуються. Результат — тільки D1 0/1.
(визначити same-capacity
  (функція (rows cells)
    (за-умовою
      ((атом? rows) (атом? cells))
      ((атом? cells) (як-є 0))
      ((атом? (як-є ()))
       (same-capacity (решта rows) (решта cells))))))

(визначити last-key
  (функція (rows)
    (за-умовою
      ((атом? (решта rows)) (перше (перше rows)))
      ((атом? (як-є ())) (last-key (решта rows))))))

; Семантичну перевірку робить SENS; помилка — реально недопущений виклик.
(визначити require-bitness
  (функція (name rows capacity first last)
    (за-умовою
      ((тотожне? (same-capacity rows capacity) (як-є 1))
       (за-умовою
         ((тотожне? (перше (перше rows)) first)
          (за-умовою
            ((тотожне? (last-key rows) last) (як-є ()))
            ((атом? (як-є ())) (domain-bitness-fail name))))
         ((атом? (як-є ())) (domain-bitness-fail name))))
      ((атом? (як-є ())) (domain-bitness-fail name)))))

; Точковий закон: D3 має вісім РІЗНИХ точних адрес, не тільки вісім рядків.
; Конструкції, EQ та вердикти належать SENS; зовнішніх truth-таблиць немає.
; Порівняння робиться над доменно-кваліфікованими ключами, не над
; десятковим представленням їхнього packed payload.
(визначити ключ-відсутній?
  (функція (ключ рядки)
    (за-умовою
      ((атом? рядки) (атом? (як-є ())))
      ((тотожне? ключ (перше (перше рядки))) (як-є 0))
      ((атом? (як-є ())) (ключ-відсутній? ключ (решта рядки))))))

(визначити ключі-без-повторів?
  (функція (рядки)
    (за-умовою
      ((атом? рядки) (атом? (як-є ())))
      ((ключ-відсутній? (перше (перше рядки)) (решта рядки))
       (ключі-без-повторів? (решта рядки)))
      ((атом? (як-є ())) (як-є 0)))))

(визначити d1 (load-domain "lib/domains/d1.lisp"))
(визначити d2 (load-domain "lib/domains/d2.lisp"))
(визначити d3 (load-domain "lib/domains/d3.lisp"))
(визначити d4 (load-domain "lib/domains/d4.lisp"))
(визначити d5 (load-domain "lib/domains/d5.lisp"))
(визначити d6 (load-domain "lib/domains/d6.lisp"))
(визначити d7 (load-domain "lib/domains/d7.lisp"))
(визначити d8 (load-domain "lib/domains/d8.lisp"))
(визначити d9 (load-domain "lib/domains/d9.lisp"))
(визначити d10 (load-domain "lib/domains/d10.lisp"))
(визначити d11 (load-domain "lib/domains/d11.lisp"))

(визначити w1 (як-є (0)))
(визначити w2 (witness-double w1))
(визначити w3 (witness-double w2))
(визначити w4 (witness-double w3))
(визначити w5 (witness-double w4))
(визначити w6 (witness-double w5))
(визначити w7 (witness-double w6))
(визначити w8 (witness-double w7))
(визначити w9 (witness-double w8))
(визначити w10 (witness-double w9))
; D11 = 32 + 8 + 2 + 1 = 43 дійсних резидентів; ємність = 2048.
(визначити w11-occupied
  (witness-copy w6 (witness-copy w4 (witness-copy w2 w1))))

(require-bitness (як-є d1) d1 w2 (як-є 0) (як-є 1))
(require-bitness (як-є d2) d2 w3 (як-є 00) (як-є 11))
(require-bitness (як-є d3) d3 w4 (як-є 000) (як-є 111))
(require-bitness (як-є d4) d4 w5 (як-є 0000) (як-є 1111))
(require-bitness (як-є d5) d5 w6 (як-є 00000) (як-є 11111))
(require-bitness (як-є d6) d6 w7 (як-є 000000) (як-є 111111))
(require-bitness (як-є d7) d7 w8 (як-є 0000000) (як-є 1111111))
(require-bitness (як-є d8) d8 w9 (як-є 00000000) (як-є 11111111))
(require-bitness (як-є d9) d9 w10 (як-є 000000000) (як-є 111111111))
(визначити w11-full (witness-double w10))
(require-bitness (як-є d10) d10 w11-full
  (як-є 0000000000) (як-є 1111111111))
(require-bitness (як-є d11) d11 w11-occupied
  (як-є 00000000000) (як-є 00000101010))

; Мутант D3: A B C D E F G H -> A B C B E F G H.
; Не змінює ні кількості (8), ні першого (000), ні останнього (111) ключа.
; Старий тест ємності та країв такий дефект не виявляв.
(визначити д3-дубль-усередині
  (сполучити (перше d3)
    (сполучити (перше (решта d3))
      (сполучити (перше (решта (решта d3)))
        (сполучити (перше (решта d3))
          (решта (решта (решта (решта d3)))))))))

; Позитивний контроль: ратифікований D3 не містить повторів.
(за-умовою
  ((ключі-без-повторів? d3) (як-є ()))
  ((атом? (як-є ())) (помилка-д3-повтор-у-каноні)))

; Негативний контроль: ємність та краї ті самі, але дублікат виявлено.
(за-умовою
  ((same-capacity д3-дубль-усередині w4)
   (за-умовою
     ((тотожне? (перше (перше д3-дубль-усередині)) (як-є 000))
      (за-умовою
        ((тотожне? (last-key д3-дубль-усередині) (як-є 111))
         (за-умовою
           ((тотожне? (ключі-без-повторів? д3-дубль-усередині) (як-є 0))
            (як-є ()))
           ((атом? (як-є ())) (помилка-д3-пропущений-дубль))))
        ((атом? (як-є ())) (помилка-д3-крайній-ключ))))
     ((атом? (як-є ())) (помилка-д3-початковий-ключ))))
  ((атом? (як-є ())) (помилка-д3-ємність-мутанта)))

; Негативний свідок: вкорінили ще один зайвий рядок D1.
; Результат перевірки мусить бути 0, не «вгаданий» host truthiness.
(за-умовою
  ((тотожне?
     (same-capacity (сполучити (перше d1) d1) w2)
     (як-є 0))
   (як-є ()))
  ((атом? (як-є ())) (domain-bitness-negative-fail)))

(друкувати "DOMAIN-BITNESS-LAWS: PASS D1..D10 capacity; D11 sparse=43; D3 unique exact-width addresses; fixed-capacity interior-duplicate mutant rejected by SENS")
