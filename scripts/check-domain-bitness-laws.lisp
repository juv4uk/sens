; Виконуваний SENS-свідок ємності доменів. Жодної зовнішньої семантики.
; Властивість: кількість рядків Dn = 2^n, а крайні адреси мають точно n біт.
; D11 — окрема розріджена тестова лексика з 43 адрес.
;
; Д3: 001 як-є, 010 атом?, 011 решта, 100 перше, 101 тотожне?, 110 за-умовою, 111 сполучити.
; Д4: 0010 функція, 0011 визначити.
; Ратифіковані проєкції читання: Д9:110110111 читати-файл, Д9:110101001 читати-всі.
; Д8:11011011 друкувати (лише відображення результату).
;
; Немає десяткових 2, 4, ... 1024 як семантичних операндів і немає
; Rust/Python-таблиці «очікуваної істини». 2^n будує сама мова списками.
; Негативний свідок подвоєної адреси теж оцінює сам SENS.
; Кодова ширина Dn відрізняється від числового значення: нулі істотні.
;
; Обмеження цього конкретного вузького тесту: він перевіряє потужність,
; крайні точні координати та негативний зайвий рядок; НЕ доводить,
; що ВСІ внутрішні координати мають n біт чи всі попарно різні.
; Для цього існують окремі свідки ідентичності драбини.

(визначити завантажити-домен
  (функція (шлях)
    (решта (перше (читати-всі (читати-файл шлях))))))

; Побудова унарного свідка потужності: кожна комірка містить D3 NIL.
; Підрахунок структури не потребує числового носія або D24 конверсії.
(визначити скопіювати-свідка
  (функція (лівий правий)
    (за-умовою
      ((атом? лівий) правий)
      ((атом? (як-є ()))
       (сполучити (перше лівий) (скопіювати-свідка (решта лівий) правий))))))

(визначити подвоїти-свідка
  (функція (комірки)
    (скопіювати-свідка комірки комірки)))

; Два списки мають однакову потужність тоді й лише тоді, коли
; одночасно вичерпуються. Результат — тільки D1 0/1.
(визначити однакова-ємність?
  (функція (рядки комірки)
    (за-умовою
      ((атом? рядки) (атом? комірки))
      ((атом? комірки) (атом? (як-є (()))))
      ((атом? (як-є ()))
       (однакова-ємність? (решта рядки) (решта комірки))))))

(визначити останній-ключ
  (функція (рядки)
    (за-умовою
      ((атом? (решта рядки)) (перше (перше рядки)))
      ((атом? (як-є ())) (останній-ключ (решта рядки))))))

; Семантичну перевірку робить SENS; помилка — реально недопущений виклик.
(визначити вимагати-точної-ширини
  (функція (назва рядки ємність перший останній)
    (за-умовою
      ((тотожне? (однакова-ємність? рядки ємність) (атом? (як-є ())))
       (за-умовою
         ((однакові? (значення-у-текст (перше (перше рядки))) перший)
          (за-умовою
            ((однакові? (значення-у-текст (останній-ключ рядки)) останній) (як-є ()))
            ((атом? (як-є ())) (помилка-ширини-домену назва))))
         ((атом? (як-є ())) (помилка-ширини-домену назва))))
      ((атом? (як-є ())) (помилка-ширини-домену назва)))))

; Точковий закон: D3 має вісім РІЗНИХ точних адрес, не тільки вісім рядків.
; Конструкції, «тотожне?» й вердикти належать СЕНС; таблиць істини хоста немає.
; Порівняння робиться над доменно-кваліфікованими ключами, не над
; десятковим представленням їхніх упакованих даних.
(визначити ключ-відсутній?
  (функція (ключ рядки)
    (за-умовою
      ((атом? рядки) (атом? (як-є ())))
      ((тотожне? ключ (перше (перше рядки))) (атом? (як-є (()))))
      ((атом? (як-є ())) (ключ-відсутній? ключ (решта рядки))))))

(визначити ключі-без-повторів?
  (функція (рядки)
    (за-умовою
      ((атом? рядки) (атом? (як-є ())))
      ((ключ-відсутній? (перше (перше рядки)) (решта рядки))
       (ключі-без-повторів? (решта рядки)))
      ((атом? (як-є ())) (атом? (як-є (())))))))

(визначити д1 (завантажити-домен "lib/domains/d1.lisp"))
(визначити д2 (завантажити-домен "lib/domains/d2.lisp"))
(визначити д3 (завантажити-домен "lib/domains/d3.lisp"))
(визначити д4 (завантажити-домен "lib/domains/d4.lisp"))
(визначити д5 (завантажити-домен "lib/domains/d5.lisp"))
(визначити д6 (завантажити-домен "lib/domains/d6.lisp"))
(визначити д7 (завантажити-домен "lib/domains/d7.lisp"))
(визначити д8 (завантажити-домен "lib/domains/d8.lisp"))
(визначити д9 (завантажити-домен "lib/domains/d9.lisp"))
(визначити д10 (завантажити-домен "lib/domains/d10.lisp"))
(визначити д11 (завантажити-домен "lib/domains/d11.lisp"))

(визначити свідок1 (як-є (())))
(визначити свідок2 (подвоїти-свідка свідок1))
(визначити свідок3 (подвоїти-свідка свідок2))
(визначити свідок4 (подвоїти-свідка свідок3))
(визначити свідок5 (подвоїти-свідка свідок4))
(визначити свідок6 (подвоїти-свідка свідок5))
(визначити свідок7 (подвоїти-свідка свідок6))
(визначити свідок8 (подвоїти-свідка свідок7))
(визначити свідок9 (подвоїти-свідка свідок8))
(визначити свідок10 (подвоїти-свідка свідок9))
; D11 = 32 + 8 + 2 + 1 = 43 дійсних резидентів; ємність = 2048.
(визначити свідок11-заповнений
  (скопіювати-свідка свідок6 (скопіювати-свідка свідок4 (скопіювати-свідка свідок2 свідок1))))

(вимагати-точної-ширини (як-є д1) д1 свідок2 "0" "1")
(вимагати-точної-ширини (як-є д2) д2 свідок3 "00" "11")
(вимагати-точної-ширини (як-є д3) д3 свідок4 "000" "111")
(вимагати-точної-ширини (як-є д4) д4 свідок5 "0000" "1111")
(вимагати-точної-ширини (як-є д5) д5 свідок6 "00000" "11111")
(вимагати-точної-ширини (як-є д6) д6 свідок7 "000000" "111111")
(вимагати-точної-ширини (як-є д7) д7 свідок8 "0000000" "1111111")
(вимагати-точної-ширини (як-є д8) д8 свідок9 "00000000" "11111111")
(вимагати-точної-ширини (як-є д9) д9 свідок10 "000000000" "111111111")
(визначити свідок11-повний (подвоїти-свідка свідок10))
(вимагати-точної-ширини (як-є д10) д10 свідок11-повний
  "0000000000" "1111111111")
(вимагати-точної-ширини (як-є д11) д11 свідок11-заповнений
  "00000000000" "00000101010")

; Мутант D3: A B C D E F G H -> A B C B E F G H.
; Не змінює ні кількості (8), ні першого (000), ні останнього (111) ключа.
; Старий тест ємності та країв такий дефект не виявляв.
(визначити д3-дубль-усередині
  (сполучити (перше д3)
    (сполучити (перше (решта д3))
      (сполучити (перше (решта (решта д3)))
        (сполучити (перше (решта д3))
          (решта (решта (решта (решта д3)))))))))

; Позитивний контроль: ратифікований D3 не містить повторів.
(за-умовою
  ((ключі-без-повторів? д3) (як-є ()))
  ((атом? (як-є ())) (помилка-д3-повтор-у-каноні)))

; Негативний контроль: ємність та краї ті самі, але дублікат виявлено.
(за-умовою
  ((однакова-ємність? д3-дубль-усередині свідок4)
   (за-умовою
     ((однакові? (значення-у-текст (перше (перше д3-дубль-усередині))) "000")
      (за-умовою
        ((тотожне? (останній-ключ д3-дубль-усередині) "111")
         (за-умовою
           ((тотожне? (ключі-без-повторів? д3-дубль-усередині) (атом? (як-є (()))))
            (як-є ()))
           ((атом? (як-є ())) (помилка-д3-пропущений-дубль))))
        ((атом? (як-є ())) (помилка-д3-крайній-ключ))))
     ((атом? (як-є ())) (помилка-д3-початковий-ключ))))
  ((атом? (як-є ())) (помилка-д3-ємність-мутанта)))

; Негативний свідок: вкорінили ще один зайвий рядок D1.
; Результат перевірки мусить бути точним значенням 0, а не вгаданою істинністю хоста.
(за-умовою
  ((тотожне?
     (однакова-ємність? (сполучити (перше д1) д1) свідок2)
     (атом? (як-є ())))
   (як-є ()))
  ((атом? (як-є ())) (помилка-ширини-домену-негативна)))

; Статус є цитованим SENS-атомом, не сирим String у T5M reader.
(друкувати (як-є domain-bitness-laws-pass))
