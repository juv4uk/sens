; Виконуваний SENS-свідок ємності доменів. Жодної зовнішньої семантики.
; Властивість: кількість рядків Dn = 2^n, а крайні адреси мають точно n біт.
; D11 — окрема розріджена тестова лексика з 43 адрес.
;
; D3: 001 QUOTE, 010 ATOM, 011 CDR, 100 CAR, 101 EQ, 110 COND, 111 CONS.
; D4: 0010 LAMBDA, 0011 DEFINE.
; Механізми читання: 110110111 READ-FILE, 110101001 READ-ALL.
; D8: 11011011 PRINT (лише відображення результату).
;
; Немає десяткових 2, 4, ... 1024 як семантичних операндів і немає
; Rust/Python-таблиці «очікуваної істини». 2^n будує сама мова списками.
; Негативний свідок подвоєної адреси теж оцінює сам SENS.
; Кодова ширина Dn відрізняється від числового значення: нулі істотні.
;
; Обмеження цього конкретного вузького тесту: він перевіряє потужність,
; крайні точні координати та негативний зайвий рядок; НЕ доводить,
; що ВСІ внутрішні координати мають n біт чи всі попарно різні.
; Для цього існують окремі свідки ідентичності драбини.

(0011 load-domain
  (0010 (path)
    (011 (100 (110101001 (110110111 path))))))

; Побудова унарного свідка потужності: кожна комірка = (001 0).
; Жоден 0 усередині QUOTE не є D24 числом або виконуваною функцією.
(0011 witness-copy
  (0010 (left right)
    (110
      ((010 left) right)
      ((010 (001 ()))
       (111 (100 left) (witness-copy (011 left) right))))))

(0011 witness-double
  (0010 (cells)
    (witness-copy cells cells)))

; Два списки мають однакову потужність тоді й лише тоді, коли
; одночасно вичерпуються. Результат — тільки D1 0/1.
(0011 same-capacity
  (0010 (rows cells)
    (110
      ((010 rows) (010 cells))
      ((010 cells) (001 0))
      ((010 (001 ()))
       (same-capacity (011 rows) (011 cells))))))

(0011 last-key
  (0010 (rows)
    (110
      ((010 (011 rows)) (100 (100 rows)))
      ((010 (001 ())) (last-key (011 rows))))))

; Семантичну перевірку робить SENS; помилка — реально недопущений виклик.
(0011 require-bitness
  (0010 (name rows capacity first last)
    (110
      ((101 (same-capacity rows capacity) (001 1))
       (110
         ((101 (100 (100 rows)) first)
          (110
            ((101 (last-key rows) last) (001 ()))
            ((010 (001 ())) (domain-bitness-fail name))))
         ((010 (001 ())) (domain-bitness-fail name))))
      ((010 (001 ())) (domain-bitness-fail name)))))

; Точковий закон: D3 має вісім РІЗНИХ точних адрес, не тільки вісім рядків.
; Конструкції, EQ та вердикти належать SENS; зовнішніх truth-таблиць немає.
; Порівняння робиться над доменно-кваліфікованими ключами, не над
; десятковим представленням їхнього packed payload.
(0011 ключ-відсутній?
  (0010 (ключ рядки)
    (110
      ((010 рядки) (010 (001 ())))
      ((101 ключ (100 (100 рядки))) (001 0))
      ((010 (001 ())) (ключ-відсутній? ключ (011 рядки))))))

(0011 ключі-без-повторів?
  (0010 (рядки)
    (110
      ((010 рядки) (010 (001 ())))
      ((ключ-відсутній? (100 (100 рядки)) (011 рядки))
       (ключі-без-повторів? (011 рядки)))
      ((010 (001 ())) (001 0)))))

(0011 d1 (load-domain "lib/domains/d1.lisp"))
(0011 d2 (load-domain "lib/domains/d2.lisp"))
(0011 d3 (load-domain "lib/domains/d3.lisp"))
(0011 d4 (load-domain "lib/domains/d4.lisp"))
(0011 d5 (load-domain "lib/domains/d5.lisp"))
(0011 d6 (load-domain "lib/domains/d6.lisp"))
(0011 d7 (load-domain "lib/domains/d7.lisp"))
(0011 d8 (load-domain "lib/domains/d8.lisp"))
(0011 d9 (load-domain "lib/domains/d9.lisp"))
(0011 d10 (load-domain "lib/domains/d10.lisp"))
(0011 d11 (load-domain "lib/domains/d11.lisp"))

(0011 w1 (001 (0)))
(0011 w2 (witness-double w1))
(0011 w3 (witness-double w2))
(0011 w4 (witness-double w3))
(0011 w5 (witness-double w4))
(0011 w6 (witness-double w5))
(0011 w7 (witness-double w6))
(0011 w8 (witness-double w7))
(0011 w9 (witness-double w8))
(0011 w10 (witness-double w9))
; D11 = 32 + 8 + 2 + 1 = 43 дійсних резидентів; ємність = 2048.
(0011 w11-occupied
  (witness-copy w6 (witness-copy w4 (witness-copy w2 w1))))

(require-bitness (001 d1) d1 w2 (001 0) (001 1))
(require-bitness (001 d2) d2 w3 (001 00) (001 11))
(require-bitness (001 d3) d3 w4 (001 000) (001 111))
(require-bitness (001 d4) d4 w5 (001 0000) (001 1111))
(require-bitness (001 d5) d5 w6 (001 00000) (001 11111))
(require-bitness (001 d6) d6 w7 (001 000000) (001 111111))
(require-bitness (001 d7) d7 w8 (001 0000000) (001 1111111))
(require-bitness (001 d8) d8 w9 (001 00000000) (001 11111111))
(require-bitness (001 d9) d9 w10 (001 000000000) (001 111111111))
(0011 w11-full (witness-double w10))
(require-bitness (001 d10) d10 w11-full
  (001 0000000000) (001 1111111111))
(require-bitness (001 d11) d11 w11-occupied
  (001 00000000000) (001 00000101010))

; Мутант D3: A B C D E F G H -> A B C B E F G H.
; Не змінює ні кількості (8), ні першого (000), ні останнього (111) ключа.
; Старий тест ємності та країв такий дефект не виявляв.
(0011 д3-дубль-усередині
  (111 (100 d3)
    (111 (100 (011 d3))
      (111 (100 (011 (011 d3)))
        (111 (100 (011 d3))
          (011 (011 (011 (011 d3)))))))))

; Позитивний контроль: ратифікований D3 не містить повторів.
(110
  ((ключі-без-повторів? d3) (001 ()))
  ((010 (001 ())) (помилка-д3-повтор-у-каноні)))

; Негативний контроль: ємність та краї ті самі, але дублікат виявлено.
(110
  ((same-capacity д3-дубль-усередині w4)
   (110
     ((101 (100 (100 д3-дубль-усередині)) (001 000))
      (110
        ((101 (last-key д3-дубль-усередині) (001 111))
         (110
           ((101 (ключі-без-повторів? д3-дубль-усередині) (001 0))
            (001 ()))
           ((010 (001 ())) (помилка-д3-пропущений-дубль))))
        ((010 (001 ())) (помилка-д3-крайній-ключ))))
     ((010 (001 ())) (помилка-д3-початковий-ключ))))
  ((010 (001 ())) (помилка-д3-ємність-мутанта)))

; Негативний свідок: вкорінили ще один зайвий рядок D1.
; Результат перевірки мусить бути 0, не «вгаданий» host truthiness.
(110
  ((101
     (same-capacity (111 (100 d1) d1) w2)
     (001 0))
   (001 ()))
  ((010 (001 ())) (domain-bitness-negative-fail)))

(11011011 "DOMAIN-BITNESS-LAWS: PASS D1..D10 = 2^n, D11 sparse=43; SENS negative witness")
