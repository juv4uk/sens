; Генератор таблиці функцій ECO-CANON-1 (my-lisp#75).
; Відтворює таблицю з чинного джерела даних засобами самої мови.
; Від 12.09.2026 замінює історичний скрипт на Python.
; За #76 (ECO-LISP-SCRIPTS-1) інструменти репозиторію
; пишуться мовою СЕНС, без додавання нового шару сценаріїв Python.
;
; Історичний плоский реєстр відображається лише для міграції
; та перевірки. Канонічне джерело значення — точна доменна
; тотожність і допущений закон; кількість рядків та старі
; восьмибітні позиції не є інваріантами мови.
; Історичний реєстр читаємо як дані Lisp, не регулярними виразами
; і не стороннім аналізатором тексту.
;
; До людської проєкції можуть долучатися відомості реалізації
; для конкретного процесора. Вони не наділені семантичними
; повноваженнями: профіль Intel Core i5-6400 прив'язаний
; до наявних тотожностей і лише описує машинний шлях x86-64.
;
; Безпосередньо створює дві похідні проєкції через мовний
; запис файлів із lib/fs.lisp, поверх транспортного вводу-виводу:
;   lib/generated/function-table.lisp — схема ft-2, машинні дані;
;   docs/generated/function-table.md — людська таблиця зі стовпцями
;   ук → укр → англійська → санскрит → Intel Core i5-6400 / Skylake.
;
; Виклик із кореня репозиторію:
;   cargo run -p sens-cli --bin sens -- scripts/generate-function-table.lisp
;
; «ук» — коротка українська проєкція, «укр» — повна назва
; тієї самої семантичної тотожності. Обидві читаються
; безпосередньо з semantic-registry.lisp. Генератор не створює
; нових назв і не дублює повну проєкцію в іншому стовпці.

; Поверхні реєстру — двоелементні рядки: (простір назва-або-()).
; Назви з апострофами серіалізуються як рядки, щоб реєстр
; залишався звичайними даними Lisp, придатними для повторного читання.
(визначити форма-реєстру (перше (читати-всі (читати-файл "lib/surface/semantic-registry.lisp"))))
(визначити рядки-реєстру форма-реєстру)
; Історичні рядки збережені тільки для міграції та походження
; даних. Їхні восьмибітні координати не визначають тотожність мови.
(визначити записи рядки-реєстру)

; Проєкція машинної реалізації лише доповнює вже наявні
; семантичні ідентичності; вона не створює нових.
(визначити форма-профілю-машини
  (перше (читати-всі (читати-файл "lib/machine/intel-core-i5-6400.lisp"))))

(визначити знайти-розділ
  (функція (назва розділи)
    (за-умовою
      ((атом? розділи) (як-є ()))
      
      ((тотожне? (перше (перше розділи)) назва) (перше розділи))
      ((атом? (як-є ())) (знайти-розділ назва (решта розділи))))))

(визначити рядки-машини
  (решта (знайти-розділ (як-є rows) (решта форма-профілю-машини))))

(визначити знайти-рядок-машини
  (функція (ід рядки)
    (за-умовою
      ((атом? рядки) (як-є ()))
      
      ((однакові? (перше (перше рядки)) ід) (перше рядки))
      ((атом? (як-є ())) (знайти-рядок-машини ід (решта рядки))))))

(визначити шлях-машини
  (функція (ід)
    (нехай ((рядок (знайти-рядок-машини ід рядки-машини)))
      (за-умовою ((атом? рядок) "()") ((атом? (як-є ())) (третє рядок))))))

; Історична проєкція реалізації Маккарті 1960 / Lisp 1.5.
; Її рядки лише пояснюють наявні ідентичності.
; Зворотне наділення повноваженнями заборонено контрактом:
; історична назва не створює нового SID чи доменної тотожності.
(визначити форма-історичного-профілю
  (перше (читати-всі (читати-файл "contracts/core1-historical-sid-map.lisp"))))

(визначити рядки-історичні
  (решта (знайти-розділ (як-є rows) (решта форма-історичного-профілю))))

(визначити знайти-історичний-рядок
  (функція (ід рядки)
    (за-умовою
      ((атом? рядки) (як-є ()))
      
      ((однакові? (друге (перше рядки)) ід) (перше рядки))
      ((атом? (як-є ())) (знайти-історичний-рядок ід (решта рядки))))))

(визначити мітка-макарті
  (функція (ід)
    (нехай ((рядок (знайти-історичний-рядок ід рядки-історичні)))
      (за-умовою ((атом? рядок) "()") ((атом? (як-є ())) (рядок+ (значення-у-текст (четверте рядок)) " (" (значення-у-текст (п'ятий рядок)) ")"))))))

; Слово поверхні зазвичай є символом; під час текстового
; відображення зникає обгортка Symbol. Випадок апострофа
; вже поданий звичайним рядком. У людській таблиці Markdown
; сам апостроф не потребує додаткового кодування.
(визначити текст-слова-поверхні
  (функція (слово)
    (за-умовою
      ((однакові? слово (як-є ())) "()")
      ((тотожне? (класифікувати-рядкове-значення слово) (class-membership string member))
       слово)
      ((тотожне? (класифікувати-рядкове-значення слово) (class-membership string nonmember))
       (значення-у-текст слово)))))

; У машинному файлі .lisp окремий апостроф не можна виводити
; без лапок: наступний читач сприйме його як скорочення цитування.
; Значення типу String треба екранувати та взяти в лапки,
; а Symbol лишити символом. Цю відмінність уже забезпечує
; чинне перетворення значення в текст.
(визначити текст-слова-машинної-проєкції значення-у-текст)

; Додавання рядків є двомісним; для довільної кількості
; складників використовуємо невелику обгортку над згортанням.
(визначити рядок+
  (функція аргументи (згорнути (функція (накопичувач с) (рядок-додати накопичувач с)) "" аргументи)))

; Історичний SID надходить із реєстру як точний восьмибітний
; текст; генератор зберігає його дослівно й не змінює формат.

; Поверхні містять фіксовані пари (мова слово), де слово — назва або ().
(визначити знайти-поверхню
  (функція (мова поверхні)
    (за-умовою
      ((атом? поверхні) (як-є ()))
      
      ((тотожне? (перше (перше поверхні)) мова) (перше поверхні))
      ((атом? (як-є ())) (знайти-поверхню мова (решта поверхні))))))

(визначити слово-поверхні
  (функція (запис-поверхні)
    (за-умовою ((атом? запис-поверхні) (як-є ())) ((атом? (як-є ())) (перше (решта запис-поверхні))))))

(визначити отримати-поверхню
  (функція (мова поверхні)
    (слово-поверхні (знайти-поверхню мова поверхні))))

(визначити поверхня-придатна?
  (функція (слово)
    (хибне? (однакові? слово (як-є ())))))

; Формальна назва для історичної проєкції: перша наявна
; серед en, ук і sa; інакше сам історичний ідентифікатор.
; Восьмибітний SID у цій таблиці зберігаємо текстом, зокрема
; початкові нулі: арифметичне перетворення тут неприпустиме.
(визначити біти-ід
  (функція (ід)
    (значення-у-текст ід)))

(визначити заглушка-формального
  (функція (ід поверхні)
    (нехай-послідовно ((англ (отримати-поверхню (як-є en) поверхні))
           (ук (отримати-поверхню (як-є ук) поверхні))
           (санскр (отримати-поверхню (як-є sa) поверхні)))
      (за-умовою
        ((поверхня-придатна? англ)
         (рядок+ "identity:" (біти-ід ід) "/surface:" (текст-слова-поверхні англ)))
        ((поверхня-придатна? ук)
         (рядок+ "identity:" (біти-ід ід) "/surface:" (текст-слова-поверхні ук)))
        ((поверхня-придатна? санскр)
         (рядок+ "identity:" (біти-ід ід) "/surface:" (текст-слова-поверхні санскр)))
        ((атом? (як-є ())) (рядок-додати "identity:" (біти-ід ід)))))))

; Для історичної проєкції немає вимоги повноти в 256 рядків.
; Точні домени розвиваються за власними ширинами, зайнятістю
; координат і допущеними законами.

; З'єднання рядків через новий рядок із накопичувачем.
; Наївна рекурсія тут не є хвостовою, бо виклик міститься
; в аргументах додавання рядків. Вона переповнила б стек
; до оброблення всіх рядків реєстру. Тому використовуємо
; схему накопичення, сумісну з іншими обходами ядра.
(визначити зєднати-новим-рядком-у
  (функція (рядки-рядків накопичувач)
    (за-умовою
      ((атом? рядки-рядків) накопичувач)
      
      ((тотожне? накопичувач "") (зєднати-новим-рядком-у (решта рядки-рядків) (перше рядки-рядків)))
      ((атом? (як-є ())) (зєднати-новим-рядком-у (решта рядки-рядків) (рядок+ накопичувач "
" (перше рядки-рядків)))))))

(визначити зєднати-новим-рядком (функція (рядки-рядків) (зєднати-новим-рядком-у рядки-рядків "")))

(визначити сформувати-рядок-машинної-проєкції
  (функція (запис)
    (нехай-послідовно ((ід (перше запис))
           (поверхні (решта запис))
           (ук (отримати-поверхню (як-є ук) поверхні))
           (укр (отримати-поверхню (як-є укр) поверхні))
           (англ (отримати-поверхню (як-є en) поверхні))
           (санскр (отримати-поверхню (як-є sa) поверхні))
           (симв (отримати-поверхню (як-є sym) поверхні))
           (формальне (заглушка-формального ід поверхні)))
      (рядок+
        "  (" (біти-ід ід) " " формальне
        " (ук " (текст-слова-машинної-проєкції ук) ")"
        " (укр " (текст-слова-машинної-проєкції укр) ")"
        " (en " (текст-слова-машинної-проєкції англ) ")"
        " (sa " (текст-слова-машинної-проєкції санскр) ")"
        " (sym " (текст-слова-машинної-проєкції симв) ")"
        " my-lisp)"))))

(визначити сформувати-рядок-документної-проєкції
  (функція (запис)
    (нехай-послідовно ((ід (перше запис))
           (поверхні (решта запис))
           (ук (отримати-поверхню (як-є ук) поверхні))
           (укр (отримати-поверхню (як-є укр) поверхні))
           (англ (отримати-поверхню (як-є en) поверхні))
           (санскр (отримати-поверхню (як-є sa) поверхні))
           (симв (отримати-поверхню (як-є sym) поверхні)))
      (рядок+
        "| `" (біти-ід ід) "` | " (текст-слова-поверхні ук)
        " | " (текст-слова-поверхні укр)
        " | " (текст-слова-поверхні англ)
        " | " (текст-слова-поверхні санскр)
        " | " (текст-слова-поверхні симв)
        " | " (шлях-машини ід)
        " | " (мітка-макарті ід) " |"))))

(визначити заголовок-машинної-проєкції
  (список
    "; ЗГЕНЕРОВАНО — НЕ РЕДАГУВАТИ ВРУЧНУ"
    "; ІСТОРИЧНА МІГРАЦІЙНА ПРОЄКЦІЯ — НЕ СЕМАНТИЧНА ВЛАДА"
    "; Донор: lib/surface/semantic-registry.lisp"
    "; Генератор: scripts/generate-function-table.lisp"
    "; Схема ft-2: (legacy-bitstring formal ук укр en sa sym projection)"
    "; ук — чинна коротка українська проєкція; укр — повна українська проєкція"
    "; Порядок читання: ук → укр → англійська → санскрит"
    "; поле projection — лише історичний/міграційний огляд"
    ""
    "(ft-2"))

(визначити тіло-машинної-проєкції (зєднати-новим-рядком (приєднати заголовок-машинної-проєкції (відобразити сформувати-рядок-машинної-проєкції записи))))
(визначити вміст-машинної-проєкції (рядок-додати (рядок-додати тіло-машинної-проєкції "
)") "
"))

(визначити заголовок-документної-проєкції
  (список
    "# Таблиця функцій (похідна проєкція)"
    ""
    "**Статус:** історична міграційна проєкція. Канонічну тотожність задають точні домени та допущені закони, а не ця плоска таблиця."
    ""
    "**Машинна проєкція:** `lib/machine/intel-core-i5-6400.lisp` описує лише фізичні шляхи виконання; семантики мови не створює."
    ""
    "**Історична проєкція:** `contracts/core1-historical-sid-map.lisp` — одностороннє зіставлення SID з механізмами Маккарті 1960 / Lisp 1.5, звірене з `juv4uk/mccarthy-eval`. Воно не створює нових тотожностей і не визначає семантику."
    ""
    "Відтворити: `cargo run -p sens-cli --bin sens -- scripts/generate-function-table.lisp`"
    ""
    "| ІД | ук | укр | Англійська | Санскрит | Символ | Intel Core i5-6400 / Skylake | Маккарті 1960 / Lisp 1.5 (Core1) |"
    "|----|----|-----|---------|----------|--------|------------------------------|-----------------------------------|"))

(визначити тіло-документної-проєкції (зєднати-новим-рядком (приєднати заголовок-документної-проєкції (відобразити сформувати-рядок-документної-проєкції записи))))
(визначити вміст-документної-проєкції (рядок-додати тіло-документної-проєкції "
"))

(визначити шлях-машинної-проєкції "lib/generated/function-table.lisp")
(визначити шлях-документної-проєкції "docs/generated/function-table.md")

(визначити записати-проєкції
  (функція ()
    (друге
      (список
        (записати-файл шлях-машинної-проєкції вміст-машинної-проєкції)
        (записати-файл шлях-документної-проєкції вміст-документної-проєкції)
        (друкувати
          (рядок+
            "function-table: "
            (число-рядок (довжина записи))
            " історичних рядків проєкції записано"))))))

; Значення проєкцій і перемикач аргументів — рядки, тобто атоми.
; Зіставляємо їх точним D3:101 EQ, а не ширшим D8:11110111 EQUAL.
; Це уточнення мовної тотожності, без тверджень про розмір T5.
(визначити перевірити-проєкції
  (функція ()
    (нехай ((поточна-машинна-проєкція (читати-файл шлях-машинної-проєкції))
          (поточна-документна-проєкція (читати-файл шлях-документної-проєкції)))
      (за-умовою
        ((тотожне? поточна-машинна-проєкція вміст-машинної-проєкції)
         (за-умовою
           ((тотожне? поточна-документна-проєкція вміст-документної-проєкції)
            (друкувати
              (рядок+
                "function-table: "
                (число-рядок (довжина записи))
                " історичних рядків проєкції актуально")))
           ((атом? (як-є ()))
            (друге
              (список
                (друкувати "таблиця функцій: застаріла документна проєкція")
                (перше (як-є ())))))))
        ((атом? (як-є ()))
         (друге
           (список
             (друкувати "таблиця функцій: застаріла Lisp-проєкція")
             (перше (як-є ())))))))))

(за-умовою
  ((атом? *argv*)
   (записати-проєкції))
  ((тотожне? (перше *argv*) "--check")
   (перевірити-проєкції))
  ((атом? (як-є ()))
   (записати-проєкції)))
