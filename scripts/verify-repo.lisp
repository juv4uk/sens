;; ===== Українська документація й розкладка (з xtask verify) =====

(визначити поле-запису (функція (ключ форма) (друге (знайти-за-ключем ключ (решта форма)))))

(визначити кількість-елементів
  (функція (елементи)
    (за-умовою
      ((атом? елементи) () 0)
      ((атом? елементи) (0) (додати 1 (кількість-елементів (решта елементи)))))))

(визначити останній-знак
  (функція (текст)
    (рядок-зріз текст (відняти (рядок-довжина текст) 1) (рядок-довжина текст))))

; Стабільні українські назви з таблиці функцій: ((бітовий-код . назва) ...).
(визначити рядки-реєстру (перше (читати-всі (читати-файл "lib/surface/semantic-registry.lisp"))))

(визначити сталі-українські-пари
  (функція (рядки)
    (за-умовою
      ((атом? рядки) () (як-є ()))
      ((атом? рядки) (0)
       (нехай ((назва (поле-запису (як-є ук) (перше рядки))))
         (за-умовою
           ((атом? назва) (1)
            (сполучити (сполучити (значення-у-текст (перше (перше рядки))) (символ-у-текст назва))
                  (сталі-українські-пари (решта рядки))))
           (так так (сталі-українські-пари (решта рядки)))))))))

(визначити сталі-українські-назви (сталі-українські-пари рядки-реєстру))

; Документаційний індекс: (doc категорія КОД вид "сигнатура" "опис"), КОД — голі 8 біт.
(визначити українські-описи-функцій (решта (знайти-за-ключем (як-є docs) (решта (перше (читати-всі (читати-файл "lib/surface/uk-docs.lisp")))))))
; Текстовий запис SENS для перевірок і join: голі 8 біт дають рівно 8 знаків,
; а SENS у лапках (текстовий сурогат) — 10, і перевірка його відкидає.
(визначити код-документації (функція (опис) (значення-у-текст (третє опис))))
(визначити вид-документації (функція (опис) (четверте опис)))
(визначити текст-довідника (читати-файл "docs/ukrainian-api.md"))

(визначити українська-назва-за-кодом
  (функція (код)
    (нехай ((знайдене (знайти-за-ключем код сталі-українські-назви)))
      (за-умовою
        ((атом? знайдене) (0) (решта знайдене))
        (так так (повідомити-про-помилку-репозиторію (поєднати-рядки "документаційний ID " код " не має стабільної української проєкції в реєстрі")))))))

(визначити усі-біти?
  (функція (текст)
    (за-умовою
      ((рядок-порожній? текст) (1) так)
      ((рядок-містить? (рядок-перший текст) "01") так (усі-біти? (рядок-решта текст)))
      (так так (як-є ())))))

(визначити перевірити-описи-функцій
  (функція (документи предикати мутації)
    (за-умовою
      ((атом? документи) ()
       (за-умовою
         ((менше? 10 предикати) 1
          (за-умовою
            ((менше? 0 мутації) 1 так)
            (так так (повідомити-про-помилку-репозиторію "публічний каталог мутацій схлопнувся"))))
         (так так (повідомити-про-помилку-репозиторію "публічний каталог предикатів схлопнувся"))))
      ((атом? документи) (0)
       (нехай ((код (код-документації (перше документи))) (вид (вид-документації (перше документи))))
         (за-умовою
           ((однакові? (рядок-довжина код) 8) (0)
            (повідомити-про-помилку-репозиторію (поєднати-рядки "ключ зіставлення документації має бути 8-бітним SID: " код)))
           ((усі-біти? код) () (повідомити-про-помилку-репозиторію (поєднати-рядки "ключ зіставлення документації має бути 8-бітним SID: " код)))
           (так так
            (нехай ((українське-ім'я (українська-назва-за-кодом код)))
              (нехай ((питальний-знак (однакові? (останній-знак українське-ім'я) "?"))
                    (знак-оклику (однакові? (останній-знак українське-ім'я) "!"))
                    (предикат (однакові? вид (як-є predicate)))
                    (мутація (однакові? вид (як-є mutation))))
                (за-умовою
                  ((однакові? питальний-знак предикат) (0)
                   (повідомити-про-помилку-репозиторію (поєднати-рядки "українська назва " українське-ім'я ": знак ? і predicate мусять збігатися")))
                  ((однакові? знак-оклику мутація) (0)
                   (повідомити-про-помилку-репозиторію (поєднати-рядки українське-ім'я ": ! зарезервований для мутації")))
                  (мутація (1)
                   (за-умовою
                     ((однакові? українське-ім'я "встановити-елемент-вектора!") (1)
                      (перевірити-описи-функцій (решта документи) предикати (додати мутації 1)))
                     (так так (повідомити-про-помилку-репозиторію (поєднати-рядки "несподівана мутація: " українське-ім'я)))))
                  (предикат (1)
                   (перевірити-описи-функцій (решта документи) (додати предикати 1) мутації))
                  (так так (перевірити-описи-функцій (решта документи) предикати мутації))))))))))))

(перевірити-описи-функцій українські-описи-функцій 0 0)
(повідомити-успішну-перевірку "dokumentatsiinyi-kliuch-ie-tilky-numeric")
(повідомити-успішну-перевірку "znak-pytannia-tochno-vidpovidaie-predykatam")
(повідомити-успішну-перевірку "znak-oklyku-tochno-vidpovidaie-mutatsii")

; Усі ID документації є в таблиці; усі задокументовані назви — у Markdown.
(визначити перевірити-рядки-довідника
  (функція (пари)
    (за-умовою
      ((атом? пари) () так)
      ((атом? пари) (0)
       (нехай ((код (перше (перше пари))) (українське-ім'я (решта (перше пари))))
         (за-умовою
           ((атом? (знайти-за-ключем код (відобразити (функція (опис) (сполучити (код-документації опис) так)) українські-описи-функцій))) ()
            (перевірити-рядки-довідника (решта пари)))
           ((рядок-містить? (поєднати-рядки "| `" українське-ім'я "` |") текст-довідника) так (перевірити-рядки-довідника (решта пари)))
           (так так (повідомити-про-помилку-репозиторію (поєднати-рядки "публічне українське ім'я відсутнє у Markdown-довіднику: " українське-ім'я)))))))))

(за-умовою
  ((менше? 50 (кількість-елементів сталі-українські-назви)) 1 (перевірити-рядки-довідника сталі-українські-назви))
  (так так (повідомити-про-помилку-репозиторію "замало стабільних українських назв у таблиці")))
(повідомити-успішну-перевірку "vsi-stable-ukrainski-nazvy-maiut-numeric-zapys-u-dovidnyku")

; Смисловий аудит назв: підсумок збігається з даними.
(визначити аудит-імен (перше (читати-всі (читати-файл "lib/surface/uk-name-audit.lisp"))))
(визначити перейменування-аудиту (решта (знайти-за-ключем (як-є renames) (решта аудит-імен))))
(визначити перевірено (поле-запису (як-є stable-reviewed) аудит-імен))
(визначити перейменовано (поле-запису (як-є renamed) аудит-імен))
(визначити збережено (поле-запису (як-є retained) аудит-імен))
(за-умовою
  ((однакові? перевірено (додати перейменовано збережено)) (1)
   (за-умовою
     ((однакові? перейменовано (кількість-елементів перейменування-аудиту)) (1)
      (за-умовою
        ((однакові? перевірено (кількість-елементів українські-описи-функцій)) (1) так)
        (так так (повідомити-про-помилку-репозиторію "смисловий аудит мусить точно покривати задокументовану українську поверхню"))))
     (так так (повідомити-про-помилку-репозиторію "(renamed N) розійшовся з фактичною кількістю (rename ...)"))))
  (так так (повідомити-про-помилку-репозиторію "stable-reviewed мусить дорівнювати renamed+retained")))
(повідомити-успішну-перевірку "smyslovyi-audyt-summary-zbihaietsia-z-faktychnymy-danymy")

(визначити українська-поверхня (читати-файл "lib/surface/uk.lisp"))
(визначити семантичний-реєстр
  (перше (читати-всі (читати-файл "lib/surface/semantic-registry.lisp"))))
; Англійська проєкція → точна тотожність СЕНС з єдиного семантичного реєстру.
(визначити код-сенс-для-англійського-імені
  (функція (назва рядки)
    (за-умовою
      ((атом? рядки) () ())
      ((однакові? (поле-запису (як-є en) (перше рядки)) назва) (1)
       (перше (перше рядки)))
      (так так (код-сенс-для-англійського-імені назва (решта рядки))))))

; Кожен перевірений сумісний псевдонім містить точну тотожність СЕНС.
; Так ні примітиви хоста, ні мовні функції не залежать від англійського імені під час виконання.

; Позиція першого входження зразка в рядок від заданого місця; -1 якщо немає.
(визначити позиція-зразка
  (функція (рядок зразок позиція)
    (за-умовою
      ((рядок-порожній? рядок) (1) -1)
      ((рядок-префікс? зразок рядок) так позиція)
      (так так (позиція-зразка (рядок-решта рядок) зразок (додати позиція 1))))))

(за-умовою
  ((менше? (позиція-зразка українська-поверхня "(00001001 середовище env)" 0) 0) так
   (повідомити-про-помилку-репозиторію "uk.lisp: (00001001 середовище env) мусить бути лише в реєстрі, не в поверхні"))
  (так так так))
(повідомити-успішну-перевірку "seredovyshche-ne-maie-povtornoho-surface-binding")

(визначити перевірити-сумісні-імена
  (функція (перейменування)
    (за-умовою
      ((атом? перейменування) () так)
      ((атом? перейменування) (0)
       (нехай ((англійське-ім'я (друге (перше перейменування)))
             (старе-ім'я (третє (перше перейменування)))
             (код-сенс (код-сенс-для-англійського-імені
                     (друге (перше перейменування))
                     семантичний-реєстр)))
         (за-умовою
           ((атом? код-сенс) ()
            (повідомити-про-помилку-репозиторію
              (поєднати-рядки "англійської проєкції з аудиту немає в семантичному реєстрі: "
                    (символ-у-текст англійське-ім'я))))
           ((рядок-містить?
              (поєднати-рядки "(00001001 " (символ-у-текст старе-ім'я) " " (значення-у-текст код-сенс) ")")
              українська-поверхня)
            так
            (перевірити-сумісні-імена (решта перейменування)))
           (так так
            (повідомити-про-помилку-репозиторію
              (поєднати-рядки "відсутній сумісний псевдонім точної тотожності СЕНС (00001001 "
                    (символ-у-текст старе-ім'я) " " (значення-у-текст код-сенс) ")")))))))))
(перевірити-сумісні-імена перейменування-аудиту)
(повідомити-успішну-перевірку "stari-nazvy-smystovoho-audytu-lyshaiutsia-aliasamy-sumisnosti")

; Розкладка: українські назви набираються без латиниці.
(визначити українська-розкладка
  "абвгґдеєжзиіїйклмнопрстуфхцчшщьюяАБВГҐДЕЄЖЗИІЇЙКЛМНОПРСТУФХЦЧШЩЬЮЯ0123456789-?!'*")

(визначити набирається?
  (функція (текст)
    (за-умовою
      ((рядок-порожній? текст) (1) так)
      ((рядок-містить? (рядок-перший текст) українська-розкладка) так (набирається? (рядок-решта текст)))
      (так так (як-є ())))))

(визначити перевірити-набирання
  (функція (пари)
    (за-умовою
      ((атом? пари) () так)
      ((атом? пари) (0)
       (за-умовою
         ((набирається? (решта (перше пари))) так (перевірити-набирання (решта пари)))
         (так так (повідомити-про-помилку-репозиторію (поєднати-рядки "Українська назва вимагає іншої клавіатурної розкладки: " (решта (перше пари))))))))))
(перевірити-набирання сталі-українські-назви)
(повідомити-успішну-перевірку "every-stable-ukrainian-name-is-typeable-on-the-ukrainian-layout")

(визначити латинська-літера?
  (функція (знак)
    (нехай ((числовий-код (код-символу знак)))
      (за-умовою
        ((менше? числовий-код 65) 1 (як-є ()))
        ((менше? числовий-код 91) 1 так)
        ((менше? числовий-код 97) 1 (як-є ()))
        ((менше? числовий-код 123) 1 так)
        (так так (як-є ()))))))

; Латинські літери у виконуваному коді: поза рядками й коментарями.
(визначити латиниця-у-коді
  (функція (текст у-рядку у-коментарі знайдене)
    (за-умовою
      ((рядок-порожній? текст) (1) знайдене)
      (так так
       (нехай ((символ (рядок-перший текст)) (решта-тексту (рядок-решта текст)))
         (за-умовою
           ((однакові? у-коментарі так) (1)
            (латиниця-у-коді решта-тексту () (за-умовою ((однакові? символ "\n") (1) ()) (так так так)) знайдене))
           ((однакові? у-рядку так) (1)
            (за-умовою
              ((однакові? символ "\\") (1) (латиниця-у-коді (рядок-решта решта-тексту) так () знайдене))
              ((однакові? символ "\"") (1) (латиниця-у-коді решта-тексту () () знайдене))
              (так так (латиниця-у-коді решта-тексту так () знайдене))))
           ((однакові? символ ";") (1) (латиниця-у-коді решта-тексту () так знайдене))
           ((однакові? символ "\"") (1) (латиниця-у-коді решта-тексту так () знайдене))
           ((латинська-літера? символ) так (латиниця-у-коді решта-тексту () () (рядок-додати знайдене символ)))
           (так так (латиниця-у-коді решта-тексту () () знайдене))))))))

(визначити вимагати-без-латиниці
  (функція (назва шлях)
    (нехай ((знайдене (латиниця-у-коді (читати-файл шлях) () () "")))
      (за-умовою
        ((рядок-порожній? знайдене) (1) (повідомити-успішну-перевірку назва))
        (так так (повідомити-про-помилку-репозиторію (поєднати-рядки назва ": латинські літери у виконуваному коді " шлях ": " знайдене)))))))

(вимагати-без-латиниці "ukrainian-acceptance-program-code-never-requires-latin-layout"
  "lib/surface/uk-acceptance.lisp")
(вимагати-без-латиниці "ukrainska-prohrama-pryinnyattia-ne-potrebuie-latynskoi-rozkladky"
