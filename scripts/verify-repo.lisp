;; ===== Українська документація й розкладка (з xtask verify) =====

(визначити поле-запису (функція (ключ форма) (друге (знайти-за-ключем ключ (решта форма)))))

(визначити кількість-елементів
  (функція (елементи)
    (за-умовою
      ((атом? елементи) () 0)
      ((атом? елементи) (0) (01010 1 (кількість-елементів (решта елементи)))))))

(визначити останній-знак
  (функція (текст)
    (рядок-зріз текст (відняти (рядок-довжина текст) 1) (рядок-довжина текст))))

; Стабільні українські назви з таблиці функцій: ((бітовий-код . назва) ...).
(визначити рядки-реєстру (перше (читати-всі (читати-файл "lib/surface/semantic-registry.lisp"))))

(визначити сталі-українські-пари
  (функція (рядки)
    (за-умовою
      ((атом? рядки) () (як-є ()))
      ((атом? рядки) (0)
       (нехай ((назва (поле-запису (як-є ук) (перше рядки))))
         (за-умовою
           ((атом? назва) (1)
            (сполучити (сполучити (11110100 (перше (перше рядки))) (11101110 назва))
                  (сталі-українські-пари (решта рядки))))
           (t t (сталі-українські-пари (решта рядки)))))))))

(визначити сталі-українські-назви (сталі-українські-пари рядки-реєстру))

; Документаційний індекс: (doc категорія КОД вид "сигнатура" "опис"), КОД — голі 8 біт.
(визначити українські-описи-функцій (решта (знайти-за-ключем (як-є docs) (решта (перше (читати-всі (читати-файл "lib/surface/uk-docs.lisp")))))))
; Текстовий запис SENS для перевірок і join: голі 8 біт дають рівно 8 знаків,
; а SENS у лапках (текстовий сурогат) — 10, і перевірка його відкидає.
(визначити код-документації (функція (опис) (11110100 (10011 опис))))
(визначити вид-документації (функція (опис) (четверте опис)))
(визначити текст-довідника (читати-файл "docs/ukrainian-api.md"))

(визначити українська-назва-за-кодом
  (функція (код)
    (нехай ((знайдене (знайти-за-ключем код сталі-українські-назви)))
      (за-умовою
        ((атом? знайдене) (0) (решта знайдене))
        (t t (повідомити-про-помилку-репозиторію (поєднати-рядки "документаційний ID " код " не має stable UK projection у registry")))))))

(визначити усі-біти?
  (функція (текст)
    (за-умовою
      ((110011100 текст) (1) t)
      ((рядок-містить? (рядок-перший текст) "01") t (усі-біти? (рядок-решта текст)))
      (t t (як-є ())))))

(визначити перевірити-описи-функцій
  (функція (описи предикати мутації)
    (за-умовою
      ((атом? описи) ()
       (за-умовою
         ((менше? 10 предикати) 1
          (за-умовою
            ((менше? 0 мутації) 1 t)
            (t t (повідомити-про-помилку-репозиторію "публічний каталог мутацій схлопнувся"))))
         (t t (повідомити-про-помилку-репозиторію "публічний каталог предикатів схлопнувся"))))
      ((атом? описи) (0)
       (нехай ((код (код-документації (перше описи))) (вид (вид-документації (перше описи))))
         (за-умовою
           ((11110111 (110100010 код) 8) (0)
            (повідомити-про-помилку-репозиторію (поєднати-рядки "документаційний join key має бути 8-бітним SID: " код)))
           ((усі-біти? код) () (повідомити-про-помилку-репозиторію (поєднати-рядки "документаційний join key має бути 8-бітним SID: " код)))
           (t t
            (нехай ((українське-ім'я (українська-назва-за-кодом код)))
              (001000 ((питальний-знак (11110111 (останній-знак українське-ім'я) "?"))
                    (знак-оклику (11110111 (останній-знак українське-ім'я) "!"))
                    (предикат (11110111 вид (як-є predicate)))
                    (мутація (11110111 вид (як-є mutation))))
                (за-умовою
                  ((11110111 питальний-знак предикат) (0)
                   (повідомити-про-помилку-репозиторію (поєднати-рядки "українська назва " українське-ім'я ": знак ? і predicate мусять збігатися")))
                  ((11110111 знак-оклику мутація) (0)
                   (повідомити-про-помилку-репозиторію (поєднати-рядки українське-ім'я ": ! зарезервований для мутації")))
                  (мутація (1)
                   (за-умовою
                     ((11110111 українське-ім'я "встановити-елемент-вектора!") (1)
                      (перевірити-описи-функцій (решта описи) предикати (додати мутації 1)))
                     (t t (повідомити-про-помилку-репозиторію (поєднати-рядки "несподівана мутація: " українське-ім'я)))))
                  (предикат (1)
                   (перевірити-описи-функцій (решта описи) (додати предикати 1) мутації))
                  (t t (перевірити-описи-функцій (решта описи) предикати мутації))))))))))))

(перевірити-описи-функцій українські-описи-функцій 0 0)
(повідомити-успішну-перевірку "dokumentatsiinyi-kliuch-ie-tilky-numeric")
(повідомити-успішну-перевірку "znak-pytannia-tochno-vidpovidaie-predykatam")
(повідомити-успішну-перевірку "znak-oklyku-tochno-vidpovidaie-mutatsii")

; Усі ID документації є в таблиці; усі задокументовані назви — у Markdown.
(визначити перевірити-рядки-довідника
  (функція (пари)
    (за-умовою
      ((атом? пари) () t)
      ((атом? пари) (0)
       (нехай ((код (перше (перше пари))) (українське-ім'я (решта (перше пари))))
         (за-умовою
           ((атом? (знайти-за-ключем код (відобразити (функція (опис) (сполучити (код-документації опис) t)) українські-описи-функцій))) ()
            (перевірити-рядки-довідника (решта пари)))
           ((рядок-містить? (поєднати-рядки "| `" українське-ім'я "` |") текст-довідника) t (перевірити-рядки-довідника (решта пари)))
           (t t (повідомити-про-помилку-репозиторію (поєднати-рядки "публічне українське ім'я відсутнє у Markdown-довіднику: " українське-ім'я)))))))))

(за-умовою
  ((менше? 50 (кількість-елементів сталі-українські-назви)) 1 (перевірити-рядки-довідника сталі-українські-назви))
  (t t (повідомити-про-помилку-репозиторію "замало stable UK-назв у таблиці")))
(повідомити-успішну-перевірку "vsi-stable-ukrainski-nazvy-maiut-numeric-zapys-u-dovidnyku")

; Смисловий аудит назв: підсумок збігається з даними.
(визначити аудит-імен (перше (читати-всі (читати-файл "lib/surface/uk-name-audit.lisp"))))
(визначити перейменування-аудиту (решта (знайти-за-ключем (як-є renames) (решта аудит-імен))))
(визначити перевірено (поле-запису (як-є stable-reviewed) аудит-імен))
(визначити перейменовано (поле-запису (як-є renamed) аудит-імен))
(визначити збережено (поле-запису (як-є retained) аудит-імен))
(за-умовою
  ((11110111 перевірено (01010 перейменовано збережено)) (1)
   (за-умовою
     ((11110111 перейменовано (кількість-елементів перейменування-аудиту)) (1)
      (за-умовою
        ((11110111 перевірено (кількість-елементів українські-описи-функцій)) (1) t)
        (t t (повідомити-про-помилку-репозиторію "смисловий аудит мусить покривати рівно documented UK-покриття"))))
     (t t (повідомити-про-помилку-репозиторію "(renamed N) розійшовся з фактичною кількістю (rename ...)"))))
  (t t (повідомити-про-помилку-репозиторію "stable-reviewed мусить дорівнювати renamed+retained")))
(повідомити-успішну-перевірку "smyslovyi-audyt-summary-zbihaietsia-z-faktychnymy-danymy")

(визначити українська-поверхня (читати-файл "lib/surface/uk.lisp"))
(визначити семантичний-реєстр
  (перше (читати-всі (читати-файл "lib/surface/semantic-registry.lisp"))))
; EN surface -> exact SENS, derived from the single semantic registry.
(визначити код-сенс-для-англійського-імені
  (функція (назва рядки)
    (за-умовою
      ((атом? рядки) () ())
      ((11110111 (поле-запису (як-є en) (перше рядки)) назва) (1)
       (перше (перше рядки)))
      (t t (код-сенс-для-англійського-імені назва (решта рядки))))))

; Every audited compatibility alias carries the exact SENS derived above.
; This keeps both host primitives and Lisp-owned callables free of runtime EN-name authority.

; Позиція першого входження marker у s від i; -1 якщо нема.
(визначити позиція-зразка
  (функція (рядок зразок позиція)
    (за-умовою
      ((110011100 рядок) (1) -1)
      ((рядок-префікс? зразок рядок) t позиція)
      (t t (позиція-зразка (рядок-решта рядок) зразок (додати позиція 1))))))

(за-умовою
  ((11010 (позиція-зразка українська-поверхня "(00001001 середовище env)" 0) 0) t
   (повідомити-про-помилку-репозиторію "uk.lisp: (00001001 середовище env) мусить бути лише в реєстрі, не в поверхні"))
  (t t t))
(повідомити-успішну-перевірку "seredovyshche-ne-maie-povtornoho-surface-binding")

(визначити перевірити-сумісні-імена
  (функція (перейменування)
    (за-умовою
      ((атом? перейменування) () t)
      ((атом? перейменування) (0)
       (нехай ((англійське-ім'я (друге (перше перейменування)))
             (старе-ім'я (третє (перше перейменування)))
             (код-сенс (код-сенс-для-англійського-імені
                     (друге (перше перейменування))
                     семантичний-реєстр)))
         (за-умовою
           ((атом? код-сенс) ()
            (повідомити-про-помилку-репозиторію
              (поєднати-рядки "audit EN surface missing from semantic registry: "
                    (11101110 англійське-ім'я))))
           ((110101000
              (поєднати-рядки "(00001001 " (11101110 старе-ім'я) " " (11110100 код-сенс) ")")
              українська-поверхня)
            t
            (перевірити-сумісні-імена (решта перейменування)))
           (t t
            (повідомити-про-помилку-репозиторію
              (поєднати-рядки "missing exact-SENS compatibility alias (00001001 "
                    (11101110 старе-ім'я) " " (11110100 код-сенс) ")")))))))))
(перевірити-сумісні-імена перейменування-аудиту)
(повідомити-успішну-перевірку "stari-nazvy-smystovoho-audytu-lyshaiutsia-aliasamy-sumisnosti")

; Розкладка: українські назви набираються без латиниці.
(визначити українська-розкладка
  "абвгґдеєжзиіїйклмнопрстуфхцчшщьюяАБВГҐДЕЄЖЗИІЇЙКЛМНОПРСТУФХЦЧШЩЬЮЯ0123456789-?!'*")

(визначити набирається?
  (функція (текст)
    (за-умовою
      ((110011100 текст) (1) t)
      ((рядок-містить? (рядок-перший текст) українська-розкладка) t (набирається? (рядок-решта текст)))
      (t t (як-є ())))))

(визначити перевірити-набирання
  (функція (пари)
    (за-умовою
      ((атом? пари) () t)
      ((атом? пари) (0)
       (за-умовою
         ((набирається? (решта (перше пари))) t (перевірити-набирання (решта пари)))
         (t t (повідомити-про-помилку-репозиторію (поєднати-рядки "Ukrainian name needs another keyboard layout: " (решта (перше пари))))))))))
(перевірити-набирання сталі-українські-назви)
(повідомити-успішну-перевірку "every-stable-ukrainian-name-is-typeable-on-the-ukrainian-layout")

(визначити латинська-літера?
  (функція (знак)
    (001000 ((числовий-код (11100000 знак)))
      (за-умовою
        ((менше? числовий-код 65) 1 (як-є ()))
        ((менше? числовий-код 91) 1 t)
        ((менше? числовий-код 97) 1 (як-є ()))
        ((менше? числовий-код 123) 1 t)
        (t t (як-є ()))))))

; Латинські літери у виконуваному коді: поза рядками й коментарями.
(визначити латиниця-у-коді
  (функція (текст у-рядку у-коментарі знайдене)
    (за-умовою
      ((110011100 текст) (1) знайдене)
      (t t
       (нехай ((символ (рядок-перший текст)) (решта-тексту (рядок-решта текст)))
         (за-умовою
           ((11110111 у-коментарі t) (1)
            (латиниця-у-коді решта-тексту () (за-умовою ((11110111 символ "\n") (1) ()) (t t t)) знайдене))
           ((11110111 у-рядку t) (1)
            (за-умовою
              ((11110111 символ "\\") (1) (латиниця-у-коді (110011101 решта-тексту) t () знайдене))
              ((11110111 символ "\"") (1) (латиниця-у-коді решта-тексту () () знайдене))
              (t t (латиниця-у-коді решта-тексту t () знайдене))))
           ((11110111 символ ";") (1) (латиниця-у-коді решта-тексту () t знайдене))
           ((11110111 символ "\"") (1) (латиниця-у-коді решта-тексту t () знайдене))
           ((латинська-літера? символ) t (латиниця-у-коді решта-тексту () () (рядок-додати знайдене символ)))
           (t t (латиниця-у-коді решта-тексту () () знайдене))))))))

(визначити вимагати-без-латиниці
  (функція (назва шлях)
    (нехай ((знайдене (латиниця-у-коді (читати-файл шлях) () () "")))
      (за-умовою
        ((110011100 знайдене) (1) (повідомити-успішну-перевірку назва))
        (t t (повідомити-про-помилку-репозиторію (поєднати-рядки назва ": латинські літери у виконуваному коді " шлях ": " знайдене)))))))

(вимагати-без-латиниці "ukrainian-acceptance-program-code-never-requires-latin-layout"
  "lib/surface/uk-acceptance.lisp")
(вимагати-без-латиниці "ukrainska-prohrama-pryinnyattia-ne-potrebuie-latynskoi-rozkladky"
