; --- Python-перевірки (поки викликаються; перенесення самих скриптів — окремо) ---
(визначити запустити-пайтон-перевірку
  (функція (назва сценарій аргументи)
    (нехай ((результат (процес-запустити "python3" (сполучити сценарій аргументи))))
      (за-умовою
        ((11110111 (перше результат) 0) (1) (повідомити-успішну-перевірку назва))
        ((11110111 (перше результат) 0) (0)
         (повідомити-про-помилку-репозиторію (поєднати-рядки назва " failed\n" (друге результат) (третє результат))))))))

