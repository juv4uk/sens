; Перевірки документації й політик репозиторію — мовою.
; Перша частина перенесення `cargo xtask verify` (crates/xtask/src/checks.rs).
; Разом з українськими перевірками — повна заміна `cargo xtask verify`.
;
; Запуск: sens scripts/verify-repo.lisp
; Друкує кожну перевірку; за першої ж проблеми — помилка й ненульовий вихід.

(визначити поєднати-рядки
  (функція аргументи
    (згорнути (функція (накопичувач частина) (рядок-додати накопичувач частина)) "" аргументи)))

(визначити повідомити-про-помилку-репозиторію
  (функція (повідомлення)
    (друге (список (друкувати (поєднати-рядки "FAIL: " повідомлення)) (перше (як-є ()))))))

(визначити повідомити-успішну-перевірку
  (функція (назва)
    (друкувати (поєднати-рядки "ok: " назва))))

(визначити містить-зразок? (функція (текст зразок) (рядок-містить? зразок текст)))

; Кожен зразок із переліку має бути в тексті; повертаємо відсутні.
(визначити відсутні-зразки
  (функція (текст зразки)
    (за-умовою
      ((атом? зразки) () (як-є ()))
      ((атом? зразки) (0)
       (за-умовою
         ((містить-зразок? текст (перше зразки)) так (відсутні-зразки текст (решта зразки)))
         (так так (сполучити (перше зразки) (відсутні-зразки текст (решта зразки)))))))))

(визначити вимагати-зразки
  (функція (назва шлях зразки)
    (нехай ((відсутні (відсутні-зразки (читати-файл шлях) зразки)))
      (за-умовою
        ((атом? відсутні) () (повідомити-успішну-перевірку назва))
        ((атом? відсутні) (ні) (повідомити-про-помилку-репозиторію (поєднати-рядки назва ": " шлях " бракує " (значення-у-текст відсутні))))))))

(визначити заборонити-зразок
  (функція (назва шлях зразок)
    (за-умовою
      ((містить-зразок? (читати-файл шлях) зразок) так
       (повідомити-про-помилку-репозиторію (поєднати-рядки назва ": " шлях " не має містити " (значення-у-текст зразок))))
      (так так так))))

(визначити містить-будь-який-зразок?
  (функція (текст зразки)
    (за-умовою
      ((атом? зразки) () (як-є ()))
      ((атом? зразки) (0)
       (за-умовою
         ((містить-зразок? текст (перше зразки)) так так)
         (так так (містить-будь-який-зразок? текст (решта зразки))))))))

; --- public-docs-share-current-project-identity-and-extension ---
(визначити перевірити-тотожність-документів
  (функція (шлях)
    (нехай ((документ (читати-файл шлях)))
      (за-умовою
        ((містить-будь-який-зразок? документ (як-є ("reference implementation" "reference Rust implementation" "референсна реалізація" "референсна реалізація Rust")))
         так
         (за-умовою
           ((містить-будь-який-зразок? документ (як-є ("canonical Rust implementation" "канонічна реалізація на Rust" "kanonische Rust-Implementierung")))
            так
            (повідомити-про-помилку-репозиторію (поєднати-рядки шлях ": формулювання не повинне приписувати Rust володіння семантикою")))
           (так так
            (за-умовою
              ((містить-будь-який-зразок? документ (як-є ("канонічне розширення вихідного коду — **`.lisp`**"
                                        "Канонічне розширення вихідного коду — **`.lisp`**"
                                        "canonical source extension is **`.lisp`**"
                                        "current canonical source extension is **`.lisp`**")))
               так
               (за-умовою
                 ((містить-будь-який-зразок? документ (як-є ("legacy alias" "legacy aliases")))
                  так
                  (за-умовою
                    ((містить-зразок? документ "`.wsm`") так
                     (за-умовою
                       ((містить-зразок? документ "`.my`") так так)
                       (так так (повідомити-про-помилку-репозиторію (поєднати-рядки шлях ": потрібно позначити `.my` як історичний псевдонім")))))
                    (так так (повідомити-про-помилку-репозиторію (поєднати-рядки шлях ": потрібно позначити `.wsm` як історичний псевдонім")))))
                 (так так (повідомити-про-помилку-репозиторію (поєднати-рядки шлях ": потрібно назвати `.wsm` і `.my` історичними псевдонімами")))))
              (так так (повідомити-про-помилку-репозиторію (поєднати-рядки шлях ": потрібно зазначити `.lisp` як канонічне розширення")))))))
        (так так (повідомити-про-помилку-репозиторію (поєднати-рядки шлях ": Rust потрібно описати як еталонну реалізацію")))))))

(перевірити-тотожність-документів "README.md")
(перевірити-тотожність-документів "docs/language-core.md")
(повідомити-успішну-перевірку "public-docs-share-current-project-identity-and-extension")

; --- cargo-workspace-has-no-my-lisp-package-prefix ---
; Назва пакета чи бінарної цілі Cargo з префіксом my-lisp — регресія.
(визначити перевірити-маніфести
  (функція (записи)
    (за-умовою
      ((атом? записи) ())
      (так
       (нехай ((маніфест (поєднати-рядки "crates/" (перше записи) "/Cargo.toml")))
         (нехай ((текст (читати-файл маніфест)))
           (за-умовою
             ((містить-зразок? текст "[package]\nname = \"my-lisp")
              (повідомити-про-помилку-репозиторію (поєднати-рядки "порушено префікс назви пакета Cargo: " маніфест " використовує застарілий префікс my-lisp*")))
             ((однакові? маніфест "crates/sens-cli/Cargo.toml")
              (за-умовою
                ((містить-зразок? текст "[[bin]]\nname = \"my-lisp\"")
                 (повідомити-про-помилку-репозиторію "crates/sens-cli/Cargo.toml оголошує застарілу ціль CLI my-lisp"))
                (так (перевірити-маніфести (решта записи))))
             (так (перевірити-маніфести (решта записи)))))))))))

(перевірити-маніфести (read-dir "crates"))
(повідомити-успішну-перевірку "cargo-workspace-has-no-my-lisp-package-prefix")

