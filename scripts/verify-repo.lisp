;; ===== Workflow контракту мови — канонічні шляхи .lisp (з xtask) =====
(визначити перевірити-дію-контракту
  (функція (шлях)
    (нехай ((текст (читати-файл шлях)))
      (за-умовою
        ((рядок-містить? "language-contract.my" текст) t
         (повідомити-про-помилку-репозиторію (поєднати-рядки шлях " still contains removed path language-contract.my")))
        ((рядок-містить? "contracts/my-lisp/lock.my" текст) t
         (повідомити-про-помилку-репозиторію (поєднати-рядки шлях " still contains removed path contracts/my-lisp/lock.my")))
        (t t
         (вимагати-зразки "contract-workflows-use-canonical-lisp-paths" шлях
           (як-є ("default: contracts/my-lisp/language-contract.lisp"
                   "default: contracts/my-lisp/lock.lisp"
                   "UPSTREAM_PATH: language-contract.lisp"))))))))
(перевірити-дію-контракту ".github/workflows/sync-language-contract.yml")
(перевірити-дію-контракту ".github/workflows/verify-language-contract.yml")

