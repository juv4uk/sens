; Verification-only #333 microscope. Never production authority.
; Measures the provenance-specialized read-file candidate on the same
; semantic-registry workload as #379/#394:
;   host-proven exact u8 list -> existing Lisp UTF-8 sequence decoder
;   -> String -> read-all.
;
; `read-file-bytes` materializes std::fs::read Vec<u8> directly as exact Lisp
; numbers 0..255, so this candidate deliberately skips only the redundant
; generic byte-domain pass. UTF-8 sequence interpretation remains in Lisp.

(визначити шлях-профіль-доведених-байтів "lib/surface/semantic-registry.lisp")

(визначити початок-профіль-доведених-байтів (монотонний-наносекунди))
(визначити байти-профіль-доведених-байтів (read-file-bytes шлях-профіль-доведених-байтів))
(визначити після-байтів-профіль-доведених-байтів (монотонний-наносекунди))

(визначити декодоване-профіль-доведених-байтів
  (utf8-decode-onto байти-профіль-доведених-байтів (як-є ())))
(визначити після-декодування-профіль-доведених-байтів (монотонний-наносекунди))

(визначити текст-профіль-доведених-байтів
  (юнікод-скаляри-рядок (друге декодоване-профіль-доведених-байтів)))
(визначити після-рядка-профіль-доведених-байтів (монотонний-наносекунди))

(визначити корінь-профіль-доведених-байтів (перше (читати-всі текст-профіль-доведених-байтів)))
(визначити після-читання-всього-профіль-доведених-байтів (монотонний-наносекунди))

(друкувати
  (список
    (як-є eco-lisp-script-perf/proven-byte-readfile-candidate)
    (список (як-є read-file-bytes-ns)
          (відняти після-байтів-профіль-доведених-байтів початок-профіль-доведених-байтів))
    (список (як-є decode-plus-reverse-ns)
          (відняти після-декодування-профіль-доведених-байтів після-байтів-профіль-доведених-байтів))
    (список (як-є string-assembly-ns)
          (відняти після-рядка-профіль-доведених-байтів після-декодування-профіль-доведених-байтів))
    (список (як-є read-all-ns)
          (відняти після-читання-всього-профіль-доведених-байтів після-рядка-профіль-доведених-байтів))
    (список (як-є total-ns)
          (відняти після-читання-всього-профіль-доведених-байтів початок-профіль-доведених-байтів))
    (список (як-є decode-tag) (перше декодоване-профіль-доведених-байтів))
    (список (як-є root) корінь-профіль-доведених-байтів)))

; opt-in повна укр-поверхня: exact identity = lib/domains/d*.lisp; DEFINE-аліас, без нової диспетчеризації.
(визначити монотонний-наносекунди mono-ns)
(визначити читати-всі read-all)
(визначити юнікод-скаляри-рядок unicode-scalars->string)
