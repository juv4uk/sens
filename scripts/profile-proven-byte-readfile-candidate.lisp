; #333 — дослідний вимір читання файлу без повторної перевірки
; походження байтів. Це не нормативний і не виробничий механізм.
; Навантаження — той самий семантичний реєстр, що й у дослідах #379/#394:
;   підтверджені хостом байти → наявний декодер Юнікод-8 мови СЕНС
;   → рядок → синтаксичне читання.
;
; read-file-bytes повертає точний список байтів із файлової системи.
; У цьому досліді пропускаємо лише зайву загальну перевірку, чи належать
; елементи діапазону байтів. Правила декодування UTF-8 залишаються в SENS.
; Англомовні назви полів звіту зберігаємо як дані зовнішнього протоколу.

(визначити шлях-підтверджених-байтів "lib/surface/semantic-registry.lisp")

(визначити початок-підтверджених-байтів (монотонний-наносекунди))
(визначити прочитані-підтверджені-байти
  (read-file-bytes шлях-підтверджених-байтів))
(визначити після-читання-підтверджених-байтів (монотонний-наносекунди))

(визначити декодовані-підтверджені-байти
  (кодування-юнікод-8-декодувати-до прочитані-підтверджені-байти (як-є ())))
(визначити після-декодування-підтверджених-байтів (монотонний-наносекунди))

(визначити текст-підтверджених-байтів
  (юнікод-скаляри-рядок (друге декодовані-підтверджені-байти)))
(визначити після-створення-рядка-з-байтів (монотонний-наносекунди))

(визначити корінь-підтверджених-байтів (перше (читати-всі текст-підтверджених-байтів)))
(визначити після-читання-форм-з-байтів (монотонний-наносекунди))

(друкувати
  (список
    (як-є eco-lisp-script-perf/proven-byte-readfile-candidate)
    (список (як-є read-file-bytes-ns)
          (відняти після-читання-підтверджених-байтів початок-підтверджених-байтів))
    (список (як-є decode-plus-reverse-ns)
          (відняти після-декодування-підтверджених-байтів після-читання-підтверджених-байтів))
    (список (як-є string-assembly-ns)
          (відняти після-створення-рядка-з-байтів після-декодування-підтверджених-байтів))
    (список (як-є read-all-ns)
          (відняти після-читання-форм-з-байтів після-створення-рядка-з-байтів))
    (список (як-є total-ns)
          (відняти після-читання-форм-з-байтів початок-підтверджених-байтів))
    (список (як-є decode-tag) (перше декодовані-підтверджені-байти))
    (список (як-є root) корінь-підтверджених-байтів)))

; Перехідні прив'язки механізмів, а не нові семантичні закони.
(визначити монотонний-наносекунди mono-ns)
(визначити читати-всі read-all)
(визначити юнікод-скаляри-рядок unicode-scalars->string)
