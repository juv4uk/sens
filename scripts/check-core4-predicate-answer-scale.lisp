; Живий свідок: атом? і тотожне? на порожньому та атомі.

(визначити свідок-предикатів-масштаб
  (функція ()
    (за-умовою
      ((атом? (як-є ()))
       (за-умовою
         ((тотожне? (як-є а) (як-є а))
          (за-умовою
            ((тотожне? (атом? (список (як-є а))) ні)
             (як-є (предикати-масштаб (status pass))))
            (так (як-є (предикати-масштаб (status fail))))))
         (так (як-є (предикати-масштаб (status fail))))))
      (так (як-є (предикати-масштаб (status fail)))))))

(свідок-предикатів-масштаб)
