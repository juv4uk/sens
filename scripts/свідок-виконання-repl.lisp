; Свідок ВИКОНАННЯ портативного веб-REPL.
;
; Першопричина: усі перевірки HTML міряли наявність файлу, тотожність байтів
; або підрядок у тексті — і жодна не доводила, що відвантажена сторінка
; справді ВИКОНУЄ Сенс. Цей файл задає канонічний контракт виконання:
; конкретна програма -> конкретне значення. e2e-вартовий
; (scripts/verify-web-repl-execution.mjs) вводить програму в сторінку й
; вимагає саме очікуване значення; розбіжність = червоний.
;
; Контракт чистий: без I/O, без стану. Значення взяті з ратифікованої
; семантики D5 (додавання) і структури списку.

(визначити контракт-виконання
  (як-є (
    (як-є ((програма "(додати 1 2)") (очікувано "3")))
    (як-є ((програма "(довжина (як-є (а б в)))") (очікувано "3")))
    (як-є ((програма "(атом? 'мама)") (очікувано "так")))
  )))

; Незалежний контроль: сторінка мусить показати ВИДИМУ помилку, якщо WASM
; не ініціалізувався за дедлайн — а не лишитись на «Loading…».
(визначити відмова-видима?
  (функція (рядок-стану)
    (за-умовою
      (рядок-стану ні)
      (так так))))

(визначити ні
  (функція (значення)
    (за-умовою
      (значення хибно)
      (так істинно))))
