; Діагностичний перелік вбудованих механізмів СЕНС, контракт 11.9.
; Відбираємо зв'язування з текстовою ознакою #<builtin у чинному середовищі.
; Це спостереження реалізації, НЕ облік ратифікованих функцій Д1–Д10,
; не свідок виконання фізичного T5M і не дозвіл на реліз.
; Запуск: ./target/release/sens scripts/gen-functions.lisp
; Результат: одна назва вбудованої функції на рядок.
(визначити вбудовані
  (відсіяти
    (функція (пара) (рядок-префікс? "#<builtin" (значення-у-текст (решта пара))))
    (відобразити-середовище)))

(визначити видати-пару
  (функція (пара)
    (показати (перше пара))))

(визначити видати
  (функція (записи)
    (за-умовою
      ((атом? записи) (як-є ()))
      (так (сполучити
           (видати-пару (перше записи))
           (видати (решта записи)))))))

(видати вбудовані)
