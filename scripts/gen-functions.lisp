; Перелік вбудованих функцій за контрактом мови 2.1.
; Відбираємо зв'язування зі значенням, що друкується як #<builtin.
; Запуск: ./target/release/sens scripts/gen-functions.lisp
; Результат: одна назва вбудованої функції на рядок.
(визначити вбудовані
  (відсіяти
    (функція (пара) (рядок-префікс? "#<builtin" (значення-у-текст (решта пара))))
    (відобразити-середовище)))

(визначити видати-пару
  (функція (пара)
    (показати (перше пара))))

(визначити видати
  (функція (записи)
    (за-умовою
      ((атом? записи) (як-є ()))
      ((атом? (як-є ())) (сполучити
           (видати-пару (перше записи))
           (видати (решта записи)))))))

(видати вбудовані)
