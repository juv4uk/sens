;; Live builtin inventory (contract 2.1): every binding whose value prints
;; as #<builtin ...>. Run: ./target/release/my-lisp scripts/gen-functions.lisp
;; Output: one builtin name per line.
(визначити вбудовані
  (відсіяти
    (функція (пара) (рядок-префікс? "#<builtin" (значення-у-текст (решта пара))))
    (відобразити-середовище)))

(визначити видати-пару
  (функція (пара)
    (показати (перше пара))))

(визначити видати
  (функція (записи)
    (за-умовою
      ((атом? записи) (як-є ()))
      ((атом? (як-є ())) (сполучити
           (видати-пару (перше записи))
           (видати (решта записи)))))))

(видати вбудовані)
