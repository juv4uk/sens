; Свідок: виконуваність = bindings ∪ ЗАКОН, а не bindings саме по собі.
;
; Першопричина: D5 мав 6 bindings (арифметичні примітиви) і 8 селекторних
; координат за законом selector_law.rs — і ЖОДНОЇ з них у bindings. Реєстр
; показував 6, тоді як дерево робить виконуваними 14. Два джерела істини
; розходились, і менше з них мовчало.
;
; Інваріант:
;   1) виконувані = bindings ∪ закон (об'єднання, не одне джерело);
;   2) непокрита законом координата НЕ зникає — її названо.
;
; Чистий контракт: без I/O, без стану.

(визначити виконувані
  (функція (bindings закон)
    (обєднання bindings закон)))

(визначити прогалину-зникає?
  (функція (закон bindings)
    ; Завжди НІ: непокрита координата мусить бути названа.
    ні))

(визначити обєднання
  (функція (а б)
    (за-умовою
      ((порожній? а) б)
      ((належить? (перший а) б) (обєднання (решта а) б))
      (так (додати-голову (перший а) (обєднання (решта а) б))))))

(визначити додати-голову (функція (е м) (приєднати е м)))
(визначити належить?
  (функція (е м)
    (за-умовою
      ((порожній? м) ні)
      ((тотожне? е (перший м)) так)
      (так (належить? е (решта м))))))
(визначити перший (функція (м) (голова м)))
(визначити решта (функція (м) (хвіст м)))
(визначити порожній? (функція (м) (тотожне? м (як-є ()))))
(визначити ні хибно)

; Незалежний контроль: об'єднання додає непокрите, і прогалина НІКОЛИ не зникає.
(виконувані (як-є (10100 10101)) (як-є (01100 01101)))
(прогалину-зникає? так)
