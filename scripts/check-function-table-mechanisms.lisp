; #1046 — fail-closed validation for transitional mechanism metadata.
; #3022: #d0/#d1 below are explicit transitional legacy predicate scalars.\n; #b... is now the canonical BinaryNumber source path and must not be used as a tooling boolean.\n; Semantic identity authority is ONLY lib/surface/semantic-registry.lisp.
; This checker proves mechanism metadata cannot invent a function beside that table.
; #1332/#1403: empty-list-ground is not a function mechanism.

(визначити реєстр
  (перше (читати-всі (читати-файл "lib/surface/semantic-registry.lisp"))))

(визначити метадані
  (перше (читати-всі (читати-файл "lib/function-table-mechanisms.lisp"))))

(визначити рядки-реєстру реєстр)

(визначити знайти-розділ
  (функція (назва розділи)
    (за-умовою
      ((атом? розділи) () (як-є ()))
      ((атом? розділи) (#d0)
       (за-умовою
         ((тотожне? (перше (перше розділи)) назва) (#d1)
          (перше розділи))
         ((тотожне? (перше (перше розділи)) назва) (#d0)
          (знайти-розділ назва (решта розділи))))))))

(визначити рядки-метаданих
  (решта (знайти-розділ (як-є rows) метадані)))

(визначити рядки-профілю
  (решта (знайти-розділ (як-є profile-routes) метадані)))

(визначити реєстр-має-ід?
  (функція (ід рядки)
    (за-умовою
      ((атом? рядки) () (як-є no))
      ((атом? рядки) (#d0)
       (за-умовою
         ((тотожне? ід (перше (перше рядки))) (#d1) (як-є yes))
         ((тотожне? ід (перше (перше рядки))) (#d0)
          (реєстр-має-ід? ід (решта рядки))))))))

(визначити метадані-мають-маршрут?
  (функція (ід виконавець рядки)
    (за-умовою
      ((атом? рядки) () (як-є no))
      ((атом? рядки) (#d0)
       (нехай ((рядок (перше рядки)))
         (за-умовою
           ((тотожне? ід (перше рядок)) (#d1)
            (за-умовою
              ((тотожне? виконавець (друге рядок)) (#d1) (як-є yes))
              ((тотожне? виконавець (друге рядок)) (#d0)
               (метадані-мають-маршрут? ід виконавець (решта рядки)))))
           ((тотожне? ід (перше рядок)) (#d0)
            (метадані-мають-маршрут? ід виконавець (решта рядки)))))))))

(визначити допущений-виконавець?
  (функція (виконавець)
    (за-умовою
      ((тотожне? виконавець (як-є evaluator)) (#d1) (як-є yes))
      ((тотожне? виконавець (як-є common-lisp)) (#d1) (як-є yes))
      ((тотожне? виконавець (як-є prolog)) (#d1) (як-є yes))
      ((тотожне? виконавець (як-є clips)) (#d1) (як-є yes))
      ((тотожне? виконавець (як-є datalog)) (#d1) (як-є yes))
      (так (як-є no)))))

(визначити допущений-механізм?
  (функція (механізм)
    (за-умовою
      ((тотожне? механізм (як-є quote-form)) (#d1) (як-є yes))
      ((тотожне? механізм (як-є atom-primitive)) (#d1) (як-є yes))
      ((тотожне? механізм (як-є eq-primitive)) (#d1) (як-є yes))
      ((тотожне? механізм (як-є cons-primitive)) (#d1) (як-є yes))
      ((тотожне? механізм (як-є car-primitive)) (#d1) (як-є yes))
      ((тотожне? механізм (як-є cdr-primitive)) (#d1) (як-є yes))
      ((тотожне? механізм (як-є cond-form)) (#d1) (як-є yes))
      ((тотожне? механізм (як-є lambda-form)) (#d1) (як-є yes))
      ((тотожне? механізм (як-є define-form)) (#d1) (як-є yes))
      ((тотожне? механізм (як-є bounded-exact-add)) (#d1) (як-є yes))
      (так (як-є no)))))

(визначити допущений-профіль?
  (функція (профіль)
    (за-умовою
      ((тотожне? профіль (як-є core3)) (#d1) (як-є yes))
      (так (як-є no)))))

(визначити допущений-профіль-механізм?
  (функція (механізм)
    (за-умовою
      ((тотожне? механізм (як-є registered-host-mechanism))
       (#d1)
       (як-є yes))
      (так (як-є no)))))

(визначити профіль-має-маршрут?
  (функція (профіль ід рядки)
    (за-умовою
      ((атом? рядки) () (як-є no))
      ((атом? рядки) (#d0)
       (нехай ((рядок (перше рядки)))
         (за-умовою
           ((тотожне? профіль (перше рядок)) (#d1)
            (за-умовою
              ((тотожне? ід (друге рядок)) (#d1) (як-є yes))
              ((тотожне? ід (друге рядок)) (#d0)
               (профіль-має-маршрут? профіль ід (решта рядки)))))
           ((тотожне? профіль (перше рядок)) (#d0)
            (профіль-має-маршрут? профіль ід (решта рядки)))))))))

(визначити перевірити-рядки-профілю
  (функція (рядки)
    (за-умовою
      ((атом? рядки) ()
       (як-є (function-table-mechanisms-ok)))
      ((атом? рядки) (#d0)
       (нехай-послідовно ((рядок (перше рядки))
              (профіль (перше рядок))
              (ід (друге рядок))
              (механізм (третє рядок)))
         (за-умовою
           ((тотожне? (допущений-профіль? профіль) (як-є no))
            (#d1)
            (список (як-є function-table-mechanisms-violation)
                  (як-є unsupported-profile) профіль ід))
           ((тотожне? (реєстр-має-ід? ід рядки-реєстру) (як-є no))
            (#d1)
            (список (як-є function-table-mechanisms-violation)
                  (як-є profile-function-not-in-canon-function-table) профіль ід))
           ((тотожне? (профіль-має-маршрут? профіль ід (решта рядки)) (як-є yes))
            (#d1)
            (список (як-є function-table-mechanisms-violation)
                  (як-є duplicate-profile-route) профіль ід))
           ((тотожне? (допущений-профіль-механізм? механізм) (як-є no))
            (#d1)
            (список (як-є function-table-mechanisms-violation)
                  (як-є unsupported-profile-mechanism) профіль ід механізм))
           (так (перевірити-рядки-профілю (решта рядки)))))))))

(визначити перевірити-рядки
  (функція (рядки)
    (за-умовою
      ((атом? рядки) ()
       (як-є (function-table-mechanisms-ok)))
      ((атом? рядки) (#d0)
       (нехай-послідовно ((рядок (перше рядки))
              (ід (перше рядок))
              (виконавець (друге рядок))
              (механізм (третє рядок)))
         (за-умовою
           ((тотожне? (допущений-виконавець? виконавець) (як-є no))
            (#d1)
            (список (як-є function-table-mechanisms-violation)
                  (як-є unsupported-executor) ід виконавець))
           ((тотожне? (реєстр-має-ід? ід рядки-реєстру) (як-є no))
            (#d1)
            (список (як-є function-table-mechanisms-violation)
                  (як-є sid-not-in-canon-function-table) ід))
           ((тотожне? (метадані-мають-маршрут? ід виконавець (решта рядки)) (як-є yes))
            (#d1)
            (список (як-є function-table-mechanisms-violation)
                  (як-є duplicate-executor-route) ід виконавець))
           ((тотожне? (допущений-механізм? механізм) (як-є no))
            (#d1)
            (список (як-є function-table-mechanisms-violation)
                  (як-є unsupported-mechanism) ід механізм))
           (так (перевірити-рядки (решта рядки)))))))))

(визначити вердикт-легасі (перевірити-рядки рядки-метаданих))
(визначити вердикт-профілю (перевірити-рядки-профілю рядки-профілю))

(визначити вердикт
  (за-умовою
    ((однакові? вердикт-легасі (як-є (function-table-mechanisms-ok)))
     (#d1)
     вердикт-профілю)
    (так вердикт-легасі)))

(друкувати вердикт)
