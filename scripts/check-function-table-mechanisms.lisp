; #1046 — перевірка перехідних метаданих механізмів із відмовою за замовчуванням.
; Умови виконання перевіряються за чинною Д1/Д3 з рівно двома полями.
; Історичні скалярні літерали не використовуються у викличних формах.
; Цитовані поля механізмів зберігаються як дані протоколу.
; Джерело ідентичності — ратифіковані lib/domains/d3.lisp, d4.lisp, d5.lisp.
; Перевірка доводить, що метадані механізмів не створюють нових функцій.
; #1332/#1403 — empty-list-ground не є механізмом виконання функції.

; У цьому паспорті визначено лише D3–D5 механізми. Беремо повну «укр»,
; а не стару восьмибітну колонку. Читаємо таблиці як дані СЕНС.
(визначити рядки-третього-домену
  (решта (перше (читати-всі (читати-файл "lib/domains/d3.lisp")))))
(визначити рядки-четвертого-домену
  (решта (перше (читати-всі (читати-файл "lib/domains/d4.lisp")))))
(визначити рядки-п'ятого-домену
  (решта (перше (читати-всі (читати-файл "lib/domains/d5.lisp")))))

(визначити рядки-реєстру
  (приєднати рядки-третього-домену
    (приєднати рядки-четвертого-домену рядки-п'ятого-домену)))

; Сучасний паспорт — програма (визначити ім'я (як-є ТАБЛИЦЯ)).
; Витягуємо цитовані дані, не виконуємо файл і не відновлюємо історичну плоску тотожність.
(визначити метадані
  (друге (третє
    (перше (читати-всі (читати-файл "lib/function-table-mechanisms.lisp"))))))

(визначити знайти-розділ
  (функція (назва розділи)
    (за-умовою
      ((атом? розділи) (як-є ()))
      ((атом? (як-є ())) (за-умовою
         ((тотожне? (перше (перше розділи)) назва) (перше розділи))
         ((атом? (як-є ())) (знайти-розділ назва (решта розділи))))))))

(визначити рядки-метаданих
  (решта (знайти-розділ (як-є rows) метадані)))

(визначити рядки-профілю
  (решта (знайти-розділ (як-є profile-routes) метадані)))

(визначити реєстр-має-ід?
  (функція (ід рядки)
    (за-умовою
      ((атом? рядки) (як-є no))
      ((атом? (як-є ())) (за-умовою
         ((тотожне? ід (друге (третє (перше рядки)))) (як-є yes))
         ((атом? (як-є ())) (реєстр-має-ід? ід (решта рядки))))))))

(визначити метадані-мають-маршрут?
  (функція (ід виконавець рядки)
    (за-умовою
      ((атом? рядки) (як-є no))
      ((атом? (як-є ())) (нехай ((рядок (перше рядки)))
         (за-умовою
           ((тотожне? ід (перше рядок)) (за-умовою
              ((тотожне? виконавець (друге рядок)) (як-є yes))
              ((атом? (як-є ())) (метадані-мають-маршрут? ід виконавець (решта рядки)))))
           ((атом? (як-є ())) (метадані-мають-маршрут? ід виконавець (решта рядки)))))))))

(визначити допущений-виконавець?
  (функція (виконавець)
    (за-умовою
      ((тотожне? виконавець (як-є evaluator)) (як-є yes))
      ((тотожне? виконавець (як-є common-lisp)) (як-є yes))
      ((тотожне? виконавець (як-є prolog)) (як-є yes))
      ((тотожне? виконавець (як-є clips)) (як-є yes))
      ((тотожне? виконавець (як-є datalog)) (як-є yes))
      ((атом? (як-є ())) (як-є no)))))

(визначити допущений-механізм?
  (функція (механізм)
    (за-умовою
      ((тотожне? механізм (як-є quote-form)) (як-є yes))
      ((тотожне? механізм (як-є atom-primitive)) (як-є yes))
      ((тотожне? механізм (як-є eq-primitive)) (як-є yes))
      ((тотожне? механізм (як-є cons-primitive)) (як-є yes))
      ((тотожне? механізм (як-є car-primitive)) (як-є yes))
      ((тотожне? механізм (як-є cdr-primitive)) (як-є yes))
      ((тотожне? механізм (як-є cond-form)) (як-є yes))
      ((тотожне? механізм (як-є lambda-form)) (як-є yes))
      ((тотожне? механізм (як-є define-form)) (як-є yes))
      ((тотожне? механізм (як-є bounded-exact-add)) (як-є yes))
      ((атом? (як-є ())) (як-є no)))))

(визначити допущений-профіль?
  (функція (профіль)
    (за-умовою
      ((тотожне? профіль (як-є core3)) (як-є yes))
      ((атом? (як-є ())) (як-є no)))))

(визначити допущений-профіль-механізм?
  (функція (механізм)
    (за-умовою
      ((тотожне? механізм (як-є registered-host-mechanism)) (як-є yes))
      ((атом? (як-є ())) (як-є no)))))

(визначити профіль-має-маршрут?
  (функція (профіль ід рядки)
    (за-умовою
      ((атом? рядки) (як-є no))
      ((атом? (як-є ())) (нехай ((рядок (перше рядки)))
         (за-умовою
           ((тотожне? профіль (перше рядок)) (за-умовою
              ((тотожне? ід (друге рядок)) (як-є yes))
              ((атом? (як-є ())) (профіль-має-маршрут? профіль ід (решта рядки)))))
           ((атом? (як-є ())) (профіль-має-маршрут? профіль ід (решта рядки)))))))))

(визначити перевірити-рядки-профілю
  (функція (рядки)
    (за-умовою
      ((атом? рядки) (як-є (function-table-mechanisms-ok)))
      ((атом? (як-є ())) (нехай-послідовно ((рядок (перше рядки))
              (профіль (перше рядок))
              (ід (друге рядок))
              (механізм (третє рядок)))
         (за-умовою
           ((тотожне? (допущений-профіль? профіль) (як-є no)) (список (як-є function-table-mechanisms-violation)
                  (як-є unsupported-profile) профіль ід))
           ((тотожне? (реєстр-має-ід? ід рядки-реєстру) (як-є no)) (список (як-є function-table-mechanisms-violation)
                  (як-є profile-function-not-in-canon-function-table) профіль ід))
           ((тотожне? (профіль-має-маршрут? профіль ід (решта рядки)) (як-є yes)) (список (як-є function-table-mechanisms-violation)
                  (як-є duplicate-profile-route) профіль ід))
           ((тотожне? (допущений-профіль-механізм? механізм) (як-є no)) (список (як-є function-table-mechanisms-violation)
                  (як-є unsupported-profile-mechanism) профіль ід механізм))
           ((атом? (як-є ())) (перевірити-рядки-профілю (решта рядки)))))))))

(визначити перевірити-рядки
  (функція (рядки)
    (за-умовою
      ((атом? рядки) (як-є (function-table-mechanisms-ok)))
      ((атом? (як-є ())) (нехай-послідовно ((рядок (перше рядки))
              (ід (перше рядок))
              (виконавець (друге рядок))
              (механізм (третє рядок)))
         (за-умовою
           ((тотожне? (допущений-виконавець? виконавець) (як-є no)) (список (як-є function-table-mechanisms-violation)
                  (як-є unsupported-executor) ід виконавець))
           ((тотожне? (реєстр-має-ід? ід рядки-реєстру) (як-є no)) (список (як-є function-table-mechanisms-violation)
                  (як-є function-not-in-ratified-domain-table) ід))
           ((тотожне? (метадані-мають-маршрут? ід виконавець (решта рядки)) (як-є yes)) (список (як-є function-table-mechanisms-violation)
                  (як-є duplicate-executor-route) ід виконавець))
           ((тотожне? (допущений-механізм? механізм) (як-є no)) (список (як-є function-table-mechanisms-violation)
                  (як-є unsupported-mechanism) ід механізм))
           ((атом? (як-є ())) (перевірити-рядки (решта рядки)))))))))

(визначити вердикт-метаданих (перевірити-рядки рядки-метаданих))
(визначити вердикт-профілю (перевірити-рядки-профілю рядки-профілю))

(визначити вердикт
  (за-умовою
    ((однакові? вердикт-метаданих (як-є (function-table-mechanisms-ok))) вердикт-профілю)
    ((атом? (як-є ())) вердикт-метаданих)))

(друкувати вердикт)
