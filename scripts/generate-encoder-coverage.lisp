; #604 — відтворити покриття кодувальника з похідних машинних даних,
; якими керує мова СЕНС.
; Результат записує мовна функція, а не зовнішній генератор.
; Точні мітки encoder-coverage-generate, status, forms і partial
; належать формату звіту: це цитовані дані, не викличні імена.
; Бібліотеки вже завантажуються українською функцією «завантажити-файл».
; Історична виклична голова load тут більше не потрібна.
(завантажити-файл "lib/core.lisp")
(завантажити-файл "lib/machine/encoding/coverage-generator.lisp")

(за-умовою
  ((покриття-кодувальника-індекс-коректний?)
   ((функція ()
      (записати-файл
        "lib/machine/encoding/coverage.lisp"
        (покриття-кодувальника-сформувати-звіт))
      (друкувати
        (список
          (як-є encoder-coverage-generate)
          (як-є (status written))
          (список (як-є forms) покриття-кодувальника-кількість-форм)
          (список (як-є partial) (довжина покриття-кодувальника-часткові-записи)))))))
  (так
   (друкувати
     (як-є (encoder-coverage-generate (status rejected) (reason invalid-coverage-input-projection))))))
