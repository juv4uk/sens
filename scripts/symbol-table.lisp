; Канонічна таблиця символів ядра lib/core4.lisp.
; Кожен символ отримує стабільний числовий ідентифікатор.
; Таблицю підготовлено для завантажувальних програм fpga-lisp.
;
; Історичні асемблерні файли M19–M26 призначали номери вручну;
; це спричиняло розбіжності. Зокрема, помилка M22 змінила порядок
; елементів списку. Єдина таблиця усуває суперечливі призначення.
;
; Нумерація не залежить від порядку інтернування в читачі:
; мова такого порядку не гарантує. Сортування за назвою
; забезпечує відтворюваність і можливість ручної перевірки.
;
; Обхід охоплює всі верхньорівневі форми та вкладені символічні
; атоми: назви функцій, параметри, керівні форми й посилання.
; Числа, рядки й структурні порожні значення не включаємо.
;
; Запуск:
;   cargo run -p sens-cli --bin sens -- scripts/symbol-table.lisp > symbol-table.txt
; Вихід: одна пара (назва . номер) на рядок, сортування за назвою.
; Перетворення пар на директиви .define належить окремому інструменту.

(визначити зібрати-символи-до
  (функція (вираз накопичувач)
    (за-умовою
      ((символ? вираз) (за-умовою ((значення-у-списку? вираз накопичувач) накопичувач) ((атом? (як-є ())) (сполучити вираз накопичувач))))
      ((атом? вираз) накопичувач)
      ((атом? (як-є ())) (зібрати-символи-до (решта вираз) (зібрати-символи-до (перше вираз) накопичувач))))))

(визначити зібрати-всі-символи
  (функція (форми накопичувач)
    (за-умовою ((атом? форми) накопичувач) ((атом? (як-є ())) (зібрати-всі-символи (решта форми) (зібрати-символи-до (перше форми) накопичувач))))))

; Хвостова рекурсія тут навмисна.
; Наївне нарощування вкладених пар збільшує глибину стека Rust
; пропорційно довжині списку; історична реалізація переповнила
; стек на 83 елементах. Накопичувач зберігає передню частину,
; а решту розглядаємо без зайвої вкладеності викликів.

(визначити вставити-впорядковано-до
  (функція (символ перед після)
    (за-умовою
      ((атом? після) (зворот-до перед (список символ)))
      ((текст-передує? (символ-у-текст символ) (символ-у-текст (перше після)))
       (зворот-до перед (сполучити символ після)))
      ((атом? (як-є ())) (вставити-впорядковано-до символ (сполучити (перше після) перед) (решта після))))))

(визначити вставити-впорядковано
  (функція (символ впорядковане)
    (вставити-впорядковано-до символ (як-є ()) впорядковане)))

(визначити впорядкувати-символи-до
  (функція (залишок впорядковане)
    (за-умовою ((атом? залишок) впорядковане) ((атом? (як-є ())) (впорядкувати-символи-до (решта залишок) (вставити-впорядковано (перше залишок) впорядковане))))))

(визначити впорядкувати-символи
  (функція (символи)
    (впорядкувати-символи-до символи (як-є ()))))

(визначити друкувати-таблицю-до
  (функція (символи номер)
    (за-умовою
      ((атом? символи) (як-є ()))
      ((атом? (як-є ()))
       (нехай-послідовно
         ((надруковано (друкувати (список (символ-у-текст (перше символи)) номер))))
         (друкувати-таблицю-до (решта символи) (додати-1 номер)))))))

(визначити форми-ядра (читати-всі (читати-файл "lib/core4.lisp")))
(визначити усі-символи (зібрати-всі-символи форми-ядра (як-є ())))
(визначити впорядковані-символи (впорядкувати-символи усі-символи))

(друкувати-таблицю-до впорядковані-символи (довжина (як-є ())))
(як-є ())

