; Виконання висновку про згортання застарілого коду Rust.
; Основний мовний перевіряльник записує повний іменований висновок.
; Цей окремий процес завершується помилкою при забороненому зростанні Rust.
; Позначки rust-retirement-* — незмінні дані чинного протоколу.

(визначити висновки-про-руст
  (читати-всі (читати-файл "tests/rust-retirement-verdict.lisp")))
(визначити висновок-про-руст (перше висновки-про-руст))
(визначити мітка-висновку-про-руст (перше висновок-про-руст))

(за-умовою
  ((тотожне? мітка-висновку-про-руст (як-є rust-retirement-ok)) (identity-relation same)
   (як-є rust-retirement-ok))
  ((тотожне? мітка-висновку-про-руст (як-є rust-retirement-ok)) (identity-relation distinct)
   (за-умовою
     ((тотожне? мітка-висновку-про-руст (як-є rust-retirement-violation)) (identity-relation same)
      (перше ()))
     ((тотожне? мітка-висновку-про-руст (як-є rust-retirement-violation)) (identity-relation distinct)
      (перше ())))))

; Перехідна прив'язка існуючої операції читання; не нова ідентичність.
(визначити читати-всі read-all)
