; Свідок контракту «точний продюсер».
;
; Першопричина: механізм монотонного годинника (D10) оголошений у сигнатурі як
; «Повернути монотонний лічильник наносекунд як точне ціле», але повертав
; `exact_value(..)` — а той сам себе документує як «Legacy data/presentation
; bridge, NOT a mathematical operand admission». Тож власний годинник мови не
; задовольняв `число?` і його ВІДХИЛЯЛА арифметика.
;
; Інваріант: якщо продюсер оголошений як «точне ціле», його результат мусить
; належати множині, яку приймає `число?` — тобто бути точнодоменним значенням,
; а не гостьовим числом. Чистий контракт: без I/O, без стану.

(визначити множина-числа
  (як-є (точнодоменне-значення числова-композиція)))

(визначити точний-продюсер-виконано?
  (функція (результат)
    (належить? результат множина-числа)))

(визначити належить?
  (функція (елемент множина)
    (за-умовою
      ((порожній? множина) ні)
      ((тотожне? елемент (перший множина)) так)
      (так (належить? елемент (решта множина))))))

(визначити порожній?
  (функція (м) (тотожне? м (як-є ()))))

(визначити перший
  (функція (м) (голова м)))

(визначити решта
  (функція (м) (хвіст м)))

; Незалежний контроль: точнодоменний результат проходить, гостьове число — ні.
(точний-продюсер-виконано? точнодоменне-значення)
(точний-продюсер-виконано? гостьове-число)
