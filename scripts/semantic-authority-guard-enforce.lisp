; Застосування висновку мовної перевірки повноважень.
; Імена змінних і виконуваних операцій — українською.
; Позначки semantic-authority-* залишаються незмінними даними протоколу.
; Порожній або невідомий висновок призводить до відмови.

(визначити висновки
  (читати-всі (читати-файл "tests/semantic-authority-verdict.lisp")))

(визначити висновок (перше висновки))

(визначити мітка-висновку
  (за-умовою
    ((атом? висновок)
     (за-умовою
       ((тотожне? висновок (як-є ())) (як-є empty-verdict))
       ((атом? (як-є ())) висновок)))
    ((атом? (як-є ())) (перше висновок))))

(за-умовою
  ((тотожне? мітка-висновку (як-є semantic-authority-ok))
   (як-є semantic-authority-ok))
  ((тотожне? мітка-висновку (як-є semantic-authority-violation))
   (перше (як-є ())))
  ((атом? (як-є ()))
   (перше (як-є ()))))
