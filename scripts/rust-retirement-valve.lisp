; Український SENS-сценарій перевірки змін Rust за чинним вхідним контрактом.
; Маркери rust-change, existing, new, deleted, rust-retirement-ok,
; rust-retirement-violation — точні позначки протоколу; пояснення відмов — українською.
; Семантика умов належить SENS, а не зовнішньому механізму.
; «Друге», «третє» та «четверте» беремо з чинних доменних поверхонь.
; «П'яте» наявне в доменному каталозі, але локальний обчислювач
; поки зберігаємо: сам запис у каталозі не доводить викличність.

(визначити п'яте (функція (значення) (перше (решта (решта (решта (решта значення)))))))

(визначити зміни-руста
  (читати-всі (читати-файл "tests/rust-retirement-changes.lisp")))

; Порожній перелік дозволений. Новий файл або додані рядки — відмова.
; Позитивна й негативні гілки зберігають точні протокольні результати.
(визначити вердикт-скорочення-руста
  (функція (зміни)
    (за-умовою
      ((порожній? зміни) (як-є (rust-retirement-ok)))
      ((атом? зміни) (як-є (rust-retirement-violation malformed-change-list)))
      ((атом? (як-є ()))
       ((функція (зміна)
          ((функція (шлях додавання стан)
             (за-умовою
               ((тотожне? стан (як-є new))
                (список (як-є rust-retirement-violation)
                        шлях додавання стан
                        "Нові шляхи до файлів Rust заборонено під час скорочення. Див. #299."))
               ((нуль? додавання)
                (вердикт-скорочення-руста (решта зміни)))
               ((атом? (як-є ()))
                (список (як-є rust-retirement-violation)
                        шлях додавання стан
                        "Обсяг Rust має лише зменшуватися; додані рядки Rust заборонено. Див. #299."))))
           (друге зміна) (третє зміна) (п'яте зміна)))
        (перше зміни))))))

(вердикт-скорочення-руста зміни-руста)
