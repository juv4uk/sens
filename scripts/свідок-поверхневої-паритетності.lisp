; Свідок інваріанта поверхневої паритетності.
;
; Принцип мови: «одна семантична реалізація, кілька людських проєкцій».
; Отже поверхня МОЖЕ змінювати імена та подання — і НЕ МОЖЕ змінювати
; обчислене значення тієї самої програми.
;
; Першопричина, яку фіксує цей свідок: у WASM-адаптері
; (crates/sens-wasm/src/lib.rs:258-261) українські поверхні проходять
; додаткову проєкцію джерела (десяткові цілі -> точні D24+), а core/en/sa — ні.
; Оскільки рушій розрізняє ТОЧНОДОМЕННЕ значення і гостьове число,
; та сама програма може дати РІЗНИЙ результат залежно від поверхні.
; Це поверхня як друга семантика — порушення принципу.
;
; Контракт чистий: без I/O, без стану.

(визначити поверхні
  (як-є ("core" "en" "ук" "укр" "sa")))

; Інваріант: значення не залежить від поверхні.
(визначити поверхнево-інваріантне?
  (функція (значення-за-поверхнею)
    (за-умовою
      ((порожній? значення-за-поверхнею) так)
      ((розбіжність? (перший значення-за-поверхнею) (решта значення-за-поверхнею)) ні)
      (так (поверхнево-інваріантне? (решта значення-за-поверхнею))))))

(визначити розбіжність?
  (функція (еталон решта)
    (за-умовою
      ((порожній? решта) ні)
      ((не-тотожне? еталон (перший решта)) так)
      (так (розбіжність? еталон (решта решта))))))

(визначити не-тотожне?
  (функція (а б)
    (за-умовою
      ((тотожне? а б) ні)
      (так так))))

(визначити порожній?
  (функція (м)
    (тотожне? м (як-є ()))))

(визначити перший
  (функція (м) (голова м)))

(визначити решта
  (функція (м) (хвіст м)))

; Незалежний контроль: паритет зберігається, коли всі поверхні дають те саме.
(поверхнево-інваріантне? (як-є (3 3 3 3 3)))
; і порушується, коли хоч одна розходиться (саме наш випадок: 5 на ук/укр, 4 на core).
(поверхнево-інваріантне? (як-є (5 4 4 4 4)))
