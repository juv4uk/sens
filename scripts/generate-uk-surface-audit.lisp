; Інвентаризація української поверхні для my-lisp#85.
; Це перевірочна проєкція, а не джерело семантичних повноважень.
;
; Шлях походження затверджених відомостей:
;   semantic-registry.lisp
;       → scripts/generate-function-table.lisp
;       → lib/generated/function-table.lisp
;       → цей перевірочний звіт
;
; Джерело свідчень щодо кандидатів:
;   lib/surface/український-профіль-джерела.lisp.
; Пропоновані назви залишаються кандидатами.
; Перевірена таблиця lib/generated/function-table.lisp не створює
; іншого джерела семантики. Генератор не переносить кандидати
; без ратифікації до чинної повної української проєкції.
;
; Вихідний файл:
;   lib/generated/uk-surface-audit.lisp
;
; Запуск із кореня репозиторію:
;   cargo run -p sens-cli --bin sens -- scripts/generate-uk-surface-audit.lisp

(визначити рядок+
  (функція аргументи (згорнути (функція (накопичувач с) (рядок-додати накопичувач с)) "" аргументи)))

(визначити шосте (функція (елементи) (перше (решта (решта (решта (решта (решта елементи))))))))
(визначити сьоме (функція (елементи) (перше (решта (решта (решта (решта (решта (решта елементи)))))))))
(визначити восьме (функція (елементи) (перше (решта (решта (решта (решта (решта (решта (решта елементи))))))))))
(визначити дев'яте (функція (елементи) (перше (решта (решта (решта (решта (решта (решта (решта (решта елементи)))))))))))

(визначити зєднати-новим-рядком-у
  (функція (рядки-рядків накопичувач)
    (за-умовою
      ((атом? рядки-рядків) накопичувач)
      
      ((тотожне? накопичувач "") (зєднати-новим-рядком-у (решта рядки-рядків) (перше рядки-рядків)))
      (так (зєднати-новим-рядком-у (решта рядки-рядків) (рядок+ накопичувач "\n" (перше рядки-рядків)))))))
(визначити зєднати-новим-рядком (функція (рядки-рядків) (зєднати-новим-рядком-у рядки-рядків "")))

; Рядки таблиці функцій мають похідну схему ft/2:
; (sid-bitstring formal (ук word) (укр word) (en word) (sa word) (sym word) authority)
; Поверхня або наявна, або відсутня: ft/2 не містить
; окремого статусу кожної поверхні. Статус тотожності
; (чинна, кандидатна чи лише сумісна) походить
; із українського профілю підготовки нижче.
(визначити форма-таблиці-функцій (перше (читати-всі (читати-файл "lib/generated/function-table.lisp"))))

; Історична таблиця з 256 рядків також перелічує вільні
; координати, для яких усі поверхні мають значення ().
(визначити поверхня-порожня?
  (функція (поверхня)
    (за-умовою
      ((тотожне? (друге поверхня) (як-є ())) так)
      (так (як-є ())))))

(визначити названий-рядок?
  (функція (рядок)
    (за-умовою
      ((поверхня-порожня? (третє рядок))
       (за-умовою
         ((поверхня-порожня? (четверте рядок))
          (за-умовою
            ((поверхня-порожня? (п'ятий рядок))
             (за-умовою
               ((поверхня-порожня? (шосте рядок)) (хибне? (поверхня-порожня? (сьоме рядок))))
               (так так)))
            (так так)))
         (так так)))
      (так так))))

(визначити названі-рядки
  (функція (рядки)
    (за-умовою
      ((атом? рядки) () (як-є ()))
      ((названий-рядок? (перше рядки)) (сполучити (перше рядки) (названі-рядки (решта рядки))))
      (так (названі-рядки (решта рядки))))))

(визначити рядки-таблиці-функцій (названі-рядки (решта форма-таблиці-функцій)))

(визначити форма-профілю
  (перше (читати-всі (читати-файл "lib/surface/український-профіль-джерела.lisp"))))

(визначити знайти-розділ
  (функція (назва розділи)
    (за-умовою
      ((атом? розділи) (як-є ()))
      
      ((та (відповідь-не (атом? (перше розділи))) (тотожне? (перше (перше розділи)) назва))
       (перше розділи))
      (так (знайти-розділ назва (решта розділи))))))

(визначити розділ-кандидатів (знайти-розділ (як-є назви) (решта форма-профілю)))
(визначити рядки-кандидатів
  (за-умовою ((атом? розділ-кандидатів) (як-є ())) (так (решта розділ-кандидатів))))

(визначити знайти-рядок-кандидата
  (функція (ід рядки)
    (за-умовою
      ((атом? рядки) (як-є ()))
      
      ((однакові? (перше (перше рядки)) ід) (перше рядки))
      (так (знайти-рядок-кандидата ід (решта рядки))))))

(визначити слово-поверхні
  (функція (поверхня)
    (за-умовою
      ((тотожне? (друге поверхня) (як-є ())) (як-є —))
      (так (друге поверхня)))))
(визначити статус-поверхні
  (функція (поверхня)
    (за-умовою
      ((тотожне? (друге поверхня) (як-є ())) (як-є missing))
      (так (як-є stable)))))

(визначити відсутня-поверхня?
  (функція (поверхня)
    (або (тотожне? (статус-поверхні поверхня) (як-є missing))
        (тотожне? (слово-поверхні поверхня) (як-є —)))))

; Класифікація навмисно консервативна. Звіт може показати
; кандидата, але лише окремий огляд визначає, чи він короткий,
; неоднозначний тощо. Мовні властивості не виводяться
; автоматично з написання.
(визначити клас-аудиту
  (функція (ук кандидат)
    (за-умовою
      ((тотожне? (статус-доказу-кандидата кандидат) (як-є кандидат-сумісності))
       (як-є compatibility-only))
      ((відсутня-поверхня? ук) (як-є needs-research))
      ((атом? кандидат) (як-є needs-research))
      
      ((тотожне? (друге кандидат) (третє кандидат)) (як-є full))
      (так (як-є needs-research)))))

(визначити повне-слово-кандидата
  (функція (кандидат)
    (за-умовою ((атом? кандидат) (як-є —)) (так (третє кандидат)))))

(визначити статус-доказу-кандидата
  (функція (кандидат)
    (за-умовою ((атом? кандидат) (як-є no-staging-evidence)) (так (четверте кандидат)))))

; Назва поля `candidate-compact-uk` належить завданням #86/#89.
; У #85 потрібно показувати порожню позицію,
; а не вигадувати скорочення під час інвентаризації.
(визначити компактне-слово-кандидата (функція () (як-є —)))

(визначити статус-неоднозначності
  (функція (кандидат)
    (за-умовою ((атом? кандидат) (як-є needs-research)) (так (як-є not-yet-assessed)))))

; Статус на ідентичність з профілю підготовки: чинна -> stable,
; кандидат-сумісності -> compatibility-only, будь-який інший кандидат -> candidate.
(визначити первинний-статус-профілю
  (функція (кандидат)
    (за-умовою
      ((атом? кандидат) () (як-є missing))
      ((тотожне? (четверте кандидат) (як-є чинна)) (як-є stable))
      ((тотожне? (четверте кандидат) (як-є кандидат-сумісності)) (як-є compatibility-only))
      (так (як-є candidate)))))

(визначити відрендерити-рядок
  (функція (рядок)
    (нехай-послідовно ((ід (перше рядок))
           (ук (третє рядок))
           (повний-авторитет (четверте рядок))
           (англ (п'ятий рядок))
           (санскр (шосте рядок))
           (симв (сьоме рядок))
           (кандидат (знайти-рядок-кандидата ід рядки-кандидатів))
           (первинний (первинний-статус-профілю кандидат))
           (клас (клас-аудиту ук кандидат))
           (повне-кандидата (повне-слово-кандидата кандидат))
           (статус-кандидата (статус-доказу-кандидата кандидат))
           (неоднозначність (статус-неоднозначності кандидат)))
      (рядок+
        "  (row " (значення-у-текст ід)
        " (current-uk " (значення-у-текст (слово-поверхні ук)) " "
                         (значення-у-текст (статус-поверхні ук)) ")"
        " (authoritative-full-uk " (значення-у-текст (слово-поверхні повний-авторитет)) " "
                                  (значення-у-текст (статус-поверхні повний-авторитет)) ")"
        " (en " (значення-у-текст (слово-поверхні англ)) " "
                 (значення-у-текст (статус-поверхні англ)) ")"
        " (sa " (значення-у-текст (слово-поверхні санскр)) " "
                 (значення-у-текст (статус-поверхні санскр)) ")"
        " (sym " (значення-у-текст (слово-поверхні симв)) " "
                  (значення-у-текст (статус-поверхні симв)) ")"
        " (primary-status " (значення-у-текст первинний) ")"
        " (class " (значення-у-текст клас) ")"
        " (candidate-full-uk " (значення-у-текст повне-кандидата) ")"
        " (candidate-full-status " (значення-у-текст статус-кандидата) ")"
        " (candidate-compact-uk " (значення-у-текст (компактне-слово-кандидата)) ")"
        " (ambiguity " (значення-у-текст неоднозначність) ")"
        " (evidence generated-function-table staging-profile))"))))

(визначити порахувати-клас
  (функція (шукане рядки накопичувач)
    (за-умовою ((атом? рядки) накопичувач) (так (нехай-послідовно ((ід (перше (перше рядки)))
              (ук (третє (перше рядки)))
              (кандидат (знайти-рядок-кандидата ід рядки-кандидатів))
              (клас (клас-аудиту ук кандидат)))
         (порахувати-клас шукане (решта рядки)
           (за-умовою ((тотожне? клас шукане) (додати накопичувач 1))
                 (так накопичувач))))))))

(визначити порахувати-кандидатів
  (функція (рядки накопичувач)
    (за-умовою ((атом? рядки) накопичувач) (так (порахувати-кандидатів (решта рядки)
         (за-умовою ((атом? (знайти-рядок-кандидата (перше (перше рядки)) рядки-кандидатів)) накопичувач) (так (додати накопичувач 1))))))))

(визначити усього (довжина рядки-таблиці-функцій))
(визначити кількість-повних (порахувати-клас (як-є full) рядки-таблиці-функцій 0))
(визначити кількість-сумісних (порахувати-клас (як-є compatibility-only) рядки-таблиці-функцій 0))
(визначити кількість-потребує-дослідження (порахувати-клас (як-є needs-research) рядки-таблиці-функцій 0))
(визначити кількість-кандидатів (порахувати-кандидатів рядки-таблиці-функцій 0))

(визначити заголовок
  (список
    "; GENERATED — DO NOT EDIT BY HAND"
    "; Semantic authority: lib/surface/semantic-registry.lisp via lib/generated/function-table.lisp"
    "; Candidate evidence only: lib/surface/український-профіль-джерела.lisp"
    "; Generator: scripts/generate-uk-surface-audit.lisp (my-lisp#85)"
    "; candidate-full-uk is NOT automatically promoted into authoritative full-uk"
    ""
    "(uk-surface-audit/2"
    (рядок+ "  (summary (total " (число-рядок усього) ")"
          " (full " (число-рядок кількість-повних) ")"
          " (already-compact 0)"
          " (ambiguous 0)"
          " (needs-research " (число-рядок кількість-потребує-дослідження) ")"
          " (compatibility-only " (число-рядок кількість-сумісних) ")"
          " (staging-evidence " (число-рядок кількість-кандидатів) "))")
    "  (rows"))

(визначити тіло (зєднати-новим-рядком (приєднати заголовок (відобразити відрендерити-рядок рядки-таблиці-функцій))))
(визначити вихід (рядок+ тіло "\n  )\n)\n"))

(записати-файл "lib/generated/uk-surface-audit.lisp" вихід)
(друкувати (рядок+ "uk-surface-audit: " (число-рядок усього) " identities written"))
