; Генератор аудиту української мовної проєкції СЕНС.
; Похідна звітність, а не джерело семантичних законів чи ратифікації.
; Джерело: lib/surface/semantic-registry.lisp → таблиця функцій.
; Джерело пропозицій: lib/surface/український-профіль-джерела.lisp.
; Кандидатні назви залишаються пропозиціями до окремої перевірки власником.
; Генератор не підносить їх до ратифікованої колонки повних назв.
; Вихід: lib/generated/uk-surface-audit.lisp.
; Запуск: cargo run -p my-lisp-cli --bin my-lisp -- scripts/generate-uk-surface-audit.lisp
; Протокольні ключі, вхідні дані, числа й рядки результату незмінні.

(визначити зчепити-рядки
  (функція аргументи (згорнути (функція (накопичувач фрагмент) (рядок-додати накопичувач фрагмент)) "" аргументи)))

(визначити шосте (функція (елементи) (перше (решта (решта (решта (решта (решта елементи))))))))
(визначити сьоме (функція (елементи) (перше (решта (решта (решта (решта (решта (решта елементи)))))))))
(визначити восьме (функція (елементи) (перше (решта (решта (решта (решта (решта (решта (решта елементи))))))))))
(визначити дев'яте (функція (елементи) (перше (решта (решта (решта (решта (решта (решта (решта (решта елементи)))))))))))

(визначити поєднати-через-новий-рядок-до
  (функція (рядки-тексту накопичувач)
    (за-умовою
      ((атом? рядки-тексту) накопичувач)
      
      ((тотожне? накопичувач "") (поєднати-через-новий-рядок-до (решта рядки-тексту) (перше рядки-тексту)))
      ((атом? (як-є ())) (поєднати-через-новий-рядок-до (решта рядки-тексту) (зчепити-рядки накопичувач "\n" (перше рядки-тексту)))))))
(визначити поєднати-через-новий-рядок (функція (рядки-тексту) (поєднати-через-новий-рядок-до рядки-тексту "")))

; Function-table rows have the generated schema ft/2:
; (sid-bitstring formal (ук word) (укр word) (en word) (sa word) (sym word) authority)
; A surface is present or missing; ft/2 carries no per-surface status. The
; per-identity status (current, candidate, compatibility-only) comes from the
; Ukrainian staging profile below.
(визначити форма-таблиці-функцій (перше (читати-всі (читати-файл "lib/generated/function-table.lisp"))))

; The 256-row table also lists every unused code with only () surfaces.
(визначити порожня-проєкція?
  (функція (проєкція)
    (за-умовою
      ((тотожне? (друге проєкція) (як-є ())) t)
      ((атом? (як-є ())) (як-є ())))))

(визначити іменований-рядок?
  (функція (рядок)
    (за-умовою
      ((порожня-проєкція? (третє рядок))
       (за-умовою
         ((порожня-проєкція? (четверте рядок))
          (за-умовою
            ((порожня-проєкція? (п'ятий рядок))
             (за-умовою
               ((порожня-проєкція? (шосте рядок)) (хибне? (порожня-проєкція? (сьоме рядок))))
               ((атом? (як-є ())) t)))
            ((атом? (як-є ())) t)))
         ((атом? (як-є ())) t)))
      ((атом? (як-є ())) t))))

(визначити іменовані-рядки
  (функція (рядки)
    (за-умовою
      ((атом? рядки) () (як-є ()))
      ((іменований-рядок? (перше рядки)) (сполучити (перше рядки) (іменовані-рядки (решта рядки))))
      ((атом? (як-є ())) (іменовані-рядки (решта рядки))))))

(визначити рядки-таблиці-функцій (іменовані-рядки (решта форма-таблиці-функцій)))

(визначити форма-профілю
  (перше (читати-всі (читати-файл "lib/surface/український-профіль-джерела.lisp"))))

(визначити знайти-розділ
  (функція (назва розділи)
    (за-умовою
      ((атом? розділи) (як-є ()))
      
      ((та (відповідь-не (атом? (перше розділи))) (тотожне? (перше (перше розділи)) назва))
       (перше розділи))
      ((атом? (як-є ())) (знайти-розділ назва (решта розділи))))))

(визначити розділ-кандидатів (знайти-розділ (як-є назви) (решта форма-профілю)))
(визначити рядки-кандидатів
  (за-умовою ((атом? розділ-кандидатів) (як-є ())) ((атом? (як-є ())) (решта розділ-кандидатів))))

(визначити знайти-рядок-кандидата
  (функція (ідентичність рядки)
    (за-умовою
      ((атом? рядки) (як-є ()))
      
      ((однакові? (перше (перше рядки)) ідентичність) (перше рядки))
      ((атом? (як-є ())) (знайти-рядок-кандидата ідентичність (решта рядки))))))

(визначити назва-проєкції
  (функція (проєкція)
    (за-умовою
      ((тотожне? (друге проєкція) (як-є ())) (як-є —))
      ((атом? (як-є ())) (друге проєкція)))))
(визначити стан-проєкції
  (функція (проєкція)
    (за-умовою
      ((тотожне? (друге проєкція) (як-є ())) (як-є missing))
      ((атом? (як-є ())) (як-є stable)))))

(визначити проєкція-відсутня?
  (функція (проєкція)
    (або (тотожне? (стан-проєкції проєкція) (як-є missing))
        (тотожне? (назва-проєкції проєкція) (як-є —)))))

; Classification here is intentionally conservative. The audit may report a
; candidate, but only an explicit later review may classify it as compact,
; ambiguous, etc. We therefore never infer linguistic facts from spelling.
(визначити клас-аудиту
  (функція (українська-проєкція кандидат)
    (за-умовою
      ((тотожне? (стан-доказу-кандидата кандидат) (як-є кандидат-сумісності))
       (як-є compatibility-only))
      ((проєкція-відсутня? українська-проєкція) (як-є needs-research))
      ((атом? кандидат) (як-є needs-research))
      
      ((тотожне? (друге кандидат) (третє кандидат)) (як-є full))
      ((атом? (як-є ())) (як-є needs-research)))))

(визначити повна-назва-кандидата
  (функція (кандидат)
    (за-умовою ((атом? кандидат) (як-є —)) ((атом? (як-є ())) (третє кандидат)))))

(визначити стан-доказу-кандидата
  (функція (кандидат)
    (за-умовою ((атом? кандидат) (як-є no-staging-evidence)) ((атом? (як-є ())) (четверте кандидат)))))

; `candidate-compact-uk` belongs to #86/#89. #85 must expose the empty slot,
; not invent abbreviations while performing an inventory.
(визначити скорочена-назва-кандидата (функція () (як-є —)))

(визначити стан-неоднозначності
  (функція (кандидат)
    (за-умовою ((атом? кандидат) (як-є needs-research)) ((атом? (як-є ())) (як-є not-yet-assessed)))))

; Per-identity status from the staging profile: чинна -> stable,
; кандидат-сумісності -> compatibility-only, any other candidate -> candidate.
(визначити основний-стан-профілю
  (функція (кандидат)
    (за-умовою
      ((атом? кандидат) () (як-є missing))
      ((тотожне? (четверте кандидат) (як-є чинна)) (як-є stable))
      ((тотожне? (четверте кандидат) (як-є кандидат-сумісності)) (як-є compatibility-only))
      ((атом? (як-є ())) (як-є candidate)))))

(визначити подати-рядок-аудиту
  (функція (рядок)
    (нехай-послідовно ((ідентичність (перше рядок))
           (українська-проєкція (третє рядок))
           (повна-ратифікована (четверте рядок))
           (англійська-проєкція (п'ятий рядок))
           (санскритська-проєкція (шосте рядок))
           (символьна-проєкція (сьоме рядок))
           (кандидат (знайти-рядок-кандидата ідентичність рядки-кандидатів))
           (основний-стан (основний-стан-профілю кандидат))
           (клас (клас-аудиту українська-проєкція кандидат))
           (повна-назва (повна-назва-кандидата кандидат))
           (стан-кандидата (стан-доказу-кандидата кандидат))
           (неоднозначність (стан-неоднозначності кандидат)))
      (зчепити-рядки
        "  (row " (значення-у-текст ідентичність)
        " (current-uk " (значення-у-текст (назва-проєкції українська-проєкція)) " "
                         (значення-у-текст (стан-проєкції українська-проєкція)) ")"
        " (authoritative-full-uk " (значення-у-текст (назва-проєкції повна-ратифікована)) " "
                                  (значення-у-текст (стан-проєкції повна-ратифікована)) ")"
        " (en " (значення-у-текст (назва-проєкції англійська-проєкція)) " "
                 (значення-у-текст (стан-проєкції англійська-проєкція)) ")"
        " (sa " (значення-у-текст (назва-проєкції санскритська-проєкція)) " "
                 (значення-у-текст (стан-проєкції санскритська-проєкція)) ")"
        " (sym " (значення-у-текст (назва-проєкції символьна-проєкція)) " "
                  (значення-у-текст (стан-проєкції символьна-проєкція)) ")"
        " (primary-status " (значення-у-текст основний-стан) ")"
        " (class " (значення-у-текст клас) ")"
        " (candidate-full-uk " (значення-у-текст повна-назва) ")"
        " (candidate-full-status " (значення-у-текст стан-кандидата) ")"
        " (candidate-compact-uk " (значення-у-текст (скорочена-назва-кандидата)) ")"
        " (ambiguity " (значення-у-текст неоднозначність) ")"
        " (evidence generated-function-table staging-profile))"))))

(визначити підрахувати-клас
  (функція (потрібний-клас рядки накопичувач)
    (за-умовою ((атом? рядки) накопичувач) ((атом? (як-є ())) (нехай-послідовно ((ідентичність (перше (перше рядки)))
              (українська-проєкція (третє (перше рядки)))
              (кандидат (знайти-рядок-кандидата ідентичність рядки-кандидатів))
              (клас (клас-аудиту українська-проєкція кандидат)))
         (підрахувати-клас потрібний-клас (решта рядки)
           (за-умовою ((тотожне? клас потрібний-клас) (додати накопичувач 1))
                 ((атом? (як-є ())) накопичувач))))))))

(визначити підрахувати-кандидатів
  (функція (рядки накопичувач)
    (за-умовою ((атом? рядки) накопичувач) ((атом? (як-є ())) (підрахувати-кандидатів (решта рядки)
         (за-умовою ((атом? (знайти-рядок-кандидата (перше (перше рядки)) рядки-кандидатів)) накопичувач) ((атом? (як-є ())) (додати накопичувач 1))))))))

(визначити загальна-кількість (довжина рядки-таблиці-функцій))
(визначити кількість-повних (підрахувати-клас (як-є full) рядки-таблиці-функцій 0))
(визначити кількість-сумісності (підрахувати-клас (як-є compatibility-only) рядки-таблиці-функцій 0))
(визначити кількість-досліджуваних (підрахувати-клас (як-є needs-research) рядки-таблиці-функцій 0))
(визначити кількість-кандидатів (підрахувати-кандидатів рядки-таблиці-функцій 0))

(визначити заголовок-звіту
  (список
    "; GENERATED — DO NOT EDIT BY HAND"
    "; Semantic authority: lib/surface/semantic-registry.lisp via lib/generated/function-table.lisp"
    "; Candidate evidence only: lib/surface/український-профіль-джерела.lisp"
    "; Generator: scripts/generate-uk-surface-audit.lisp (my-lisp#85)"
    "; candidate-full-uk is NOT automatically promoted into authoritative full-uk"
    ""
    "(uk-surface-audit/2"
    (зчепити-рядки "  (summary (total " (число-рядок загальна-кількість) ")"
          " (full " (число-рядок кількість-повних) ")"
          " (already-compact 0)"
          " (ambiguous 0)"
          " (needs-research " (число-рядок кількість-досліджуваних) ")"
          " (compatibility-only " (число-рядок кількість-сумісності) ")"
          " (staging-evidence " (число-рядок кількість-кандидатів) "))")
    "  (rows"))

(визначити тіло-звіту (поєднати-через-новий-рядок (приєднати заголовок-звіту (відобразити подати-рядок-аудиту рядки-таблиці-функцій))))
(визначити вихідний-вміст (зчепити-рядки тіло-звіту "\n  )\n)\n"))

(записати-файл "lib/generated/uk-surface-audit.lisp" вихідний-вміст)
(друкувати (зчепити-рядки "uk-surface-audit: " (число-рядок загальна-кількість) " identities written"))
