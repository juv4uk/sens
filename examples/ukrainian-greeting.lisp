; Маленька програма на українській поверхні my-lisp.
; Запуск: cat lib/surface/uk.lisp examples/ukrainian-greeting.lisp | my-lisp --surface uk

(визначити привітання (функція (ім'я) (рядок-додати (рядок-додати "Привіт, " ім'я) "!")))

(визначити гості (список 'Олена 'Тарас 'Вова))

(друкувати (привітання "друже"))
(друкувати (рядок-додати "Перший гість — " (значення-у-текст (перше гості))))
(друкувати (рядок-додати "Це атом? " (значення-у-текст (атом? (перше гості)))))
