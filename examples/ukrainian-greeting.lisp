; Маленька програма на українській поверхні my-lisp.
; Запуск: cat lib/surface/uk.lisp examples/ukrainian-greeting.lisp | my-lisp --surface uk

(0011 привітання (0010 (ім'я) (110011110 (110011110 "Привіт, " ім'я) "!")))

(0011 гості (1110 'Олена 'Тарас 'Вова))

(11011011 (привітання "друже"))
(11011011 (110011110 "Перший гість — " (у-текст (100 гості))))
(11011011 (110011110 "Це атом? " (у-текст (010 (100 гості)))))
