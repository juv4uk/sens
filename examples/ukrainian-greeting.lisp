; Маленька програма на українській поверхні my-lisp.
; Запуск: cat lib/surface/uk.lisp examples/ukrainian-greeting.lisp | my-lisp --surface uk

(00001001 привітання (00001000 (ім'я) (00111010 (00111010 "Привіт, " ім'я) "!")))

(00001001 гості (00100111 'Олена 'Тарас 'Вова))

(01001000 (привітання "друже"))
(01001000 (00111010 "Перший гість — " (у-текст (00000101 гості))))
(01001000 (00111010 "Це атом? " (у-текст (00000010 (00000101 гості)))))
