; Приклад вітання українською проєкцією СЕНС.
; Усі викличні голови є повними українськими назвами
; з ратифікованих доменів. Текст і коментарі також
; доступні з української клавіатури.
;
; Програма складає привітання, виводить перше ім'я
; та перевіряє, чи є це ім'я атомом.

(визначити привітання
  (функція (ім'я)
    (рядок-додати
      (рядок-додати "Привіт, " ім'я)
      "!")))

; Імена гостей — цитовані символи, а не виклики чи текстові рядки.
; Цитування виконує повна українська голова третього домену.
(визначити гості
  (список (як-є Олена) (як-є Тарас) (як-є Вова)))

(друкувати
  (привітання "друже"))

(друкувати
  (рядок-додати
    "Перший гість: "
    (значення-у-текст (перше гості))))

(друкувати
  (рядок-додати
    "Це атом? "
    (значення-у-текст (атом? (перше гості)))))
