; Каталог механізмів для вже ратифікованих функцій SENS.
; Джерело ідентичності та ширини — тільки таблиці доменів D1–D10.
; Механізм не створює нової функції та не змінює її закон.
; Додавання рядка не означає, що відповідний виконавець уже працює.
;
; Таблиця є даними: англійські назви схеми, зовнішніх виконавців і
; методів збережені як атоми протоколу, а не як викличні голови.
; Усі виконувані голови належать українській проєкції D3–D5.
; Порожній список означає відсутність механізму або маршруту.
;
; Перша форма створює значення таблиці, не викликаючи schema чи rows.
(визначити паспорт-механізмів-функцій
  (як-є
    ((schema function-table-mechanisms-1)
     (authority д1-д10)
     (rows
       (як-є evaluator quote-form)
       (атом? evaluator atom-primitive)
       (тотожне? evaluator eq-primitive)
       (сполучити evaluator cons-primitive)
       (перше evaluator car-primitive)
       (решта evaluator cdr-primitive)
       (за-умовою evaluator cond-form)
       (функція evaluator lambda-form)
       (визначити evaluator define-form)
       (додати common-lisp bounded-exact-add)
       (додати prolog bounded-exact-add)
       (додати clips bounded-exact-add)
       (додати datalog bounded-exact-add))
     (profile-routes))))

; «rows» — третє поле паспорта. Його хвіст зберігає початковий
; порядок усіх рядків, зокрема чотири різні виконавці «додати».
(визначити рядки-механізмів-функцій
  (решта (третє паспорт-механізмів-функцій)))

; Обхід списку не викидає повторні назви і не обирає виконавця
; замість профілю. Результат: список пар (виконавець механізм).
; Порожній або некоректний хвіст завершує обхід без запасного шляху.
; Резервні гілки обчислюють точну істину D1 через SENS АТОМ(NIL).
(визначити зібрати-механізми-функції
  (функція (назва залишок-рядків)
    (за-умовою
      ((атом? залишок-рядків) (як-є ()))
      ((атом? (перше залишок-рядків))
       (зібрати-механізми-функції назва (решта залишок-рядків)))
      ((хибне? (атом? (перше (перше залишок-рядків))))
       (зібрати-механізми-функції назва (решта залишок-рядків)))
      ((тотожне? назва (перше (перше залишок-рядків)))
       (сполучити
         (решта (перше залишок-рядків))
         (зібрати-механізми-функції назва (решта залишок-рядків))))
      ((атом? (як-є ()))
       (зібрати-механізми-функції назва (решта залишок-рядків))))))

; Запит за атомарною українською назвою функції.
; Структурований ключ не є ратифікованим іменем функції.
(визначити механізми-функції
  (функція (назва)
    (за-умовою
      ((атом? назва)
       (зібрати-механізми-функції назва рядки-механізмів-функцій))
      ((атом? (як-є ())) (як-є ())))))

; Живі Д1-закони SENS: чотири зовнішні маршрути Д5 ДОДАТИ.
; Не порівнюємо складені D7-назви через Д3 ТОТОЖНЕ? (лише атоми).
; Значення маршрутів перевіряє окремий повний SENS-селектор.
(за-умовою
 ((хибне? (порожній? (механізми-функції (як-є додати)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (порожній?
   (решта (решта (решта (механізми-функції (як-є додати))))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній?
   (решта (решта (решта (решта
     (механізми-функції (як-є додати)))))) так)
 (так (перше (як-є ()))))
; Неіснуюча назва й складений ключ мають повернути тільки ().
(за-умовою
 ((порожній? (механізми-функції (як-є повернути))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (механізми-функції (список (як-є додати)))) так)
 (так (перше (як-є ()))))

; Завантаження файла повертає весь паспорт, як і початкова таблиця.
паспорт-механізмів-функцій
