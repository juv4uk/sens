             (так (сполучити (система-обґрунтувань-створити-стан поточний-стан-підстановки (сполучити (перше поточні-факти) (отримати-використані-факти-зі-стану-система-обґрунтувань поточний-стан)))
                       (зіставити-звичайну-умову-з-фактами-система-обґрунтувань поточна-умова (решта поточні-факти) поточний-стан))))) (уніфікувати поточна-умова (перше поточні-факти) (отримати-підстановку-зі-стану-система-обґрунтувань поточний-стан)))))))

