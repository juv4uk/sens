       (сполучити (факт-від (перше поточні-записи))
                  (непідтримані-факти (решта поточні-записи)))))))

(визначити відкинути-непідтримані
  (функція (поточні-записи)
    (за-умовою
      ((атом? поточні-записи) (як-є ()))
      ((запис-підтриманий? (перше поточні-записи))
       (сполучити (перше поточні-записи)
                  (відкинути-непідтримані (решта поточні-записи))))
      (так (відкинути-непідтримані (решта поточні-записи))))))

; Спершу прибираємо сам запис факту, потім відкидаємо з інших записів
; залежні від нього обґрунтування. Факт без підстав каскадно відкликається,
; як у попередньому механізмі одного обґрунтування.
(визначити відкликати-факт-система-обґрунтувань
  (функція (поточний-факт поточні-записи)
    ((функція (обрізані-докази) ((функція (нові-непідтримані решта-записів) (за-умовою
          
          ((атом? нові-непідтримані)  решта-записів)
          (так (відкликати-факти-система-обґрунтувань нові-непідтримані решта-записів)))) (непідтримані-факти обрізані-докази) (відкинути-непідтримані обрізані-докази))) (обрізати-всі-записи поточний-факт (видалити-запис-система-обґрунтувань поточний-факт поточні-записи)))))

(визначити відкликати-факти-система-обґрунтувань
  (функція (поточні-факти поточні-записи)
    (за-умовою
      
      ((атом? поточні-факти)  поточні-записи)
      (так (відкликати-факти-система-обґрунтувань (решта поточні-факти) (відкликати-факт-система-обґрунтувань (перше поточні-факти) поточні-записи))))))

(визначити відкликати-факт-система-обґрунтувань!
  (макрос
    (функція (поточний-факт)
      (список (як-є визначити) (як-є пам'ять-обґрунтувань) (список (як-є відкликати-факт-система-обґрунтувань) поточний-факт (як-є пам'ять-обґрунтувань))))))

; Крок 6. Узгоджуємо форму правил прямого виведення з lib/reason.lisp.
; Історичний рушій приймав лише (pattern template) для одного факту.
; Загальна форма (head cond1 cond2 ...) містить висновок і умови:
; зворотне виведення доводить умови, пряме — добирає факти,
; які одночасно їм відповідають.
; Доказовий приклад: ((grandparent (var x) (var y))
; (parent (var x) (var z)) (parent (var z) (var y))).
; Для такого правила потрібне кон'юнктивне зіставлення, а не тільки
; перейменування команд. Підстановку послідовно передаємо між умовами,
; так само як у доведенні цілей, але відшукуємо збіги у списку фактів.
; Це додатковий шар для правил із багатьма умовами; старі одноумовні
; правила та окремі механізми підтримки обґрунтувань не переписуємо.

(визначити зіставити-умову-із-набором-фактів
  (функція (поточна-умова поточні-факти поточні-зв'язування)
    (за-умовою
      
      ((атом? поточні-факти)  (як-є ()))
      (так ((функція (поточний-стан-підстановки) (за-умовою
             ((підстановка-позначає-невдачу? поточний-стан-підстановки) (зіставити-умову-із-набором-фактів поточна-умова (решта поточні-факти) поточні-зв'язування))
             (так (сполучити поточний-стан-підстановки (зіставити-умову-із-набором-фактів поточна-умова (решта поточні-факти) поточні-зв'язування))))) (уніфікувати поточна-умова (перше поточні-факти) поточні-зв'язування))))))

; Крок 7. Заперечення за невдачею має форму (not (шаблон)).
; Раніше імпортер CLIPS пропускав такі правила, бо рушій не розумів not.
; Заперечення задовольняється, коли внутрішній шаблон не зіставляється
; з жодним поточним фактом за наявної підстановки.
; Нових зв'язувань при успіху не створюємо.
; Керування використовує тільки точний біт предиката Д1.
; Назвою оператора not може бути лише атомарна голова.

(визначити умова-має-форму-заперечення?
  (функція (поточна-умова)
    (за-умовою
      ((атом? поточна-умова) (атом? (як-є (()))))
      ((хибне? (атом? (перше поточна-умова))) (атом? (як-є (()))))
      ((однакові? (перше поточна-умова) (як-є хибне?)) (атом? (як-є ())))
      ((тотожне? (перше поточна-умова) (як-є not)) (атом? (як-є ())))
      (так (атом? (як-є (())))))))

; За успішного заперечення зберігаємо вихідну підстановку;
; внутрішній шаблон не повинен збігтися з жодним фактом.
(визначити зіставити-заперечену-умову-правила
  (функція (внутрішній-зразок поточні-факти поточні-зв'язування)
    (за-умовою
      ((атом? (зіставити-умову-із-набором-фактів внутрішній-зразок поточні-факти поточні-зв'язування))
       (список поточні-зв'язування))
      (так (як-є ())))))

; Крок 10. Умова (or (шаблон1) (шаблон2) ...) обирає
; об'єднання всіх успішних підстановок альтернатив.
; Без розпізнавання or зіставлення шукало б факт з такою головою.
; Кожну альтернативу зіставляємо як незалежну умову;
; вона може містити not або вкладену диз'юнкцію.
; Прогалину перевірено на правилі (or (cat ?x) (dog ?x)).

(визначити умова-має-форму-диз'юнкції?
  (функція (поточна-умова)
    (за-умовою
      
      ((атом? поточна-умова)  (як-є ()))
      ((хибне? (атом? (перше поточна-умова))) (тотожне? (перше поточна-умова) (як-є or)))
      ((атом? (перше поточна-умова))  (тотожне? (перше поточна-умова) (як-є or)))
      )))

(визначити зіставити-умову-логічного-або
  (функція (альтернативи-умов поточні-факти поточні-зв'язування)
    (за-умовою
      
      ((атом? альтернативи-умов)  (як-є ()))
      (так (приєднати (зіставити-одну-умову-правила (перше альтернативи-умов) поточні-факти поточні-зв'язування)
                  (зіставити-умову-логічного-або (решта альтернативи-умов) поточні-факти поточні-зв'язування))))))

; Крок 11. Явна кон'юнкція (and ...) усередині іншої умови
; повинна задовольнити кожну підумову.
; На верхньому рівні список умов уже є неявною кон'юнкцією,
; тому використовуємо ту саму послідовність підстановок.
; Це необхідно для (or (and (cat ?x) (small ?x)) (dog ?x)).
; Без окремого закону and така гілка помилково не спрацьовувала.

(визначити умова-має-форму-кон'юнкції?
  (функція (поточна-умова)
    (за-умовою
      
      ((атом? поточна-умова)  (як-є ()))
      ((хибне? (атом? (перше поточна-умова))) (тотожне? (перше поточна-умова) (як-є and)))
      ((атом? (перше поточна-умова))  (тотожне? (перше поточна-умова) (як-є and)))
      )))

(визначити зіставити-умову-кон'юнкції
  (функція (вкладені-умови поточні-факти поточні-зв'язування)
    (зіставити-умови вкладені-умови поточні-факти поточні-зв'язування)))

; Крок 12. Умова (test вираз) не зіставляє шаблон із фактом.
; Спочатку підставляємо раніше зв'язані змінні у вираз,
; потім обчислюємо отриману форму мовою СЕНС.
; Успіх зберігає попередню підстановку без нових зв'язувань.
; Джерело перевірки — (test (> ?x 5)).

(визначити умова-має-тестову-форму?
  (функція (поточна-умова)
    (за-умовою
      
      ((атом? поточна-умова)  (як-є ()))
      ((хибне? (атом? (перше поточна-умова))) (тотожне? (перше поточна-умова) (як-є test)))
      ((атом? (перше поточна-умова))  (тотожне? (перше поточна-умова) (як-є test)))
      )))

(визначити зіставити-тестову-умову
  (функція (поточний-вираз поточні-зв'язування)
    (нехай-похідне ((результат (обчислити (застосувати-підстановка поточний-вираз поточні-зв'язування))))
      ; Свідчення E1 (#216): історичний обчислювач точних величин повертав 0 за невдалого порівняння,
      ; який тоді тлумачився як істина. Стара двочастинна форма COND
      ; помилково визнавала хибну перевірку успішною.
      ; Умову відхиляємо для порожнього результату () або точної
      ; відповіді точного числового обчислювача 0. Структурні відповіді порівняння також
      ; перевіряємо явно, не передаючи числа в COND як умови.
      (за-умовою
        ((порожній? результат) (як-є ()))
        ; Д5 НУЛЬ? має вузьку передумову: лише числовий Д24+.
        ; Ненульовий символ або складений результат не спричиняє TypeError.
        ((число? результат)
         (за-умовою
           ((нуль? результат) (як-є ()))
           (так (список поточні-зв'язування))))
        (так (список поточні-зв'язування))))))

; Крок 15. Умови існування та загальності мають окремі закони.
; Проблему виявлено на зовнішньому прикладі CLIPS Sudoku:
; пошук факту з буквальною головою exists не працює.
; Exists успішний, якщо хоча б одна підстановка задовольнила
; всі його підумови, але не створює нових зовнішніх зв'язувань.
; Квантор загальності перевіряє всі підстановки першої умови й вимагає,
; щоб решта умов виконувалася для кожної.
; Не підміняємо загальний квантор комбінацією not exists not: чинне заперечення
; зіставляє лише внутрішній шаблон, а не складену кон'юнкцію.
; Назви exists, forall і not залишаються даними протоколу.

(визначити умова-має-квантор-існування?
  (функція (поточна-умова)
    (за-умовою
      
      ((атом? поточна-умова)  (як-є ()))
      ((хибне? (атом? (перше поточна-умова))) (тотожне? (перше поточна-умова) (як-є exists)))
      ((атом? (перше поточна-умова))  (тотожне? (перше поточна-умова) (як-є exists)))
      )))

(визначити зіставити-умову-існування
  (функція (вкладені-умови поточні-факти поточні-зв'язування)
    (за-умовою
      
      ((атом? (зіставити-умови вкладені-умови поточні-факти поточні-зв'язування))  (як-є ()))
      (так (список поточні-зв'язування)))))

(визначити умова-має-загальний-квантор?
  (функція (поточна-умова)
    (за-умовою
      
      ((атом? поточна-умова)  (як-є ()))
      ((хибне? (атом? (перше поточна-умова))) (тотожне? (перше поточна-умова) (як-є forall)))
      ((атом? (перше поточна-умова))  (тотожне? (перше поточна-умова) (як-є forall)))
      )))

(визначити кожен-кандидат-задовольняє-умову?
  (функція (кандидати-фактів решта-умов поточні-факти)
    (за-умовою
      
      ((атом? кандидати-фактів)  (атом? (як-є ())))
      
      ((атом? (зіставити-умови решта-умов поточні-факти (перше кандидати-фактів)))  (як-є ()))
      (так (кожен-кандидат-задовольняє-умову? (решта кандидати-фактів) решта-умов поточні-факти)))))

(визначити зіставити-умову-для-всіх-кандидатів
  (функція (перша-умова решта-умов поточні-факти поточні-зв'язування)
    (за-умовою
      ((кожен-кандидат-задовольняє-умову?
         (зіставити-одну-умову-правила перша-умова поточні-факти поточні-зв'язування) решта-умов поточні-факти)
       (список поточні-зв'язування))
      )))

(визначити зіставити-одну-умову-правила
  (функція (поточна-умова поточні-факти поточні-зв'язування)
    (за-умовою
      ((умова-має-форму-заперечення? поточна-умова) (зіставити-заперечену-умову-правила (друге поточна-умова) поточні-факти поточні-зв'язування))
      ((умова-має-форму-диз'юнкції? поточна-умова) (зіставити-умову-логічного-або (решта поточна-умова) поточні-факти поточні-зв'язування))
      ((умова-має-форму-кон'юнкції? поточна-умова) (зіставити-умову-кон'юнкції (решта поточна-умова) поточні-факти поточні-зв'язування))
      ((умова-має-тестову-форму? поточна-умова) (зіставити-тестову-умову (друге поточна-умова) поточні-зв'язування))
      ((умова-має-квантор-існування? поточна-умова) (зіставити-умову-існування (решта поточна-умова) поточні-факти поточні-зв'язування))
      ((умова-має-загальний-квантор? поточна-умова)
       (зіставити-умову-для-всіх-кандидатів (друге поточна-умова) (решта (решта поточна-умова)) поточні-факти поточні-зв'язування))
      (так (зіставити-умову-із-набором-фактів поточна-умова поточні-факти поточні-зв'язування)))))

; Послідовний обхід умов використовує закон lib/unify.lisp,
; спільний із доведенням цілей у lib/reason.lisp.
; Кожну умову звіряємо з явним списком фактів, а заперечення
; успішне лише за відсутності збігу внутрішнього шаблону.
(визначити зіставити-умови
  (функція (поточні-умови поточні-факти поточні-зв'язування)
    (потік-виконання-кон'юнкція поточні-умови поточні-зв'язування
      (функція (поточна-умова поточний-стан-підстановки) (зіставити-одну-умову-правила поточна-умова поточні-факти поточний-стан-підстановки)))))

(визначити застосувати-голову-правила-до-підстановок
  (функція (голова-правила підстановки)
    (за-умовою
      
      ((атом? підстановки)  (як-є ()))
      (так (сполучити (застосувати-підстановка голова-правила (перше підстановки)) (застосувати-голову-правила-до-підстановок голова-правила (решта підстановки)))))))

; Правило (head cond1 cond2 ...) породжує головний факт
; для кожної підстановки, що задовольняє всі умови.
; Повторені факти прибирає подальше об'єднання з перевіркою членства.
(визначити застосувати-одне-правило-до-всіх-збігів
  (функція (поточне-правило поточні-факти)
    (за-умовою
      ((атом? (решта поточне-правило))
       (застосувати-голову-правила-до-підстановок (перше поточне-правило) (список (як-є ()))))
      ((хибне? (атом? (решта поточне-правило)))
       (застосувати-голову-правила-до-підстановок (перше поточне-правило) (зіставити-умови (решта поточне-правило) поточні-факти (як-є ())))))))

(визначити застосувати-правила-до-всіх-збігів
  (функція (поточні-правила поточні-факти)
    (за-умовою
      ((атом? поточні-правила) (як-є ()))
      ((хибне? (атом? поточні-правила))
       (приєднати (застосувати-одне-правило-до-всіх-збігів (перше поточні-правила) поточні-факти)
                 (застосувати-правила-до-всіх-збігів (решта поточні-правила) поточні-факти))))))

(визначити виконати-багатоваріантне-виведення
  (функція (правила факти)
    ((функція (об'єднані) (за-умовою
        ((уніфікація-рівні? об'єднані факти) факти)
        (так (виконати-багатоваріантне-виведення правила об'єднані))))
      (додати-нові (застосувати-правила-до-всіх-збігів правила факти) факти))))

; Історичне зовнішнє ім'я — те саме мовне замикання.
