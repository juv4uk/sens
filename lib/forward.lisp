         ((обчислити (застосувати-підстановка (друге поточна-умова) (отримати-підстановку-зі-стану-система-обґрунтувань поточний-стан))) (список поточний-стан))
         ))
      (так (зіставити-звичайну-умову-з-фактами-система-обґрунтувань поточна-умова поточні-факти поточний-стан)))))

(визначити зіставити-умови-система-обґрунтувань
