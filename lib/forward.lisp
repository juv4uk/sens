    ((функція (об'єднані-записи) (за-умовою
        ((уніфікація-рівні? об'єднані-записи поточні-записи) поточні-записи)
        (так (запустити-система-обґрунтувань-мульти поточні-правила об'єднані-записи)))) (додати-нові-записи-система-обґрунтувань (запустити-правила-система-обґрунтувань-мульти поточні-правила (мапа-факт-від поточні-записи)) поточні-записи))))

(визначити запустити-система-обґрунтувань-мульти!
  (макрос
    (функція (поточні-правила)
      (список (як-є визначити) (як-є пам'ять-обґрунтувань) (список (як-є запустити-система-обґрунтувань-мульти) поточні-правила (як-є пам'ять-обґрунтувань))))))

