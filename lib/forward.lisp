; Чинний рушій прямого виведення СЕНС: ратифіковані Д1–Д10
; та повна українська проєкція викличних голів.
; Викличні коди визначає чинна доменна драбина; прихованого обходу немає.
; Істина та хиба — точні значення Д1; десяткові математичні значення
; належать Д24+, а T5M виконує лише фізичне пакування.
;
; Рушій працює з пам'яттю фактів і правилами зіставлення та дії,
; як у CLIPS. Це доповнення до зворотного виведення в lib/reason.lisp.
; Використано мовні функції уніфікації та підстановки з lib/unify.lisp,
; без вбудовування бібліотеки CLIPS і без нових примітивів Rust.
;
; Перший крок: застосувати одне правило до одного факту.
; Плану черги, пошуку нерухомої точки, відкликання фактів і підтримки
; обґрунтувань на цьому кроці немає — це окремі можливості.
; Правило є парою (шаблон зразок). Шаблон може містити логічні змінні
; протоколу (var name); зразок підставляє знайдені зв'язування.
;
(визначити робоча-пам'ять (як-є ()))

(визначити ствердити-факт!
  (макрос
    (функція (факт)
      (список (як-є визначити) (як-є робоча-пам'ять) (список (як-є сполучити) факт (як-є робоча-пам'ять))))))

; Зіставляємо шаблон правила з одним фактом. За успіху
; повертаємо зразок із підставленими зв'язуваннями — новий факт.
; За невдачі повертаємо протокольний атом no-match, а не порожній
; список: порожній список може бути коректним результатом правила.
; Імена та значення зовнішнього протоколу залишаються незмінними.
(визначити запустити-правило
  (функція (правило факт)
    ; Дві складові — рівно (шаблон зразок). Немає CAR/CDR атома,
    ; неповного правила чи непомітно проігнорованого третього поля.
    ; Відмова зберігає чинний протокольний атом no-match.
    (за-умовою
      ((атом? правило) (як-є no-match))
      ((атом? (решта правило)) (як-є no-match))
      ((хибне? (порожній? (решта (решта правило)))) (як-є no-match))
      (так
       ((функція (шаблон зразок)
          ((функція (зв'язування)
             (за-умовою
               ((підстановка-позначає-невдачу? зв'язування)
                (як-є no-match))
               (так (застосувати-підстановка зразок зв'язування))))
           (уніфікувати шаблон факт (як-є ()))))
        (перше правило)
        (друге правило))))))

; Другий крок: застосувати одне правило до кожного факту списку
; та зібрати нові факти. Це чиста функція без запису в робочу
; пам'ять, без обходу всього набору правил і без циклу до стабілізації.
; Невдалі зіставлення з маркером no-match відкидаються.
; Перед перевіркою тотожності атома результату потрібно впевнитися,
; що результат атомарний. Успіх може породити складений список,
; для якого атомарне порівняння непридатне.
(визначити запустити-правило-на-факти
  (функція (правило факти)
    (за-умовою
      ((атом? факти) (як-є ()))
      (так
       ((функція (результат)
          (за-умовою
            ; Складений факт — успішний результат; D3 EQ приймає тільки атоми.
            ((хибне? (атом? результат))
             (сполучити
               результат
               (запустити-правило-на-факти правило (решта факти))))
            ; Лише атомарний маркер невдачі пропускаємо.
            ((тотожне? результат (як-є no-match))
             (запустити-правило-на-факти правило (решта факти)))
            (так
             (сполучити
               результат
               (запустити-правило-на-факти правило (решта факти))))))
        (запустити-правило правило (перше факти)))))))
; Зручний виклик бере факти з поточної робочої пам'яті.
; Передавати цей список явним аргументом тут не потрібно.

(визначити запустити-правило-на-робоча-пам'ять
  (функція (правило-для-робочої-памяті)
    (запустити-правило-на-факти правило-для-робочої-памяті робоча-пам'ять)))

; Крок 3. Одним проходом застосовуємо всі правила набору до фактів.
; Новий факт не зіставляється з іншими правилами під час того самого виклику:
; циклу до нерухомої точки на цьому етапі ще немає.
; Результати об'єднуємо, як під час перебору правил для цілі
; у lib/reason.lisp. Це розгалуження виведено засобами СЕНС.

(визначити запустити-правила-на-факти
  (функція (правила-для-фактів факти-для-правил)
    (за-умовою
      
      ((атом? правила-для-фактів)  (як-є ()))
      (так (приєднати (запустити-правило-на-факти (перше правила-для-фактів) факти-для-правил)
                  (запустити-правила-на-факти (решта правила-для-фактів) факти-для-правил))))))

(визначити запустити-правила-на-робоча-пам'ять
  (функція (правила-робочої-пам'яті)
    (запустити-правила-на-факти правила-робочої-пам'яті робоча-пам'ять)))

; Крок 4. Повторюємо застосування всіх правил до поточного списку фактів,
; доки прохід не перестане додавати нові факти. Складені факти порівнюємо
; структурно й не додаємо дублікати. Рівність вихідного та злитого списків
; доводить нерухому точку без довжини, десяткової арифметики чи Д24-примусу.
; Рушій повертає підсумковий список як чиста функція.
; Він сам не записує його у робоча-пам'ять: замикання не повинне
; видавати локальне переприв'язування за зміну глобального стану.
; Окреме явне ствердження фактів на верхньому рівні оновлює пам'ять.
;
; Перевірка членства — похідний закон СЕНС для структурних фактів.
; На відміну від старого MEMBER, вона не звертається до першого складника
; порожнього списку й не вимагає окремого допуску D8 EQUAL.

(визначити факт-наявний?
  (функція (факт-для-пошуку память-для-пошуку)
    (за-умовою
      ((порожній? память-для-пошуку) (атом? (як-є (()))))
      ((уніфікація-рівні? факт-для-пошуку (перше память-для-пошуку)) (атом? (як-є ())))
      (так (факт-наявний? факт-для-пошуку (решта память-для-пошуку))))))

(визначити додати-нові
  (функція (нові-факти наявні-факти)
    (за-умовою
      ((атом? нові-факти) наявні-факти)
      ((факт-наявний? (перше нові-факти) наявні-факти)
       (додати-нові (решта нові-факти) наявні-факти))
      (так
       (додати-нові
         (решта нові-факти)
         (сполучити (перше нові-факти) наявні-факти))))))

(визначити запустити
  (функція (правила факти)
    ((функція (злиті-факти)
       (за-умовою
         ((уніфікація-рівні? злиті-факти факти) факти)
         (так (запустити правила злиті-факти))))
     (додати-нові (запустити-правила-на-факти правила факти) факти))))

(визначити ствердити-факти!
  (макрос
    (функція (факти)
      (список (як-є визначити) (як-є робоча-пам'ять) (список (як-є додати-нові) факти (як-є робоча-пам'ять))))))

; Крок 5а. Відкликання прибирає зі списку перший структурно рівний факт.
; На цьому етапі ще немає підтримки обґрунтувань: похідний факт може
; залишитися після відкликання єдиної підстави його виведення.
; Простий список фактів не пам'ятає причин появи кожного елемента.
; Для каскадного відкликання потрібні пари факту та його підстав;
; цю окрему можливість визначено далі в кроці 5б.

(визначити відкликати-факт
  (функція (факт-для-вилучення факти-перед-вилученням)
    (за-умовою
      
      ((атом? факти-перед-вилученням)  (як-є ()))
      ((уніфікація-рівні? факт-для-вилучення (перше факти-перед-вилученням)) (решта факти-перед-вилученням))
      (так (сполучити (перше факти-перед-вилученням) (відкликати-факт факт-для-вилучення (решта факти-перед-вилученням)))))))

(визначити відкликати-факт!
  (макрос
    (функція (поточний-факт)
      (список (як-є визначити) (як-є робоча-пам'ять) (список (як-є відкликати-факт) поточний-факт (як-є робоча-пам'ять))))))

; Крок 5б. Додаємо мінімальний механізм підтримки обґрунтувань.
; Обґрунтований факт має форму (факт . підтримка): підтримка містить
; факти, потрібні правилу, а порожня підтримка означає пряму аксіому.
; Відкликання підстави каскадно відкликає факти, які від неї залежать.
;
; Ця версія пам'ятає лише перше обґрунтування кожного факту.
; Якщо факт має інший незалежний доказ, його все одно можуть відкликати:
; така межа можливостей явна, не прихована. Наступний крок розширює
; запис до кількох незалежних обґрунтувань.
; Окрема обґрунтована-пам'ять не підміняє робоча-пам'ять,
; тому попередні функції списку фактів зберігають свою поведінку.

(визначити створити-обґрунтований
  (функція (факт-із-підставами підстави-факту)
    (сполучити факт-із-підставами підстави-факту)))

(визначити факт-від (функція (запис-обґрунтування) (перше запис-обґрунтування)))
(визначити підтримки-від (функція (запис-обґрунтування) (решта запис-обґрунтування)))
(визначити аксіома (функція (аксіоматичний-факт) (створити-обґрунтований аксіоматичний-факт (як-є ()))))

(визначити мапа-факт-від
  (функція (записи-обґрунтувань)
    (за-умовою
      
      ((атом? записи-обґрунтувань)  (як-є ()))
      (так (сполучити (факт-від (перше записи-обґрунтувань)) (мапа-факт-від (решта записи-обґрунтувань)))))))

; Правило діє як на першому кроці, але успішний результат
; доповнюємо фактом, що його обґрунтував.
(визначити запустити-правило-система-істини
  (функція (правило факт)
    ((функція (результат)
       (за-умовою
         ; Успішний складений факт не порівнюється атомарним Д3 EQ.
         ((хибне? (атом? результат))
          (створити-обґрунтований результат (список факт)))
         ((тотожне? результат (як-є no-match)) (як-є no-match))
         (так (створити-обґрунтований результат (список факт)))))
     (запустити-правило правило факт))))

(визначити запустити-правило-на-факти-система-істини
  (функція (правило факти)
    (за-умовою
      ((атом? факти) (як-є ()))
      (так
       ((функція (результат)
          (за-умовою
            ; Лише атомарний no-match пропускаємо; складена пара — доказ.
            ((атом? результат)
             (запустити-правило-на-факти-система-істини правило (решта факти)))
            (так
             (сполучити
               результат
               (запустити-правило-на-факти-система-істини правило (решта факти))))))
        (запустити-правило-система-істини правило (перше факти)))))))

(визначити запустити-правила-на-факти-система-істини
  (функція (поточні-правила поточні-факти)
    (за-умовою
      
      ((атом? поточні-правила)  (як-є ()))
      (так (приєднати (запустити-правило-на-факти-система-істини (перше поточні-правила) поточні-факти)
                  (запустити-правила-на-факти-система-істини (решта поточні-правила) поточні-факти))))))

(визначити обґрунтований-член?
  (функція (поточний-факт поточні-записи)
    (за-умовою
      
      ((атом? поточні-записи) (атом? (як-є (()))))
      ((уніфікація-рівні? поточний-факт (факт-від (перше поточні-записи))) (атом? (як-є ())))
      (так (обґрунтований-член? поточний-факт (решта поточні-записи))))))

(визначити додати-нові-обґрунтований
  (функція (нові-записи поточні-записи)
    (за-умовою
      
      ((атом? нові-записи)  поточні-записи)
      ((обґрунтований-член? (факт-від (перше нові-записи)) поточні-записи)
       (додати-нові-обґрунтований (решта нові-записи) поточні-записи))
      (так (додати-нові-обґрунтований (решта нові-записи) (сполучити (перше нові-записи) поточні-записи))))))

; Цикл до нерухомої точки над обґрунтованими фактами, як у кроці 4.
(визначити запустити-система-істини
  (функція (поточні-правила поточні-записи)
    ((функція (нові-записи) ((функція (об'єднані-записи) (за-умовою
          ((уніфікація-рівні? об'єднані-записи поточні-записи) поточні-записи)
          (так (запустити-система-істини поточні-правила об'єднані-записи)))) (додати-нові-обґрунтований нові-записи поточні-записи))) (запустити-правила-на-факти-система-істини поточні-правила (мапа-факт-від поточні-записи)))))

(визначити обґрунтована-пам'ять (як-є ()))

(визначити ствердити-факт-система-істини!
  (макрос
    (функція (поточний-факт)
      (список (як-є визначити) (як-є обґрунтована-пам'ять) (список (як-є додати-нові-обґрунтований) (список (як-є список) (список (як-є аксіома) поточний-факт)) (як-є обґрунтована-пам'ять))))))

(визначити запустити-система-істини!
  (макрос
    (функція (поточні-правила)
      (список (як-є визначити) (як-є обґрунтована-пам'ять) (список (як-є запустити-система-істини) поточні-правила (як-є обґрунтована-пам'ять))))))

(визначити видалити-обґрунтований
  (функція (поточний-факт поточні-записи)
    (за-умовою
      
      ((атом? поточні-записи)  (як-є ()))
      ((уніфікація-рівні? поточний-факт (факт-від (перше поточні-записи))) (видалити-обґрунтований поточний-факт (решта поточні-записи)))
      (так (сполучити (перше поточні-записи) (видалити-обґрунтований поточний-факт (решта поточні-записи)))))))

(визначити залежні-від
  (функція (поточний-факт поточні-записи)
    (за-умовою
      
      ((атом? поточні-записи)  (як-є ()))
      ((значення-у-списку? поточний-факт (підтримки-від (перше поточні-записи)))
       (сполучити (факт-від (перше поточні-записи)) (залежні-від поточний-факт (решта поточні-записи))))
      (так (залежні-від поточний-факт (решта поточні-записи))))))

; Відкликаємо факт і рекурсивно всі похідні факти,
; для яких він був необхідною підставою.
(визначити відкликати-факт-система-істини
  (функція (поточний-факт поточні-записи)
    (відкликати-факти-система-істини (залежні-від поточний-факт поточні-записи) (видалити-обґрунтований поточний-факт поточні-записи))))

(визначити відкликати-факти-система-істини
  (функція (поточні-факти поточні-записи)
    (за-умовою
      
      ((атом? поточні-факти)  поточні-записи)
      (так (відкликати-факти-система-істини (решта поточні-факти) (відкликати-факт-система-істини (перше поточні-факти) поточні-записи))))))

(визначити відкликати-факт-система-істини!
  (макрос
    (функція (поточний-факт)
      (список (як-є визначити) (як-є обґрунтована-пам'ять) (список (як-є відкликати-факт-система-істини) поточний-факт (як-є обґрунтована-пам'ять))))))

; Крок 5в. Підтримуємо кілька незалежних обґрунтувань одного факту.
; Запис має форму (факт обґрунтування-1 обґрунтування-2 ...).
; Кожне обґрунтування є списком потрібних фактів; порожній список
; означає безпосередньо стверджену аксіому.
; Під час відкликання вилучаємо тільки ті обґрунтування, які справді
; містять відкликану підставу. Похідний факт зникає лише тоді,
; коли жодного незалежного обґрунтування не залишилося.
; Окрема пам'ять-обґрунтувань не замінює робочу пам'ять
; і не змінює простішу систему одного обґрунтування з кроку 5б.

(визначити обґрунтування-від (функція (поточний-запис) (решта поточний-запис)))

(визначити запустити-правило-система-обґрунтувань
  (функція (правило факт)
    ((функція (результат)
       (за-умовою
         ; Доказ JTMS не є атомом; порівнюємо тільки атомарний no-match.
         ((хибне? (атом? результат))
          (список результат (список факт)))
         ((тотожне? результат (як-є no-match)) (як-є no-match))
         (так (список результат (список факт)))))
     (запустити-правило правило факт))))

(визначити запустити-правило-на-факти-система-обґрунтувань
  (функція (правило факти)
    (за-умовою
      ((атом? факти) (як-є ()))
      (так
       ((функція (результат)
          (за-умовою
            ((атом? результат)
             (запустити-правило-на-факти-система-обґрунтувань правило (решта факти)))
            (так
             (сполучити
               результат
               (запустити-правило-на-факти-система-обґрунтувань правило (решта факти))))))
        (запустити-правило-система-обґрунтувань правило (перше факти)))))))

(визначити запустити-правила-на-факти-система-обґрунтувань
  (функція (поточні-правила поточні-факти)
    (за-умовою
      
      ((атом? поточні-правила)  (як-є ()))
      (так (приєднати (запустити-правило-на-факти-система-обґрунтувань (перше поточні-правила) поточні-факти)
                  (запустити-правила-на-факти-система-обґрунтувань (решта поточні-правила) поточні-факти))))))

(визначити знайти-запис-за-фактом
  (функція (поточний-факт поточні-записи)
    (за-умовою
      
      ((атом? поточні-записи)  (як-є ()))
      ((уніфікація-рівні? поточний-факт (факт-від (перше поточні-записи))) (перше поточні-записи))
      (так (знайти-запис-за-фактом поточний-факт (решта поточні-записи))))))

(визначити видалити-запис-система-обґрунтувань
  (функція (поточний-факт поточні-записи)
    (за-умовою
      
      ((атом? поточні-записи)  (як-є ()))
      ((уніфікація-рівні? поточний-факт (факт-від (перше поточні-записи))) (видалити-запис-система-обґрунтувань поточний-факт (решта поточні-записи)))
      (так (сполучити (перше поточні-записи) (видалити-запис-система-обґрунтувань поточний-факт (решта поточні-записи)))))))

; Додаємо пару (факт обґрунтування) до записів.
; Новий факт отримує запис, старий — лише нове обґрунтування.
; Повторне виведення тим самим шляхом не змінює пам'ять,
; що забезпечує завершення циклу до нерухомої точки.
(визначити додати-обґрунтування
  (функція (поточний-факт обґрунтування-доказ поточні-записи)
    ((функція (існуючий-запис)
       (за-умовою
         ((порожній? існуючий-запис)
          (сполучити (список поточний-факт обґрунтування-доказ) поточні-записи))
         ((значення-у-списку? обґрунтування-доказ (обґрунтування-від існуючий-запис))
          поточні-записи)
         (так
          (сполучити
            (сполучити поточний-факт
              (сполучити обґрунтування-доказ (обґрунтування-від існуючий-запис)))
            (видалити-запис-система-обґрунтувань поточний-факт поточні-записи)))))
     (знайти-запис-за-фактом поточний-факт поточні-записи))))

(визначити додати-нові-записи-система-обґрунтувань
  (функція (нові-записи поточні-записи)
    (за-умовою
      
      ((атом? нові-записи)  поточні-записи)
      (так (додати-нові-записи-система-обґрунтувань
           (решта нові-записи)
           (додати-обґрунтування (факт-від (перше нові-записи)) (друге (перше нові-записи)) поточні-записи))))))

; Порівнюємо повний об'єднаний результат, а не кількість записів:
; нове обґрунтування може з'явитися в уже відомого факту,
; не змінюючи кількості фактів.
(визначити запустити-система-обґрунтувань
  (функція (поточні-правила поточні-записи)
