  (функція (кандидати-фактів решта-умов поточні-факти)
    (за-умовою
      
      ((атом? кандидати-фактів)  так)
      
      ((атом? (зіставити-умови решта-умов поточні-факти (перше кандидати-фактів)))  (як-є ()))
      (так (кожен-кандидат-задовольняє-умову? (решта кандидати-фактів) решта-умов поточні-факти)))))

(визначити зіставити-умову-для-всіх-кандидатів
  (функція (перша-умова решта-умов поточні-факти поточні-зв'язування)
    (за-умовою
      ((кожен-кандидат-задовольняє-умову?
         (зіставити-одну-умову-правила перша-умова поточні-факти поточні-зв'язування) решта-умов поточні-факти)
       (список поточні-зв'язування))
      )))

(визначити зіставити-одну-умову-правила
  (функція (поточна-умова поточні-факти поточні-зв'язування)
    (за-умовою
      ((умова-має-форму-заперечення? поточна-умова) (зіставити-заперечену-умову-правила (друге поточна-умова) поточні-факти поточні-зв'язування))
      ((умова-має-форму-диз'юнкції? поточна-умова) (зіставити-умову-логічного-або (решта поточна-умова) поточні-факти поточні-зв'язування))
      ((умова-має-форму-кон'юнкції? поточна-умова) (зіставити-умову-кон'юнкції (решта поточна-умова) поточні-факти поточні-зв'язування))
      ((умова-має-тестову-форму? поточна-умова) (зіставити-тестову-умову (друге поточна-умова) поточні-зв'язування))
      ((умова-має-квантор-існування? поточна-умова) (зіставити-умову-існування (решта поточна-умова) поточні-факти поточні-зв'язування))
      ((умова-має-загальний-квантор? поточна-умова)
       (зіставити-умову-для-всіх-кандидатів (друге поточна-умова) (решта (решта поточна-умова)) поточні-факти поточні-зв'язування))
      (так (зіставити-умову-із-набором-фактів поточна-умова поточні-факти поточні-зв'язування)))))

; Built directly on `thread-conjunction` (lib/unify.lisp) — the same
; conjunction-walking kernel `lib/reason.lisp`'s `prove-goals` threads a
; richer `(subst proofs)` state through. Here `try-one` is
; `match-one-condition`: for one condition, either match it against every
; fact in the explicit list, or (for `not`) check that its inner pattern
; matches none of them — rather than recursively searching further rules.
(визначити зіставити-умови
  (функція (поточні-умови поточні-факти поточні-зв'язування)
    (потік-виконання-кон'юнкція поточні-умови поточні-зв'язування
      (функція (поточна-умова поточний-стан-підстановки) (зіставити-одну-умову-правила поточна-умова поточні-факти поточний-стан-підстановки)))))

(визначити застосувати-голову-правила-до-підстановок
  (функція (голова-правила підстановки)
    (за-умовою
      
      ((атом? підстановки)  (як-є ()))
      (так (сполучити (застосувати-підстановка голова-правила (перше підстановки)) (застосувати-голову-правила-до-підстановок голова-правила (решта підстановки)))))))

; Fires a `(head cond1 cond2 ...)` rule against a fact list: finds every
; substitution satisfying the whole condition conjunction, and returns one
; derived `head` per substitution found (possibly the same fact more than
; once, if several substitutions produce it — downstream dedup via
; `append-new`/`member?` already handles that, same as Steps 1-5).
(визначити застосувати-одне-правило-до-всіх-збігів
  (функція (поточне-правило поточні-факти)
    (за-умовою
      ((атом? (решта поточне-правило))
       (застосувати-голову-правила-до-підстановок (перше поточне-правило) (список (як-є ()))))
      ((хибне? (атом? (решта поточне-правило)))
       (застосувати-голову-правила-до-підстановок (перше поточне-правило) (зіставити-умови (решта поточне-правило) поточні-факти (як-є ())))))))

(визначити застосувати-правила-до-всіх-збігів
  (функція (поточні-правила поточні-факти)
    (за-умовою
      ((атом? поточні-правила) (як-є ()))
      ((хибне? (атом? поточні-правила))
       (приєднати (застосувати-одне-правило-до-всіх-збігів (перше поточні-правила) поточні-факти)
                 (застосувати-правила-до-всіх-збігів (решта поточні-правила) поточні-факти))))))

(визначити виконати-багатоваріантне-виведення
  (функція (правила факти)
    ((функція (об'єднані) (за-умовою
        ((однакові? (довжина об'єднані) (довжина факти)) факти)
        (так (виконати-багатоваріантне-виведення правила об'єднані))))
      (додати-нові (застосувати-правила-до-всіх-збігів правила факти) факти))))

