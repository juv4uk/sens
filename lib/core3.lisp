; Експериментальний профіль третього ядра.
;
; Профіль користується спільними механізмами мови, не дублює
; реєстрів, семантичних законів і таблиць виконавців.
;
; Порядок завантаження: четверте ядро, проєкція семантичного реєстру,
; добір механізму, тоді цей профіль.
;
; Викличні голови "визначити", "функція", "як-є", "сполучити"
; і "список" належать ратифікованій українській проєкції.
; "Вибрати-механізм" уже визначено в бібліотеці добору механізмів.
; Його бібліотечне визначення не створює нової машинної координати.
;
; Чотири назви виконавців усередині цитування - точні чинні
; значення протоколу маршрутизації, а не викличні голови.
; Підміняти їх перекладом без зміни протоколу не можна.
; Побудова впорядкованого списку належить третьому домену.
; Результати перевіряє обчислювач СЕНС, а не зовнішній виконавець.

(визначити ядро3-виконавці
  (сполучити (як-є common-lisp)
    (сполучити (як-є prolog)
      (сполучити (як-є clips)
        (сполучити (як-є datalog)
          (як-є ()))))))

(визначити ядро3-маршрут
  (функція (ідентичність виконавець)
    (вибрати-механізм ідентичність виконавець)))

(визначити ядро3-додати-маршрути
  (функція (ідентичність)
    (список
      (ядро3-маршрут ідентичність (як-є common-lisp))
      (ядро3-маршрут ідентичність (як-є prolog))
      (ядро3-маршрут ідентичність (як-є clips))
      (ядро3-маршрут ідентичність (як-є datalog)))))

(визначити ядро3-стан-профілю
  (функція ()
    (як-є
      (core3
        (contract "7" "0")
        (role experimental-kernel-laboratory)
        (selector shared-lisp-owned)
        (lowering partial)
        (clips-result-observation blocked)
        (four-island-round-trip pending)))))

; Кінцевий виклик-свідок: файл виконується при завантаженні, а не лише визначає.
(ядро3-стан-профілю)
