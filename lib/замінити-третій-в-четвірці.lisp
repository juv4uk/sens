; Д3/Д4: заміна лише третього елемента власної четвірки.
; Визначення належить SENS Lisp, не Rust/Python/JSON.
(визначити замінити-третій-в-четвірці
  (функція (елементи новий)
    (сполучити (перше елементи)
      (сполучити (перше (решта елементи))
        (сполучити новий (решта (решта (решта елементи))))))))

; Закон: перший, другий та четвертий зберігаються; третій оновлений.
(визначити початкова-четвірка
  (список (як-є атом?) (як-є тотожне?) (як-є решта) (як-є сполучити)))
(визначити оновлена-четвірка
  (замінити-третій-в-четвірці початкова-четвірка (як-є за-умовою)))

(за-умовою
  ((тотожне? (перше оновлена-четвірка) (як-є атом?))
   (за-умовою
     ((тотожне? (друге оновлена-четвірка) (як-є тотожне?))
      (за-умовою
        ((тотожне? (перше (решта (решта оновлена-четвірка))) (як-є за-умовою))
         (за-умовою
           ((тотожне?
              (перше (решта (решта (решта оновлена-четвірка))))
              (як-є сполучити))
            (хибне?
              (тотожне? (перше (решта (решта оновлена-четвірка))) (як-є решта))))
           ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон зворотної підстановки: старе третє значення відновлюється.
(визначити відновлена-четвірка-після-заміни
  (замінити-третій-в-четвірці оновлена-четвірка (як-є решта)))
(за-умовою
  ((тотожне? (перше (решта-решти відновлена-четвірка-після-заміни)) (як-є решта))
   (за-умовою
     ((тотожне? (друге (решта-решти відновлена-четвірка-після-заміни)) (як-є сполучити))
      (хибне? (тотожне? (перше (решта-решти відновлена-четвірка-після-заміни)) (як-є за-умовою))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
