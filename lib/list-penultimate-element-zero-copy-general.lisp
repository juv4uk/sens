; СЕНС Д3 і Д5: передостанній елемент правильного списку.
; Для довжини 0 або 1 повертаємо порожнє значення.
; Один перегляд без копіювання хвоста і додаткових пар.
(визначити передостанній-елемент
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((порожній? (решта елементи)) (як-є ()))
   ((порожній? (решта (решта елементи))) (перше елементи))
   (так (передостанній-елемент (решта елементи))))))

; Хибна умова викликає перше від порожнього списку.
(за-умовою
 ((порожній? (передостанній-елемент (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (передостанній-елемент (список (як-є атом?)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (передостанній-елемент
             (список (як-є атом?) (як-є решта)))
            (як-є атом?)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (передостанній-елемент
             (список (як-є атом?) (як-є решта) (як-є сполучити)))
            (як-є решта)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (передостанній-елемент
             (список (як-є атом?) (як-є решта)
                     (як-є сполучити) (як-є функція)))
            (як-є сполучити)) так)
 (так (перше (як-є ()))))
; Повтори не змінюють позицію.
(за-умовою
 ((тотожне? (передостанній-елемент
             (список (як-є атом?) (як-є атом?) (як-є решта)))
            (як-є атом?)) так)
 (так (перше (як-є ()))))
; Повертаємо сам складений елемент, а не його перший символ.
(за-умовою
 ((хибне? (атом? (передостанній-елемент
                   (список (як-є атом?) (список (як-є функція))
                           (як-є решта))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (передостанній-елемент
                    (список (як-є атом?) (список (як-є функція))
                            (як-є решта))))
            (як-є функція)) так)
 (так (перше (як-є ()))))
; Негатив: не плутати передостанній із першим чи останнім.
(за-умовою
 ((хибне? (тотожне? (передостанній-елемент
                     (список (як-є атом?) (як-є решта) (як-є сполучити)))
                    (як-є атом?))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (тотожне? (передостанній-елемент
                     (список (як-є атом?) (як-є решта) (як-є сполучити)))
                    (як-є сполучити))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
