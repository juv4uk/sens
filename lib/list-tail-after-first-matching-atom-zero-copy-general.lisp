; СЕНС: суфікс після ПЕРШОГО входження атома, без створення пар.
; Д3 ТОТОЖНЕ? отримує тільки атоми; вкладені пари пропускаються.
; Д7 — проєкція людських назв, Zig/T5M — лише обернений носій.

(визначити хвіст-після-першого-збігу-атома
 (функція (елементи шукане)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((хибне? (атом? шукане)) (як-є ()))
   ((хибне? (атом? (перше елементи)))
    (хвіст-після-першого-збігу-атома (решта елементи) шукане))
   ((тотожне? (перше елементи) шукане) (решта елементи))
   (так (хвіст-після-першого-збігу-атома (решта елементи) шукане)))))

; Відхилення будь-якого живого закону виконує справжній CAR NIL.
(визначити довести-хвіст-першого-збігу
 (функція (вхід шукане очікувана-голова)
  (за-умовою
   ((тотожне?
     (перше (хвіст-після-першого-збігу-атома вхід шукане))
     очікувана-голова) так)
   (так (перше (як-є ()))))))

; Порожній, атомний і відсутній збіг повертають ().
(за-умовою
 ((порожній? (хвіст-після-першого-збігу-атома (як-є ()) (як-є атом?))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-першого-збігу-атома (як-є решта) (як-є решта))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-першого-збігу-атома
   (список (як-є атом?) (як-є функція)) (як-є решта))) так)
 (так (перше (як-є ()))))
; Складений ключ не є атомом і не викликає небезпечного EQ.
(за-умовою
 ((порожній? (хвіст-після-першого-збігу-атома
   (список (як-є атом?) (як-є решта))
   (список (як-є атом?)))) так)
 (так (перше (як-є ()))))
; Другий та третій атоми залишаються після першого входження.
(довести-хвіст-першого-збігу
 (список (як-є решта) (як-є атом?) (як-є решта))
 (як-є решта) (як-є атом?))
(довести-хвіст-першого-збігу
 (список (як-є атом?) (як-є решта) (як-є функція))
 (як-є решта) (як-є функція))
; Вкладена пара пропускається, але правий хвіст зберігає пари.
(довести-хвіст-першого-збігу
 (список (список (як-є решта)) (як-є решта)
         (список (як-є функція)) (як-є сполучити))
 (як-є решта) (список (як-є функція)))
; Порожнє () всередині списку є атомом.
(довести-хвіст-першого-збігу
 (список (як-є ()) (як-є функція))
 (як-є ()) (як-є функція))
; Негатив: хвіст після ОСТАННЬОГО повтору не дорівнює правильному.
(за-умовою
 ((хибне? (порожній? (хвіст-після-першого-збігу-атома
   (список (як-є решта) (як-є атом?) (як-є решта))
   (як-є решта)))) так)
 (так (перше (як-є ()))))
(атом? (як-є ()))
