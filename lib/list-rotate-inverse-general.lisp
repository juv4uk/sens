; Два обернені циклічні зсуви скінченного правильного списку.
; Закон: правий після лівого та лівий після правого повертає джерело.
; Функції та перевірки виконує сама мова СЕНС через третій і четвертий домени.
; Жоден алгоритм не делеговано зовнішній мові або текстовому формату.

(визначити додати-останнім-для-зсуву
  (функція (елементи новий)
    (за-умовою
      ((атом? елементи) (список новий))
      (так
       (сполучити (перше елементи)
         (додати-останнім-для-зсуву (решта елементи) новий))))))

(визначити останній-для-зсуву
  (функція (елементи)
    (за-умовою
      ((атом? (решта елементи)) (перше елементи))
      (так (останній-для-зсуву (решта елементи))))))

(визначити крім-останнього-для-зсуву
  (функція (елементи)
    (за-умовою
      ((атом? (решта елементи)) (як-є ()))
      (так
       (сполучити (перше елементи)
         (крім-останнього-для-зсуву (решта елементи)))))))

(визначити зсунути-ліворуч
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      (так
       (додати-останнім-для-зсуву (решта елементи) (перше елементи))))))

(визначити зсунути-праворуч
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      (так
       (сполучити (останній-для-зсуву елементи)
         (крім-останнього-для-зсуву елементи))))))

(визначити вхідна-п'ятірка
  (список (як-є атом?) (як-є решта) (як-є сполучити)
          (як-є тотожне?) (як-є за-умовою)))

(визначити зсунута-ліворуч (зсунути-ліворуч вхідна-п'ятірка))

(визначити зсунута-праворуч (зсунути-праворуч вхідна-п'ятірка))

(визначити зворотна-після-лівого
  (зсунути-праворуч зсунута-ліворуч))

(визначити зворотна-після-правого
  (зсунути-ліворуч зсунута-праворуч))

