; Д11: SRFI-1 filter-map для одного скінченного правильного списку.
; Вихід містить ПЕРЕТВОРЕНІ елементи у вихідному порядку.
; Лише точне Д1 ні відкидається, а структурне () є допустимим елементом.
; Код перетворення — першокласне функціональне значення SENS.
; Виклик допоміжної функції іменований: українська виклична голова, без host-eval.

; Помічник отримує вже обчислений хвіст: немає взаємної рекурсії
; або недоступного на час першого DEFINE імені.
(визначити приєднати-нехибний-результат
  (функція (отримане оброблений-хвіст)
    (за-умовою
      ((однакові? отримане ні) оброблений-хвіст)
      (так (сполучити отримане оброблений-хвіст)))))

(визначити відобразити-та-зберегти-нехибні
  (функція (перетворити елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      (так
       (приєднати-нехибний-результат
         (перетворити (перше елементи))
         (відобразити-та-зберегти-нехибні
           перетворити (решта елементи)))))))

; Перша Д1-серія: з трьох значень два проходять перетворення ХИБНЕ?.
(визначити відфільтровані-булеві
  (відобразити-та-зберегти-нехибні
    хибне? (список ні так ні)))
(за-умовою
  ((перше відфільтровані-булеві) так)
  (так (перше (як-є ()))))
(за-умовою
  ((друге відфільтровані-булеві) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (решта (решта відфільтровані-булеві))) так)
  (так (перше (як-є ()))))

; Негативний приклад Д1 ні не потрапляє в результат.
(за-умовою
  ((порожній?
     (відобразити-та-зберегти-нехибні
       (функція (елемент) ні)
       (список (як-є атом?)))) так)
  (так (перше (як-є ()))))

; Структурне () не дорівнює Д1 ні й повинне лишитися елементом.
(визначити відфільтровані-порожні
  (відобразити-та-зберегти-нехибні
    (функція (елемент) (як-є ()))
    (список (як-є атом?))))
(за-умовою
  ((хибне? (порожній? відфільтровані-порожні)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (перше відфільтровані-порожні)) так)
  (так (перше (як-є ()))))

(атом? (як-є ()))
