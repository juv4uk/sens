; Рекурсивне вилучення ПЕРШОГО входження точного атома з власного списку.
; Повторний такий атом не видаляється; порядок усіх інших елементів незмінний.
; Лише чинні українські голови Д3 і Д4 й локальна функція Д7. Немає нового код операції.
(визначити вилучити-перший-атом
  (функція (елементи шукане)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((тотожне? (перше елементи) шукане) (решта елементи))
      ((атом? (як-є ()))
       (сполучити
         (перше елементи)
         (вилучити-перший-атом (решта елементи) шукане))))))

(визначити первинний
  (список (як-є атом?) (як-є тотожне?) (як-є решта)
          (як-є атом?) (як-є сполучити)))
(визначити скорочений
  (вилучити-перший-атом первинний (як-є атом?)))
(визначити без-змін
  (вилучити-перший-атом
    (список (як-є решта) (як-є сполучити)) (як-є атом?)))
(визначити без-середнього
  (вилучити-перший-атом
    (список (як-є атом?) (як-є тотожне?) (як-є решта))
    (як-є тотожне?)))

; Дійсний СЕНС сам обчислює позитиви і негативи; результат точний Д1:1.
; Будь-яка хибна умова спричинить справжній збій перше від порожній.
(за-умовою
  ((тотожне? (перше скорочений) (як-є тотожне?))
   (за-умовою
     ((тотожне? (друге скорочений) (як-є решта))
      (за-умовою
        ((тотожне? (третє скорочений) (як-є атом?))
         (за-умовою
           ((тотожне? (четверте скорочений) (як-є сполучити))
            (за-умовою
              ((порожній? (решта (решта (решта (решта скорочений)))))
               (за-умовою
                 ((хибне? (тотожне? (третє скорочений) (як-є тотожне?)))
                  (за-умовою
                    ((тотожне? (перше без-змін) (як-є решта))
                     (за-умовою
                       ((тотожне? (друге без-змін) (як-є сполучити))
                        (за-умовою
                          ((порожній? (решта (решта без-змін)))
                           (за-умовою
                             ((порожній? (вилучити-перший-атом (як-є ()) (як-є атом?)))
                              (за-умовою
                                ((порожній? (вилучити-перший-атом (список (як-є атом?)) (як-є атом?)))
                                 (за-умовою
                                   ((тотожне? (перше без-середнього) (як-є атом?))
                                    (за-умовою
                                      ((тотожне? (друге без-середнього) (як-є решта))
                                       (за-умовою
                                         ((порожній? (решта (решта без-середнього)))
                                          (за-умовою
                                            ((хибне? (тотожне? (перше скорочений) (як-є атом?)))
                                             (атом? (як-є ())))
                                            ((атом? (як-є ())) (перше (як-є ())))))
                                         ((атом? (як-є ())) (перше (як-є ())))))
                                      ((атом? (як-є ())) (перше (як-є ())))))
                                   ((атом? (як-є ())) (перше (як-є ())))))
                                ((атом? (як-є ())) (перше (як-є ())))))
                             ((атом? (як-є ())) (перше (як-є ())))))
                          ((атом? (як-є ())) (перше (як-є ())))))
                       ((атом? (як-є ())) (перше (як-є ())))))
                    ((атом? (як-є ())) (перше (як-є ())))))
                 ((атом? (як-є ())) (перше (як-є ())))))
              ((атом? (як-є ())) (перше (як-є ())))))
           ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
