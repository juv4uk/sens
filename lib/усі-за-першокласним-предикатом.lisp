; СЕНС: ALL над скінченним правильним списком.
; Умова — першокласна доменна функція, не рядок, SID8 або Sens8.
; Кожний елемент перевіряє власний обчислювач SENS, Zig лише пакує T5M.
; Не створюємо жодної проміжної CONS-пари; зупиняємося на першому Д1 ні.

(визначити усі-за-першокласним-предикатом
  (функція (умова елементи)
    (за-умовою
      ((порожній? елементи) так)
      ((умова (перше елементи))
       (усі-за-першокласним-предикатом умова (решта елементи)))
      (так ні))))

; Порожній список: істина без виклику умови.
(за-умовою
  ((усі-за-першокласним-предикатом атом? (як-є ())) так)
  (так (перше (як-є ()))))

; Першокласний Д3 АТОМ?: три атоми, включно з порожнім.
(за-умовою
  ((усі-за-першокласним-предикатом
     атом? (список (як-є атом?) (як-є ()) (як-є решта))) так)
  (так (перше (як-є ()))))

; Негатив: вкладена CONS-пара не є атомом, навіть після двох атомів.
(за-умовою
  ((хибне?
     (усі-за-першокласним-предикатом
       атом?
       (список (як-є атом?) (як-є решта)
               (список (як-є сполучити))))) так)
  (так (перше (як-є ()))))

; Першокласний Д4 ПОРОЖНІЙ? — інша функція та інший закон.
(за-умовою
  ((усі-за-першокласним-предикатом
     порожній? (список (як-є ()) (як-є ()))) так)
  (так (перше (як-є ()))))

; Негатив Д4: непорожній атом після порожнього має повернути Д1 ні.
(за-умовою
  ((хибне?
     (усі-за-першокласним-предикатом
       порожній? (список (як-є ()) (як-є атом?)))) так)
  (так (перше (як-є ()))))

; Фінальний результат — обчислена СЕНС-істина Д1.
(атом? (як-є ()))
