; Д3 і Д5: замінити тільки перше входження точного атома.
; Пізніші повтори, порядок, довжина і незмінний суфікс збережені.
; Семантика лише в СЕНС; Зіг і Т5М - фізичний оборотний носій.
(визначити замінити-перший-збіг-атома
  (функція (елементи шукане заміна)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((тотожне? (перше елементи) шукане)
       (сполучити заміна (решта елементи)))
      ((атом? (як-є ()))
       (сполучити (перше елементи)
         (замінити-перший-збіг-атома (решта елементи) шукане заміна))))))

(визначити вхід-першої-заміни
  (список (як-є атом?) (як-є решта) (як-є атом?)
          (як-є сполучити) (як-є атом?) (як-є тотожне?)))
(визначити замінена-шістка
  (замінити-перший-збіг-атома вхід-першої-заміни (як-є атом?) (як-є за-умовою)))
(визначити замінено-посередині
  (замінити-перший-збіг-атома
    (список (як-є решта) (як-є атом?) (як-є атом?))
    (як-є атом?) (як-є тотожне?)))
(визначити замінено-наприкінці
  (замінити-перший-збіг-атома
    (список (як-є решта) (як-є сполучити) (як-є атом?))
    (як-є атом?) (як-є тотожне?)))
(визначити без-першої-заміни
  (замінити-перший-збіг-атома
    (список (як-є решта) (як-є сполучити))
    (як-є атом?) (як-є тотожне?)))
(визначити та-сама-заміна
  (замінити-перший-збіг-атома вхід-першої-заміни (як-є атом?) (як-є атом?)))
(визначити два-однакових
  (замінити-перший-збіг-атома
    (список (як-є атом?) (як-є атом?))
    (як-є атом?) (як-є тотожне?)))

