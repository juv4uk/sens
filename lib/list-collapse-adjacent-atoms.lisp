  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((атом? (решта результат-однакових)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше результат-одного) (як-є решта)) (атом? (як-є ())))
