; Стискання лише сусідніх однакових атомів у правильному скінченному списку.
; Закон: порядок різних атомів збережено, кожен максимальний сусідній
; відрізок однакових атомів замінено одним атомом.
; Не усуваємо несусідні повтори. Порівняння тотожне? тільки між атомами.
; Значення обчислює СЕНС Д3 і Д4 і Д5; Т5М лише фізичний носій.

; Тотожність Д3 призначена атомам. Складені елементи не порівнюємо
; через Д3 EQ і не згортаємо, навіть якщо вони структурно однакові.
(визначити сусідні-атомарні-рівні?
  (функція (ліве праве)
    (за-умовою
      ((хибне? (атом? ліве)) ні)
      ((хибне? (атом? праве)) ні)
      (так (тотожне? ліве праве)))))

(визначити стиснути-сусідні-атоми
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи))
       (сполучити (перше елементи) (як-є ())))
      ((сусідні-атомарні-рівні?
        (перше елементи) (перше (решта елементи)))
       (стиснути-сусідні-атоми (решта елементи)))
      (так
       (сполучити (перше елементи)
         (стиснути-сусідні-атоми (решта елементи)))))))

(визначити зразок-сусідніх
  (список (як-є атом?) (як-є атом?)
          (як-є решта) (як-є решта)
          (як-є як-є) (як-є як-є)
          (як-є атом?)))
(визначити результат-сусідніх
  (стиснути-сусідні-атоми зразок-сусідніх))
(визначити результат-чергування
  (стиснути-сусідні-атоми
    (список (як-є атом?) (як-є решта) (як-є атом?))))
(визначити результат-однакових
  (стиснути-сусідні-атоми
    (список (як-є як-є) (як-є як-є) (як-є як-є))))
(визначити результат-одного
  (стиснути-сусідні-атоми (список (як-є решта))))
(визначити результат-порожнього
  (стиснути-сусідні-атоми (як-є ())))

; Справжні Д1-свідки. Невиконаний закон падає на перше порожнього списку.
; Свідки самостійні: не підмінюємо їх текстовим збігом чи зовнішнє-тестом.
(за-умовою
  ((тотожне? (перше результат-сусідніх) (як-є атом?)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((тотожне? (друге результат-сусідніх) (як-є решта)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((тотожне? (третє результат-сусідніх) (як-є як-є)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (решта (решта (решта результат-сусідніх)))) (як-є атом?))
   (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((атом? (решта (решта (решта (решта результат-сусідніх))))) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
; Негативний свідок: несусідні атоми не губляться.
(за-умовою
  ((тотожне? (перше результат-чергування) (як-є атом?)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((тотожне? (друге результат-чергування) (як-є решта)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((тотожне? (третє результат-чергування) (як-є атом?)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((атом? (решта (решта (решта результат-чергування)))) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше результат-однакових) (як-є як-є)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((атом? (решта результат-однакових)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше результат-одного) (як-є решта)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((атом? (решта результат-одного)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((атом? результат-порожнього) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((хибне? (тотожне? (перше результат-сусідніх) (як-є решта)))
   (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Додаткові живі Д1-закони: складені сусіди не є атомами для Д3 EQ.
; Два однакові складені елементи залишаються двома, без втрати пари.
(визначити дві-складені-після-стискання
  (стиснути-сусідні-атоми
    (список (список (як-є атом?)) (список (як-є атом?)))))
(за-умовою
  ((хибне? (атом? (перше дві-складені-після-стискання))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне? (атом? (друге дві-складені-після-стискання))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (решта (решта дві-складені-після-стискання))) так)
  (так (перше (як-є ()))))

; Однакові атоми обабіч складеної пари не є сусідніми.
(визначити розірвана-серія-атомів
  (стиснути-сусідні-атоми
    (список (як-є атом?) (список (як-є решта))
            (як-є атом?) (як-є атом?))))
(за-умовою
  ((тотожне? (перше розірвана-серія-атомів) (як-є атом?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне? (атом? (друге розірвана-серія-атомів))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (третє розірвана-серія-атомів) (як-є атом?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (решта (решта (решта розірвана-серія-атомів)))) так)
  (так (перше (як-є ()))))

; Порожній як елемент є атомом, дві порожні голови ущільнюються.
(визначити дві-порожні-голови
  (стиснути-сусідні-атоми (список (як-є ()) (як-є ()))))
(за-умовою
  ((порожній? (перше дві-порожні-голови)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (решта дві-порожні-голови)) так)
  (так (перше (як-є ()))))
