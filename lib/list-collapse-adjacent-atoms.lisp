; Стискання лише сусідніх однакових атомів у правильному скінченному списку.
; Закон: порядок різних атомів збережено, кожен максимальний сусідній
; відрізок однакових атомів замінено одним атомом.
; Не усуваємо несусідні повтори. Порівняння тотожне? тільки між атомами.
; Значення обчислює СЕНС Д3 і Д4 і Д5; Т5М лише фізичний носій.

(визначити стиснути-сусідні-атоми
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи))
       (сполучити (перше елементи) (як-є ())))
      ((тотожне? (перше елементи) (перше (решта елементи)))
       (стиснути-сусідні-атоми (решта елементи)))
      (так
       (сполучити (перше елементи)
         (стиснути-сусідні-атоми (решта елементи)))))))

(визначити зразок-сусідніх
  (список (як-є атом?) (як-є атом?)
          (як-є решта) (як-є решта)
          (як-є як-є) (як-є як-є)
          (як-є атом?)))
(визначити результат-сусідніх
  (стиснути-сусідні-атоми зразок-сусідніх))
(визначити результат-чергування
  (стиснути-сусідні-атоми
    (список (як-є атом?) (як-є решта) (як-є атом?))))
(визначити результат-однакових
  (стиснути-сусідні-атоми
    (список (як-є як-є) (як-є як-є) (як-є як-є))))
(визначити результат-одного
  (стиснути-сусідні-атоми (список (як-є решта))))
(визначити результат-порожнього
  (стиснути-сусідні-атоми (як-є ())))

; Справжні Д1-свідки. Невиконаний закон падає на перше порожнього списку.
; Свідки самостійні: не підмінюємо їх текстовим збігом чи зовнішнє-тестом.
(за-умовою
  ((тотожне? (перше результат-сусідніх) (як-є атом?)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((тотожне? (друге результат-сусідніх) (як-є решта)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((тотожне? (третє результат-сусідніх) (як-є як-є)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (решта (решта (решта результат-сусідніх)))) (як-є атом?))
   (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((атом? (решта (решта (решта (решта результат-сусідніх))))) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
; Негативний свідок: несусідні атоми не губляться.
(за-умовою
  ((тотожне? (перше результат-чергування) (як-є атом?)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((тотожне? (друге результат-чергування) (як-є решта)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((тотожне? (третє результат-чергування) (як-є атом?)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((атом? (решта (решта (решта результат-чергування)))) (атом? (як-є ())))
