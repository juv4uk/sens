(за-умовою
  ((атом? (решта результат-одного)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
  ((атом? результат-порожнього) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))
(за-умовою
