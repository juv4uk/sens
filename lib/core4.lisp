; Логічні та й або - мовні макроси з коротким замиканням.
; Перевірений аргумент має повертати точний однобітний результат.
; Числовий нуль не є порожнім списком чи істинністю стороннього виконавця.
; Кожна гілка умов має два поля: перевірка та результат.
; Останній аргумент повертається як значення без додаткової перевірки.
(визначити та
  (макрос
    (функція залишок-аргументів
  (за-умовою
    ((атом? залишок-аргументів) (атом? ()))
    ((атом? (решта залишок-аргументів)) (перше залишок-аргументів))
    (так
     (сполучити (як-є за-умовою)
       (сполучити
         (сполучити (перше залишок-аргументів)
           (сполучити
             (сполучити (як-є та) (решта залишок-аргументів))
             (як-є ())))
         (сполучити
           (сполучити (як-є атом?)
             (сполучити (як-є ()) (як-є ())))
           (сполучити
             (сполучити
               (як-є атом?)
               (сполучити
                 (сполучити (як-є сполучити)
                   (сполучити (як-є ())
                     (сполучити (як-є ()) (як-є ()))))
                 (як-є ())))
             (як-є ()))))))))))

(визначити або
  (макрос
    (функція залишок-аргументів
  (за-умовою
    ((атом? залишок-аргументів) (атом? (сполучити () ())))
    ((атом? (решта залишок-аргументів)) (перше залишок-аргументів))
    (так
     (сполучити (як-є за-умовою)
       (сполучити
         (сполучити (перше залишок-аргументів)
           (сполучити
             (сполучити (як-є атом?)
               (сполучити (як-є ()) (як-є ())))
             (як-є ())))
         (сполучити
           (сполучити
             (сполучити (як-є атом?)
               (сполучити (як-є ()) (як-є ())))
             (сполучити
               (сполучити (як-є або) (решта залишок-аргументів))
               (як-є ())))
           (як-є ())))))))))

