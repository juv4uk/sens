(визначити елемент-списку-за-індексом
  (функція (індекс елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((хибне? (порожній? елементи))
       (за-умовою
         ((тотожне? індекс 0) (перше елементи))
         ((хибне? (тотожне? індекс 0))
          (елемент-списку-за-індексом
            (відняти індекс 1)
            (решта елементи))))))))

(визначити nth елемент-списку-за-індексом)

