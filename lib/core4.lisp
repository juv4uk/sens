; Д4:0111 решта-решти — чинний механізм СЕНС (CDDR: композиція D3).
; Історичне перевизначення незмінної канонічної функції вилучено.

; Довжину, відображення та відбір обчислюємо хвостовою рекурсією
; з накопичувачем. На відміну від додавання елемента після повернення
; рекурсії, тут глибина стека хоста не зростає з довжиною списку.
; Відображення й відбір спочатку накопичують елементи у зворотному
; порядку, а потім один раз відновлюють порядок функцією «зворот».
; Підрахунок довжини не створює списку, а повертає накопичене число.
; Історичне свідчення стійкості стека:
; crates/my-лісп/tests/stack_safety.rs.
; Д6:000001 LENGTH-ONTO · pramāṇa-saṅkalana.
; Лише точне D3:() завершує правильний список і повертає акумулятор.
; D1:ні, D7-атом і неправильний крапковий хвіст — D3 CAR Type,
; а не неявний кінець. Жодного додаткового доменного коду.
; Числовий крок використовує чинне точне D5 додати та число-один.
; Спільний точний D3-preflight для D6 LENGTH-ONTO, REDUCE, NTH і MAPLIST.
; Визначено до первинного обчислення LENGTH, отже bootstrap не має
; звертатися до ще не визначеної функції.
(визначити підтвердити-д6-список
  (функція (залишок)
    (за-умовою
      ; Тільки D3:() є завершенням. D1:ні — окреме атомарне значення,
      ; його заборонено порівнювати з порожнечею загальним EQ.
      ((порожній? залишок) так)
      ((атом? залишок) (перше залишок))
      (так
       (підтвердити-д6-список (решта залишок))))))

; D11-пропозиція: приватний одноразовий обхід лише вже перевіреного D3-хребта.
; Ніяких повторних D3-перевірок на кожному рекурсивному кроці.
(визначити довжина-до-ядро
  (функція (значення акумулятор)
    (за-умовою
      ((порожній? значення) акумулятор)
      (так
       (довжина-до-ядро
         (решта значення)
         (додати акумулятор число-один))))))

; D6 LENGTH-ONTO: перше ПОВНИЙ D3-доказ, потім D5 арифметика.
; Неправильний корінь/хвіст має D3 CAR Type навіть за нечислового акумулятора.
(визначити довжина-до
  (функція (значення акумулятор)
    (за-умовою
      ((підтвердити-д6-список значення)
       (довжина-до-ядро значення акумулятор))
      (так (перше (як-є ()))))))


(визначити довжина
  (функція (значення)
    (довжина-до значення число-нуль)))

