; Д8:00110011 ACONS-SWAPPED — чинна продуктова координата #3960.
; Закон орієнтації #3741: tau(ACONS(k,v,A)) = ACONS(v,k,tau(A)).
; tau(pair) = CONS(решта(pair),перше(pair)); Д6 MAP зберігає порядок alist.
; Лише мовна похідна функція СЕНС, не новий Д8 primitive.
(визначити додати-асоціацію-навпаки
  (функція (ключ значення асоціації)
    (додати-асоціацію значення ключ
      (відобразити
        (функція (пара) (сполучити (решта пара) (перше пара)))
        асоціації))))

