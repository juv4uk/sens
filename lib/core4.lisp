; leq? (не-більше?)
; Партія D6 з дослідження #3622: LEFT TAKE / DROP для невід'ємного D24+ n.
; Резидентні коди D6:110000 / D6:110001, не D8-right aliases.
; У тілі лише D5 ZEROP, D6 SUB1, D3 CAR/CDR/CONS/COND, D4 NULL.
(визначити взяти
  (функція (кількість елементи)
    (за-умовою
      ((нуль-д24? кількість) (як-є ()))
      ((порожній? елементи) (як-є ()))
      ((порожній? (як-є ()))
       (сполучити (перше елементи)
            (взяти (зменшити-на-один кількість) (решта елементи)))))))

(визначити відкинути
  (функція (кількість елементи)
    (за-умовою
      ((нуль-д24? кількість) елементи)
      ((порожній? елементи) (як-є ()))
      ((порожній? (як-є ()))
       (відкинути (зменшити-на-один кількість) (решта елементи))))))

; D8:00100001 SUBSEQ — лише списки та кваліфіковані D24 межі.
