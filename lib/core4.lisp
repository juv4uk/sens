; string-length/string-empty?/string-prefix?/string-contains? (PLAN.md,
; пункт 14, живо застосований тест G5 з пункту 20) — жодна з них не
; потребує нового Rust-примітива: string-first/string-rest уже дають
; рядок по одному символу, а eq вже порівнює Value::String за
; значенням, тож "" — реальний, перевірюваний базовий випадок — та сама
; форма, що й будь-який інший рекурсивний обхід списку в цьому файлі,
; лише по рядку, не по ланцюжку пар. string-append (справді невиразний
; так само — нічого тут не може побудувати новий об'єднаний рядок)
; лишається в Rust — див. власний коментар у special_forms.rs, чому.
(визначити класифікувати-рядкове-значення
  (функція (значення-аргументу)
    (за-умовою
      ((хибне? (атом? значення-аргументу))
       (як-є (class-membership string nonmember)))
      ((атом? значення-аргументу) 
       (за-умовою
         ((тотожне? (рядок-перший (значення-у-текст значення-аргументу))
              (рядок-перший (значення-у-текст (рядок-решта (значення-у-текст (як-є ?))))))
          
          (як-є (class-membership string member)))
         ((хибне? (тотожне? (рядок-перший (значення-у-текст значення-аргументу))
              (рядок-перший (значення-у-текст (рядок-решта (значення-у-текст (як-є ?)))))))
          
          (як-є (class-membership string nonmember)))))
      ((атом? значення-аргументу) 
       (як-є (class-membership string nonmember))))))

(визначити порівняти-рядки-за-кодовими-точками
  (функція (лівий-аргумент правий-аргумент)
    (за-умовою
      ((рядок-порожній? лівий-аргумент) 
       (за-умовою
         ((рядок-порожній? правий-аргумент) 
          (як-є (text-order same)))
         ((хибне? (рядок-порожній? правий-аргумент))
          (як-є (text-order before)))))
      ; Лівий рядок уже непорожній (першу гілку пройдено).
      ; Правий порожній — тільки тоді результат AFTER.
      ((рядок-порожній? правий-аргумент)
       (як-є (text-order after)))
      ((тотожне? (рядок-перший лівий-аргумент) (рядок-перший правий-аргумент))
       
       (порівняти-рядки-за-кодовими-точками (рядок-решта лівий-аргумент) (рядок-решта правий-аргумент)))
      ((менше? (код-символу (рядок-перший лівий-аргумент))
          (код-символу (рядок-перший правий-аргумент)))
       
       (як-є (text-order before)))
      ((хибне? (менше? (код-символу (рядок-перший лівий-аргумент)) (код-символу (рядок-перший правий-аргумент))))
       (як-є (text-order after))))))

(визначити класифікувати-непорожність-рядка
  (функція (значення-аргументу)
    (за-умовою
      ; Класифікатор повертає структуровані дані, а не Д1-предикат.
      ((тотожне? (третє (класифікувати-рядкове-значення значення-аргументу))
                 (як-є member))
       (за-умовою
         ((хибне? (рядок-порожній? значення-аргументу))
          (як-є (class-membership string nonempty-member)))
         ((рядок-порожній? значення-аргументу)
          (як-є (class-membership string member)))))
      (так
       (як-є (class-membership string nonmember))))))

; string<? — лексикографічний порядок за кодовими точками, як `<` для &str
; у Rust (UTF-8 зберігає порядок кодових точок). Переведено з Rust у мову
; (власник, 2026-09-26): рядок розбирають лише примітиви string-first
; через точні Д9 STRING-FIRST/STRING-REST і Д8 CHAR-CODE. Не-рядок
; дає природну помилку Type від string-first; неправильна кількість
; аргументів — Arity від прив'язки лямбди.
(визначити текст-передує?
  (функція (перший-аргумент другий-аргумент)
    (за-умовою
      ; Порожній текст менший за будь-який непорожній текст.
      ((рядок-порожній? перший-аргумент)
       (за-умовою
         ((рядок-порожній? другий-аргумент) ні)
         (так так)))
      ((рядок-порожній? другий-аргумент) ні)
      ; Два порівняння Д24+ кодових точок розрізняють <, > та =.
      ; Рівний префікс не можна визнати «більшим»: ідемо до хвостів.
      ((менше? (код-символу (рядок-перший перший-аргумент))
               (код-символу (рядок-перший другий-аргумент)))
       так)
      ((менше? (код-символу (рядок-перший другий-аргумент))
               (код-символу (рядок-перший перший-аргумент)))
       ні)
      (так
       (текст-передує? (рядок-решта перший-аргумент)
                      (рядок-решта другий-аргумент))))))



; Д8:10110001 STRING< — ратифікована українська поверхня того ж мовного закону.
; Тотожність текстового порядку належить чинному Д8; обхід через старий код заборонено.

; Д8:00100011 STRING> — похідний закон текстового порядку з Д8:10110001 STRING<.
; STRING>(a,b) = STRING<(b,a); координата і ширина не змінюються.
; Власна мовна функція СЕНС; без прямого виклику Д8 чи нового закону зовнішнього виконавця.
(визначити текст-більший?
  (функція (ліве праве)
    (текст-передує? праве ліве)))

; Д8:00000100 PROG1 і Д8:11001001 PROG2 — звичайні функції СЕНС.
; Виклик обчислює всі аргументи в стандартному порядку перед входом у тіло;
; далі повертаємо відповідно перший або другий уже обчислений результат.
; Жодного примітива зовнішнього виконавця чи нового доменного коду.
(визначити повернути-перше
  (функція всі-аргументи (нехай ((перший-аргумент (перше всі-аргументи)) (решта-аргументів (решта всі-аргументи)))
    перший-аргумент)))
(визначити послідовність-повернути-перше повернути-перше)

(визначити повернути-друге
  (функція всі-аргументи (нехай ((перший-аргумент (перше всі-аргументи)) (другий-аргумент (перше (решта всі-аргументи))) (решта-аргументів (решта (решта всі-аргументи))))
    другий-аргумент)))
(визначити послідовність-повернути-друге повернути-друге)

; Мовний предикат символу не потребує окремого примітива Rust.
; Для атомарного значення перевіряємо тотожність із символом,
; відновленим з його канонічного тексту. Перевірка атомарності
; не допускає застосування Д3 EQ до пар.
; Перетворення тексту на символ працює з довільним його ім'ям,
; навіть коли воно не є звичним ідентифікатором читача.
(визначити символ?
  (функція (значення-аргументу)
    (за-умовою
      ((порожній? значення-аргументу) ні)
      ((хибне? (атом? значення-аргументу)) ні)
      ((тотожне? значення-аргументу (текст-у-символ (значення-у-текст значення-аргументу))) так)
      (так ні))))
; Історичне ім'я — лише сумісне зв'язування української функції.


; Цілочисельна частка та остача для невід'ємних чисел
; виражаються наявними арифметичними й порівняльними функціями
; без нових машинних примітивів. Це не дає права довільно
; припускати семантику ділення від'ємних чисел: округлення вниз
; і відкидання дробової частини — різні контракти.
; Історична потреба походить із дослідження fpga-лісп від 10.08.2026.
;
; Початкове повторюване віднімання потребувало стільки рекурсивних
; викликів, яким було саме значення частки. Для діленого
; 9999999999999 і дільника 10 це переповнювало стек.
; Тому блок частки шукаємо подвоєнням: найбільший b * 2^k,
; який ще вміщується в a, віднімаємо і повторюємо.
; Глибина пошуку залежить від log(a/b), а не від значення частки.
;
; Числовий інваріант: 0 < частина ≤ a. Перевірка
; a < 2*частина могла переносити проміжне число з Д24 до Д48.
; Рівносильне порівняння a-частина < частина не потребує
; такого переповнення перед подвоєнням. Межі доменів
; визначає математична семантика Д24+, а не текстова назва.
(визначити знайти-найбільший-блок-частки
  (функція (перший-аргумент другий-аргумент частина множник)
    (за-умовою
      ((менше? (відняти перший-аргумент частина) частина) (сполучити частина множник))
      (так
       (знайти-найбільший-блок-частки перший-аргумент другий-аргумент
         (додати частина частина)
         (додати множник множник))))))

; За нульового дільника алгоритм подвоєння не просувається:
; 0+0=0, тому рекурсія могла бути нескінченною.
; Гілка перевірки дільника має зберігати визначену помилку
; ділення на нуль, а не потрапляти у цикл.
;
; Структурну пару (частина . множник) читаємо як дані.
; Її не слід пропускати через історичний макрос LET,
; який міг би сприйняти числовий результат за голову виклику.
; Числова частка Д5 і алгоритм цілочисельного ділення
; потребують окремої перевірки контрактів, без підміни законів.
(визначити цілочисельна-частка-з-блоку
  (функція (перший-аргумент другий-аргумент частина-і-множник)
    (додати (решта частина-і-множник)
            (частка-через-подвоєння
              (відняти перший-аргумент (перше частина-і-множник)) другий-аргумент))))
; Рекурсія по залишку має зберігати ЦІЛУ частку; Д5 ЧАСТКА
; ратифікована як точне дробове ділення і тут непридатна.
; Похідний механізм подвоєння має власне українське ім'я.
; Ратифіковане Д5 «частка» не перевизначаємо: воно означає точне ділення.
(визначити частка-через-подвоєння
  (функція (перший-аргумент другий-аргумент)
    (за-умовою
      ((нуль? другий-аргумент) (частка перший-аргумент другий-аргумент))
      ((менше? перший-аргумент другий-аргумент) (відняти другий-аргумент другий-аргумент))
      (так
       (цілочисельна-частка-з-блоку перший-аргумент другий-аргумент
         (знайти-найбільший-блок-частки перший-аргумент другий-аргумент другий-аргумент
           (частка другий-аргумент другий-аргумент)))))))
; Сумісна назва старого похідного алгоритму не підміняє Д5 «частка».

; Канонічна MOD-остача: a - b*FLOOR(a/b), а не a - b*(a/b).
; Д5 ЧАСТКА є точним дробовим діленням; використовувати її як цілу
; частку давало нульову остачу та нецілі UTF-8 байти у живому СЕНС.
; FLOOR нижче є мовним визначенням, а не новим хост-примітивом.
(визначити модульна-остача
  (функція (перший-аргумент другий-аргумент)
    (відняти перший-аргумент
      (помножити другий-аргумент (округлити-вниз перший-аргумент другий-аргумент)))))
; Історичне ім'я — лише сумісне зв'язування української функції.

; Похідні порівняння мають зберігати точну алгебру відповідей:
; істина — 1/1, хиба — 0/1, невизначена відповідь — ().
; Канонічні двопольові гілки умови розрізняють точну хибу
; і відсутність відповіді, не покладаючись на істинність хоста.
(визначити перевірити-неспадання-значень?
  (функція (поточне-значення залишені-елементи)
    (за-умовою
      ((атом? залишені-елементи) так)
      ((менше? поточне-значення (перше залишені-елементи)) 
       (перевірити-неспадання-значень? (перше залишені-елементи) (решта залишені-елементи)))
      ((однакові? поточне-значення (перше залишені-елементи)) 
       (перевірити-неспадання-значень? (перше залишені-елементи) (решта залишені-елементи)))
      ((хибне? (однакові? поточне-значення (перше залишені-елементи))) ні))))

(визначити перевірити-незростання-значень?
  (функція (поточне-значення залишені-елементи)
    (за-умовою
      ((атом? залишені-елементи) так)
      ((більше? поточне-значення (перше залишені-елементи)) 
       (перевірити-незростання-значень? (перше залишені-елементи) (решта залишені-елементи)))
      ((однакові? поточне-значення (перше залишені-елементи)) 
       (перевірити-незростання-значень? (перше залишені-елементи) (решта залишені-елементи)))
      ((хибне? (однакові? поточне-значення (перше залишені-елементи))) ні))))

; Вилучено дві історичні ASCII-голови порівняння, які не є
; ратифікованими доменними викликами. Чинні українські Д6-предикати
; не-більше? та не-менше? уже визначені вище й мають власні закони.
; Так Core4 не подає недопущений знак '<' у фізичний читач Д7.

; number->string (G5-тест: уже виразне через наявне?) — так, тепер,
; коли є quotient/mod. Знахідка з сесії fpga-лісп, assembler.лісп, яка
; мала власну версію на фіксованій таблиці DECIMAL-POWERS (обмежена
; ~10 розрядами самою побудовою таблиці). Ця рекурсує через
; quotient/mod, та сама -onto-форма акумулятора, що й length-onto/
; reverse-onto вище, тож не має власної стелі розрядності. Обсяг:
; лише невід'ємні цілі, як і самі quotient/mod.
; Числовий друк має один канонічний закон — ратифікований Д9.
; Точне подання цілих чисел і скорочених дробів визначає значення-у-текст.
; Окремий рекурсивний акумулятор дублював цей закон і більше не потрібний.
(визначити число-рядок
  (функція (число-аргумент)
    (значення-у-текст число-аргумент)))
; Сумісні англомовні назви залишаються псевдонімами тих самих Лісп-значень.

; Ратифіковані Д9: потік-перший/потік-останній. Без ASCII ->/->>
; у викличній голові чи цитованому розгортанні: текст Д7 не мусить
; кодувати нератифіковані символи, а потік є власним СЕНС-макросом.
; глибокої вкладеності (політика clean-code).
; `(-> x (f y) g)` розгортається в `(g (f x y))`.
;
(визначити потік-перший
  (макрос
    (функція форми-аргументів
  (за-умовою
    ((атом? форми-аргументів) (перше форми-аргументів))
    ((атом? (решта форми-аргументів)) (перше форми-аргументів))
    ((хибне? (атом? (решта форми-аргументів)))
        (нехай-послідовно ((вираз-перший (перше форми-аргументів))
               (форма-наступна (перше (решта форми-аргументів)))
               (форми-залишок (решта (решта форми-аргументів)))
               (крок-розгортання
                 (за-умовою
                   ((хибне? (атом? форма-наступна))
                    (сполучити (перше форма-наступна) (сполучити вираз-перший (решта форма-наступна))))
                   ((атом? форма-наступна) (список форма-наступна вираз-перший)))))
          (за-умовою
            ((атом? форми-залишок) крок-розгортання)
            ((хибне? (атом? форми-залишок))
             (сполучити (як-є потік-перший) (сполучити крок-розгортання форми-залишок))))))))))

(визначити потік-останній
  (макрос
    (функція форми-аргументів
  (за-умовою
    ((атом? форми-аргументів) (перше форми-аргументів))
    ((атом? (решта форми-аргументів)) (перше форми-аргументів))
    ((хибне? (атом? (решта форми-аргументів)))
        (нехай-послідовно ((вираз-перший (перше форми-аргументів))
               (форма-наступна (перше (решта форми-аргументів)))
               (форми-залишок (решта (решта форми-аргументів)))
               (крок-розгортання
                 (за-умовою
                   ((хибне? (атом? форма-наступна))
                    (приєднати форма-наступна (список вираз-перший)))
                   ((атом? форма-наступна) (список форма-наступна вираз-перший)))))
          (за-умовою
            ((атом? форми-залишок) крок-розгортання)
            ((хибне? (атом? форми-залишок))
             (сполучити (як-є потік-останній) (сполучити крок-розгортання форми-залишок))))))))))

;; ── Додатки числової бібліотеки (M0, 2026-08-22) ─────────────────────
;; Додано для реальних задач (WSM-24 shape comparison): abs/min/max/
;; sqrt. Усе — бібліотечні функції над наявними примітивами; жодного
 ;; нового коду в ядрі Rust: спочатку мовна бібліотека, потім примітив ядра.
;;
;; Конвенції:
;;   (abs x) / (min a b ...) / (max a b ...) — вбудовані Rust (builtins.rs);
;;   (min-list lst)/(max-list lst) — вбудовані в Rust операції для списків;
;;   (sqrt x)         — Ньютон, 40 ітерацій; точний вхід дає раціональне
;;                      наближення, дробове — дробовий результат
;;                      (S1 inexact promotion). Відʼємний вхід → nil.

(визначити уточнити-корінь-ітерацією
  (функція (наближення аргумент-х число-аргумент)
    (за-умовою
      ((однакові? число-аргумент число-нуль)  наближення)
      ((хибне? (однакові? число-аргумент число-нуль))
       (уточнити-корінь-ітерацією (поділити (додати наближення (поділити аргумент-х наближення)) число-два) аргумент-х (відняти число-аргумент число-один))))))

;; цілий корінь: Ньютон на частках — довідно завершуваний
(визначити цілий-корінь
  (функція (число-аргумент)
    (за-умовою
      ((менше? число-аргумент число-два)  число-аргумент)
      ((хибне? (менше? число-аргумент число-два))
       (крок-цілого-кореня число-аргумент (частка число-аргумент число-два))))))

(визначити крок-цілого-кореня
  (функція (число-аргумент функція-г)
    (нехай ((наступне (частка (додати функція-г (частка число-аргумент функція-г)) число-два)))
      (за-умовою
        ((менше? наступне функція-г)  (крок-цілого-кореня число-аргумент наступне))
        ((хибне? (менше? наступне функція-г)) функція-г)))))

(визначити корінь
  (функція (аргумент-х)
    (за-умовою
      ((менше? аргумент-х число-нуль)  (як-є ()))
      ((однакові? аргумент-х число-нуль)  число-нуль)
      ((однакові? аргумент-х (частка аргумент-х число-один)) 
       (нехай ((корінь-наближення (цілий-корінь аргумент-х)))
         (за-умовою
           ((однакові? (помножити корінь-наближення корінь-наближення) аргумент-х)  корінь-наближення)
           (так  (уточнити-корінь-ітерацією (поділити аргумент-х число-два) аргумент-х число-вісім)))))
      (так  (уточнити-корінь-ітерацією (поділити аргумент-х число-два) аргумент-х число-п'ять)))))

; Модуль, мінімум, максимум і спискові крайні значення перенесено
; з Rust builtins.rs до бібліотеки Лісп за рішенням власника від 11.09.2026.
; Значення операцій належить Ліспу; Rust забезпечує лише незвідні механізми.
; Ці функції використовують арифметику, порівняння та обхід пар,
; а не системні можливості. Їхні ратифіковані тотожності вже були
; в бібліотека/surface/semantic-registry.лісп — не створюємо повторних координат.
; Історичну тотожність з реалізацією Rust раніше перевіряли в
; crates/my-лісп/tests/builtin_to_lisp_migration.rs; поточні тести
; після цієї редакторської зміни окремо не запускалися.
; Д6:010011 ABS / модуль — точна арифметика Д24+ і умова Д1.
; Д6:010011 ABS / модуль — точна арифметика Д24+, точна умова Д1.
; LESSP повертає точне числове значення; EQUAL? проєктує відповіді 1/0 у Д1.
(визначити модуль
  (функція (аргумент-х)
    (за-умовою
      ((менше? аргумент-х (відняти аргумент-х аргумент-х))
       (відняти (відняти аргумент-х аргумент-х) аргумент-х))
      (так аргумент-х))))

; Обов'язковий перший параметр у крапковому списку аргументів,
; як у <= та >=, забезпечує помилку арності для порожнього виклику.
; Її виявляє зв'язування параметрів самого обчислювача,
; а не новий механізм чи окрема помилка в бібліотечній функції.
;
; Під час попередньої перевірки оракулом виявлено дві помилки:
; 1. EQ приймає атоми; перевірка непорожнього списку через EQ
;    спричиняла помилку типу на рекурсивному кроці.
; 2. ATOM не відрізняє порожній результат від числа: число теж атом.
;    Тому базовий випадок для результату перевіряємо через Д4:0101 NULL,
;    а не через Д3 ATOM. Для власне списку перевірка атомарності допустима.
; Д6:000010 та Д6:000011: власні композиції СЕНС з Д3/Д4/Д5.
; Числова область Д24+, для порожнього списку повертаємо ().
; D6:000010/000011 · śreṇī-alpatara / śreṇī-brhattara.
; Повний D3-хребет треба перевірити перед першим порівнянням D5:
; інакше Type від чисел маскує неправильний D1-хвіст.
; Лише D3:() є коректним кінцем; D1:ні відхиляє D3 ПЕРШЕ.
(визначити перевірити-структуру-списку-екстремумів
  (функція (елементи)
    (за-умовою
      ((атом? елементи)
       (за-умовою
         ((тотожне? елементи (як-є ())) так)
         (так (перше елементи))))
      (так
       (перевірити-структуру-списку-екстремумів
         (решта елементи))))))

; Ядра отримують лише структурно перевірений список D3.
; Порівняння виконується один раз на кроці; при рівності
; зберігається перше обране точне числове значення D12+.
(визначити найменше-залишки
  (функція (залишки обране)
    (за-умовою
      ((порожній? залишки) обране)
      ((менше? (перше залишки) обране)
       (найменше-залишки (решта залишки) (перше залишки)))
      (так
       (найменше-залишки (решта залишки) обране)))))

(визначити найбільше-залишки
  (функція (залишки обране)
    (за-умовою
      ((порожній? залишки) обране)
      ((більше? (перше залишки) обране)
       (найбільше-залишки (решта залишки) (перше залишки)))
      (так
       (найбільше-залишки (решта залишки) обране)))))

; D11-пропозиція: допоміжний SENS-доказ числовості D6 MIN/MAX.
; Публічні функції спочатку доводять ПОВНУ D3-структуру; лише тоді
; цей прохід перевіряє D5:01001 ЧИСЛО? на КОЖНОМУ елементі.
; Самопорівняння x<x або x>x не є перевіркою числового типу.
; Перший нечисловий елемент дає точну помилку D3 ПЕРШЕ Type
; ще до обчислення будь-якого мінімуму чи максимуму.
(визначити перевірити-числовість-елементів-екстремумів
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) так)
      ((число? (перше елементи))
       (перевірити-числовість-елементів-екстремумів
         (решта елементи)))
      ; Сам D5 ADD на відсутньому D12+ операнді дає саме числовий
      ; Type, не удаваний D3 CAR Type для ПРАВИЛЬНОГО списку.
      ; Якщо недопущений операнд був би помилково прийнятий,
      ; COND відхилить не-D1 результат: функція не повертає успіх.
      (так (додати (перше елементи) число-нуль)))))

; Порожній правильний список повертає D3:().
; Структурний доказ передує числовому; результат тільки з D12+.
(визначити найменше-у-списку
  (функція (елементи)
    (за-умовою
