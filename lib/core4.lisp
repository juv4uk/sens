; #1391: логіка відповідей Core4 — закон contracts/core4-predicate-answer-scale.lisp /3.
; Відповідь — список двійкових бітів: (1)…(1 1 1 1 1 1 1) «так»,
; (0)…(0 0 0 0 0 0 0) «ні», () «невідомо». Лінія істинності:
;   0 < 00 < … < 0000000 < () < 1111111 < … < 11 < 1
; Виконуваний свідок законів — experiments/core4-logic15-algebra.lisp.

; NOT: інвертувати кожен біт, ширина та сама; () лишається ().
(визначити відповідь-не
  (функція (перший-аргумент)
    (за-умовою
      
      ((атом? перший-аргумент) 
       (сполучити
         (за-умовою
           ((тотожне? (перше перший-аргумент) 0)  1)
           ((хибне? (тотожне? (перше перший-аргумент) 0)) 0))
         (відповідь-не (решта перший-аргумент)))))))

(визначити answer-not відповідь-не)

; AND: мінімум на лінії. «Ні» перемагає; з двох «ні» — коротше (сильніше);
; з двох «так» — довше (слабше); () поглинає «так».
; Для двох відповідей одного напряму крок іде по обох списках разом.
(визначити відповідь-і
  (функція (перший-аргумент другий-аргумент)
    (за-умовою
      ((хибне? (атом? перший-аргумент))
       (за-умовою
         
         ((атом? другий-аргумент) 
          (за-умовою
            ((тотожне? (перше другий-аргумент) 0)  другий-аргумент)
            ((тотожне? (перше другий-аргумент) 0)  (як-є ()))))))
      ((атом? перший-аргумент) 
       (за-умовою
         ((хибне? (атом? другий-аргумент))
          (за-умовою
            ((тотожне? (перше перший-аргумент) 0)  перший-аргумент)
            ((тотожне? (перше перший-аргумент) 0)  (як-є ()))))
         ((атом? другий-аргумент) 
          (за-умовою
            ((тотожне? (перше перший-аргумент) (перше другий-аргумент)) 
             (за-умовою
               ((тотожне? (перше перший-аргумент) 0)  перший-аргумент)
               ((хибне? (тотожне? (перше перший-аргумент) 0)) другий-аргумент)))
            ((тотожне? (перше перший-аргумент) (перше другий-аргумент)) 
             (за-умовою
               ((хибне? (атом? (решта перший-аргумент)))
                (за-умовою
                  ((тотожне? (перше перший-аргумент) 0)  перший-аргумент)
                  ((хибне? (тотожне? (перше перший-аргумент) 0)) другий-аргумент)))
               ((хибне? (атом? (решта другий-аргумент)))
                (за-умовою
                  ((тотожне? (перше другий-аргумент) 0)  другий-аргумент)
                  ((хибне? (тотожне? (перше другий-аргумент) 0)) перший-аргумент)))
               ((атом? (решта другий-аргумент)) 
                (сполучити (перше перший-аргумент)
                          (відповідь-і (решта перший-аргумент) (решта другий-аргумент)))))))))))))

