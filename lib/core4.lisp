; realpart / imagpart — дійсна та уявна частини комплексної пари
(визначити дійсна-частина
  (функція (пара) (перше пара)))

(визначити уявна-частина
  (функція (пара) (решта пара)))

; aref (елемент-масиву) — n-й елемент послідовності
(визначити елемент-масиву
  (функція (число-аргумент список) (елемент-списку-за-індексом число-аргумент список)))

; vector-copy (копіювати-вектор) — копія списку через append з порожнім
(визначити копіювати-вектор
  (функція (с) (приєднати с (як-є ()))))

; getprop (отримати-властивість) — знайти значення за ключем у списку пар
(визначити отримати-властивість
  (функція (ключ список) (знайти-за-ключем ключ список)))

; putprop (встановити-властивість) — додати пару (ключ . значення) на початок
(визначити встановити-властивість
