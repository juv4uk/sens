  (функція (перший-аргумент другий-аргумент) (хибне? (менше? перший-аргумент другий-аргумент))))


; ===== Похідні визначення Д6 (партія 3) =====
; remainder (остача)
(визначити остача
  (функція (перший-аргумент другий-аргумент) (модульна-остача перший-аргумент другий-аргумент)))
; gcd (нсд)
(визначити найбільший-спільний-дільник
  (функція (перший-аргумент другий-аргумент)
    (за-умовою
      ((нуль? другий-аргумент) перший-аргумент)
      (так (найбільший-спільний-дільник другий-аргумент (модульна-остача перший-аргумент другий-аргумент))))))
; Д8:00100110 — найменше спільне кратне.
; Похідний закон через точну арифметику Д5 та найбільший спільний дільник Д6.
; Нульовий аргумент дає нуль; ненульовий результат невід'ємний.
; Це бібліотечне визначення, а не нова машинна координата.
(визначити найменше-спільне-кратне
  (функція (перше-число друге-число)
    (за-умовою
      ((нуль? перше-число) число-нуль)
      ((нуль? друге-число) число-нуль)
      (так
        (модуль
          (помножити
            (частка перше-число
              (найбільший-спільний-дільник перше-число друге-число))
            друге-число))))))

; ===== НСД (розширення) + T5M (транспортний кодек) =====
; Власник 2026-10-17: «реалізуй T5M новими функціями + реалізуй НСД».
; Усе — похідні від наявних Д3/Д4/Д5/Д6; жодних нових координат.

; --- НСД (gcd) ---
; нсд для списку: згортка бінарного нсд (уже визначеного вище) по списку.
(визначити нсд-списку
  (функція (числа)
    (за-умовою
      ((порожній? числа) число-нуль)
      ((порожній? (решта числа)) (перше числа))
      (так (найбільший-спільний-дільник (перше числа) (нсд-списку (решта числа)))))))

; нсд трьох чисел — явна трійкова форма (зручна для свідків).
(визначити нсд-трьох
  (функція (перший-аргумент другий-аргумент третє-значення)
    (найбільший-спільний-дільник перший-аргумент (найбільший-спільний-дільник другий-аргумент третє-значення))))

; --- T5M: точні слова -> трійковий транспорт ---
; 5 трітів/байт (3^5=243<256); тріт-розділювач 2; фінальний байт ДОПОВНЮЄТЬСЯ трітами 2
; (підтверджено незалежно: t5m.zig encode -> while (used!=0) appendDigit(...,2)).

(визначити тріт-розділювач число-два)
(визначити трітів-у-байті число-п'ять)
(визначити трійкова-основа число-три)

; На межі Д1-біти залишаються предикатами; трійкова математика використовує трити Д24.
(визначити т5м-д24-тріт
  (функція (значення)
    ; Вхід — точний біт предиката Д1, керує вибором, а не є числом.
    (за-умовою
      (значення число-один)
      (так число-нуль))))

; Декодер повертає біти Д1, а не числові замінники Д24.
(визначити т5м-біт-д1
  (функція (значення)
    (за-умовою
      ((тотожне? значення число-нуль) ні)
      ((тотожне? значення число-один) так)
      (так значення))))

; накопичити: новий акумулятор = поточний*3 + тріт
(визначити т5-накопичити
  (функція (поточний тріт)
    (додати (помножити поточний трійкова-основа) тріт)))

; біти слова (старший перший) -> список трітів (0/1 як тріти)
(визначити т5-тріти-слова
  (функція (біти)
    (за-умовою
      ((порожній? біти) (як-є ()))
      (так (сполучити (т5м-д24-тріт (перше біти)) (т5-тріти-слова (решта біти)))))))

; згорнути список трітів у трійкове число
(визначити т5-трійкове
  (функція (тріти)
    (т5-трійкове-з число-нуль тріти)))

; акумуляторна згортка зліва направо: перший тріт — старший
(визначити т5-трійкове-з
  (функція (акум тріти)
    (за-умовою
      ((порожній? тріти) акум)
      (так (т5-трійкове-з (т5-накопичити акум (перше тріти)) (решта тріти))))))

; доповнити список трітів до 5 значенням 2 (розділювач) — фінальний байт
(визначити т5-заповнити
  (функція (тріти)
    (за-умовою
      ((рівно-пять? (довжина тріти)) тріти)
      (так (т5-заповнити (сполучити (як-є ()) (сполучити тріти тріт-розділювач)))))))

; один байт T5 з одного слова (<=5 трітів) — контрольований приклад
(визначити т5-байт-слова
  (функція (біти)
    (т5-трійкове (т5-заповнити (т5-тріти-слова біти)))))

; рівно-пять? — допоміжний предикат довжини (без семантики зовнішнього виконавця)
; --- T5M: ПОВНИЙ багатобайтовий кодек ---
; Перевірено 6/6 проти scripts/сенс_t5_codec.py (енкодер і декодер, round-trip).
; Правило: тріти = (розділювач 2 між словами) + біти; доповнити до кратного 5
; трітом 2 У КІНЦІ; групами по 5, згортка ЗЛІВА НАПРАВО (перший тріт — старший).

; тріти одного слова: (якщо не перше) 2, потім біти
(визначити т5-тріти-списку
  (функція (слова)
    (за-умовою
      ((порожній? слова) (як-є ()))
      ((порожній? (решта слова))
       (т5-тріти-слова (перше слова)))
      (так
       (т5-зшити (т5-тріти-слова (перше слова))
         (сполучити тріт-розділювач (т5-тріти-списку (решта слова))))))))

; доповнити список трітів до кратного 5 (тріт 2 у КІНЦІ)
(визначити т5-вирівняти
  (функція (тріти)
    (за-умовою
      ((нуль? (остача (довжина тріти) число-п'ять)) тріти)
      (так (т5-вирівняти (т5-зшити тріти (сполучити тріт-розділювач (як-є ()))))))))

; перші 5 трітів -> один байт (акумуляторна згортка зліва направо)
(визначити т5-група-байт-з
  (функція (акум пять)
    (за-умовою
      ((порожній? пять) акум)
      (так (т5-група-байт-з (т5-накопичити акум (перше пять)) (решта пять))))))

; взяти перші n елементів
(визначити т5-взяти-н
  (функція (число-аргумент елементи)
    (за-умовою
      ((нуль? число-аргумент) (як-є ()))
      ((порожній? елементи) (як-є ()))
      (так (сполучити (перше елементи) (т5-взяти-н (зменшити-на-один число-аргумент) (решта елементи)))))))

; відкинути перші n елементів
(визначити т5-відкинути-н
  (функція (число-аргумент елементи)
    (за-умовою
      ((нуль? число-аргумент) елементи)
      ((порожній? елементи) (як-є ()))
      (так (т5-відкинути-н (зменшити-на-один число-аргумент) (решта елементи))))))

; повний енкодер: список слів (кожне — список бітів) -> список байтів
; --- Партія Д8/Д9 №3: масиви + рядки (наказ: партіями, у main) ---
; Точні коди: 100 перше, 011 решта, 111 CONS, 001 QUOTE, 110011110 STRING-APPEND.

; copy-array (копіювати-масив) — копія послідовності через append з порожнім
(визначити копіювати-масив
  (функція (с) (приєднати с (як-є ()))))

; vector-length (довжина-вектора) — довжина послідовності через Д6 LENGTH
(визначити довжина-вектора
  (функція (с) (довжина с)))

; Д9:110011110 STRING-APPEND має точний механізм для двох текстових значень.
; Не затінювати його Core4-визначенням через Д4 APPEND, який приймає списки.

; Д9:110100011 STRING-SLICE — СЕНС проєкція над списком символів.
; [початок, кінець) з двома точними межами Д24+, без зовнішньої обробки тексту чи UTF-8.
; Тільки вже чинний Д8 SUBSEQ, прямий Д9 виклик заборонений.
(визначити рядок-зріз
  (функція (рядок початок кінець)
    (підпослідовність рядок початок кінець)))

; --- Партія Д9: content-store put/remove + fs-empty (наказ: партіями, у main) ---
; Семантика задана фікстурою d9-content-store-projection-laws.лісп:
; сховище = список пар (адреса . значення); розмір = довжина; отримати -> (значення) або ().
; Точні коди: 100 перше, 011 решта, 111 CONS, 001 QUOTE, 0101 EMPTY?, 101 EQ, 110 COND.

; CONTENT-STORE-PUT зберігає значення за адресою через незмінну мапу Д9.
(визначити вміст-сховище-покласти
  (функція (сховище адреса значення)
    (мапа-вставити адреса значення сховище)))

; content-store-remove (вміст-сховище-видалити) — прибрати всі пари з цією адресою
(визначити вміст-сховище-видалити
  (функція (сховище адреса)
    (за-умовою
      ((порожній? сховище) (як-є ()))
      ((тотожне? адреса (перше (перше сховище)))
       (вміст-сховище-видалити (решта сховище) адреса))
      (так (сполучити (перше сховище)
                  (вміст-сховище-видалити (решта сховище) адреса))))))

; Порожній знімок ФС: об'єкти, зв'язки, ревізія.
(визначити фс-порожній
  (функція ()
    (список (як-є ()) (мапа-порожній) (довжина (як-є ())))))

; prune-entry (обрізати-запис) — відкинути найстаріший (останній) запис
(визначити обрізати-запис
  (функція (сховище)
    (за-умовою
      ((порожній? сховище) (як-є ()))
      ((порожній? (решта сховище)) сховище)
      (так (сполучити (перше сховище) (обрізати-запис (решта сховище)))))))

; --- Партія Д8 №2: аксесори й похідні (наказ: партіями, у main) ---
; Точні коди: 100 перше, 011 решта, 111 CONS, 001 QUOTE. Жодних нових координат.

; rational (чисельник/знаменник) — раціональне як пара (чисельник . знаменник)
(визначити чисельник
  (функція (дріб) (перше дріб)))

(визначити знаменник
  (функція (дріб) (решта дріб)))

; realpart / imagpart — дійсна та уявна частини комплексної пари
(визначити дійсна-частина
  (функція (пара) (перше пара)))

(визначити уявна-частина
  (функція (пара) (решта пара)))

; aref (елемент-масиву) — n-й елемент послідовності
(визначити елемент-масиву
  (функція (число-аргумент елементи) (елемент-списку-за-індексом число-аргумент елементи)))

; vector-copy (копіювати-вектор) — копія списку через append з порожнім
(визначити копіювати-вектор
  (функція (с) (приєднати с (як-є ()))))

; getprop (отримати-властивість) — знайти значення за ключем у списку пар
(визначити отримати-властивість
  (функція (ключ елементи) (знайти-за-ключем ключ елементи)))

; putprop (встановити-властивість) — додати пару (ключ . значення) на початок
(визначити встановити-властивість
  (функція (ключ значення елементи)
    (сполучити (сполучити ключ значення) елементи)))

; --- Партія Д8: чисті похідні функції (наказ власника: визначати партіями) ---
; Усе — похідне від наявних Д3/Д4/Д5/Д6/Д8; жодних нових координат.

; dotimes (повторити-разів) — викликати дію N разів, повернути останній результат
(визначити повторити-разів
  (функція (число-аргумент дія)
    (повторити-з число-аргумент дія (як-є ()))))

(визначити повторити-з
  (функція (число-аргумент дія акум)
    (за-умовою
      ((нуль? число-аргумент) акум)
      (так (повторити-з (зменшити-на-один число-аргумент) дія (дія))))))

; values (значення) — тотожність (одне значення не загортається)
(визначити значення
  (функція (аргумент-х) аргумент-х))

; multiple-value-list (список-значень) — обгорнути у список
(визначити список-значень
  (функція (аргумент-х) (сполучити аргумент-х (як-є ()))))

; incf!/decf! (збільшити!/зменшити!) — арифметичні інкременти
(визначити збільшити!
  (функція (аргумент-х) (+ аргумент-х число-один)))

(визначити зменшити!
  (функція (аргумент-х) (- аргумент-х число-один)))

; closurep? (замикання?) — чи є значення функцією (через symbol? на car голови)
(визначити замикання?
  (функція (аргумент-х) (символ? аргумент-х)))

; boundp? (зв'язане?) — чи є символ зв'язаним (через symbol?)
(визначити зв'язане?
  (функція (аргумент-х)
    (за-умовою
      ((символ? аргумент-х) (як-є так))
      (так (як-є ())))))

; pairlis-lite: vcons (вектор-сполучити) — cons двох значень у пару
(визначити вектор-сполучити
  (функція (перший-аргумент другий-аргумент) (сполучити перший-аргумент другий-аргумент)))

; --- T5M3: 3-байтова упаковка (15 трітів у 3 байти, LE) ---
; Власник 2026-10-17: «ми в т5м пакуєм по 3 байти». 3^15=14348907 < 2^24=16777216.
; Перевірено round-trip 7/7 (Python-модель). Група = 15 трітів -> одне 24-бітне
; число -> 3 байти little-endian. Група доповнюється трітом 2 до кратного 15.

(визначити т5м3-вирівняти
  (функція (тріти)
    (за-умовою
      ((нуль? (остача (довжина тріти) число-п'ятнадцять)) тріти)
      (так (т5м3-вирівняти (т5-зшити тріти (сполучити тріт-розділювач (як-є ()))))))))

; 15 трітів -> 24-бітне значення (згортка зліва направо)
(визначити т5м3-значення-15
  (функція (тріти)
    (т5м3-значення-з число-нуль тріти)))

(визначити т5м3-значення-з
  (функція (акум тріти)
    (за-умовою
      ((порожній? тріти) акум)
      (так (т5м3-значення-з (т5-накопичити акум (перше тріти)) (решта тріти))))))

; значення -> 3 байти (LE): [v%256, (v/256)%256, (v/65536)%256]
(визначити т5м3-три-байти
  (функція (значення-в)
    (сполучити (остача значення-в число-двісті-п'ятдесят-шість)
         (сполучити (остача (частка-через-подвоєння значення-в число-двісті-п'ятдесят-шість) число-двісті-п'ятдесят-шість)
              (сполучити (остача (частка-через-подвоєння значення-в число-шістдесят-п'ять-тисяч-п'ятсот-тридцять-шість) число-двісті-п'ятдесят-шість)
                   (як-є ()))))))

; повний 3-байтовий енкодер: список слів -> плоский список байтів
(визначити т5м3-у-байти
  (функція (слова)
    (т5м3-групувати-15 (т5м3-вирівняти (т5-тріти-списку слова)))))

; --- T5M3: ДЕКОДЕР 3 байти -> 15 трітів -> слова ---
; Round-trip перевірено 4/4 (Python-модель).

; 3 байти (LE) -> 24-бітне значення
(визначити т5м3-значення-байтів
  (функція (байт-нуль байт-один байт-два)
    (додати байт-нуль (додати (помножити байт-один число-двісті-п'ятдесят-шість) (помножити байт-два число-шістдесят-п'ять-тисяч-п'ятсот-тридцять-шість)))))

; 24-бітне значення -> рівно 15 трітів (старший перший), акумуляторно
(визначити т5м3-15-трітів
  (функція (значення-в)
    (т5м3-15-з значення-в число-нуль (як-є ()))))

(визначити т5м3-15-з
  (функція (значення-в акум тріти)
    (за-умовою
      ((рівно-15? (довжина тріти)) тріти)
      (так (т5м3-15-з (частка-через-подвоєння значення-в число-три) акум (сполучити (остача значення-в число-три) тріти))))))

(визначити рівно-15?
  (функція (число-аргумент)
    (тотожне? число-аргумент число-п'ятнадцять)))

; перевернути список (хвіст-рекурсивно, з акумулятором)
(визначити т5-перевернути
  (функція (елементи акум)
    (за-умовою
      ((порожній? елементи) акум)
      (так (т5-перевернути (решта елементи) (сполучити (перше елементи) акум))))))

; усі байти -> плоский список трітів

; Обернений стовпчиковий поділ трьох Д24 байтів на 3.
; Математична межа кожного тимчасового слова <= 767.
; Повернення: (залишок . (новий-b0 новий-b1 новий-b2)).
(визначити т5м3-байти-ділити-на-три
  (функція (байти)
    (т5м3-ділити-старший
      (перше байти)
      (перше (решта байти))
      (перше (решта (решта байти))))))

(визначити т5м3-ділити-старший
  (функція (байт-нуль байт-один байт-два)
    (т5м3-ділити-середній
      байт-нуль байт-один
      (частка-через-подвоєння байт-два число-три)
      (остача байт-два число-три))))

(визначити т5м3-ділити-середній
  (функція (байт-нуль байт-один частка-друга остача-друга)
    (т5м3-ділити-середній-з
      байт-нуль частка-друга
      (додати (помножити остача-друга число-двісті-п'ятдесят-шість) байт-один))))

(визначити т5м3-ділити-середній-з
  (функція (байт-нуль частка-друга значення-один)
    (т5м3-ділити-молодший
      байт-нуль частка-друга
      (частка-через-подвоєння значення-один число-три)
      (остача значення-один число-три))))

(визначити т5м3-ділити-молодший
  (функція (байт-нуль частка-друга частка-перша остача-перша)
    (т5м3-ділити-молодший-з
      частка-перша частка-друга (додати (помножити остача-перша число-двісті-п'ятдесят-шість) байт-нуль))))

(визначити т5м3-ділити-молодший-з
  (функція (частка-перша частка-друга значення-нуль)
    (сполучити
      (остача значення-нуль число-три)
      (список (частка-через-подвоєння значення-нуль число-три) частка-перша частка-друга))))

; Наймолодший тріт видобуваємо першим; CONS дає порядок MSB-first.
(визначити т5м3-15-трітів-із-байтів
  (функція (байти кількість зібрані)
    (за-умовою
      ((нуль? кількість) зібрані)
      (так
       (т5м3-15-із-частки
         (т5м3-байти-ділити-на-три байти)
         кількість зібрані)))))

(визначити т5м3-15-із-частки
  (функція (ділення кількість зібрані)
    (т5м3-15-трітів-із-байтів
      (решта ділення)
      (зменшити-на-один кількість)
      (сполучити (перше ділення) зібрані))))

(визначити т5м3-тріти-байтів
  (функція (байти)
    (за-умовою
      ((порожній? байти) (як-є ()))
      (так
       (т5-зшити
        (т5м3-15-трітів-із-байтів (список (перше байти) (перше (решта байти)) (перше (решта (решта байти)))) число-п'ятнадцять (як-є ()))
        (т5м3-тріти-байтів (решта (решта (решта байти)))))))))

; прибрати хвостові 2 (пад)
(визначити т5-без-хвостових-2
  (функція (тріти)
    (за-умовою
      ((порожній? тріти) (як-є ()))
      (так
       (за-умовою
        ((тотожне? (т5-останній тріти) тріт-розділювач) (т5-без-хвостових-2 (т5-без-останнього тріти)))
        (так тріти))))))

; розбити тріти на слова по розділювачу 2
(визначити т5-розбити-по-2
  (функція (тріти поточне слова)
    (за-умовою
      ((порожній? тріти) (т5-перевернути (т5-додати-слово поточне слова) (як-є ())))
      ((тотожне? (перше тріти) тріт-розділювач)
       (т5-розбити-по-2 (решта тріти) (як-є ()) (т5-додати-слово поточне слова)))
      (так (т5-розбити-по-2 (решта тріти)
                              (сполучити (т5м-біт-д1 (перше тріти)) поточне) слова)))))

(визначити т5-додати-слово
  (функція (поточне слова)
    (за-умовою
      ((порожній? поточне) слова)
      (так (сполучити (т5-перевернути поточне (як-є ())) слова)))))

(визначити т5-останній
  (функція (елементи)
    (за-умовою ((порожній? (решта елементи)) (перше елементи))
         (так (т5-останній (решта елементи))))))

(визначити т5-без-останнього
  (функція (елементи)
    (за-умовою ((порожній? (решта елементи)) (як-є ()))
         (так (сполучити (перше елементи) (т5-без-останнього (решта елементи)))))))

; ПОВНИЙ декодер: список байтів -> список слів (кожне — список бітів)
(визначити т5м3-з-байтів
  (функція (байти)
    (т5-розбити-по-2 (т5-без-хвостових-2 (т5м3-тріти-байтів байти)) (як-є ()) (як-є ()))))


; T5M3 — стовпчикове пакування трьох байтів у самій мові СЕНС.
; Кожний проміжний перенос <= 767 (Д24). Не обчислюємо тимчасове
; 15-трітове число > межі звичайного знакового Д24.
; Закон: [b0,b1,b2] = [0,0,0]; для тріта t повторити V := 3V+t.
; Крок потокового трьохбайтового кодування T5M3. Прямі застосування
; функцій Д4 зв'язують проміжні значення v0/v1/v2; макрос LET
; не визначає закону чисел із явно заданим доменом.
; Кожен крок виконує точну арифметику Д24: 3 × байт + тріт + попереднє перенесення.
(визначити т5м3-байтовий-крок
  (функція (тріт байти)
    (т5м3-байтовий-крок-другий
      (додати (помножити (перше байти) число-три) тріт)
      (решта байти))))

(визначити т5м3-байтовий-крок-другий
  (функція (значення-нуль решта-байтів)
    (т5м3-байтовий-крок-третій
      значення-нуль
      (додати (помножити (перше решта-байтів) число-три)
              (частка-через-подвоєння значення-нуль число-двісті-п'ятдесят-шість))
      (перше (решта решта-байтів)))))

(визначити т5м3-байтовий-крок-третій
  (функція (значення-нуль значення-один байт-два)
    (список
      (остача значення-нуль число-двісті-п'ятдесят-шість)
      (остача значення-один число-двісті-п'ятдесят-шість)
      (остача
        (додати (помножити байт-два число-три) (частка-через-подвоєння значення-один число-двісті-п'ятдесят-шість))
        число-двісті-п'ятдесят-шість))))

(визначити т5м3-байти-групи-з
  (функція (тріти байти)
    (за-умовою
      ((порожній? тріти) байти)
      (так
       (т5м3-байти-групи-з
         (решта тріти) (т5м3-байтовий-крок (перше тріти) байти))))))

(визначити т5м3-байти-із-трітів
  (функція (тріти)
    (т5м3-байти-групи-з тріти (список число-нуль число-нуль число-нуль))))

(визначити т5м3-групувати-15
  (функція (тріти)
    (за-умовою
      ((порожній? тріти) (як-є ()))
      (так
       (т5-зшити
        (т5м3-байти-із-трітів (т5-взяти-н число-п'ятнадцять тріти))
        (т5м3-групувати-15 (т5-відкинути-н число-п'ятнадцять тріти)))))))

; зшити два списки
(визначити т5-зшити
  (функція (перший-аргумент другий-аргумент)
    (за-умовою
      ((порожній? перший-аргумент) другий-аргумент)
      (так (сполучити (перше перший-аргумент) (т5-зшити (решта перший-аргумент) другий-аргумент))))))

(визначити т5-у-байти
  (функція (слова)
    (т5-групувати (т5-вирівняти (т5-тріти-списку слова)))))

(визначити т5-групувати
  (функція (тріти)
    (за-умовою
      ((порожній? тріти) (як-є ()))
      (так
       (сполучити (т5-група-байт-з число-нуль (т5-взяти-н число-п'ять тріти))
            (т5-групувати (т5-відкинути-н число-п'ять тріти)))))))

(визначити рівно-пять?
  (функція (число-аргумент)
    (тотожне? число-аргумент число-п'ять)))

; expt (піднести-до-степеня)
; Д6 POWER: власна рекурсія СЕНС; показники — невід'ємні Д24+.
; Канонічні Д24 нуль/один, жодних числових голів або десяткових посередників.
(визначити піднести-до-степеня
  (функція (основа показник)
    (за-умовою
      ((нуль? показник) число-один)
      (так
       (помножити основа
         (піднести-до-степеня основа (зменшити-на-один показник)))))))
; rassoc (знайти-за-значенням): точний атомний збіг значення.
; Запис із парою в cdr не можна передавати D3 EQ: пропускаємо його.
(визначити знайти-за-значенням
  (функція (значення-в список-пар)
    (за-умовою
      ((атом? список-пар) (як-є ()))
      ; D3 EQ приймає лише атомний шуканий аргумент.
      ((хибне? (атом? значення-в)) (як-є ()))
      ((атом? (перше список-пар))
       (знайти-за-значенням значення-в (решта список-пар)))
      ((хибне? (атом? (решта (перше список-пар))))
       (знайти-за-значенням значення-в (решта список-пар)))
      ((тотожне? значення-в (решта (перше список-пар)))
       (перше список-пар))
      (так
       (знайти-за-значенням значення-в (решта список-пар))))))
; intersection (перетин)
(визначити перетин
  (функція (перший-аргумент другий-аргумент) (відсіяти (функція (аргумент-х) (значення-у-списку? аргумент-х другий-аргумент)) перший-аргумент)))
; Д6:111011 UNION — незмінна композиція списків через Д5 MEMBER.
; Лівий список перевіряється під час рекурсії; права основа також має
; бути структурно правильним D3-списком, а не прихованим D1-атомом.
; Допоміжний SENS-обхід зберігає самий оригінальний правий список:
; не змінює порядок, повтори, тотожність та наявний закон результату.
(визначити об'єднання-перевірити-правий
  (функція (залишок початковий)
    (за-умовою
      ((порожній? залишок) початковий)
      ((атом? залишок) (перше залишок))
      (так
       (об'єднання-перевірити-правий
         (решта залишок) початковий)))))

(визначити об'єднання
  (функція (перший-аргумент другий-аргумент)
    (за-умовою
      ((порожній? перший-аргумент)
       (об'єднання-перевірити-правий другий-аргумент другий-аргумент))
      ((атом? перший-аргумент) (перше перший-аргумент))
      ((значення-у-списку? (перше перший-аргумент) другий-аргумент)
       (об'єднання (решта перший-аргумент) другий-аргумент))
      (так
       (сполучити (перше перший-аргумент)
         (об'єднання (решта перший-аргумент) другий-аргумент))))))


; Д9:110001100 — ОБ'ЄДНАННЯ-НА-МІСЦІ (історичне NUNION).
; Нормативна похідна семантика для незмінних списків СЕНС:
; множинний результат збігається з «об'єднання», без мутації хоста.
; Дослідження: research/d9-nunion-subst-depth-batch-2026-10-17.лісп.
; Зовнішня історична назва не є окремою викличною тотожністю.
(визначити об'єднання-на-місці
  (функція (лівий-список правий-список)
    (об'єднання лівий-список правий-список)))

; ===== Похідні визначення Д6 (партія 4) =====
; evenp (парне?)
(визначити парне?
  (функція (аргумент-х) (нуль? (модульна-остача аргумент-х число-два))))
; oddp (непарне?)
(визначити непарне?
  (функція (аргумент-х) (хибне? (нуль? (модульна-остача аргумент-х число-два)))))
; Д6:111110 INTEGERP — «ціле?» має власний механізм точного D12+.
; Не визначати його заново через D5 NUMBERP: канонічний RATIO не є цілим.
; D12/D24/... мають точну доменну ідентичність; D1/D3/D7 — не числа.
; Д6:111111 RATIONALP — похідний SENS-закон над чинним D5:01001 NUMBERP.
; Для ратифікованої точної числової родини цілі, NEG та канонічні RATIO
; раціональні; дробовий RATIO не є цілим. Числові float тут не допускаються.
; D5 NUMBERP вже має реалізацію у SENS evaluator і парний D12/T5M-допуск;
; історичний коментар про відсутність механізму D5:01001 був застарілим.
; Не виводити D12-ідентичність із тексту, бітності без домену або D7.
(визначити раціональне?
  (функція (аргумент-х) (число? аргумент-х)))
; Д6:111100 ANY — коротке замикання, точна структура D3.
; Лише атом, тотожний D3:(), дає D1:ні без виклику предиката.
; D1:ні та інший непорожній атом не є D3:(): D3 CAR повертає Type.
; Предикат викликається тільки після структурного допуску пари.
(визначити будь-яке?
  (функція (умова елементи)
    (за-умовою
      ((атом? елементи)
       (за-умовою
         ((тотожне? елементи (як-є ())) ні)
         (так (перше елементи))))
      ((умова (перше елементи)) так)
      (так (будь-яке? умова (решта елементи))))))

; Д6:111101 ALL — коротке замикання, точна структура D3.
; Лише D3:() дає D1:так; іншому атомові заборонено маскувати Type.
; На правильній парі зупинка на першому D1:ні незмінна.
(визначити усі?
  (функція (умова елементи)
    (за-умовою
      ((атом? елементи)
       (за-умовою
         ((тотожне? елементи (як-є ())) так)
         (так (перше елементи))))
      ((умова (перше елементи)) (усі? умова (решта елементи)))
      (так ні))))


; ===== Похідні визначення Д6 (партія 5) =====
; curry (частково-застосувати)
(визначити частково-застосувати
  (функція (функція-ф аргумент-х)
    (функція (аргумент-у)
      (функція-ф аргумент-х аргумент-у))))
; Д6:101111 SCAN — ліве згортання зі збереженням усіх станів.
; Скінченний правильний xs: SCAN(f,z,xs) = (z, f(z,x1), ..., REDUCE(f,z,xs)).
; Прямий результат SCAN(дія,стан,()) лишається Д3:().
; Допоміжний SCAN-ONTO з порожнім хвостом повертає (стан).
; Неправильний атомарний хвіст має справжню Type D3 CAR до виклику дії.
; Хвостова рекурсія будує зворотні стани; один D5 REVERSE відновлює порядок.
; Додаткове визначення є внутрішнім помічником SENS без доменної координати.
(визначити накопичувати-зворотні-стани
  (функція (дія стан елементи зворотні-стани)
    (за-умовою
      ; Лише структурне Д3:() завершує обхід.
      ; D1:ні у хвості спричиняє нативну Type від Д3 ПЕРШЕ.
      ((атом? елементи)
       (за-умовою
         ((тотожне? елементи (як-є ())) (зворот зворотні-стани))
         (так (перше елементи))))
      (так
       ((функція (наступний-стан)
          (накопичувати-зворотні-стани
            дія наступний-стан (решта елементи)
            (сполучити наступний-стан зворотні-стани)))
        (дія стан (перше елементи)))))))

(визначити накопичувати-до
  (функція (дія стан елементи)
    (накопичувати-зворотні-стани
      дія стан елементи
      (сполучити стан (як-є ())))))

(визначити накопичувати
  (функція (дія стан елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((атом? елементи) (перше елементи))
      (так
       (накопичувати-до дія стан елементи)))))
; Д6:111001 UNZIP — один структурний обхід списку пар засобами SENS.
; Тільки D3:() завершує обхід із двома порожніми списками.
; Атомарний корінь, атомарний хвіст чи атом замість пари: D3 CAR Type.
; Компоненти є рівно D3 CAR/CDR кожної пари: хвіст пари може бути атомом.
; D8:11100011 UNZIP-swapped лишається перестановкою цих результатів.
; Одна рекурсія, без двох незалежних викликів D6 MAP; порядок збережено.
(визначити розпарувати-пари
  (функція (пари)
    (за-умовою
      ((порожній? пари) (список (як-є ()) (як-є ())))
      ((атом? пари) (перше пари))
      ((атом? (перше пари)) (перше (перше пари)))
      (так
       ((функція (пара хвости)
          (список
            (сполучити (перше пара) (перше хвости))
            (сполучити (решта пара) (перше (решта хвости)))))
        (перше пари)
        (розпарувати-пари (решта пари)))))))
; Д6:111000 ZIP — парування до кінця коротшого правильного списку.
; Тільки атом, тотожний Д3:(), завершує обхід. Д1:ні не є D3:().
; Для іншого атома Д3 ПЕРШЕ мусить видати справжню Type-помилку.
; При коректних парах зберігаємо порядок і обидві голови без дублювання.
; Перевіряємо лівий, тоді правий аргумент: порожній список завершує ZIP.
(визначити спарувати-послідовності
  (функція (перший-аргумент другий-аргумент)
    (за-умовою
      ((атом? перший-аргумент)
       (за-умовою
         ((тотожне? перший-аргумент (як-є ())) (як-є ()))
         (так (перше перший-аргумент))))
      ((атом? другий-аргумент)
       (за-умовою
         ((тотожне? другий-аргумент (як-є ())) (як-є ()))
         (так (перше другий-аргумент))))
      (так
       (сполучити
         (сполучити (перше перший-аргумент) (перше другий-аргумент))
         (спарувати-послідовності
           (решта перший-аргумент)
           (решта другий-аргумент)))))))


; Д8:11100001 ZIP-swapped / Д8:11100011 UNZIP-swapped.
; Ратифіковані координати #3960, product law #3710, без нових opcode.
; Похідні від Д6:111000 і Д6:111001. Точні слова не розширюються.
(визначити спарувати-послідовності-навпаки
  (функція (ліві праві)
    (спарувати-послідовності праві ліві)))

(визначити розпарувати-пари-навпаки
  (функція (пари)
    ((функція (результат)
       (список (друге результат) (перше результат)))
     (розпарувати-пари пари))))

; Д8:11110001 — заперечити умову для кожної спроби ANY; ратифікована композиція.
; Лише похідна реалізація СЕНС через Д6:111100 ANY та Д4:0100 NOT.
(визначити є-що-не-задовольняє?
  (функція (параметр-п значення)
    (будь-яке? (функція (аргумент-х) (хибне? (параметр-п аргумент-х))) значення)))

; Д8:11110011 = ALL(NOT p), включно з порожнім списком.
