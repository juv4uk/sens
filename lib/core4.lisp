       (за-умовою
         ((тотожне? (перше другий-аргумент) ні) другий-аргумент)
         ((хибне? (тотожне? (перше другий-аргумент) ні))
          (за-умовою
            ((менше? (довжина перший-аргумент) (довжина другий-аргумент))
             другий-аргумент)
            ((хибне? (менше? (довжина перший-аргумент) (довжина другий-аргумент)))
