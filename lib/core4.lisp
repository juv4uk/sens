  (функція (перший-аргумент)
    (за-умовою
      ((порожній? перший-аргумент) (як-є ()))
      ((числовий-рівність (довжина перший-аргумент) (довжина (як-є (ні ні ні ні ні ні ні)))) (як-є ()))
