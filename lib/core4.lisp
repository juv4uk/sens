  (функція (перший-аргумент другий-аргумент)
    (за-умовою
      ((порожній? перший-аргумент)
       (за-умовою
         ((порожній? другий-аргумент) (як-є ()))
         ((тотожне? (перше другий-аргумент) ні) другий-аргумент)
         ((хибне? (тотожне? (перше другий-аргумент) ні)) (як-є ()))))
      ((порожній? другий-аргумент)
       (за-умовою
         ((тотожне? (перше перший-аргумент) ні) перший-аргумент)
         ((хибне? (тотожне? (перше перший-аргумент) ні)) (як-є ()))))
      ((тотожне? (перше перший-аргумент) ні)
