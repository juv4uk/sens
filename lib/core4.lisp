      ((тотожне? адреса (перше (перше сховище)))
       (список (решта (перше сховище))))
      (так (вміст-сховище-отримати (решта сховище) адреса)))))

; Д9:000011110 CONTENT-STORE-CONTAINS? — присутність, ніколи не істинність значення.
(визначити вміст-сховище-містить?
  (функція (сховище адреса)
    (за-умовою
      ((порожній? сховище) ні)
      ((тотожне? адреса (перше (перше сховище))) так)
      (так (вміст-сховище-містить? (решта сховище) адреса)))))

; Д8:10110111 FLOOR, точна ціла частка, округлена вниз.
; Д8:01001100 TRUNCATE і Д8:01000000 REM зі знаком діленого —
; доведення нижчих доменів. Якщо знаки різні й REM != 0, тоді FLOOR = TRUNC - 1.
(визначити округлити-вниз
  (функція (ділене дільник)
    (за-умовою
      ((нуль? (остача-зі-знаком ділене дільник))
       (округлити-до-нуля ділене дільник))
      ((менше? ділене (відняти ділене ділене))
       (за-умовою
         ((менше? дільник (відняти дільник дільник))
          (округлити-до-нуля ділене дільник))
         (так
          (відняти (округлити-до-нуля ділене дільник)
            (частка дільник дільник)))))
      ((менше? дільник (відняти дільник дільник))
       (відняти (округлити-до-нуля ділене дільник)
         (частка дільник дільник)))
      (так (округлити-до-нуля ділене дільник)))))

; Д8:10110010 LOGNOT, безмежна арифметична тотожність доповняльного коду:
; Для кожного допустимого цілого n зі знаком: NOT(n) = -n - 1.
(визначити побітове-не
  (функція (число)
    (відняти (змінити-знак число) число-один)))


; Д9:000010011 GUARD-REFERENCE-FIELD — теговане посилання містить (field value).
; Ключі звіряємо через чинний Д5 ASSOC та структурну рівність, без прямого виклику Д9.
; Д9:000010011 — власний прямий обхід полів маркованого запису засобами СЕНС.
; Уникайте пониження анонімного викликного гола; форма (tag (field value) ...).
(визначити внутрішнє-поле-у-парах
  (функція (поле пари)
    (за-умовою
      ((порожній? пари) (як-є ()))
      ((однакові? поле (перше (перше пари))) (решта (перше пари)))
      (так (внутрішнє-поле-у-парах поле (решта пари))))))
(визначити захист-еталон-поле
  (функція (поле запис)
    (внутрішнє-поле-у-парах поле (решта запис))))


; Д9:000001111 PROVENANCE-RULE із канонічного (statement goal (source ...) (rule ...) ...).
(визначити походження-правило
  (функція (запис)
    (захист-еталон-поле (як-є rule) (решта запис))))


; Д9:000010110 PROVENANCE-GOAL — друга комірка канонічного запису.
(визначити походження-ціль
  (функція (запис)
    (друге запис)))


; Д9:000011100 PROVENANCE-DERIVED-FROM — незмінне поле дочірніх доказів.
(визначити походження-похідний-з
  (функція (запис)
    (захист-еталон-поле (як-є derived-from) (решта запис))))


; Д9:000101001 PROVENANCE-SOURCE — явне поле джерела свідчення в записі.
; Д9:000101001 PROVENANCE-SOURCE — точне третє поле канонічного
; запису (statement goal (source value) (rule ...) (derived-from ...)).
; `source` — позначення поля даних, а не виклична чи доменна поверхня.
(визначити походження-джерело
  (функція (запис)
    (друге (третє запис))))


; Д9:000001000 GUARD-UNKNOWN-ROUTES — точні канонічні маршрути з бібліотека/guard.лісп.
; Без оркестрації під час виконання: маршрутизація залишається незмінним значенням СЕНС.
(визначити захист-невідоме-маршрути
  (функція ()
    (як-є
      (((route ask-agent)
        (when ecosystem-local-or-component-owned)
        (action ask-responsible-live-agent)
        (verify commit-or-artifact-or-direct-source))
       ((route ask-owner)
        (when authority-choice-intent-license-or-destructive-scope)
        (action ask-owner-explicitly)
        (verify owner-decision-record))
       ((route research-web)
        (when external-current-or-primary-source-needed)
        (action search-authoritative-external-sources)
        (verify citations-and-access-date))))))


; Д9:000100100 MAKE-GUARD-FINDING — канонічний запис із бібліотека/guard.лісп.
; Явний дозволений статус рішення/свідчення, незмінні поля списку СЕНС.
(визначити створити-захист-висновок
  (функція (вхідне-рішення вхідний-доказ-стан предмет стан контракт різниця вплив порада докази)
    (за-умовою
      ((хибне? (захист-рішення? вхідне-рішення))
       (список (як-є invalid-guard-decision) вхідне-рішення))
      ((хибне? (захист-доказ-стан? вхідний-доказ-стан))
       (список (як-є invalid-evidence-status) вхідний-доказ-стан))
      (так
       (список
         (як-є guard-finding)
         (список (як-є schema) (як-є guard-1))
         (список (як-є decision) вхідне-рішення)
         (список (як-є evidence-status) вхідний-доказ-стан)
         (список (як-є subject) предмет)
         (список (як-є state) стан)
         (список (як-є contract) контракт)
         (список (як-є difference) різниця)
         (список (як-є impact) вплив)
         (список (як-є guidance) порада)
         (список (як-є evidence) докази)
         (список (як-є unknown-routes)
           (за-умовою
             ((тотожне? вхідне-рішення (як-є unknown))
              (захист-невідоме-маршрути))
             (так (як-є ())))))))))

; Д9:000110110 GUARD-COMPARE — чиста проєкція СЕНС з бібліотека/guard.лісп.
; Рівність визначає чинний структурний EQUAL; запис будує Д9 MAKE-GUARD-FINDING.
(визначити захист-порівняти
  (функція (предмет очікуване спостережене докази)
    (за-умовою
      ((однакові? очікуване спостережене)
       (створити-захист-висновок
         (як-є allow) (як-є confirmed) предмет спостережене очікуване
         (як-є ()) (як-є invariant-preserved) (як-є no-action) докази))
      (так
       (створити-захист-висновок
         (як-є warn) (як-є confirmed) предмет спостережене очікуване
         (список (як-є expected) очікуване (як-є observed) спостережене)
         (як-є contract-drift)
         (як-є reconcile-observation-with-contract) докази)))))

; Д9:000000110 GUARD-UNKNOWN — зберегти явне відсутнє свідчення,
; Невідомий стан класифікується як маршрутизований епістемічний стан, а не мовчазна відмова.
; Формат запису ратифіковано в бібліотека/guard.лісп через make-guard-finding.
(визначити захист-невідоме
  (функція (предмет відсутні-докази порада)
    (список
      (як-є guard-finding)
      (список (як-є schema) (як-є guard-1))
      (список (як-є decision) (як-є unknown))
      (список (як-є evidence-status) (як-є unresolved))
      (список (як-є subject) предмет)
      (список (як-є state) (як-є not-observed))
      (список (як-є contract) (як-є insufficient-evidence))
      (список (як-є difference) відсутні-докази)
      (список (як-є impact) (як-є decision-not-earned))
      (список (як-є guidance) порада)
      (список (як-є evidence) (як-є ()))
      (список (як-є unknown-routes) (захист-невідоме-маршрути)))))

; Д9:010111110 CANON-CONFORMS? — виконуване точне об'єднання одинадцяти законів.
; бібліотека/canon.лісп є семантичним джерелом. Чинні закони властивостей Д1
; проєктуються у канонічний явний запис стану з трьома полями мовою СЕНС.
(визначити канон-запис-д1-ознаки
  (функція (закон ознака)
    (за-умовою
      (ознака (канон-закон-виконаний закон))
      (так (канон-закон-порушений закон)))))

(визначити канон-відповідає?
  (функція ()
    (канон-відповідність-з
      (список
        (канон-закон-порожній-список)
        (канон-запис-д1-ознаки (як-є atom-cons)
          (канон-закон-атом-пара (як-є x) (як-є y)))
        (канон-запис-д1-ознаки (як-є car-cons)
          (канон-закон-перше-пара (як-є x) (як-є y)))
        (канон-запис-д1-ознаки (як-є cdr-cons)
          (канон-закон-решта-пара (як-є x) (як-є y)))
        (канон-запис-д1-ознаки (як-є eq-reflexive-atom)
          (канон-закон-рівність-рефлексивний-атом (як-є x)))
        (канон-запис-д1-ознаки (як-є cdr-dotted)
          (канон-закон-решта-крапковий (як-є x) (як-є y)))
        (канон-запис-д1-ознаки (як-є cdr-proper)
          (канон-закон-решта-правильний (як-є x)
            (список (як-є y))))
        (канон-запис-д1-ознаки (як-є cdr-improper)
          (канон-закон-решта-неправильний (як-є x) (як-є y)))
        (канон-закон-цитування-пригнічує-обчислення)
        (канон-закон-умова-перший-збіг-короткий-ланцюг)
        (канон-закон-символьний-поверхня)))))
; Д6:110101 MIN і Д6:110111 MAX — правильні варіативні проєкції СЕНС.
; Обов'язковий перший аргумент зберігає початкове обмеження арності Д6.
; Точно кваліфіковані порівняння Д24+ виконують уже наявні згортання списків Д6.
(визначити найменше
  (функція всі-аргументи (нехай ((перше-значення (перше всі-аргументи)) (решта-значень (решта всі-аргументи)))
    (найменше-у-списку (сполучити перше-значення решта-значень)))))
; Історичний зовнішній запис збережено як сумісне посилання.
(визначити найбільше
  (функція всі-аргументи (нехай ((перше-значення (перше всі-аргументи)) (решта-значень (решта всі-аргументи)))
    (найбільше-у-списку (сполучити перше-значення решта-значень)))))
; Історичний зовнішній запис збережено як сумісне посилання.


; Д9:111111010 WORLD? — рівно (world parent journal metadata),
; Відновлено з бібліотека/world.лісп. Жодного змінюваного об'єкта чи предиката хоста.
(визначити світ?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((однакові? (перше значення) (як-є world))
        (за-умовою
          ((атом? (решта значення)) ні)
          ((атом? (решта (решта значення))) ні)
          ((атом? (решта (решта (решта значення)))) ні)
          (так (порожній?
            (решта (решта (решта (решта значення))))))))
      (так ні))))

; Історичний зразок Д9 для світу: відбір подій tell/retract за модулем, від найновіших.
; Події мають ратифіковану форму списку (operation module clause).
(визначити внутрішні-події-модуля
  (функція (модуль події)
    (за-умовою
      ((порожній? події) (як-є ()))
      ((атом? події) (як-є ()))
      ((тотожне? (друге (перше події)) модуль)
        (сполучити (перше події)
          (внутрішні-події-модуля модуль (решта події))))
      (так (внутрішні-події-модуля модуль (решта події))))))

; Д9:111100100 WORLD-MODULE-EVENTS. Незмінний журнал залишається без змін.
(визначити світ-модуль-події
  (функція (світ модуль)
    (внутрішні-події-модуля модуль (світ-журнал світ))))

; Д9:111100000 WORLD-MODULE-KNOWN? — лише непорожній парний потік подій
; встановлює існування; Д1:NO ніколи не зводиться тихо з ().
(визначити світ-модуль-відомий?
  (функція (світ модуль)
    (хибне? (атом? (світ-модуль-події світ модуль)))))


; Д9:111010101 WORLD-TELL — новий незмінний світ із подією tell.
; Тотожність і порядок подій успадковано від бібліотека/world.лісп.
(визначити світ-повідомити
  (функція (світ модуль клауза)
    (світ-запис світ (список (як-є tell) модуль клауза))))

; Д9:111001010 WORLD-RETRACT — фіксація відкликання без зміни батьківського стану.
(визначити світ-відкликати
  (функція (світ модуль клауза)
    (світ-запис світ (список (як-є retract) модуль клауза))))


; Джерело Д9 WORLD-CLAUSES (бібліотека/world.лісп) — чисте хронологічне згортання подій.
; Журнал має порядок від нових до старих подій; згортати від старих до нових без змінювання світів.
(визначити внутрішній-зворот-подій
  (функція (події акумулятор)
    (за-умовою
      ((порожній? події) акумулятор)
      ((атом? події) акумулятор)
      (так (внутрішній-зворот-подій
        (решта події) (сполучити (перше події) акумулятор))))))

; Відкликати лише першу активну клаузу, структурно тотожну шуканій.
(визначити внутрішній-вилучити-клаузу
  (функція (клауза клаузи)
    (за-умовою
      ((порожній? клаузи) (як-є ()))
      ((однакові? клауза (перше клаузи)) (решта клаузи))
      (так
        (сполучити (перше клаузи)
          (внутрішній-вилучити-клаузу клауза (решта клаузи)))))))

; Історична форма події — (tell|retract module clause). Невідомі види
; зберігають стан: без нового випадку хоста, без неявного допуску опкоду.
(визначити внутрішньо-застосувати-подію
  (функція (клаузи подія)
    (за-умовою
      ((тотожне? (перше подія) (як-є tell))
        (сполучити (перше (решта (решта подія))) клаузи))
      ((тотожне? (перше подія) (як-є retract))
        (внутрішній-вилучити-клаузу
          (перше (решта (решта подія))) клаузи))
      (так клаузи))))

(визначити внутрішнє-згортання-подій
  (функція (події клаузи)
    (за-умовою
      ((порожній? події) клаузи)
      ((атом? події) клаузи)
      (так
        (внутрішнє-згортання-подій
          (решта події)
          (внутрішньо-застосувати-подію клаузи (перше події)))))))

; Д9:111010110 WORLD-CLAUSES. Вибираємо чинні твердження одного модуля.
; Модуль отримуємо з незмінного журналу з урахуванням порядку подій tell/retract.
(визначити світ-клаузи
  (функція (світ модуль)
    (внутрішнє-згортання-подій
      (внутрішній-зворот-подій
        (світ-модуль-події світ модуль) (як-є ()))
      (як-є ()))))


; Партія Д9/Д10 — 17.10.2026: власні семантичні тіла, без прямої диспетчеризації Д9/Д10.
; Д9:010011101 JUSTIFIED-MEMBER? — ратифікована проєкція членства.
; Джерело: research/d9-justified-member-remove-batch-2026-10-17.лісп.
(визначити обґрунтований-член?
  (функція (факт записи)
    (за-умовою
      ((порожній? записи) ні)
      ((однакові? факт (перше (перше записи))) так)
      (так (обґрунтований-член? факт (решта записи))))))

; Д9:010101001 REMOVE-JUSTIFIED — незмінний список, усі рівні елементи вилучено.
(визначити видалити-обґрунтований
  (функція (факт записи)
    (відсіяти
      (функція (запис)
        (хибне? (однакові? факт (перше запис))))
      записи)))

; Д9:001111010 MAKE-JUSTIFIED — факт та його список підтримок.
; Джерело: research/d9-justified-vec-arglist-batch-2026-10-17.лісп.
(визначити створити-обґрунтований
  (функція (факт підтримки)
    (сполучити факт підтримки)))

; Д9:001111011 AXIOM — рідна історична аксіома TMS (fact . NIL).
; Закон із бібліотека/forward.лісп; точна порожнеча Д3 є даними, не прямим опкодом Д9.
(визначити аксіома
  (функція (факт)
    (створити-обґрунтований факт (як-є ()))))


; Д9:010101011 FACT-OF / Д9:010001010 SUPPORTS-OF.
; Донор бібліотека/forward.лісп: TMS-запис (fact . supports), не W8 і не масив.
; перше/решта точно Д3:100/011; відсутній запис відхиляє Д3 типом.
(визначити факт-від
  (функція (запис) (перше запис)))
(визначити підтримки-від
  (функція (запис) (решта запис)))

; Д9:010011001 MAP-FACT-OF — рекурсивна проєкція фактів без зміни порядку.
; Власне СЕНС-визначення, не прямий Д9 value-call.
(визначити мапа-факт-від
  (функція (записи)
    (за-умовою
      ((порожній? записи) (як-є ()))
