; Умови застосування: EQ тільки над атомною головою; порядок зберігається;
; порожній список проходить ALL-ASSERTS? як істина.
; Тут не створюємо нових кодів і не відкриваємо прямі викличні голови Д10.
; Д1:YES = ATOM(QUOTE(())); Д1:NO = ATOM(CONS(QUOTE(()),QUOTE(()))).

; Д10:0100100110 clips-assert-form? — похідний закон через Д3/Д4.
(визначити твердження-кліпс?
  (функція (форма)
    (за-умовою
      ((атом? форма) ні)
      ((однакові? (перше форма) (як-є assert)) так)
      (так (однакові? (перше форма) (текст-у-символ "assert"))))))

; Д10:0100100111 clips-printout-form? — похідний закон через Д3/Д4.
(визначити виведення-кліпс?
  (функція (форма)
    (за-умовою
      ((атом? форма) ні)
      ((однакові? (перше форма) (як-є printout)) так)
      (так (однакові? (перше форма) (текст-у-символ "printout"))))))

; Д10:0100101000 clips-drop-printouts — похідний закон через Д3/Д4.
(визначити прибрати-виведення-кліпс
  (функція (форми)
    (за-умовою
      ; Тільки структурне D3:() є завершенням; D1:ні мусить дати CAR Type.
      ((порожній? форми) (як-є ()))
      ((атом? форми) (перше форми))
      ((виведення-кліпс? (перше форми))
       (прибрати-виведення-кліпс (решта форми)))
      (так
       (сполучити (перше форми) (прибрати-виведення-кліпс (решта форми)))))))

; Д10:0100101001 clips-all-asserts? — похідний закон через Д3/Д4.
(визначити усі-твердження-кліпс?
