; Д5:10101: точний доменний закон належить ратифікованій назві
; «зворот-до». Історичний латинський псевдонім нижче — лише сумісність.
; Д5:10101 REVERSE-ONTO: тільки структурний D3 () завершує обхід.
; Некоректний атомарний хвіст не можна маскувати як порожній результат:
; D3 ПЕРШЕ / РЕШТА мусять видати справжню SENS Type-помилку.
; Нормативний закон: REVERSE-ONTO(x,y) = APPEND(REVERSE(x),y).
(визначити зворот-до
  (функція (значення-аргументів накопичувач)
    (за-умовою
      ; Лише структурне D3:() завершує правильний список.
      ; D1:ні є атомним даним і має викликати D3 ПЕРШЕ Type.
      ((порожній? значення-аргументів) накопичувач)
      ((атом? значення-аргументів) (перше значення-аргументів))
      (так
       (зворот-до (решта значення-аргументів)
         (сполучити (перше значення-аргументів) накопичувач))))))


; Д5:10100 ЗВОРОТ. Канонічне українське визначення через Д5:10101.
(визначити зворот
  (функція (значення)
    (зворот-до значення (як-є ()))))

; Д5:01000 ZEROP — похідний мовний закон тільки для допущених чисел Д24+.
; У адитивній групі x = x+x рівносильне x = 0.
; Д5:01010 PLUS перевіряє числовий домен, Д3:101 EQ повертає Д1.
; Д5 ZEROP: явна числова Д24+ операція та Д3-еквівалентність;
; не викликати історичні двійкові координати як Лісп-числа.
(визначити нуль?
  (функція (значення)
    (тотожне? значення (відняти значення значення))))
; Та сама closure для явно типізованого зовнішнього написання тесту.
(визначити нуль-д24?
  (функція (значення)
    ; Точний Д24 нуль — це Д24:000...000, не EQ до суми значення+значення.
    ; EQUAL? зберігає домен і повертає Д1:1 або Д1:0.
    (однакові? значення число-нуль)))



; Д5 PLUS/DIFFERENCE/TIMES/LESSP/GREATERP уже мають незмінні механізми
; виклику значень у точному домені. Канонічні назви задано в
; бібліотека/domains/d5.лісп; не перевизначати ці незмінні імена в Core4.

; (reverse-onto (reverse left) right): спершу розвертаємо left, а тоді
; консимо його назад на right по елементу — відбудовує left ++ right у
; правильному порядку — два хвостово-рекурсивні проходи замість одного
; не-хвостового, невелика доплата роботою заради append, безпечного для
; Rust-стека.
; Д4:1111 приєднати — чинний механізм СЕНС (APPEND: правильні списки).
; Історичне перевизначення незмінної канонічної функції вилучено.
; Історичне ім'я — лише сумісне зв'язування української функції.

; Д6:101010 MAP-ONTO — хвостова рекурсія тільки для правильного списку.
; Закон: reverse(початковий акумулятор) ++ MAP(дія, значення).
; Дія виконується рівно один раз для кожного елемента у порядку обходу.
; Завершення лише на структурному D3 (); атомарний хвіст має Type від D3 CAR.
; D5 REVERSE і D5 REVERSE-ONTO зберігають власні доменні тотожності.
(визначити відобразити-до
  (функція (дія значення акумулятор)
    (за-умовою
      ((порожній? значення) (зворот акумулятор))
      ((атом? значення) (перше значення))
      (так
       (відобразити-до дія (решта значення)
         (сполучити (дія (перше значення)) акумулятор))))))

; Дослідження Д10 / родина спискових функцій PAIP: координати з таблиці
; власника не означають машинного допуску F1–F4. Кожну функцію визначено
; мовою СЕНС через уже ратифіковані Д3 CONS/перше/решта, Д4 NULL/COND і Д5 APPEND.
; Історичні свідки: knowledge/d10-crossrepo-paip-v1.json та бібліотека/domains/d10.лісп.
; Межа виконання від 18.10.2026: після завантаження Core4 точне слово Д10
; викликає тільки кореневе замикання реально визначеної функції,
; без автоматичного допуску примітива чи виведення викличності з ширини.
; Межа виконання: точне слово Д10 викликає лише реально визначене замикання;
; ширина та сама наявність координати не створюють функцію.
; Д10:0011010111 MKLIST: () залишається (); атом стає одноелементним
; списком, а наявний непорожній список повертається без змін.
(визначити утворити-список
  (функція (значення)
    (за-умовою
      ((порожній? значення) (як-є ()))
      ((атом? значення) (сполучити значення (як-є ())))
      (так значення))))

; Д10:0011001010 MAPPEND: об'єднати правильні списки, які повернула дія,
; зберігаючи порядок входу; без руйнівного додавання чи прихованих перетворень.
(визначити відобразити-й-додати
  (функція (дія елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((атом? елементи) (перше (як-є ())))
      (так
       (приєднати (дія (перше елементи))
               (відобразити-й-додати дія (решта елементи)))))))

; Д10:0011001110 FLATTEN: закон PAIP розкриває рівно ОДИН рівень,
; а не довільну глибину дерева.
(визначити сплющити
  (функція (елементи)
    (відобразити-й-додати
      (функція (елемент) (утворити-список елемент))
      елементи)))

; Д10 PAIP/MAL: лише похідне мовне визначення без машинного допуску F1–F4.
; Д10:0011001101 LAST1 повертає голову останньої пари непорожнього
; правильного списку, а не саму останню пару.
; Джерело: knowledge/d10-crossrepo-paip-v1.json.
(визначити останній
  (функція (елементи)
    (перше (останній-хвіст елементи))))

; Д10:0100001100 LISTP: і NIL, і будь-яка пара CONS мають форму списку;
; це відмінне від PROPER-LIST? та Д3:010 ATOM.
; Джерело: knowledge/d10-crossrepo-mal-v1.json.
(визначити список?
  (функція (значення)
    (за-умовою
      ((порожній? значення) так)
      ((атом? значення) ні)
      (так так))))


; Д10 PAIP FIND-IF-ANYWHERE: обхід дерева виведено із зафіксованого закону PAIP.
; Спочатку перевіряємо ATOM, предикат застосовуємо до всіх атомів, навіть ().
; Обхід зліва направо; успіх у перше не потребує подальшого обходу решта.
; Запис у таблиці Д10 не створює примітива чи машинного коду; виклик
; наявного замикання можливий лише після завантаження саме цього визначення.
(визначити є-листок-дерева-що-задовольняє-предикат?
  (функція (предикат дерево)
    (за-умовою
      ((атом? дерево)
       (за-умовою
         ((предикат дерево) так)
         (так ні)))
      ((є-листок-дерева-що-задовольняє-предикат? предикат (перше дерево))
       так)
      (так
       (є-листок-дерева-що-задовольняє-предикат? предикат (решта дерево))))))
; Д6:101000 MAP: власна рекурсія СЕНС над правильним списком.
; Д4:0101 NULL завершує обхід лише на порожньому списку; Д3:111 CONS зберігає порядок.
(визначити відобразити
  (функція (дія значення)
    (за-умовою
      ((порожній? значення) (як-є ()))
      (так
       (сполучити (дія (перше значення))
            (відобразити дія (решта значення)))))))

; Д6:101011 FILTER-ONTO: предикат повертає Д1, викликається рівно раз.
; Для правильного списку зберігаємо порядок і повтори: під час обходу
; відібрані елементи додаються ліворуч накопичувача; фінальний зворот
; повертає reverse(початковий-накопичувач) ++ відібрані-значення.
; Д6 LET не потрібен: лінива Д3 COND не викликає предикат повторно.
; Незалежний допуск Д5 REVERSE залишається окремим фізичним доказом.
(визначити відсіяти-до
  (функція (предикат значення акумулятор)
    (за-умовою
      ((порожній? значення) (зворот акумулятор))
      ((предикат (перше значення))
       (відсіяти-до предикат (решта значення)
         (сполучити (перше значення) акумулятор)))
      (так (відсіяти-до предикат (решта значення) акумулятор)))))

; Д6:101001 — незалежний мовний закон FILTER через Д3/Д4.
; Для скінченного правильного списку порядок і кратність зберігаються.
; Оцінюємо предикат рівно один раз на елемент; порожній список є базою.
; Не покладаємося на Д6:101011 FILTER-ONTO, Д5:10100 REVERSE чи Д6 LET:
; відсутній прямий механізм цих кодів не повинен підмінювати закон FILTER.
; Ця рекурсія не хвостова: стекова межа потребує окремого бенчмарка.
(визначити відсіяти
  (функція (умова значення)
    (за-умовою
      ((порожній? значення) (як-є ()))
      ((атом? значення) (перше значення))
      ((умова (перше значення))
       (сполучити (перше значення)
         (відсіяти умова (решта значення))))
      (так (відсіяти умова (решта значення))))))

; Д6:101110 REDUCE — ліве згортання зі станом у першому аргументі.
; Тільки точний порожній список Д3:() повертає початковий стан.
; Для непорожньої пари обчислюємо (операція стан (перше елементи));
; крок не переставляє аргументи й не пропускає повтори.
; Атомарний непорожній хвіст спершу відхиляє Д3 CAR з реальною Type,
; ще ДО довільного виклику операції, незалежно від порядку обчислення.
; Спільний D3-доказ для D6 REDUCE та D6 NTH.
; Перевіряємо весь хребет один раз ДО будь-якої користувацької операції.
; Тільки точне D3:() є кінцем; пізній D1/D7 атом дає D3 CAR Type.


; Внутрішнє ядро обчислює кожний крок рівно один раз, зліва направо.
; Хребет уже підтверджено, тому додаткової валідації тут немає.
(визначити згорнути-ядро
  (функція (операція стан елементи)
    (за-умовою
      ((порожній? елементи) стан)
      (так
       (згорнути-ядро операція
         (операція стан (перше елементи))
         (решта елементи))))))

; Д6:101110 REDUCE: спершу структурна правильність, потім callback.
(визначити згорнути
  (функція (операція стан елементи)
    (за-умовою
      ((підтвердити-д6-список елементи)
       (згорнути-ядро операція стан елементи))
      (так (перше (як-є ()))))))


; Паралельне зв'язування «нехай» розгортається у негайний виклик функції.
; Історична форма `(let ((x 1) (y 2)) body)` означає
; `((lambda (x y) body) 1 2)`, як у docs/quote-tutorial.md.
; Значення зв'язувань обчислюються в зовнішньому середовищі, до створення
; нового лексичного рівня. Тому у `(let ((x 1) (y x)) ...)`
; другий вираз не бачить першого зв'язування, як у Scheme/Racket.
; Макрос має фіксовану арність й одну форму тіла: кілька виразів
; об'єднуємо окремим викликом функції без параметрів.
; Розгортання будуємо зі спискових та предикатних законів Д3.
; Старі помічники зі структурними відповідями (1)/(0) не можуть
; керувати строгим двопольовим Д3:110 COND.

; D6:001000/001001: перевірити ВСЮ форму до розгортання.
; Єдиний законний хвіст — точний D3:(). Кожен запис: (атом вираз).
; D6:001000/001001 LET/LET* — ім'я має бути D7-символом,
; а не D1 логічним бітом, D3:() чи математичним D12+ атомом.
; Ця перевірка виконується до побудови лямбда-параметрів.
(визначити підтвердити-д6-імя-привязки
  (функція (імя)
    (за-умовою
      ((порожній? імя) (перше (як-є ())))
      ((атом? імя)
       (за-умовою
         ((тотожне? імя так) (перше (як-є ())))
         ((тотожне? імя ні) (перше (як-є ())))
         ((число? імя) (перше (як-є ())))
         (так так)))
      (так (перше (як-є ()))))))

(визначити підтвердити-д6-запис-привязки
  (функція (запис)
    (за-умовою
      ((атом? запис) (перше запис))
      ((підтвердити-д6-імя-привязки (перше запис))
       (за-умовою
         ((атом? (решта запис)) (перше (решта запис)))
         ((порожній? (решта (решта запис))) так)
         (так (перше (як-є ())))))
      (так (перше (як-є ()))))))

(визначити підтвердити-д6-привязки
  (функція (привязки)
    (за-умовою
      ((атом? привязки)
       (за-умовою
         ((порожній? привязки) так)
         (так (перше привязки))))
      ((підтвердити-д6-запис-привязки (перше привязки))
       (підтвердити-д6-привязки (решта привязки)))
      (так (перше (як-є ()))))))

(визначити параметри-привязок
  (функція (привязки)
    (за-умовою
      ((порожній? привязки) (як-є ()))
      ((атом? привязки) (перше привязки))
      (так (сполучити (перше (перше привязки))
                      (параметри-привязок (решта привязки)))))))

(визначити значення-привязок
  (функція (привязки)
    (за-умовою
      ((порожній? привязки) (як-є ()))
      ((атом? привязки) (перше привязки))
      (так (сполучити (перше (решта (перше привязки)))
                      (значення-привязок (решта привязки)))))))

(визначити нехай
  (макрос
    (функція (привязки тіло)
      (за-умовою
        ((підтвердити-д6-привязки привязки)
         (сполучити
           (сполучити
             (як-є функція)
             (сполучити (параметри-привязок привязки)
                        (сполучити тіло (як-є ()))))
           (значення-привязок привязки)))
        (так (перше (як-є ())))))))

; Тимчасове сумісне ім'я для наявних викликів під час переходу поверхні.

; Послідовне «нехай-послідовно» відрізняється від паралельного «нехай»:
; кожне наступне зв'язування бачить усі попередні.
; Історична форма `(let* ((x 1) (y (+ x 1))) body)` розгортається у
; `(let ((x 1)) (let* ((y (+ x 1))) body))`.
; Кожний крок створює вкладене зв'язування, а без нових зв'язувань
; обчислюється тіло. Це звичайна рекурсія Лісп-макроса, не спеціальна
; команда виконавця.
;
; Первісна рівність Маккарті `eq` визначена лише на атомах.
; Структурна рівність «однакові?» обходить пари СЕНС рекурсивно.
; Кожен вихід — точний D1-біт; fallback не залежить від голих D7-імен так/ні.
; EQ викликається тільки коли ОБИДВА D3-значення атомарні.
(визначити однакові?
  (функція (перший-аргумент другий-аргумент)
    (за-умовою
      ; D3 EQ викликається лише після перевірки обох операндів на ATOM.
      ; Не передаємо пару у ПОРОЖНІЙ?, бо це атомна тотожність NIL.
      ((атом? перший-аргумент)
       (за-умовою
         ((атом? другий-аргумент)
          (за-умовою
            ((порожній? перший-аргумент)
             (порожній? другий-аргумент))
            ((порожній? другий-аргумент) ні)
            (так (тотожне? перший-аргумент другий-аргумент))))
         (так ні)))
      ((атом? другий-аргумент) ні)
      ((однакові? (перше перший-аргумент) (перше другий-аргумент))
       (однакові? (решта перший-аргумент) (решта другий-аргумент)))
      (так ні))))

; Д8:11110111 EQUAL — ратифікована українська поверхня
; структурної рівності, визначеної мовою СЕНС.
; Псевдонім не створює нової машинної команди.

; Заперечення «хибне?» приймає тільки точний біт предиката Д1.
; Будь-який інший вхід відхиляє Д3 COND, без старої істинності хоста.
; Умови й відповіді — справжній PredicateBit Д1 із Д3 ATOM,
; а не незв'язані символи так/ні звичайного Лісп-читача.
; Д4:0100 хибне? — чинний механізм СЕНС (NOT: точне заперечення D1).
; Історичне перевизначення незмінної канонічної функції вилучено.


; nth/member?/assoc уже виражаються наявними законами обходу списку,
; як довжина та обернення. Це не нові машинні примітиви.
; У дослідженні fpga-лісп від 10.08.2026 (assembler.лісп) три операції
; було незалежно повторено як nth, contains?/any-eq? і assoc-str:
; доведене дублювання, а не припущення про відсутню функцію.
; Узагальнений пошук за ключем відповідає локальному обходу
; асоціативного списку (символ . значення) у бібліотека/meta-eval.лісп.
; Д6:000100 NTH — індекс тільки явно кваліфікований Д24, відлік від нуля.
; Порожній хвіст / завеликий індекс повертає (); не викликаємо 000100 як число.
; D6:000100 NTH · kramāṅka. Тільки D3:() завершує хребет.
; Перевірка повного списку до повернення елемента.


; Правильний D3 список і невід'ємний цілий D12+ індекс.
; Числовий нуль належить D5 ZEROP, а не атомному D3 EQ.
(визначити елемент-списку-за-індексом-ядро
  (функція (індекс елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((нуль? індекс) (перше елементи))
      (так
       (елемент-списку-за-індексом-ядро
         (відняти індекс число-один)
         (решта елементи))))))

(визначити елемент-списку-за-індексом
  (функція (індекс елементи)
    (за-умовою
      ((підтвердити-д6-список елементи)
       (за-умовою
         ((ціле? індекс)
          (за-умовою
