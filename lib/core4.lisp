; PAIP SORT*: навмисно обмежена списками похідна функція СЕНС.
; Donor: juv4uk/paip-лісп@2db2ba99465cadef904e574b20b6981b32ad81df,
; лісп/auxfns.лісп. Повний інтерфейс історичного джерела для послідовностей і ключів ширший.
; Упорядкування приймає правильний список і точний предикат
; Д1 «передує». Елементи обробляємо зліва направо, нові
; ставимо після рівних ключів, зберігаючи сталий порядок.
; Це не прямий допуск дослідної Д10:0011001011 SORT*.

(визначити вставити-впорядковано-за
  (функція (перед? елемент упорядкований)
    (за-умовою
      ((порожній? упорядкований)
       (сполучити елемент (як-є ())))
      ((перед? елемент (перше упорядкований))
       (сполучити елемент упорядкований))
      (так
       (сполучити
         (перше упорядкований)
         (вставити-впорядковано-за перед? елемент (решта упорядкований)))))))

(визначити сортувати-список-за-крок
  (функція (перед? залишок упорядкований)
    (за-умовою
      ((порожній? залишок) упорядкований)
      (так
       (сортувати-список-за-крок
         перед?
         (решта залишок)
         (вставити-впорядковано-за перед? (перше залишок) упорядкований))))))

(визначити сортувати-список-за
  (функція (перед? елементи)
    (сортувати-список-за-крок перед? елементи (як-є ()))))

; Партія Д10 / CLIPS: чотири похідні визначення на стороні СЕНС.
; Донорські закони: бібліотека/clips-import.лісп — CLIPS-ASSERT-FORM?,
