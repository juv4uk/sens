; Yantra — повне українське джерело агента SENS.
; Виконання команд перевіряється лише за фактичними повідомленнями результатів.
; Відмова HTTP ніколи не стає успішним повідомленням моделі.
; Латинські рядки — зовнішній формат JSON, адреси та команди системи.
; Семантика, внутрішні ключі й виконувані виклики — українською.
; Значення чисел у людській проєкції — десяткові.

(визначити екранувати-знак-формат-обміну-даними
  (функція (знак)
    (за-умовою
      ((тотожне? знак "\"") "\\\"")
      ((тотожне? знак "\\") "\\\\")
      ((тотожне? знак "\n") "\\n")
      ((тотожне? знак "\r") "\\r")
      ((тотожне? знак "\t") "\\t")
      (так знак))))

(визначити екранувати-текст-накопиченням
  (функція (вхідний-текст накопичений-текст)
    (за-умовою
      ((рядок-порожній? вхідний-текст) накопичений-текст)
      (так (екранувати-текст-накопиченням (рядок-решта вхідний-текст)
                           (рядок-додати накопичений-текст (екранувати-знак-формат-обміну-даними (рядок-перший вхідний-текст))))))))

(визначити екранувати-формат-обміну-даними
  (функція (вхідний-текст) (екранувати-текст-накопиченням вхідний-текст "")))

(визначити з'єднати-текст-накопиченням
  (функція (частини-рядка накопичений-текст)
    (за-умовою
      
      ((атом? частини-рядка)  накопичений-текст)
      (так (з'єднати-текст-накопиченням (решта частини-рядка) (рядок-додати накопичений-текст (перше частини-рядка)))))))

(визначити з'єднати-частини-тексту
  (функція (частини-тексту)
    (з'єднати-текст-накопиченням частини-тексту "")))

(визначити кодувати-рядок-формат-обміну-даними
  (функція (рядок-для-кодування) (рядок-додати "\"" (рядок-додати (екранувати-формат-обміну-даними рядок-для-кодування) "\""))))

(визначити кодувати-ключ-формат-обміну-даними
  (функція (ключ-для-кодування)
    (за-умовою
      ((символ? ключ-для-кодування) (кодувати-рядок-формат-обміну-даними (символ-у-текст ключ-для-кодування)))
      (так (кодувати-рядок-формат-обміну-даними ключ-для-кодування)))))

(визначити об'єкт-формат-обміну-даними?
  (функція (перевірювана-структура)
    (за-умовою
      ((атом? перевірювана-структура) ні)
      ((атом? (перше перевірювана-структура)) ні)
      ((атом? (перше (перше перевірювана-структура))) так)
      (так ні))))

(визначити кодувати-значення-формат-обміну-даними
  (функція (значення-для-кодування)
    (за-умовою
      
      ((атом? значення-для-кодування)  (за-умовою
         ((тотожне? значення-для-кодування так) "true")
         ((тотожне? значення-для-кодування ні) "false")
         ((тотожне? значення-для-кодування (як-є ())) "null")
         ((класифікувати-рядкове-значення значення-для-кодування)
          
          (кодувати-рядок-формат-обміну-даними значення-для-кодування))
         (так (значення-у-текст значення-для-кодування))))
      ((об'єкт-формат-обміну-даними? значення-для-кодування) (кодувати-об'єкт-формат-обміну-даними значення-для-кодування))
      (так (кодувати-масив-формат-обміну-даними значення-для-кодування)))))

(визначити кодувати-записи-об'єкта-накопиченням
  (функція (записи-об'єкта накопичений-рядок)
    (за-умовою
      
      ((атом? записи-об'єкта)  накопичений-рядок)
      (так (нехай ((поточний-запис (перше записи-об'єкта)))
           (кодувати-записи-об'єкта-накопиченням
            (решта записи-об'єкта)
            (з'єднати-частини-тексту (список накопичений-рядок
                    (за-умовою ((рядок-порожній? накопичений-рядок) "")
                          (так ","))
                    (кодувати-ключ-формат-обміну-даними (перше поточний-запис))
                    ":"
                    (кодувати-значення-формат-обміну-даними (решта поточний-запис))))))))))

(визначити кодувати-об'єкт-формат-обміну-даними
  (функція (пари-об'єкта)
    (з'єднати-частини-тексту (список "{" (кодувати-записи-об'єкта-накопиченням пари-об'єкта "") "}"))))

(визначити кодувати-елементи-масиву-накопиченням
  (функція (елементи-масиву накопичений-рядок)
    (за-умовою
      
      ((атом? елементи-масиву)  накопичений-рядок)
      (так (кодувати-елементи-масиву-накопиченням
          (решта елементи-масиву)
          (з'єднати-частини-тексту (список накопичений-рядок
                  (за-умовою ((рядок-порожній? накопичений-рядок) "")
                        (так ","))
                  (кодувати-значення-формат-обміну-даними (перше елементи-масиву)))))))))

(визначити кодувати-масив-формат-обміну-даними
  (функція (елементи-масиву)
    (з'єднати-частини-тексту (список "[" (кодувати-елементи-масиву-накопиченням елементи-масиву "") "]"))))

(визначити знайти-значення-за-ключем
  (функція (ключ пари-списку)
    ((функція (знайдений-запис)
       (за-умовою
         ((порожній? знайдений-запис) (як-є ()))
         (так (решта знайдений-запис))))
     (знайти-за-ключем ключ пари-списку))))

(визначити роль-повідомлення (функція (повідомлення) (знайти-значення-за-ключем (як-є роль) повідомлення)))
(визначити зміст-повідомлення (функція (повідомлення) (знайти-значення-за-ключем (як-є зміст) повідомлення)))
(визначити виклики-повідомлення (функція (повідомлення) (знайти-значення-за-ключем (як-є виклики-інструментів) повідомлення)))
(визначити ідентифікатор-виклику-повідомлення (функція (повідомлення) (знайти-значення-за-ключем (як-є ідентифікатор-виклику) повідомлення)))

(визначити ідентифікатор-виклику (функція (виклик-інструмента) (знайти-значення-за-ключем (як-є ідентифікатор) виклик-інструмента)))
(визначити назва-інструмента (функція (виклик-інструмента) (знайти-значення-за-ключем (як-є назва) виклик-інструмента)))
(визначити аргументи-виклику (функція (виклик-інструмента) (знайти-значення-за-ключем (як-є аргументи) виклик-інструмента)))

(визначити зміст-повідомлення-формат-обміну-даними
  (функція (джерельне-повідомлення)
    ((функція (прочитаний-зміст)
      (за-умовою
        ((тотожне? прочитаний-зміст (як-є ())) "")
        (так прочитаний-зміст)))
     (знайти-значення-за-ключем "content" джерельне-повідомлення))))

(визначити виклик-інструмента-з-формат-обміну-даними
  (функція (джерельний-виклик)
    ((функція (опис-функції)
      (список (сполучити (як-є ідентифікатор) (знайти-значення-за-ключем "id" джерельний-виклик))
            (сполучити (як-є назва) (знайти-значення-за-ключем "name" опис-функції))
            (сполучити (як-є аргументи) (знайти-значення-за-ключем "arguments" опис-функції))))
     (знайти-значення-за-ключем "function" джерельний-виклик))))

(визначити повідомлення-з-формат-обміну-даними
  (функція (джерельне-повідомлення)
    ((функція (виклики-інструментів)
       (приєднати
         (список
           (сполучити (як-є роль) (знайти-значення-за-ключем "role" джерельне-повідомлення))
           (сполучити (як-є зміст)
             (зміст-повідомлення-формат-обміну-даними джерельне-повідомлення)))
         (за-умовою
           ((порожній? виклики-інструментів) (як-є ()))
           (так (список
             (сполучити (як-є виклики-інструментів)
               (відобразити виклик-інструмента-з-формат-обміну-даними
                 виклики-інструментів)))))))
     (знайти-значення-за-ключем "tool_calls" джерельне-повідомлення))))

(визначити витягти-відповідь-помічника
  (функція (одержана-відповідь)
    (нехай-послідовно ((варіанти-відповіді (знайти-значення-за-ключем "choices" одержана-відповідь))
           (перший-варіант (перше варіанти-відповіді)))
      (знайти-значення-за-ключем "message" перший-варіант))))

(визначити кодувати-виклик-інструмента
  (функція (виклик-інструмента)
    (список (сполучити "id" (ідентифікатор-виклику виклик-інструмента))
          (сполучити "type" "function")
          (сполучити "function" (список (сполучити "name" (назва-інструмента виклик-інструмента))
                                 (сполучити "arguments" (аргументи-виклику виклик-інструмента)))))))

(визначити кодувати-повідомлення
  (функція (повідомлення)
    (за-умовою
      ((однакові? (роль-повідомлення повідомлення) "tool")
       (список
         (сполучити "role" "tool")
         (сполучити "tool_call_id" (ідентифікатор-виклику-повідомлення повідомлення))
         (сполучити "content" (зміст-повідомлення повідомлення))))
      (так
       ((функція (виклики-інструментів)
          (приєднати
            (список
              (сполучити "role" (роль-повідомлення повідомлення))
              (сполучити "content" (зміст-повідомлення повідомлення)))
            (за-умовою
              ((порожній? виклики-інструментів) (як-є ()))
              (так
               (список
                 (сполучити "tool_calls"
                   (відобразити кодувати-виклик-інструмента
                     виклики-інструментів)))))))
        (виклики-повідомлення повідомлення))))))

(визначити схема-інструмента-команд
  (функція ()
    (список (сполучити "type" "function")
          (сполучити "function"
                (список (сполучити "name" "bash")
                      (сполучити "description" "Виконує одну команду bash і повертає об'єднаний стандартний вивід та вивід помилок.")
                      (сполучити "parameters"
                            (список (сполучити "type" "object")
                                  (сполучити "properties"
                                        (список (сполучити "cmd" (список (сполучити "type" "string")
                                                                (сполучити "description" "Команда bash, яку потрібно виконати")))))
                                  (сполучити "required" (список "cmd")))))))))

(визначити створити-тіло-запиту
  (функція (модель повідомлення)
    (кодувати-значення-формат-обміну-даними
      (список
        (сполучити "model" модель)
        (сполучити "messages" (відобразити кодувати-повідомлення повідомлення))
        (сполучити "tools" (список (схема-інструмента-команд)))))))

(визначити надіслати-запит-формат-обміну-даними
  (функція (адреса тіло)

    (нехай ((результат (процес-запустити "curl"
                               (список "-s" "-S" "--fail" "--show-error"
                                     "--max-time" "120"
                                     "-X" "POST"
                                     "-H" "Content-Type: application/json"
                                     "-d" тіло адреса))))
      (список (елемент-списку-за-індексом 0 результат) (елемент-списку-за-індексом 1 результат) (елемент-списку-за-індексом 2 результат)))))

(визначити код-завершення-передачі (функція (результат) (перше результат)))
(визначити тіло-передачі (функція (результат) (перше (решта результат))))
(визначити помилки-передачі (функція (результат) (перше (решта (решта результат)))))

(визначити виконати-команду
  (функція (аргументи-текстом)
    (нехай-послідовно ((розібрані-аргументи-виклику (формат-обміну-даними-розібрати аргументи-текстом))
           (команда (знайти-значення-за-ключем "cmd" розібрані-аргументи-виклику))
           (результат (процес-запустити "bash" (список "-c" команда)))
           (код-завершення (елемент-списку-за-індексом 0 результат))
           (стандартний-вивід (елемент-списку-за-індексом 1 результат))
           (помилки (елемент-списку-за-індексом 2 результат)))
      (з'єднати-частини-тексту (список "[exit-code " (число-рядок код-завершення)
              "]\n"
              стандартний-вивід
              (за-умовою ((рядок-порожній? помилки) "")
                    (так (з'єднати-частини-тексту (список "\n[stderr]\n" помилки)))))))))

(визначити спрямувати-виклик-інструмента
  (функція (назва аргументи-текстом)
    (за-умовою
      ((однакові? назва "bash") (виконати-команду аргументи-текстом))
      (так (рядок-додати "помилка: невідомий інструмент: " назва)))))

(визначити виконати-виклик-інструмента
  (функція (виклик)
    (спрямувати-виклик-інструмента (назва-інструмента виклик) (аргументи-виклику виклик))))

(визначити додати-результати-інструментів
  (функція (виклики накопичене)
    (за-умовою
      
      ((атом? виклики)  накопичене)
      (так (додати-результати-інструментів
          (решта виклики)
          (приєднати накопичене
                  (список (список (сполучити (як-є роль) "tool")
                              (сполучити (як-є ідентифікатор-виклику) (ідентифікатор-виклику (перше виклики)))
                              (сполучити (як-є зміст) (виконати-виклик-інструмента (перше виклики)))))))))))

(визначити маркери-тверджень-виконання
  (як-є ("ran " "executed" "command output" "output of the command" "виконав" "виконано")))

(визначити маркер-міститься?
  (функція (маркери текст)
    (за-умовою
      
      ((атом? маркери) ні)
      ((рядок-містить? (перше маркери) текст) так)
      (так (маркер-міститься? (решта маркери) текст)))))

(визначити стверджує-виконання?
  (функція (текст) (маркер-міститься? маркери-тверджень-виконання текст)))

(визначити є-результат-інструмента?
  (функція (повідомлення)
    (за-умовою
      
      ((атом? повідомлення) ні)
      ((однакові? (роль-повідомлення (перше повідомлення)) "tool") так)
      (так (є-результат-інструмента? (решта повідомлення))))))

(визначити ідентифікатори-викликів-повідомлення
  (функція (повідомлення) (відобразити ідентифікатор-виклику (виклики-повідомлення повідомлення))))

(визначити ідентифікатор-у-списку?
  (функція (ідентифікатор ідентифікатори)
    (за-умовою
      
      ((атом? ідентифікатори) ні)
      ((однакові? ідентифікатор (перше ідентифікатори)) так)
      (так (ідентифікатор-у-списку? ідентифікатор (решта ідентифікатори))))))

(визначити усі-ідентифікатори-покриті?
  (функція (ідентифікатори кандидати)
    (за-умовою
      ((атом? ідентифікатори) так)
      ((ідентифікатор-у-списку? (перше ідентифікатори) кандидати)
       (усі-ідентифікатори-покриті? (решта ідентифікатори) кандидати))
      (так ні))))

(визначити завершується-власними-результатами?
  (функція (повідомлення)
    (за-умовою
      
      ((атом? повідомлення) ні)
      (так (зібрати-результати-інструментів-назад
          (решта (зворот повідомлення))
          (як-є ()))))))

(визначити ідентифікатори-неповторні?
  (функція (ідентифікатори)
    (за-умовою
      ((порожній? ідентифікатори) так)
      ((ідентифікатор-у-списку?
         (перше ідентифікатори)
         (решта ідентифікатори)) ні)
      (так (ідентифікатори-неповторні? (решта ідентифікатори))))))

(визначити зібрати-результати-інструментів-назад
  (функція (повідомлення-назад ідентифікатори-результатів)
    (за-умовою
      ((атом? повідомлення-назад) ні)
      ((однакові? (роль-повідомлення (перше повідомлення-назад)) "tool")
       (зібрати-результати-інструментів-назад
         (решта повідомлення-назад)
         (сполучити
           (ідентифікатор-виклику-повідомлення (перше повідомлення-назад))
           ідентифікатори-результатів)))
      (так
       ((функція (повідомлення-виклику)
          (за-умовою
            ((хибне? (однакові? (роль-повідомлення повідомлення-виклику) "assistant")) ні)
            ((порожній? ідентифікатори-результатів) ні)
            ((порожній? (виклики-повідомлення повідомлення-виклику)) ні)
            ((хибне? (ідентифікатори-неповторні?
               (ідентифікатори-викликів-повідомлення повідомлення-виклику))) ні)
            ((хибне? (ідентифікатори-неповторні?
               ідентифікатори-результатів)) ні)
            ((усі-ідентифікатори-покриті?
               (ідентифікатори-викликів-повідомлення повідомлення-виклику)
               ідентифікатори-результатів)
             (усі-ідентифікатори-покриті?
               ідентифікатори-результатів
               (ідентифікатори-викликів-повідомлення повідомлення-виклику)))
            (так ні)))
        (перше повідомлення-назад))))))

(визначити припустима-завершальна-відповідь?
  (функція (повідомлення-помічника повідомлення)
    (за-умовою
      ((стверджує-виконання? (зміст-повідомлення повідомлення-помічника))
       (завершується-власними-результатами? повідомлення))
      (так так))))

(визначити настанови-після-бездоказової-відповіді
  (список (сполучити (як-є роль) "system")
        (сполучити (як-є зміст)
              "У попередній відповіді стверджувалося, що команду виконано, але в цій розмові немає результату інструмента bash. Текстове твердження не є доказом виконання. Справді викличте інструмент bash або дайте відповідь без заяви про виконання.")))

(визначити межа-кроків 6)

(визначити кількість-повідомлень-ролі
  (функція (роль повідомлення)
    (за-умовою
      
      ((атом? повідомлення)  0)
      ((однакові? (роль-повідомлення (перше повідомлення)) роль) (додати 1 (кількість-повідомлень-ролі роль (решта повідомлення))))
      (так (кількість-повідомлень-ролі роль (решта повідомлення))))))

(визначити заблокована-відповідь?
  (функція (відповідь)
    (за-умовою
      ((атом? відповідь) так)
      ((атом? (перше відповідь))
       (тотожне? (перше відповідь) (як-є заблоковано)))
      (так ні))))

(визначити цикл-агента
  (функція (завершити повідомлення крок)
    (за-умовою
      ((не-менше? крок межа-кроків)
       (список
         (сполучити (як-є стан) (як-є перевищено-межу-кроків))
         (сполучити (як-є крок) крок)
         (сполучити (як-є повідомлення) повідомлення)))
      (так
       ((функція (відповідь)
          (за-умовою
            ((заблокована-відповідь? відповідь)
             (список
               (сполучити (як-є стан) (як-є заблоковано))
               (сполучити (як-є деталь) відповідь)
               (сполучити (як-є крок) крок)
               (сполучити (як-є повідомлення) повідомлення)))
            (так
             ((функція (з-відповіддю)
                ((функція (виклики-інструментів)
                   (за-умовою
                     ((порожній? виклики-інструментів)
                      (за-умовою
                        ((припустима-завершальна-відповідь? відповідь з-відповіддю)
                         (список
                           (сполучити (як-є стан) (як-є завершено))
                           (сполучити (як-є епістемічний-стан) (як-є гіпотеза))
                           (сполучити (як-є відповідь) (зміст-повідомлення відповідь))
                           (сполучити (як-є крок) крок)
                           (сполучити (як-є повідомлення) з-відповіддю)))
                        (так
                         (цикл-агента завершити
                           (приєднати з-відповіддю (список настанови-після-бездоказової-відповіді))
                           (додати крок 1)))))
                     (так
                      (цикл-агента завершити
                        (приєднати з-відповіддю
                          (додати-результати-інструментів виклики-інструментів (як-є ())))
                        (додати крок 1)))))
                 (виклики-повідомлення відповідь)))
              (приєднати повідомлення (список відповідь))))))
        (завершити повідомлення))))))

(визначити запустити-агента
