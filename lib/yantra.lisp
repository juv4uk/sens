(визначити отримати-відповідь-моделі
  (функція (повідомлення)
    ((функція (транспортний-результат)
       (за-умовою
         ((однакові? (код-завершення-передачі транспортний-результат) 0)
          ((функція (одержане-повідомлення)
             (за-умовою
               ((порожній? одержане-повідомлення)
                (список (як-є заблоковано) "порожня відповідь помічника"))
               (так
                (повідомлення-з-формат-обміну-даними одержане-повідомлення))))
           (витягти-відповідь-помічника
             (формат-обміну-даними-розібрати
               (тіло-передачі транспортний-результат)))))
         (так
          (список
            (як-є заблоковано)
            (рядок-додати
              "код завершення curl: "
              (рядок-додати
                (число-рядок (код-завершення-передачі транспортний-результат))
                (за-умовою
                  ((рядок-порожній? (помилки-передачі транспортний-результат)) "")
                  (так
                    (рядок-додати "\n"
                      (помилки-передачі транспортний-результат)))))))))
     (надіслати-запит-формат-обміну-даними адреса-моделі
       (створити-тіло-запиту назва-моделі повідомлення))))))
