; Перемежування двох скінченних правильних списків без втрати хвоста.
; Вихід: л1 п1 л2 п2 ...; непарний залишок довшого списку зберігається.
; Жодних числових літералів чи зовнішніх обчислювачів: тільки СЕНС Д3 і Д4 і Д5.
; Д7 задає людські українські імена, Зіг і Т5М пакує фізичну програму.

(визначити перемежувати-два-списки
  (функція (ліві праві)
    (за-умовою
      ((порожній? ліві) праві)
      ((порожній? праві) ліві)
      (так
        (сполучити (перше ліві)
          (сполучити (перше праві)
            (перемежувати-два-списки (решта ліві) (решта праві))))))))

; Це виконувані закони Д1 і Д3, не статичні українські тексти.
; Невірний результат навмисно виконує перше від порожнього списку.
(за-умовою
  ((порожній? (перемежувати-два-списки (як-є ()) (як-є ()))) так)
  (так (перше (як-є ()))))

(за-умовою
  ((тотожне? (перше (перемежувати-два-списки
      (як-є ()) (список (як-є атом?)))) (як-є атом?)) так)
  (так (перше (як-є ()))))

(за-умовою
  ((тотожне? (перше (перемежувати-два-списки
      (список (як-є решта)) (як-є ()))) (як-є решта)) так)
  (так (перше (як-є ()))))

; Ліві (атом? решта), праві (сполучити тотожне?).
(визначити перевірний-перемежований
  (перемежувати-два-списки
    (список (як-є атом?) (як-є решта))
    (список (як-є сполучити) (як-є тотожне?))))

(за-умовою
  ((тотожне? (перше перевірний-перемежований) (як-є атом?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (друге перевірний-перемежований) (як-є сполучити)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (решта-решти перевірний-перемежований)) (як-є решта)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (друге (решта-решти перевірний-перемежований)) (як-є тотожне?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (решта-решти (решта-решти перевірний-перемежований))) так)
  (так (перше (як-є ()))))

; Праві довші: зайвий хвіст не губиться.
(визначити правий-залишок-перемежування
  (перемежувати-два-списки
    (список (як-є атом?))
    (список (як-є решта) (як-є сполучити) (як-є тотожне?))))
(за-умовою
  ((тотожне? (перше (решта-решти правий-залишок-перемежування))
              (як-є сполучити)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (друге (решта-решти правий-залишок-перемежування))
              (як-є тотожне?)) так)
  (так (перше (як-є ()))))

; Ліві довші: непарний лівий елемент не втрачається.
(за-умовою
  ((тотожне? (перше (решта-решти
      (перемежувати-два-списки
        (список (як-є атом?) (як-є решта)) (список (як-є сполучити)))))
      (як-є решта)) так)
  (так (перше (як-є ()))))

; Вкладена пара залишається парою, а не Д3 ЕК над неатомом.
(за-умовою
  ((хибне? (атом? (перше (перемежувати-два-списки
       (список (список (як-є атом?) (як-є решта)))
       (список (як-є сполучити)))))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (перше (перемежувати-два-списки
       (список (список (як-є атом?) (як-є решта)))
       (список (як-є сполучити))))) (як-є атом?)) так)
  (так (перше (як-є ()))))

; Негатив: вихідний порядок не є простим злиттям.
(за-умовою
  ((хибне? (тотожне? (друге перевірний-перемежований) (як-є решта))) так)
  (так (перше (як-є ()))))

(атом? (як-є ()))
