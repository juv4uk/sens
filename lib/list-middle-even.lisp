; СЕНС: середні два елементи правильного списку парної довжини (не менше 2).
; Два вказівники: швидкий просувається на дві пари пари,
; повільний - на одну. Закон випливає з Д3 перше, решта, пари і Д4 ЛІСТ.
; Лише власні визначення СЕНС; Зіг і Т5М не обчислює результат.
(визначити середня-пара-через-два-вказівники
  (функція (повільний швидкий)
    (за-умовою
      ((порожній? (решта (решта швидкий)))
        (список (перше повільний) (друге повільний)))
      ((атом? (як-є ()))
        (середня-пара-через-два-вказівники
          (решта повільний) (решта (решта швидкий)))))))

(визначити середня-пара-парного-списку
  (функція (елементи)
    (середня-пара-через-два-вказівники елементи елементи)))

(визначити пара-для-середини
  (середня-пара-парного-списку
    (список (як-є атом?) (як-є тотожне?))))
(визначити четвірка-для-середини
  (середня-пара-парного-списку
    (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?))))
(визначити шістка-для-середини
  (середня-пара-парного-списку
    (список (як-є атом?) (як-є тотожне?) (як-є решта)
            (як-є сполучити) (як-є порожній?) (як-є хибне?))))

; Три незалежні довжини, кожен позиційний позитив і два негативи.
; Успіх - точне Д1 так, жодних машинних тегів і хостових оракулів.

(за-умовою
  ((тотожне? (перше пара-для-середини) (як-є атом?))
    (за-умовою
      ((тотожне? (друге пара-для-середини) (як-є тотожне?))
        (за-умовою
          ((тотожне? (перше четвірка-для-середини) (як-є решта))
            (за-умовою
              ((тотожне? (друге четвірка-для-середини) (як-є сполучити))
                (за-умовою
                  ((тотожне? (перше шістка-для-середини) (як-є решта))
                    (за-умовою
                      ((тотожне? (друге шістка-для-середини) (як-є сполучити))
                        (за-умовою
                          ((хибне? (тотожне? (перше четвірка-для-середини) (як-є атом?)))
                            (за-умовою
                              ((хибне? (тотожне? (друге шістка-для-середини) (як-є порожній?)))
                                (атом? (як-є ())))
                              ((атом? (як-є ())) (перше (як-є ())))))
                          ((атом? (як-є ())) (перше (як-є ())))))
                      ((атом? (як-є ())) (перше (як-є ())))))
                  ((атом? (як-є ())) (перше (як-є ())))))
              ((атом? (як-є ())) (перше (як-є ())))))
          ((атом? (як-є ())) (перше (як-є ())))))
      ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
