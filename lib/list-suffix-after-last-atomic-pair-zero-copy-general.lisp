; СЕНС: повернути суфікс ПІСЛЯ останньої суміжної пари атомів.
; Один прохід, нуль пари у власне алгоритмі; повертається існуючий решта.
; Якщо пари немає, повертається вхідний список. () є структурним атомом Д3.
; Лише чинні українські Д1 і Д3 і Д5, без сід8 і сенс8 і зовнішнє-семантики.
(визначити суфікс-після-пари-атомів-хід
  (функція (залишок знайдений)
    (за-умовою
      ((атом? залишок) знайдений)
      ((порожній? (решта залишок)) знайдений)
      ((атом? (перше залишок))
       (за-умовою
         ((атом? (перше (решта залишок)))
          (суфікс-після-пари-атомів-хід
            (решта залишок) (решта (решта залишок))))
         (так (суфікс-після-пари-атомів-хід
                (решта залишок) знайдений))))
      (так (суфікс-після-пари-атомів-хід
             (решта залишок) знайдений)))))
(визначити суфікс-після-останньої-пари-атомів
  (функція (елементи)
    (суфікс-після-пари-атомів-хід елементи елементи)))

(визначити без-пари
  (список (список (як-є атом?)) (як-є решта)
          (список (як-є сполучити))))
(визначити з-одною-парою
  (список (список (як-є атом?)) (як-є решта)
          (як-є сполучити) (список (як-є функція))))
(визначити з-двома-парами
  (список (як-є атом?) (як-є решта) (список (як-є сполучити))
          (як-є функція) (як-є визначити) (список (як-є сполучити))))

; Нативні СЕНС-закони: неправильна гілка падає на перше порожнього.
(за-умовою
  ((порожній? (суфікс-після-останньої-пари-атомів (як-є ()))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (суфікс-після-останньої-пари-атомів
                       (список (як-є атом?)))) (як-є атом?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (суфікс-після-останньої-пари-атомів
                 (список (як-є атом?) (як-є решта)))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (суфікс-після-останньої-пари-атомів
                 (список (як-є атом?) (як-є решта)
                         (як-є сполучити)))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне? (атом? (перше (суфікс-після-останньої-пари-атомів
                            без-пари)))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (друге (суфікс-після-останньої-пари-атомів
                       без-пари)) (як-є решта)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (решта (суфікс-після-останньої-пари-атомів
                        з-одною-парою))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (решта (суфікс-після-останньої-пари-атомів
                        з-двома-парами))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне? (атом? (перше (суфікс-після-останньої-пари-атомів
                            з-двома-парами)))) так)
  (так (перше (як-є ()))))
; Атомарний вхід не має решта: гуард з Д3 мусить спрацювати раніше
; за перевірку наступного елемента. Обидва позитивні закони виконує СЕНС.
(за-умовою
  ((тотожне?
     (суфікс-після-останньої-пари-атомів (як-є атом?))
     (як-є атом?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне?
     (перше (суфікс-після-пари-атомів-хід
       (як-є атом?) (список (як-є сполучити))))
     (як-є сполучити)) так)
  (так (перше (як-є ()))))

; Негатив: відкидати не один атом, а саме останню сусідню пару.
(за-умовою
  ((хибне? (тотожне? (перше (суфікс-після-останньої-пари-атомів
                               (список (як-є атом?))))
                         (як-є решта))) так)
  (так (перше (як-є ()))))
(атом? (як-є ()))
