; СЕНС: чотири правильні списки, збереження порядку до найкоротшого.
; Рівно чотири СПОЛУЧИТИ на цикл, без проміжних списків чи хостової семантики.
; Д1-Д4 визначають закон, Зіг/Т5М тільки пакує й обернено відкриває слова.
(визначити переплести-чотири-до-найкоротшого
  (функція (перші другі треті четверті)
    (за-умовою
      ((порожній? перші) (як-є ()))
      ((порожній? другі) (як-є ()))
      ((порожній? треті) (як-є ()))
      ((порожній? четверті) (як-є ()))
      (так
        (сполучити (перше перші)
          (сполучити (перше другі)
            (сполучити (перше треті)
              (сполучити (перше четверті)
                (переплести-чотири-до-найкоротшого
                  (решта перші) (решта другі)
                  (решта треті) (решта четверті))))))))))

; Рівність вкладених структур через Д3, не ЕК над двома парами.
(визначити чотири-дерева-рівні?
  (функція (ліве праве)
    (за-умовою
      ((атом? ліве)
        (за-умовою
          ((атом? праве) (тотожне? ліве праве))
          (так ні)))
      ((атом? праве) ні)
      ((чотири-дерева-рівні? (перше ліве) (перше праве))
        (чотири-дерева-рівні? (решта ліве) (решта праве)))
      (так ні))))

; У разі хибного результату SENS виконує справжню помилку ПЕРШЕ(()). 
(визначити перевірити-переплетення-чотирьох
  (функція (перші другі треті четверті очікуване)
    (за-умовою
      ((чотири-дерева-рівні?
         (переплести-чотири-до-найкоротшого
           перші другі треті четверті)
         очікуване)
       так)
      (так (перше (як-є ()))))))
