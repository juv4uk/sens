; Найперший атом, який трапляється рівно один раз у всьому списку.
; Не плутати останнє входження з єдиним: атом-повтор уже відкинуто.
; Складені елементи пропускаються без виклику тотожне? на парі.
; Виконується сам СЕНС. Д7 передає назви, а не семантичні закони.

(визначити атом-у-списку-для-унікальності?
  (функція (шукане елементи)
    (за-умовою
      ((порожній? елементи) ні)
      ((хибне? (атом? (перше елементи)))
       (атом-у-списку-для-унікальності? шукане (решта елементи)))
      ((тотожне? шукане (перше елементи)) так)
      (так (атом-у-списку-для-унікальності? шукане (решта елементи))))))

(визначити перший-єдиний-атом-допомога
  (функція (елементи побачені)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((хибне? (атом? (перше елементи)))
       (перший-єдиний-атом-допомога (решта елементи) побачені))
      ((атом-у-списку-для-унікальності? (перше елементи) побачені)
       (перший-єдиний-атом-допомога (решта елементи) побачені))
      ((атом-у-списку-для-унікальності? (перше елементи) (решта елементи))
       (перший-єдиний-атом-допомога
         (решта елементи)
         (сполучити (перше елементи) побачені)))
      (так (перше елементи)))))

(визначити перший-глобально-єдиний-атом
  (функція (елементи)
    (перший-єдиний-атом-допомога елементи (як-є ()))))

; Кожний закон виконує результат у СЕНС; помилка викликає перше від порожнечі.

; Порожня послідовність не має розв'язку
(за-умовою
  ((порожній? (перший-глобально-єдиний-атом (як-є ()))) (атом? (як-є ())))
  (так (перше (як-є ()))))

; Єдиний атом повертається
(за-умовою
  ((тотожне? (перший-глобально-єдиний-атом (список (як-є атом?))) (як-є атом?)) (атом? (як-є ())))
  (так (перше (як-є ()))))

; Два різні атоми дають перший
(за-умовою
  ((тотожне? (перший-глобально-єдиний-атом (список (як-є атом?) (як-є решта))) (як-є атом?)) (атом? (як-є ())))
  (так (перше (як-є ()))))

; Три різні атоми дають перший
(за-умовою
  ((тотожне? (перший-глобально-єдиний-атом (список (як-є атом?) (як-є решта) (як-є сполучити))) (як-є атом?)) (атом? (як-є ())))
  (так (перше (як-є ()))))

; Повтор двічі не є єдиним
(за-умовою
  ((порожній? (перший-глобально-єдиний-атом (список (як-є атом?) (як-є атом?)))) (атом? (як-є ())))
  (так (перше (як-є ()))))

; Повтор після іншого залишає єдиний середній
(за-умовою
  ((тотожне? (перший-глобально-єдиний-атом (список (як-є атом?) (як-є решта) (як-є атом?))) (як-є решта)) (атом? (як-є ())))
  (так (перше (як-є ()))))

; Повтори двох атомів не дають хибно останню появу
(за-умовою
  ((порожній? (перший-глобально-єдиний-атом (список (як-є атом?) (як-є решта) (як-є атом?) (як-є решта)))) (атом? (як-є ())))
  (так (перше (як-є ()))))

; Серед двох повторених атомів знайти третій
(за-умовою
  ((тотожне? (перший-глобально-єдиний-атом (список (як-є атом?) (як-є решта) (як-є атом?) (як-є решта) (як-є сполучити))) (як-є сполучити)) (атом? (як-є ())))
  (так (перше (як-є ()))))

; Зустріч справа не повинна повертати раніше повторені
(за-умовою
  ((тотожне? (перший-глобально-єдиний-атом (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є решта) (як-є атом?))) (як-є сполучити)) (атом? (як-є ())))
  (так (перше (як-є ()))))

; Атом перший, вкладений список другий
(за-умовою
  ((тотожне? (перший-глобально-єдиний-атом (список (як-є атом?) (список (як-є решта)))) (як-є атом?)) (атом? (як-є ())))
  (так (перше (як-є ()))))

; Вкладений список перед єдиним атомом
(за-умовою
  ((тотожне? (перший-глобально-єдиний-атом (список (список (як-є атом?)) (як-є решта))) (як-є решта)) (атом? (як-є ())))
  (так (перше (як-є ()))))

; Повтори із вкладеним списком не означають єдиності
(за-умовою
  ((порожній? (перший-глобально-єдиний-атом (список (як-є атом?) (список (як-є решта)) (як-є атом?)))) (атом? (як-є ())))
  (так (перше (як-є ()))))

; Один унікальний перед повтором
(за-умовою
  ((тотожне? (перший-глобально-єдиний-атом (список (як-є атом?) (як-є решта) (як-є решта) (як-є сполучити) (як-є сполучити))) (як-є атом?)) (атом? (як-є ())))
  (так (перше (як-є ()))))

; Один унікальний після повторів
(за-умовою
  ((тотожне? (перший-глобально-єдиний-атом (список (як-є атом?) (як-є атом?) (як-є решта) (як-є решта) (як-є сполучити))) (як-є сполучити)) (атом? (як-є ())))
  (так (перше (як-є ()))))

; Перший з двох унікальних після повтору
(за-умовою
  ((тотожне? (перший-глобально-єдиний-атом (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є атом?))) (як-є решта)) (атом? (як-є ())))
  (так (перше (як-є ()))))

; Негативний свідок без результату у тричленному повторі
(за-умовою
  ((порожній? (перший-глобально-єдиний-атом (список (як-є сполучити) (як-є сполучити) (як-є сполучити)))) (атом? (як-є ())))
  (так (перше (як-є ()))))

; Четвертий атом з'являється лише раз
(за-умовою
  ((тотожне? (перший-глобально-єдиний-атом (список (як-є атом?) (як-є решта) (як-є атом?) (як-є решта) (як-є тотожне?))) (як-є тотожне?)) (атом? (як-є ())))
  (так (перше (як-є ()))))
