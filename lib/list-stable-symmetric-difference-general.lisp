; Д3/Д5: стабільна симетрична різниця двох списків точних атомів.
; Зліва лишаються тільки атоми, яких немає справа, потім навпаки.
; Відносний порядок і повтори зберігаються; D7 є людською проєкцією.
(визначити належить-для-симетрії?
  (функція (шукане елементи)
    (за-умовою
      ((атом? елементи) ні)
      ((тотожне? шукане (перше елементи)) так)
      ((атом? (як-є ()))
       (належить-для-симетрії? шукане (решта елементи))))))

(визначити лише-один-бік
  (функція (елементи інші)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((належить-для-симетрії? (перше елементи) інші)
       (лише-один-бік (решта елементи) інші))
      ((атом? (як-є ()))
       (сполучити (перше елементи)
         (лише-один-бік (решта елементи) інші))))))

(визначити приєднати-для-симетрії
  (функція (ліві праві)
    (за-умовою
      ((атом? ліві) праві)
      ((атом? (як-є ()))
       (сполучити (перше ліві)
         (приєднати-для-симетрії (решта ліві) праві))))))

(визначити симетрична-різниця-атомів
  (функція (ліві праві)
    (за-умовою
      ; Якщо один бік порожній, віддаємо інший без нового списку.
      ((атом? ліві) праві)
      ((атом? праві) ліві)
      ((атом? (як-є ()))
       (приєднати-для-симетрії
         (лише-один-бік ліві праві)
         (лише-один-бік праві ліві))))))

(визначити лівий-вхід-симетрії
  (список (як-є атом?) (як-є решта) (як-є атом?)
          (як-є сполучити) (як-є тотожне?) (як-є решта)))
(визначити правий-вхід-симетрії
  (список (як-є решта) (як-є як-є) (як-є перше)))
(визначити результат-симетрії
  (симетрична-різниця-атомів лівий-вхід-симетрії правий-вхід-симетрії))
(визначити результат-навпаки
  (симетрична-різниця-атомів правий-вхід-симетрії лівий-вхід-симетрії))
(визначити лівий-порожній
  (симетрична-різниця-атомів (як-є ()) правий-вхід-симетрії))
(визначити правий-порожній
  (симетрична-різниця-атомів лівий-вхід-симетрії (як-є ())))

