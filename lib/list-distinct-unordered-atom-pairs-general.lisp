; ОПТИМІЗАЦІЙНИЙ КОНКУРС - різні невпорядковані пари атомних значень.
; Порядок - перша поява: (а б а в) дає ((а б) (а в) (б в)).
; Без зайвого перерахування позицій: спершу лише к унікальних атомів;
; потім к(к-1) поділити на 2 потрібних пар. Для ндаєдаєк економимо створення пари.
; Семантика тільки СЕНС Д3 і Д4 і Д5. Д7 - проєкція символів, Зіг - Т5М.

(визначити атом-є-серед-унікальних?
  (функція (шукане бачені)
    (за-умовою
      ((порожній? бачені) ні)
      ((тотожне? шукане (перше бачені)) так)
      (так (атом-є-серед-унікальних? шукане (решта бачені))))))

(визначити лише-перші-різні-атоми
  (функція (елементи бачені)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((порожній? (перше елементи))
       (лише-перші-різні-атоми (решта елементи) бачені))
      ((хибне? (атом? (перше елементи)))
       (лише-перші-різні-атоми (решта елементи) бачені))
      ((атом-є-серед-унікальних? (перше елементи) бачені)
       (лише-перші-різні-атоми (решта елементи) бачені))
      (так
       (сполучити
         (перше елементи)
         (лише-перші-різні-атоми
           (решта елементи) (сполучити (перше елементи) бачені)))))))

; Формування без АППЕНД: суфікс результату передається від зовнішнього проходу.
(визначити пари-першого-у-суфікс
  (функція (перший решта-значень результат)
    (за-умовою
      ((порожній? решта-значень) результат)
      (так
       (сполучити
         (список перший (перше решта-значень))
         (пари-першого-у-суфікс
           перший (решта решта-значень) результат))))))

(визначити пари-з-унікальних-атомів
  (функція (унікальні)
    (за-умовою
      ((порожній? унікальні) (як-є ()))
      (так
       (пари-першого-у-суфікс
         (перше унікальні) (решта унікальні)
         (пари-з-унікальних-атомів (решта унікальні)))))))

(визначити усі-різні-неупорядковані-пари-атомів
  (функція (елементи)
    (пари-з-унікальних-атомів
      (лише-перші-різні-атоми елементи (як-є ())))))

(визначити рівні-пари-різних-атомів?
  (функція (ліве праве)
    (за-умовою
      ((порожній? ліве) (порожній? праве))
      ((порожній? праве) ні)
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (тотожне? ліве праве))
         (так ні)))
      ((атом? праве) ні)
      ((рівні-пари-різних-атомів? (перше ліве) (перше праве))
       (рівні-пари-різних-атомів? (решта ліве) (решта праве)))
      (так ні))))

