; Д3 і Д4: усі початкові та кінцеві відрізки власного скінченного списку.
; Префікси впорядковані від порожнього до повного,
; суфікси впорядковані від повного до порожнього.
; Порожній список має один префікс та один суфікс: сам порожній.
; Лише виконувані українські СЕНС-функції, жодного нового код операції.

(визначити всі-суфікси-списку
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (список (як-є ())))
      ((атом? (як-є ()))
       (сполучити елементи
         (всі-суфікси-списку (решта елементи)))))))

(визначити префікси-накопиченням
  (функція (залишок накопичений)
    (за-умовою
      ((порожній? залишок) (список накопичений))
      ((атом? (як-є ()))
       (сполучити накопичений
         (префікси-накопиченням
           (решта залишок)
           (приєднати накопичений (список (перше залишок)))))))))

(визначити всі-префікси-списку
  (функція (елементи)
    (префікси-накопиченням елементи (як-є ()))))

(визначити початкова-четвірка
  (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?)))
(визначити усі-суфікси-четвірки (всі-суфікси-списку початкова-четвірка))
(визначити усі-префікси-четвірки (всі-префікси-списку початкова-четвірка))

; Живі свідки: 4 суфіксні голови, 4 префіксні кінці,
; дві порожні крайові секції, дві точні довжини,
; два порожні базиси, два одноелементні, один негатив.
(за-умовою
  ((тотожне? (перше (перше усі-суфікси-четвірки)) (як-є атом?))
   (за-умовою
     ((тотожне? (перше (перше (решта усі-суфікси-четвірки))) (як-є решта))
