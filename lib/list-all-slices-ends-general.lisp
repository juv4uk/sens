        ((тотожне? (перше (перше (решта (решта усі-суфікси-четвірки)))) (як-є сполучити))
         (за-умовою
           ((тотожне? (перше (перше (решта (решта (решта усі-суфікси-четвірки))))) (як-є тотожне?))
            (за-умовою
              ((тотожне? (перше (перше (решта усі-префікси-четвірки))) (як-є атом?))
               (за-умовою
                 ((тотожне? (перше (решта (перше (решта (решта усі-префікси-четвірки))))) (як-є решта))
                  (за-умовою
                    ((тотожне? (перше (решта (решта (перше (решта (решта (решта усі-префікси-четвірки))))))) (як-є сполучити))
                     (за-умовою
                       ((тотожне? (перше (решта (решта (решта (перше (решта (решта (решта (решта усі-префікси-четвірки))))))))) (як-є тотожне?))
                        (за-умовою
                          ((порожній? (перше (решта (решта (решта (решта усі-суфікси-четвірки))))))
                           (за-умовою
                             ((порожній? (перше усі-префікси-четвірки))
                              (за-умовою
                                ((порожній? (решта (решта (решта (решта (решта усі-суфікси-четвірки))))))
                                 (за-умовою
                                   ((порожній? (решта (решта (решта (решта (решта усі-префікси-четвірки))))))
                                    (за-умовою
                                      ((порожній? (перше (всі-префікси-списку (як-є ()))))
                                       (за-умовою
                                         ((порожній? (перше (всі-суфікси-списку (як-є ()))))
                                          (за-умовою
                                            ((тотожне? (перше (перше (решта (всі-префікси-списку (список (як-є атом?)))))) (як-є атом?))
                                             (за-умовою
                                               ((тотожне? (перше (перше (всі-суфікси-списку (список (як-є атом?))))) (як-є атом?))
                                                (за-умовою
                                                  ((хибне? (тотожне? (перше (перше (решта усі-суфікси-четвірки))) (як-є атом?)))
                                                   (атом? (як-є ())))
