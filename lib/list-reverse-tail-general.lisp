; Лінійне обернення скінченного правильного списку в СЕНС.
; Один прохід, один накопичувач, без дописування в кінець і чисел.
; Кожний елемент зберігає свою структуру, включно з порожнім списком.
; Д3 і Д5 виконують закон, Зіґ пакує лише фізичні слова Т5М.

(визначити обернути-залишок
  (функція (залишок накопичене)
    (за-умовою
      ((порожній? залишок) накопичене)
      (так
        (обернути-залишок
          (решта залишок)
          (сполучити (перше залишок) накопичене))))))

(визначити обернути-список
  (функція (елементи)
    (обернути-залишок елементи (як-є ()))))

(визначити початкова-трійка
  (список (як-є атом?) (як-є решта) (як-є сполучити)))
(визначити обернена-трійка (обернути-список початкова-трійка))
(визначити відновлена-трійка (обернути-список обернена-трійка))

; Справжнє виконання перевірок. Хибний закон викликає перше від порожнього.
(за-умовою
  ((порожній? (обернути-список (як-є ()))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше обернена-трійка) (як-є сполучити)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (друге обернена-трійка) (як-є решта)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (решта-решти обернена-трійка)) (як-є атом?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (решта (решта-решти обернена-трійка))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше відновлена-трійка) (як-є атом?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (друге відновлена-трійка) (як-є решта)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (решта-решти відновлена-трійка)) (як-є сполучити)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (обернути-список (список (як-є атом?))))
               (як-є атом?)) так)
  (так (перше (як-є ()))))

; Вкладена пара не сплющується, порожній елемент не губиться.
(визначити змішаний
  (обернути-список
    (список (як-є атом?) (список (як-є решта)) (як-є ()))))
(за-умовою
  ((порожній? (перше змішаний)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне? (атом? (друге змішаний))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (друге змішаний)) (як-є решта)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (решта-решти змішаний)) (як-є атом?)) так)
  (так (перше (як-є ()))))

; Негатив: обернений список не може лишатися у вихідному порядку.
(за-умовою
  ((хибне? (тотожне? (перше обернена-трійка) (як-є атом?))) так)
  (так (перше (як-є ()))))

(атом? (як-є ()))
