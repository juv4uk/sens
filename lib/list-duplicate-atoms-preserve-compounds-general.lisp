; СЕНС Д3 і Д5: подвоїти тільки атомні ЕЛЕМЕНТИ власного правильного списку.
; Складений елемент не сплощується і не дублюється; порожній () - атом Д3.
; Час О(н), вихідні пари рівно за кількістю вихідних елементів.
; Семантика лише в СЕНС; Д7 - поверхня, Зіг - Т5М, без пітон і джейсон.

(визначити подвоїти-лише-атоми
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((атом? (перше елементи))
       (сполучити (перше елементи)
         (сполучити (перше елементи)
           (подвоїти-лише-атоми (решта елементи)))))
      (так
       (сполучити (перше елементи)
         (подвоїти-лише-атоми (решта елементи)))))))

(визначити зразок-подвоєних-атомів
  (подвоїти-лише-атоми
    (список (як-є атом?) (список (як-є решта))
            (як-є сполучити) (як-є ()))))

; Справжні Д1 свідки: хибний закон виконує перше від порожній і падає.

; порожній-вхід
(за-умовою
  ((порожній? (подвоїти-лише-атоми (як-є ()))) так)
  (так (перше (як-є ()))))

; один-атом-перший
(за-умовою
  ((тотожне? (перше (подвоїти-лише-атоми (список (як-є атом?)))) (як-є атом?)) так)
  (так (перше (як-є ()))))

; один-атом-другий
(за-умовою
  ((тотожне? (друге (подвоїти-лише-атоми (список (як-є атом?)))) (як-є атом?)) так)
  (так (перше (як-є ()))))

; один-атом-довжина-два
(за-умовою
  ((порожній? (решта-решти (подвоїти-лише-атоми (список (як-є атом?))))) так)
  (так (перше (як-є ()))))

; одна-пара-зберегти
(за-умовою
  ((хибне? (атом? (перше (подвоїти-лише-атоми (список (список (як-є решта))))))) так)
  (так (перше (як-є ()))))

; одна-пара-елемент
(за-умовою
  ((тотожне? (перше (перше (подвоїти-лише-атоми (список (список (як-є решта)))))) (як-є решта)) так)
  (так (перше (як-є ()))))

; одна-пара-довжина-один
(за-умовою
  ((порожній? (решта (подвоїти-лише-атоми (список (список (як-є решта)))))) так)
  (так (перше (як-є ()))))

; атом-один
(за-умовою
  ((тотожне? (перше зразок-подвоєних-атомів) (як-є атом?)) так)
  (так (перше (як-є ()))))

; атом-два
(за-умовою
  ((тотожне? (перше (решта зразок-подвоєних-атомів)) (як-є атом?)) так)
  (так (перше (як-є ()))))

; вкладена-пара
(за-умовою
  ((хибне? (атом? (перше (решта (решта зразок-подвоєних-атомів))))) так)
  (так (перше (як-є ()))))

; вкладений-вміст
(за-умовою
  ((тотожне? (перше (перше (решта (решта зразок-подвоєних-атомів)))) (як-є решта)) так)
  (так (перше (як-є ()))))

; перша-копія-сполучити
(за-умовою
  ((тотожне? (перше (решта (решта (решта зразок-подвоєних-атомів)))) (як-є сполучити)) так)
  (так (перше (як-є ()))))

; друга-копія-сполучити
(за-умовою
  ((тотожне? (перше (решта (решта (решта (решта зразок-подвоєних-атомів))))) (як-є сполучити)) так)
  (так (перше (як-є ()))))

; перший-порожній-атом
(за-умовою
  ((порожній? (перше (решта (решта (решта (решта (решта зразок-подвоєних-атомів))))))) так)
  (так (перше (як-є ()))))

; другий-порожній-атом
(за-умовою
  ((порожній? (перше (решта (решта (решта (решта (решта (решта зразок-подвоєних-атомів)))))))) так)
  (так (перше (як-є ()))))

; жодного-зайвого
(за-умовою
  ((порожній? (решта (решта (решта (решта (решта (решта (решта зразок-подвоєних-атомів)))))))) так)
  (так (перше (як-є ()))))

; не-дублювати-вкладену
(за-умовою
  ((хибне? (тотожне? (перше (решта (решта (решта зразок-подвоєних-атомів)))) (як-є решта))) так)
  (так (перше (як-є ()))))

; не-плутати-атоми
(за-умовою
  ((хибне? (тотожне? (перше (решта зразок-подвоєних-атомів)) (як-є сполучити))) так)
  (так (перше (як-є ()))))

; Фінальний натіве СЕНС орасле.
(атом? (як-є ()))
