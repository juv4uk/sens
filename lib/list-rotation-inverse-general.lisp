; Нативне Д3 і Д4 взаємно обернене циклічне обертання списку довільної довжини.
; Вхід - скінченний власний список, порожній та одиничний обробляються.
; Правий зсув визначено композицією списку, а не новим зовнішнє код операції.
; Д1:1 лише за істинних СЕНС-свідків, а не зовнішнє боол.

(визначити кінцевий-елемент-для-обертання
  (функція (елементи)
    (за-умовою
      ((порожній? (решта елементи)) (перше елементи))
      ((атом? (як-є ())) (кінцевий-елемент-для-обертання (решта елементи))))))

(визначити без-кінцевого-для-обертання
  (функція (елементи)
    (за-умовою
      ((порожній? (решта елементи)) (як-є ()))
      ((атом? (як-є ()))
       (сполучити (перше елементи)
         (без-кінцевого-для-обертання (решта елементи)))))))

(визначити обернути-ліворуч-на-один
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((атом? (як-є ()))
       (приєднати (решта елементи) (список (перше елементи)))))))

(визначити обернути-праворуч-на-один
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (кінцевий-елемент-для-обертання елементи)
         (без-кінцевого-для-обертання елементи))))))

(визначити початкова-п'ятірка (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є порожній?) (як-є тотожне?)))
(визначити повернена-вліво (обернути-ліворуч-на-один початкова-п'ятірка))
(визначити повернена-вправо (обернути-праворуч-на-один початкова-п'ятірка))
(визначити відновлена-після-лівого (обернути-праворуч-на-один повернена-вліво))
(визначити відновлена-після-правого (обернути-ліворуч-на-один повернена-вправо))

; 20 позиційних позитивів, 4 крайові базиси, один негативний порядок.
(за-умовою
  ((тотожне? (перше повернена-вліво) (як-є решта))
   (за-умовою
     ((тотожне? (перше (решта повернена-вліво)) (як-є сполучити))
      (за-умовою
        ((тотожне? (перше (решта (решта повернена-вліво))) (як-є порожній?))
         (за-умовою
           ((тотожне? (перше (решта (решта (решта повернена-вліво)))) (як-є тотожне?))
            (за-умовою
              ((тотожне? (перше (решта (решта (решта (решта повернена-вліво))))) (як-є атом?))
               (за-умовою
                 ((тотожне? (перше повернена-вправо) (як-є тотожне?))
                  (за-умовою
                    ((тотожне? (перше (решта повернена-вправо)) (як-є атом?))
                     (за-умовою
                       ((тотожне? (перше (решта (решта повернена-вправо))) (як-є решта))
                        (за-умовою
                          ((тотожне? (перше (решта (решта (решта повернена-вправо)))) (як-є сполучити))
                           (за-умовою
                             ((тотожне? (перше (решта (решта (решта (решта повернена-вправо))))) (як-є порожній?))
                              (за-умовою
                                ((тотожне? (перше відновлена-після-лівого) (як-є атом?))
                                 (за-умовою
                                   ((тотожне? (перше (решта відновлена-після-лівого)) (як-є решта))
                                    (за-умовою
                                      ((тотожне? (перше (решта (решта відновлена-після-лівого))) (як-є сполучити))
                                       (за-умовою
                                         ((тотожне? (перше (решта (решта (решта відновлена-після-лівого)))) (як-є порожній?))
                                          (за-умовою
                                            ((тотожне? (перше (решта (решта (решта (решта відновлена-після-лівого))))) (як-є тотожне?))
                                             (за-умовою
                                               ((тотожне? (перше відновлена-після-правого) (як-є атом?))
                                                (за-умовою
                                                  ((тотожне? (перше (решта відновлена-після-правого)) (як-є решта))
                                                   (за-умовою
                                                     ((тотожне? (перше (решта (решта відновлена-після-правого))) (як-є сполучити))
                                                      (за-умовою
                                                        ((тотожне? (перше (решта (решта (решта відновлена-після-правого)))) (як-є порожній?))
                                                         (за-умовою
                                                           ((тотожне? (перше (решта (решта (решта (решта відновлена-після-правого))))) (як-є тотожне?))
                                                            (за-умовою
                                                              ((порожній? (обернути-ліворуч-на-один (як-є ())))
                                                               (за-умовою
                                                                 ((порожній? (обернути-праворуч-на-один (як-є ())))
                                                                  (за-умовою
                                                                    ((тотожне? (перше (обернути-ліворуч-на-один (список (як-є атом?)))) (як-є атом?))
                                                                     (за-умовою
                                                                       ((тотожне? (перше (обернути-праворуч-на-один (список (як-є атом?)))) (як-є атом?))
                                                                        (за-умовою
                                                                          ((хибне? (тотожне? (перше повернена-вліво) (як-є атом?)))
                                                                           (атом? (як-є ())))
                                                                          ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
