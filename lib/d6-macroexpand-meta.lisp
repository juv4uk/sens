; Д6:000110 (vistāra-rūpa-prasāra-eka) і Д6:000111
; (vistāra-rūpa-prasāra): мовна реалізація на базі meta-eval.
; Попередньо завантажити lib/meta-eval.lisp та його SENS-залежності.
; Результат кроку: (успіх . (D1-змінено . форма)) або (невдача . помилка).
; Повний результат: (успіх . форма) або (невдача . помилка).
; Цей код НЕ ратифікує нові координати і НЕ доводить прямої
; машинної викличності D6 без фізичного SENS/Zig/T5M свідка.
; Усі оператори макросів шукаються в чинному ЛЕКСИЧНОМУ оточенні,
; а не в статичній таблиці і не у Rust.
; Аргументи передаються макросу як сирі форми, без передчасного eval.
;
; Зберігаємо невідомі, звичайні та спеціальні форми без виконання.
(визначити д6-розгортання-без-зміни
  (функція (форма)
    (власний-результат-успіх (сполучити ні форма))))

; Наслідок наявного SENS macro apply вже містить успіх або помилку.
; Не виконувати розгорнуту форму: це завдання наступного eval.
(визначити д6-розгортання-від-наслідку
  (функція (наслідок)
    (за-умовою
      ((це-результат-невдалого-обчислення? наслідок) наслідок)
      (так
       (власний-результат-успіх
         (сполучити так (решта наслідок)))))))

(визначити д6-розгортання-від-цілі
  (функція (форма оточення ціль)
    (за-умовою
      ((хибне? (це-макрос? ціль))
       (д6-розгортання-без-зміни форма))
      ((хибне?
         (арність-відповідає-аргументам? (друге ціль) (решта форма)))
       (власний-результат-невдача
         (помилка-арності-мета (друге ціль) (решта форма))))
      (так
       (д6-розгортання-від-наслідку
         (застосувати-функцію-з-наслідком
           ціль (решта форма) оточення))))))

; Один крок розгортає тільки макрос у голові виклику.
; Тіло цитати, спеціальну форму та підвирази не чіпаємо.
; Канонічну спеціальну форму не можна затінити макросом.
(визначити розгорнути-макрос-1
  (функція (форма оточення)
    (за-умовою
      ((атом? форма) (д6-розгортання-без-зміни форма))
      ((порожній? форма) (д6-розгортання-без-зміни форма))
      ((хибне? (атом? (перше форма)))
       (д6-розгортання-без-зміни форма))
      ((канонічне-ім'я-форми? (перше форма))
       (д6-розгортання-без-зміни форма))
      ((хибне?
         (ім'я-визначене-в-оточенні? (перше форма) оточення))
       (д6-розгортання-без-зміни форма))
      (так
       (д6-розгортання-від-цілі
         форма оточення
         (знайти-значення-імені-в-лексичному-середовищі
           (перше форма) оточення))))))

; Кожна відвідана ФОРМА зберігається без числа кроків та D24-лічильника.
; Повтор форми — структурний цикл; завершитися мовчки тут не можна.
(визначити д6-форма-була-раніше?
  (функція (форма історія)
    (за-умовою
      ((порожній? історія) ні)
      ((однакові? форма (перше історія)) так)
      (так (д6-форма-була-раніше?
             форма (решта історія))))))

(визначити д6-розгортання-до-стабільності-від-наслідку
  (функція (наслідок оточення історія)
    (за-умовою
      ((це-результат-невдалого-обчислення? наслідок) наслідок)
      ((хибне? (перше (решта наслідок)))
       (власний-результат-успіх (решта (решта наслідок))))
      (так
       (д6-розгортання-до-стабільності-ядро
         (решта (решта наслідок)) оточення історія)))))

(визначити д6-розгортання-до-стабільності-ядро
  (функція (форма оточення історія)
    (за-умовою
      ((д6-форма-була-раніше? форма історія)
       (власний-результат-невдача
         (створити-структуровану-помилку
           (як-є macro-expansion-cycle) форма)))
      (так
       (д6-розгортання-до-стабільності-від-наслідку
         (розгорнути-макрос-1 форма оточення)
         оточення
         (сполучити форма історія))))))

; Повторюємо лише головне розгортання. Цикл із двох і більше
; макросів закінчується структурованою помилкою, а не зависанням.
(визначити розгорнути-макрос
  (функція (форма оточення)
    (д6-розгортання-до-стабільності-ядро
      форма оточення (як-є ()))))
