; СЕНС Д3-Д5: знайти найпершу серію з принаймні н сусідніх атомних елементів.
; Повертає ПОЧАТОК цієї серії як наявний суфікс, без жодного нового пари.
; Роздільник - непорожня складена пара; структурне () є атомним елементом.
; Один прохід О(ленгтг), лічильник - лише ратифікована математика Д24+.
; нульова потреба повертає джерело; від'ємне значення відхиляє справжній виконавець СЕНС.

(визначити серія-число-нуль (довжина (як-є ())))
(визначити серія-число-один (довжина (як-є (а))))
(визначити серія-число-два (довжина (як-є (а б))))
(визначити серія-число-три (довжина (як-є (а б в))))

(визначити шукати-серію-атомів-довжини
 (функція (залишок суфікс-серії-атомів треба ціль)
  (за-умовою
   ((нуль? треба) суфікс-серії-атомів)
   ((атом? залишок) (як-є ()))
   ((атом? (перше залишок))
    (за-умовою
     ((порожній? суфікс-серії-атомів)
      (шукати-серію-атомів-довжини
       (решта залишок) залишок (відняти треба серія-число-один) ціль))
     (так
      (шукати-серію-атомів-довжини
       (решта залишок) суфікс-серії-атомів (відняти треба серія-число-один) ціль))))
   (так
    (шукати-серію-атомів-довжини
     (решта залишок) (як-є ()) ціль ціль)))))

(визначити перша-серія-атомів-щонайменше
 (функція (елементи мінімум)
  (за-умовою
   ((менше? мінімум серія-число-нуль) (перше (як-є ())))
   ((нуль? мінімум) елементи)
   (так
    (шукати-серію-атомів-довжини
     елементи (як-є ()) мінімум мінімум)))))

; Структурна рівність означена виключно ратифікованими функціями Д3.
(визначити дерева-серій-рівні?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((дерева-серій-рівні? (перше ліве) (перше праве))
    (дерева-серій-рівні? (решта ліве) (решта праве)))
   (так ні))))

(визначити довести-серію-атомів
 (функція (елементи мінімум очікуване)
  (за-умовою
   ((дерева-серій-рівні?
     (перша-серія-атомів-щонайменше елементи мінімум)
     очікуване) так)
   (так (перше (як-є ()))))))

; Порожнє й брак потрібної довжини.
(довести-серію-атомів (як-є ()) серія-число-один (як-є ()))
(довести-серію-атомів
 (список (як-є атом?) (як-є решта))
 серія-число-три (як-є ()))
(довести-серію-атомів
 (список (список (як-є атом?)) (список (як-є решта)))
 серія-число-один (як-є ()))

; Якщо серія на початку - повернути увесь початковий суфікс.
(довести-серію-атомів
 (список (як-є атом?) (як-є решта) (як-є сполучити))
 серія-число-два
 (список (як-є атом?) (як-є решта) (як-є сполучити)))

; Спочатку коротка серія, потім довша: не повертати першу.
(довести-серію-атомів
 (список (як-є атом?) (список (як-є решта))
         (як-є сполучити) (як-є функція) (як-є визначити))
 серія-число-три
 (список (як-є сполучити) (як-є функція) (як-є визначити)))

; Розриви складеними елементами забороняють склеювання серій.
(довести-серію-атомів
 (список (як-є атом?) (список (як-є решта))
         (як-є функція) (список (як-є визначити)) (як-є сполучити))
 серія-число-два (як-є ()))

; порожній усередині списку рахується як атомний елемент.
(довести-серію-атомів
 (список (список (як-є решта)) (як-є ()) (як-є функція))
 серія-число-два
 (список (як-є ()) (як-є функція)))

; Нульова довжина не змінює навіть атомарний вхід.
(довести-серію-атомів (як-є атом?) серія-число-нуль (як-є атом?))

; Негативний свідок: короткий префікс не є серією довжини три.
(за-умовою
 ((хибне? (дерева-серій-рівні?
   (перша-серія-атомів-щонайменше
    (список (як-є атом?) (список (як-є решта))
            (як-є сполучити) (як-є функція) (як-є визначити))
    серія-число-три)
   (список (як-є атом?) (список (як-є решта))
           (як-є сполучити) (як-є функція) (як-є визначити)))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
