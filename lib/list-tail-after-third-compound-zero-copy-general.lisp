; СЕНС Д3 і Д5: суфікс після третього складеного елемента.
; Один перегляд О(н), О(1) додаткових пар: лише решта, жодного сполучити.
; Порожній елемент () є атомом, а (()) - складений елемент.
(визначити пропусти-одну-пару-для-третьої
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((атом? (перше елементи))
    (пропусти-одну-пару-для-третьої (решта елементи)))
   (так (решта елементи)))))

(визначити пропусти-дві-пари-для-третьої
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((атом? (перше елементи))
    (пропусти-дві-пари-для-третьої (решта елементи)))
   (так (пропусти-одну-пару-для-третьої (решта елементи))))))

(визначити хвіст-після-третьої-пари
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-третьої-пари (решта елементи)))
   (так (пропусти-дві-пари-для-третьої (решта елементи))))))

; Позитивні й негативні свідки виконуються самим СЕНС.
; Хибний закон переходить до недопустимого перше порожнього списку.
(за-умовою
 ((порожній? (хвіст-після-третьої-пари (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-третьої-пари
   (список (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-третьої-пари
   (список (список (як-є атом?)) (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-третьої-пари
   (список (список (як-є атом?)) (список (як-є решта))
           (як-є сполучити)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-третьої-пари
   (список (список (як-є атом?)) (список (як-є решта))
           (список (як-є сполучити))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (перше (хвіст-після-третьої-пари
    (список (список (як-є атом?)) (список (як-є решта))
            (список (як-є сполучити)) (як-є визначити))))
   (як-є визначити)) так)
 (так (перше (як-є ()))))
; Ні атоми між парами, ні порожній () не збільшують лічильник пар.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-третьої-пари
    (список (список (як-є атом?)) (як-є ())
            (список (як-є решта)) (як-є сполучити)
            (список (як-є функція)) (як-є визначити))))
   (як-є визначити)) так)
 (так (перше (як-є ()))))
; Четвертий складений елемент зберігається, не сплющується.
(за-умовою
 ((хибне?
   (атом? (перше (хвіст-після-третьої-пари
    (список (список (як-є атом?)) (список (як-є решта))
            (список (як-є сполучити)) (список (як-є функція))
            (як-є визначити)))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (перше (перше (хвіст-після-третьої-пари
    (список (список (як-є атом?)) (список (як-є решта))
            (список (як-є сполучити)) (список (як-є функція))
            (як-є визначити)))))
   (як-є функція)) так)
 (так (перше (як-є ()))))
; Негатив: початкова пропущена пара не може лишитися в суфіксі.
(за-умовою
 ((хибне?
   (тотожне?
    (перше (хвіст-після-третьої-пари
     (список (як-є атом?) (список (як-є решта))
             (список (як-є сполучити)) (список (як-є функція))
             (як-є визначити))))
    (як-є атом?))) так)
 (так (перше (як-є ()))))
(атом? (як-є ()))
