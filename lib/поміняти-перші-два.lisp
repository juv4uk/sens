; СЕНС: обмін перших двох елементів списку зі збереженням хвоста.
; Виконувана українська проєкція D3/D4/D5, без сторонньої семантики.
; Вхід: власний список щонайменше з двох елементів.
(визначити поміняти-перші-два
  (функція (елементи)
    (сполучити (друге елементи)
      (сполучити (перше елементи) (решта-решти елементи)))))

; Справжній SENS-приклад: результат [тотожне?, атом?, решта].
(визначити вхід-обміну
  (список (як-є атом?) (як-є тотожне?) (як-є решта)))
(визначити результат-обміну (поміняти-перші-два вхід-обміну))

(за-умовою
  ((тотожне? (перше результат-обміну) (як-є тотожне?))
   (за-умовою
     ((тотожне? (друге результат-обміну) (як-є атом?))
      (за-умовою
        ((тотожне? (третє результат-обміну) (як-є решта))
         (хибне? (тотожне? (перше результат-обміну) (як-є атом?))))
        ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
     ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
