; СЕНС: обмін перших двох елементів списку зі збереженням хвоста.
; Виконувана українська проєкція D3/D4, без зовнішніх мовних реалізацій.
; Власна перестановка складена лише з D3 CAR/CDR/CONS; перевірка D1.
; Вхід: власний список щонайменше з двох елементів.
(визначити поміняти-перші-два
  (функція (елементи)
    (сполучити (перше (решта елементи))
      (сполучити (перше елементи) (решта (решта елементи))))))

; Справжній SENS-приклад: результат [тотожне?, атом?, решта].
(визначити вхід-обміну
  (сполучити (як-є атом?)
    (сполучити (як-є тотожне?)
      (сполучити (як-є решта) (як-є ())))))
(визначити результат-обміну (поміняти-перші-два вхід-обміну))
; Обмін є інволюцією: повторне застосування відновлює перший елемент.
(визначити повернені-елементи (поміняти-перші-два результат-обміну))

(за-умовою
  ((тотожне? (перше результат-обміну) (як-є тотожне?))
   (за-умовою
     ((тотожне? (друге результат-обміну) (як-є атом?))
      (за-умовою
        ((тотожне? (перше (решта (решта результат-обміну))) (як-є решта))
         (за-умовою
           ((тотожне? (перше повернені-елементи) (як-є атом?))
            (хибне? (тотожне? (перше результат-обміну) (як-є атом?))))
           ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
        ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
     ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ())))))

; Незалежний позитивний свідок інволюції для другого елемента й хвоста:
; після двох перестановок збережено всю трійку, а не лише перший атом.
(за-умовою
  ((тотожне? (друге повернені-елементи) (як-є тотожне?))
   (за-умовою
     ((тотожне? (перше (решта (решта повернені-елементи))) (як-є решта))
      (атом? (як-є ())))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
