; Читання чинних доменних проєкцій СЕНС без дублювання семантичної влади.
; Ідентичність запису — пара (домен бітове-слово), а не плоский байт.
; Єдина влада над координатами й назвами: lib/domains/d1.lisp ... d10.lisp.
; Цей довідник НЕ надає резидентам права виклику й не перепаковує T5M.
; D11 (нерактифіковані експериментальні адреси) тут не оголошуємо.
; D7 — текстові дані, не виклична функція. Її рядки тут лише довідкові.
; Поля «ук», «укр», «san», «en», «LISP», «sym» зберігаються без перейменування.

(визначити джерела-семантичного-реєстру
  (як-є
    ((д1 "lib/domains/d1.lisp")
     (д2 "lib/domains/d2.lisp")
     (д3 "lib/domains/d3.lisp")
     (д4 "lib/domains/d4.lisp")
     (д5 "lib/domains/d5.lisp")
     (д6 "lib/domains/d6.lisp")
     (д7 "lib/domains/d7.lisp")
     (д8 "lib/domains/d8.lisp")
     (д9 "lib/domains/d9.lisp")
     (д10 "lib/domains/d10.lisp"))))

(визначити прочитати-джерело-семантичного-реєстру
  (функція (джерело)
    (перше (читати-всі джерело))))

; З (domain-table-1 (БІТИ (ук ...) ...)) одержуємо лише чинні рядки.
(визначити позначити-рядки-доменом
  (функція (домен рядки)
    (за-умовою
      ((порожній? рядки) (як-є ()))
      (так
       (сполучити
         (сполучити
           (список домен (перше (перше рядки)))
           (решта (перше рядки)))
         (позначити-рядки-доменом домен (решта рядки)))))))

(визначити прочитати-рядки-домену
  (функція (домен шлях)
    (позначити-рядки-доменом
      домен
      (решта
        (прочитати-джерело-семантичного-реєстру
          (читати-файл шлях))))))

(визначити прочитати-рядки-всіх-доменів
  (функція (джерела)
    (за-умовою
      ((порожній? джерела) (як-є ()))
      (так
       (приєднати
         (прочитати-рядки-домену
           (перше (перше джерела))
           (друге (перше джерела)))
         (прочитати-рядки-всіх-доменів (решта джерела)))))))

(визначити прочитати-семантичний-реєстр
  (функція ()
    (прочитати-рядки-всіх-доменів
      джерела-семантичного-реєстру)))

(визначити рядки-семантичного-реєстру
  (функція (реєстр)
    реєстр))

(визначити простори-імен-семантичного-реєстру
  (функція ()
    (як-є (укр ук san en LISP sym))))

(визначити простори-імен-рядка-реєстру
  (функція (проєкції)
    (за-умовою
      
      ((хибне? (атом? проєкції))
       (сполучити
         (перше (перше проєкції))
         (простори-імен-рядка-реєстру
           (решта проєкції)))))))

(визначити простори-імен-з-рядка-реєстру
  (функція (рядок)
    (простори-імен-рядка-реєстру
      (проєкції-рядка-реєстру рядок))))

(визначити ідентичність-рядка-реєстру
  (функція (рядок)
    (перше рядок)))

(визначити проєкції-рядка-реєстру
  (функція (рядок)
    (решта рядок)))

(визначити знайти-проєкцію-реєстру
  (функція (простір-імен проєкції)
    (за-умовою
      
      ((хибне? (атом? проєкції))
       (за-умовою
         ((тотожне? простір-імен (перше (перше проєкції))) 
          (перше проєкції))
         ((хибне? (тотожне? простір-імен (перше (перше проєкції))))
          (знайти-проєкцію-реєстру простір-імен (решта проєкції))))))))

(визначити назва-проєкції-реєстру
  (функція (простір-імен рядок)
    (нехай ((запис
            (знайти-проєкцію-реєстру
              простір-імен
              (проєкції-рядка-реєстру рядок))))
      (за-умовою
        
        ((хибне? (атом? запис))
         (друге запис))))))

(визначити знайти-рядок-семантичного-реєстру
  (функція (посилання-сенс рядки)
    (за-умовою
      
      ((хибне? (атом? рядки))
       (за-умовою
         ((однакові? посилання-сенс (ідентичність-рядка-реєстру (перше рядки)))
          
          (перше рядки))
         (так
          (знайти-рядок-семантичного-реєстру посилання-сенс (решта рядки))))))))

(визначити знайти-ідентичність-у-просторах-імен
  (функція (назва рядок простори-імен)
    (за-умовою
      
      ((хибне? (атом? простори-імен))
       (нехай ((кандидат
               (назва-проєкції-реєстру
                 (перше простори-імен)
                 рядок)))
         (за-умовою
           ((однакові? назва кандидат) 
            (ідентичність-рядка-реєстру рядок))
           ((хибне? (однакові? назва кандидат))
            (знайти-ідентичність-у-просторах-імен
              назва
              рядок
              (решта простори-імен)))))))))

(визначити всі-ідентичності-за-проєкцією
  (функція (назва рядки)
    (за-умовою
      ((порожній? рядки) (як-є ()))
      (так
       (нехай ((посилання-сенс
                 (знайти-ідентичність-у-просторах-імен
                   назва
                   (перше рядки)
                   (як-є (укр ук san en LISP sym)))))
         (за-умовою
           ((порожній? посилання-сенс)
            (всі-ідентичності-за-проєкцією назва (решта рядки)))
           (так
            (сполучити
              посилання-сенс
              (всі-ідентичності-за-проєкцією назва (решта рядки))))))))))

; Саме ім'я не може довільно вибирати одну з різних доменних координат.
; За неоднозначності повертаємо порожнє, а не вигадану identity.
(визначити ідентичність-за-проєкцією
  (функція (назва рядки)
    (нехай ((знайдені (всі-ідентичності-за-проєкцією назва рядки)))
      (за-умовою
        ((порожній? знайдені) (як-є ()))
        ((порожній? (решта знайдені)) (перше знайдені))
        (так (як-є ()))))))

(визначити перевірити-кругове-читання-реєстру
  (функція (посилання-сенс)
    (нехай-послідовно ((надруковане (значення-у-текст посилання-сенс))
           (форми
             (читати-всі надруковане)))
      (перше форми))))

; Пошук у вже прочитаних даних реєстру без повторного звернення до вводу-виводу хоста.
(визначити рядок-у-семантичному-реєстрі
  (функція (реєстр посилання-сенс)
    (знайти-рядок-семантичного-реєстру
      посилання-сенс
      (рядки-семантичного-реєстру реєстр))))

(визначити ідентичність-у-семантичному-реєстрі
  (функція (реєстр проєкція)
    (ідентичність-за-проєкцією
      проєкція
      (рядки-семантичного-реєстру реєстр))))

; Допоміжні обгортки для звичайного використання під час виконання.
(визначити отримати-рядок-семантичного-реєстру
  (функція (посилання-сенс)
    (рядок-у-семантичному-реєстрі
      (прочитати-семантичний-реєстр)
      посилання-сенс)))

(визначити отримати-ідентичність-семантичного-реєстру
  (функція (проєкція)
    (ідентичність-у-семантичному-реєстрі
      (прочитати-семантичний-реєстр)
      проєкція)))
