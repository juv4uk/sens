    (rename observation-statement спостереження-текст зміст-спостереження "Statement спостереження може бути структурованими даними, не лише текстом.")
    (rename intent-goal намір-мета мета-наміру "Природна українська родова конструкція.")
    (rename supporting-evidence підтримуючий-доказ підтримувальний-доказ "Нормативніша прикметникова форма без калькованого активного дієприкметника.")
    (rename member? містить? значення-у-списку? "У виклику прямо видно відношення: значення належить списку.")
    (rename string-prefix? текст-починається? префікс-тексту? "Аргументи мають порядок префікс, текст; назва читається як питання про це відношення.")
    (rename string-contains? містить-текст? фрагмент-у-тексті? "Аргументи мають порядок фрагмент, текст; назва більше не приховує суб'єкт відношення.")
    (rename codepoint->string код-у-текст кодова-точка-у-текст "«Кодова точка» точно називає Unicode code point, а не довільний код або кодування.")
    (rename string->codepoint текст-у-код текст-у-кодову-точку "Результат точно названо Unicode кодовою точкою.")
    (rename write-to-string у-текст значення-у-текст "Функція серіалізує довільне Lisp-значення; назва більше не виглядає як безконтекстна конверсія.")
    (rename unix-time-now юнікс-час-зараз поточний-юнікс-час "Природний український порядок слів.")
    (rename deadline-after-ns дедлайн-після-нс дедлайн-через-нс "«Через N наносекунд» природно описує дельту від поточного монотонного часу.")
    (rename map-contains? карта-містить? ключ-у-карті? "У виклику прямо видно відношення ключа до карти й порядок аргументів.")
    (rename contains-atom? містить-атом? атом-у-списку? "Helper перевіряє заданий атом у списку; назва читається природно в порядку аргументів.")
  ))
