;; Приймальна програма для української мовної поверхні.
;; Перевірка визначень та обчислень українськими словами.
;;
;; Усі виконувані назви записані українською розкладкою.
;; Перевіряються числові значення, рядки та розділові знаки.
;; Використано визначення, функції, арифметику, порівняння,
;; списки, функції вищого порядку, рядки та роботу з часом.
;; Жодна перевірка не потребує англійської викличної назви.
;;
;; Перед запуском завантажити ядро та українську поверхню.
;; Приймальна перевірка покриття української поверхні.
;;
;; Після завантаження залежностей обчислити цей файл.

;;
;; 1. Визначення та функції
;;

(визначити квадрат
  (функція (число)
    (помножити число число)))

(визначити факторіал
  (функція (число)
    (за-умовою
      ((не-більше? число 1) 1 1)
      ((не-більше? число 1) 0
       (помножити число (факторіал (відняти число 1)))))))

;;
;; 2. Арифметика та порівняння
;;

(визначити перевірка-арифметики
  (функція ()
    (за-умовою
      ((рівне? (додати 2 3) 5) 1 (як-є ок))
      ((рівне? (додати 2 3) 5) 0 (як-є помилка)))))

;;
;; 3. Обробка списків
;;

(визначити суму-списку
  (функція (перелік)
    (за-умовою
      ((хибне? (однакові? перелік ())) () 0)
      ((хибне? (хибне? (однакові? перелік ()))) ()
       (додати (перше перелік) (суму-списку (решта перелік)))))))

(визначити довжина-рекурсивно
  (функція (перелік)
    (за-умовою
      ((хибне? (однакові? перелік ())) () 0)
      ((хибне? (хибне? (однакові? перелік ()))) ()
       (додати 1 (довжина-рекурсивно (решта перелік)))))))

;;
;; 4. Функції вищого порядку
;;

(визначити подвоїти-все
  (функція (перелік)
    (відобразити (функція (число) (помножити число 2)) перелік)))

(визначити лише-парні
  (функція (перелік)
    (відсіяти
      (функція (число) (тотожне? (модульна-остача число 2) 0))
      перелік)))

(визначити добуток-списку
  (функція (перелік)
    (згорнути помножити 1 перелік)))

;;
;; 5. Рядки
;;

(визначити привітання
  (функція (ім'я)
    (рядок-додати "Привіт, " ім'я)))

;;
;; 6. Бібліотека часу
;;

(визначити поточний-час
  (функція ()
    (юнікс-час-зараз)))

;;
;; 7. Самоперевірка
;;

(визначити перевірити-все
  (функція ()
    (за-умовою
      ;; арифметика
      ((рівне? (квадрат 7) 49) 0 (як-є помилка-квадрат))
      ;; факторіал
      ((рівне? (факторіал 5) 120) 0 (як-є помилка-факторіал))
      ;; рекурсія списків
      ((рівне? (суму-списку (список 1 2 3 4 5)) 15) 0 (як-є помилка-сума))
      ((рівне? (довжина-рекурсивно (список (як-є а) (як-є б) (як-є в))) 3) 0 (як-є помилка-довжина))
      ;; відображення
      ((рівне? (довжина-рекурсивно (подвоїти-все (список 1 2 3))) 3) 0 (як-є помилка-подвоїти))
      ((рівне? (суму-списку (подвоїти-все (список 1 2 3))) 12) 0 (як-є помилка-подвоїти))
      ;; відсіювання
      ((рівне? (довжина-рекурсивно (лише-парні (список 1 2 3 4 5 6))) 3) 0 (як-є помилка-парні))
      ((рівне? (суму-списку (лише-парні (список 1 2 3 4 5 6))) 12) 0 (як-є помилка-парні))
      ;; згортання
      ((рівне? (добуток-списку (список 1 2 3 4)) 24) 0 (як-є помилка-добуток))
      ;; рядки
      ((рівне? (рядок-довжина (привітання "світе")) (рядок-довжина "Привіт, світе")) 0 (як-є помилка-привітання))
      ;; перевірка рядка
      ((рівне? (рядок-довжина "тест") 4) 0 (як-є помилка-текст-предикат))
      ;; довжина рядка
      ((рівне? (рядок-довжина "кіт") 3) 0 (як-є помилка-довжина-тексту))
      ;; порівняння
      ((менше? 1 2) 0 (як-є помилка-менше))
      ((більше? 3 2) 0 (як-є помилка-більше))
      ((рівне? 4 4) 0 (як-є помилка-рівне))
      ;; усі перевірки пройдено
      ((хибне? (тотожне? 1 1)) () (як-є успіх)))))

;; Запустити всі перевірки
(перевірити-все)
