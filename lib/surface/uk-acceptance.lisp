; Приймальна програма української проєкції СЕНС.
; Лише українські викличні голови, повні імена функцій та параметрів.
; Умовні гілки мають по два поля: предикат Д1 і вираз.
; Порожній список — структура, а не прихована логічна хиба.
; Математичні значення порівнюємо математичними предикатами.
; Невдала перевірка повертає названу помилку, успіх — лише після всіх перевірок.

(визначити квадрат
  (функція (число)
    (помножити число число)))

(визначити факторіал
  (функція (число)
    (за-умовою
      ((не-більше? число 1) 1)
      (так (помножити число (факторіал (відняти число 1)))))))

(визначити перевірка-арифметики
  (функція ()
    (за-умовою
      ((рівне? (додати 2 3) 5) (як-є ок))
      (так (як-є помилка)))))

(визначити суму-списку
  (функція (перелік)
    (за-умовою
      ((порожній? перелік) 0)
      (так (додати (перше перелік) (суму-списку (решта перелік)))))))

(визначити довжина-рекурсивно
  (функція (перелік)
    (за-умовою
      ((порожній? перелік) 0)
      (так (додати 1 (довжина-рекурсивно (решта перелік)))))))

(визначити подвоїти-все
  (функція (перелік)
    (відобразити
      (функція (число) (помножити число 2))
      перелік)))

(визначити лише-парні
  (функція (перелік)
    (відсіяти
      (функція (число)
        (рівне? (модульна-остача число 2) 0))
      перелік)))

(визначити добуток-списку
  (функція (перелік)
    (згорнути помножити 1 перелік)))

(визначити привітання
  (функція (ім'я)
    (рядок-додати "Привіт, " ім'я)))

(визначити поточний-час
  (функція ()
    (юнікс-час-зараз)))

(визначити перевірити-все
  (функція ()
    (за-умовою
      ((хибне? (рівне? (квадрат 7) 49)) (як-є помилка-квадрат))
      ((хибне? (рівне? (факторіал 5) 120)) (як-є помилка-факторіал))
      ((хибне? (рівне? (суму-списку (список 1 2 3 4 5)) 15)) (як-є помилка-сума))
      ((хибне? (рівне? (довжина-рекурсивно (список (як-є а) (як-є б) (як-є в))) 3))
       (як-є помилка-довжина))
      ((хибне? (рівне? (довжина-рекурсивно (подвоїти-все (список 1 2 3))) 3))
       (як-є помилка-подвоїти))
      ((хибне? (рівне? (суму-списку (подвоїти-все (список 1 2 3))) 12))
       (як-є помилка-подвоїти-сума))
      ((хибне? (рівне? (довжина-рекурсивно (лише-парні (список 1 2 3 4 5 6))) 3))
       (як-є помилка-парні))
      ((хибне? (рівне? (суму-списку (лише-парні (список 1 2 3 4 5 6))) 12))
       (як-є помилка-парні-сума))
      ((хибне? (рівне? (добуток-списку (список 1 2 3 4)) 24))
       (як-є помилка-добуток))
      ((хибне? (рівне? (рядок-довжина (привітання "світе"))
                           (рядок-довжина "Привіт, світе")))
       (як-є помилка-привітання))
      ((хибне? (рівне? (рядок-довжина "тест") 4)) (як-є помилка-текст-предикат))
      ((хибне? (рівне? (рядок-довжина "кіт") 3)) (як-є помилка-довжина-тексту))
      ((хибне? (менше? 1 2)) (як-є помилка-менше))
      ((хибне? (більше? 3 2)) (як-є помилка-більше))
      ((хибне? (рівне? 4 4)) (як-є помилка-рівне))
      (так (як-є успіх)))))

(перевірити-все)
