; Інвентар української поверхні.

; Структуру інвентаря будує сам SENS: D3 CONS працює як оператор,
; а D7 зберігає тільки буквальні назви поверхні, не їхню семантику.
; Результат тотожний попереднім даним, але виконується реальна композиція.
(визначити інвентар-укр
  (функція ()
    (сполучити (як-є uk-inventory)
      (сполучити
        (як-є (визначити функція за-умовою тотожне? як-є перше решта список))
        (як-є ())))))

; Інвентар зобов'язаний містити правильний список атомарних назв.
; Це перевіряє саме СЕНС: непридатне вкладення повертає точне «ні».
(визначити інвентар-укр-атомарний?
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) так)
      ((атом? елементи) ні)
      ((атом? (перше елементи))
       (інвентар-укр-атомарний? (решта елементи)))
      (так ні))))

; Позитивний і негативний свідки. Успіх залишає той самий результат,
; що й раніше; порушення закону зупиняє виконання через CAR порожнього.
(за-умовою
  ((інвентар-укр-атомарний? (друге (інвентар-укр)))
   (за-умовою
     ((хибне? (інвентар-укр-атомарний?
                 (список (як-є (неприпустиме-вкладення)))))
      (інвентар-укр))
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))
