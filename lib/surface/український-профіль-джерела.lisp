; Це НЕ semantic authority і НЕ заміна lib/surface/semantic-registry.lisp.
; Canon / byte SID лишається єдиною identity. Цей файл є staging-
; проєкцією повної української peer-surface `ukr` у спільній Canon-таблиці
; функцій. Після матеріалізації таблиці в #75 цей файл не повинен лишитися
; паралельним джерелом істини.
;
; Поле `чинна-назва` відбиває теперішню stable UK surface; `повна-назва`
; є або тією самою вже повною назвою, або кандидатом для окремого огляду.
; Усі byte SIDs походять із semantic-registry.lisp.

(український-профіль-джерела/1
  (залежить-від
    (канон-таблиця-функцій issue-75)
    (український-source issue-77))

  (призначення
    (цільова-колонка ukr)
    (не-окрема-authority t)
    (semantic-id єдина-identity))

  (політика
    (основна-людська-мова українська)
    (основне-розширення ".lisp")
    (повні-слова t)
    (програмістські-скорочення заборонені-за-замовчуванням)
    (кодування utf-8-nfc)
    (старі-розширення compatibility-only))

  (дозволені-міжнародні-позначення
    (utf-8 abi api elf uefi x86_64 json http tcp udp sha256))

  ; Повний staging-прохід: усі 167 semantic identity з function table.
  ; `чинна` = поточна stable UK surface вже відповідає повнослівному стилю.
  ; `кандидат-власника` = прямо запропоновано власником.
  ; `кандидат-повної-назви` = запропоновано для ручного огляду власником.
  ; `кандидат-сумісності` = описова UK-назва compatibility-only identity;
  ;   вона НЕ стає новою surface автоматично.
  ; `кандидат-нової-stable-назви` = UK-кандидат для stable identity, яка
  ;   наразі не має української surface; потрібна окрема ратифікація registry.
  ;
  ; `аліаси-повних-назв` не створюють нових semantic identities і не
  ; ратифікують surface. Вони лише фіксують, що compatibility-row свідомо
  ; повторює повну українську назву канонічного власника значення.
