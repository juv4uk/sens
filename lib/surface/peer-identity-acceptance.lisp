; Приймальна програма чинних українських D1/D3 та D24+ функцій.
; Мовна тотожність поверхонь перевіряється окремо за доменними координатами.
; Тут перевіряємо справжній результат обчислення SENS, а не старі
; англійські alias або тільки наявність визначення.
; Кожна умова обчислює D1-предикат; немає незв'язаних host так/ні.
; Хиба в числовій рівності — EQ різних цитованих атомів, не NIL-список.

; Рівність математичних D24+ значень — це перетин двох
; ратифікованих D6-порядків, а не атомне D3 EQ або host-порівняння.
(визначити приймання-число-нуль (довжина (як-є ())))
(визначити приймання-число-два (довжина (як-є (а б))))
(визначити приймання-число-п'ять (довжина (як-є (а б в г ґ))))
(визначити приймання-число-сім (довжина (як-є (а б в г ґ д е))))

(визначити однакове-число?
  (функція (ліве праве)
    (за-умовою
      ((не-більше? ліве праве)
       (не-менше? ліве праве))
      ((атом? (як-є ()))
       (тотожне? (як-є ліва-мітка) (як-є права-мітка))))))

(визначити перевірити-спільні-функції
  (функція ()
    (за-умовою
      ((хибне? (однакове-число? (модуль (відняти приймання-число-нуль приймання-число-сім)) приймання-число-сім))
       (як-є помилка-модуль))
      ((хибне? (однакове-число? (найменше приймання-число-сім приймання-число-два приймання-число-п'ять) приймання-число-два))
       (як-є помилка-найменше))
      ((хибне? (однакове-число? (найбільше приймання-число-сім приймання-число-два приймання-число-п'ять) приймання-число-сім))
       (як-є помилка-найбільше))
      ((хибне? (однакове-число? (найменше-у-списку (список приймання-число-сім приймання-число-два приймання-число-п'ять)) приймання-число-два))
       (як-є помилка-найменше-списку))
      ((хибне? (однакове-число? (найбільше-у-списку (список приймання-число-сім приймання-число-два приймання-число-п'ять)) приймання-число-сім))
       (як-є помилка-найбільше-списку))
      ((атом? (як-є ())) (як-є успіх)))))

(перевірити-спільні-функції)
