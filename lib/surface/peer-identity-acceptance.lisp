; Приймальна програма чинних українських D1/D3 та D24+ функцій.
; Мовна тотожність поверхонь перевіряється окремо за доменними координатами.
; Тут перевіряємо справжній результат обчислення SENS, а не старі
; англійські alias або тільки наявність визначення.
; Кожна умова обчислює D1-предикат; немає незв'язаних host так/ні.
; Хиба в числовій рівності — EQ різних цитованих атомів, не NIL-список.

; Рівність математичних D24+ значень — це перетин двох
; ратифікованих D6-порядків, а не атомне D3 EQ або host-порівняння.
(визначити однакове-число?
  (функція (ліве праве)
    (за-умовою
      ((не-більше? ліве праве)
       (не-менше? ліве праве))
      ((атом? (як-є ()))
       (тотожне? (як-є ліва-мітка) (як-є права-мітка))))))

(визначити перевірити-спільні-функції
  (функція ()
    (за-умовою
      ((хибне? (однакове-число? (модуль (відняти 0 7)) 7))
       (як-є помилка-модуль))
      ((хибне? (однакове-число? (найменше 7 2 5) 2))
       (як-є помилка-найменше))
      ((хибне? (однакове-число? (найбільше 7 2 5) 7))
       (як-є помилка-найбільше))
      ((хибне? (однакове-число? (найменше-у-списку (список 7 2 5)) 2))
       (як-є помилка-найменше-списку))
      ((хибне? (однакове-число? (найбільше-у-списку (список 7 2 5)) 7))
       (як-є помилка-найбільше-списку))
      ((атом? (як-є ())) (як-є успіх)))))

(перевірити-спільні-функції)
