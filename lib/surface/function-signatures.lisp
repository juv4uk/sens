  (01011100 (kind builtin) (arity 2) (surfaces stable) (sig "(ntp-query-raw host timeout-ms)") (doc "Perform one bounded NTP query and return raw protocol fields"))
  (01011101 (kind builtin) (arity 0) (surfaces stable) (sig "(timezone-declarations-raw)") (doc "Observe raw TZ and /etc/timezone declaration candidates"))
  (10100000 (kind builtin) (arity 1) (surfaces stable) (sig "(json-parse string)") (doc "Parse JSON into sens values"))
  (10100001 (kind builtin) (arity 1) (surfaces stable) (sig "(sha256-hex string)") (doc "Return the SHA-256 hex digest"))
