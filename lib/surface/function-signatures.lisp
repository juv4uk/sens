  (01010111 (kind builtin) (arity 1) (surfaces stable) (sig "(numeric-buffer-length buffer)") (doc "Return the element count"))
  (01011000 (kind builtin) (arity 2) (surfaces stable) (sig "(numeric-buffer-ref buffer index)") (doc "Return an element by index"))
  (01011001 (kind builtin) (arity 2) (surfaces stable) (sig "(numeric-buffer-map function buffer)") (doc "Map a function over a numeric buffer"))
  (01011010 (kind builtin) (arity 0) (surfaces stable) (sig "(mono-ns)") (doc "Return a monotonic nanosecond counter as an exact integer"))
