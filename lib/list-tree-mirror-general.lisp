; СЕНС Д3-Д5: рекурсивне дзеркало вкладених правильних списків точних атомів.
; Закон: дзеркалити-дерево(дзеркалити-дерево(х)) = х для скінченного х.
; Порожні вузли лишаються порожніми, атоми не змінюються.
; Структура Д2 і точні доменні слова - семантика; Д7 - лише людська проєкція.

(визначити дописати-для-дзеркала
  (функція (ліві праві)
    (за-умовою
      ((атом? ліві) праві)
      ((атом? (як-є ()))
       (сполучити (перше ліві)
         (дописати-для-дзеркала (решта ліві) праві))))))

(визначити дзеркалити-дерево
  (функція (дерево)
    (за-умовою
      ((атом? дерево) дерево)
      ((атом? (як-є ()))
       (дописати-для-дзеркала
         (дзеркалити-дерево (решта дерево))
         (список (дзеркалити-дерево (перше дерево))))))))

(визначити вкладене-дерево
  (список
    (як-є атом?)
    (список (як-є решта) (список (як-є сполучити) (як-є тотожне?)))
    (як-є ())
    (як-є хибне?)))
(визначити дзеркальне-дерево (дзеркалити-дерево вкладене-дерево))
(визначити відновлене-дерево (дзеркалити-дерево дзеркальне-дерево))

