; СЕНС: кожний четвертий елемент правильного списку (4, 8, 12...).
; Один прохід, одна нова пара на четвірку, жодних числових лічильників.
; Вкладені пари передаємо без копіювання, значення задає тільки СЕНС.
(визначити взяти-кожний-четвертий
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((порожній? (решта елементи)) (як-є ()))
   ((порожній? (решта (решта елементи))) (як-є ()))
   ((порожній? (решта (решта (решта елементи)))) (як-є ()))
   (так
    (сполучити
     (четверте елементи)
     (взяти-кожний-четвертий
      (решта (решта (решта (решта елементи))))))))))

; Результат для двох повних четвірок - два незмінні атоми.
(визначити четверті-з-вісьмох
 (взяти-кожний-четвертий
  (список (як-є атом?) (як-є решта)
          (як-є сполучити) (як-є функція)
          (як-є визначити) (як-є за-умовою)
          (як-є як-є) (як-є тотожне?))))

; Граничні довжини, позитивні й негативні свідки. Якщо закон
; порушено, сам СЕНС виконає ПЕРШЕ на порожньому списку й відхилить.
(за-умовою
 ((порожній? (взяти-кожний-четвертий (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній?
   (взяти-кожний-четвертий
    (список (як-є атом?) (як-є решта) (як-є сполучити)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше четверті-з-вісьмох) (як-є функція)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (друге четверті-з-вісьмох) (як-є тотожне?)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта (решта четверті-з-вісьмох))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (тотожне? (перше четверті-з-вісьмох) (як-є сполучити))) так)
 (так (перше (як-є ()))))

; Вкладена четверта пара повинна залишатися парою з тим самим атомом.
(визначити четвертий-вкладений
 (взяти-кожний-четвертий
  (список (як-є атом?) (як-є решта) (як-є сполучити)
          (список (як-є функція) (як-є визначити)))))
(за-умовою
 ((тотожне? (перше (перше четвертий-вкладений)) (як-є функція)) так)
 (так (перше (як-є ()))))
(атом? (як-є ()))
