; Д3 і Д5. Знайти атом першої пари однакових сусідніх елементів.
; На відміну від перевірки наявності повтору, повертається сам атом.
; Коли суміжної пари немає, повертається порожній список як дані.
; Виконання належить СЕНС, а не зовнішньому обчислювачу.
(визначити перший-сусідній-повтор
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) (як-є ()))
      ((тотожне? (перше елементи) (друге елементи))
       (перше елементи))
      ((атом? (як-є ()))
       (перший-сусідній-повтор (решта елементи))))))

; Кожний закон має позитивну гілку і справжній шлях помилки у СЕНС.

; Закон 1. порожній список.
(за-умовою
  ((порожній? (перший-сусідній-повтор (як-є ()))) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 2. один елемент.
(за-умовою
  ((порожній? (перший-сусідній-повтор (список (як-є атом?)))) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 3. два різні.
(за-умовою
  ((порожній? (перший-сусідній-повтор (список (як-є атом?) (як-є решта)))) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 4. пара однакових на початку.
(за-умовою
  ((тотожне? (перший-сусідній-повтор (список (як-є атом?) (як-є атом?))) (як-є атом?)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

