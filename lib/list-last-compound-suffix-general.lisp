; Суфікс від останнього складеного елемента правильного списку.
; Порожній список як елемент - атом Д3, тому він не є межею.
; Не перебудовуємо суфікс і не порівнюємо складені пари через ЕК.
; Лише СЕНС і Д3-Д5 визначає результат; Зіг і Т5М - фізичне представлення.

(визначити суфікс-від-останньої-пари-далі
 (функція (елементи знайдений)
  (за-умовою
   ((порожній? елементи) знайдений)
   ((атом? (перше елементи))
    (суфікс-від-останньої-пари-далі (решта елементи) знайдений))
   (так
    (суфікс-від-останньої-пари-далі (решта елементи) елементи)))))

(визначити суфікс-від-останньої-пари
 (функція (елементи)
  (суфікс-від-останньої-пари-далі елементи (як-є ()))))

; Рівність довільної структури доводимо рекурсивно через Д3.
; ЕК використовується лише коли обидві частини атомарні.
(визначити дерева-останнього-суфікса-однакові?
 (функція (лівий правий)
  (за-умовою
   ((атом? лівий)
    (за-умовою
     ((атом? правий) (тотожне? лівий правий))
     (так ні)))
   ((атом? правий) ні)
   ((дерева-останнього-суфікса-однакові?
      (перше лівий) (перше правий))
    (дерева-останнього-суфікса-однакові?
      (решта лівий) (решта правий)))
   (так ні))))

(визначити довести-останній-суфікс
 (функція (елементи очікуваний)
  (за-умовою
   ((дерева-останнього-суфікса-однакові?
     (суфікс-від-останньої-пари елементи)
     очікуваний)
    (атом? (як-є ())))
   (так (перше (як-є ()))))))

