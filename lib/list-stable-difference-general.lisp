; D3/D5: стабільна різниця двох списків атомів, порядок збережено.
(визначити входить-у-праві?
 (функція (шукане праві)
  (за-умовою
   ((атом? праві) ні)
   ((тотожне? шукане (перше праві)) так)
   ((атом? (як-є ())) (входить-у-праві? шукане (решта праві))))))
(визначити різниця-атомів-стала
 (функція (ліві праві)
  (за-умовою
   ((атом? ліві) (як-є ()))
   ; Порожній правий набір: повернути лівий список без копіювання.
   ((атом? праві) ліві)
   ((входить-у-праві? (перше ліві) праві)
    (різниця-атомів-стала (решта ліві) праві))
   ((атом? (як-є ()))
    (сполучити (перше ліві) (різниця-атомів-стала (решта ліві) праві))))))
(визначити залишені
 (різниця-атомів-стала
  (список (як-є атом?) (як-є решта) (як-є атом?) (як-є сполучити) (як-є тотожне?) (як-є решта))
  (список (як-є решта) (як-є атом?))))
(визначити повтори-залишені
 (різниця-атомів-стала
  (список (як-є сполучити) (як-є решта) (як-є сполучити))
  (список (як-є решта))))

(визначити незмінені-при-порожніх-правих
 (різниця-атомів-стала
  (список (як-є атом?) (як-є решта) (як-є атом?))
  (як-є ())))

; Нативний свідок раннього завершення: не пропущено й не додано атомів.
; Відхилення на будь-якому місці завершується CAR NIL у самому SENS.
(за-умовою
 ((тотожне? (перше незмінені-при-порожніх-правих) (як-є атом?))
  (за-умовою
   ((тотожне? (друге незмінені-при-порожніх-правих) (як-є решта))
    (за-умовою
     ((тотожне? (перше (решта (решта незмінені-при-порожніх-правих))) (як-є атом?))
      (за-умовою
       ((порожній? (решта (решта (решта незмінені-при-порожніх-правих))))
        (атом? (як-є ())))
       ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
   ((атом? (як-є ())) (перше (як-є ())))))
 ((атом? (як-є ())) (перше (як-є ()))))

