; Функційне оновлення першої частини пари без мутацій та семантики хоста.
; Голова нової пари дорівнює новому значенню.
; Хвіст результату тотожний хвосту початкової пари.
(визначити замінити-голову-пари
  (функція (пара нове)
    (сполучити нове (решта пара))))

(визначити початкова-пара-голови
  (сполучити (як-є атом?) (як-є решта)))
(визначити оновлена-пара-голови
  (замінити-голову-пари початкова-пара-голови (як-є тотожне?)))

; Результат: нова голова, незмінний хвіст, заперечення старої голови.
(за-умовою
  ((тотожне? (перше оновлена-пара-голови) (як-є тотожне?))
   (за-умовою
     ((тотожне? (решта оновлена-пара-голови) (як-є решта))
      (хибне? (тотожне? (перше оновлена-пара-голови) (як-є атом?))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
