; Д11: захищений протокол таблиць асоціацій, не нові машинні коди.
; Джерело: СРФІ-1, таблиці асоціацій, ключ завжди перший аргумент компаратора.
; Джерело - СРФІ-1, списки й асоціації
; Переосмислення для СЕНС: Д1 присутність відокремлена від значення.
; Дані та коди СЕНС залишаються першокласними об'єктами.
; Кожен запис - СПОЛУЧИТИ-пара (ключ . дані), записи - правильний скінченний список.
; Порівнювач має повертати точний Д1, без логічних значень хосту.
;
; Єдиний SENS-закон форми alist: скінченний правильний список пар.
; D1 ні, структурне () та довільна пара дозволені як ЗНАЧЕННЯ запису.
; Але сам запис мусить бути парою, а хвіст таблиці — структурним ().
(визначити правильна-таблиця-асоціацій?
  (функція (записи)
    (за-умовою
      ; Точний D3 NULL вирізняє () без атомної D3 EQ.
      ; D1:ні чи D7-атом ніколи не є кінцем alist.
      ((порожній? записи) так)
      ((атом? записи) ні)
      ((атом? (перше записи)) ні)
      (так
       (правильна-таблиця-асоціацій? (решта записи))))))

; Відмова є справжньою D3 Type, а не хибним успіхом або D1 ні.
; Перевірка всього хвоста відбувається до першого порівняння ключів.
(визначити підтвердити-таблицю-асоціацій
  (функція (записи)
    (за-умовою
      ((правильна-таблиця-асоціацій? записи) записи)
      (так (перше (як-є ()))))))

; Пошук повертає (так запис) або (ні ()).
; Ядро обходить уже перевірений alist і зупиняється на першому збігу.
(визначити знайти-запис-із-наявністю-ядро
  (функція (порівняти ключ записи)
    (за-умовою
      ((порожній? записи) (список ні (як-є ())))
      ((порівняти ключ (перше (перше записи)))
       (список так (перше записи)))
      (так
       (знайти-запис-із-наявністю-ядро
         порівняти ключ (решта записи))))))

(визначити знайти-запис-із-наявністю
  (функція (порівняти ключ записи)
    (знайти-запис-із-наявністю-ядро
      порівняти ключ
      (підтвердити-таблицю-асоціацій записи))))

; Оновлюється тільки перший збіг; за відсутності ключа
; запис додається в кінець. Вхід не мутується.
(визначити оновити-перший-запис-ядро
  (функція (порівняти ключ дані записи)
    (за-умовою
      ((порожній? записи) (список (сполучити ключ дані)))
      ((порівняти ключ (перше (перше записи)))
       (сполучити
         (сполучити ключ дані)
         (решта записи)))
      (так
       (сполучити
         (перше записи)
         (оновити-перший-запис-ядро
           порівняти ключ дані (решта записи)))))))

(визначити оновити-перший-запис
  (функція (порівняти ключ дані записи)
    (оновити-перший-запис-ядро
      порівняти ключ дані
      (підтвердити-таблицю-асоціацій записи))))

; Усі значення ключа зберігають початковий порядок і кратність.
; D1 ні та () — повноправні елементи результату.
(визначити зібрати-значення-ключа-ядро
  (функція (порівняти ключ записи)
    (за-умовою
      ((порожній? записи) (як-є ()))
      ((порівняти ключ (перше (перше записи)))
       (сполучити
         (решта (перше записи))
         (зібрати-значення-ключа-ядро
           порівняти ключ (решта записи))))
      (так
       (зібрати-значення-ключа-ядро
         порівняти ключ (решта записи))))))

(визначити зібрати-значення-ключа
  (функція (порівняти ключ записи)
    (зібрати-значення-ключа-ядро
      порівняти ключ
      (підтвердити-таблицю-асоціацій записи))))

; Д11 · ALIST-VALUE-PRESENCE: відокремити факт знайдення ключа від даних.
; Знайдений запис має форму (ключ . значення), не двоелементний список.
; D1:ні та D3:() у полі значення залишаються ДАНИМИ. Нема нового opcode.
; Сам пошук перевіряє всю структуру alist до першого виклику компаратора.
; Внутрішня проєкція приймає тільки результат чинного знайти-запис-із-наявністю.
(визначити значення-запису-із-наявністю
  (функція (знайдено)
    (за-умовою
      ((перше знайдено)
       (список так
         (решта (перше (решта знайдено)))))
      (так (список ні (як-є ()))))))

(визначити знайти-значення-запису-із-наявністю
  (функція (порівняти ключ записи)
    (значення-запису-із-наявністю
      (знайти-запис-із-наявністю порівняти ключ записи))))
