; Д11: захищений протокол таблиць асоціацій, не нові машинні коди.
; Джерело: СРФІ-1, таблиці асоціацій, ключ завжди перший аргумент компаратора.
; Джерело - СРФІ-1, списки й асоціації
; Переосмислення для СЕНС: Д1 присутність відокремлена від значення.
; Дані та коди СЕНС залишаються першокласними об'єктами.
; Кожен запис - СПОЛУЧИТИ-пара (ключ . дані), записи - правильний скінченний список.
; Порівнювач має повертати точний Д1, без логічних значень хосту.
;
; Закон пошуку: (так запис) або (ні ()); Д1 ні як значення запису
; НЕ означає відсутній ключ. Пошук завершується на першому збігу.
(визначити знайти-запис-із-наявністю
  (функція (порівняти ключ записи)
    (за-умовою
      ((порожній? записи) (список ні (як-є ())))
      ((порівняти ключ (перше (перше записи)))
       (список так (перше записи)))
      (так
       (знайти-запис-із-наявністю
         порівняти ключ (решта записи))))))

; Закон точного оновлення: змінюється тільки ПЕРШИЙ збіг.
; Початкові дублікати далі залишаються без змін; порядок сталий.
; Коли ключ відсутній - новий запис додається В КІНЕЦЬ.
; Вхідний запис не змінюється побічним ефектом.
(визначити оновити-перший-запис
  (функція (порівняти ключ дані записи)
    (за-умовою
      ((порожній? записи) (список (сполучити ключ дані)))
      ((порівняти ключ (перше (перше записи)))
       (сполучити
         (сполучити ключ дані)
         (решта записи)))
      (так
       (сполучити
         (перше записи)
         (оновити-перший-запис
           порівняти ключ дані (решта записи)))))))

; Список усіх значень за ключем у початковому порядку.
; Важливо: дійсний Д1 ні та () лишаються ЕЛЕМЕНТАМИ результату.
(визначити зібрати-значення-ключа
  (функція (порівняти ключ записи)
    (за-умовою
      ((порожній? записи) (як-є ()))
      ((порівняти ключ (перше (перше записи)))
       (сполучити
         (решта (перше записи))
         (зібрати-значення-ключа
           порівняти ключ (решта записи))))
      (так
       (зібрати-значення-ключа
         порівняти ключ (решта записи))))))

; Живий СЕНС-свідок: наявність ключа НЕ дорівнює істинності даних.
; Точний Д3 ТОТОЖНЕ? передається як першокласна функція порівняння.
(визначити довести-наявність-хибного-значення
  (функція (знайдено)
    (за-умовою
      ((перше знайдено)
       (за-умовою
         ((хибне? (решта (друге знайдено))) так)
         (так (перше (як-є ())))))
      (так (перше (як-є ()))))))

(довести-наявність-хибного-значення
  (знайти-запис-із-наявністю
    тотожне? (як-є атом?)
    (список
      (сполучити (як-є атом?) ні)
      (сполучити (як-є решта) так))))

; Відсутній ключ має точну Д1 відмову, а не удаваний порожній успіх.
(за-умовою
  ((хибне?
     (перше
       (знайти-запис-із-наявністю
         тотожне? (як-є сполучити)
         (список (сполучити (як-є атом?) ні))))) так)
  (так (перше (як-є ()))))

; Оновлення першого ключа змінює перше значення з Д1:ні на Д1:так,
; але зберігає наступний дублікат з Д1:ні. Усе перевіряє живий СЕНС.
(визначити довести-оновлення-першого-запису
  (функція (оновлені)
    (за-умовою
      ((решта (перше оновлені))
       (за-умовою
         ((хибне? (решта (перше (решта оновлені)))) так)
         (так (перше (як-є ())))))
      (так (перше (як-є ()))))))

(довести-оновлення-першого-запису
  (оновити-перший-запис
    тотожне? (як-є атом?) так
    (список
      (сполучити (як-є атом?) ні)
      (сполучити (як-є атом?) ні))))
