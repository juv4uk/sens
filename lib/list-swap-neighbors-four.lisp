; Д3 і Д4: обмін першого з другим і третього з четвертим. Вхід - список із чотирьох елементів.
; Інволюція: повторне застосування відновлює кожну позицію.
; Лише чинні українські функції та Д7-імена, без нового код операції.
(визначити поміняти-сусідів-четвірки
  (функція (четвірка)
    (список
      (друге четвірка)
      (перше четвірка)
      (друге (решта-решти четвірка))
      (перше (решта-решти четвірка)))))

(визначити початкова-четвірка
  (список (як-є атом?) (як-є тотожне?) (як-є решта) (як-є сполучити)))
(визначити переставлена-четвірка (поміняти-сусідів-четвірки початкова-четвірка))
(визначити відновлена-четвірка (поміняти-сусідів-четвірки переставлена-четвірка))

; Справжній СЕНС Д1: 4 позиції, обернення, негатив неправильного порядку.
(за-умовою
  ((тотожне? (перше переставлена-четвірка) (як-є тотожне?))
   (за-умовою
     ((тотожне? (друге переставлена-четвірка) (як-є атом?))
      (за-умовою
        ((тотожне? (перше (решта-решти переставлена-четвірка)) (як-є сполучити))
         (за-умовою
           ((тотожне? (друге (решта-решти переставлена-четвірка)) (як-є решта))
            (за-умовою
              ((тотожне? (перше відновлена-четвірка) (як-є атом?))
               (за-умовою
                 ((тотожне? (друге (решта-решти відновлена-четвірка)) (як-є сполучити))
                  (за-умовою
                    ((хибне? (тотожне? (перше переставлена-четвірка) (як-є атом?)))
                     (атом? (як-є ())))
                    ((атом? (як-є ())) (перше (як-є ())))))
                 ((атом? (як-є ())) (перше (як-є ())))))
              ((атом? (як-є ())) (перше (як-є ())))))
           ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
