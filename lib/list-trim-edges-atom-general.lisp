; Д3 і Д5: вилучення заданого атома з обох країв правильного списку.
; У середині всі входження і порядок збережені; жоден хост не виконує семантику.
(визначити пропустити-крайні
  (функція (елементи зразок)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((тотожне? (перше елементи) зразок)
       (пропустити-крайні (решта елементи) зразок))
      ((атом? (як-є ())) елементи))))

(визначити обернути-для-країв
  (функція (елементи накопичене)
    (за-умовою
      ((порожній? елементи) накопичене)
      ((атом? (як-є ()))
       (обернути-для-країв (решта елементи)
         (сполучити (перше елементи) накопичене))))))

(визначити очистити-обидва-краї
  (функція (елементи зразок)
    (обернути-для-країв
      (пропустити-крайні
        (обернути-для-країв
          (пропустити-крайні елементи зразок)
          (як-є ()))
        зразок)
      (як-є ()))))

(визначити приклад-країв
  (очистити-обидва-краї
    (список (як-є атом?) (як-є атом?) (як-є решта)
            (як-є атом?) (як-є сполучити) (як-є атом?) (як-є атом?))
    (як-є атом?)))
(визначити лівий-край
  (очистити-обидва-краї
    (список (як-є атом?) (як-є атом?) (як-є решта) (як-є сполучити))
    (як-є атом?)))
(визначити правий-край
  (очистити-обидва-краї
    (список (як-є решта) (як-є сполучити) (як-є атом?) (як-є атом?))
    (як-є атом?)))
(визначити без-збігів
  (очистити-обидва-краї
    (список (як-є решта) (як-є сполучити) (як-є решта))
    (як-є атом?)))
(визначити усе-обрізано
  (очистити-обидва-краї
    (список (як-є атом?) (як-є атом?) (як-є атом?))
    (як-є атом?)))

