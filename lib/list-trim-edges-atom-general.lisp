; Д3/Д5: вилучення заданого атома з обох країв правильного списку.
; У середині всі входження і порядок збережені; жоден хост не виконує семантику.
(визначити пропустити-крайні
  (функція (елементи зразок)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((тотожне? (перше елементи) зразок)
       (пропустити-крайні (решта елементи) зразок))
      ((атом? (як-є ())) елементи))))

; Після пропуску лівого краю робимо один рекурсивний обхід правого.
; Готовий хвіст обчислюється рівно один раз: якщо він порожній, то
; поточний крайній атом відкидаємо лише за точним ТОТОЖНЕ?.
; Немає двох повних розворотів, проміжних перевернутих списків і ПРИЄДНАТИ.
(визначити завершити-правий-край
  (функція (голова готовий-хвіст зразок)
    (за-умовою
      ((порожній? готовий-хвіст)
       (за-умовою
         ((тотожне? голова зразок) (як-є ()))
         (так (список голова))))
      (так (сполучити голова готовий-хвіст)))))

(визначити пропустити-правий-край
  (функція (елементи зразок)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      (так
       (завершити-правий-край
         (перше елементи)
         (пропустити-правий-край (решта елементи) зразок)
         зразок)))))

(визначити очистити-обидва-краї
  (функція (елементи зразок)
    (пропустити-правий-край
      (пропустити-крайні елементи зразок)
      зразок)))

(визначити приклад-країв
  (очистити-обидва-краї
    (список (як-є атом?) (як-є атом?) (як-є решта)
            (як-є атом?) (як-є сполучити) (як-є атом?) (як-є атом?))
    (як-є атом?)))
(визначити лівий-край
  (очистити-обидва-краї
    (список (як-є атом?) (як-є атом?) (як-є решта) (як-є сполучити))
    (як-є атом?)))
(визначити правий-край
  (очистити-обидва-краї
    (список (як-є решта) (як-є сполучити) (як-є атом?) (як-є атом?))
    (як-є атом?)))
(визначити без-збігів
  (очистити-обидва-краї
    (список (як-є решта) (як-є сполучити) (як-є решта))
    (як-є атом?)))
(визначити усе-обрізано
  (очистити-обидва-краї
    (список (як-є атом?) (як-є атом?) (як-є атом?))
    (як-є атом?)))

