; СЕНС: наявний хвіст після першого атомного елемента.
; Один прохід, без сполучити, без копіювання, без хостового оракула.
(визначити хвіст-після-першого-атома
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи)) (решта елементи))
   (так (хвіст-після-першого-атома (решта елементи))))))

; Позитивні крайові закони й негативний контроль виконує сам СЕНС.
(за-умовою
 ((порожній? (хвіст-після-першого-атома (як-є атом?))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-першого-атома (як-є решта))) так)
 (так (перше (як-є ()))))

(за-умовою
 ((порожній? (хвіст-після-першого-атома (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-першого-атома
              (список (список (як-є атом?))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-першого-атома
              (список (як-є атом?)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (хвіст-після-першого-атома
                     (список (як-є атом?) (як-є решта))))
            (як-є решта)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (хвіст-після-першого-атома
                     (список (список (як-є решта))
                             (як-є атом?) (як-є сполучити))))
            (як-є сполучити)) так)
 (так (перше (як-є ()))))
; Порожній елемент є атомом, отже після нього лишається другий елемент.
(за-умовою
 ((тотожне? (перше (хвіст-після-першого-атома
                     (список (як-є ()) (як-є атом?))))
            (як-є атом?)) так)
 (так (перше (як-є ()))))
; Негатив: головний атом не є частиною хвоста.
(за-умовою
 ((хибне? (тотожне? (перше (хвіст-після-першого-атома
                             (список (як-є атом?) (як-є решта))))
                    (як-є атом?))) так)
 (так (перше (як-є ()))))
(атом? (як-є ()))
