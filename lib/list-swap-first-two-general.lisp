; Обмін перших двох елементів без обходу хвоста.
; Порожній та одноелементний списки залишаються незмінними.
; Два обміни відновлюють точний порядок. Лише чинні Д1, Д3 та Д4.
(визначити обміняти-перші-два
  (функція (елементи)
    (за-умовою
      ((атом? елементи) елементи)
      ((атом? (решта елементи)) елементи)
      (так
        (сполучити (перше (решта елементи))
          (сполучити (перше елементи) (решта-решти елементи)))))))
(визначити початкові-елементи
  (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?)))
(визначити після-обміну (обміняти-перші-два початкові-елементи))
(визначити після-двох-обмінів (обміняти-перші-два після-обміну))
; Незалежні точні позиції та негатив: другий став першим,
; перший став другим, третій і четвертий не змінюються.
(за-умовою
  ((тотожне? (перше після-обміну) (як-є решта))
    (за-умовою
      ((тотожне? (друге після-обміну) (як-є атом?))
        (за-умовою
          ((тотожне? (перше (решта-решти після-обміну)) (як-є сполучити))
            (за-умовою
              ((тотожне? (друге (решта-решти після-обміну)) (як-є тотожне?))
                (за-умовою
                  ((тотожне? (перше після-двох-обмінів) (як-є атом?))
                    (за-умовою
                      ((тотожне? (друге після-двох-обмінів) (як-є решта))
                        (хибне? (тотожне? (перше після-обміну) (як-є атом?))))
                      (так (перше (як-є ())))))
                  (так (перше (як-є ())))))
              (так (перше (як-є ())))))
          (так (перше (як-є ())))))
      (так (перше (як-є ())))))
  (так (перше (як-є ()))))
