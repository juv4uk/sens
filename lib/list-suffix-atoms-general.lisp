; Д3 і Д5: зразок є суфіксом скінченного списку точних атомів.
; Реверс обох аргументів зведений до тієї самої структурної перевірки.
(визначити обернути-для-суфікса
  (функція (елементи накопичене)
    (за-умовою
      ((порожній? елементи) накопичене)
      ((атом? (як-є ()))
       (обернути-для-суфікса (решта елементи)
         (сполучити (перше елементи) накопичене))))))
(визначити початок-оберненого-суфікса?
  (функція (зразок елементи)
    (за-умовою
      ((порожній? зразок) так)
      ((порожній? елементи) ні)
      ((тотожне? (перше зразок) (перше елементи))
       (початок-оберненого-суфікса? (решта зразок) (решта елементи)))
      ((атом? (як-є ())) ні))))
(визначити суфікс-атомів?
  (функція (зразок елементи)
    (початок-оберненого-суфікса?
      (обернути-для-суфікса зразок (як-є ()))
      (обернути-для-суфікса елементи (як-є ())))))

