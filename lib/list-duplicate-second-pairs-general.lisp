; СЕНС: дублювати кожен другий атом у послідовних парах.
; (а б в г д) переходить в (а б б в г г д), без індексів і хостової семантики.
; Обернена функція знімає другий примірник, перевіряючи тотожність атомів.
; Д1–Д5 єдині виконавці, Д7 лише проєкція; Zig/T5M пакує фізичні слова.
(визначити подвоїти-других-у-парах
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) елементи)
      (так
        (сполучити (перше елементи)
          (сполучити (друге елементи)
            (сполучити (друге елементи)
              (подвоїти-других-у-парах (решта-решти елементи)))))))))

(визначити прибрати-дублікати-других
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) елементи)
      ((атом? (решта-решти елементи)) (перше (як-є ())))
      ((тотожне? (друге елементи) (третє елементи))
        (сполучити (перше елементи)
          (сполучити (друге елементи)
            (прибрати-дублікати-других (решта (решта-решти елементи))))))
      (так (перше (як-є ()))))))

(визначити вхід-дублювання
  (список (як-є атом?) (як-є решта) (як-є сполучити)
          (як-є тотожне?) (як-є порожній?)))
(визначити подвоєні-елементи (подвоїти-других-у-парах вхід-дублювання))
(визначити повернені-елементи (прибрати-дублікати-других подвоєні-елементи))

; Доведення: усі позиції виходу, п'ять вихідних позицій після
; обернення, непарний хвіст, порожні й одиночні входи та негатив.
(за-умовою
  ((тотожне? (перше подвоєні-елементи) (як-є атом?)) (за-умовою
  ((тотожне? (перше (решта подвоєні-елементи)) (як-є решта)) (за-умовою
  ((тотожне? (перше (решта (решта подвоєні-елементи))) (як-є решта)) (за-умовою
  ((тотожне? (перше (решта (решта (решта подвоєні-елементи)))) (як-є сполучити)) (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта подвоєні-елементи))))) (як-є тотожне?)) (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта (решта подвоєні-елементи)))))) (як-є тотожне?)) (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта (решта (решта подвоєні-елементи))))))) (як-є порожній?)) (за-умовою
  ((тотожне? (перше повернені-елементи) (як-є атом?)) (за-умовою
  ((тотожне? (перше (решта повернені-елементи)) (як-є решта)) (за-умовою
  ((тотожне? (перше (решта (решта повернені-елементи))) (як-є сполучити)) (за-умовою
  ((тотожне? (перше (решта (решта (решта повернені-елементи)))) (як-є тотожне?)) (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта повернені-елементи))))) (як-є порожній?)) (за-умовою
  ((порожній? (решта (решта (решта (решта (решта повернені-елементи)))))) (за-умовою
  ((порожній? (подвоїти-других-у-парах (як-є ()))) (за-умовою
  ((порожній? (прибрати-дублікати-других (як-є ()))) (за-умовою
  ((тотожне? (перше (подвоїти-других-у-парах (список (як-є атом?)))) (як-є атом?)) (за-умовою
  ((хибне? (тотожне? (друге подвоєні-елементи) (як-є атом?))) так)
