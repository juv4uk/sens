; Обернена рекурсивна декомпозиція скінченного списку довільної довжини.
; Д3 і Д4: вибрати непарні й парні позиції, потім відновити порядок.
; порожній, одноелементний, парний і непарний випадки; без зовнішнє-логіки.
(визначити вибрати-непарні-позиції
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) (список (перше елементи)))
      ((атом? (як-є ()))
        (сполучити (перше елементи)
          (вибрати-непарні-позиції (решта-решти елементи)))))))

(визначити вибрати-парні-позиції
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) (як-є ()))
      ((атом? (як-є ()))
        (сполучити (друге елементи)
          (вибрати-парні-позиції (решта-решти елементи)))))))

(визначити відновити-чергування
  (функція (непарні парні)
    (за-умовою
      ((атом? непарні) парні)
      ((атом? парні) непарні)
      ((атом? (як-є ()))
        (сполучити (перше непарні)
          (сполучити (перше парні)
            (відновити-чергування (решта непарні) (решта парні))))))))

(визначити початковий-список
  (список (як-є атом?) (як-є тотожне?) (як-є решта) (як-є сполучити) (як-є за-умовою)))
(визначити непарні-позиції (вибрати-непарні-позиції початковий-список))
(визначити парні-позиції (вибрати-парні-позиції початковий-список))
(визначити відновлений-список
  (відновити-чергування непарні-позиції парні-позиції))

; 5 відновлених позицій, 3+2 проєкції, порожній, одиничний випадок,
; точні довжини та два негативи. При порушенні - хибна гілка аварійна.
(за-умовою
  ((тотожне? (перше відновлений-список) (як-є атом?)) (за-умовою
  ((тотожне? (перше (решта відновлений-список)) (як-є тотожне?)) (за-умовою
  ((тотожне? (перше (решта (решта відновлений-список))) (як-є решта)) (за-умовою
  ((тотожне? (перше (решта (решта (решта відновлений-список)))) (як-є сполучити)) (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта відновлений-список))))) (як-є за-умовою)) (за-умовою
  ((тотожне? (перше непарні-позиції) (як-є атом?)) (за-умовою
  ((тотожне? (перше (решта непарні-позиції)) (як-є решта)) (за-умовою
  ((тотожне? (перше (решта (решта непарні-позиції))) (як-є за-умовою)) (за-умовою
  ((тотожне? (перше парні-позиції) (як-є тотожне?)) (за-умовою
  ((тотожне? (перше (решта парні-позиції)) (як-є сполучити)) (за-умовою
  ((атом? (решта (решта (решта непарні-позиції)))) (за-умовою
  ((атом? (решта (решта парні-позиції))) (за-умовою
  ((атом? (вибрати-непарні-позиції (як-є ()))) (за-умовою
  ((атом? (вибрати-парні-позиції (як-є ()))) (за-умовою
  ((атом? (відновити-чергування (як-є ()) (як-є ()))) (за-умовою
  ((тотожне? (перше (вибрати-непарні-позиції (список (як-є атом?)))) (як-є атом?)) (за-умовою
  ((атом? (вибрати-парні-позиції (список (як-є атом?)))) (за-умовою
  ((хибне? (тотожне? (перше відновлений-список) (як-є сполучити))) (за-умовою
  ((хибне? (тотожне? (перше парні-позиції) (як-є атом?))) (атом? (як-є ())))
