; СЕНС: безкопійний хвіст після першої трійки однакових атомів.
; Для скінченного списку атомів, без створення проміжних списків.
(визначити хвіст-після-першої-трійки
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) (як-є ()))
      ((атом? (решта (решта елементи))) (як-є ()))
      ((тотожне? (перше елементи) (перше (решта елементи)))
        (за-умовою
          ((тотожне? (перше елементи) (перше (решта (решта елементи))))
            (решта (решта (решта елементи))))
          (так (хвіст-після-першої-трійки (решта елементи)))))
      (так (хвіст-після-першої-трійки (решта елементи))))))

; Порожній, короткий та безтрійковий вхід повертають порожнє.
(за-умовою
  ((атом? (хвіст-після-першої-трійки (як-є ()))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((атом? (хвіст-після-першої-трійки
      (список (як-є атом?) (як-є атом?)))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((атом? (хвіст-після-першої-трійки
      (список (як-є атом?) (як-є атом?) (як-є решта) (як-є решта)))) так)
  (так (перше (як-є ()))))

; Перша трійка на початку зберігає точний вихідний хвіст.
(за-умовою
  ((тотожне?
    (перше (хвіст-після-першої-трійки
      (список (як-є атом?) (як-є атом?) (як-є атом?)
              (як-є решта) (як-є сполучити))))
    (як-є решта)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне?
    (перше (решта (хвіст-після-першої-трійки
      (список (як-є атом?) (як-є атом?) (як-є атом?)
              (як-є решта) (як-є сполучити)))))
    (як-є сполучити)) так)
  (так (перше (як-є ()))))

; Пошук після відмінного атома та перекриття двох пар.
(за-умовою
  ((тотожне?
    (перше (хвіст-після-першої-трійки
      (список (як-є решта) (як-є атом?) (як-є атом?)
              (як-є атом?) (як-є тотожне?))))
    (як-є тотожне?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне?
    (перше (хвіст-після-першої-трійки
      (список (як-є атом?) (як-є атом?) (як-є решта)
              (як-є решта) (як-є решта) (як-є сполучити))))
    (як-є сполучити)) так)
  (так (перше (як-є ()))))

; Трійка наприкінці повертає порожнє, а не попередній атом.
(за-умовою
  ((атом? (хвіст-після-першої-трійки
      (список (як-є решта) (як-є атом?) (як-є атом?) (як-є атом?)))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне?
    (тотожне?
      (перше (хвіст-після-першої-трійки
        (список (як-є атом?) (як-є атом?) (як-є атом?)
                (як-є решта))))
      (як-є атом?))) так)
  (так (перше (як-є ()))))
(атом? (як-є ()))
