  (дерево-містить-атом? тестове-дерево-пошуку (як-є тотожне?)))
(перевірити-пошук-у-дереві
  (хибне? (дерево-містить-атом? тестове-дерево-пошуку (як-є за-умовою))))
(перевірити-пошук-у-дереві
  (хибне? (дерево-містить-атом? (список (як-є ()) (список (як-є ()))) (як-є атом?))))
