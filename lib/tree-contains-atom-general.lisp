; Д3/Д5: пошук точного атома у скінченному дереві списків.
; Порожні вузли пропускаємо, EQ викликаємо лише для двох атомів.
; Рекурсія і коротке замикання належать самому SENS, не Python/JSON/Zig.

(визначити дерево-містить-атом?
  (функція (дерево шукане)
    (за-умовою
      ((порожній? дерево) ні)
      ((атом? дерево) (тотожне? дерево шукане))
      ((дерево-містить-атом? (перше дерево) шукане) так)
      ((атом? (як-є ()))
       (дерево-містить-атом? (решта дерево) шукане)))))

(визначити перевірити-пошук-у-дереві
  (функція (правда)
    (за-умовою
      (правда (атом? (як-є ())))
      ((атом? (як-є ())) (перше (як-є ()))))))

(визначити тестове-дерево-пошуку
  (список
    (як-є ())
    (список (як-є атом?)
            (список (як-є решта) (як-є сполучити)))
    (як-є ())
    (список (список (як-є тотожне?)))))

; Усі перевірки виконує справжній SENS D1/D3/D5.
; За невідповідності — явна помилка ПЕРШЕ порожнього списку.
(перевірити-пошук-у-дереві
