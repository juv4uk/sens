; СЕНС: оборотне розділення четвірки на непарні й парні позиції.
; Четвірка стає двома черговими парами та відновлюється.
; Область: правильний список рівно з чотирьох елементів.

(визначити розділити-через-один-четвірку
  (функція (четвірка)
    (список
      (список (перше четвірка) (третє четвірка))
      (список (друге четвірка) (четверте четвірка)))))

(визначити зібрати-через-один-четвірку
  (функція (пари)
    (список
      (перше (перше пари))
      (перше (друге пари))
      (друге (перше пари))
      (друге (друге пари)))))

(визначити початкова-чергова-четвірка (список (як-є атом?) (як-є тотожне?) (як-є решта) (як-є сполучити)))
(визначити непарні-парні-пари
  (розділити-через-один-четвірку початкова-чергова-четвірка))
(визначити відновлена-чергова-четвірка
  (зібрати-через-один-четвірку непарні-парні-пари))

; Нативний Д1-свідок обох пар, повного відновлення і негативної перестановки.
(за-умовою
  ((тотожне? (перше (перше непарні-парні-пари)) (як-є атом?))
   (за-умовою
  ((тотожне? (друге (перше непарні-парні-пари)) (як-є решта))
   (за-умовою
  ((тотожне? (перше (друге непарні-парні-пари)) (як-є тотожне?))
   (за-умовою
  ((тотожне? (друге (друге непарні-парні-пари)) (як-є сполучити))
   (за-умовою
  ((тотожне? (перше відновлена-чергова-четвірка) (як-є атом?))
   (за-умовою
  ((тотожне? (друге відновлена-чергова-четвірка) (як-є тотожне?))
   (за-умовою
  ((тотожне? (третє відновлена-чергова-четвірка) (як-є решта))
   (за-умовою
  ((тотожне? (четверте відновлена-чергова-четвірка) (як-є сполучити))
   (за-умовою
  ((хибне? (тотожне? (друге (перше непарні-парні-пари)) (як-є тотожне?)))
   (атом? (як-є ())))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ())))))

; Другий незалежний вхід: обернена композиція має працювати не лише
; для зафіксованої четвірки вище. Семантика належить Д3 і Д4 СЕНС.
(визначити інша-чергова-четвірка
  (список (як-є за-умовою) (як-є сполучити) (як-є атом?) (як-є решта)))
(визначити друга-відновлена-чергова-четвірка
  (зібрати-через-один-четвірку
    (розділити-через-один-четвірку інша-чергова-четвірка)))
(за-умовою
  ((тотожне? (перше друга-відновлена-чергова-четвірка) (як-є за-умовою))
   (за-умовою
     ((тотожне? (четверте друга-відновлена-чергова-четвірка) (як-є решта))
      (хибне? (тотожне? (друге друга-відновлена-чергова-четвірка) (як-є атом?))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
