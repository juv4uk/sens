
(00001001 C1-SECOND
  (00001000 (X)
    (00000101 (00000110 X))))

(00001001 C1-THIRD
  (00001000 (X)
    (00000101 (00000110 (00000110 X)))))

(00001001 C1-FOURTH
  (00001000 (X)
    (00000101 (00000110 (00000110 (00000110 X))))))

(00001001 C1-MAKE-ERROR
  (00001000 (KIND DETAIL)
    (00000100 (00000001 C1-ERROR)
      (00000100 KIND
        (00000100 DETAIL NIL)))))

(00001001 C1-ERRORP
  (00001000 (VALUE)
    (00000111
      ((00000010 VALUE) NIL)
      ((00000011 (00000101 VALUE) (00000001 C1-ERROR)) T)
      (T NIL))))

(00001001 C1-MAKE-FOUND
  (00001000 (VALUE)
    (00000100 (00000001 C1-FOUND)
      (00000100 VALUE NIL))))

(00001001 C1-FOUNDP
  (00001000 (VALUE)
    (00000111
      ((00000010 VALUE) NIL)
      ((00000011 (00000101 VALUE) (00000001 C1-FOUND)) T)
