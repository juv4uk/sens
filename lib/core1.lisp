(00001001 C1-EVAL
  (10101010 C1-EVAL
    (00001000 (EXPR ENV GLOBAL)
      (00000111
        ((00000010 EXPR)
         (00000111
           ((00000011 EXPR NIL) NIL)
           ((00000011 EXPR (00000001 nil)) NIL)
           ((00000011 EXPR T) T)
           ((00000011 EXPR (00000001 t)) T)
           ((C1-ADMITTED-SID-VALUEP EXPR) EXPR)
           (T (C1-LOOKUP EXPR ENV GLOBAL))))
        ((C1-QUOTE-NAMEP (00000101 EXPR))
         (C1-SECOND EXPR))
        ((C1-COND-NAMEP (00000101 EXPR))
         (C1-EVCON (00000110 EXPR) ENV GLOBAL))
        ((C1-LABEL-NAMEP (00000101 EXPR))
         (C1-EVAL (C1-THIRD EXPR) ENV GLOBAL))
        ((C1-LAMBDA-NAMEP (00000101 EXPR))
         (FUNCTION
           (00001000 (ARGS GLOBAL-AT-CALL)
             ((00001000 (BOUND)
                (00000111
                  ((C1-ERRORP BOUND) BOUND)
                  (T
                   (C1-EVAL
                     (C1-THIRD EXPR)
                     BOUND
                     GLOBAL-AT-CALL))))
              (C1-BIND
                (C1-SECOND EXPR)
                ARGS
                ENV)))))
        ((C1-DEFINE-NAMEP (00000101 EXPR))
         (C1-MAKE-ERROR
           (00000001 INVALID-FORM)
           (00000001 DEFINE-IS-TOP-LEVEL-ONLY)))
        (T
         ((00001000 (FN)
            (00000111
              ((C1-ERRORP FN) FN)
              (T
               ((00001000 (ARGS)
                  (00000111
                    ((C1-ERRORP ARGS) ARGS)
                    (T (C1-APPLY FN ARGS GLOBAL))))
                (C1-EVLIS (00000110 EXPR) ENV GLOBAL)))))
          (C1-EVAL (00000101 EXPR) ENV GLOBAL)))))))

(00001001 C1-MAKE-WORLD
  (00001000 (VALUE GLOBAL)
    (00000100 (00000001 C1-WORLD)
      (00000100 VALUE
        (00000100 GLOBAL NIL)))))

(00001001 C1-WORLD-VALUE
  (00001000 (WORLD)
    (C1-SECOND WORLD)))

(00001001 C1-WORLD-GLOBAL
  (00001000 (WORLD)
    (C1-THIRD WORLD)))

(00001001 C1-DEFINITIONP
  (00001000 (FORM)
    (00000111
      ((00000010 FORM) NIL)
      ((C1-DEFINE-NAMEP (00000101 FORM)) T)
      (T NIL))))

(00001001 C1-EVAL-PROGRAM
  (10101010 C1-EVAL-PROGRAM
    (00001000 (FORMS GLOBAL)
      (00000111
        ((00000011 FORMS NIL)
         (C1-MAKE-WORLD NIL GLOBAL))
        ((C1-DEFINITIONP (00000101 FORMS))
         ((00001000 (FORM)
            ((00001000 (VALUE)
               (00000111
                 ((C1-ERRORP VALUE)
                  (C1-MAKE-WORLD VALUE GLOBAL))
                 (T
                  (C1-EVAL-PROGRAM
                    (00000110 FORMS)
                    (00000100
                      (00000100 (C1-SECOND FORM) VALUE)
                      GLOBAL)))))
             (C1-EVAL (C1-THIRD FORM) NIL GLOBAL)))
          (00000101 FORMS)))
        ((00000011 (00000110 FORMS) NIL)
         (C1-MAKE-WORLD
           (C1-EVAL (00000101 FORMS) NIL GLOBAL)
           GLOBAL))
        (T
         ((00001000 (VALUE)
            (00000111
              ((C1-ERRORP VALUE)
               (C1-MAKE-WORLD VALUE GLOBAL))
              (T
               (C1-EVAL-PROGRAM
                 (00000110 FORMS)
                 GLOBAL))))
          (C1-EVAL (00000101 FORMS) NIL GLOBAL)))))))

(00001001 C1-WORLD-EVAL
  (00001000 (WORLD EXPR)
    (C1-MAKE-WORLD
      (C1-EVAL EXPR NIL (C1-WORLD-GLOBAL WORLD))
      (C1-WORLD-GLOBAL WORLD))))

(00001001 C1-EVAL-PROGRAM-THEN
  (00001000 (FORMS EXPR)
    ((00001000 (WORLD)
       (C1-WORLD-VALUE
         (C1-WORLD-EVAL WORLD EXPR)))
     (C1-EVAL-PROGRAM FORMS NIL))))
