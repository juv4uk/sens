(00001001 C1-DEFAULT
  (00001000 (NAME)
    ((00001000 (IDENTITY)
       (00000111
         ((00000011 IDENTITY NIL)
          (C1-MAKE-ERROR (00000001 UNBOUND) NAME))
         (T IDENTITY)))
     (C1-PRIMITIVE-IDENTITY NAME))))

(00001001 C1-LOOKUP
  (00001000 (NAME ENV GLOBAL)
    ((00001000 (LOCAL)
       (00000111
         ((C1-FOUNDP LOCAL) (C1-FOUND-VALUE LOCAL))
         (T
          ((00001000 (TOP)
             (00000111
               ((C1-FOUNDP TOP) (C1-FOUND-VALUE TOP))
               (T (C1-DEFAULT NAME))))
           (C1-LOOKUP-IN NAME GLOBAL)))))
     (C1-LOOKUP-IN NAME ENV))))

(00001001 C1-FUNARGP
  (00001000 (VALUE)
    (00000111
      ((00000010 VALUE) NIL)
      ((00000011 (00000101 VALUE) (00000001 FUNARG)) T)
      (T NIL))))

(00001001 C1-ONE-ARGP
  (00001000 (ARGS)
    (00000111
      ((00000010 ARGS) NIL)
      ((00000011 (00000110 ARGS) NIL) T)
      (T NIL))))

(00001001 C1-TWO-ARGP
  (00001000 (ARGS)
    (00000111
      ((00000010 ARGS) NIL)
      ((00000010 (00000110 ARGS)) NIL)
      ((00000011 (00000110 (00000110 ARGS)) NIL) T)
      (T NIL))))

(00001001 C1-BIND
  (10101010 C1-BIND
    (00001000 (PARAMS ARGS ENV)
      (00000111
        ((00000011 PARAMS NIL)
         (00000111
           ((00000011 ARGS NIL) ENV)
           (T (C1-MAKE-ERROR (00000001 ARITY) (00000001 TOO-MANY-ARGUMENTS)))))
        ((00000011 ARGS NIL)
         (C1-MAKE-ERROR (00000001 ARITY) (00000001 TOO-FEW-ARGUMENTS)))
        (T
         (C1-BIND
           (00000110 PARAMS)
           (00000110 ARGS)
           (00000100 (00000100 (00000101 PARAMS) (00000101 ARGS)) ENV)))))))

(00001001 C1-APPLY-PRIMITIVE
  (00001000 (SID ARGS)
    (00000111
      ((00000011 SID 00100111) ARGS)
      ((00000011 SID 00100001)
       (00000111
         ((C1-ONE-ARGP ARGS)
          (00000111
            ((00000011 (00000101 ARGS) NIL) T)
            (T NIL)))
         (T (C1-MAKE-ERROR (00000001 ARITY) SID))))
      ((00000011 SID 00000010)
       (00000111
         ((C1-ONE-ARGP ARGS) (00000010 (00000101 ARGS)))
         (T (C1-MAKE-ERROR (00000001 ARITY) SID))))
      ((00000011 SID 00000011)
       (00000111
         ((C1-TWO-ARGP ARGS) (00000011 (00000101 ARGS) (00000101 (00000110 ARGS))))
         (T (C1-MAKE-ERROR (00000001 ARITY) SID))))
      ((00000011 SID 00000100)
       (00000111
         ((C1-TWO-ARGP ARGS) (00000100 (00000101 ARGS) (00000101 (00000110 ARGS))))
         (T (C1-MAKE-ERROR (00000001 ARITY) SID))))
      ((00000011 SID 00000101)
       (00000111
         ((C1-ONE-ARGP ARGS)
          (00000111
            ((00000010 (00000101 ARGS))
             (C1-MAKE-ERROR (00000001 TYPE) (00000001 CAR-REQUIRES-PAIR)))
            (T (00000101 (00000101 ARGS)))))
         (T (C1-MAKE-ERROR (00000001 ARITY) SID))))
      ((00000011 SID 00000110)
       (00000111
         ((C1-ONE-ARGP ARGS)
          (00000111
            ((00000010 (00000101 ARGS))
             (C1-MAKE-ERROR (00000001 TYPE) (00000001 CDR-REQUIRES-PAIR)))
            (T (00000110 (00000101 ARGS)))))
         (T (C1-MAKE-ERROR (00000001 ARITY) SID))))
      (T
       (C1-MAKE-ERROR (00000001 UNSUPPORTED-PRIMITIVE) SID)))))

(00001001 C1-EVLIS
  (10101010 C1-EVLIS
    (00001000 (FORMS ENV GLOBAL)
      (00000111
        ((00000011 FORMS NIL) NIL)
        (T
         ((00001000 (FIRST)
            (00000111
              ((C1-ERRORP FIRST) FIRST)
              (T
               ((00001000 (REST)
                  (00000111
                    ((C1-ERRORP REST) REST)
                    (T (00000100 FIRST REST))))
                (C1-EVLIS (00000110 FORMS) ENV GLOBAL)))))
          (C1-EVAL (00000101 FORMS) ENV GLOBAL)))))))

(00001001 C1-EVCON
  (10101010 C1-EVCON
    (00001000 (CLAUSES ENV GLOBAL)
      (00000111
        ((00000011 CLAUSES NIL)
         (C1-MAKE-ERROR (00000001 UNSATISFIED-CONDITIONAL) NIL))
        (T
         ((00001000 (TEST-VALUE)
            (00000111
              ((C1-ERRORP TEST-VALUE) TEST-VALUE)
              ((00000011 TEST-VALUE NIL)
               (C1-EVCON (00000110 CLAUSES) ENV GLOBAL))
              (T
               (C1-EVAL
                 (C1-SECOND (00000101 CLAUSES))
                 ENV
                 GLOBAL))))
          (C1-EVAL
            (00000101 (00000101 CLAUSES))
            ENV
            GLOBAL)))))))

(00001001 C1-APPLY
  (00001000 (FN ARGS GLOBAL)
    (00000111
      ((C1-ERRORP FN) FN)
      ((C1-PRIMITIVE-IDENTITY FN)
       (C1-APPLY-PRIMITIVE (C1-PRIMITIVE-IDENTITY FN) ARGS))
      ((C1-FUNARGP FN)
       (FN ARGS GLOBAL))
      (T
       (C1-MAKE-ERROR (00000001 NOT-CALLABLE) FN)))))

