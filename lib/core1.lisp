; Перший профіль обчислювача СЕНС на точних доменах.
;
; Канонічне значення істини належить однобітному домену.
; Межу слова визначає структура запису, а не текстовий тег ширини.
; Старий читач цього профілю ще розрізняє число та однобітний
; предикат через тимчасове позначення. Таке позначення не є законом мови.
; Прибирати його можна лише після переходу конкретного читача
; на точнодоменне дерево й підтвердження справжнім виконанням СЕНС.
; Структурна порожнеча третього домену не дорівнює логічній хибі.
;
; Тут збережено дисципліну двопольових умов та відсутність
; самовільних перетворень між доменами різної ширини.
; Послідовні вибірки другого і третього елементів спираються
; на вже ратифіковані селектори четвертого й п'ятого доменів.
; Дев'ять внутрішніх звернень уже використовують ці селектори.
; Для четвертого елемента дозволено композицію з третього
; та п'ятого доменів. Резидент шостого домену без виконуваного
; механізму не стає викликуваним через саме існування адреси.
;
; Фізичні свідчення охоплюють вибірки, перевірку кількості
; аргументів, допуск історичних слів і структуру знайденого.
; Відмінності історичних результатів від однобітної хиби
; необхідно зберігати як спостережувані відмінності.
; Цитовані мітки записів не можна довільно вважати атомами
; чи порівнювати як атоми без доведеного закону даних.
;
; Старі назви деяких внутрішніх визначень ще потрібні
; історичним споживачам. Вони не ратифікують нових функцій.
; Повного перенесення всього профілю ще не доведено.
; Жодних нових примітивів, неявної викликуваності
; чи дублювання текстом машинних функцій не додається.

(визначити ядро1-другий-елемент
  (функція (значення)
    (друге значення)))

(визначити ядро1-третій-елемент
  (функція (значення)
    (третє значення)))

(визначити ядро1-четвертий-елемент
  (функція (значення)
    (третє (решта значення))))

(визначити ядро1-створити-помилку
  (функція (вид подробиці)
    (сполучити (як-є C1-ERROR)
      (сполучити вид
        (сполучити подробиці (як-є ()))))))

(визначити ядро1-помилка?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((тотожне? (перше значення) (як-є C1-ERROR)) так)
      (так ні))))

(визначити ядро1-створити-знайдене
  (функція (значення)
    (сполучити (як-є C1-FOUND)
      (сполучити значення (як-є ())))))

(визначити ядро1-знайдено?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((тотожне? (перше значення) (як-є C1-FOUND)) так)
      (так ні))))

(визначити ядро1-значення-знайденого
  (функція (значення)
    (друге значення)))

(визначити ядро1-знайти-в-оточенні
  (мітка ядро1-знайти-в-оточенні
    (функція (назва оточення)
      (за-умовою
        ((тотожне? оточення (як-є ())) (як-є C1-MISSING))
        ((тотожне? (перше (перше оточення)) назва)
         (ядро1-створити-знайдене (решта (перше оточення))))
        (так
         (ядро1-знайти-в-оточенні назва (решта оточення)))))))

(визначити ядро1-допущене-історичне-слово?
  (функція (величина)
    (за-умовою
      ((тотожне? величина 001) так)
      ((тотожне? величина 010) так)
      ((тотожне? величина 101) так)
      ((тотожне? величина 111) так)
      ((тотожне? величина 100) так)
      ((тотожне? величина 011) так)
      ((тотожне? величина 110) так)
      ((тотожне? величина 0010) так)
      ((тотожне? величина 0011) так)
      ((тотожне? величина 01010) так)
      ((тотожне? величина 01011) так)
      ((тотожне? величина 0100) так)
      ((тотожне? величина 1110) так)
      (так (як-є ())))))

(визначити ядро1-історична-тотожність-примітива
  (функція (назва)
    (за-умовою
      ((тотожне? назва 010) 010)
      ((тотожне? назва 101) 101)
      ((тотожне? назва 111) 111)
      ((тотожне? назва 100) 100)
      ((тотожне? назва 011) 011)
      ((тотожне? назва 0100) 0100)
      ((тотожне? назва 1110) 1110)
      ((тотожне? назва (як-є ATOM)) 010)
      ((тотожне? назва (як-є atom)) 010)
      ((тотожне? назва (як-є EQ))   101)
      ((тотожне? назва (як-є eq))   101)
      ((тотожне? назва (як-є CONS)) 111)
      ((тотожне? назва (як-є cons)) 111)
      ((тотожне? назва (як-є CAR))  100)
      ((тотожне? назва (як-є car))  100)
      ((тотожне? назва (як-є CDR))  011)
      ((тотожне? назва (як-є cdr))  011)
      ((тотожне? назва (як-є LIST)) 1110)
      ((тотожне? назва (як-є list)) 1110)
      ((тотожне? назва (як-є NOT))  0100)
      ((тотожне? назва (як-є not))  0100)
      (так (як-є ())))))

(визначити ядро1-значення-за-замовчуванням
  (функція (назва)
    ((функція (тотожність-слова)
       (за-умовою
         ((тотожне? тотожність-слова (як-є ()))
          (ядро1-створити-помилку (як-є UNBOUND) назва))
         (так тотожність-слова)))
     (ядро1-історична-тотожність-примітива назва))))

(визначити ядро1-знайти-значення
  (функція (назва оточення глобальне-оточення)
    ((функція (локальне)
       (за-умовою
         ((ядро1-знайдено? локальне) (ядро1-значення-знайденого локальне))
         (так
          ((функція (верхнє)
             (за-умовою
               ((ядро1-знайдено? верхнє) (ядро1-значення-знайденого верхнє))
               (так (ядро1-значення-за-замовчуванням назва))))
           (ядро1-знайти-в-оточенні назва глобальне-оточення)))))
     (ядро1-знайти-в-оточенні назва оточення))))

(визначити ядро1-функціональний-аргумент?
  (функція (величина)
    (за-умовою
      ((атом? величина) ні)
      ((тотожне? (перше величина) (як-є FUNARG)) так)
      (так ні))))

(визначити ядро1-один-аргумент?
  (функція (аргументи)
    (за-умовою
      ((атом? аргументи) ні)
      ((тотожне? (решта аргументи) (як-є ())) так)
      (так ні))))

(визначити ядро1-два-аргументи?
  (функція (аргументи)
    (за-умовою
      ((атом? аргументи) ні)
      ((атом? (решта аргументи)) ні)
      ((тотожне? (решта (решта аргументи)) (як-є ())) так)
      (так ні))))

(визначити ядро1-поєднати-параметри
  (мітка ядро1-поєднати-параметри
    (функція (параметри аргументи оточення)
      (за-умовою
        ((тотожне? параметри (як-є ()))
         (за-умовою
           ((тотожне? аргументи (як-є ())) оточення)
           (так (ядро1-створити-помилку (як-є ARITY) (як-є TOO-MANY-ARGUMENTS)))))
        ((тотожне? аргументи (як-є ()))
         (ядро1-створити-помилку (як-є ARITY) (як-є TOO-FEW-ARGUMENTS)))
        (так
         (ядро1-поєднати-параметри
           (решта параметри)
           (решта аргументи)
           (сполучити (сполучити (перше параметри) (перше аргументи)) оточення)))))))

(визначити ядро1-застосувати-примітив
  (функція (ідентифікатор аргументи)
    (за-умовою
      ((тотожне? ідентифікатор 1110) аргументи)
      ((тотожне? ідентифікатор 0100)
       (за-умовою
         ((ядро1-один-аргумент? аргументи)
          (за-умовою
            ((тотожне? (перше аргументи) (як-є ())) так)
            (так (як-є ()))))
         (так (ядро1-створити-помилку (як-є ARITY) ідентифікатор))))
      ((тотожне? ідентифікатор 010)
       (за-умовою
         ((ядро1-один-аргумент? аргументи) (атом? (перше аргументи)))
         (так (ядро1-створити-помилку (як-є ARITY) ідентифікатор))))
      ((тотожне? ідентифікатор 101)
       (за-умовою
         ((ядро1-два-аргументи? аргументи) (тотожне? (перше аргументи) (перше (решта аргументи))))
         (так (ядро1-створити-помилку (як-є ARITY) ідентифікатор))))
      ((тотожне? ідентифікатор 111)
       (за-умовою
         ((ядро1-два-аргументи? аргументи) (сполучити (перше аргументи) (перше (решта аргументи))))
         (так (ядро1-створити-помилку (як-є ARITY) ідентифікатор))))
      ((тотожне? ідентифікатор 100)
       (за-умовою
         ((ядро1-один-аргумент? аргументи)
          (за-умовою
            ((атом? (перше аргументи))
             (ядро1-створити-помилку (як-є TYPE) (як-є CAR-REQUIRES-PAIR)))
            (так (перше (перше аргументи)))))
         (так (ядро1-створити-помилку (як-є ARITY) ідентифікатор))))
      ((тотожне? ідентифікатор 011)
       (за-умовою
         ((ядро1-один-аргумент? аргументи)
          (за-умовою
            ((атом? (перше аргументи))
             (ядро1-створити-помилку (як-є TYPE) (як-є CDR-REQUIRES-PAIR)))
            (так (решта (перше аргументи)))))
         (так (ядро1-створити-помилку (як-є ARITY) ідентифікатор))))
      (так
       (ядро1-створити-помилку (як-є UNSUPPORTED-PRIMITIVE) ідентифікатор)))))

(визначити ядро1-обчислити-аргументи
  (мітка ядро1-обчислити-аргументи
    (функція (форми оточення глобальне-оточення)
      (за-умовою
        ((тотожне? форми (як-є ())) (як-є ()))
        (так
         ((функція (перший-результат)
            (за-умовою
              ((ядро1-помилка? перший-результат) перший-результат)
              (так
               ((функція (решта-результатів)
                  (за-умовою
                    ((ядро1-помилка? решта-результатів) решта-результатів)
                    (так (сполучити перший-результат решта-результатів))))
                (ядро1-обчислити-аргументи (решта форми) оточення глобальне-оточення)))))
          (ядро1-обчислити (перше форми) оточення глобальне-оточення)))))))

(визначити ядро1-обчислити-умови
  (мітка ядро1-обчислити-умови
    (функція (умови оточення глобальне-оточення)
      (за-умовою
        ((тотожне? умови (як-є ()))
         (ядро1-створити-помилку (як-є UNSATISFIED-CONDITIONAL) (як-є ())))
        (так
         ((функція (значення-перевірки)
            (за-умовою
              ((ядро1-помилка? значення-перевірки) значення-перевірки)
              ((тотожне? значення-перевірки (як-є ()))
               (ядро1-обчислити-умови (решта умови) оточення глобальне-оточення))
              (так
               (ядро1-обчислити
                 (друге (перше умови))
                 оточення
                 глобальне-оточення))))
          (ядро1-обчислити
            (перше (перше умови))
            оточення
            глобальне-оточення)))))))

(визначити ядро1-застосувати
  (функція (викликана-функція аргументи глобальне-оточення)
    (за-умовою
      ((ядро1-помилка? викликана-функція) викликана-функція)
      ((ядро1-історична-тотожність-примітива викликана-функція)
       (ядро1-застосувати-примітив (ядро1-історична-тотожність-примітива викликана-функція) аргументи))
      ((ядро1-функціональний-аргумент? викликана-функція)
       (викликана-функція аргументи глобальне-оточення))
      (так
       (ядро1-створити-помилку (як-є NOT-CALLABLE) викликана-функція)))))

(визначити ядро1-назва-цитування?
  (функція (назва)
    (за-умовою
      ((тотожне? назва 001) так)
      ((тотожне? назва (як-є QUOTE)) так)
      ((тотожне? назва (як-є quote)) так)
      (так ні))))

(визначити ядро1-назва-умови?
  (функція (назва)
    (за-умовою
      ((тотожне? назва 110) так)
