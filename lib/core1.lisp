(00001001 C1-PRIMITIVE-IDENTITY
  (00001000 (NAME)
    (00000111
      ((00000011 NAME 00000010) 00000010)
      ((00000011 NAME 00000011) 00000011)
      ((00000011 NAME 00000100) 00000100)
      ((00000011 NAME 00000101) 00000101)
      ((00000011 NAME 00000110) 00000110)
      ((00000011 NAME 00100001) 00100001)
      ((00000011 NAME 00100111) 00100111)
      ((00000011 NAME (00000001 ATOM)) 00000010)
      ((00000011 NAME (00000001 atom)) 00000010)
      ((00000011 NAME (00000001 EQ))   00000011)
      ((00000011 NAME (00000001 eq))   00000011)
      ((00000011 NAME (00000001 CONS)) 00000100)
      ((00000011 NAME (00000001 cons)) 00000100)
      ((00000011 NAME (00000001 CAR))  00000101)
      ((00000011 NAME (00000001 car))  00000101)
      ((00000011 NAME (00000001 CDR))  00000110)
      ((00000011 NAME (00000001 cdr))  00000110)
      ((00000011 NAME (00000001 LIST)) 00100111)
      ((00000011 NAME (00000001 list)) 00100111)
      ((00000011 NAME (00000001 NOT))  00100001)
