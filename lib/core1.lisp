; Перший профіль обчислювача СЕНС на точних доменах.
;
; Чинність визначає точний домен і закон, а не бітовий збіг.
; D1 зберігає логічну хибу, D3 — порожню структуру,
; D12+ — математичні числа, зокрема нуль. Нульова адреса
; належить машинному runtime і не є числовим значенням SENS.
; Десятковий запис чисел — людська проєкція, не фізична мова.
;
; Тут збережено дисципліну двопольових умов та відсутність
; самовільних перетворень між доменами різної ширини.
; Послідовні вибірки другого і третього елементів спираються
; на вже ратифіковані селектори четвертого й п'ятого доменів.
; Дев'ять внутрішніх звернень уже використовують ці селектори.
; Для четвертого елемента дозволено композицію з третього
; та п'ятого доменів. Резидент шостого домену без виконуваного
; механізму не стає викликуваним через саме існування адреси.
;
; Фізичні свідчення охоплюють вибірки, перевірку кількості
; аргументів, допуск історичних слів і структуру знайденого.
; Відмінності історичних результатів від однобітної хиби
; необхідно зберігати як спостережувані відмінності.
; Цитовані мітки записів не можна довільно вважати атомами
; чи порівнювати як атоми без доведеного закону даних.
;
; Визначення мають українські проєкційні імена. Допоміжні
; назви не підмінюють резидентів чинних доменів.
; Повного виконання всього профілю ще не доведено.
; Жодних нових примітивів, неявної викликуваності
; чи дублювання текстом машинних функцій не додається.

; Похідні функціональні резиденти Д4–Д6 із lib/core.lisp.
; Їхні точні імена та координати беруться з lib/domains/d4–d6.lisp;
; тіла складаються лише з уже доступних операцій Д3.
; Із Д9 перенесені лише визначення, перевірені окремими свідками.
(визначити тотожність (функція (передане-значення) передане-значення))

(визначити порожній?
  (функція (передане-значення)
    (за-умовою
      ((атом? передане-значення) (тотожне? передане-значення (як-є ())))
      ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ())))))))

(визначити решта-першого
  (функція (передане-значення)
    (решта (перше передане-значення))))

(визначити решта-решти
  (функція (передане-значення)
    (решта (решта передане-значення))))

(визначити перше-першого
  (функція (передане-значення)
    (перше (перше передане-значення))))

(визначити решта-двох-перших
  (функція (передане-значення)
    (решта (перше (перше передане-значення)))))

(визначити решта-після-першого
  (функція (передане-значення)
    (решта (перше (решта передане-значення)))))

(визначити решта-решти-першого
  (функція (передане-значення)
    (решта (решта (перше передане-значення)))))

(визначити решта-трьох
  (функція (передане-значення)
    (решта (решта (решта передане-значення)))))

(визначити перше-двох-перших
  (функція (передане-значення)
    (перше (перше (перше передане-значення)))))

(визначити перше-після-першого
  (функція (передане-значення)
    (перше (перше (решта передане-значення)))))

(визначити перше-решти-першого
  (функція (передане-значення)
    (перше (решта (перше передане-значення)))))

(визначити третє
  (функція (значення-функції)
    (перше (решта (решта значення-функції)))))

(визначити четверте
  (функція (значення-функції)
    (третє (решта значення-функції))))

; Д9: п'ятий елемент правильного списку є похідним селектором Д3.
; Коротший правильний список повертає порожню структуру; окремої
; машинної викличності резидента Д9 це визначення не додає.
(визначити п'ятий
  (функція (передане-значення)
    (за-умовою
      ((порожній? передане-значення) (як-є ()))
      ((порожній? (решта передане-значення)) (як-є ()))
      ((порожній? (решта (решта передане-значення))) (як-є ()))
      ((порожній? (решта (решта (решта передане-значення)))) (як-є ()))
      ((порожній? (решта (решта (решта (решта передане-значення))))) (як-є ()))
      ((атом? (як-є ()))
       (перше (решта (решта (решта (решта передане-значення)))))))))

; Д8: та й або зберігають коротке обчислення. Макроси будують D1
; відповіді через перевірені D3-форми, не через текстові «так»/«ні».
(визначити та
  (макрос
    (функція сирі-аргументи
      (за-умовою
        ((порожній? сирі-аргументи) (як-є (атом? (як-є ()))))
        ((порожній? (решта сирі-аргументи)) (перше сирі-аргументи))
        ((атом? (як-є ()))
         (список
           (як-є за-умовою)
           (список (перше сирі-аргументи) (сполучити (як-є та) (решта сирі-аргументи)))
           (список
             (як-є (атом? (як-є ())))
             (як-є (атом? (сполучити (як-є ()) (як-є ())))))))))))

(визначити або
  (макрос
    (функція сирі-аргументи
      (за-умовою
        ((порожній? сирі-аргументи) (як-є (атом? (сполучити (як-є ()) (як-є ())))))
        ((порожній? (решта сирі-аргументи)) (перше сирі-аргументи))
        ((атом? (як-є ()))
         (список
           (як-є за-умовою)
           (список (перше сирі-аргументи) (як-є (атом? (як-є ()))))
           (список
             (як-є (атом? (як-є ())))
             (сполучити (як-є або) (решта сирі-аргументи)))))))))

; Д10: умовний вибір є макросом із власною точною ідентичністю.
; Його безумовні гілки формують D1 через D3, а не D7-текст.
(визначити якщо
  (макрос
    (функція сирі-аргументи
      (за-умовою
        ((порожній? сирі-аргументи) (макрос))
        ((порожній? (решта сирі-аргументи)) (макрос))
        ((порожній? (решта (решта сирі-аргументи)))
         (список
           (як-є за-умовою)
           (список (перше сирі-аргументи) (друге сирі-аргументи))
           (список
             (як-є (атом? (як-є ())))
             (як-є (атом? (сполучити (як-є ()) (як-є ())))))))
        ((порожній? (решта (решта (решта сирі-аргументи))))
         (список
           (як-є за-умовою)
           (список (перше сирі-аргументи) (друге сирі-аргументи))
           (список
             (як-є (атом? (як-є ())))
             (третє сирі-аргументи))))
        ((атом? (як-є ())) (макрос))))))

(визначити другий-елемент
  (функція (передане-значення)
    (друге передане-значення)))

(визначити третій-елемент
  (функція (передане-значення)
    (третє передане-значення)))

(визначити четвертий-елемент
  (функція (передане-значення)
    (третє (решта передане-значення))))

(визначити створити-помилку
  (функція (вид подробиці)
    (сполучити (як-є запис-помилки)
      (сполучити вид
        (сполучити подробиці (як-є ()))))))

(визначити помилка?
  (функція (передане-значення)
    (за-умовою
      ((атом? передане-значення) ні)
      ((назви-рівні? (перше передане-значення) (як-є запис-помилки)) так)
      (так ні))))

; Результат пошуку має власну структурну присутність:
; () — ключ відсутній, (значення) — знайдений навіть порожній payload.
; Жодна Text7-мітка чи частковий D3 EQ не визначає цю ознаку.
(визначити створити-знайдене
  (функція (передане-значення)
    (сполучити передане-значення (як-є ()))))

(визначити знайдено?
  (функція (передане-значення)
    (хибне? (атом? передане-значення))))

(визначити значення-знайденого
  (функція (передане-значення)
    (перше передане-значення)))

; Структурна рівність імен — бібліотечна композиція на Д3.
; Складена назва Д7 залишається списком знаків, а не вигаданим атомом.
; Атомне ТОТОЖНЕ? застосовується лише коли обидва значення атомні.
(визначити назви-рівні?
  (мітка назви-рівні?
    (функція (ліва права)
      (за-умовою
        ((атом? ліва)
         (за-умовою
           ((атом? права) (тотожне? ліва права))
           (так ні)))
        ((атом? права) ні)
        ((назви-рівні? (перше ліва) (перше права))
         (назви-рівні? (решта ліва) (решта права)))
        (так ні)))))

(визначити знайти-в-оточенні
  (мітка знайти-в-оточенні
    (функція (назва оточення)
      (за-умовою
        ((атом? оточення) (як-є ()))
        ((назви-рівні? (перше (перше оточення)) назва)
         (створити-знайдене (решта (перше оточення))))
        (так (знайти-в-оточенні назва (решта оточення)))))))

; Доменний закон: порівняння функцій лише за точним чинним
; об'єктом у повній колонці укр. Старі бітові текстові токени
; не є ані числовими аргументами, ані виконуваними ідентичностями.
(визначити допущене-історичне-слово?
  (функція (величина)
    (за-умовою
      ((назви-рівні? величина (як-є як-є)) так)
      ((назви-рівні? величина (як-є атом?)) так)
      ((назви-рівні? величина (як-є тотожне?)) так)
      ((назви-рівні? величина (як-є сполучити)) так)
      ((назви-рівні? величина (як-є перше)) так)
      ((назви-рівні? величина (як-є решта)) так)
      ((назви-рівні? величина (як-є за-умовою)) так)
      ((назви-рівні? величина (як-є функція)) так)
      ((назви-рівні? величина (як-є визначити)) так)
      ((назви-рівні? величина (як-є додати)) так)
      ((назви-рівні? величина (як-є відняти)) так)
      ((назви-рівні? величина (як-є хибне?)) так)
      ((назви-рівні? величина (як-є список)) так)
      (так ні))))

; Тільки чинні українські проєкції ратифікованих доменних примітивів.
; Історичні ATOM/EQ/CONS/CAR/CDR/LIST/NOT не є викличними псевдонімами.
; Виклична тотожність встановлюється лише чинною доменною драбинкою.
(визначити історична-тотожність-примітива
  (функція (назва)
    (за-умовою
      ((назви-рівні? назва (як-є атом?)) (як-є атом?))
      ((назви-рівні? назва (як-є тотожне?)) (як-є тотожне?))
      ((назви-рівні? назва (як-є сполучити)) (як-є сполучити))
      ((назви-рівні? назва (як-є перше)) (як-є перше))
      ((назви-рівні? назва (як-є решта)) (як-є решта))
      ((назви-рівні? назва (як-є порожній?)) (як-є порожній?))
      ((назви-рівні? назва (як-є додати-1)) (як-є додати-1))
      ((назви-рівні? назва (як-є хибне?)) (як-є хибне?))
      ((назви-рівні? назва (як-є список)) (як-є список))
      (так (як-є ())))))

; Іменовані Д5 продовження замінюють три недопущені виклики
; анонімної функції в голові. Проміжний результат рахується один раз.
; Семантика пошуку: локальне → глобальне → історичний ратифікований код.
(визначити перевірити-історичну-тотожність
  (функція (назва тотожність-слова)
    (за-умовою
      ((порожній? тотожність-слова)
       (створити-помилку (як-є UNBOUND) назва))
      (так тотожність-слова))))

(визначити значення-за-замовчуванням
  (функція (назва)
    (за-умовою
      ((назви-рівні? назва (як-є ні)) ні)
      ((назви-рівні? назва (як-є так)) так)
      (так
       (перевірити-історичну-тотожність
         назва (історична-тотожність-примітива назва))))))

(визначити значення-із-глобального-пошуку
  (функція (назва верхнє)
    (за-умовою
      ((знайдено? верхнє) (значення-знайденого верхнє))
      (так (значення-за-замовчуванням назва)))))

(визначити значення-із-локального-пошуку
  (функція (назва глобальне-оточення локальне)
    (за-умовою
      ((знайдено? локальне) (значення-знайденого локальне))
      (так
       (значення-із-глобального-пошуку
         назва (знайти-в-оточенні назва глобальне-оточення))))))

(визначити знайти-значення
  (функція (назва оточення глобальне-оточення)
    (значення-із-локального-пошуку
      назва глобальне-оточення
      (знайти-в-оточенні назва оточення))))

; Кількість поданих значень — звичайні Д3/Д5 предикати.
; Не перевизначати ратифікований Д9 АРГУМЕНТИ (110001111).
(визначити одна-величина?
  (функція (одержане)
    (за-умовою
      ((атом? одержане) ні)
      ((порожній? (решта одержане)) так)
      (так ні))))

(визначити дві-величини?
  (функція (одержане)
    (за-умовою
      ((атом? одержане) ні)
      ((атом? (решта одержане)) ні)
      ((порожній? (решта (решта одержане))) так)
      (так ні))))

(визначити поєднати-параметри
  (мітка поєднати-параметри
    (функція (параметри передані-значення оточення)
      (за-умовою
        ((порожній? параметри)
         (за-умовою
           ((порожній? передані-значення) оточення)
           (так (створити-помилку (як-є ARITY) (як-є TOO-MANY-ARGUMENTS)))))
        ((порожній? передані-значення)
         (створити-помилку (як-є ARITY) (як-є TOO-FEW-ARGUMENTS)))
        (так
         (поєднати-параметри
           (решта параметри)
           (решта передані-значення)
           (сполучити (сполучити (перше параметри) (перше передані-значення)) оточення)))))))

(визначити застосувати-примітив
  (функція (ідентифікатор передані-значення)
    (за-умовою
      ((назви-рівні? ідентифікатор (як-є список)) передані-значення)
      ((назви-рівні? ідентифікатор (як-є хибне?))
       (за-умовою
         ((одна-величина? передані-значення)
          (хибне? (перше передані-значення)))
         (так (створити-помилку (як-є ARITY) ідентифікатор))))
      ((назви-рівні? ідентифікатор (як-є атом?))
       (за-умовою
         ((одна-величина? передані-значення) (атом? (перше передані-значення)))
         (так (створити-помилку (як-є ARITY) ідентифікатор))))
      ((назви-рівні? ідентифікатор (як-є тотожне?))
       (за-умовою
         ((дві-величини? передані-значення) (тотожне? (перше передані-значення) (перше (решта передані-значення))))
         (так (створити-помилку (як-є ARITY) ідентифікатор))))
      ((назви-рівні? ідентифікатор (як-є сполучити))
       (за-умовою
         ((дві-величини? передані-значення) (сполучити (перше передані-значення) (перше (решта передані-значення))))
         (так (створити-помилку (як-є ARITY) ідентифікатор))))
      ((назви-рівні? ідентифікатор (як-є перше))
       (за-умовою
         ((одна-величина? передані-значення)
          (за-умовою
            ((атом? (перше передані-значення))
             (створити-помилку (як-є TYPE) (як-є CAR-REQUIRES-PAIR)))
            (так (перше (перше передані-значення)))))
         (так (створити-помилку (як-є ARITY) ідентифікатор))))
      ((назви-рівні? ідентифікатор (як-є решта))
       (за-умовою
         ((одна-величина? передані-значення)
          (за-умовою
            ((атом? (перше передані-значення))
             (створити-помилку (як-є TYPE) (як-є CDR-REQUIRES-PAIR)))
            (так (решта (перше передані-значення)))))
         (так (створити-помилку (як-є ARITY) ідентифікатор))))
      ((назви-рівні? ідентифікатор (як-є порожній?))
       (за-умовою
         ((одна-величина? передані-значення)
          (порожній? (перше передані-значення)))
         (так (створити-помилку (як-є ARITY) ідентифікатор))))
      ((назви-рівні? ідентифікатор (як-є додати-1))
       (за-умовою
         ((одна-величина? передані-значення)
          (додати-1 (перше передані-значення)))
         (так (створити-помилку (як-є ARITY) ідентифікатор))))
      (так
       (створити-помилку (як-є UNSUPPORTED-PRIMITIVE) ідентифікатор)))))

; Д5-функції зберігають рівно один виклик обчислення кожної форми.
; Помилка першого значення зупиняє обхід ще ДО рекурсивного хвоста.
(визначити поєднати-результати-аргументів
  (функція (перший-результат решта-результатів)
    (за-умовою
      ((помилка? решта-результатів) решта-результатів)
      (так (сполучити перший-результат решта-результатів)))))

(визначити продовжити-аргументи
  (функція (перший-результат форми оточення глобальне-оточення)
    (за-умовою
      ((помилка? перший-результат) перший-результат)
      (так
       (поєднати-результати-аргументів
         перший-результат
         (обчислити-аргументи
           (решта форми) оточення глобальне-оточення))))))

(визначити обчислити-аргументи
  (мітка обчислити-аргументи
    (функція (форми оточення глобальне-оточення)
      (за-умовою
        ((порожній? форми) (як-є ()))
        (так
         (продовжити-аргументи
           (обчислити-форму-ядра (перше форми) оточення глобальне-оточення)
           форми оточення глобальне-оточення))))))

; Умова обчислюється рівно один раз, а її Д1 значення керує
; власним Д5-продовженням; анонімного виклику в голові більше немає.
(визначити продовжити-умови
  (функція (значення-перевірки умови оточення глобальне-оточення)
    (за-умовою
      ((помилка? значення-перевірки) значення-перевірки)
      (так
       (за-умовою
         ((хибне? значення-перевірки)
          (вибрати-гілку-ядра (решта умови) оточення глобальне-оточення))
         (так
          (обчислити-форму-ядра
            (друге (перше умови)) оточення глобальне-оточення)))))))

(визначити вибрати-гілку-ядра
  (мітка вибрати-гілку-ядра
    (функція (умови оточення глобальне-оточення)
      (за-умовою
        ((порожній? умови)
         (створити-помилку (як-є UNSATISFIED-CONDITIONAL) (як-є ())))
        (так
         (продовжити-умови
           (обчислити-форму-ядра
             (перше (перше умови)) оточення глобальне-оточення)
           умови оточення глобальне-оточення))))))

(визначити виконати-виклик-ядра
  (функція (викликана-функція передані-значення глобальне-оточення)
    (за-умовою
      ((помилка? викликана-функція) викликана-функція)
      ((хибне? (порожній?
                 (історична-тотожність-примітива викликана-функція)))
       (застосувати-примітив
         (історична-тотожність-примітива викликана-функція)
         передані-значення))
      (так
       ; Значення, створене D4 FUNCTION, уже є замиканням. D5 FUNCTION
       ; є лише ратифікованою координатою і не є конструктором чи викликом.
       ; Точний D4 APPLY викликає значення без англомовного/історичного
       ; dispatch та сам відхиляє не-викличні значення.
       (застосувати викликана-функція
         (список передані-значення глобальне-оточення))))))

(визначити назва-цитування?
  (функція (назва)
    (за-умовою
      ((назви-рівні? назва (як-є як-є)) так)
      (так ні))))

(визначити назва-умови?
  (функція (назва)
    (за-умовою
      ((назви-рівні? назва (як-є за-умовою)) так)
      (так ні))))

(визначити назва-функції?
  (функція (назва)
    (за-умовою
      ((назви-рівні? назва (як-є функція)) так)
      (так ні))))

(визначити назва-визначення?
  (функція (назва)
    (за-умовою
      ((назви-рівні? назва (як-є визначити)) так)
      (так ні))))

(визначити назва-мітки?
  (функція (назва)
    (за-умовою
      ((назви-рівні? назва (як-є мітка)) так)
      (так ні))))

; Розпізнавання спеціальних форм спирається на точні резиденти D5.
(визначити назва-програми?
  (функція (назва) (назви-рівні? назва (як-є програма))))
(визначити назва-встановити?
  (функція (назва) (назви-рівні? назва (як-є встановити))))
(визначити назва-встановити-ім'я?
  (функція (назва) (назви-рівні? назва (як-є встановити-ім'я))))
(визначити назва-перейти?
  (функція (назва) (назви-рівні? назва (як-є перейти))))
(визначити назва-повернути?
  (функція (назва) (назви-рівні? назва (як-є повернути))))

; Виклики Д5 визначені на стороні SENS: під'єднане оточення
; та значення функції перевіряються рівно один раз, без call-head LAMBDA.
(визначити виконати-тіло-функції
  (функція (приєднане вираз оточення-виклику)
    (за-умовою
      ((помилка? приєднане) приєднане)
      (так
       (обчислити-форму-ядра (третє вираз) приєднане оточення-виклику)))))

(визначити застосувати-обчислені-аргументи
  (функція (викликана-функція передані-значення глобальне-оточення)
    (за-умовою
      ((помилка? передані-значення) передані-значення)
      (так
       (виконати-виклик-ядра викликана-функція передані-значення глобальне-оточення)))))

(визначити продовжити-виклик
  (функція (викликана-функція вираз оточення глобальне-оточення)
    (за-умовою
      ((помилка? викликана-функція) викликана-функція)
      (так
       (застосувати-обчислені-аргументи
         викликана-функція
         (обчислити-аргументи
           (решта вираз) оточення глобальне-оточення)
         глобальне-оточення)))))

(визначити обчислити-форму-ядра
  (мітка обчислити-форму-ядра
    (функція (вираз оточення глобальне-оточення)
      (за-умовою
        ((атом? вираз)
         (за-умовою
           ((порожній? вираз) (як-є ()))
           ; D1, D12+ та інші атомарні значення вже є значеннями.
           ; Однознакова D7-назва також може бути D3-атомом, тому точне
           ; зв'язування перевіряється перед поверненням атома як значення.
           ((знайдено? (знайти-в-оточенні вираз оточення))
            (значення-знайденого (знайти-в-оточенні вираз оточення)))
           ((знайдено? (знайти-в-оточенні вираз глобальне-оточення))
            (значення-знайденого (знайти-в-оточенні вираз глобальне-оточення)))
           (так вираз)))
        ((назва-цитування? (перше вираз))
         ; Цитування приймає рівно одну форму. Перевірка решти виклику
         ; перед селектором не дає пропустити зайві аргументи або
         ; перетворити відсутню форму на помилку механізму CAR.
         (за-умовою
           ((одна-величина? (решта вираз)) (друге вираз))
           (так (створити-помилку (як-є ARITY) (як-є QUOTE)))))
        ((назва-умови? (перше вираз))
         (вибрати-гілку-ядра (решта вираз) оточення глобальне-оточення))
        ((назва-програми? (перше вираз))
         (виконати-програму-в-оточенні
           (решта (решта вираз))
           (решта (решта вираз))
           (оточення-програми (перше (решта вираз)) оточення)
           глобальне-оточення))
        ((назва-мітки? (перше вираз))
         (обчислити-форму-ядра (третє вираз) оточення глобальне-оточення))
        ((назва-функції? (перше вираз))
         (функція (передані-значення оточення-виклику)
           (виконати-тіло-функції
             (поєднати-параметри
               (друге вираз) передані-значення оточення)
             вираз оточення-виклику)))
        ((назва-визначення? (перше вираз))
         (створити-помилку
           (як-є INVALID-FORM)
           (як-є DEFINE-IS-TOP-LEVEL-ONLY)))
        ; Проєкційні написання резидентів D1 зв'язуються до пошуку
        ; змінних, щоб однаковий D7-текст не затінив точне значення.
        ((назви-рівні? вираз (як-є ні)) ні)
        ((назви-рівні? вираз (як-є так)) так)
        ; Текстові імена D7 у фізичному синтаксичному дереві можуть
        ; мати D3-подання послідовності знаків, тому D3 АТОМ? їх не
        ; класифікує як імена. Спершу шукаємо точне структурне ім'я
        ; в лексичному, потім у глобальному оточенні; довільну форму
        ; виклику це не перетворює на змінну.
        ((знайдено? (знайти-в-оточенні вираз оточення))
         (значення-знайденого (знайти-в-оточенні вираз оточення)))
        ((знайдено? (знайти-в-оточенні вираз глобальне-оточення))
         (значення-знайденого (знайти-в-оточенні вираз глобальне-оточення)))
        (так
         (продовжити-виклик
           (обчислити-форму-ядра (перше вираз) оточення глобальне-оточення)
           вираз оточення глобальне-оточення))))))

(визначити створити-середовище-обчислювача
  (функція (величина глобальне-оточення)
    (сполучити (як-є запис-світу)
      (сполучити величина
        (сполучити глобальне-оточення (як-є ()))))))

(визначити значення-світу
  (функція (світ)
    (друге світ)))

(визначити глобальне-оточення-світу
  (функція (світ)
    (третє світ)))

(визначити визначення?
  (функція (форма)
    (за-умовою
      ((атом? форма) ні)
      ((назва-визначення? (перше форма)) так)
      (так ні))))

; Рідні Д5-продовження зберігають порядок DEFINE і розрізнення
; двох сутностей: ФОРМА — поточне визначення, ФОРМИ — вся побудувати-програму-ядра.
; Єдине обчислення значення лишається в SENS.
(визначити продовжити-визначення
  (функція (форма форми величина глобальне-оточення)
    (за-умовою
      ((помилка? величина)
       (створити-середовище-обчислювача величина глобальне-оточення))
      (так
       (обчислити-програму
         (решта форми)
         (сполучити
           (сполучити (друге форма) величина)
           глобальне-оточення))))))

(визначити продовжити-форму-програми
  (функція (величина форми глобальне-оточення)
    (за-умовою
      ((помилка? величина)
       (створити-середовище-обчислювача величина глобальне-оточення))
      (так
       (обчислити-програму (решта форми) глобальне-оточення)))))

(визначити обчислити-програму
  (мітка обчислити-програму
    (функція (форми глобальне-оточення)
      (за-умовою
        ((порожній? форми)
         (створити-середовище-обчислювача (як-є ()) глобальне-оточення))
        ((визначення? (перше форми))
         (продовжити-визначення
           (перше форми)
           форми
           (обчислити-форму-ядра (третє (перше форми))
             (як-є ()) глобальне-оточення)
           глобальне-оточення))
        ((порожній? (решта форми))
         (створити-середовище-обчислювача
           (обчислити-форму-ядра (перше форми) (як-є ()) глобальне-оточення)
           глобальне-оточення))
        (так
         (продовжити-форму-програми
           (обчислити-форму-ядра (перше форми) (як-є ()) глобальне-оточення)
           форми глобальне-оточення))))))

(визначити обчислити-у-світі
  (функція (світ вираз)
    (створити-середовище-обчислювача
      (обчислити-форму-ядра вираз (як-є ()) (глобальне-оточення-світу світ))
      (глобальне-оточення-світу світ))))

; Жодного анонімного виклику у голові: програмний світ
; передається безпосередньо між Д5 викликами, рівно один раз.
(визначити обчислити-програму-та-вираз
  (функція (форми вираз)
    (значення-світу
      (обчислити-у-світі
        (обчислити-програму форми (як-є ()))
        вираз))))

; ─────────────────────────────────────────────────────────────────────────────
; Доповнення початкового ядра: читач списків і звільнення пам'яті.
; Читач розбирає крапкові пари зі списку лексем без зовнішнього вводу.
; Звільнення пам'яті відтворює точні закони позначення та очищення.
; Усі рішення належать СЕНС, а не зовнішньому тлумаченню назв.
; ─────────────────────────────────────────────────────────────────────────────

(визначити розібрати-лексеми-ядра
  (мітка розібрати-лексеми-ядра
    (функція (лексеми)
      (за-умовою
        ((порожній? лексеми) (як-є ()))
        ((назви-рівні? (перше лексеми) (як-є атом?))     ; токенізована назва маркера атома
         (перше лексеми))
        (так
         (прочитати-вкладений-список лексеми))))))

(визначити прочитати-вкладений-список
  (мітка прочитати-вкладений-список
    (функція (лексеми)
      (за-умовою
        ((порожній? лексеми) (як-є ()))
        ((назви-рівні? (перше лексеми) (як-є крапка))    ; лексема крапки у вхідному потоці
         (перше (решта лексеми)))
        (так
         (сполучити (розібрати-лексеми-ядра (перше лексеми))
              (прочитати-вкладений-список (решта лексеми))))))))

; Принцип п'ять: сучасний збирач на явній моделі досяжності графа.
; Це НЕ колектор живої пам'яті SENS: корені/комірки тут є звичайними даними.
; Комірка — (ім'я ліве праве), імена та посилання — цитовані атоми,
; () означає відсутнє ребро. Довільне фізичне GC — лише в субстраті (#2544).
;
; ВИБІР АЛГОРИТМУ: класичний однорівневий mark-sweep замінено на
; ТРИКОЛІРНЕ ІНКРЕМЕНТАЛЬНЕ МАРКУВАННЯ (Дейкстра/Стіл).
; Чому саме воно, а не поколіннєве чи mark-region (Immix):
;  1) воно лишає ТОЙ САМИЙ закон досяжності — позначення з коренів
;     уздовж ребер — тож поділ живі/сміття тотожний старому;
;  2) воно спирається лише на наявні корені + комірки й не вимагає
;     вигаданих «віку» комірок (слабка гіпотеза поколінь) чи фізичних
;     регіонів субстрату (mark-region) — а модель НЕ фізична;
;  3) стан (сірі чорні) явний і оборотний, а крок — інкрементальний,
;     тож бар'єр запису можна довести окремим виконуваним законом.
; Поколіннєве вимагало б неіснуючого віку комірок; mark-region — регіонів.
;
; Білі — усі імена, яких немає ні серед сірих, ні серед чорних; їх не
; зберігають, а обчислюють різницею. Сірі — знайдені, ще не проскановані
; (робочий список). Чорні — проскановані; саме вони й утворюють
; позначений (досяжний) набір. Інваріант Дейкстри «чорний не вказує на
; білого» тримається тим, що нащадків сіріють ПЕРШ ніж батька чорнити.
; Обхід тримає і цикл, і спільного нащадка: нащадок не дублюється ні в
; сірих, ні в чорних, а робочий список завжди скінченний.

(визначити повернути-память
  (функція (корені комірки)
    (зібрати-непозначене
      (позначити-все корені комірки) комірки)))

; Назви посилань сьомого домену мають складену структуру.
; Порівнюємо її власним рекурсивним законом, а не частковим
; атомним порівнянням. Давня назва функції збережена для викликачів.
(визначити однакові-атоми?
  (функція (лівий правий)
    (назви-рівні? лівий правий)))

(визначити знайти-комірку-для-памяті
  (мітка знайти-комірку-для-памяті
    (функція (посилання комірки)
      (за-умовою
        ((порожній? комірки) (як-є ()))
        ((однакові-атоми? (перше (перше комірки)) посилання) (перше комірки))
        (так (знайти-комірку-для-памяті посилання (решта комірки)))))))

(визначити позначена-комірка?
  (мітка позначена-комірка?
    (функція (посилання позначені)
      (за-умовою
        ((порожній? позначені) ні)
        ((однакові-атоми? посилання (перше позначені)) так)
        (так (позначена-комірка? посилання (решта позначені)))))))

; ── Триколірний інкрементальний рушій (Дейкстра/Стіл) ──
; Стан — явна пара (сірі чорні). Один крок обробляє рівно один сірий
; вузол: знайшовши його комірку, ставить до черги непозначених нащадків
; без дублів, а сам вузол чорнить. Вузол без комірки не чорніє.
; Сірий або чорний нащадок повторно не ставиться до роботи.
; Два Д5-продовження не створюють додаткових CONS-пар.
; Читаємо кожен вузол графа та знайдений запис тільки один раз.
(визначити додати-сірий-якщо-відсутній
  (функція (посилання сірі чорні)
    (за-умовою
      ((порожній? посилання) сірі)
      ((позначена-комірка? посилання сірі) сірі)
      ((позначена-комірка? посилання чорні) сірі)
      (так (сполучити посилання сірі)))))

(визначити додати-ребра-сірого-вузла
  (функція (сірі чорні ліве праве)
    (список
      (додати-сірий-якщо-відсутній
        ліве (додати-сірий-якщо-відсутній праве сірі чорні) чорні)
      чорні)))

(визначити триколірний-за-записом
  (функція (запис посилання решта-сірих чорні комірки)
    (за-умовою
      ((порожній? запис)
       (список решта-сірих чорні))
      (так
       (додати-ребра-сірого-вузла
         решта-сірих (сполучити посилання чорні)
         (друге запис) (третє запис))))))

(визначити триколірний-за-посиланням
  (функція (посилання решта-сірих чорні комірки)
    (за-умовою
      ((порожній? посилання)
       (список решта-сірих чорні))
      ((позначена-комірка? посилання чорні)
       (список решта-сірих чорні))
      (так
       (триколірний-за-записом
         (знайти-комірку-для-памяті посилання комірки)
         посилання решта-сірих чорні комірки)))))

(визначити триколірний-крок
  (мітка триколірний-крок
    (функція (сірі чорні комірки)
      (за-умовою
        ((порожній? сірі) (список сірі чорні))
        (так
         (триколірний-за-посиланням
           (перше сірі) (решта сірі) чорні комірки))))))


; Вичерпати робочий список сірих до нерухомої точки; результат — чорні.
; Крок атомарний і завершується, бо кожен сірий вузол або відкидається,
; або чорніє один раз, а нащадків у комірки не більше двох.
; Продовження отримує єдиний результат триколірного кроку;
; ніяких повторних обходів та анонімної функції у викличній голові.
(визначити триколірний-продовжити
  (функція (стан комірки)
    (за-умовою
      ((порожній? (перше стан)) (друге стан))
      (так
       (триколірний-до-кінця
         (перше стан) (друге стан) комірки)))))

(визначити триколірний-до-кінця
  (мітка триколірний-до-кінця
    (функція (сірі чорні комірки)
      (триколірний-продовжити
        (триколірний-крок сірі чорні комірки)
        комірки))))

; Дейкстрове затемнення при записі (insertion barrier).
; Якщо ЧОРНИЙ об'єкт дістає нове ребро на БІЛИЙ, нащадка негайно
; заносять до сірих; інакше інкрементальне маркування втратило б
; досяжний об'єкт. Бар'єр потрібен лише для чорного власника.
(визначити затемнення-при-записі
  (функція (власник нащадок сірі чорні)
    (за-умовою
      ((порожній? нащадок) (список сірі чорні))
      ((позначена-комірка? нащадок чорні) (список сірі чорні))
      ((позначена-комірка? нащадок сірі) (список сірі чорні))
      ((хибне? (позначена-комірка? власник чорні)) (список сірі чорні))
      (так (список (сполучити нащадок сірі) чорні)))))

; Давній виклик лишається чинним: обхід від одного посилання з уже
; наявним набором позначених. Тепер це тонка обгортка над триколірним
; рушієм — той самий набір-результат, інший (інкрементальний) механізм.
(визначити обійти-посилання
  (функція (посилання позначені комірки)
    (триколірний-до-кінця (список посилання) позначені комірки)))

; Корені сіються як початковий робочий список сірих, а позначені входять
; як початкові чорні. Сигнатура й результат збережені для старих викликачів.
(визначити позначити-корені
  (функція (корені позначені комірки)
    (триколірний-до-кінця корені позначені комірки)))

(визначити позначити-все
  (функція (корені комірки)
    (позначити-корені корені (як-є ()) комірки)))

; Збережені двоаргументні проєкції попереднього Core1, без opcode D11.
(визначити позначити
  (функція (посилання комірки)
    (обійти-посилання посилання (як-є ()) комірки)))

(визначити позначити-комірку
  (функція (посилання комірки)
    (за-умовою
      ((порожній? (знайти-комірку-для-памяті посилання комірки))
       (як-є ()))
      (так (список посилання)))))

(визначити позначити-нащадків
  (функція (посилання комірки)
    (обійти-посилання посилання (як-є ()) комірки)))

; Результат — лише комірки, недосяжні з явних коренів.
; Фізичне звільнення цих слотів НЕ виконується Lisp-функцією.
(визначити зібрати-непозначене
  (мітка зібрати-непозначене
    (функція (позначені комірки)
      (за-умовою
        ((порожній? комірки) (як-є ()))
        ((позначена-комірка? (перше (перше комірки)) позначені)
         (зібрати-непозначене позначені (решта комірки)))
        (так (сполучити (перше комірки)
               (зібрати-непозначене позначені (решта комірки))))))))

(визначити вільні-комірки
  (функція (комірки)
    (зібрати-непозначене (як-є ()) комірки)))

; Компактна проєкція саме живих комірок у вихідному порядку.
; Вона лишає ідентичності та дочірні посилання незмінними; фізичне
; переміщення байтів/адрес — окремий механізм субстрату (#2544).
(визначити зібрати-досяжне
  (мітка зібрати-досяжне
    (функція (позначені комірки)
      (за-умовою
        ((порожній? комірки) (як-є ()))
        ((позначена-комірка? (перше (перше комірки)) позначені)
         (сполучити (перше комірки)
           (зібрати-досяжне позначені (решта комірки))))
        (так (зібрати-досяжне позначені (решта комірки)))))))

(визначити ущільнити-досяжне
  (функція (корені комірки)
    (зібрати-досяжне
      (позначити-все корені комірки) комірки)))

; Один обхід коренів дає один точний набір позначок.
; Два незалежні проходи комірок утворюють розділення (живі сміття).
; Кожна комірка належить рівно одній частині за своїм іменем;
; ніякої фізичної деалокації чи доменної семантики в Rust/Zig.
; Маркування коренів відбувається рівно один раз у власному SENS.
; Та сама множина міток передається обом вибіркам.
(визначити розділити-за-позначками
  (функція (позначені комірки)
    (сполучити
      (зібрати-досяжне позначені комірки)
      (сполучити
        (зібрати-непозначене позначені комірки)
        (як-є ())))))

(визначити розділити-память
  (функція (корені комірки)
    (розділити-за-позначками
      (позначити-все корені комірки)
      комірки)))

; ─────────────────────────────────────────────────────────────────────────────
; Початкове ядро: арифметика спирається на ратифіковані п'ятий і шостий домени.
; Значення чисел належать математичним доменам від двадцять четвертого.
; П'ятий домен містить додавання, віднімання, множення та частку.
; Шостий домен містить зміну на одиницю, зміну знака та остачу.
; Тут лише тонкі мовні обгортки без нових примітивів чи зовнішньої арифметики.
; ─────────────────────────────────────────────────────────────────────────────

; Арифметика використовує спільні точні визначення SENS.

; ─────────────────────────────────────────────────────────────────────────────
; Початкове ядро: можливості з історичного додатка до опису мови.
; Списки властивостей, імперативний перебіг, приєднання та пошук
; реалізовані законами СЕНС і використовуються обчислювачем.
; ─────────────────────────────────────────────────────────────────────────────

(визначити знайти-пару-за-ключем
  (мітка знайти-пару-за-ключем
    (функція (ключ список-пар)
      (за-умовою
        ((порожній? список-пар) (як-є ()))
        ((назви-рівні? (перше (перше список-пар)) ключ)
         (перше список-пар))
        (так (знайти-пару-за-ключем ключ (решта список-пар)))))))

(визначити знайти-значення-властивості
  (мітка знайти-значення-властивості
    (функція (ключ властивість список-пар)
      (за-умовою
        ((порожній? список-пар) (як-є ()))
        ((назви-рівні? (перше (перше список-пар)) ключ)
         (за-умовою
           ((назви-рівні?
              (перше (перше (решта (перше список-пар)))) властивість)
            (перше (решта (перше (решта (перше список-пар))))))
           (так
            (знайти-значення-властивості
              ключ властивість (решта список-пар)))))
        (так
         (знайти-значення-властивості ключ властивість (решта список-пар)))))))

(визначити зібрати-оточення-ядра
  (мітка зібрати-оточення-ядра
    (функція (перший-аргумент другий-аргумент)
      (за-умовою
        ((порожній? перший-аргумент) другий-аргумент)
        (так (сполучити (перше перший-аргумент) (зібрати-оточення-ядра (решта перший-аргумент) другий-аргумент)))))))

; Списки властивостей: читання та запис.
(визначити отримати
  (функція (ключовий-символ властивість список-пар)
    (знайти-значення-властивості ключовий-символ властивість список-пар)))

(визначити записати
  (функція (ключовий-символ властивість величина список-пар)
    (сполучити
      (сполучити ключовий-символ
        (сполучити
          (сполучити властивість (сполучити величина (як-є ())))
          (як-є ())))
         список-пар)))

; D5 PROG: локальні зв'язування, послідовні форми, мітки, GO,
; RETURN, SET і SETQ. Стан передається незмінними SENS-оточеннями.
; Історичне NIL при старті змінної / падінні з кінця відображене на D3:().
(визначити побудувати-програму-ядра
  (функція (настанови)
    (виконати-програму настанови настанови)))

(визначити виконати-програму
  (мітка виконати-програму
    (функція (лічильник-команд тіло)
      (за-умовою
        ((порожній? лічильник-команд) (як-є ()))
        (так (виконати-програму-в-оточенні
               лічильник-команд тіло (як-є ()) (як-є ())))))))

; Реалізація точного резидента D6:000000 з LISP 1.5, ст.61 Appendix A:
; порожній список дає 0, інакше довжина дорівнює ADD1 від довжини решти.
; Формула рахує комірки верхнього рівня proper list.
(визначити довжина
  (мітка довжина
    (функція (вхід)
      (за-умовою
        ((порожній? вхід) 0)
        (так (додати-1
               (довжина (решта вхід))))))))

; Точний резидент D6:000001. LENGTH-ONTO зберігає початковий
; числовий акумулятор і додає по одиниці за кожну комірку proper list.
(визначити довжина-до
  (мітка довжина-до
    (функція (вхід акумулятор)
      (за-умовою
        ((порожній? вхід) акумулятор)
        (так (довжина-до
               (решта вхід)
               (додати-1 акумулятор)))))))

; Точний резидент D6:000100. Скануємо весь хребет навіть після
; знаходження елемента, щоб ранній індекс не приховав неправильний хвіст.
(визначити елемент-списку-за-індексом-сканувати
  (мітка елемент-списку-за-індексом-сканувати
    (функція (індекс вхід знайдено значення)
      (за-умовою
        ((порожній? вхід) значення)
        (знайдено
         (елемент-списку-за-індексом-сканувати
           індекс (решта вхід) так значення))
        ((нуль? індекс)
         (елемент-списку-за-індексом-сканувати
           індекс (решта вхід) так (перше вхід)))
        (так
         (елемент-списку-за-індексом-сканувати
           (відняти індекс 1) (решта вхід) ні значення))))))

(визначити елемент-списку-за-індексом
  (функція (індекс вхід)
    (за-умовою
      ((ціле? індекс)
       (за-умовою
         ((менше? індекс 0) (перше (як-є ())))
         (так (елемент-списку-за-індексом-сканувати
                індекс вхід ні (як-є ())))))
      (так (перше (як-є ()))))))

; Точний резидент D6:101010. Акумулятор містить початковий хвіст
; і вже відображені елементи у зворотному порядку; база розвертає його.
; Рекурсія досягає D3:() і не маскує неправильний хвіст.
(визначити відобразити-до
  (мітка відобразити-до
    (функція (дія вхід акумулятор)
      (за-умовою
        ((порожній? вхід) (зворот акумулятор))
        ((атом? вхід) (перше вхід))
        (так
         (відобразити-до
           дія (решта вхід)
           (сполучити (дія (перше вхід)) акумулятор)))))))

; Точний резидент D6:101011. Предикат перевіряється один раз на
; елемент; відібрані значення накопичуються ліворуч, а база відновлює
; reverse(початковий акумулятор) ++ відібрані значення.
(визначити відсіяти-до
  (мітка відсіяти-до
    (функція (предикат вхід акумулятор)
      (за-умовою
        ((порожній? вхід) (зворот акумулятор))
        ((атом? вхід) (перше вхід))
        ((предикат (перше вхід))
         (відсіяти-до
           предикат (решта вхід)
           (сполучити (перше вхід) акумулятор)))
        (так (відсіяти-до предикат (решта вхід) акумулятор))))))

; Точний резидент D6:101001. Незалежний рекурсивний закон FILTER:
; порядок і кратність збережені, предикат викликається раз на елемент.
; Непорожній атомарний хвіст передається до D3 CAR і дає типову помилку.
(визначити відсіяти
  (мітка відсіяти
    (функція (предикат вхід)
      (за-умовою
        ((порожній? вхід) (як-є ()))
        ((атом? вхід) (перше вхід))
        ((предикат (перше вхід))
         (сполучити (перше вхід)
           (відсіяти предикат (решта вхід))))
        (так (відсіяти предикат (решта вхід)))))))

; Спільна перевірка proper list: до виклику користувацької дії
; доходимо до D3:() або отримуємо D3 CAR Type на атомарному хвості.
(визначити підтвердити-правильний-список-ядра
  (мітка підтвердити-правильний-список-ядра
    (функція (хвости)
      (за-умовою
        ((порожній? хвости) так)
        ((атом? хвости) (перше хвости))
        (так
         (підтвердити-правильний-список-ядра (решта хвости)))))))

(визначити відобразити-ядро
  (мітка відобразити-ядро
    (функція (дія вхід)
      (за-умовою
        ((порожній? вхід) (як-є ()))
        (так
         (сполучити
           (дія (перше вхід))
           (відобразити-ядро дія (решта вхід))))))))

; D6:101000 MAP застосовує дію до кожного елемента зліва направо,
; зберігає порядок і кратність; спершу перевіряє весь список.
(визначити відобразити
  (функція (дія вхід)
    (за-умовою
      ((підтвердити-правильний-список-ядра вхід)
       (відобразити-ядро дія вхід))
      (так (перше (як-є ()))))))

(визначити відобразити-залишки-ядро
  (мітка відобразити-залишки-ядро
    (функція (хвости дія)
      (за-умовою
        ((порожній? хвости) (як-є ()))
        (так
         (сполучити
           (дія хвости)
           (відобразити-залишки-ядро (решта хвости) дія)))))))

; D6:000101 MAPLIST за Appendix A Lisp 1.5: дія отримує весь поточний
; суфікс, не його перший елемент; порожній список не викликає дію.
(визначити відобразити-залишки
  (функція (хвости дія)
    (за-умовою
      ((підтвердити-правильний-список-ядра хвости)
       (відобразити-залишки-ядро хвости дія))
      (так (перше (як-є ()))))))

; Похідні D6-замикання через D4 ФУНКЦІЮ: складення застосовує
; внутрішню дію першою; часткове застосування фіксує перший аргумент;
; переставлення міняє місцями рівно два аргументи.
(визначити скласти-функції
  (функція (зовнішня внутрішня)
    (функція (аргумент)
      (зовнішня (внутрішня аргумент)))))

(визначити частково-застосувати
  (функція (функція-двох-аргументів перший-аргумент)
    (функція (другий-аргумент)
      (функція-двох-аргументів перший-аргумент другий-аргумент))))

(визначити поміняти-аргументи
  (функція (функція-двох-аргументів)
    (функція (перший-аргумент другий-аргумент)
      (функція-двох-аргументів другий-аргумент перший-аргумент))))

; Точні резиденти D6:000010/000011. Прохід перевіряє весь proper list:
; кожен елемент порівнюється, тому неправильний хвіст або нечисловий
; елемент не приховується вже знайденим мінімумом/максимумом.
(визначити найменше-у-списку-до
  (мітка найменше-у-списку-до
    (функція (вхід найкраще)
      (за-умовою
        ((порожній? вхід) найкраще)
        ((менше? (перше вхід) найкраще)
         (найменше-у-списку-до (решта вхід) (перше вхід)))
        (так (найменше-у-списку-до (решта вхід) найкраще))))))

(визначити найменше-у-списку
  (функція (вхід)
    (за-умовою
      ((порожній? вхід) (як-є ()))
      (так (найменше-у-списку-до (решта вхід) (перше вхід))))))

(визначити найбільше-у-списку-до
  (мітка найбільше-у-списку-до
    (функція (вхід найкраще)
      (за-умовою
        ((порожній? вхід) найкраще)
        ((більше? (перше вхід) найкраще)
         (найбільше-у-списку-до (решта вхід) (перше вхід)))
        (так (найбільше-у-списку-до (решта вхід) найкраще))))))

(визначити найбільше-у-списку
  (функція (вхід)
    (за-умовою
      ((порожній? вхід) (як-є ()))
      (так (найбільше-у-списку-до (решта вхід) (перше вхід))))))

; Точні резиденти D5:10100/10101. Закон D5 ратифікує:
; REVERSE(x)=REVERSE-ONTO(x,()); REVERSE-ONTO(x,y)=APPEND(REVERSE(x),y).
; Це рекурсивна акумуляторна реалізація історичного LISP 1.5 REVERSE
; (Appendix A, ст.61; mccarthy-eval fixture 14), без Core4-залежності.
(визначити зворот-до
  (мітка зворот-до
    (функція (вхід накопичувач)
      (за-умовою
        ((порожній? вхід) накопичувач)
        (так
         (зворот-до
           (решта вхід)
           (сполучити (перше вхід) накопичувач)))))))

(визначити зворот
  (функція (вхід)
    (зворот-до вхід (як-є ()))))

(визначити оточення-програми
  (мітка оточення-програми
    (функція (змінні початкове)
      (за-умовою
        ((порожній? змінні) початкове)
        (так
         (сполучити
           (сполучити (перше змінні) (як-є ()))
           (оточення-програми (решта змінні) початкове)))))))

(визначити оновити-зв'язування-програми
  (мітка оновити-зв'язування-програми
    (функція (назва величина оточення)
      (за-умовою
        ((порожній? оточення)
         (створити-помилку (як-є UNBOUND) назва))
        ((назви-рівні? назва (перше (перше оточення)))
         (сполучити
           (сполучити назва величина)
           (решта оточення)))
        (так
         (за-умовою
           ((помилка? (оновити-зв'язування-програми
                        назва величина (решта оточення)))
            (оновити-зв'язування-програми назва величина (решта оточення)))
           (так
            (сполучити
              (перше оточення)
              (оновити-зв'язування-програми
                назва величина (решта оточення))))))))))

(визначити знайти-мітку-програми
  (мітка знайти-мітку-програми
    (функція (назва тіло)
      (за-умовою
        ((порожній? тіло) (як-є ()))
        ((мітка? (перше тіло))
         (за-умовою
           ((назви-рівні? назва (назва-мітки-настанови (перше тіло)))
            (створити-знайдене (решта тіло)))
           (так (знайти-мітку-програми назва (решта тіло)))))
        (так (знайти-мітку-програми назва (решта тіло)))))))

(визначити назва-мітки-настанови
  (функція (настанова)
    (за-умовою
      ((назва-мітки? (перше настанова)) (друге настанова))
      (так настанова))))

(визначити виконати-умови-програми
  (мітка виконати-умови-програми
    (функція (умови наступні тіло оточення глобальне-оточення)
      (за-умовою
        ((порожній? умови)
         (виконати-програму-в-оточенні
           наступні тіло оточення глобальне-оточення))
        ((назви-рівні? (перше (перше умови)) (як-є так))
         (виконати-вибрану-умову-програми
           (друге (перше умови)) наступні тіло оточення глобальне-оточення))
        (так
         (продовжити-умови-програми
           (обчислити-форму-ядра
             (перше (перше умови)) оточення глобальне-оточення)
           умови наступні тіло оточення глобальне-оточення))))))

(визначити продовжити-умови-програми
  (функція (умова умови наступні тіло оточення глобальне-оточення)
    (за-умовою
      ((помилка? умова) умова)
      ((хибне? умова)
       (виконати-умови-програми
         (решта умови) наступні тіло оточення глобальне-оточення))
      (так
       (виконати-вибрану-умову-програми
         (друге (перше умови)) наступні тіло оточення глобальне-оточення)))))

(визначити виконати-вибрану-умову-програми
  (функція (форма наступні тіло оточення глобальне-оточення)
    (за-умовою
      ((атом? форма)
       (створити-помилку (як-є INVALID-COND-CLAUSE) форма))
      ((назва-повернути? (перше форма))
       (обчислити-форму-ядра (друге форма) оточення глобальне-оточення))
      ((назва-перейти? (перше форма))
       (продовжити-перехід-програми
         (друге форма) тіло оточення глобальне-оточення))
      (так
       (продовжити-звичайну-настанову-програми
         (обчислити-форму-ядра форма оточення глобальне-оточення)
         наступні тіло оточення глобальне-оточення)))))

(визначити продовжити-звичайну-настанову-програми
  (функція (результат наступні тіло оточення глобальне-оточення)
    (за-умовою
      ((помилка? результат) результат)
      (так (виконати-програму-в-оточенні
             наступні тіло оточення глобальне-оточення)))))

(визначити продовжити-перехід-програми
  (функція (мітка тіло оточення глобальне-оточення)
    (продовжити-знайдену-мітку-програми
      (знайти-мітку-програми мітка тіло)
      мітка тіло оточення глобальне-оточення)))

(визначити продовжити-знайдену-мітку-програми
  (функція (знайдене мітка тіло оточення глобальне-оточення)
    (за-умовою
      ((знайдено? знайдене)
       (виконати-програму-в-оточенні
         (значення-знайденого знайдене) тіло оточення глобальне-оточення))
      (так (створити-помилку (як-є UNDEFINED-LABEL) мітка)))))

(визначити продовжити-запис-програми
  (функція (назва вираз наступні тіло оточення глобальне-оточення)
    (продовжити-обчислене-записування-програми
      (обчислити-форму-ядра вираз оточення глобальне-оточення)
      назва наступні тіло оточення глобальне-оточення)))

(визначити продовжити-обчислене-записування-програми
  (функція (величина назва наступні тіло оточення глобальне-оточення)
    (за-умовою
      ((помилка? величина) величина)
      (так
       (продовжити-оновлене-оточення-програми
         (оновити-зв'язування-програми назва величина оточення)
         наступні тіло глобальне-оточення)))))

(визначити продовжити-оновлене-оточення-програми
  (функція (нове-оточення наступні тіло глобальне-оточення)
    (за-умовою
      ((помилка? нове-оточення) нове-оточення)
      (так (виконати-програму-в-оточенні
             наступні тіло нове-оточення глобальне-оточення)))))

(визначити виконати-програму-в-оточенні
  (мітка виконати-програму-в-оточенні
    (функція (лічильник-команд тіло оточення глобальне-оточення)
      (за-умовою
        ((порожній? лічильник-команд) (як-є ()))
        ((мітка? (перше лічильник-команд))
         (виконати-програму-в-оточенні
           (решта лічильник-команд) тіло оточення глобальне-оточення))
        ((назва-повернути? (перше (перше лічильник-команд)))
         (обчислити-форму-ядра
           (друге (перше лічильник-команд)) оточення глобальне-оточення))
        ((назва-перейти? (перше (перше лічильник-команд)))
         (продовжити-перехід-програми
           (друге (перше лічильник-команд)) тіло оточення глобальне-оточення))
        ((назва-встановити-ім'я? (перше (перше лічильник-команд)))
         (продовжити-запис-програми
           (друге (перше лічильник-команд))
           (третє (перше лічильник-команд))
           (решта лічильник-команд) тіло оточення глобальне-оточення))
        ((назва-встановити? (перше (перше лічильник-команд)))
         (продовжити-ціль-встановити-програми
           (обчислити-форму-ядра
             (друге (перше лічильник-команд)) оточення глобальне-оточення)
           (третє (перше лічильник-команд))
           (решта лічильник-команд) тіло оточення глобальне-оточення))
        ((назва-умови? (перше (перше лічильник-команд)))
         (виконати-умови-програми
           (решта (перше лічильник-команд))
           (решта лічильник-команд) тіло оточення глобальне-оточення))
        (так
         (продовжити-звичайну-настанову-програми
           (обчислити-форму-ядра
             (перше лічильник-команд) оточення глобальне-оточення)
           (решта лічильник-команд) тіло оточення глобальне-оточення))))))

(визначити продовжити-ціль-встановити-програми
  (функція (назва вираз наступні тіло оточення глобальне-оточення)
    (за-умовою
      ((помилка? назва) назва)
      (так (продовжити-запис-програми
             назва вираз наступні тіло оточення глобальне-оточення)))))

(визначити виконати-перехід-ядра
  (функція (назва-мітки тіло)
    (знайти-перехід назва-мітки тіло)))

(визначити знайти-перехід
  (мітка знайти-перехід
    (функція (назва-мітки тіло)
      (за-умовою
        ((порожній? тіло) (як-є ()))
        ((мітка? (перше тіло))
         (за-умовою
           ((назви-рівні? (назва-мітки-настанови (перше тіло)) назва-мітки)
            тіло)
           (так (знайти-перехід назва-мітки (решта тіло)))))
        (так (знайти-перехід назва-мітки (решта тіло)))))))

(визначити мітка?
  (функція (настанова)
    ; Однолітерна атомна мітка зберігає історичний запис; українська
    ; D7-назва задається точним D5 LABEL, бо D7-проєкція є послідовністю.
    (за-умовою
      ((атом? настанова) так)
      ((назва-мітки? (перше настанова)) так)
      (так ні))))

(визначити пара?
  (функція (перший-аргумент)
    ; Допущений D1 результат замість незв'язаних так/ні.
    (хибне? (атом? перший-аргумент))))

; ─────────────────────────────────────────────────────────────────────────────
; Початкове ядро: історична можливість роботи з масивами.
; Це SENS-спискова модель: масив є значенням-списком, запис повертає
; новий список. Вона НЕ відтворює ARRAY з mccarthy-eval, де декларація
; зв'язує глобальну назву з мінливим LIST-масивом, а STORE повертає
; записане значення. Для історичної поведінки є окремий корпус донора.
; У цій моделі індекс має точну математичну семантику.
; Зовнішній масив чи новий машинний примітив не додається.
; ─────────────────────────────────────────────────────────────────────────────

(визначити побудувати-модель-масиву
  (функція (розмір)
    (заповнити-модель-масиву розмір (як-є ()))))

; Розміри й індекси цього профілю масиву — числа D12.
; Зменшення є локальним визначенням Core1 поверх резидента D5
; «відняти»; жодної залежності від допоміжних функцій Core4.
; Операція не перетворює числа між доменами.
(визначити зменшити-лічильник-масиву
  (функція (лічильник)
    (відняти лічильник 1)))

; Порожній або вичерпаний список не можна передавати перше/решта.
; Помилка межі — мовне значення, без прихованого host-виключення.
(визначити заповнити-модель-масиву
  (мітка заповнити-модель-масиву
    (функція (розмір накопичувач)
      (за-умовою
        ((менше? розмір 0)
         (створити-помилку (як-є відємний-розмір-масиву) розмір))
        ((більше? розмір 0)
         (заповнити-модель-масиву
           (зменшити-лічильник-масиву розмір)
           (сполучити 0 накопичувач)))
        (так накопичувач)))))

(визначити масив
  (функція (розмір)
    (побудувати-модель-масиву розмір)))

(визначити значення-масиву-за-індексом
  (мітка значення-масиву-за-індексом
    (функція (масив індекс)
      (за-умовою
        ((менше? індекс 0)
         (створити-помилку (як-є індекс-поза-масивом) індекс))
        ((атом? масив)
         (створити-помилку (як-є індекс-поза-масивом) індекс))
        ((більше? індекс 0)
         (значення-масиву-за-індексом
           (решта масив)
           (зменшити-лічильник-масиву індекс)))
        (так (перше масив))))))

(визначити продовжити-зміну-елемента-масиву
  (функція (результат перший-елемент)
    (за-умовою
      ((помилка? результат) результат)
      (так (сполучити перший-елемент результат)))))

(визначити змінити-елемент-масиву
  (мітка змінити-елемент-масиву
    (функція (масив індекс вміст)
      (за-умовою
        ((менше? індекс 0)
         (створити-помилку (як-є індекс-поза-масивом) індекс))
        ((порожній? масив)
         (створити-помилку (як-є індекс-поза-масивом) індекс))
        ((атом? масив)
         (створити-помилку (як-є індекс-поза-масивом) індекс))
        ((більше? індекс 0)
         (продовжити-зміну-елемента-масиву
           (змінити-елемент-масиву
             (решта масив)
             (зменшити-лічильник-масиву індекс)
             вміст)
           (перше масив)))
        (так (сполучити вміст (решта масив)))))))

(визначити масив?
  (функція (перший-аргумент)
    ; Структурний порожній список — масив, інший атом — ні.
    ; Непорожня пара — масив; кожна гілка повертає саме біт D1.
    (за-умовою
      ((атом? перший-аргумент)
       (порожній? перший-аргумент))
      (так (атом? (як-є ()))))))

