(00001001 C1-FOUND-VALUE
  (00001000 (VALUE)
    (C1-SECOND VALUE)))

(00001001 C1-LOOKUP-IN
  (10101010 C1-LOOKUP-IN
    (00001000 (NAME ENV)
      (00000111
        ((00000011 ENV NIL) (00000001 C1-MISSING))
        ((00000011 (00000101 (00000101 ENV)) NAME)
         (C1-MAKE-FOUND (00000110 (00000101 ENV))))
        (T
         (C1-LOOKUP-IN NAME (00000110 ENV)))))))

