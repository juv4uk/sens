; Перший профіль обчислювача СЕНС на точних доменах.
;
; Канонічне значення істини належить однобітному домену.
; Межу слова визначає структура запису, а не текстовий тег ширини.
; Старий читач цього профілю ще розрізняє число та однобітний
; предикат через тимчасове позначення. Таке позначення не є законом мови.
; Прибирати його можна лише після переходу конкретного читача
; на точнодоменне дерево й підтвердження справжнім виконанням СЕНС.
; Структурна порожнеча третього домену не дорівнює логічній хибі.
;
; Тут збережено дисципліну двопольових умов та відсутність
; самовільних перетворень між доменами різної ширини.
; Послідовні вибірки другого і третього елементів спираються
; на вже ратифіковані селектори четвертого й п'ятого доменів.
; Дев'ять внутрішніх звернень уже використовують ці селектори.
; Для четвертого елемента дозволено композицію з третього
; та п'ятого доменів. Резидент шостого домену без виконуваного
; механізму не стає викликуваним через саме існування адреси.
;
; Фізичні свідчення охоплюють вибірки, перевірку кількості
; аргументів, допуск історичних слів і структуру знайденого.
; Відмінності історичних результатів від однобітної хиби
; необхідно зберігати як спостережувані відмінності.
; Цитовані мітки записів не можна довільно вважати атомами
; чи порівнювати як атоми без доведеного закону даних.
;
; Старі назви деяких внутрішніх визначень ще потрібні
; історичним споживачам. Вони не ратифікують нових функцій.
; Повного перенесення всього профілю ще не доведено.
; Жодних нових примітивів, неявної викликуваності
; чи дублювання текстом машинних функцій не додається.

(визначити ядро1-другий-елемент
  (функція (значення)
    (друге значення)))

(визначити ядро1-третій-елемент
  (функція (значення)
    (третє значення)))

(визначити ядро1-четвертий-елемент
  (функція (значення)
    (третє (решта значення))))

(визначити ядро1-створити-помилку
  (функція (вид подробиці)
    (сполучити (як-є ядро1-запис-помилки)
      (сполучити вид
        (сполучити подробиці (як-є ()))))))

(визначити ядро1-помилка?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((ядро1-назви-рівні? (перше значення) (як-є ядро1-запис-помилки)) так)
      (так ні))))

; Результат пошуку має власну структурну присутність:
; () — ключ відсутній, (значення) — знайдений навіть порожній payload.
; Жодна Text7-мітка чи частковий D3 EQ не визначає цю ознаку.
(визначити ядро1-створити-знайдене
  (функція (значення)
    (сполучити значення (як-є ()))))

(визначити ядро1-знайдено?
  (функція (значення)
    (хибне? (атом? значення))))

(визначити ядро1-значення-знайденого
  (функція (значення)
    (перше значення)))

; Структурна рівність імен — бібліотечна композиція на Д3.
; Складена назва Д7 залишається списком знаків, а не вигаданим атомом.
; Атомне ТОТОЖНЕ? застосовується лише коли обидва значення атомні.
(визначити ядро1-назви-рівні?
  (мітка ядро1-назви-рівні?
    (функція (ліва права)
      (за-умовою
        ((атом? ліва)
         (за-умовою
           ((атом? права) (тотожне? ліва права))
           (так ні)))
        ((атом? права) ні)
        ((ядро1-назви-рівні? (перше ліва) (перше права))
         (ядро1-назви-рівні? (решта ліва) (решта права)))
        (так ні)))))

(визначити ядро1-знайти-в-оточенні
  (мітка ядро1-знайти-в-оточенні
    (функція (назва оточення)
      (за-умовою
        ((атом? оточення) (як-є ()))
        ((ядро1-назви-рівні? (перше (перше оточення)) назва)
         (ядро1-створити-знайдене (решта (перше оточення))))
        (так (ядро1-знайти-в-оточенні назва (решта оточення)))))))

; Доменний закон: порівняння функцій лише за точним чинним
; об'єктом у повній колонці укр. Старі бітові текстові токени
; не є ані числовими аргументами, ані виконуваними ідентичностями.
(визначити ядро1-допущене-історичне-слово?
  (функція (величина)
    (за-умовою
      ((тотожне? величина (як-є як-є)) так)
      ((тотожне? величина (як-є атом?)) так)
      ((тотожне? величина (як-є тотожне?)) так)
      ((тотожне? величина (як-є сполучити)) так)
      ((тотожне? величина (як-є перше)) так)
      ((тотожне? величина (як-є решта)) так)
      ((тотожне? величина (як-є за-умовою)) так)
      ((тотожне? величина (як-є функція)) так)
      ((тотожне? величина (як-є визначити)) так)
      ((тотожне? величина (як-є додати)) так)
      ((тотожне? величина (як-є відняти)) так)
      ((тотожне? величина (як-є хибне?)) так)
      ((тотожне? величина (як-є список)) так)
      (так (як-є ())))))

(визначити ядро1-історична-тотожність-примітива
  (функція (назва)
    (за-умовою
      ((тотожне? назва (як-є атом?)) (як-є атом?))
      ((тотожне? назва (як-є тотожне?)) (як-є тотожне?))
      ((тотожне? назва (як-є сполучити)) (як-є сполучити))
      ((тотожне? назва (як-є перше)) (як-є перше))
      ((тотожне? назва (як-є решта)) (як-є решта))
      ((тотожне? назва (як-є хибне?)) (як-є хибне?))
      ((тотожне? назва (як-є список)) (як-є список))
      ((тотожне? назва (як-є ATOM)) (як-є атом?))
      ((тотожне? назва (як-є atom)) (як-є атом?))
      ((тотожне? назва (як-є EQ))   (як-є тотожне?))
      ((тотожне? назва (як-є eq))   (як-є тотожне?))
      ((тотожне? назва (як-є CONS)) (як-є сполучити))
      ((тотожне? назва (як-є cons)) (як-є сполучити))
      ((тотожне? назва (як-є CAR))  (як-є перше))
      ((тотожне? назва (як-є car))  (як-є перше))
      ((тотожне? назва (як-є CDR))  (як-є решта))
      ((тотожне? назва (як-є cdr))  (як-є решта))
      ((тотожне? назва (як-є LIST)) (як-є список))
      ((тотожне? назва (як-є list)) (як-є список))
      ((тотожне? назва (як-є NOT))  (як-є хибне?))
      ((тотожне? назва (як-є not))  (як-є хибне?))
      (так (як-є ())))))

(визначити ядро1-значення-за-замовчуванням
  (функція (назва)
    ((функція (тотожність-слова)
       (за-умовою
         ((порожній? тотожність-слова)
          (ядро1-створити-помилку (як-є UNBOUND) назва))
         (так тотожність-слова)))
     (ядро1-історична-тотожність-примітива назва))))

(визначити ядро1-знайти-значення
  (функція (назва оточення глобальне-оточення)
    ((функція (локальне)
       (за-умовою
         ((ядро1-знайдено? локальне) (ядро1-значення-знайденого локальне))
         (так
          ((функція (верхнє)
             (за-умовою
               ((ядро1-знайдено? верхнє) (ядро1-значення-знайденого верхнє))
               (так (ядро1-значення-за-замовчуванням назва))))
           (ядро1-знайти-в-оточенні назва глобальне-оточення)))))
     (ядро1-знайти-в-оточенні назва оточення))))

(визначити ядро1-функціональний-аргумент?
  (функція (величина)
    (за-умовою
      ((атом? величина) ні)
      ((тотожне? (перше величина) (як-є FUNARG)) так)
      (так ні))))

(визначити ядро1-один-аргумент?
  (функція (аргументи)
    (за-умовою
      ((атом? аргументи) ні)
      ((порожній? (решта аргументи)) так)
      (так ні))))

(визначити ядро1-два-аргументи?
  (функція (аргументи)
    (за-умовою
      ((атом? аргументи) ні)
      ((атом? (решта аргументи)) ні)
      ((порожній? (решта (решта аргументи))) так)
      (так ні))))

(визначити ядро1-поєднати-параметри
  (мітка ядро1-поєднати-параметри
    (функція (параметри аргументи оточення)
      (за-умовою
        ((порожній? параметри)
         (за-умовою
           ((порожній? аргументи) оточення)
           (так (ядро1-створити-помилку (як-є ARITY) (як-є TOO-MANY-ARGUMENTS)))))
        ((порожній? аргументи)
         (ядро1-створити-помилку (як-є ARITY) (як-є TOO-FEW-ARGUMENTS)))
        (так
         (ядро1-поєднати-параметри
           (решта параметри)
           (решта аргументи)
           (сполучити (сполучити (перше параметри) (перше аргументи)) оточення)))))))

(визначити ядро1-застосувати-примітив
  (функція (ідентифікатор аргументи)
    (за-умовою
      ((тотожне? ідентифікатор (як-є список)) аргументи)
      ((тотожне? ідентифікатор (як-є хибне?))
       (за-умовою
         ((ядро1-один-аргумент? аргументи)
          (за-умовою
            ((порожній? (перше аргументи)) так)
            (так (як-є ()))))
         (так (ядро1-створити-помилку (як-є ARITY) ідентифікатор))))
      ((тотожне? ідентифікатор (як-є атом?))
       (за-умовою
         ((ядро1-один-аргумент? аргументи) (атом? (перше аргументи)))
         (так (ядро1-створити-помилку (як-є ARITY) ідентифікатор))))
      ((тотожне? ідентифікатор (як-є тотожне?))
       (за-умовою
         ((ядро1-два-аргументи? аргументи) (тотожне? (перше аргументи) (перше (решта аргументи))))
         (так (ядро1-створити-помилку (як-є ARITY) ідентифікатор))))
      ((тотожне? ідентифікатор (як-є сполучити))
       (за-умовою
         ((ядро1-два-аргументи? аргументи) (сполучити (перше аргументи) (перше (решта аргументи))))
         (так (ядро1-створити-помилку (як-є ARITY) ідентифікатор))))
      ((тотожне? ідентифікатор (як-є перше))
       (за-умовою
         ((ядро1-один-аргумент? аргументи)
          (за-умовою
            ((атом? (перше аргументи))
             (ядро1-створити-помилку (як-є TYPE) (як-є CAR-REQUIRES-PAIR)))
            (так (перше (перше аргументи)))))
         (так (ядро1-створити-помилку (як-є ARITY) ідентифікатор))))
      ((тотожне? ідентифікатор (як-є решта))
       (за-умовою
         ((ядро1-один-аргумент? аргументи)
          (за-умовою
            ((атом? (перше аргументи))
             (ядро1-створити-помилку (як-є TYPE) (як-є CDR-REQUIRES-PAIR)))
            (так (решта (перше аргументи)))))
         (так (ядро1-створити-помилку (як-є ARITY) ідентифікатор))))
      (так
       (ядро1-створити-помилку (як-є UNSUPPORTED-PRIMITIVE) ідентифікатор)))))

(визначити ядро1-обчислити-аргументи
  (мітка ядро1-обчислити-аргументи
    (функція (форми оточення глобальне-оточення)
      (за-умовою
        ((порожній? форми) (як-є ()))
        (так
         ((функція (перший-результат)
            (за-умовою
              ((ядро1-помилка? перший-результат) перший-результат)
              (так
               ((функція (решта-результатів)
                  (за-умовою
                    ((ядро1-помилка? решта-результатів) решта-результатів)
                    (так (сполучити перший-результат решта-результатів))))
                (ядро1-обчислити-аргументи (решта форми) оточення глобальне-оточення)))))
          (ядро1-обчислити (перше форми) оточення глобальне-оточення)))))))

(визначити ядро1-обчислити-умови
  (мітка ядро1-обчислити-умови
    (функція (умови оточення глобальне-оточення)
      (за-умовою
        ((порожній? умови)
         (ядро1-створити-помилку (як-є UNSATISFIED-CONDITIONAL) (як-є ())))
        (так
         ((функція (значення-перевірки)
            (за-умовою
              ((ядро1-помилка? значення-перевірки) значення-перевірки)
              ((порожній? значення-перевірки)
               (ядро1-обчислити-умови (решта умови) оточення глобальне-оточення))
              (так
               (ядро1-обчислити
                 (друге (перше умови))
                 оточення
                 глобальне-оточення))))
          (ядро1-обчислити
            (перше (перше умови))
            оточення
            глобальне-оточення)))))))

(визначити ядро1-застосувати
  (функція (викликана-функція аргументи глобальне-оточення)
    (за-умовою
      ((ядро1-помилка? викликана-функція) викликана-функція)
      ((ядро1-історична-тотожність-примітива викликана-функція)
       (ядро1-застосувати-примітив (ядро1-історична-тотожність-примітива викликана-функція) аргументи))
      ((ядро1-функціональний-аргумент? викликана-функція)
       (викликана-функція аргументи глобальне-оточення))
      (так
       (ядро1-створити-помилку (як-є NOT-CALLABLE) викликана-функція)))))

(визначити ядро1-назва-цитування?
  (функція (назва)
    (за-умовою
      ((тотожне? назва (як-є як-є)) так)
      ((тотожне? назва (як-є QUOTE)) так)
      ((тотожне? назва (як-є quote)) так)
      (так ні))))

(визначити ядро1-назва-умови?
  (функція (назва)
    (за-умовою
      ((тотожне? назва (як-є за-умовою)) так)
      ((тотожне? назва (як-є COND)) так)
      ((тотожне? назва (як-є cond)) так)
      (так ні))))

(визначити ядро1-назва-функції?
  (функція (назва)
    (за-умовою
      ((тотожне? назва (як-є функція)) так)
      ((тотожне? назва (як-є LAMBDA)) так)
      ((тотожне? назва (як-є lambda)) так)
      (так ні))))

(визначити ядро1-назва-визначення?
  (функція (назва)
    (за-умовою
      ((тотожне? назва (як-є визначити)) так)
      ((тотожне? назва (як-є DEFINE)) так)
      ((тотожне? назва (як-є define)) так)
      ((тотожне? назва (як-є def)) так)
      (так ні))))

(визначити ядро1-назва-мітки?
  (функція (назва)
    (за-умовою
      ((тотожне? назва (як-є мітка)) так)
      ((тотожне? назва (як-є LABEL)) так)
      ((тотожне? назва (як-є label)) так)
      (так ні))))

(визначити ядро1-обчислити
  (мітка ядро1-обчислити
    (функція (вираз оточення глобальне-оточення)
      (за-умовою
        ((атом? вираз)
         (за-умовою
           ((порожній? вираз) (як-є ()))
           ((тотожне? вираз (як-є nil)) (як-є ()))
           ((тотожне? вираз (як-є t)) так)
           ((ядро1-допущене-історичне-слово? вираз) вираз)
           (так (ядро1-знайти-значення вираз оточення глобальне-оточення))))
        ((ядро1-назва-цитування? (перше вираз))
         (друге вираз))
        ((ядро1-назва-умови? (перше вираз))
         (ядро1-обчислити-умови (решта вираз) оточення глобальне-оточення))
        ((ядро1-назва-мітки? (перше вираз))
         (ядро1-обчислити (третє вираз) оточення глобальне-оточення))
        ((ядро1-назва-функції? (перше вираз))
         (функція-значення
           (функція (аргументи оточення-виклику)
             ((функція (приєднане)
                (за-умовою
                  ((ядро1-помилка? приєднане) приєднане)
                  (так
                   (ядро1-обчислити
                     (третє вираз)
                     приєднане
                     оточення-виклику))))
              (ядро1-поєднати-параметри
                (друге вираз)
                аргументи
                оточення)))))
        ((ядро1-назва-визначення? (перше вираз))
         (ядро1-створити-помилку
           (як-є INVALID-FORM)
           (як-є DEFINE-IS-TOP-LEVEL-ONLY)))
        (так
         ((функція (викликана-функція)
            (за-умовою
              ((ядро1-помилка? викликана-функція) викликана-функція)
              (так
               ((функція (аргументи)
                  (за-умовою
                    ((ядро1-помилка? аргументи) аргументи)
                    (так (ядро1-застосувати викликана-функція аргументи глобальне-оточення))))
                (ядро1-обчислити-аргументи (решта вираз) оточення глобальне-оточення)))))
          (ядро1-обчислити (перше вираз) оточення глобальне-оточення)))))))

(визначити ядро1-створити-світ
  (функція (величина глобальне-оточення)
    (сполучити (як-є ядро1-запис-світу)
      (сполучити величина
        (сполучити глобальне-оточення (як-є ()))))))

(визначити ядро1-значення-світу
  (функція (світ)
    (друге світ)))

(визначити ядро1-глобальне-оточення-світу
  (функція (світ)
    (третє світ)))

(визначити ядро1-визначення?
  (функція (форма)
    (за-умовою
      ((атом? форма) ні)
      ((ядро1-назва-визначення? (перше форма)) так)
      (так ні))))

(визначити ядро1-обчислити-програму
  (мітка ядро1-обчислити-програму
    (функція (форми глобальне-оточення)
      (за-умовою
        ((порожній? форми)
         (ядро1-створити-світ (як-є ()) глобальне-оточення))
        ((ядро1-визначення? (перше форми))
         ((функція (форма)
            ((функція (величина)
               (за-умовою
                 ((ядро1-помилка? величина)
                  (ядро1-створити-світ величина глобальне-оточення))
                 (так
                  (ядро1-обчислити-програму
                    (решта форми)
                    (сполучити
                      (сполучити (друге форма) величина)
                      глобальне-оточення)))))
             (ядро1-обчислити (третє форма) (як-є ()) глобальне-оточення)))
          (перше форми)))
        ((порожній? (решта форми))
         (ядро1-створити-світ
           (ядро1-обчислити (перше форми) (як-є ()) глобальне-оточення)
           глобальне-оточення))
        (так
         ((функція (величина)
            (за-умовою
              ((ядро1-помилка? величина)
               (ядро1-створити-світ величина глобальне-оточення))
              (так
               (ядро1-обчислити-програму
                 (решта форми)
                 глобальне-оточення))))
          (ядро1-обчислити (перше форми) (як-є ()) глобальне-оточення)))))))

(визначити ядро1-обчислити-у-світі
  (функція (світ вираз)
    (ядро1-створити-світ
      (ядро1-обчислити вираз (як-є ()) (ядро1-глобальне-оточення-світу світ))
      (ядро1-глобальне-оточення-світу світ))))

(визначити ядро1-обчислити-програму-та-вираз
  (функція (форми вираз)
    ((функція (світ)
       (ядро1-значення-світу
         (ядро1-обчислити-у-світі світ вираз)))
     (ядро1-обчислити-програму форми (як-є ())))))

; ─────────────────────────────────────────────────────────────────────────────
; Доповнення початкового ядра: читач списків і звільнення пам'яті.
; Читач розбирає крапкові пари зі списку лексем без зовнішнього вводу.
; Звільнення пам'яті відтворює точні закони позначення та очищення.
; Усі рішення належать СЕНС, а не зовнішньому тлумаченню назв.
; ─────────────────────────────────────────────────────────────────────────────

(визначити ядро1-прочитати
  (мітка ядро1-прочитати
    (функція (лексеми)
      (за-умовою
        ((порожній? лексеми) (як-є ()))
        ((тотожне? (перше лексеми) (як-є атом?))          ; лексема АТОМ — повернути саму лексему
         (перше лексеми))
        (так
         (ядро1-прочитати-список лексеми))))))

(визначити ядро1-прочитати-список
  (мітка ядро1-прочитати-список
    (функція (лексеми)
      (за-умовою
        ((порожній? лексеми) (як-є ()))
        ((тотожне? (перше лексеми) (як-є за-умовою))          ; лексема КРАПКА — точковий хвіст
         (перше (решта лексеми)))
        (так
         (сполучити (ядро1-прочитати (перше лексеми))
              (ядро1-прочитати-список (решта лексеми))))))))

; Принцип п'ять: явна модель досяжності символьного графа.
; Це НЕ колектор живої пам'яті SENS: roots/heap тут є звичайними даними.
; Комірка — (ім'я ліве праве), імена та посилання — цитовані атоми,
; () означає відсутнє ребро. Довільне фізичне GC — лише в субстраті.
; Старе тіло втрачало всі комірки, окрім першої, й ігнорувало позначення.
; Обхід із множиною відвіданих зберігає цикл і спільного нащадка.

(визначити ядро1-повернути-память
  (функція (корені комірки)
    (ядро1-зібрати-непозначене
      (ядро1-позначити-все корені комірки) комірки)))

; Назви посилань сьомого домену мають складену структуру.
; Порівнюємо її власним рекурсивним законом, а не частковим
; атомним порівнянням. Давня назва функції збережена для викликачів.
(визначити ядро1-однакові-атоми?
  (функція (лівий правий)
    (ядро1-назви-рівні? лівий правий)))

(визначити ядро1-знайти-комірку-для-памяті
  (мітка ядро1-знайти-комірку-для-памяті
    (функція (посилання комірки)
      (за-умовою
        ((порожній? комірки) (як-є ()))
        ((ядро1-однакові-атоми? (перше (перше комірки)) посилання) (перше комірки))
        (так (ядро1-знайти-комірку-для-памяті посилання (решта комірки)))))))

(визначити ядро1-позначена-комірка?
  (мітка ядро1-позначена-комірка?
    (функція (посилання позначені)
      (за-умовою
        ((порожній? позначені) ні)
        ((ядро1-однакові-атоми? посилання (перше позначені)) так)
        (так (ядро1-позначена-комірка? посилання (решта позначені)))))))

(визначити ядро1-обійти-посилання
  (мітка ядро1-обійти-посилання
    (функція (посилання позначені комірки)
      (за-умовою
        ((порожній? посилання) позначені)
        ((ядро1-позначена-комірка? посилання позначені) позначені)
        (так
         ((функція (запис)
            (за-умовою
              ((порожній? запис) позначені)
              (так
               (ядро1-обійти-посилання
                 (третє запис)
                 (ядро1-обійти-посилання
                   (друге запис)
                   (сполучити посилання позначені)
                   комірки)
                 комірки))))
          (ядро1-знайти-комірку-для-памяті посилання комірки)))))))

(визначити ядро1-позначити-корені
  (мітка ядро1-позначити-корені
    (функція (корені позначені комірки)
      (за-умовою
        ((порожній? корені) позначені)
        (так (ядро1-позначити-корені
               (решта корені)
               (ядро1-обійти-посилання (перше корені) позначені комірки)
               комірки))))))

(визначити ядро1-позначити-все
  (функція (корені комірки)
    (ядро1-позначити-корені корені (як-є ()) комірки)))

; Збережені двоаргументні проєкції попереднього Core1, без opcode D11.
(визначити ядро1-позначити
  (функція (посилання комірки)
    (ядро1-обійти-посилання посилання (як-є ()) комірки)))

(визначити ядро1-позначити-комірку
  (функція (посилання комірки)
    (за-умовою
      ((порожній? (ядро1-знайти-комірку-для-памяті посилання комірки))
       (як-є ()))
      (так (список посилання)))))

(визначити ядро1-позначити-нащадків
  (функція (посилання комірки)
    (ядро1-обійти-посилання посилання (як-є ()) комірки)))

; Результат — лише комірки, недосяжні з явних коренів.
; Фізичне звільнення цих слотів НЕ виконується Lisp-функцією.
(визначити ядро1-зібрати-непозначене
  (мітка ядро1-зібрати-непозначене
    (функція (позначені комірки)
      (за-умовою
        ((порожній? комірки) (як-є ()))
        ((ядро1-позначена-комірка? (перше (перше комірки)) позначені)
         (ядро1-зібрати-непозначене позначені (решта комірки)))
        (так (сполучити (перше комірки)
               (ядро1-зібрати-непозначене позначені (решта комірки))))))))

(визначити ядро1-вільні-комірки
  (функція (комірки)
    (ядро1-зібрати-непозначене (як-є ()) комірки)))

; Компактна проєкція саме живих комірок у вихідному порядку.
; Вона лишає ідентичності та дочірні посилання незмінними; фізичне
; переміщення байтів/адрес — окремий механізм субстрату (#2544).
(визначити ядро1-зібрати-досяжне
  (мітка ядро1-зібрати-досяжне
    (функція (позначені комірки)
      (за-умовою
        ((порожній? комірки) (як-є ()))
        ((ядро1-позначена-комірка? (перше (перше комірки)) позначені)
         (сполучити (перше комірки)
           (ядро1-зібрати-досяжне позначені (решта комірки))))
        (так (ядро1-зібрати-досяжне позначені (решта комірки)))))))

(визначити ядро1-ущільнити-досяжне
  (функція (корені комірки)
    (ядро1-зібрати-досяжне
      (ядро1-позначити-все корені комірки) комірки)))

; Один обхід коренів дає один точний набір позначок.
; Два незалежні проходи комірок утворюють розділення (живі сміття).
; Кожна комірка належить рівно одній частині за своїм іменем;
; ніякої фізичної деалокації чи доменної семантики в Rust/Zig.
(визначити ядро1-розділити-память
  (функція (корені комірки)
    ((функція (позначені)
       (сполучити
         (ядро1-зібрати-досяжне позначені комірки)
         (сполучити
           (ядро1-зібрати-непозначене позначені комірки)
           (як-є ()))))
     (ядро1-позначити-все корені комірки))))

; ─────────────────────────────────────────────────────────────────────────────
; Початкове ядро: арифметика спирається на ратифіковані п'ятий і шостий домени.
; Значення чисел належать математичним доменам від двадцять четвертого.
; П'ятий домен містить додавання, віднімання, множення та частку.
; Шостий домен містить зміну на одиницю, зміну знака та остачу.
; Тут лише тонкі мовні обгортки без нових примітивів чи зовнішньої арифметики.
; ─────────────────────────────────────────────────────────────────────────────

(визначити ядро1-додати
  (функція (лівий правий)
    (додати лівий правий)))

(визначити ядро1-відняти
  (функція (лівий правий)
    (відняти лівий правий)))

(визначити ядро1-помножити
  (функція (лівий правий)
    (помножити лівий правий)))

(визначити ядро1-частка
  (функція (лівий правий)
    (частка лівий правий)))

; Лише допущена арифметика D24+, без історичних скорочених викликів.
(визначити ядро1-збільшити-на-один
  (функція (лівий)
    (додати лівий 1)))

(визначити ядро1-зменшити-на-один
  (функція (лівий)
    (відняти лівий 1)))

(визначити ядро1-обернути-знак
  (функція (лівий)
    (змінити-знак лівий)))

(визначити ядро1-остача
  (функція (лівий правий)
    (остача лівий правий)))

; НУЛЬ перевіряється арифметично у D24+, а не D3 EQ для атомів.
; Лише допустимі числові значення: від'ємне або додатне не є нулем.
; Обидва результати породжує сам D1-предикат СЕНС.
(визначити ядро1-нуль?
  (функція (лівий)
    (за-умовою
      ((менше? лівий 0) (атом? (сполучити (як-є ()) (як-є ()))))
      ((більше? лівий 0) (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (як-є ())) (атом? (як-є ()))))))

; ─────────────────────────────────────────────────────────────────────────────
; Початкове ядро: можливості з історичного додатка до опису мови.
; Списки властивостей, імперативний перебіг, приєднання та пошук
; реалізовані законами СЕНС і використовуються обчислювачем.
; ─────────────────────────────────────────────────────────────────────────────

(визначити ядро1-знайти-за-ключем
  (мітка ядро1-знайти-за-ключем
    (функція (ключ список-пар)
      (за-умовою
        ((порожній? список-пар) (як-є ядро1-відсутнє))
        ((тотожне? (перше (перше список-пар)) ключ)
         (перше список-пар))
        (так (ядро1-знайти-за-ключем ключ (решта список-пар)))))))

(визначити ядро1-приєднати
  (мітка ядро1-приєднати
    (функція (перший-аргумент другий-аргумент)
      (за-умовою
        ((порожній? перший-аргумент) другий-аргумент)
        (так (сполучити (перше перший-аргумент) (ядро1-приєднати (решта перший-аргумент) другий-аргумент)))))))

; Списки властивостей: читання та запис.
(визначити ядро1-отримати
  (функція (символ властивість список-пар)
    (ядро1-знайти-за-ключем властивість (ядро1-знайти-за-ключем символ список-пар))))

(визначити ядро1-записати
  (функція (символ властивість величина список-пар)
    (сполучити (сполучити символ (сполучити властивість величина))
         список-пар)))

; Імперативна програма: позначені форми та явний лічильник кроків.
; Тіло програми є списком форм із необов'язковою позначкою.
; Перехід змінює явну позначку виконання без керування з боку хоста.
(визначити ядро1-програма
  (функція (настанови)
    (ядро1-виконати-програму настанови настанови)))

(визначити ядро1-виконати-програму
  (мітка ядро1-виконати-програму
    (функція (лічильник-команд тіло)
      (за-умовою
        ((порожній? лічильник-команд) (як-є ()))
        ((ядро1-мітка? (перше лічильник-команд))
         (ядро1-виконати-програму (решта лічильник-команд) тіло))          ; рядок мітки — пропустити
        (так
         (ядро1-виконати-програму (решта лічильник-команд) тіло))))))

(визначити ядро1-перейти
  (функція (назва-мітки тіло)
    (ядро1-знайти-перехід назва-мітки тіло)))

(визначити ядро1-знайти-перехід
  (мітка ядро1-знайти-перехід
    (функція (назва-мітки тіло)
      (за-умовою
        ((порожній? тіло) (як-є ()))
        ((тотожне? (перше (перше тіло)) назва-мітки) тіло)     ; мітку знайдено
        (так (ядро1-знайти-перехід назва-мітки (решта тіло)))))))

(визначити ядро1-мітка?
  (функція (настанова)
    (за-умовою
      ((атом? настанова) ні)
      ((ядро1-атом? (перше настанова)) так)         ; окремий символ є міткою
      (так ні))))

(визначити ядро1-атом?
  (функція (перший-аргумент)
    (за-умовою
      ((порожній? перший-аргумент) так)
      ((ядро1-пара? перший-аргумент) ні)
      (так так))))

(визначити ядро1-пара?
  (функція (перший-аргумент)
    ; Допущений D1 результат замість незв'язаних так/ні.
    (хибне? (атом? перший-аргумент))))

; ─────────────────────────────────────────────────────────────────────────────
; Початкове ядро: історична можливість роботи з масивами.
; Створення масиву, читання елемента та запис значення.
; Масив є обмеженим списком, індекс має точну математичну семантику.
; Зовнішній масив чи новий машинний примітив не додається.
; ─────────────────────────────────────────────────────────────────────────────

(визначити ядро1-створити-масив
  (функція (розмір)
    (ядро1-заповнити-масив розмір (як-є ()))))

; Індекси та розміри — математичні значення D24+, не тотожність D3.
; Порожній або вичерпаний список не можна передавати перше/решта.
; Помилка межі — мовне значення, без прихованого host-виключення.
(визначити ядро1-заповнити-масив
  (мітка ядро1-заповнити-масив
    (функція (розмір накопичувач)
      (за-умовою
        ((менше? розмір 0)
         (ядро1-створити-помилку (як-є відємний-розмір-масиву) розмір))
        ((більше? розмір 0)
         (ядро1-заповнити-масив
           (ядро1-зменшити-на-один розмір)
           (сполучити 0 накопичувач)))
        ((атом? (як-є ())) накопичувач)))))

(визначити ядро1-масив
  (функція (розмір)
    (ядро1-створити-масив розмір)))

(визначити ядро1-елемент-масиву
  (мітка ядро1-елемент-масиву
    (функція (масив індекс)
      (за-умовою
        ((менше? індекс 0)
         (ядро1-створити-помилку (як-є індекс-поза-масивом) індекс))
        ((атом? масив)
         (ядро1-створити-помилку (як-є індекс-поза-масивом) індекс))
        ((більше? індекс 0)
         (ядро1-елемент-масиву
           (решта масив)
           (ядро1-зменшити-на-один індекс)))
        ((атом? (як-є ())) (перше масив))))))

(визначити ядро1-змінити-елемент-масиву
  (мітка ядро1-змінити-елемент-масиву
    (функція (масив індекс вміст)
      (за-умовою
        ((менше? індекс 0)
         (ядро1-створити-помилку (як-є індекс-поза-масивом) індекс))
        ((атом? масив)
         (ядро1-створити-помилку (як-є індекс-поза-масивом) індекс))
        ((більше? індекс 0)
         (сполучити
           (перше масив)
           (ядро1-змінити-елемент-масиву
             (решта масив)
             (ядро1-зменшити-на-один індекс)
             вміст)))
        ((атом? (як-є ())) (сполучити вміст (решта масив)))))))

(визначити ядро1-масив?
  (функція (перший-аргумент)
    ; Структурний порожній список — масив, інший атом — ні.
    ; Непорожня пара — масив; кожна гілка повертає саме біт D1.
    (за-умовою
      ((атом? перший-аргумент)
       (порожній? перший-аргумент))
      ((атом? (як-є ())) (атом? (як-є ()))))))

