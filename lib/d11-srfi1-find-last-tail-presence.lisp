; Д11: останній суфікс з явною ознакою наявності.
; Це SENS-композиція D1/D3; жодного нового коду D11 або хост-оракула.
; Вхід: чистий предикат та правильний скінченний D3-список.
; Результат: (так суфікс), інакше (ні ()).
; Знайдене значення D1:ні та структурне () залишаються різними.
; Валідація — чинний FIND-PRESENCE ДО першого виклику предиката.
; Повертаємо саму пару входу, а не копію суфікса.

; Оригінальний суфікс залишається парою D3; проміжний
; результат (так суфікс) НЕ будується після кожного збігу.
; Лише D3:() означає, що збігів не було. Значення D1:ні
; всередині непорожнього суфікса не втрачається.
(визначити знайти-останній-хвіст-із-наявністю-ядро
  (функція (умова залишок знайдений-хвіст)
    (за-умовою
      ((порожній? залишок)
       (за-умовою
         ((порожній? знайдений-хвіст)
          (список ні (як-є ())))
         (так (список так знайдений-хвіст))))
      ((умова (перше залишок))
       (знайти-останній-хвіст-із-наявністю-ядро
         умова (решта залишок) залишок))
      (так
       (знайти-останній-хвіст-із-наявністю-ядро
         умова (решта залишок) знайдений-хвіст)))))

(визначити знайти-останній-хвіст-із-наявністю
  (функція (умова елементи)
    (знайти-останній-хвіст-із-наявністю-ядро
      умова
      (перевірити-список-для-наявності елементи елементи)
      (як-є ()))))
