; Д3 і Д5: зберігаємо лише останнє входження кожного атома.
; Порядок збережених атомів та віддалені неповторені значення незмінні.
; Семантика належить самому СЕНС. Д7 є лише текстовою проєкцією.

(визначити атом-зустрічається-далі?
 (функція (шукане елементи)
  (за-умовою
   ((порожній? елементи) ні)
   ((тотожне? шукане (перше елементи)) так)
   (так (атом-зустрічається-далі? шукане (решта елементи))))))

(визначити залишити-останні-входження
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((атом-зустрічається-далі? (перше елементи) (решта елементи))
    (залишити-останні-входження (решта елементи)))
   (так (сполучити (перше елементи)
                   (залишити-останні-входження (решта елементи)))))))

(визначити списки-останніх-однакові?
 (функція (ліві праві)
  (за-умовою
   ((порожній? ліві) (порожній? праві))
   ((порожній? праві) ні)
   ((тотожне? (перше ліві) (перше праві))
    (списки-останніх-однакові? (решта ліві) (решта праві)))
   (так ні))))

