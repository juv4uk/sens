   ((порожній? приклади) так)
   ((списки-останніх-однакові?
     (залишити-останні-входження (перше (перше приклади)))
     (друге (перше приклади)))
    (за-умовою
     ((списки-останніх-однакові?
       (залишити-останні-входження
        (залишити-останні-входження (перше (перше приклади))))
       (друге (перше приклади)))
      (закони-останніх-входжень? (решта приклади)))
     (так ні)))
   (так ні))))

