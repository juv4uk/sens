; Перекривні четвірки суміжних елементів, зберігаючи порядок і повтори.
; Справжнє виконання СЕНС Д3-Д5; без пітон, джейсон та машинних літералів.
(визначити перекривні-четвірки
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) (як-є ()))
      ((атом? (решта (решта елементи))) (як-є ()))
      ((атом? (решта (решта (решта елементи)))) (як-є ()))
      (так
        (сполучити
          (список (перше елементи) (друге елементи) (третє елементи)
                  (перше (решта (решта (решта елементи)))))
          (перекривні-четвірки (решта елементи)))))))

(визначити проба-чотири
  (перекривні-четвірки
    (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?))))
(визначити проба-пять
  (перекривні-четвірки
    (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?) (як-є порожній?))))
(визначити проба-повтори
  (перекривні-четвірки
    (список (як-є атом?) (як-є решта) (як-є атом?) (як-є решта) (як-є атом?))))
(визначити проба-вкладена
  (перекривні-четвірки
    (список (список (як-є атом?) (як-є решта))
            (як-є сполучити) (як-є тотожне?) (як-є порожній?))))

; Хибність кожного закону запускає справжню помилку перше від порожнього.

; Закон 1.
(за-умовою
  ((порожній? (перекривні-четвірки (як-є ()))) так)
  (так (перше (як-є ()))))

; Закон 2.
(за-умовою
  ((порожній? (перекривні-четвірки (список (як-є атом?)))) так)
  (так (перше (як-є ()))))

; Закон 3.
(за-умовою
  ((порожній? (перекривні-четвірки (список (як-є атом?) (як-є решта)))) так)
  (так (перше (як-є ()))))

; Закон 4.
(за-умовою
  ((порожній? (перекривні-четвірки (список (як-є атом?) (як-є решта) (як-є сполучити)))) так)
  (так (перше (як-є ()))))

; Закон 5.
(за-умовою
  ((тотожне? (перше (перше проба-чотири)) (як-є атом?)) так)
