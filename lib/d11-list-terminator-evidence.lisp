; Д11: бібліотечний закон розрізнення кінця правильного та крапкового списку.
; Не створює машинної координати: композиція чинних Д1, Д3 і Д4.
; Скінченні ациклічні структури; цикли не допускаються цим законом.
; Протокол: (так ()) = правильне завершення; (ні хвіст) = крапковий хвіст.
; Д1:ні може бути коректним значенням хвоста: ознака окрема від payload.
; Критична відмінність: АТОМ? включає (), але не дорівнює ПОРОЖНІЙ?.
; Джерело структури: стандарт R7RS, правила правильних списків SRFI-1.

(визначити розрізнити-хвіст-списку
  (функція (структура)
    (за-умовою
      ((порожній? структура) (список так (як-є ())))
      ((атом? структура) (список ні структура))
      (так
       (розрізнити-хвіст-списку (решта структура))))))

; Позитивний випадок: структурна порожнеча, не Д1:ні.
(за-умовою
  ((перше (розрізнити-хвіст-списку (як-є ()))) так)
  (так (перше (як-є ()))))

; Значення порожнього завершення повинно лишатися саме ().
(за-умовою
  ((порожній? (друге (розрізнити-хвіст-списку (як-є ())))) так)
  (так (перше (як-є ()))))

; Правильний список має завершуватися (), навіть якщо голова є списком.
(за-умовою
  ((перше
     (розрізнити-хвіст-списку
       (список (список (як-є атом?)) (як-є решта)))) так)
  (так (перше (як-є ()))))

; Неправильний список із термінатором Д1:так: присутність НЕ є істиною.
(за-умовою
  ((хибне?
     (перше
       (розрізнити-хвіст-списку
         (сполучити (як-є атом?) так)))) так)
  (так (перше (як-є ()))))

; Хвіст Д1:так повертається точно, без заміни на порожній список.
(за-умовою
  ((друге
     (розрізнити-хвіст-списку
       (сполучити (як-є атом?) так))) так)
  (так (перше (як-є ()))))

; Хвіст Д1:ні — реальні дані, не відсутність запису.
(за-умовою
  ((хибне?
     (перше
       (розрізнити-хвіст-списку
         (сполучити (як-є атом?) ні)))) так)
  (так (перше (як-є ()))))

(за-умовою
  ((хибне?
     (друге
       (розрізнити-хвіст-списку
         (сполучити (як-є атом?) ні)))) так)
  (так (перше (як-є ()))))

; Сам атом також відрізняється від порожнього списку.
(за-умовою
  ((хибне? (перше (розрізнити-хвіст-списку ні))) так)
  (так (перше (як-є ()))))

; Рекурсія проходить усі пари та знаходить термінатор, не перший елемент.
(за-умовою
  ((хибне?
     (друге
       (розрізнити-хвіст-списку
         (сполучити (як-є атом?)
           (сполучити (як-є решта) ні))))) так)
  (так (перше (як-є ()))))

; Кінцевий D1-самовердикт при виконанні файлу.
(атом? (як-є ()))
