; СЕНС Д3 і Д5: суфікс другої половини правильного списку за одну ходу.
; Для непарної довжини середній елемент належить результату.
; Два вказівники: швидкий крокує по дві пари, повільний по одній.
; Повертається вихідний хвіст без жодного нового сполучити; час О(н).
; Замість довжина + повторного відкидання префікса - єдиний обхід.
(визначити суфікс-від-середини-два-вказівники
 (функція (повільний швидкий)
  (за-умовою
   ((порожній? швидкий) повільний)
   ((порожній? (решта швидкий)) повільний)
   (так (суфікс-від-середини-два-вказівники
         (решта повільний) (решта (решта швидкий)))))))

(визначити суфікс-другої-половини
 (функція (елементи)
  (суфікс-від-середини-два-вказівники елементи елементи)))

; Реальна структурна рівність Д3: атоми рівні через тотожне?, пари - рекурсивно.
(визначити однакові-серединні-дерева?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((однакові-серединні-дерева? (перше ліве) (перше праве))
    (однакові-серединні-дерева? (решта ліве) (решта праве)))
   (так ні))))

; Зламаний закон виконує перше(порожній) самим СЕНС, а не чужим інтерпретатором.
(визначити перевірити-серединний-суфікс
 (функція (вхід очікуване)
  (за-умовою
   ((однакові-серединні-дерева?
     (суфікс-другої-половини вхід) очікуване) так)
   (так (перше (як-є ()))))))

