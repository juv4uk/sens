; Охоронець драбини — запити до індексу з REPL.
;
; Навіщо: агент, який пише програму, мусить спитати «а чи є вже така
; функція?» ДО того, як писати нову. Цей файл дає таку відповідь із
; даних, згенерованих із джерел, а не з пам'яті.
;
; Дані: lib/generated/drabyna-data.lisp — 5110 записів
;   (список "ім'я" "файл" рядок уживань арність)
;
; Поверхні, вжиті тут, усі вже є в lib/core.lisp — нових не вводимо:
;   перше :31   решта :35   порожній? :12   тотожне? :16   друге :29
;   за-умовою   список   функція   визначити
;
; Чого цей файл НЕ робить: не вигадує домен функції. Домен — це
; координата (таблиця lib/domains/d*.lisp), а не простір імен.

; Знайти запис за іменем. Повертає запис або порожнечу.
(визначити драбина-знайти
  (функція (записи ім'я)
    (за-умовою
      ((порожній? записи) (як-є ()))
      ((тотожне? (перше (перше записи)) ім'я) (перше записи))
      ((як-є ()) (драбина-знайти (решта записи) ім'я)))))

; Чи визначена функція в драбині? Д1-відповідь, без текстових псевдонімів.
(визначити драбина-є?
  (функція (ім'я)
    (за-умовою
      ((порожній? (драбина-знайти драбина-записи ім'я)) (як-є ()))
      ((як-є ()) (атом? (як-є ()))))))

; Де визначено: (список "файл" рядок). Порожнеча, якщо не знайдено.
(визначити драбина-де
  (функція (ім'я)
    (за-умовою
      ((порожній? (драбина-знайти драбина-записи ім'я)) (як-є ()))
      ((як-є ()) (список (друге (драбина-знайти драбина-записи ім'я))
                         (перше (решта (решта (драбина-знайти драбина-записи ім'я)))))))))

; Скільки разів ім'я зустрічається в lib/**. Це показник, на чому
; стоїть мова: 5049 у «функція», 139 у «помножити», 1 у рідкісних.
(визначити драбина-уживань
  (функція (ім'я)
    (за-умовою
      ((порожній? (драбина-знайти драбина-записи ім'я)) (як-є ()))
      ((як-є ()) (перше (решта (решта (решта (драбина-знайти драбина-записи ім'я)))))))))

; Скільки всього визначень. Один прохід, без нових механізмів.
(визначити драбина-лічба
  (функція (записи)
    (за-умовою
      ((порожній? записи) 0)
      ((як-є ()) (додати 1 (драбина-лічба (решта записи)))))))
