; Д3 і Д5: взяти найдовший початковий ланцюг заданого атома.
; Лише точна тотожність атомів, жодного ЕК над парами.
(визначити взяти-поки-атом
  (функція (елементи шукане)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((тотожне? (перше елементи) шукане)
       (сполучити (перше елементи)
         (взяти-поки-атом (решта елементи) шукане)))
      ((атом? (як-є ())) (як-є ())))))
(визначити вхід-поки-взяти
  (список (як-є атом?) (як-є атом?) (як-є решта) (як-є атом?)))
(визначити префікс-взяти
  (взяти-поки-атом вхід-поки-взяти (як-є атом?)))
(визначити все-взяти
  (взяти-поки-атом (список (як-є атом?) (як-є атом?)) (як-є атом?)))
(визначити жодного-взяти
  (взяти-поки-атом вхід-поки-взяти (як-є решта)))

