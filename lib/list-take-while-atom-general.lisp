   (за-умовою
  ((хибне? (тотожне? (перше префікс-взяти) (як-є решта)))
   (за-умовою
  ((тотожне? (перше все-взяти) (як-є атом?))
   (за-умовою
  ((тотожне? (друге все-взяти) (як-є атом?))
   (за-умовою
  ((порожній? (решта (решта все-взяти)))
   (за-умовою
  ((порожній? жодного-взяти)
   (за-умовою
  ((порожній? (взяти-поки-атом (як-є ()) (як-є атом?)))
   (за-умовою
  ((порожній? (взяти-поки-атом (список (як-є решта)) (як-є атом?)))
   (за-умовою
  ((тотожне? (перше (взяти-поки-атом (список (як-є решта)) (як-є решта))) (як-є решта))
   (за-умовою
  ((порожній? (решта (взяти-поки-атом (список (як-є решта)) (як-є решта))))
   (за-умовою
  ((порожній? (взяти-поки-атом (список (як-є атом?)) (як-є решта)))
   (за-умовою
  ((порожній? (взяти-поки-атом (список (як-є решта) (як-є атом?)) (як-є атом?)))
