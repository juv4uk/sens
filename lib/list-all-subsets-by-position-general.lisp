; Усі підмножини скінченного списку за позиціями, не за різними значеннями.
; Повторені атоми залишають різні вибори, зберігається вхідний порядок.
; Порожній список має рівно одну підмножину - порожню.
; Рекурсію та семантику виконує СЕНС, транспорт належить Зіг.
; Д7 кодує лише людську проєкцію, без чужих машинних чисел.

(визначити зєднати-списки-підмножин
  (функція (ліві праві)
    (за-умовою
      ((порожній? ліві) праві)
      ((атом? (як-є ()))
       (сполучити
         (перше ліві)
         (зєднати-списки-підмножин (решта ліві) праві))))))

(визначити додати-голову-до-всіх-підмножин
  (функція (голова підмножини)
    (за-умовою
      ((порожній? підмножини) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (сполучити голова (перше підмножини))
         (додати-голову-до-всіх-підмножин голова (решта підмножини)))))))

(визначити розширити-підмножини
  (функція (голова підмножини-хвоста)
    (зєднати-списки-підмножин
      підмножини-хвоста
      (додати-голову-до-всіх-підмножин голова підмножини-хвоста))))

(визначити усі-підмножини-за-позиціями
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (список (як-є ())))
      ((атом? (як-є ()))
       (розширити-підмножини
         (перше елементи)
         (усі-підмножини-за-позиціями (решта елементи)))))))

; Структурна рівність: Д3 тотожне? приймає лише два атоми.
; Різниця між порожнечею, атомом та парою зберігається.
(визначити рівні-підмножини?
  (функція (ліві праві)
    (за-умовою
      ((порожній? ліві) (порожній? праві))
      ((порожній? праві) ні)
      ((атом? ліві)
       (за-умовою
         ((атом? праві) (тотожне? ліві праві))
         ((атом? (як-є ())) ні)))
      ((атом? праві) ні)
      ((рівні-підмножини? (перше ліві) (перше праві))
       (рівні-підмножини? (решта ліві) (решта праві)))
      ((атом? (як-є ())) ні))))

