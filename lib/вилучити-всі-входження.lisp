; Вилучення всіх входжень одного атома з власного скінченного списку атомів.
; Д3: порожній хвіст, порівняння атомів, перше, решта, сполучення.
; Жодного нового резидента, прихованого хостового фільтра чи зміни порядку.
(визначити вилучити-всі-входження
  (функція (шукане елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((тотожне? шукане (перше елементи))
       (вилучити-всі-входження шукане (решта елементи)))
      ((атом? (як-є ()))
       (сполучити
         (перше елементи)
         (вилучити-всі-входження шукане (решта елементи)))))))

(визначити початкові-атоми
  (список (як-є атом?) (як-є решта) (як-є атом?)
          (як-є тотожне?) (як-є атом?)))
(визначити без-шуканого
  (вилучити-всі-входження (як-є атом?) початкові-атоми))
(визначити незмінні-атоми
  (вилучити-всі-входження (як-є сполучити) початкові-атоми))

; Справжній результат СЕНС — Д1:так лише за всіх законів:
; порядок збережених, довжина, порожній базис, повне вилучення,
; відсутній атом нічого не змінює, негатив до хибного першого елемента.
(за-умовою
  ((тотожне? (перше без-шуканого) (як-є решта))
   (за-умовою
     ((тотожне? (друге без-шуканого) (як-є тотожне?))
      (за-умовою
        ((атом? (решта (решта без-шуканого)))
         (за-умовою
           ((атом? (вилучити-всі-входження (як-є атом?) (як-є ())))
            (за-умовою
              ((атом? (вилучити-всі-входження
                         (як-є атом?) (список (як-є атом?) (як-є атом?))))
               (за-умовою
                 ((тотожне? (перше незмінні-атоми) (як-є атом?))
                  (за-умовою
                    ((тотожне? (друге незмінні-атоми) (як-є решта))
                     (за-умовою
                       ((хибне? (тотожне? (перше без-шуканого) (як-є атом?)))
                        (атом? (як-є ())))
                       ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                    ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                 ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
              ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
           ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
        ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
     ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
