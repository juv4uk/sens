; СЕНС: вилучати кожний четвертий елемент із правильного списку.
; Один прохід, три нові пари на повну четвірку, неповний хвіст спільний.
; Звичайні та вкладені дані зберігаються без числових лічильників.
; Д1 вирішує закони, Д3-Д5 виконують, Д7 кодує лише відсутні в драбині назви.
(визначити вилучити-кожен-четвертий
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (решта елементи)) елементи)
   ((атом? (решта (решта елементи))) елементи)
   ((атом? (решта (решта (решта елементи)))) елементи)
   (так
    (сполучити (перше елементи)
     (сполучити (друге елементи)
      (сполучити (третє елементи)
       (вилучити-кожен-четвертий
        (решта (решта (решта (решта елементи))))))))))))

; Порівняння дерев виконує сама мова, не хостовий тест.
(визначити дерева-четвертого-однакові?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою ((атом? праве) (тотожне? ліве праве))
                (так ні)))
   ((атом? праве) ні)
   ((дерева-четвертого-однакові? (перше ліве) (перше праве))
    (дерева-четвертого-однакові? (решта ліве) (решта праве)))
   (так ні))))

(визначити перевірити-четверте-вилучення
 (функція (вхід очікуване)
  (за-умовою
   ((дерева-четвертого-однакові?
     (вилучити-кожен-четвертий вхід) очікуване) так)
   (так (перше (як-є ()))))))

