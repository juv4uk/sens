; Д11: SRFI-1 LIST-TABULATE. Кандидат без нової доменної координати.
; Вхід: невід'ємна точна ціла кількість D24+ і першокласна функція.
; Елемент i створює один виклик (створити-елемент i).
; D1:ні й D3:() як елементи зберігаються, не завершують список.
; Неправильна кількість відхиляється D3 CAR Type до виклику callback.
; Динамічний порядок у SRFI-1 вільний, тут індекси зростають від нуля.
(визначити табулювати-список-ядро
  (функція (створити-елемент кількість індекс накопичене)
    (за-умовою
      ((менше? індекс кількість)
       (табулювати-список-ядро
         створити-елемент
         кількість
         (додати індекс число-один)
         (сполучити (створити-елемент індекс) накопичене)))
      (так (зворот накопичене)))))

(визначити табулювати-список
  (функція (кількість створити-елемент)
    (за-умовою
      ((ціле? кількість)
       (за-умовою
         ((менше? кількість число-нуль)
          (перше (як-є ())))
         (так
          (табулювати-список-ядро
            створити-елемент кількість число-нуль (як-є ())))))
      (так (перше (як-є ()))))))
