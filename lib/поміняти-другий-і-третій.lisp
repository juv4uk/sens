; Обмін другого і третього елементів у власній четвірці.
; Похідний закон третього та четвертого доменів.
(визначити поміняти-другий-і-третій
  (функція (четвірка)
    (список
      (перше четвірка)
      (перше (решта (решта четвірка)))
      (перше (решта четвірка))
      (перше (решта (решта (решта четвірка)))))))

(визначити початкова-четвірка-для-обміну
  (список (як-є атом?) (як-є тотожне?) (як-є решта) (як-є сполучити)))
(визначити обміняна-четвірка
  (поміняти-другий-і-третій початкова-четвірка-для-обміну))

; Справжнє виконання відтворює правильний порядок і відхиляє старий.
(за-умовою
  ((тотожне? (перше обміняна-четвірка) (як-є атом?))
   (за-умовою
     ((тотожне? (друге обміняна-четвірка) (як-є решта))
      (за-умовою
        ((тотожне? (перше (решта (решта обміняна-четвірка))) (як-є тотожне?))
         (за-умовою
           ((тотожне? (перше (решта (решта (решта обміняна-четвірка)))) (як-є сполучити))
            (хибне? (тотожне? (друге обміняна-четвірка) (як-є тотожне?))))
           ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
