; Кожен елемент правильного списку має бути атомом і з'являтися один раз.
; Сусідні й несусідні повторення однаково порушують закон.
; Вкладену пару не можна передавати до тотожне? третього домену.
; Перевірки нижче виконуються самою мовою, без зовнішнього обчислювача.

(визначити атом-зустрічається-далі?
  (функція (шукане елементи)
    (за-умовою
      ((порожній? елементи) ні)
      ((хибне? (атом? (перше елементи)))
       (атом-зустрічається-далі? шукане (решта елементи)))
      ((тотожне? шукане (перше елементи)) так)
      (так (атом-зустрічається-далі? шукане (решта елементи))))))

(визначити усі-атоми-різні?
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) так)
      ((хибне? (атом? (перше елементи))) ні)
      ((атом-зустрічається-далі? (перше елементи) (решта елементи)) ні)
      (так (усі-атоми-різні? (решта елементи))))))

; Невиконаний закон викликає справжню помилку перше від порожнечі.

; Порожній список
(за-умовою
  (((усі-атоми-різні? (як-є ())) (атом? (як-є ()))))
  (так (перше (як-є ()))))

; Один атом
(за-умовою
  (((усі-атоми-різні? (список (як-є атом?))) (атом? (як-є ()))))
  (так (перше (як-є ()))))

; Два різні атоми
(за-умовою
  (((усі-атоми-різні? (список (як-є атом?) (як-є решта))) (атом? (як-є ()))))
  (так (перше (як-є ()))))

; Три різні атоми
(за-умовою
  (((усі-атоми-різні? (список (як-є атом?) (як-є решта) (як-є сполучити))) (атом? (як-є ()))))
  (так (перше (як-є ()))))

; Сусідні повторення
(за-умовою
  (((хибне? (усі-атоми-різні? (список (як-є атом?) (як-є атом?)))) (атом? (як-є ()))))
  (так (перше (як-є ()))))

; Несусідні повторення
(за-умовою
  (((хибне? (усі-атоми-різні? (список (як-є атом?) (як-є решта) (як-є атом?)))) (атом? (як-є ()))))
  (так (перше (як-є ()))))

; Повтор наприкінці
(за-умовою
  (((хибне? (усі-атоми-різні? (список (як-є решта) (як-є атом?) (як-є сполучити) (як-є решта)))) (атом? (як-є ()))))
  (так (перше (як-є ()))))

; Один вкладений елемент
(за-умовою
  (((хибне? (усі-атоми-різні? (список (список (як-є атом?))))) (атом? (як-є ()))))
  (так (перше (як-є ()))))

; Вкладений елемент посередині
(за-умовою
  (((хибне? (усі-атоми-різні? (список (як-є атом?) (список (як-є решта)) (як-є сполучити)))) (атом? (як-є ()))))
  (так (перше (як-є ()))))

; Пошук пропускає вкладену пару
(за-умовою
  (((атом-зустрічається-далі? (як-є атом?) (список (список (як-є атом?)) (як-є атом?))) (атом? (як-є ()))))
  (так (перше (як-є ()))))

; Сам вкладений елемент не є шуканим атомом
(за-умовою
  (((хибне? (атом-зустрічається-далі? (як-є атом?) (список (список (як-є атом?))))) (атом? (як-є ()))))
  (так (перше (як-є ()))))
