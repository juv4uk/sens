;; Публічні вердикти порад — українські мітки; ключі сумісності пакетів
;; (format/version/module/clauses) лишаються незмінним зовнішнім протоколом.
;; Незмінний світ — звичайні дані СЕНС:
;;   (world батько журнал-знань метадані)
;; Кожен перехід повертає нове значення, залишаючи попередній
;; світ батьком. Журнал нової версії спільно використовує хвіст
;; старого списку. Змінюваний об'єкт хоста й новий примітив Rust
;; для таких переходів не потрібні.
;; Назва world у формі є незмінним протокольним маркером даних.

; Д10 META = метадані — канонічна виклична голова, не локальний параметр.
; Відокремлюємо назву поля від ідентичності функції без зміни даних world.
; Точні D24 корені надходять із канонічного Core4 binding-source.
; Не використовуємо недопущений D6 LENGTH для значень чисел.
(визначити світ-число-нуль число-нуль)
(визначити світ-число-один число-один)

(визначити створити-світ
  (функція (батько журнал дані-світу)
    (список (як-є world) батько журнал дані-світу)))

(визначити порожній-світ
  (функція ()
    (створити-світ (як-є ()) (як-є ()) (як-є ()))))

(визначити світ?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((внутрішня-рівність-версій (перше значення) (як-є world))
       (за-умовою
         ; Точна форма: (world батько журнал метадані).
         ; D3 ATOM/CDR перевіряють необхідні хвости; D4 NULL відкидає зайве поле.
         ; Без D6 LENGTH, числового літерала арності та перевірки списку хостом.
         ((атом? (решта значення)) ні)
         ((атом? (решта (решта значення))) ні)
         ((атом? (решта (решта (решта значення)))) ні)
         ((порожній? (решта (решта (решта (решта значення))))) так)
         (так ні)))
      (так ні))))

(визначити світ-батько (функція (світ) (друге світ)))
(визначити світ-журнал (функція (світ) (третє світ)))
; D6:100111 CADDDR поки не має допущеного механізму обчислення.
; Четверте поле виводимо через точні D3:011 CDR та D5:10011 CADDR.
(визначити світ-метадані (функція (світ) (третє (решта світ))))

;; Події мають ту саму форму даних, що й журнал у
;; lib/knowledge.lisp. Це зберігає сумісність пакетів та
;; проєкцій між бібліотеками без прихованого перетворення.

(визначити світ-запис
  (функція (світ подія)
    (створити-світ світ
                (сполучити подія (світ-журнал світ))
                (світ-метадані світ))))

(визначити світ-повідомити
  (функція (світ назва-модуля клауза)
    (світ-запис світ (список (як-є tell) назва-модуля клауза))))

(визначити світ-відкликати
  (функція (світ назва-модуля клауза)
    (світ-запис світ (список (як-є retract) назва-модуля клауза))))

; D6 FILTER (101001) не має допущеного механізму обчислення.
; Події модуля відбираємо через точну структуру атома/пари D3
; і D3 EQ для атомарної назви модуля, зберігаючи порядок подій.
(визначити внутрішні-події-модуля
  (функція (назва-модуля події)
    (за-умовою
      ((порожній? події) (як-є ()))
      ((атом? події) (як-є ()))
      ((внутрішня-рівність-версій (друге (перше події)) назва-модуля)
       (сполучити (перше події) (внутрішні-події-модуля назва-модуля (решта події))))
      (так (внутрішні-події-модуля назва-модуля (решта події))))))

(визначити світ-модуль-події
  (функція (світ назва-модуля)
    (внутрішні-події-модуля назва-модуля (світ-журнал світ))))

; Вилучаємо першу структурно рівну клаузу. Атоми й вкладені
; пари порівнюємо за локально виведеним точним законом рівності D1.
(визначити внутрішній-світ-прибрати-перше
  (функція (значення значення-списку)
    (за-умовою
      ((порожній? значення-списку) (як-є ()))
      ((атом? значення-списку) (як-є ()))
      ((внутрішня-рівність-версій значення (перше значення-списку)) (решта значення-списку))
      (так (сполучити (перше значення-списку) (внутрішній-світ-прибрати-перше значення (решта значення-списку)))))))


(визначити внутрішній-світ-застосувати-подію
  (функція (клаузи подія)
    (за-умовою
      ((внутрішня-рівність-версій (перше подія) (як-є tell)) (сполучити (третє подія) клаузи))
      ((внутрішня-рівність-версій (перше подія) (як-є retract))
       (внутрішній-світ-прибрати-перше (третє подія) клаузи))
      (так клаузи))))


; D4 NOT заперечує предикат D3 ATOM: модуль відомий лише тоді,
; коли його потік подій є непорожньою парою. D3 CONS не замінює NOT.
(визначити світ-модуль-відомий?
  (функція (світ назва-модуля)
    (хибне? (атом? (світ-модуль-події світ назва-модуля)))))

(визначити внутрішній-світ-модуль-відсутній?
  (функція (світ назва-модуля)
    (атом? (світ-модуль-події світ назва-модуля))))

; D5 REVERSE і D6 REDUCE ратифіковані, але їхню викличність
; не припускаємо: згортання подій у часовому порядку виводимо зі списків D3.
(визначити внутрішній-зворот-подій
  (функція (події накопичувач)
    (за-умовою
      ((порожній? події) накопичувач)
      ((атом? події) накопичувач)
      (так (внутрішній-зворот-подій (решта події) (сполучити (перше події) накопичувач))))))

(визначити внутрішнє-згортання-подій
  (функція (події клаузи)
    (за-умовою
      ((порожній? події) клаузи)
      ((атом? події) клаузи)
      (так (внутрішнє-згортання-подій
                  (решта події)
                  (внутрішній-світ-застосувати-подію клаузи (перше події)))))))

(визначити світ-клаузи
  (функція (світ назва-модуля)
    (внутрішнє-згортання-подій
      (внутрішній-зворот-подій (світ-модуль-події світ назва-модуля) (як-є ()))
      (як-є ()))))

;; Чисті адаптери логічного виведення залежать тільки
;; від явно переданих світу, модуля та цілі.
;; Глобальний журнал-знань тут не читаємо.

(визначити міркувати-у-світ
  (функція (світ назва-модуля мета)
    (за-умовою
      ((світ-модуль-відомий? світ назва-модуля)
       (міркувати мета (світ-клаузи світ назва-модуля)))
      ((внутрішній-світ-модуль-відсутній? світ назва-модуля)
       (як-є Module-not-found)))))

(визначити вперед-у-світ
  (функція (світ назва-модуля)
    (за-умовою
      ((світ-модуль-відомий? світ назва-модуля)
       (виконати-багатоваріантне-виведення (світ-клаузи світ назва-модуля) (як-є ())))
      ((внутрішній-світ-модуль-відсутній? світ назва-модуля)
       (як-є Module-not-found)))))

; Виведений предикат D1 для назв модулів світу як символів.
; Це закон Lisp над ATOM/NULL/EQ і точними механізмами D8
; запису та перетворення рядка на символ, а не дозвіл
; на виконання іншої координати D9:110101100.
(визначити внутрішній-символ?
  (функція (значення)
    (за-умовою
      ; Спочатку відкидаємо складене значення: D4 ПОРОЖНІЙ? лише для атома.
      ; Структурний список (зірка) не стає назвою модуля.
      ((хибне? (атом? значення)) ні)
      ((порожній? значення) ні)
      ; D1 предикат не є символом: D8 WRITE не серіалізує D1:1/D1:0.
      ((тотожне? значення так) ні)
      ((тотожне? значення (хибне? так))
       ні)
      ((тотожне? значення (текст-у-символ (значення-у-текст значення))) так)
      (так ні))))

; Явна протилежна клауза у поточному незмінному світі має пріоритет.
; Не підмінювати її відсутністю доказу в індексі міркування:
; цитовані вкладені голови звіряємо структурно, а не через D3 EQ пар.
; Повертаємо саму клаузу як одноелементний список доказів або D3 NIL.
(визначити внутрішній-світ-прямий-доказ-протилежного
  (функція (клаузи протилежне)
    (за-умовою
      ((порожній? клаузи) (як-є ()))
      ((атом? клаузи) (як-є ()))
      ((атом? (перше клаузи))
       (внутрішній-світ-прямий-доказ-протилежного (решта клаузи) протилежне))
      ; Пряме свідчення можливе лише від факту (голова).
      ; Правило (голова передумова ...) без доведеної передумови
      ; НЕ є доказом голови — його розглядає SENS-механізм міркування.
      ((хибне? (порожній? (решта (перше клаузи))))
       (внутрішній-світ-прямий-доказ-протилежного (решта клаузи) протилежне))
      ((внутрішня-рівність-версій (перше (перше клаузи)) протилежне)
       (список (перше клаузи)))
      (так
       (внутрішній-світ-прямий-доказ-протилежного (решта клаузи) протилежне)))))

(визначити порада-рішення-у-світ
  (функція (світ назва-модуля клауза)
    (за-умовою
      ((хибне? (внутрішній-символ? назва-модуля))
       (список (як-є відхилений) (список (як-є reason) (як-є invalid-module)) (список (як-є input) клауза)))
      ((хибне? (клауза-бази-знань-коректна? клауза))
       (список (як-є відхилений) (список (як-є reason) (як-є invalid-clause)) (список (як-є input) клауза)))
      (так
       (нехай ((протилежне (отримати-протилежну-голову-твердження-знання (перше клауза))))
         (нехай ((докази (за-умовою
                         ((світ-модуль-відомий? світ назва-модуля)
                          (нехай ((прямий
                                   (внутрішній-світ-прямий-доказ-протилежного
                                     (світ-клаузи світ назва-модуля) протилежне)))
                            (за-умовою
                              ((хибне? (атом? прямий)) прямий)
                              (так
                               (міркувати-у-світ світ назва-модуля протилежне)))))
                         (так (як-є ())))))
           (за-умовою
             
             ((атом? докази)  (список (як-є прийнятий)
                    (список (як-є module) назва-модуля)
                    (список (як-є knowledge) клауза)))
             (так
              (список (як-є суперечність)
                    (список (як-є new) клауза)
                    (список (як-є existing) протилежне)
                    (список (як-є proof) (перше докази)))))))))))

(визначити порадити-світ
  (функція (світ назва-модуля клауза)
    (нехай ((рішення (порада-рішення-у-світ світ назва-модуля клауза)))
      (за-умовою
        ((внутрішня-рівність-версій (перше рішення) (як-є прийнятий))
         (список рішення (світ-повідомити світ назва-модуля клауза)))
        (так (список рішення світ))))))

;; Пакетне додавання створює рівно один дочірній світ,
;; тільки якщо весь набір тверджень коректний і не суперечить
;; уже наявним знанням. Нові правила під час перевірки можуть
;; підтримувати або заперечувати одне одного.
;; У разі відхилення жоден частковий запис не стає видимим.

(визначити порада-всі-рішення-у-світ
  (функція (світ назва-модуля клаузи)
    (за-умовою
      ((хибне? (внутрішній-символ? назва-модуля))
       (список (як-є відхилений) (список (як-є reason) (як-є invalid-module)) (список (як-є input) клаузи)))
      
      ((атом? клаузи)  (список (як-є відхилений) (список (як-є reason) (як-є invalid-batch)) (список (як-є input) клаузи)))
      ((хибне? (правильно-структурований-список-знань? клаузи))
       (список (як-є відхилений) (список (як-є reason) (як-є invalid-batch)) (список (як-є input) клаузи)))
      ((хибне? (клаузи-бази-знань-коректні? клаузи))
       (список (як-є відхилений) (список (як-є reason) (як-є invalid-clause)) (список (як-є input) клаузи)))
      (так
       (нехай ((наявні (за-умовою
                         ((світ-модуль-відомий? світ назва-модуля)
                          (світ-клаузи світ назва-модуля))
                         (так (як-є ())))))
         (нехай ((суперечність (виявити-суперечність-у-групі-порад
                           клаузи клаузи (приєднати клаузи наявні))))
           (за-умовою
             
             ((атом? суперечність)  (список (як-є прийнятий)
                    (список (як-є module) назва-модуля)
                    (список (як-є knowledge) клаузи)))
             (так
              (список (як-є суперечність)
                    (список (як-є new) (перше суперечність))
                    (список (як-є existing) (друге суперечність))
                    (список (як-є proof) (третє суперечність)))))))))))

(визначити світ-повідомити-всі
  (функція (світ назва-модуля клаузи)
    (створити-світ світ
                (приєднати (перетворити-клаузи-на-події-повідомлення назва-модуля клаузи)
                        (світ-журнал світ))
                (світ-метадані світ))))

; D9 визначити-модуль (111100110) уже є мовним зв'язуванням.
; Не перевизначаємо ратифікований D9 макрос через DEFINE: світ використовує
; явні функції незмінного переходу нижче.


;; Історичні макроси повідомлення й відкликання знань використовують
;; такий самий перехід. Повідомлення перевіряє суперечність до запису
;; й допускає лише підтверджений перехід. Відкликання не потребує
;; попередньої перевірки: вилучення твердження не породжує суперечності.
;; Обидва відновлюють сумісний журнал з поверненого незмінного світу.
; D9 повідомити-знання (111011010) уже є мовним зв'язуванням.
; Не перевизначаємо його через DEFINE: записування світу належить
; ратифікованому переходу повідомити-знання / світ-повідомити-всі.

; D9 111111100 «відкликати-знання» належить lib/knowledge.lisp.
; Не перевизначаємо ратифіковану ідентичність у World.

(визначити порадити-всі-світ
  (функція (світ назва-модуля клаузи)
    (нехай ((рішення (порада-всі-рішення-у-світ світ назва-модуля клаузи)))
      (за-умовою
        ((внутрішня-рівність-версій (перше рішення) (як-є прийнятий))
         (список рішення (світ-повідомити-всі світ назва-модуля клаузи)))
        (так (список рішення світ))))))

;; Умовний сумісний перехід потрібно обчислювати рівно один раз.
;; Звичайне локальне зв'язування тут непридатне: визначення оновило б
;; тимчасове лексичне оточення. Тому розгортання використовує одну
;; явну допоміжну прив'язку верхнього рівня. Аргумент і чистий
;; перехід світу виконуються по одному разу; журнал оновлюється
;; тільки після допущеного результату.
; Чинне похідне SENS-правило: теги рішення порівнюються тільки
; точним D3:101 EQ після D4:1000 CAAR. Макрос генерує виклик за назвою,
; а не цитує двійкові коди як десяткові числа і не змінює граматику.
; Guard у згенерованому AST передає українське значення Д1 «так» через «як-є так».
(визначити внутрішній-прийнято-перехід?
  (функція (перехід)
    (внутрішня-рівність-версій (перше-першого перехід) (як-є прийнятий))))

; Тільки похідний SENS-селектор. D3:100 CAR витягає рішення
; із (decision world); виклик задаємо українською назвою «перше», не числовим кодом.
(визначити внутрішнє-рішення-переходу
  (функція (перехід)
    (перше перехід)))

(визначити внутрішній-світ-розгорнути-історичний-перехід
  (функція (перехід)
    (список (як-є друге)
          (список (як-є список)
                (список (як-є визначити) (як-є внутрішній-перехід-знань) перехід)
                (список (як-є за-умовою)
                      (список
                        ; Створюємо виклик предиката D1, визначеного в СЕНС.
                        ; Його тіло виконує точні D3 EQ і D4 CAAR,
                        ; а не числове порівняння структурного списку з атомом (1).
                        (список (як-є внутрішній-прийнято-перехід?)
                              (як-є внутрішній-перехід-знань))
                        (список (як-є друге)
                              (список (як-є список)
                                    (список (як-є визначити) (як-є журнал-знань)
                                          (список (як-є світ-журнал)
                                                (список (як-є друге)
                                                      (як-є внутрішній-перехід-знань))))
                                    (список (як-є внутрішнє-рішення-переходу) (як-є внутрішній-перехід-знань)))))
                      (список (список (як-є атом?) (список (як-є як-є) (як-є ())))
                            (список (як-є внутрішнє-рішення-переходу) (як-є внутрішній-перехід-знань))))))))


(визначити порадити
  (макрос
    (функція (назва-модуля клауза)
  (внутрішній-світ-розгорнути-історичний-перехід
    (список (як-є порадити-світ)
          (список (як-є створити-світ) (як-є ()) (як-є журнал-знань) (як-є ()))
          (список (як-є як-є) назва-модуля)
          клауза)))))

(визначити порадити-всі
  (макрос
    (функція (назва-модуля клаузи)
  (внутрішній-світ-розгорнути-історичний-перехід
    (список (як-є порадити-всі-світ)
          (список (як-є створити-світ) (як-є ()) (як-є журнал-знань) (як-є ()))
          (список (як-є як-є) назва-модуля)
          клаузи)))))

;; Обмін світами використовує наявну версіоновану оболонку
;; `my-lisp-knowledge`. Експорт читає один явно вибраний стан.
;; Імпорт перевіряє оболонку як дані й передає допустимий перехід
;; функції «порадити-всі-світ». Отримані дані ніколи не обчислюються
;; як виконуваний код.
(визначити створити-світ-знання-пакет
  (функція (світ назва-модуля)
    (за-умовою
      ((хибне? (внутрішній-символ? назва-модуля))
       (список (як-є відхилений) (список (як-є reason) (як-є invalid-module)) (список (як-є input) назва-модуля)))
      ((внутрішній-світ-модуль-відсутній? світ назва-модуля)
       (список (як-є відхилений) (список (як-є reason) (як-є Module-not-found)) (список (як-є input) назва-модуля)))
      ((світ-модуль-відомий? світ назва-модуля)
       (нехай ((клаузи (світ-клаузи світ назва-модуля)))
         (за-умовою
           
           ((атом? клаузи)  (список (як-є відхилений) (список (як-є reason) (як-є invalid-batch)) (список (як-є input) клаузи)))
           (так (створити-пакет-структурованих-знань назва-модуля клаузи))))))))

; Версія пакета знань — структуроване значення (0 1), а не атом.
; Порівнюємо значення рекурсивно через структуру даних і точні відповіді Д1.
; Однакова форма не замінює рекурсивної перевірки пари.
(визначити внутрішня-рівність-версій
  (функція (ліве праве)
    ; Спочатку розрізняємо атоми й пари: порожній? є атомною перевіркою
    ; і не має отримувати пару. Для атомів однакові? обробляє також D3:().
    (за-умовою
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (однакові? ліве праве))
         (так ні)))
      ((атом? праве) ні)
      ((внутрішня-рівність-версій (перше ліве) (перше праве))
       (внутрішня-рівність-версій (решта ліве) (решта праве)))
      (так ні))))

(визначити імпорт-знання-пакет-світ
  (функція (світ пакет)
    (за-умовою
      
      ((атом? пакет)  (список (список (як-є відхилений)
                   (список (як-є reason) (як-є invalid-package))
                   (список (як-є input) пакет))
             світ))
      ((хибне? (правильно-структурований-список-знань? пакет))
       (список (список (як-є відхилений)
                   (список (як-є reason) (як-є invalid-package))
                   (список (як-є input) пакет))
             світ))
      ((хибне? (записи-пакета-знань-коректні? пакет))
       (список (список (як-є відхилений)
                   (список (як-є reason) (як-є invalid-package))
                   (список (як-є input) пакет))
             світ))
      ((внутрішня-рівність-версій (отримати-поле-пакета-знань (як-є format) пакет) (як-є my-lisp-knowledge))
       (за-умовою
         ((внутрішня-рівність-версій (отримати-поле-пакета-знань (як-є version) пакет)
                  версія-пакета-знань)
          (порадити-всі-світ світ
                            (отримати-поле-пакета-знань (як-є module) пакет)
                            (отримати-поле-пакета-знань (як-є clauses) пакет)))
         (так
          (список (список (як-є відхилений)
                      (список (як-є reason) (як-є unsupported-version))
                      (список (як-є version)
                            (отримати-поле-пакета-знань (як-є version) пакет)))
                світ))))
      (так
       (список (список (як-є відхилений)
                   (список (як-є reason) (як-є invalid-package))
                   (список (як-є input) пакет))
             світ)))))

;; Імпорт пакета завершує міграцію записувача. Історичний макрос
;; передає перевірку, оброблення версій, виявлення конфліктів
;; та атомарний перехід імпортеру світу як даних.
;; Тільки прийнятий результат повторно зв'язує журнал.
;; Імпорт пакетів завершує міграцію засобів запису: перевірку та облік версій,
;; розбір конфліктів і атомарний перехід передано імпортеру Світу, що оперує лише даними; журнал
;; перевизначається лише для пакетів зі станом accepted.
;; Імпорт пакета завершує міграцію письменника: перевірка, версіювання,
;; конфлікти й атомарний перехід лежать на чисто-даних імпортері світу; лише
;; прийнятий результат переприв'язує журнал.
(визначити імпортувати-пакет-знань
  (макрос
    (функція (пакет)
  (внутрішній-світ-розгорнути-історичний-перехід
    (список (як-є імпорт-знання-пакет-світ)
          (список (як-є створити-світ) (як-є ()) (як-є журнал-знань) (як-є ()))
          пакет)))))

;; Навігація історією використовує незмінні батьківські зв'язки,
;; а не вигадані позначки часу. Глибину відлічуємо від кореня:
;; порожній світ має глибину нуль.
;; Різниця двох світів повертає хронологічний список подій,
;; тільки якщо перший світ є предком другого.
;; Для незалежних гілок зберігаємо протокольне
;; World-not-ancestor до появи доведеного закону об'єднання.

(визначити світ-глибина
  (функція (світ)
    (за-умовою
      
      ((атом? (світ-батько світ))  світ-число-нуль)
      (так (додати світ-число-один (світ-глибина (світ-батько світ)))))))

(визначити отримати-світ-на-заданій-глибині-від-поточного
  (функція (світ поточна-глибина цільова-глибина)
    (за-умовою
      ((тотожне? поточна-глибина цільова-глибина) світ)
      ((атом? (світ-батько світ)) (як-є World-not-found))
      (так
       (отримати-світ-на-заданій-глибині-від-поточного
         (світ-батько світ)
         (відняти поточна-глибина світ-число-один)
         цільова-глибина)))))

(визначити світ-у-глибина
  (функція (світ цільова-глибина)
    (за-умовою
      ((менше? цільова-глибина світ-число-нуль)  (як-є World-not-found))
      (так (отримати-світ-на-заданій-глибині-від-поточного світ (світ-глибина світ) цільова-глибина)))))

(визначити отримати-префікс-журналу-світу
  (функція (журнал старий-журнал)
    (за-умовою
      ((внутрішня-рівність-версій журнал старий-журнал) (як-є ()))
      
      ((атом? журнал)  (як-є World-not-ancestor))
      (так
       (нехай ((залишок-подій (отримати-префікс-журналу-світу (решта журнал) старий-журнал)))
         (за-умовою
           ((цей-світ-не-є-предком-іншого? залишок-подій) залишок-подій)
           (так (сполучити (перше журнал) залишок-подій))))))))

(визначити цей-світ-не-є-предком-іншого?
  (функція (значення)
    (за-умовою
      ((внутрішня-рівність-версій значення (як-є World-not-ancestor)) так)
      (так ні))))

(визначити світ-різниця
  (функція (звідки куди)
    (за-умовою
      ((внутрішня-рівність-версій звідки куди) (як-є ()))
      
      ((атом? (світ-батько куди))  (як-є World-not-ancestor))
      (так
       (нехай ((ранні-події (світ-різниця звідки (світ-батько куди))))
         (за-умовою
           ((цей-світ-не-є-предком-іншого? ранні-події) ранні-події)
           (так
            (нехай ((події-переходу
                    (отримати-префікс-журналу-світу
                      (світ-журнал куди)
                      (світ-журнал (світ-батько куди)))))
              (за-умовою
                ((цей-світ-не-є-предком-іншого? події-переходу) події-переходу)
                (так (приєднати ранні-події події-переходу)))))))))))

;; Порівняння гілок відокремлене від політики злиття. Спершу
;; вирівнюємо обидві історії за абсолютною глибиною, далі разом
;; ідемо до батьків аж до рівних значень. Незмінювані світи
;; зі структурно рівними історіями семантично тотожні, навіть
;; якщо відновлені незалежно з пакета.
;; `world-branch-diff` повертає спільну основу і дві часові різниці.
;;
;; Порівняння гілок зупиняється до merge-policy. Історії вирівнюються за
;; абсолютною глибиною й разом ідуть до рівного предка. Для immutable-значень
;; структурно рівні історії — той самий семантичний світ. `world-branch-diff`
;; показує спільну базу та обидві хронологічні дельти.
;;
;; Порівняння гілок завершується перед політикою злиття. Обидві історії
;; зводяться до однакової глибини й спільно простежуються до спільного предка.
;; При незмінних значеннях структурно однакові історії — це той самий
;; семантичний світ. `world-branch-diff` показує базу й обидві часові дельти.
(визначити піднятись-ланцюгом-світу-до-заданої-глибини
  (функція (світ поточна-глибина цільова-глибина)
    (за-умовою
      ((тотожне? поточна-глибина цільова-глибина)  світ)
      (так (піднятись-ланцюгом-світу-до-заданої-глибини (світ-батько світ)
                               (відняти поточна-глибина світ-число-один)
                               цільова-глибина)))))

(визначити вирівняний-спільний-предок-двох-світів
  (функція (ліве праве)
    (за-умовою
      ((внутрішня-рівність-версій ліве праве) ліве)
      ((атом? ліве) (як-є World-no-common-ancestor))
      ((атом? праве) (як-є World-no-common-ancestor))
      ((атом? (світ-батько ліве)) (як-є World-no-common-ancestor))
      ((атом? (світ-батько праве)) (як-є World-no-common-ancestor))
      (так
       (вирівняний-спільний-предок-двох-світів (світ-батько ліве)
                                      (світ-батько праве))))))

; Предка знаходимо переходом по незмінюваних батьківських світах.
; Відповідь СЕНС — предикат Д1, а не числове порівняння глибини.
(визначити внутрішній-предок-світу?
  (функція (кандидат світ)
    (за-умовою
      ((атом? світ) ні)
      ((внутрішня-рівність-версій кандидат світ) так)
      ((атом? (світ-батько світ)) ні)
      (так
       (внутрішній-предок-світу? кандидат (світ-батько світ))))))

; Перший предок лівого світу, наявний серед предків правого,
; є найглибшим спільним світом. Це чиста структура СЕНС, незалежна від D24+.
(визначити світ-спільний-предок
  (функція (ліве праве)
    (за-умовою
      ((атом? ліве) (як-є World-no-common-ancestor))
      ((атом? праве) (як-є World-no-common-ancestor))
      ((внутрішній-предок-світу? ліве праве) ліве)
      ((атом? (світ-батько ліве)) (як-є World-no-common-ancestor))
      (так (світ-спільний-предок (світ-батько ліве) праве)))))

(визначити світи-не-мають-спільного-предка?
  (функція (значення)
    (за-умовою
      ((внутрішня-рівність-версій значення (як-є World-no-common-ancestor)) так)
      (так ні))))

(визначити світ-гілка-різниця
  (функція (ліве праве)
    (нехай ((спільна-основа (світ-спільний-предок ліве праве)))
      (за-умовою
        ((світи-не-мають-спільного-предка? спільна-основа) спільна-основа)
        (так
         (список (список (як-є base) спільна-основа)
               (список (як-є left) (світ-різниця спільна-основа ліве))
               (список (як-є right) (світ-різниця спільна-основа праве))))))))

;; Тотожність вмісту починається з канонічної адреси, а не
;; з передчасного примітива хешування. `write-to-string` працює
;; детерміновано і з можливістю точного зворотного читання:
;; рівні знання мають однакову адресу на кожній відповідній реалізації.
;; Адреса світу охоплює повний журнал подій і метадані,
;; але не батька: журнал уже містить історію повністю, тому
;; серіалізація не дублює її рекурсивно. Це точний ключ, не
;; криптографічний відбиток сталої довжини. Майбутній шар SHA
;; може хешувати ключ, не змінюючи визначення тотожності.
;;
;; Content-ідентичність починається з канонічної адреси, не передчасного hash-
;; примітива. `write-to-string` детермінований і read-back-safe, тому рівне
;; знання має ту саму адресу в кожній conforming-реалізації. Адреса світу
;; охоплює весь журнал подій і metadata; parent не дублюється рекурсивно.
;; Це точний ключ, не криптографічний digest; майбутній SHA лише стисне ключ.
;;
;; Тотожність вмісту починається з канонічної адреси, а не з
;; поспішного хеш-примітива. `write-to-string` детермінований і
;; зворотно читається, тож однакове знання в кожній конформній реалізації
;; має ту саму адресу. Адреса світу охоплює журнал і метадані;
;; попередник не дублюється рекурсивно. Це точний ключ,
;; не криптографічний дайджест; пізніший SHA може цей ключ укоротити.
(визначити знання-вміст-адреса
  (функція (знання)
    (значення-у-текст знання)))

(визначити світ-адреса-вміст
  (функція (світ)
    (список (як-є world-history)
            (світ-журнал світ)
            (світ-метадані світ))))

(визначити світ-вміст-адреса
  (функція (світ)
    (знання-вміст-адреса (світ-адреса-вміст світ))))

