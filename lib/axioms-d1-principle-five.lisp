; Виконувані аксіоми СЕНС: істина та хиба є точними Д1.
; Порожній структурний список Д3 не є хибою Д1.
; Принцип п'ять: контрольований текст стає структурою знання.
; Не потрібні семантичні оракули пітонів, джейсонів чи Зіга.

; Ратифіковані значення Д1: ні та так. Жодних обхідних конструкторів.

; Для Д7 складених слів використовуємо рекурсію НАШОГО СЕНС.
; Атомарне тотожне? не має права отримувати пари, незалежно від Д8 поверхні.
(визначити принцип-п'ять-структурно-рівні?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((хибне? (принцип-п'ять-структурно-рівні? (перше ліве) (перше праве))) ні)
   (так (принцип-п'ять-структурно-рівні? (решта ліве) (решта праве))))))


; Перетворити рівно чотири цитовані слова на структурований факт.
(визначити принцип-п'ять-факт
 (функція (слова)
  (за-умовою
   ; ATOM дає точний Д1:1 і для (), і для неправильного атомного хвоста.
   ; Д3 NIL не підміняє Д1 NO: відмова завжди явне «ні».
   ((атом? слова) ні)
   ((атом? (решта слова)) ні)
   ((атом? (решта (решта слова))) ні)
   ((атом? (решта (решта (решта слова)))) ні)
   ((хибне? (порожній? (решта (решта (решта (решта слова))))))
    ні)
   ((хибне? (принцип-п'ять-структурно-рівні? (друге слова) (як-є is))) ні)
   ((хибне? (принцип-п'ять-структурно-рівні? (третє слова) (як-є a))) ні)
   (так
    (список (список (четверте слова) (перше слова)))))))

; Відтворити контрольовані слова зі структури знання.
(визначити принцип-п'ять-слова
 (функція (факти)
  (за-умовою
   ((атом? факти) ні)
   ((атом? (перше факти)) ні)
   ((атом? (решта (перше факти))) ні)
   (так
    (список
     (друге (перше факти))
     (як-є is)
     (як-є a)
     (перше (перше факти)))))))

; Позитивні та негативні свідки повертають тільки Д1.
; Вихідне знання отримано з даних, а не підставлено в перевірці.
(визначити перевірити-принцип-п'ять
 (функція (факти)
  (за-умовою
   ((атом? факти) ні)
   ; Некоректна форма знання повинна повертати Д1:0, а не CAR/CDR Type.
   ((атом? (перше факти)) ні)
   ((атом? (решта (перше факти))) ні)
   ((хибне? (принцип-п'ять-структурно-рівні? (перше (перше факти)) (як-є planet)))
    ні)
   ((хибне? (принцип-п'ять-структурно-рівні? (друге (перше факти)) (як-є earth)))
    ні)
   ((хибне? (принцип-п'ять-структурно-рівні? (перше (принцип-п'ять-слова факти))
                      (як-є earth)))
    ні)
   ((хибне? (принцип-п'ять-структурно-рівні? (четверте (принцип-п'ять-слова факти))
                      (як-є planet)))
    ні)
   ((хибне? (хибне?
     (принцип-п'ять-факт (як-є (earth was a planet)))))
    ні)
   ((хибне? (хибне?
     (принцип-п'ять-факт (як-є (earth is a)))))
    ні)
   ((хибне? (хибне?
     (принцип-п'ять-факт (як-є (earth is a planet extra)))))
    ні)
   ; Негативні законні входи: сам атом та неспарований факт не кидають Type.
   ((хибне? (хибне? (принцип-п'ять-факт (як-є атом?)))) ні)
   ((хибне? (хибне? (принцип-п'ять-слова (як-є (атом?))))) ні)
   ((хибне? (хибне? (перевірити-принцип-п'ять (як-є (атом?))))) ні)
   ; Структурний Д3 порожній є атомом та порожнім, але не Д1 хибою.
   ((хибне? (порожній? (як-є ()))) ні)
   ((хибне? (атом? (як-є ()))) ні)
   ((хибне? так) ні)
   (ні ні)
   (так так))))

(перевірити-принцип-п'ять
 (принцип-п'ять-факт (як-є (earth is a planet))))
