; Виконувані аксіоми СЕНС: істина та хиба є точними D1.
; Порожній структурний список D3 не є хибою D1.
; Принцип п'ять: контрольований текст стає структурою знання.
; Не потрібні семантичні оракули Python, JSON чи Rust.

; Ратифіковані значення Д1: ні та так. Жодних обхідних конструкторів.

; D7-текст після T5M є структурованими даними, а не D3-атомом.
; Тому порівняння текстових слів потребує структурного D8 ОДНАКОВІ?,
; не атомарного D3 ТОТОЖНЕ? (воно падало під час парного SENS). 
;
; Перетворити рівно чотири цитовані слова на структурований факт.
(визначити принцип-п'ять-факт
 (функція (слова)
  (за-умовою
   ((порожній? слова) ні)
   ((порожній? (решта слова)) ні)
   ((порожній? (решта (решта слова))) ні)
   ((порожній? (решта (решта (решта слова)))) ні)
   ((хибне? (порожній? (решта (решта (решта (решта слова))))))
    ні)
   ((хибне? (однакові? (друге слова) (як-є is))) ні)
   ((хибне? (однакові? (третє слова) (як-є a))) ні)
   (так
    (список (список (четверте слова) (перше слова)))))))

; Відтворити контрольовані слова зі структури знання.
(визначити принцип-п'ять-слова
 (функція (факти)
  (за-умовою
   ((атом? факти) ні)
   ((порожній? (перше факти)) ні)
   (так
    (список
     (друге (перше факти))
     (як-є is)
     (як-є a)
     (перше (перше факти)))))))

; Позитивні та негативні свідки повертають тільки D1.
; Вихідне знання отримано з даних, а не підставлено в перевірці.
(визначити перевірити-принцип-п'ять
 (функція (факти)
  (за-умовою
   ((атом? факти) ні)
   ((хибне? (однакові? (перше (перше факти)) (як-є planet)))
    ні)
   ((хибне? (однакові? (друге (перше факти)) (як-є earth)))
    ні)
   ((хибне? (однакові? (перше (принцип-п'ять-слова факти))
                      (як-є earth)))
    ні)
   ((хибне? (однакові? (четверте (принцип-п'ять-слова факти))
                      (як-є planet)))
    ні)
   ((хибне?
     (принцип-п'ять-факт (як-є (earth was a planet))))
    ні)
   ((хибне?
     (принцип-п'ять-факт (як-є (earth is a))))
    ні)
   ((хибне?
     (принцип-п'ять-факт (як-є (earth is a planet extra))))
    ні)
   ; Структурний D3 порожній є атомом та порожнім, але не D1 хибою.
   ((хибне? (порожній? (як-є ()))) ні)
   ((хибне? (атом? (як-є ()))) ні)
   ((хибне? так) ні)
   (ні ні)
   (так так))))

(перевірити-принцип-п'ять
 (принцип-п'ять-факт (як-є (earth is a planet))))
