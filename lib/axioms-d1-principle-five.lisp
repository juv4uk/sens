; Виконувані аксіоми СЕНС: істина та хиба є точними Д1.
; Порожній структурний список Д3 не є хибою Д1.
; Принцип п'ять: контрольований текст стає структурою знання.
; Не потрібні семантичні оракули пітонів, джейсонів чи Зіга.

; Ратифіковані значення Д1: ні та так. Жодних обхідних конструкторів.

; Для Д7 складених слів використовуємо рекурсію НАШОГО СЕНС.
; Атомарне тотожне? не має права отримувати пари, незалежно від Д8 поверхні.
(визначити принцип-п'ять-структурно-рівні?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((хибне? (принцип-п'ять-структурно-рівні? (перше ліве) (перше праве))) ні)
   (так (принцип-п'ять-структурно-рівні? (решта ліве) (решта праве))))))


; Перетворити рівно чотири цитовані слова на структурований факт.
(визначити принцип-п'ять-факт
 (функція (слова)
  (за-умовою
   ; ATOM дає точний Д1:1 і для (), і для неправильного атомного хвоста.
   ; Д3 NIL не підміняє Д1 NO: відмова завжди явне «ні».
   ((атом? слова) ні)
   ((атом? (решта слова)) ні)
   ((атом? (решта (решта слова))) ні)
   ((атом? (решта (решта (решта слова)))) ні)
   ((хибне? (порожній? (решта (решта (решта (решта слова))))))
    ні)
   ((хибне? (принцип-п'ять-структурно-рівні? (друге слова) (як-є is))) ні)
   ((хибне? (принцип-п'ять-структурно-рівні? (третє слова) (як-є a))) ні)
   (так
    (список (список (четверте слова) (перше слова)))))))

; Відтворити контрольовані слова зі структури знання.
(визначити принцип-п'ять-слова
 (функція (факти)
  (за-умовою
   ((атом? факти) ні)
   ; Обернення лише для рівно одного факту з рівно двома полями.
   ; Інакше зайві факти або значення губляться без повідомлення про помилку.
   ((хибне? (порожній? (решта факти))) ні)
   ((атом? (перше факти)) ні)
   ((атом? (решта (перше факти))) ні)
   ((хибне? (порожній? (решта (решта (перше факти))))) ні)
   (так
    (список
     (друге (перше факти))
     (як-є is)
     (як-є a)
     (перше (перше факти)))))))

; Позитивні та негативні свідки повертають тільки Д1.
; Вихідне знання отримано з даних, а не підставлено в перевірці.
(визначити перевірити-принцип-п'ять
 (функція (факти)
  (за-умовою
   ((атом? факти) ні)
   ; Некоректна форма знання повинна повертати Д1:0, а не CAR/CDR Type.
   ((атом? (перше факти)) ні)
   ((атом? (решта (перше факти))) ні)
   ((хибне? (принцип-п'ять-структурно-рівні? (перше (перше факти)) (як-є planet)))
    ні)
   ((хибне? (принцип-п'ять-структурно-рівні? (друге (перше факти)) (як-є earth)))
    ні)
   ((хибне? (принцип-п'ять-структурно-рівні? (перше (принцип-п'ять-слова факти))
                      (як-є earth)))
    ні)
   ((хибне? (принцип-п'ять-структурно-рівні? (четверте (принцип-п'ять-слова факти))
                      (як-є planet)))
    ні)
   ((хибне? (хибне?
     (принцип-п'ять-факт (як-є (earth was a planet)))))
    ні)
   ((хибне? (хибне?
     (принцип-п'ять-факт (як-є (earth is a)))))
    ні)
   ((хибне? (хибне?
     (принцип-п'ять-факт (як-є (earth is a planet extra)))))
    ні)
   ; Негативні законні входи: сам атом та неспарований факт не кидають Type.
   ((хибне? (хибне? (принцип-п'ять-факт (як-є атом?)))) ні)
   ((хибне? (хибне? (принцип-п'ять-слова (як-є (атом?))))) ні)
   ((хибне? (хибне? (принцип-п'ять-слова
     (як-є ((planet earth extra)))))) ні)
   ((хибне? (хибне? (принцип-п'ять-слова
     (як-є ((planet earth) (planet mars)))))) ні)
   ((хибне? (хибне? (перевірити-принцип-п'ять (як-є (атом?))))) ні)
   ; Структурний Д3 порожній є атомом та порожнім, але не Д1 хибою.
   ((хибне? (порожній? (як-є ()))) ні)
   ((хибне? (атом? (як-є ()))) ні)
   ((хибне? так) ні)
   (ні ні)
   (так так))))

(перевірити-принцип-п'ять
 (принцип-п'ять-факт (як-є (earth is a planet))))

; ── Принцип п'ять: виконуваний доказ сучасного збирача ──
; Той самий символьний граф (комірка = (ім'я ліве праве)), але тепер
; машинно доведено: триколірне ІНКРЕМЕНТАЛЬНЕ маркування (Дейкстра/Стіл)
; дає ТОЙ САМИЙ досяжний набір, що класичний mark-sweep, на графі з
; циклом, спільним нащадком і недосяжним циклом; а бар'єр запису зберігає
; досяжність. Це незалежний закон-свідок, а не друга реалізація збирача.

(визначити принцип-п'ять-знайти-комірку
  (мітка принцип-п'ять-знайти-комірку
    (функція (ім'я комірки)
      (за-умовою
        ((атом? комірки) (як-є ()))
        ((принцип-п'ять-структурно-рівні? (перше (перше комірки)) ім'я)
         (перше комірки))
        (так (принцип-п'ять-знайти-комірку ім'я (решта комірки)))))))

(визначити принцип-п'ять-належить?
  (мітка принцип-п'ять-належить?
    (функція (ім'я набір)
      (за-умовою
        ((атом? набір) ні)
        ((принцип-п'ять-структурно-рівні? (перше набір) ім'я) так)
        (так (принцип-п'ять-належить? ім'я (решта набір)))))))

; Класичний mark-sweep: рекурсивне позначення з множиною відвіданих.

; Д5-продовження: знахідку обчислюємо рівно один раз, без анонімної call-head.
(визначити принцип-п'ять-класичне-позначення-запис
  (функція (посилання позначені комірки запис)
    (за-умовою
      ((атом? запис) позначені)
      (так
       (принцип-п'ять-класичне-позначення
         (третє запис)
         (принцип-п'ять-класичне-позначення
           (друге запис)
           (сполучити посилання позначені)
           комірки)
         комірки)))))

(визначити принцип-п'ять-класичне-позначення
  (мітка принцип-п'ять-класичне-позначення
    (функція (посилання позначені комірки)
      (за-умовою
        ((порожній? посилання) позначені)
        ((принцип-п'ять-належить? посилання позначені) позначені)
        (так
         (принцип-п'ять-класичне-позначення-запис
           посилання позначені комірки
           (принцип-п'ять-знайти-комірку посилання комірки)))))))

(визначити принцип-п'ять-класичне-маркування
  (мітка принцип-п'ять-класичне-маркування
    (функція (корені позначені комірки)
      (за-умовою
        ((атом? корені) позначені)
        (так (принцип-п'ять-класичне-маркування
               (решта корені)
               (принцип-п'ять-класичне-позначення (перше корені) позначені комірки)
               комірки))))))

; Триколірний інкрементальний крок і вичерпання робочого списку сірих.

; Обидва продовження — звичайні Д5-функції; стан списків не копіюємо.
(визначити принцип-п'ять-триколірний-крок-запис
  (функція (посилання решта-сірих чорні комірки запис)
    (за-умовою
      ((атом? запис)
       (принцип-п'ять-триколірний-крок решта-сірих чорні комірки))
      (так
       (принцип-п'ять-триколірний-крок
         (сполучити (друге запис)
           (сполучити (третє запис) решта-сірих))
         (сполучити посилання чорні)
         комірки)))))

(визначити принцип-п'ять-триколірний-крок-посилання
  (функція (посилання решта-сірих чорні комірки)
    (за-умовою
      ((порожній? посилання)
       (принцип-п'ять-триколірний-крок решта-сірих чорні комірки))
      ((принцип-п'ять-належить? посилання чорні)
       (принцип-п'ять-триколірний-крок решта-сірих чорні комірки))
      (так
       (принцип-п'ять-триколірний-крок-запис
         посилання решта-сірих чорні комірки
         (принцип-п'ять-знайти-комірку посилання комірки))))))

(визначити принцип-п'ять-триколірний-крок
  (мітка принцип-п'ять-триколірний-крок
    (функція (сірі чорні комірки)
      (за-умовою
        ((атом? сірі) (список сірі чорні))
        (так
         (принцип-п'ять-триколірний-крок-посилання
           (перше сірі) (решта сірі) чорні комірки))))))


(визначити принцип-п'ять-триколірне-маркування-стан
  (функція (стан комірки)
    (за-умовою
      ((атом? (перше стан)) (друге стан))
      (так
       (принцип-п'ять-триколірне-маркування
         (перше стан) (друге стан) комірки)))))

(визначити принцип-п'ять-триколірне-маркування
  (мітка принцип-п'ять-триколірне-маркування
    (функція (сірі чорні комірки)
      (принцип-п'ять-триколірне-маркування-стан
        (принцип-п'ять-триколірний-крок сірі чорні комірки)
        комірки))))

(визначити принцип-п'ять-триколірне-від-коренів
  (функція (корені комірки)
    (принцип-п'ять-триколірне-маркування корені (як-є ()) комірки)))

; Порівняння наборів без довжини: взаємне входження (набори без дублів).
(визначити принцип-п'ять-підмножина?
  (мітка принцип-п'ять-підмножина?
    (функція (а б)
      (за-умовою
        ((атом? а) так)
        ((принцип-п'ять-належить? (перше а) б) (принцип-п'ять-підмножина? (решта а) б))
        (так ні)))))

(визначити принцип-п'ять-набори-рівні?
  (функція (а б)
    (за-умовою
      ((принцип-п'ять-підмножина? а б) (принцип-п'ять-підмножина? б а))
      (так ні))))

; Дейкстрове затемнення при записі: чорний власник + білий нащадок.
(визначити принцип-п'ять-затемнення-при-записі
  (функція (власник нащадок сірі чорні)
    (за-умовою
      ((порожній? нащадок) (список сірі чорні))
      ((принцип-п'ять-належить? нащадок чорні) (список сірі чорні))
      ((принцип-п'ять-належить? нащадок сірі) (список сірі чорні))
      ((хибне? (принцип-п'ять-належить? власник чорні)) (список сірі чорні))
      (так (список (сполучити нащадок сірі) чорні)))))

; Оборотна пара: явний триколірний стан кодується в слово й назад.
(визначити принцип-п'ять-стан-у-слово
  (функція (сірі чорні)
    (список сірі чорні)))

(визначити принцип-п'ять-слово-у-стан
  (функція (слово)
    (список (перше слово) (друге слово))))

; ── Дані та виконувані твердження ──
; а -> б, в; б -> в; в -> б (цикл); спільний нащадок в; недосяжний
; цикл г <-> д; е -> а (недосяжне). Живі: {а б в}; сміття: {г д е}.
(визначити принцип-п'ять-корені (як-є (а)))
(визначити принцип-п'ять-комірки
  (як-є ((а б в)
         (б в ())
         (в б ())
         (г д ())
         (д г ())
         (е а ()))))

(визначити принцип-п'ять-класичні
  (принцип-п'ять-класичне-маркування
    принцип-п'ять-корені (як-є ()) принцип-п'ять-комірки))
(визначити принцип-п'ять-триколірні
  (принцип-п'ять-триколірне-від-коренів
    принцип-п'ять-корені принцип-п'ять-комірки))

; 1) обидва механізми дають однаковий набір.
(принцип-п'ять-набори-рівні? принцип-п'ять-класичні принцип-п'ять-триколірні)

; 2) точний склад живого й сміття для триколірного.
(принцип-п'ять-належить? (як-є а) принцип-п'ять-триколірні)
(принцип-п'ять-належить? (як-є б) принцип-п'ять-триколірні)
(принцип-п'ять-належить? (як-є в) принцип-п'ять-триколірні)
(хибне? (принцип-п'ять-належить? (як-є г) принцип-п'ять-триколірні))
(хибне? (принцип-п'ять-належить? (як-є д) принцип-п'ять-триколірні))
(хибне? (принцип-п'ять-належить? (як-є е) принцип-п'ять-триколірні))

; 3) бар'єр запису: чорний а дістає ребро на білий г — г стає сірим,
;    і після вичерпання досяжними стають і г, і д (недосяжний цикл).
(визначити принцип-п'ять-барєрний-стан
  (принцип-п'ять-затемнення-при-записі
    (як-є а) (як-є г) (як-є ()) принцип-п'ять-триколірні))
(визначити принцип-п'ять-після-барєру
  (принцип-п'ять-триколірне-маркування
    (перше принцип-п'ять-барєрний-стан)
    (друге принцип-п'ять-барєрний-стан)
    принцип-п'ять-комірки))
(принцип-п'ять-належить? (як-є г) принцип-п'ять-після-барєру)
(принцип-п'ять-належить? (як-є д) принцип-п'ять-після-барєру)
(хибне? (принцип-п'ять-належить? (як-є е) принцип-п'ять-після-барєру))

; 4) оборотність явного стану: слово -> стан повертає той самий стан.
(визначити принцип-п'ять-стан
  (список (як-є (а)) (як-є (б в))))
(визначити принцип-п'ять-слово
  (принцип-п'ять-стан-у-слово
    (перше принцип-п'ять-стан) (друге принцип-п'ять-стан)))
(визначити принцип-п'ять-стан-назад
  (принцип-п'ять-слово-у-стан принцип-п'ять-слово))
(принцип-п'ять-набори-рівні?
  (перше принцип-п'ять-стан-назад) (перше принцип-п'ять-стан))
(принцип-п'ять-набори-рівні?
  (друге принцип-п'ять-стан-назад) (друге принцип-п'ять-стан))

; 5) підсумок принципу: триколірний збирач доведено — повертає так.
(принцип-п'ять-набори-рівні? принцип-п'ять-класичні принцип-п'ять-триколірні)
