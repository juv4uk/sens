; M3 · бенчмарк-примітиви — українська проєкція SENS.
; Виміри = список значень; медіана = середина впорядкованого списку.
; Числа — структурні (довжина вкладених списків), без сирих літералів.
; Годинник (монотонний-мс) — capability; семантика сортування/медіани — мова.
; Поверхні: d3–d6 (довжина, менше?, перше, решта, сполучити, порожній?).
; Не SID8/Sens8, не Python/JS.

; Довжина списку — структурна метрика вимірів.
(визначити бенч-довжина
  (функція (список)
    (за-умовою
      ((порожній? список) (як-є ()))
      (так (сполучити так (бенч-довжина (решта список)))))))

; Порівняння структурних «чисел» (списків-одиниць): а коротший за б?
(визначити коротший?
  (функція (а б)
    (за-умовою
      ((порожній? а)
       (за-умовою
         ((порожній? б) ні)
         (так так)))
      (так
        (за-умовою
          ((порожній? б) ні)
          (так (коротший? (решта а) (решта б))))))))

; Вставити значення у вже впорядкований (неспадний) список.
(визначити вставити-впорядковано
  (функція (значення впорядкований)
    (за-умовою
      ((порожній? впорядкований) (сполучити значення (як-є ())))
      (так
        (за-умовою
          ((коротший? значення (перше впорядкований))
           (сполучити значення впорядкований))
          (так
            (сполучити
              (перше впорядкований)
              (вставити-впорядковано значення (решта впорядкований)))))))))

; Впорядкувати список структурних вимірів (insertion sort).
(визначити впорядкувати-виміри
  (функція (виміри)
    (за-умовою
      ((порожній? виміри) (як-є ()))
      (так
        (вставити-впорядковано
          (перше виміри)
          (впорядкувати-виміри (решта виміри)))))))

; Відкинути перший елемент n разів (n = структурне число).
(визначити відкинути
  (функція (скільки список)
    (за-умовою
      ((порожній? скільки) список)
      (так
        (за-умовою
          ((порожній? список) (як-є ()))
          (так (відкинути (решта скільки) (решта список))))))))

; Індекс середини: floor((n-1)/2) у структурних одиницях.
(визначити половина-індекс
  (функція (розмір)
    (за-умовою
      ((порожній? розмір) (як-є ()))
      (так
        (за-умовою
          ((порожній? (решта розмір)) (як-є ()))
          (так (сполучити так (половина-індекс (решта (решта розмір))))))))))

; Середина впорядкованого списку (лівий центр для парної довжини).
(визначити середина-списку
  (функція (впорядкований)
    (за-умовою
      ((порожній? впорядкований) (як-є ()))
      (так
        (перше
          (відкинути
            (половина-індекс (бенч-довжина впорядкований))
            впорядкований))))))

; Медіана: впорядкувати, взяти середину.
(визначити медіана
  (функція (виміри)
    (середина-списку (впорядкувати-виміри виміри))))

; Рівність структурних чисел.
(визначити рівне?
  (функція (а б)
    (однакові? а б)))

; Парне порівняння двох наборів (Kalibera-скелет):
; так, якщо медіана а не довша за медіану б.
(визначити медіана-не-довша?
  (функція (виміри-а виміри-б)
    ((функція (медіана-а медіана-б)
       (за-умовою
         ((коротший? медіана-а медіана-б) так)
         (так (рівне? медіана-а медіана-б))))
     (медіана виміри-а)
     (медіана виміри-б))))

; --- Енергія як метрика (крок нуль) ---
; Лічильник — capability `read-energy-uj`: RAPL через powercap sysfs,
; повертає два числа в мікроджоулях (package + dram). Механізм німий.
; Семантика — тут, мовою. Д5 `частка` точна, тож 1 000 000 мкДж = 1 Дж
; без втрат і без плаваючої коми.

(визначити мікроджоулі-у-джоулі
  (функція (мкдж)
    (частка мкдж 1000000)))

; Джоулів на 1000 форм — та сама одиниця, що forms/s, лише в енергії.
; Порядок множення обраний так, щоб не втратити точність на малих мкдж.
(визначити джоулів-на-тисячу-форм
  (функція (мкдж форми)
    (частка (помножити мкдж 1000) (помножити форми 1000000))))

; Негативний свідок виміру: лічильник RAPL монотонний.
; Якщо друге читання МЕНШЕ за перше — вимір недійсний: або лічильник
; переповнився, або читали не той домен, або прогін не відбувся.
; Без цієї перевірки «енергія на форму» може вийти від'ємною — і тихо.
(визначити енергія-не-спадає?
  (функція (перше-читання друге-читання)
    (не-менше? друге-читання перше-читання)))

; RAPL-знімок має рівно два точні числові лічильники: (package dram).
; Неповна, зайва або неправильна структура не стає нульовим виміром.
(визначити енергія-знімок-правильний?
  (функція (знімок)
    (за-умовою
      ((атом? знімок) ні)
      ((порожній? знімок) ні)
      ((порожній? (решта знімок)) ні)
      ((атом? (решта знімок)) ні)
      ((хибне? (число? (перше знімок))) ні)
      ((хибне? (число? (перше (решта знімок)))) ні)
      ((хибне? (порожній? (решта (решта знімок)))) ні)
      (так так))))

; Регресія будь-якого накопичувального лічильника робить всю пару недійсною.
(визначити енергія-пара-не-спадає?
  (функція (до після)
    (за-умовою
      ((хибне? (енергія-знімок-правильний? до)) ні)
      ((хибне? (енергія-знімок-правильний? після)) ні)
      ((хибне? (енергія-не-спадає? (перше до) (перше після))) ні)
      ((хибне? (енергія-не-спадає? (перше (решта до)) (перше (решта після)))) ні)
      (так так))))

; Зворотний порядок — негативний свідок для лічильника, що справді просунувся.
(визначити енергія-зворотний-свідок-відхилено?
  (функція (до після)
    (хибне? (енергія-пара-не-спадає? після до))))

; Дозволяємо рахувати Дж/1000 форм лише для монотонного виміру і N>0.
; Повертаємо (valid package-J/1000-forms dram-J/1000-forms), RED не відкидаємо.
(визначити енергія-на-тисячу-форм
  (функція (до після форми)
    (за-умовою
      ((хибне? (енергія-пара-не-спадає? до після))
       (як-є invalid-energy-sample))
      ((енергія-пара-не-спадає? після до)
       (як-є energy-counter-did-not-advance))
      ((хибне? (менше? число-нуль форми))
       (як-є invalid-form-count))
      (так
       (список
         (як-є valid)
         (джоулів-на-тисячу-форм (відняти (перше після) (перше до)) форми)
         (джоулів-на-тисячу-форм
           (відняти (перше (решта після)) (перше (решта до)))
           форми))))))

; Енергетичні значення — точні числа, не структурні довжини.
(визначити енергія-вставити-впорядковано
  (функція (значення впорядковані)
    (за-умовою
      ((порожній? впорядковані) (сполучити значення (як-є ())))
      ((менше? значення (перше впорядковані))
       (сполучити значення впорядковані))
      (так
       (сполучити (перше впорядковані)
         (енергія-вставити-впорядковано значення (решта впорядковані)))))))

(визначити енергія-впорядкувати
  (функція (виміри)
    (за-умовою
      ((порожній? виміри) (як-є ()))
      (так (енергія-вставити-впорядковано
             (перше виміри) (енергія-впорядкувати (решта виміри)))))))

(визначити медіана-енергії
  (функція (виміри)
    (середина-списку (енергія-впорядкувати виміри))))

(визначити енергія-запис-правильний?
  (функція (запис)
    (за-умовою
      ((атом? запис) ні)
      ((порожній? запис) ні)
      ((хибне? (однакові? (перше запис) (як-є valid))) ні)
      ((порожній? (решта запис)) ні)
      ((атом? (решта запис)) ні)
      ((порожній? (решта (решта запис))) ні)
      ((атом? (решта (решта запис))) ні)
      ((хибне? (порожній? (решта (решта (решта запис))))) ні)
      ((хибне? (число? (перше (решта запис)))) ні)
      ((хибне? (число? (перше (решта (решта запис))))) ні)
      (так так))))

(визначити енергії-записи-правильні?
  (функція (записи)
    (за-умовою
      ((порожній? записи) ні)
      ((атом? записи) ні)
      ((хибне? (енергія-запис-правильний? (перше записи))) ні)
      ((порожній? (решта записи)) так)
      (так (енергії-записи-правильні? (решта записи))))))

(визначити енергія-пакетні-виміри
  (функція (записи)
    (за-умовою
      ((порожній? записи) (як-є ()))
      (так
       (сполучити (перше (решта (перше записи)))
         (енергія-пакетні-виміри (решта записи)))))))

(визначити енергія-dram-виміри
  (функція (записи)
    (за-умовою
      ((порожній? записи) (як-є ()))
      (так
       (сполучити (перше (решта (решта (перше записи))))
         (енергія-dram-виміри (решта записи))))))

; Медіана приймає тільки валідні парні виміри; некоректний запис відхиляє весь набір.
(визначити медіана-пари-енергії
  (функція (записи)
    (за-умовою
      ((хибне? (енергії-записи-правильні? записи))
       (як-є invalid-energy-samples))
      (так
       (список
         (медіана-енергії (енергія-пакетні-виміри записи))
         (медіана-енергії (енергія-dram-виміри записи))))))

