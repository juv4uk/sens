; Experimental extension for mutually recursive top-level lambda definitions.
; Load after the current Core4 profile (`lib/core4.lisp`) and lib/meta-eval.lisp.
;
; Міграція: 10 однозв'язувальних D6:001000 LET усунено через чинну D4:0010 LAMBDA.
; Семантика: те саме одноразове обчислення аргументу, те саме локальне зв'язування.
; Двопольний D3 COND; резервна умова — прямий однобітний D1:YES.
; Reuses existing evaluator application/body logic, argument binding,
; lexical lookup, macro and lambda predicates, and positional accessors.
; Width is identity; every bit of the domain address is valued.
;
; Consecutive top-level `(def name (lambda ...))` forms are treated as one
; finite recursive group. No cyclic Rust Environment is required.
;
; A group closure stores the raw finite group as Lisp data:
;   (recursive-group-closure name params body group captured-env)
;
; At call time the group environment is reconstructed from that data.

; D3:110 condition requires an exact D1 control bit, not quoted D3 empty.
; These two predicates return D1:0 on negative branches so callers can
; compose them inside D3 COND without historical truthiness.
(визначити це-замикання-рекурсивної-групи?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      (так (тотожне? (перше значення) (як-є recursive-group-closure))))))



(визначити визначення-лямбди-на-верхньому-рівні?
  (функція (форма)
    (за-умовою
      ((атом? форма) ні)
      ((тотожне? (перше форма) (як-є визначити))
       (перевірити-форму-лямбда? (третє форма)))
      (так ні))))

(визначити взяти-групу-лямбда-визначень
  (функція (форми)
    (за-умовою
      ((атом? форми) (як-є ()))
      ((визначення-лямбди-на-верхньому-рівні? (перше форми))
       (сполучити (перше форми)
            (взяти-групу-лямбда-визначень (решта форми))))
      (так (як-є ())))))

(визначити відкинути-групу-лямбда-визначень
  (функція (форми)
    (за-умовою
      ((атом? форми) (як-є ()))
      ((визначення-лямбди-на-верхньому-рівні? (перше форми))
       (відкинути-групу-лямбда-визначень (решта форми)))
      (так форми))))

(визначити створити-замикання-взаєморекурсивної-групи
  (функція (форма група захоплене-оточення)
    ((функція (lambda-form) (список (як-є recursive-group-closure)
            (друге форма)
            (друге lambda-form)
            (решта (решта lambda-form))
            група
            захоплене-оточення)) (третє форма))))

; Build onto the captured environment so later definitions in the same group
; appear earlier in the alist, matching same-frame overwrite order.
(визначити додати-зв'язки-в-оточення-рекурсивної-групи
  (функція (форми група захоплене-оточення накопичувач)
    (за-умовою
      ((атом? форми) накопичувач)
      (так
       ((функція (форма) (додати-зв'язки-в-оточення-рекурсивної-групи
           (решта форми)
           група
           захоплене-оточення
           (сполучити
             (сполучити (друге форма)
                   (створити-замикання-взаєморекурсивної-групи форма група захоплене-оточення))
             накопичувач))) (перше форми))))))

(визначити побудувати-лексичні-зв'язки-рекурсивної-групи
  (функція (група захоплене-оточення)
    (додати-зв'язки-в-оточення-рекурсивної-групи група група захоплене-оточення захоплене-оточення)))

(визначити застосувати-замикання-взаєморекурсії
  (функція (викликана-функція аргументи)
    ((функція (оточення-групи) (обчислити-тіло-мета
        (четверте викликана-функція)
        (зв'язати-аргументи-з-лямбда-параметрами
          (третє викликана-функція)
          аргументи
          оточення-групи))) (побудувати-лексичні-зв'язки-рекурсивної-групи (п'ятий викликана-функція) (шосте-значення-групи викликана-функція)))))

; Apply wrapper: group closures go through group path; others reuse my-apply.
(визначити застосувати-групове-замикання
  (функція (викликана-функція аргументи)
    (за-умовою
      ((це-замикання-рекурсивної-групи? викликана-функція) (застосувати-замикання-взаєморекурсії викликана-функція аргументи))
      (так (застосувати-функцію-мета викликана-функція аргументи)))))

(визначити обчислити-список-групи
  (функція (вирази оточення)
    (за-умовою
      ((атом? вирази) (як-є ()))
      (так
       (сполучити (обчислити-вираз-групи (перше вирази) оточення)
            (обчислити-список-групи (решта вирази) оточення))))))

(визначити обчислити-тіло-групи
  (функція (тіло-функції оточення)
    (за-умовою
      ((атом? (решта тіло-функції)) (обчислити-вираз-групи (перше тіло-функції) оточення))
      (так
       ((функція ()
          (обчислити-вираз-групи (перше тіло-функції) оточення)
          (обчислити-тіло-групи (решта тіло-функції) оточення)))))))

(визначити обчислити-умови-групи
  (функція (гілки-умов оточення)
    (за-умовою
      ((атом? гілки-умов) (як-є ()))
      ((обчислити-вираз-групи (перше (перше гілки-умов)) оточення)
       (обчислити-вираз-групи (друге (перше гілки-умов)) оточення))
      (так (обчислити-умови-групи (решта гілки-умов) оточення)))))

(визначити застосувати-групове-замикання-власне
  (функція (викликана-функція аргументи)
    (за-умовою
      ((це-замикання-рекурсивної-групи? викликана-функція)
       ((функція (оточення-групи) (обчислити-тіло-групи
           (четверте викликана-функція)
           (зв'язати-аргументи-з-лямбда-параметрами (третє викликана-функція) аргументи оточення-групи))) (побудувати-лексичні-зв'язки-рекурсивної-групи (п'ятий викликана-функція) (шосте-значення-групи викликана-функція))))
      (так (застосувати-функцію-мета викликана-функція аргументи)))))

(визначити обчислити-вираз-групи
  (функція (вираз оточення)
    (за-умовою
      ((атом? вираз) (знайти-значення-імені-в-лексичному-середовищі вираз оточення))
      ((атом? (перше вираз))
       (за-умовою
         ((тотожне? (перше вираз) (як-є як-є)) (друге вираз))
         ((тотожне? (перше вираз) (як-є за-умовою))
          (обчислити-умови-групи (решта вираз) оточення))
         ((тотожне? (перше вираз) (як-є функція))
          (список (як-є closure) (друге вираз) (решта (решта вираз)) оточення))
         (так
          ((функція (функція-значення) (за-умовою
              ((це-макрос? функція-значення)
               (обчислити-вираз-групи (застосувати-функцію-мета функція-значення (решта вираз)) оточення))
              (так
               (застосувати-групове-замикання-власне
                 функція-значення
                 (обчислити-список-групи (решта вираз) оточення))))) (обчислити-вираз-групи (перше вираз) оточення)))))
      (так
       (застосувати-групове-замикання-власне
         (обчислити-вираз-групи (перше вираз) оточення)
         (обчислити-список-групи (решта вираз) оточення))))))

(визначити обчислити-верхню-форму-групи
  (функція (форма оточення)
    (за-умовою
      ((атом? форма) (сполучити оточення (обчислити-вираз-групи форма оточення)))
      ((тотожне? (перше форма) (як-є визначити))
       ((функція (значення) (сполучити (сполучити (сполучити (друге форма) значення) оточення) значення)) (обчислити-вираз-групи (третє форма) оточення)))
      ((тотожне? (перше форма) (як-є визначити-макрос))
       (обчислити-форму-та-оновити-оточення форма оточення))
      (так (сполучити оточення (обчислити-вираз-групи форма оточення))))))

(визначити обчислити-програму-з-рекурсивними-групами
  (функція (форми оточення)
    (за-умовою
      ((визначення-лямбди-на-верхньому-рівні? (перше форми))
       ((функція (група) ((функція (залишок-форм) ((функція (оточення-групи) (за-умовою
               ((атом? залишок-форм) (сполучити оточення-групи (решта (перше оточення-групи))))
               (так (обчислити-програму-з-рекурсивними-групами залишок-форм оточення-групи)))) (побудувати-лексичні-зв'язки-рекурсивної-групи група оточення))) (відкинути-групу-лямбда-визначень форми))) (взяти-групу-лямбда-визначень форми)))
      (так
       ((функція (результат) (за-умовою
           ((атом? (решта форми)) результат)
           (так
            (обчислити-програму-з-рекурсивними-групами
              (решта форми)
              (перше результат))))) (обчислити-верхню-форму-групи (перше форми) оточення))))))
