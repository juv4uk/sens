; СЕНС: суфікс після н-го складеного елемента, без копіювання хвоста.
; Атоми (включно з ()) не рахуються; вкладені елементи не обходяться.
; н - невід'ємне ціле Д24+, н=0 повертає вхід без змін.
; Семантика, перевірки та рекурсія - лише СЕНС, не пітон і джейсон.

(визначити хвіст-після-н-складених
 (функція (елементи скільки)
  (за-умовою
   ; Від'ємне н не є індексом: не перетворювати помилку на порожній список.
   ((менше? скільки 0) (перше (як-є ())))
   ((нуль? скільки) елементи)
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-н-складених (решта елементи) скільки))
   (так
    (хвіст-після-н-складених
     (решта елементи) (відняти скільки 1))))))

; Кожен свідок - дійсний вираз СЕНС: хибний закон викликає ПЕРШЕ ().
(визначити складені-вхід
 (список (як-є атом?)
         (список (як-є решта))
         (як-є сполучити)
         (список (як-є функція))
         (як-є визначити)))

; Жодної складеної пари: порожній результат, навіть якщо атомів багато.
(за-умовою
 ((порожній? (хвіст-після-н-складених
   (список (як-є атом?) (як-є решта)) 1)) так)
 (так (перше (як-є ()))))

; Перша складена пара стоїть після атома: результат починається з СПОЛУЧИТИ.
(за-умовою
 ((тотожне? (перше (хвіст-після-н-складених складені-вхід 1))
            (як-є сполучити)) так)
 (так (перше (як-є ()))))

; Друга складена пара: повертається саме наявний одноклітинний суфікс.
(за-умовою
 ((тотожне? (перше (хвіст-після-н-складених складені-вхід 2))
            (як-є визначити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта (хвіст-після-н-складених складені-вхід 2))) так)
 (так (перше (як-є ()))))

; Третя складена відсутня; неправильний атомарний хвіст теж завершується.
(за-умовою
 ((порожній? (хвіст-після-н-складених складені-вхід 3)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-н-складених
   (сполучити (як-є атом?) (як-є решта)) 1)) так)
 (так (перше (як-є ()))))

; Нуль не пропускає ні атомів, ні складених елементів.
(за-умовою
 ((тотожне? (перше (хвіст-після-н-складених складені-вхід 0))
            (як-є атом?)) так)
 (так (перше (як-є ()))))

; Негативний свідок: перший атом не стає нібито першою складеною парою.
(за-умовою
 ((хибне? (тотожне?
            (перше (хвіст-після-н-складених складені-вхід 1))
            (як-є решта))) так)
 (так (перше (як-є ()))))
; Додаткові D1 закони для лише складених елементів без D3 EQ на парах.
; Перша вкладена пара знімається за n=1, не торкаючись атома.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-н-складених
    (список (список (як-є атом?)) (як-є решта) (як-є функція)) 1))
   (як-є решта)) так)
 (так (перше (як-є ()))))
; Порожній елемент () атом, тож не збільшує лічильник складених.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-н-складених
    (список (як-є ()) (список (як-є атом?))
            (як-є функція) (список (як-є решта)) (як-є визначити)) 2))
   (як-є визначити)) так)
 (так (перше (як-є ()))))
; Другого складеного немає: кінцевий суфікс порожній.
(за-умовою
 ((порожній? (хвіст-після-н-складених
   (список (список (як-є атом?)) (як-є решта)) 2)) так)
 (так (перше (як-є ()))))
; Негатив: після першого складеного не слід повертати саму пару.
(за-умовою
 ((хибне? (тотожне?
    (перше (хвіст-після-н-складених
      (список (список (як-є атом?)) (як-є решта)) 1))
    (як-є атом?))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
