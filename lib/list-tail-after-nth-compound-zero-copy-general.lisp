; СЕНС: суфікс після н-го складеного елемента, без копіювання хвоста.
; Атоми (включно з ()) не рахуються; вкладені елементи не обходяться.
; н — невід'ємне ціле Д24+; нуль повертає вхід без змін.
; Семантика, перевірки та рекурсія - лише СЕНС, не пітон і джейсон.

(визначити хвіст-складені-число-нуль (довжина (як-є ())))
(визначити хвіст-складені-число-один (довжина (як-є (а))))
(визначити хвіст-складені-число-два (довжина (як-є (а б))))
(визначити хвіст-складені-число-три (довжина (як-є (а б в))))
(визначити хвіст-складені-число-чотири (довжина (як-є (а б в г))))

(визначити хвіст-після-н-складених
 (функція (елементи скільки)
  (за-умовою
   ; Від'ємне н не є індексом: не перетворювати помилку на порожній список.
   ((менше? скільки хвіст-складені-число-нуль) (перше (як-є ())))
   ((нуль? скільки) елементи)
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-н-складених (решта елементи) скільки))
   (так
    (хвіст-після-н-складених
     (решта елементи) (відняти скільки хвіст-складені-число-один))))))

; Кожен свідок - дійсний вираз СЕНС: хибний закон викликає ПЕРШЕ ().
(визначити складені-вхід
 (список (як-є атом?)
         (список (як-є решта))
         (як-є сполучити)
         (список (як-є функція))
         (як-є визначити)))

; Жодної складеної пари: порожній результат, навіть якщо атомів багато.
(за-умовою
 ((порожній? (хвіст-після-н-складених
   (список (як-є атом?) (як-є решта)) хвіст-складені-число-один)) так)
 (так (перше (як-є ()))))

; Перша складена пара стоїть після атома: результат починається з СПОЛУЧИТИ.
(за-умовою
 ((тотожне? (перше (хвіст-після-н-складених складені-вхід хвіст-складені-число-один))
            (як-є сполучити)) так)
 (так (перше (як-є ()))))

; Друга складена пара: повертається саме наявний одноклітинний суфікс.
(за-умовою
 ((тотожне? (перше (хвіст-після-н-складених складені-вхід хвіст-складені-число-два))
            (як-є визначити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта (хвіст-після-н-складених складені-вхід хвіст-складені-число-два))) так)
 (так (перше (як-є ()))))

; Третя складена відсутня; неправильний атомарний хвіст теж завершується.
(за-умовою
 ((порожній? (хвіст-після-н-складених складені-вхід хвіст-складені-число-три)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-н-складених
   (сполучити (як-є атом?) (як-є решта)) хвіст-складені-число-один)) так)
 (так (перше (як-є ()))))

; Нуль не пропускає ні атомів, ні складених елементів.
(за-умовою
 ((тотожне? (перше (хвіст-після-н-складених складені-вхід хвіст-складені-число-нуль))
            (як-є атом?)) так)
 (так (перше (як-є ()))))

; Негативний свідок: перший атом не стає нібито першою складеною парою.
(за-умовою
 ((хибне? (тотожне?
            (перше (хвіст-після-н-складених складені-вхід хвіст-складені-число-один))
            (як-є решта))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
