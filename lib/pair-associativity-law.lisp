; Д3/Д4: оборотне перегрупування трьох довільних значень CONS.
; ((a . b) . c) <-> (a . (b . c)); не змінюємо дані a, b, c.
; Нова машинна функція не вводиться: тільки чинні сполучити/перше/решта.
(визначити згрупувати-праворуч
  (функція (пара)
    (сполучити
      (перше (перше пара))
      (сполучити (решта (перше пара)) (решта пара)))))

(визначити згрупувати-ліворуч
  (функція (пара)
    (сполучити
      (сполучити (перше пара) (перше (решта пара)))
      (решта (решта пара)))))

(визначити пара-ліворуч
  (сполучити
    (сполучити (як-є атом?) (як-є тотожне?))
    (як-є решта)))
(визначити пара-праворуч (згрупувати-праворуч пара-ліворуч))
(визначити пара-відновлена (згрупувати-ліворуч пара-праворуч))

; Д1: три тотожності в кожному напрямку, плюс негатив підміни b на a.
; Якщо хоч одна тотожність хибна, SENS виконує помилковий CAR від NIL.
(за-умовою
  ((тотожне? (перше пара-праворуч) (як-є атом?))
    (за-умовою
      ((тотожне? (перше (решта пара-праворуч)) (як-є тотожне?))
        (за-умовою
          ((тотожне? (решта (решта пара-праворуч)) (як-є решта))
            (за-умовою
              ((тотожне? (перше (перше пара-відновлена)) (як-є атом?))
                (за-умовою
                  ((тотожне? (решта (перше пара-відновлена)) (як-є тотожне?))
                    (за-умовою
                      ((тотожне? (решта пара-відновлена) (як-є решта))
                        (за-умовою
                          ((хибне? (тотожне? (перше (решта пара-праворуч)) (як-є атом?)))
                            (атом? (як-є ())))
                          ((атом? (як-є ())) (перше (як-є ())))))
                      ((атом? (як-є ())) (перше (як-є ())))))
                  ((атом? (як-є ())) (перше (як-є ())))))
              ((атом? (як-є ())) (перше (як-є ())))))
          ((атом? (як-є ())) (перше (як-є ())))))
      ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
