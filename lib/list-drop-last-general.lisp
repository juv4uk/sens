; Узагальнене вилучення останнього елемента власного правильного списку.
; Закон: порожній та одиничний список дає порожній; для (а б . хс) зберігаємо а
; і рекурсивно вилучаємо останній з (б . хс). Точні Д3 і Д4, без зовнішнє-логіки.
(визначити вилучити-останній
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) (як-є ()))
      ((атом? (як-є ()))
       (сполучити (перше елементи)
                  (вилучити-останній (решта елементи)))))))

(визначити скорочена-четвірка
  (вилучити-останній
    (список (як-є атом?) (як-є тотожне?) (як-є решта) (як-є сполучити))))
(визначити скорочена-вкладена
  (вилучити-останній
    (список (сполучити (як-є атом?) (як-є ())) (як-є решта))))

; Живий свідок СЕНС: довжина, порядок, вкладена структура,
; порожній і одиничний випадки, негативна перестановка. Успіх = Д1:1.
(за-умовою
  ((атом? (вилучити-останній (як-є ())))
   (за-умовою
     ((атом? (вилучити-останній (список (як-є атом?))))
      (за-умовою
        ((тотожне? (перше скорочена-четвірка) (як-є атом?))
         (за-умовою
           ((тотожне? (друге скорочена-четвірка) (як-є тотожне?))
            (за-умовою
              ((тотожне? (перше (решта (решта скорочена-четвірка))) (як-є решта))
               (за-умовою
                 ((атом? (решта (решта (решта скорочена-четвірка))))
                  (за-умовою
                    ((хибне? (тотожне? (перше скорочена-четвірка) (як-є решта)))
                     (за-умовою
                       ((хибне? (атом? (перше скорочена-вкладена)))
                        (за-умовою
                          ((тотожне? (перше (перше скорочена-вкладена)) (як-є атом?))
                           (за-умовою
                             ((атом? (решта скорочена-вкладена))
                              (атом? (як-є ())))
                             ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                          ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                       ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                    ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                 ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
              ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
           ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
        ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
     ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ())))))

; Незалежний п'ятиелементний вхід: перевірка ще одного кроку рекурсії.
; Жодне людське ім'я тут не є машинним опкодом: всі атоми цитовані.
(визначити п'ятірка-для-вилучення
  (список (як-є атом?) (як-є тотожне?) (як-є решта)
          (як-є сполучити) (як-є за-умовою)))
(визначити четвірка-після-вилучення
  (вилучити-останній п'ятірка-для-вилучення))

; Д1-твердження: четвертий збережений, п'ятий відсутній,
; а помилкове ототожнення третього з вилученим п'ятим відхилено.
(за-умовою
  ((тотожне? (перше четвірка-після-вилучення) (як-є атом?))
    (за-умовою
      ((тотожне? (друге четвірка-після-вилучення) (як-є тотожне?))
        (за-умовою
          ((тотожне? (третє четвірка-після-вилучення) (як-є решта))
            (за-умовою
              ((тотожне? (четверте четвірка-після-вилучення) (як-є сполучити))
                (за-умовою
                  ((атом? (решта (решта (решта (решта четвірка-після-вилучення)))))
                    (хибне? (тотожне? (третє четвірка-після-вилучення) (як-є за-умовою))))
                  ((атом? (як-є ())) (перше (як-є ())))))
              ((атом? (як-є ())) (перше (як-є ())))))
          ((атом? (як-є ())) (перше (як-є ())))))
      ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
