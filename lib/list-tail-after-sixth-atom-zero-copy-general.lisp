; СЕНС Д3: zero-copy хвіст після шостого атомного елемента.
; Без Д24+ лічильника і жодного CONС. Кожен крок перевіряє атомність хвоста.
; Складені елементи не рахуються; порожній () елемент рахується.

(визначити хвіст-після-одного-для-шостого
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи)) (решта елементи))
   (так (хвіст-після-одного-для-шостого (решта елементи))))))

(визначити хвіст-після-двох-для-шостого
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи)) (хвіст-після-одного-для-шостого (решта елементи)))
   (так (хвіст-після-двох-для-шостого (решта елементи))))))

(визначити хвіст-після-трьох-для-шостого
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи)) (хвіст-після-двох-для-шостого (решта елементи)))
   (так (хвіст-після-трьох-для-шостого (решта елементи))))))

(визначити хвіст-після-чотирьох-для-шостого
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи)) (хвіст-після-трьох-для-шостого (решта елементи)))
   (так (хвіст-після-чотирьох-для-шостого (решта елементи))))))

(визначити хвіст-після-пяти-для-шостого
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи)) (хвіст-після-чотирьох-для-шостого (решта елементи)))
   (так (хвіст-після-пяти-для-шостого (решта елементи))))))

(визначити хвіст-після-шостого-атома
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи)) (хвіст-після-пяти-для-шостого (решта елементи)))
   (так (хвіст-після-шостого-атома (решта елементи))))))

; Чинні D1-свідки обчислюються тільки SENS, невірна гілка викликає CAR ().
(за-умовою
 ((порожній? (хвіст-після-шостого-атома (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-шостого-атома (як-є атом?))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-шостого-атома
    (список (як-є атом?) (як-є решта) (як-є сполучити)
            (як-є визначити) (як-є функція)))) так)
 (так (перше (як-є ()))))
; Сьомий та восьмий елементи — точні наявні атоми, не копії.
(визначити суфікс-шостого
 (хвіст-після-шостого-атома
  (список (як-є атом?) (як-є решта) (як-є сполучити)
          (як-є визначити) (як-є функція) (як-є тотожне?)
          (як-є за-умовою) (як-є як-є))))
(за-умовою
 ((тотожне? (перше суфікс-шостого) (як-є за-умовою)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (друге суфікс-шостого) (як-є як-є)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта (решта суфікс-шостого))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (тотожне? (перше суфікс-шостого) (як-є атом?))) так)
 (так (перше (як-є ()))))
; Складені елементи пропускаємо: лише атомні позиції відраховуються.
(визначити суфікс-шостого-вкладений
 (хвіст-після-шостого-атома
  (список (список (як-є атом?)) (як-є атом?)
          (список (як-є функція)) (як-є решта)
          (як-є сполучити) (як-є визначити)
          (як-є функція) (як-є тотожне?)
          (як-є за-умовою))))
(за-умовою
 ((тотожне? (перше суфікс-шостого-вкладений) (як-є за-умовою)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта суфікс-шостого-вкладений)) так)
 (так (перше (як-є ()))))
; Шостий атом може бути (), і наступний елемент тоді лишається.
(за-умовою
 ((тотожне? (перше (хвіст-після-шостого-атома
    (список (як-є атом?) (як-є решта) (як-є сполучити)
            (як-є визначити) (як-є функція) (як-є ())
            (як-є тотожне?)))) (як-є тотожне?)) так)
 (так (перше (як-є ()))))
(атом? (як-є ()))
