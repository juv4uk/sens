; Обмін другого й четвертого елементів списку з п'яти, краї незмінні.
; Точний закон композиції Д3 і Д4; дворазове застосування відновлює всі позиції.
; Цей файл самостійно повертає Д1:1 лише після позитивних і негативного свідків.
(визначити переставити-внутрішні-п'ятірки
  (функція (елементи)
    (список
      (перше елементи)
      (перше (решта (решта (решта елементи))))
      (перше (решта (решта елементи)))
      (перше (решта елементи))
      (перше (решта (решта (решта (решта елементи))))))))

(визначити початкова-п'ятірка
  (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?) (як-є порожній?)))
(визначити переставлена-п'ятірка
  (переставити-внутрішні-п'ятірки початкова-п'ятірка))
(визначити відновлена-п'ятірка
  (переставити-внутрішні-п'ятірки переставлена-п'ятірка))

(за-умовою
  ((тотожне? (перше переставлена-п'ятірка) (як-є атом?))
   (за-умовою
     ((тотожне? (перше (решта переставлена-п'ятірка)) (як-є тотожне?))
      (за-умовою
        ((тотожне? (перше (решта (решта переставлена-п'ятірка))) (як-є сполучити))
         (за-умовою
           ((тотожне? (перше (решта (решта (решта переставлена-п'ятірка)))) (як-є решта))
            (за-умовою
              ((тотожне? (перше (решта (решта (решта (решта переставлена-п'ятірка))))) (як-є порожній?))
               (за-умовою
                 ((тотожне? (перше відновлена-п'ятірка) (як-є атом?))
                  (за-умовою
                    ((тотожне? (перше (решта (решта (решта (решта відновлена-п'ятірка))))) (як-є порожній?))
                     (за-умовою
                       ((хибне? (тотожне? (перше переставлена-п'ятірка) (як-є решта)))
                        (атом? (як-є ())))
                       ((атом? (як-є ())) (перше (як-є ())))))
                    ((атом? (як-є ())) (перше (як-є ())))))
                 ((атом? (як-є ())) (перше (як-є ())))))
              ((атом? (як-є ())) (перше (як-є ())))))
           ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
