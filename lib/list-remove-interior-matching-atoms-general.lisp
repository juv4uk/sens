; Вилучити лише внутрішні входження заданого атома в правильному списку.
; Початкова і кінцева позиції зберігаються незалежно від збігу.
; Справжнє виконання і закони належать СЕНС, Зіґ лише транспортує.

(визначити пропустити-внутрішнє-входження
 (функція (елементи шукане)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((порожній? (решта елементи)) елементи)
   ((тотожне? (перше елементи) шукане)
    (пропустити-внутрішнє-входження (решта елементи) шукане))
   (так (сполучити (перше елементи)
                   (пропустити-внутрішнє-входження (решта елементи) шукане))))))

(визначити вилучити-лише-внутрішні-входження
 (функція (елементи шукане)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((порожній? (решта елементи)) елементи)
   (так (сполучити (перше елементи)
                   (пропустити-внутрішнє-входження (решта елементи) шукане))))))

(визначити списки-внутрішніх-входжень-однакові?
 (функція (лівий правий)
  (за-умовою
   ((порожній? лівий) (порожній? правий))
   ((порожній? правий) ні)
   ((тотожне? (перше лівий) (перше правий))
    (списки-внутрішніх-входжень-однакові? (решта лівий) (решта правий)))
   (так ні))))

