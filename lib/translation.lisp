            пропозиція (переклад-вміст пропозиція)))
         ((атом? (як-є ()))
          (створити-переклад-перевірка
            (як-є відхилений) (як-є некоректна-відмова)
            пропозиція (переклад-вміст пропозиція)))))
      ((атом? (як-є ()))
       (створити-переклад-перевірка
         (як-є відхилений) (як-є некоректний-переклад) пропозиція пропозиція)))))

; Лише прийняті кандидати знань відкривають вміст для допуску.
; Запитання не записує нове знання.
; Відхилений або неоднозначний огляд не переходить до функції порад.
; Перевірка вмісту прийнятого огляду не потребує анонімного
; Використання значення п'ятого домену не відкриває доступ для запитів чи відхилень.
(визначити переклад-допустимість-пропозиції?
  (функція (пропозиція)
    (за-умовою
      ((хибне? (структура-обгортки-перекладу-коректна? пропозиція)) ні)
      ((однакові? (переклад-стан пропозиція) (як-є кандидат))
       (за-умовою
         ((однакові? (переклад-вид пропозиція) (як-є клауза)) (атом? (як-є ())))
         ((однакові? (переклад-вид пропозиція) (як-є пакет)) (атом? (як-є ())))
         ((атом? (як-є ())) ні)))
      ((атом? (як-є ())) ні))))

(визначити переклад-допустимий?
  (функція (огляд)
    (за-умовою
      ((хибне? (запис-огляду-перекладу-коректний? огляд)) ні)
      ((однакові? (переклад-перевірка-стан огляд) (як-є прийнятий))
       (переклад-допустимість-пропозиції?
         (переклад-перевірка-пропозиція огляд)))
      ((атом? (як-є ())) ні))))

(визначити переклад-допуск-вміст
  (функція (огляд)
    (за-умовою
      ((переклад-допустимий? огляд)
       (переклад-вміст (переклад-перевірка-пропозиція огляд)))
      ((атом? (як-є ())) (як-є ())))))

; Відхилені й неоднозначні переклади є спостереженнями, а не знанням.
(визначити переклад-доказ-вартий?
  (функція (огляд)
    (за-умовою
      ((хибне? (запис-огляду-перекладу-коректний? огляд)) ні)
      ((однакові? (переклад-перевірка-стан огляд) (як-є відхилений)) (атом? (як-є ())))
      ((однакові? (переклад-перевірка-стан огляд) (як-є неоднозначний)) (атом? (як-є ())))
      ((атом? (як-є ())) ні))))

(визначити переклад-доказ-запис
  (функція (огляд)
    (список схема-доказу-перекладу огляд)))

(визначити переклад-доказ-наступний
  (функція (огляд журнал)
    (за-умовою
      ((переклад-доказ-вартий? огляд)
       (сполучити (переклад-доказ-запис огляд) журнал))
      ((атом? (як-є ())) журнал))))

; Огляд перевіряється єдиний раз, після чого те саме значення
; використовується для доказу; без підміни з боку зовнішнього виконавця чи виклику значення.
(визначити переклад-зібрати-огляд-і-доказ
  (функція (огляд журнал)
    (список огляд (переклад-доказ-наступний огляд журнал))))

(визначити переклад-перевірка-з-доказ
  (функція (назва-модуля пропозиція журнал)
    (переклад-зібрати-огляд-і-доказ
      (переклад-перевірка назва-модуля пропозиція)
      журнал)))

; Схеми та журнал уже визначено українськими визначеннями вище.
; Історичні латинські змінні не використовуються чинними споживачами,
; тому повторні присвоєння не створюємо.

; Канонічні функції перекладу дев'ятого й десятого доменів визначено вище виключно
; повними українськими іменами з ратифікованої колонки «укр».
; Повторні визначення з іншими назвами не вводимо: англійський стовпець є лише відображенням.
; таблиці доменів є людською проєкцією, а не другим визначенням.
; Цитовані англомовні поля зовнішнього протоколу залишаються даними.
