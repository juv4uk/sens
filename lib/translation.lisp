; Межа зовнішнього перекладу для Advice Taker.
; Перекладач не є семантичним авторитетом: створює лише скінченні
; дані Lisp за версіонованим протоколом. Lisp перевіряє вміст
; засобами чинних валідаторів знань, виконує перевірку допустимості
; через наявний інтерфейс порад і класифікує висновок.
; Цей файл не змінює журнал знань.
;
; Протокол пропозиції: (translation-1 STATUS KIND SOURCE PAYLOAD).
; Стани: candidate / ambiguous / rejected.
; Види: clause / batch / query.
; Протокол огляду: (translation-review-1 STATUS CODE PROPOSAL DETAIL).
; Стан огляду: accepted / rejected / ambiguous.
; Позначки протоколу залишаються цитованими даними, не функціями.
; Перевірки типу символа оцінюють точне «ні» Д1 через хибне?,
; а не порівнюють результат предиката з порожнім списком даних.

(визначити схема-перекладу (як-є translation-1))
(визначити схема-огляду-перекладу (як-є translation-review-1))
(визначити схема-доказу-перекладу (як-є translation-evidence-1))
(визначити журнал-доказів-перекладу (як-є ()))

; Нативний Core4 SYMBOL? уже розрізняє D8-символ, Text7, число й пару.
; Не реконструюємо символ із динамічного тексту: такий шлях вимагає
; неіснуючого Text7 binding і ламає WRITE/READ межу.
; D1-значення та D3 NIL відхиляються явно до виклику примітива.
(визначити переклад-внутрішній-символ?
  (функція (значення)
    (за-умовою
      ((порожній? значення) ні)
      ; D3 EQ і D9 SYMBOL? тут приймають лише атомний носій.
      ; Структурне значення відхиляється точним D1:ні до SYMBOL?.
      ((хибне? (атом? значення)) ні)
      ((тотожне? значення так) ні)
      ((тотожне? значення (хибне? так)) ні)
      (так (символ? значення)))))

; Рівно п'ять полів за законами D3 CAR/CDR та D4 NULL.
; Відсутність навіть одного поля і зайве шосте поле — D1:NO.
; Не потребує недопущеного D6 LENGTH чи числового літерала.
(визначити переклад-рівно-п'ять-полів?
  (функція (значення)
    (за-умовою
      ((атом? значення) (атом? (як-є (()))))
      ((атом? (решта значення)) (атом? (як-є (()))))
      ((атом? (решта (решта значення))) (атом? (як-є (()))))
      ((атом? (решта (решта (решта значення)))) (атом? (як-є (()))))
      ((атом? (решта (решта (решта (решта значення))))) (атом? (як-є (()))))
      ((атом? (як-є ()))
        (порожній?
          (решта (решта (решта (решта (решта значення))))))))))

(визначити переклад-стан
  (функція (пропозиція) (друге пропозиція)))

(визначити переклад-вид
  (функція (пропозиція) (третє пропозиція)))

(визначити переклад-джерело
  (функція (пропозиція) (четверте пропозиція)))

(визначити переклад-вміст
  (функція (пропозиція) (п'ятий пропозиція)))

(визначити статус-запису-перекладу-коректний?
  (функція (стан)
    (за-умовою
      ((хибне? (переклад-внутрішній-символ? стан)) ні)
      ((однакові? стан (як-є candidate)) (атом? (як-є ())))
      ((однакові? стан (як-є ambiguous)) (атом? (як-є ())))
      ((однакові? стан (як-є rejected)) (атом? (як-є ())))
      ((атом? (як-є ())) ні))))

(визначити вид-кандидата-перекладу-коректний?
  (функція (вид)
    (за-умовою
      ((хибне? (переклад-внутрішній-символ? вид)) ні)
      ((однакові? вид (як-є clause)) (атом? (як-є ())))
      ((однакові? вид (як-є batch)) (атом? (як-є ())))
      ((однакові? вид (як-є query)) (атом? (як-є ())))
      ((атом? (як-є ())) ні))))

; Обгортка перевіряє тільки протокольну форму повідомлення.
; Зміст перевіряють окремо, щоб некоректний кандидат не губився
; під загальною помилкою транспорту.
(визначити структура-обгортки-перекладу-коректна?
  (функція (пропозиція)
    (за-умовою
      ((атом? пропозиція) ні)
      ((хибне? (правильно-структурований-список-знань? пропозиція)) ні)
      ((хибне? (переклад-рівно-п'ять-полів? пропозиція)) ні)
      ((хибне? (переклад-внутрішній-символ? (перше пропозиція))) ні)
      ((однакові? (перше пропозиція) схема-перекладу)
       (за-умовою
         ((хибне? (статус-запису-перекладу-коректний? (переклад-стан пропозиція)))
          ні)
         ((хибне? (вид-кандидата-перекладу-коректний? (переклад-вид пропозиція)))
          ні)
         ; D9 рядок? є прямим D1-свідком типу поля; дані-класифікації
         ; не порівнюємо з доменною тотожністю символу.
         ((рядок? (переклад-джерело пропозиція))
          (атом? (як-є ())))
         ((атом? (як-є ())) ні)))
      ((атом? (як-є ())) ні))))

; Валідатор вмісту має єдиний тип результату: точний D1:1/0.
; D3 NIL є даними списку, а не хибою для D3 COND.
(визначити пакет-кандидатів-перекладу-коректний?
  (функція (вміст)
    (за-умовою
      ((атом? вміст) (атом? (як-є (стан))))
      ((хибне? (правильно-структурований-список-знань? вміст))
       (атом? (як-є (стан))))
      ((атом? (як-є ())) (клаузи-бази-знань-коректні? вміст)))))

(визначити вміст-кандидата-перекладу-коректний?
  (функція (вид вміст)
    (за-умовою
      ((однакові? вид (як-є clause)) (клауза-бази-знань-коректна? вміст))
      ((однакові? вид (як-є batch)) (пакет-кандидатів-перекладу-коректний? вміст))
      ((однакові? вид (як-є query)) (ціль-бази-знань-коректна? вміст))
      ((атом? (як-є ())) (атом? (як-є (стан)))))))

(визначити альтернативні-варіанти-перекладу-коректні?
  (функція (вид альтернативи)
    (за-умовою
      ((атом? альтернативи) ні)
      ((тотожне? (вміст-кандидата-перекладу-коректний? вид (перше альтернативи)) (атом? (як-є ())))
       (за-умовою
         ; D3 NIL — єдиний допустимий кінець списку альтернатив.
         ((порожній? (решта альтернативи)) (атом? (як-є ())))
         ((атом? (решта альтернативи)) ні)
         ((атом? (як-є ())) (альтернативні-варіанти-перекладу-коректні? вид (решта альтернативи)))))
      ((атом? (як-є ())) ні))))

; Неоднозначність потребує щонайменше двох правильних альтернатив.
; Одна альтернатива є кандидатом, а жодна — не неоднозначністю.
(визначити опис-неоднозначності-перекладу-коректний?
  (функція (вид вміст)
    (за-умовою
      ((хибне? (правильно-структурований-список-знань? вміст)) ні)
      ((атом? (решта вміст)) ні)
      ((атом? (як-є ())) (альтернативні-варіанти-перекладу-коректні? вид вміст)))))

(визначити створити-переклад-перевірка
  (функція (стан код пропозиція деталь)
    (список схема-огляду-перекладу стан код пропозиція деталь)))

(визначити переклад-перевірка-стан
  (функція (огляд) (друге огляд)))

(визначити переклад-перевірка-код
  (функція (огляд) (третє огляд)))

(визначити переклад-перевірка-пропозиція
  (функція (огляд) (четверте огляд)))

(визначити переклад-перевірка-деталь
  (функція (огляд) (п'ятий огляд)))

(визначити статус-огляду-кандидата-перекладу-коректний?
  (функція (стан)
    (за-умовою
      ((хибне? (переклад-внутрішній-символ? стан)) ні)
      ((однакові? стан (як-є accepted)) (атом? (як-є ())))
      ((однакові? стан (як-є rejected)) (атом? (як-є ())))
      ((однакові? стан (як-є ambiguous)) (атом? (як-є ())))
      ((атом? (як-є ())) ні))))

(визначити запис-огляду-перекладу-коректний?
  (функція (огляд)
    (за-умовою
      ((атом? огляд) ні)
      ((хибне? (правильно-структурований-список-знань? огляд)) ні)
      ((хибне? (переклад-рівно-п'ять-полів? огляд)) ні)
      ((хибне? (переклад-внутрішній-символ? (перше огляд))) ні)
      ((однакові? (перше огляд) схема-огляду-перекладу)
       (за-умовою
         ((хибне? (статус-огляду-кандидата-перекладу-коректний? (переклад-перевірка-стан огляд)))
          ні)
         ((хибне? (переклад-внутрішній-символ? (переклад-перевірка-код огляд)))
          ні)
         ((атом? (як-є ())) (атом? (як-є ())))))
      ((атом? (як-є ())) ні))))

(визначити рішення-на-основі-огляду-перекладу-й-поради
  (функція (пропозиція рішення)
    (за-умовою
      ((атом? рішення)
       (створити-переклад-перевірка
         (як-є rejected) (як-є malformed-advice-decision) пропозиція рішення))
      ((хибне? (переклад-внутрішній-символ? (перше рішення)))
       (створити-переклад-перевірка
         (як-є rejected) (як-є malformed-advice-decision) пропозиція рішення))
      ((однакові? (перше рішення) (як-є accepted))
       (створити-переклад-перевірка
         (як-є accepted) (як-є knowledge-accepted) пропозиція рішення))
      ((однакові? (перше рішення) (як-є conflict))
       (створити-переклад-перевірка
         (як-є rejected) (як-є knowledge-conflict) пропозиція рішення))
      ((однакові? (перше рішення) (як-є rejected))
       (створити-переклад-перевірка
         (як-є rejected) (як-є knowledge-rejected) пропозиція рішення))
      ((атом? (як-є ()))
       (створити-переклад-перевірка
         (як-є rejected) (як-є malformed-advice-decision) пропозиція рішення)))))

; D10: два викличні рішення поради не випливають з самого запису у таблиці.
; Виводимо їх із виконуваного закону незмінного World: журнал лише читається,
; а огляд перекладу не вносить подію tell і не змінює жодного зв'язування.
; Один і той самий механізм слугує звичайній клаузі й атомарному пакету.
(визначити отримати-рішення-за-порадою
  (функція (назва-модуля клауза)
    (порада-рішення-у-світ
      (створити-світ (як-є ()) (поточний-журнал-знань) (як-є ()))
      назва-модуля клауза)))

(визначити узагальнене-рішення-за-всіма-порадами
  (функція (назва-модуля клаузи)
    (порада-всі-рішення-у-світ
      (створити-світ (як-є ()) (поточний-журнал-знань) (як-є ()))
      назва-модуля клаузи)))

; Обчислення кандидата — іменоване SENS-зв'язування, не виклик
; анонімного значення D5. Вид і вміст читаються по одному разу.
(визначити переклад-оглянути-кандидата-за-видом
  (функція (назва-модуля пропозиція вид вміст)
    (за-умовою
      ((хибне? (вміст-кандидата-перекладу-коректний? вид вміст))
       (створити-переклад-перевірка
         (як-є rejected) (як-є invalid-candidate) пропозиція вміст))
      ((однакові? вид (як-є query))
       (створити-переклад-перевірка
         (як-є accepted) (як-є query) пропозиція вміст))
      ((однакові? вид (як-є clause))
       (рішення-на-основі-огляду-перекладу-й-поради
         пропозиція (отримати-рішення-за-порадою назва-модуля вміст)))
      ((однакові? вид (як-є batch))
       (рішення-на-основі-огляду-перекладу-й-поради
         пропозиція (узагальнене-рішення-за-всіма-порадами назва-модуля вміст)))
      ((атом? (як-є ()))
       (створити-переклад-перевірка
         (як-є rejected) (як-є invalid-kind) пропозиція вид)))))

(визначити отримати-кандидата-на-огляд-перекладу
  (функція (назва-модуля пропозиція)
    (переклад-оглянути-кандидата-за-видом
      назва-модуля пропозиція
      (переклад-вид пропозиція)
      (переклад-вміст пропозиція))))

; Перевірка перекладу не змінює стану знань.
; Навіть прийнятий огляд не записує фактів: потрібен окремий допуск.
(визначити переклад-перевірка
  (функція (назва-модуля пропозиція)
    (за-умовою
      ((хибне? (переклад-внутрішній-символ? назва-модуля))
       (створити-переклад-перевірка
         (як-є rejected) (як-є invalid-module) пропозиція назва-модуля))
      ((хибне? (структура-обгортки-перекладу-коректна? пропозиція))
       (створити-переклад-перевірка
         (як-є rejected) (як-є invalid-translation) пропозиція пропозиція))
      ((однакові? (переклад-стан пропозиція) (як-є candidate))
       (отримати-кандидата-на-огляд-перекладу назва-модуля пропозиція))
      ((однакові? (переклад-стан пропозиція) (як-є ambiguous))
       (за-умовою
         ((опис-неоднозначності-перекладу-коректний?
            (переклад-вид пропозиція) (переклад-вміст пропозиція))
          (створити-переклад-перевірка
            (як-є ambiguous) (як-є translator-ambiguous)
            пропозиція (переклад-вміст пропозиція)))
         ((атом? (як-є ()))
          (створити-переклад-перевірка
            (як-є rejected) (як-є invalid-ambiguity)
            пропозиція (переклад-вміст пропозиція)))))
      ((однакові? (переклад-стан пропозиція) (як-є rejected))
       (за-умовою
         ((переклад-внутрішній-символ? (переклад-вміст пропозиція))
          (створити-переклад-перевірка
            (як-є rejected) (як-є translator-rejected)
            пропозиція (переклад-вміст пропозиція)))
         ((атом? (як-є ()))
          (створити-переклад-перевірка
            (як-є rejected) (як-є invalid-rejection)
            пропозиція (переклад-вміст пропозиція)))))
      ((атом? (як-є ()))
       (створити-переклад-перевірка
         (як-є rejected) (як-є invalid-translation) пропозиція пропозиція)))))

; Лише прийняті кандидати знань відкривають вміст для допуску.
; Запитання не записує нове знання.
; Відхилений або неоднозначний огляд не переходить до функції порад.
; Перевірка вмісту прийнятого огляду не потребує анонімного
; D5 value-call і не відкриває доступ для запитів чи відхилень.
(визначити переклад-допустимість-пропозиції?
  (функція (пропозиція)
    (за-умовою
      ((хибне? (структура-обгортки-перекладу-коректна? пропозиція)) ні)
      ((однакові? (переклад-стан пропозиція) (як-є candidate))
       (за-умовою
         ((однакові? (переклад-вид пропозиція) (як-є clause)) (атом? (як-є ())))
         ((однакові? (переклад-вид пропозиція) (як-є batch)) (атом? (як-є ())))
         ((атом? (як-є ())) ні)))
      ((атом? (як-є ())) ні))))

(визначити переклад-допустимий?
  (функція (огляд)
    (за-умовою
      ((хибне? (запис-огляду-перекладу-коректний? огляд)) ні)
      ((однакові? (переклад-перевірка-стан огляд) (як-є accepted))
       (переклад-допустимість-пропозиції?
         (переклад-перевірка-пропозиція огляд)))
      ((атом? (як-є ())) ні))))

(визначити переклад-допуск-вміст
  (функція (огляд)
    (за-умовою
      ((переклад-допустимий? огляд)
       (переклад-вміст (переклад-перевірка-пропозиція огляд)))
      ((атом? (як-є ())) (як-є ())))))

; Відхилені й неоднозначні переклади є спостереженнями, а не знанням.
(визначити переклад-доказ-вартий?
  (функція (огляд)
    (за-умовою
      ((хибне? (запис-огляду-перекладу-коректний? огляд)) ні)
      ((однакові? (переклад-перевірка-стан огляд) (як-є rejected)) (атом? (як-є ())))
      ((однакові? (переклад-перевірка-стан огляд) (як-є ambiguous)) (атом? (як-є ())))
      ((атом? (як-є ())) ні))))

(визначити переклад-доказ-запис
  (функція (огляд)
    (список схема-доказу-перекладу огляд)))

(визначити переклад-доказ-наступний
  (функція (огляд журнал)
    (за-умовою
      ((переклад-доказ-вартий? огляд)
       (сполучити (переклад-доказ-запис огляд) журнал))
      ((атом? (як-є ())) журнал))))

; Огляд перевіряється єдиний раз, після чого той самий об'єкт
; використовується для доказу; жодної host-підміни чи value-call.
(визначити переклад-зібрати-огляд-і-доказ
  (функція (огляд журнал)
    (список огляд (переклад-доказ-наступний огляд журнал))))

(визначити переклад-перевірка-з-доказ
  (функція (назва-модуля пропозиція журнал)
    (переклад-зібрати-огляд-і-доказ
      (переклад-перевірка назва-модуля пропозиція)
      журнал)))

; Схеми та журнал уже визначено українськими зв'язуваннями вище.
; Історичні латинські змінні не використовуються чинними споживачами,
; тому повторні зв'язування не створюємо.

; Канонічні функції перекладу D9/D10 визначено вище виключно
; повними українськими іменами з ратифікованої колонки «укр».
; Англомовні DEFINE-дублі більше не вводяться: англійська колонка
; таблиці доменів є людською проєкцією, а не другим зв'язуванням.
; Цитовані англомовні поля зовнішнього протоколу залишаються даними.
