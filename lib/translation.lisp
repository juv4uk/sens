; Обгортка перевіряє тільки протокольну форму повідомлення.
; Зміст перевіряють окремо, щоб некоректний кандидат не губився
; під загальною помилкою транспорту.
(визначити структура-обгортки-перекладу-коректна?
  (функція (пропозиція)
    (за-умовою
      ((атом? пропозиція) ні)
      ((хибне? (правильно-структурований-список-знань? пропозиція)) ні)
      ((хибне?
         (за-умовою
           ((атом? (решта (решта (решта (решта пропозиція))))) ні)
           ((атом? (як-є ()))
            (за-умовою
              ((атом? (решта (решта (решта (решта (решта пропозиція))))))
               (тотожне? (решта (решта (решта (решта (решта пропозиція))))) (як-є ())))
              ((атом? (як-є ())) ні)))))
       ні)
      ((внутрішня-рівність-версій (перше пропозиція) схема-перекладу)
       (за-умовою
         ((хибне? (статус-запису-перекладу-коректний? (переклад-стан пропозиція)))
          ні)
         ((хибне? (вид-кандидата-перекладу-коректний? (переклад-вид пропозиція)))
          ні)
          ; Перевірка рядка є прямим свідком типу поля; значення класифікації
         ; не порівнюємо з доменною тотожністю символу.
         ((рядок? (переклад-джерело пропозиція))
          (атом? (як-є ())))
         ((атом? (як-є ())) ні)))
      ((атом? (як-є ())) ні))))

