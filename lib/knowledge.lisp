;; Історичний борг читача #5605; власницька заборона #5789.
;; Українська проєкція булевих значень Д1: «ні» та «так».
;; Не вводити нових текстових носіїв точного доменного коду.
;; Історичний parse() засвідчує походження старої реалізації,
;; але не визначає теперішнього закону мови.
;; Міграція можлива лише через позиційний читач D1, позитивні та
;; негативні свідчення справжнього виконання СЕНС і точний
;; фізичний круговий перехід Zig/T5. Числова підміна заборонена.
;;
;; Мовна система модулів представлення знань.
;; Предикати повертають точні D1-значення; D3 атом? перевіряє
;; форму даних, а не підмінює собою істинність.
;;
;; Журнал фактів із додаванням подій без перезапису історії.
;; Раніше *knowledge-base* зберігав один знімок на модуль:
;; кожен виклик defmodule або tell-knowledge замінював його цілком.
;; За таким знімком не можна встановити послідовність надходження
;; фактів або відкликати попереднє твердження.
;;
;; Натомість журнал-знань є джерелом поточного стану:
;; події (tell назва-модуля клауза) і (retract назва-модуля клауза)
;; додаються на початок списку. Імена подій є значеннями
;; чинного протоколу, тому їх не змінено на українські.
;; Позначок часу немає: порядок подій задає сам список;
;; додавання неіснуючого джерела часу створило б хибну точність.
;; Поточні клаузи модуля обчислюються як проєкція журналу
;; за запитом, а не зберігаються в окремому знімку.
;;
(визначити журнал-знань (як-є ()))

; Повертаємо саме поточний журнал при кожному виклику; жодного кешування
; або другої змінної стану. Протокол подій не змінюється.
(визначити поточний-журнал-знань
  (функція () журнал-знань))

(визначити перетворити-клаузи-на-події-повідомлення
  (функція (назва-модуля клаузи)
    (за-умовою
      ((атом? клаузи) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (список (як-є tell) назва-модуля (перше клаузи))
         (перетворити-клаузи-на-події-повідомлення назва-модуля (решта клаузи)))))))

(визначити визначити-модуль
  (макрос
    (функція (назва правила)
      (список (як-є визначити) (як-є журнал-знань)
      (список (перше (як-є (приєднати)))
      (список (як-є перетворити-клаузи-на-події-повідомлення) назва правила)
      (як-є журнал-знань))))))

; Сполучення задає українська назва «сполучити» у Д3:111.
; Д8:00000100 — окрема адреса Д8; збіг бітів не об'єднує домени.
; AST макросу формуємо ратифікованими українськими викличними іменами.
; «сполучити» належить D3:111; бітовий літерал у коді не потрібний.
(визначити відкликати-знання
  (макрос
    (функція (назва-модуля клауза)
      (список (як-є визначити) (як-є журнал-знань)
      (список (як-є сполучити)
      (список (як-є список) (список (як-є як-є) (як-є retract)) (список (як-є як-є) назва-модуля) клауза)
      (як-є журнал-знань))))))

; Обернення журналу — виконуваний закон над D3 CAR/CDR/CONS.
; Таблична наявність D5 REVERSE не означає наявності його механізму.
; Атомарний хвіст не додає вигаданих подій; лише правильні пари обходимо.
(визначити внутрішній-зворот-журналу-знань
  (функція (елементи накопичувач)
    (за-умовою
      ((порожній? елементи) накопичувач)
      ((атом? елементи) накопичувач)
      ((хибне? (атом? елементи))
       (внутрішній-зворот-журналу-знань
         (решта елементи)
         (сполучити (перше елементи) накопичувач))))))

; Подія журналу має лише дві канонічні дії. Їхні D7-подання
; перевіряємо структурно; атомність D3 не є умовою для Text7-імені.
(визначити подія-журналу-дія-коректна?
  (функція (дія)
    (за-умовою
      ((однакові? дія (як-є tell)) так)
      ((однакові? дія (як-є retract)) так)
      (так ні))))

(визначити додати-події-журналу-модуля
  (функція (назва-модуля журнал накопичувач)
    (за-умовою
      ((порожній? журнал) (внутрішній-зворот-журналу-знань накопичувач (як-є ())))
      ((атом? журнал)  (внутрішній-зворот-журналу-знань накопичувач (як-є ())))
      ; Неправильний запис не має другого поля Д4: його не можна читати.
      ; Пропускаємо лише цей запис, зберігаючи порядок правильних подій.
      ((атом? (перше журнал))
       (додати-події-журналу-модуля назва-модуля (решта журнал) накопичувач))
      ((атом? (решта (перше журнал)))
       (додати-події-журналу-модуля назва-модуля (решта журнал) накопичувач))
      ; Протокол журналу має РІВНО три поля, не короткий
      ; запис, не зайві дані й не крапковий хвіст.
      ((атом? (решта (решта (перше журнал))))
       (додати-події-журналу-модуля назва-модуля (решта журнал) накопичувач))
      ((хибне? (порожній? (решта (решта (решта (перше журнал))))))
       (додати-події-журналу-модуля назва-модуля (решта журнал) накопичувач))
      ; D7-мітка дії перевіряється за закритим протоколом, не через ATOM.
      ((хибне? (подія-журналу-дія-коректна? (перше (перше журнал))))
       (додати-події-журналу-модуля назва-модуля (решта журнал) накопичувач))
      ; Ім'я модуля може бути D8-атомом або канонічним D7-ланцюгом.
      ((хибне? (знання-символ? (друге (перше журнал))))
       (додати-події-журналу-модуля назва-модуля (решта журнал) накопичувач))
      ((уніфікація-рівні? (друге (перше журнал)) назва-модуля)
       (додати-події-журналу-модуля
         назва-модуля
         (решта журнал)
         (сполучити (перше журнал) накопичувач)))
      ((атом? (як-є ()))
       (додати-події-журналу-модуля
         назва-модуля
         (решта журнал)
         накопичувач)))))

(визначити отримати-події-журналу-окремого-модуля
  (функція (назва-модуля журнал)
    (додати-події-журналу-модуля назва-модуля журнал (як-є ()))))

; Лише правильна подія з другим полем може довести існування
; модуля. На атомі, одноелементній формі чи крапковому хвості
; D4 «друге» не викликаємо — невідоме не стає доказом.
(визначити журнал-містить-записи-модуля?
  (функція (назва-модуля журнал)
    (за-умовою
      ((атом? журнал) (атом? (як-є (стан))))
      ; Неправильний запис не приховує правильні події пізніше у журналі.
      ((атом? (перше журнал))
       (журнал-містить-записи-модуля? назва-модуля (решта журнал)))
      ((атом? (решта (перше журнал)))
       (журнал-містить-записи-модуля? назва-модуля (решта журнал)))
      ; Протокол журналу має РІВНО три поля, не короткий
      ; запис, не зайві дані й не крапковий хвіст.
      ((атом? (решта (решта (перше журнал))))
       (журнал-містить-записи-модуля? назва-модуля (решта журнал)))
      ((хибне? (порожній? (решта (решта (решта (перше журнал))))))
       (журнал-містить-записи-модуля? назва-модуля (решта журнал)))
      ; Перевіряємо дію та D7-ім'я тією самою мовною межею.
      ((хибне? (подія-журналу-дія-коректна? (перше (перше журнал))))
       (журнал-містить-записи-модуля? назва-модуля (решта журнал)))
      ((хибне? (знання-символ? (друге (перше журнал))))
       (журнал-містить-записи-модуля? назва-модуля (решта журнал)))
      ((уніфікація-рівні? (друге (перше журнал)) назва-модуля) (атом? (як-є ())))
      ((атом? (як-є ())) (журнал-містить-записи-модуля? назва-модуля (решта журнал))))))

; Порожні історичні координати не стають новими функціями чи визначеннями.
; Ім'я знань може бути атомним D8-символом або канонічною
; непорожньою D7-послідовністю гліфів. SYMBOL? не приймає структуру:
; спільний SENS-розпізнавач перевіряє атомність першого гліфа і D3-хребет,
; не викликаючи D3 EQ на складеному значенні.
(визначити знання-символ?
  (функція (значення)
    (результат-внутрішній-символ? значення)))

(визначити модуль-відомий?
  (функція (назва-модуля)
    (журнал-містить-записи-модуля? назва-модуля журнал-знань)))

(визначити застосувати-одну-подію-журналу
  (функція (клаузи подія)
    (за-умовою
      ; Подія має рівно три поля: дія, модуль, клауза.
      ; До D5 «третє» перевіряємо наявність усіх пар D3,
      ; а потім D4 «порожній?» підтверджує точний кінець списку.
      ; Надлишковий елемент та крапковий хвіст — не виконувана подія.
      ((атом? подія) клаузи)
      ((атом? (решта подія)) клаузи)
      ((атом? (решта (решта подія))) клаузи)
      ((хибне? (порожній? (решта (решта (решта подія))))) клаузи)
      ; D3 EQ не порівнює складені імена дій: відхиляємо їх до EQ.
      ((хибне? (атом? (перше подія))) клаузи)
      ((однакові? (перше подія) (як-є tell)) (сполучити (третє подія) клаузи))
      ((однакові? (перше подія) (як-є retract)) (відкликати-факт (третє подія) клаузи))
      ((атом? (як-є ())) клаузи))))

(визначити модуль-клаузи-зараз
  (функція (назва-модуля)
    (згорнути застосувати-одну-подію-журналу (як-є ())
            (внутрішній-зворот-журналу-знань
              (отримати-події-журналу-окремого-модуля назва-модуля журнал-знань)
              (як-є ())))))

(визначити завантажити-знання
  (макрос
    (функція (назва-модуля)
      (список (як-є load) назва-модуля))))

(визначити міркувати-у
  (функція (назва-модуля ціль)
    (за-умовою
      ((модуль-відомий? назва-модуля) (міркувати ціль (модуль-клаузи-зараз назва-модуля)))
      ((атом? (як-є ())) (як-є Module-not-found)))))

(визначити вперед-у
  (функція (назва-модуля)
    (за-умовою
      ((модуль-відомий? назва-модуля) (виконати-багатоваріантне-виведення (модуль-клаузи-зараз назва-модуля) (як-є ())))
      ((атом? (як-є ())) (як-є Module-not-found)))))

(визначити перевірити-конфлікт?
  (функція (назва-модуля правила)
    (за-умовою
      ((модуль-відомий? назва-модуля)
       ; Значення голови й доказів зв'язує чинний D6 LET.
       ; Вкладений анонімний виклик помилково входив у D5:00001 FUNCTION,
       ; де немає допущеного механізму value-call.
       (нехай ((голова (перше-першого правила)))
         (нехай ((докази
                   (міркувати-у назва-модуля
                     (отримати-протилежну-голову-твердження-знання голова))))
           (за-умовою
             ((атом? докази) (атом? (як-є (стан))))
             ((атом? (як-є ())) (атом? (як-є ())))))))
      ((атом? (як-є ())) (атом? (як-є (стан)))))))

; Розгортання макроса COND безпосередньо містить однобітну умову W1 без підміни через ATOM.
(визначити повідомити-знання
  (макрос
    (функція (назва-модуля правила)
      (список (як-є за-умовою)
      (список (список (як-є перевірити-конфлікт?) назва-модуля правила)
      (список (як-є як-є) (як-є Conflict-detected)))
      (список (список (як-є атом?) (список (як-є як-є) (як-є ())))
      (список (як-є визначити) (як-є журнал-знань)
      (список (перше (як-є (приєднати)))
      (список (як-є перетворити-клаузи-на-події-повідомлення) назва-модуля правила)
      (як-є журнал-знань))))))))

; Валідатори термів і цілей відновлено окремим доказовим зрізом.
; Інші заархівовані API не вмикаються цим патчем: кожен потребує власного
; закону СЕНС і залишається закритим для виконання до появи такого доказу.

(визначити правильно-структурований-список-знань?
  (функція (значення)
    (за-умовою
      ((порожній? значення) (атом? (як-є ())))
      ((атом? значення) (атом? (як-є (стан))))
      ((атом? (як-є ())) (правильно-структурований-список-знань? (решта значення))))))

; Розпізнаємо заперечення лише як правильну двопольову форму.
; Атом, (not), (not . x), (not x y) не дозволяють викликати D3 CAR/D4 CADR
; так, ніби перед нами доведена пара (not ціль).
(визначити отримати-протилежну-голову-твердження-знання
  (функція (голова)
    (за-умовою
      ((атом? голова) (список (як-є хибне?) голова))
      ((атом? (решта голова)) (список (як-є хибне?) голова))
      ((хибне? (порожній? (решта (решта голова))))
       (список (як-є хибне?) голова))
      ; Голова-предикат може бути канонічною D7-послідовністю гліфів.
      ; D7-ланцюг не є D3-атомом: його перевіряє чинний структурний закон.
      ; Відхиляємо вкладений список, але не відкидаємо правильне D7-ім'я.
      ((хибне? (знання-символ? (перше голова))) (список (як-є хибне?) голова))
      ((внутрішня-рівність-версій (перше голова) (як-є хибне?)) (друге голова))
      ((атом? (як-є ())) (список (як-є хибне?) голова)))))

(визначити клауза-бази-знань-коректна?
  (функція (клауза)
    (за-умовою
      ((атом? клауза) (атом? (як-є (стан))))
      ((хибне? (правильно-структурований-список-знань? клауза)) (атом? (як-є (стан))))
      ((хибне? (ціль-бази-знань-коректна? (перше клауза))) (атом? (як-є (стан))))
      ((атом? (як-є ())) (цілі-бази-знань-коректні? (решта клауза))))))

;; Точна арність змінної (var ім'я) та заперечення (хибне?/not goal):
;; D3 ATOM/CDR + D4 CADR/NOT, без D6 LENGTH і некваліфікованого числа 2.
;; Очікування семантики лежать у tests/semantic/knowledge-exact-arity-structure.bits.

(визначити голова-твердження-знань-заперечена?
  (функція (голова)
    (за-умовою
      ; Голова правила має форму (хибне? ціль), а не є самою міткою.
      ((атом? голова) (атом? (як-є (стан))))
      ((хибне? (внутрішня-рівність-версій
                 (перше голова) (як-є хибне?)))
       (атом? (як-є (стан))))
      ; Заперечення має рівно один аргумент: обриваємо нульову та
      ; надлишкову арність до звернення до самої цілі.
      ((порожній? (решта голова)) (атом? (як-є (стан))))
      ((хибне? (порожній? (решта (решта голова))))
       (атом? (як-є (стан))))
      ((атом? (як-є ())) (атом? (як-є ()))))))

(визначити терми-бази-знань-коректні?
  (функція (терми)
    (за-умовою
      ((порожній? терми) (атом? (як-є ())))
      ((атом? терми) (атом? (як-є (стан))))
      ((терм-бази-знань-коректний? (перше терми))
       (терми-бази-знань-коректні? (решта терми)))
      ((атом? (як-є ())) (атом? (як-є (стан)))))))

(визначити терм-бази-знань-коректний?
  (функція (терм)
    (за-умовою
      ((атом? терм) (атом? (як-є ())))
      ((атом? (перше терм))
       (за-умовою
         ((однакові? (перше терм) (як-є var))
          (за-умовою
