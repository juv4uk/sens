;; Історичний борг читача #5605; власницька заборона #5789.
;; Старі #d1:0/#d1:1 не є чинними літералами СЕНС.
;; Не вводити нових текстових носіїв точного доменного коду.
;; Історичний parse() засвідчує походження старої реалізації,
;; але не визначає теперішнього закону мови.
;; Міграція можлива лише через позиційний читач D1, позитивні та
;; негативні свідчення справжнього виконання СЕНС і точний
;; фізичний круговий перехід Zig/T5. Числова підміна заборонена.
;;
;; Мовна система модулів представлення знань.
;; Предикати повертають точні D1-значення; D3 атом? перевіряє
;; форму даних, а не підмінює собою істинність.
;;
;; Журнал фактів із додаванням подій без перезапису історії.
;; Раніше *knowledge-base* зберігав один знімок на модуль:
;; кожен виклик defmodule або tell-knowledge замінював його цілком.
;; За таким знімком не можна встановити послідовність надходження
;; фактів або відкликати попереднє твердження.
;;
;; Натомість *knowledge-journal* є джерелом поточного стану:
;; події (tell назва-модуля клауза) і (retract назва-модуля клауза)
;; додаються на початок списку. Імена подій є значеннями
;; чинного протоколу, тому їх не змінено на українські.
;; Позначок часу немає: порядок подій задає сам список;
;; додавання неіснуючого джерела часу створило б хибну точність.
;; Поточні клаузи модуля обчислюються як проєкція журналу
;; за запитом, а не зберігаються в окремому знімку.
;;
(визначити *knowledge-journal* (як-є ()))

(визначити перетворити-клаузи-на-події-повідомлення
  (функція (назва-модуля клаузи)
    (за-умовою
      ((атом? клаузи) (як-є ()))
      (так
       (сполучити
         (список (як-є tell) назва-модуля (перше клаузи))
         (перетворити-клаузи-на-події-повідомлення назва-модуля (решта клаузи)))))))

(визначити визначити-модуль
  (макрос
    (функція (назва правила)
      (список (як-є визначити) (як-є *knowledge-journal*)
      (список (як-є приєднати)
      (список (як-є перетворити-клаузи-на-події-повідомлення) (список (як-є як-є) назва) правила)
      (як-є *knowledge-journal*))))))

; Вилучено спадкову сід8-ідентичність 00000100: це НЕ D3 CONS.
; За ратифікованою таблицею D8:00000100 = PROG1, D3:111 = CONS.
; AST макросу формуємо ратифікованими українськими викличними іменами.
; «сполучити» належить D3:111; бітовий літерал у коді не потрібний.
(визначити відкликати-знання
  (макрос
    (функція (назва-модуля клауза)
      (список (як-є визначити) (як-є *knowledge-journal*)
      (список (як-є сполучити)
      (список (як-є список) (список (як-є як-є) (як-є retract)) (список (як-є як-є) назва-модуля) клауза)
      (як-є *knowledge-journal*))))))

(визначити додати-події-журналу-модуля
  (функція (назва-модуля журнал накопичувач)
    (за-умовою
      ((порожній? журнал) (зворот накопичувач))
      ((атом? журнал)  (зворот накопичувач))
      ((тотожне? (друге (перше журнал)) назва-модуля)
       (додати-події-журналу-модуля
         назва-модуля
         (решта журнал)
         (сполучити (перше журнал) накопичувач)))
      (так
       (додати-події-журналу-модуля
         назва-модуля
         (решта журнал)
         накопичувач)))))

(визначити отримати-події-журналу-окремого-модуля
  (функція (назва-модуля журнал)
    (додати-події-журналу-модуля назва-модуля журнал (як-є ()))))

(визначити журнал-містить-записи-модуля?
  (функція (назва-модуля журнал)
    (за-умовою
      ((атом? журнал) ні)
      ((тотожне? (друге (перше журнал)) назва-модуля) так)
      (так (журнал-містить-записи-модуля? назва-модуля (решта журнал))))))

; Закон символу визначає ядро: не дублюємо історичні порожні комірки W8.
(визначити знання-символ?
  (функція (значення)
    (символ? значення)))

(визначити модуль-відомий?
  (функція (назва-модуля)
    (журнал-містить-записи-модуля? назва-модуля *knowledge-journal*)))

(визначити застосувати-одну-подію-журналу
  (функція (клаузи подія)
    (за-умовою
      ((тотожне? (перше подія) (як-є tell)) (сполучити (третє подія) клаузи))
      ((тотожне? (перше подія) (як-є retract)) (відкликати-факт (третє подія) клаузи))
      (так клаузи))))

(визначити модуль-клаузи-зараз
  (функція (назва-модуля)
    (згорнути застосувати-одну-подію-журналу (як-є ())
            (зворот (отримати-події-журналу-окремого-модуля назва-модуля *knowledge-journal*)))))

(визначити завантажити-знання
  (макрос
    (функція (назва-модуля)
      (список (як-є load) назва-модуля))))

(визначити міркувати-у
  (функція (назва-модуля ціль)
    (за-умовою
      ((модуль-відомий? назва-модуля) (міркувати ціль (модуль-клаузи-зараз назва-модуля)))
      (так (як-є Module-not-found)))))

(визначити вперед-у
  (функція (назва-модуля)
    (за-умовою
      ((модуль-відомий? назва-модуля) (виконати-багатоваріантне-виведення (модуль-клаузи-зараз назва-модуля) (як-є ())))
      (так (як-є Module-not-found)))))

(визначити перевірити-конфлікт?
  (функція (назва-модуля правила)
    (за-умовою
      ((модуль-відомий? назва-модуля)
       ((функція (голова)
          ((функція (докази)
             (за-умовою
               ((атом? докази) ні)
               (так так)))
           (міркувати-у назва-модуля (отримати-протилежну-голову-твердження-знання голова))))
        (перше-першого правила)))
      (так ні))))

; Розгортання макроса COND безпосередньо містить однобітну умову W1 без підміни через ATOM.
(визначити повідомити-знання
  (макрос
    (функція (назва-модуля правила)
      (список (як-є за-умовою)
      (список (список (як-є перевірити-конфлікт?) (список (як-є як-є) назва-модуля) правила)
      (список (як-є як-є) (як-є Conflict-detected)))
      (список так
      (список (як-є визначити) (як-є *knowledge-journal*)
      (список (як-є приєднати)
      (список (як-є перетворити-клаузи-на-події-повідомлення) (список (як-є як-є) назва-модуля) правила)
      (як-є *knowledge-journal*))))))))

; Валідатори термів і цілей відновлено окремим доказовим зрізом.
; Інші заархівовані API не вмикаються цим патчем: кожен потребує власного
; закону СЕНС і залишається закритим для виконання до появи такого доказу.

(визначити правильно-структурований-список-знань?
  (функція (значення)
    (за-умовою
      ((порожній? значення) так)
      ((атом? значення) ні)
      (так (правильно-структурований-список-знань? (решта значення))))))

(визначити отримати-протилежну-голову-твердження-знання
  (функція (голова)
    (за-умовою
      ((тотожне? (перше голова) (як-є not)) (друге голова))
      ((тотожне? (перше голова) (як-є not?)) (друге голова))
      (так (список (як-є not?) голова)))))

(визначити клауза-бази-знань-коректна?
  (функція (клауза)
    (за-умовою
      ((атом? клауза) ні)
      ((хибне? (правильно-структурований-список-знань? клауза)) ні)
      ((хибне? (ціль-бази-знань-коректна? (перше клауза))) ні)
      (так (цілі-бази-знань-коректні? (решта клауза))))))

;; Точна арність змінної (var ім'я) та заперечення (not?/not goal):
;; D3 ATOM/CDR + D4 CADR/NOT, без D6 LENGTH і некваліфікованого числа 2.
;; Очікування семантики лежать у tests/semantic/knowledge-exact-arity-structure.bits.

(визначити голова-твердження-знань-заперечена?
  (функція (голова)
    (за-умовою
      ((тотожне? голова (як-є not?)) так)
      ((тотожне? голова (як-є not)) так)
      (так ні))))

(визначити терми-бази-знань-коректні?
  (функція (терми)
    (за-умовою
      ((порожній? терми) так)
      ((атом? терми) ні)
      ((терм-бази-знань-коректний? (перше терми))
       (терми-бази-знань-коректні? (решта терми)))
      (так ні))))

(визначити терм-бази-знань-коректний?
  (функція (терм)
    (за-умовою
      ((атом? терм) так)
      ((атом? (перше терм))
       (за-умовою
         ((тотожне? (перше терм) (як-є var))
          (за-умовою
            ; (var ім'я): нуль аргументів відхиляємо; один перевіряємо,
            ; пару після CDDR відхиляємо. Жодного числового LENGTH.
            ((атом? (решта терм)) ні)
            ((атом? (решта (решта терм))) (знання-символ? (друге терм)))
            (так ні)))
         (так (терми-бази-знань-коректні? терм))))
      (так (терми-бази-знань-коректні? терм)))))

(визначити ціль-бази-знань-коректна?
  (функція (ціль)
    (за-умовою
      ((атом? ціль) ні)
      ((хибне? (правильно-структурований-список-знань? ціль)) ні)
      ((хибне? (знання-символ? (перше ціль))) ні)
      ((голова-твердження-знань-заперечена? (перше ціль))
       (за-умовою
         ; (not? goal) та (not goal) мають мати рівно один аргумент.
         ((атом? (решта ціль)) ні)
         ((атом? (решта (решта ціль))) (ціль-бази-знань-коректна? (друге ціль)))
         (так ні)))
      (так (терми-бази-знань-коректні? (решта ціль))))))

(визначити цілі-бази-знань-коректні?
  (функція (цілі)
    (за-умовою
      ((порожній? цілі) так)
      ((атом? цілі) ні)
      ((ціль-бази-знань-коректна? (перше цілі))
       (цілі-бази-знань-коректні? (решта цілі)))
      (так ні))))

(визначити клаузи-бази-знань-коректні?
  (функція (клаузи)
    (за-умовою
      ((порожній? клаузи) так)
      ((атом? клаузи) ні)
      ((клауза-бази-знань-коректна? (перше клаузи))
       (клаузи-бази-знань-коректні? (решта клаузи)))
      (так ні))))

; Повернено історичний пакетний закон із lib/knowledge.lisp @ 327b51ca,
; а не нова зовнішня підміна. Первинна міграція D4 DEFINE/LAMBDA, D3 COND/CAR/CDR,
; D4 NULL, D9:101001110 REASON; рішення про наявність доказу — D1.
; Десятибітні координати цих похідних функцій не оголошуються викличними:
; лише визначення самої СЕНС встановлює їхні локальні зв'язування Ліспу.
; Нуль доказів = D4 NULL(()) -> продовжити; наявний доказ -> конфлікт.
(визначити суперечність-запереченій-голові-правила
  (функція (правила усі-правила)
    (за-умовою
      ((порожній? правила) (як-є ()))
      ((атом? правила) (як-є ()))
      (так
       ((функція (голова)
          (за-умовою
            ((голова-твердження-знань-заперечена? (перше голова))
             ((функція (позитивна-голова)
                ((функція (докази)
                   (за-умовою
                     ((порожній? докази)
                      (суперечність-запереченій-голові-правила (решта правила) усі-правила))
                     (так (список голова позитивна-голова (перше докази)))))
                 (міркувати позитивна-голова усі-правила)))
              (друге голова)))
            (так
             (суперечність-запереченій-голові-правила (решта правила) усі-правила))))
        (перше (перше правила)))))))

; Фіксуємо один з трьох доказів конфлікту: нова клауза, протилежна
; голова, перший доказ. Спочатку весь пакет, тоді чинні світові правила.
; Якщо жодна пара не суперечить — точний порожній список, без зовнішньої істинності.
(визначити виявити-суперечність-у-групі-порад
  (функція (клаузи залишок усі-правила)
    (за-умовою
      ((порожній? залишок)
       ((функція (глобальний-доказ)
          (за-умовою
            ((порожній? глобальний-доказ) (як-є ()))
            (так
             (список (перше клаузи) (перше глобальний-доказ) (третє глобальний-доказ)))))
        (суперечність-запереченій-голові-правила усі-правила усі-правила)))
      ((атом? залишок) (як-є ()))
      (так
       ((функція (протилежна-голова)
          ((функція (докази)
             (за-умовою
               ((порожній? докази)
                (виявити-суперечність-у-групі-порад клаузи (решта залишок) усі-правила))
               (так
                (список (перше залишок) протилежна-голова (перше докази)))))
           (міркувати протилежна-голова усі-правила)))
        (отримати-протилежну-голову-твердження-знання (перше (перше залишок))))))))

; Ратифікований D4:1000 = CAR(CAR), D4:0110 = CDR(CAR).
; Точна бітність та однобітний негатив: tests/semantic/knowledge-d4-selectors-*.bits.
(визначити отримати-поле-пакета-знань
  (функція (назва пакет)
    (за-умовою
      ((атом? пакет) (як-є ()))
      ((тотожне? назва (перше-першого пакет)) (решта-першого пакет))
      (так (отримати-поле-пакета-знань назва (решта пакет))))))

; Історичний пакет знань 0.1 відновлений з lib/knowledge.lisp @ 327b51ca1f.
; Дані пакета не обчислюються. Назви полів — цитовані дані, а не функції D7.
; Умови: пряма D1-бітність; D4:1000 CAAR; D3:111 CONS; D4:1110 LIST.
; Ні сід8-псевдонімів, ні D10-ратифікації чи нових примітивів.
; Версія пакета знань визначається тільки українською назвою.
; Історичне латинське зв'язування більше не дублює значення.
(визначити *версія-пакета-знань* (як-є (ні 1)))

(визначити записи-пакета-знань-коректні?
  (функція (записи)
    (за-умовою
      ((порожній? записи) так)
      ((атом? записи) ні)
      ((атом? (перше записи)) ні)
      ((знання-символ? (перше-першого записи))
       (записи-пакета-знань-коректні? (решта записи)))
      (так ні))))

(визначити створити-пакет-структурованих-знань
  (функція (назва-модуля клаузи)
    (список (сполучити (як-є format) (як-є my-lisp-knowledge))
          (сполучити (як-є version) *версія-пакета-знань*)
          (сполучити (як-є module) назва-модуля)
          (сполучити (як-є clauses) клаузи))))

; Українська проєкція: точна тотожність із lib/domains/d*.lisp; сумісне зв'язування без нової диспетчеризації.
(визначити advice-negative-head-conflict суперечність-запереченій-голові-правила)
(визначити clauses->tell-events перетворити-клаузи-на-події-повідомлення)
(визначити knowledge-clause-valid? клауза-бази-знань-коректна?)
(визначити knowledge-clauses-valid? клаузи-бази-знань-коректні?)
(визначити knowledge-goal-valid? ціль-бази-знань-коректна?)
(визначити knowledge-goals-valid? цілі-бази-знань-коректні?)
(визначити knowledge-not-head? голова-твердження-знань-заперечена?)
(визначити knowledge-package-entries-valid? записи-пакета-знань-коректні?)
(визначити knowledge-package-field отримати-поле-пакета-знань)
(визначити knowledge-proper-list? правильно-структурований-список-знань?)
(визначити knowledge-term-valid? терм-бази-знань-коректний?)
(визначити knowledge-terms-valid? терми-бази-знань-коректні?)
