; СЕНС: наявний суфікс після третього атомного елемента списку.
; Д3-Д5, один прохід, нуль нових пар у самому алгоритмі.
; АТОМ? захищає РЕШТА і ПЕРШЕ також від атомарного неповного хвоста.
; Порожній елемент () є атомом, непорожній вкладений список не рахуємо.
(визначити хвіст-після-одного-для-третього
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи)) (решта елементи))
   (так (хвіст-після-одного-для-третього (решта елементи))))))

(визначити хвіст-після-двох-для-третього
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-одного-для-третього (решта елементи)))
   (так (хвіст-після-двох-для-третього (решта елементи))))))

(визначити хвіст-після-третього-атома
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-двох-для-третього (решта елементи)))
   (так (хвіст-після-третього-атома (решта елементи))))))

; Додаткові живі крайові перевірки: сам атом та відкрита пара.
(за-умовою
 ((порожній? (хвіст-після-третього-атома (як-є атом?))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-третього-атома
   (сполучити (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))

; Вісім незалежних мовних свідків, без стороннього обчислювача.
; Порушення переходить до справжнього ПЕРШЕ порожнього списку.
(за-умовою
 ((порожній? (хвіст-після-третього-атома (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-третього-атома
    (список (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-третього-атома
    (список (список (як-є атом?))
            (список (як-є решта))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-третього-атома
    (список (як-є атом?) (як-є решта) (як-є сполучити)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
    (перше (хвіст-після-третього-атома
      (список (як-є атом?) (як-є решта) (як-є сполучити)
              (як-є визначити))))
    (як-є визначити)) так)
 (так (перше (як-є ()))))
; Складені елементи не змінюють лічильник.
(за-умовою
 ((тотожне?
    (перше (хвіст-після-третього-атома
      (список (список (як-є атом?)) (як-є атом?)
              (список (як-є решта)) (як-є ())
              (як-є сполучити) (як-є функція))))
    (як-є функція)) так)
 (так (перше (як-є ()))))
; Четвертий атом після трьох має лишитися, а не зникнути.
(за-умовою
 ((тотожне?
    (друге (хвіст-після-третього-атома
      (список (як-є атом?) (як-є решта) (як-є сполучити)
              (як-є визначити) (як-є функція))))
    (як-є функція)) так)
 (так (перше (як-є ()))))
; Негатив: початковий атом не має потрапити у вихідний суфікс.
(за-умовою
 ((хибне?
    (тотожне?
      (перше (хвіст-після-третього-атома
        (список (як-є атом?) (як-є решта)
                (як-є сполучити) (як-є визначити))))
      (як-є атом?))) так)
 (так (перше (як-є ()))))
(атом? (як-є ()))
