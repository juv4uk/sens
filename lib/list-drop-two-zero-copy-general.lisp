; СЕНС: відкинути перші два елементи правильного списку.
; Д3: два РЕШТА, нуль нових пар, сталий час і стала додаткова пам'ять.
; Порожній, одноелементний та атомарний вхід дає структурне ().
; Жодного сід8 і сенс8, кодових літералів, пітон чи джейсон.
(визначити хвіст-після-двох
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (решта елементи)) (як-є ()))
   (так (решта (решта елементи))))))

; Справжній СЕНС сам перевіряє позитивні та негативні приклади.
; Неправильний результат спричиняє помилку ПЕРШЕ на ().
(за-умовою
 ((порожній? (хвіст-після-двох (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-двох (список (як-є атом?)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-двох
               (список (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (перше (хвіст-після-двох
            (список (як-є атом?) (як-є решта)
                    (як-є сполучити))))
   (як-є сполучити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (друге (хвіст-після-двох
            (список (як-є атом?) (як-є решта)
                    (як-є сполучити) (як-є визначити))))
   (як-є визначити)) так)
 (так (перше (як-є ()))))
; Негатив: недопустимо повернути хвіст після лише одного елемента.
(за-умовою
 ((хибне?
   (тотожне?
    (перше (хвіст-після-двох
             (список (як-є атом?) (як-є решта) (як-є сполучити))))
    (як-є решта))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
