(визначити однакові-унарні-відліки?
 (функція (лівий правий)
  (за-умовою
   ((порожній? лівий) (порожній? правий))
   ((порожній? правий) ні)
   ((тотожне? (перше лівий) (перше правий))
    (однакові-унарні-відліки? (решта лівий) (решта правий)))
   (так ні))))

