; СЕНС: повернути незмінений хвіст після першої сусідньої пари
; зі складеного елемента та наступного атома. Один прохід, без сполучити
; в самому алгоритмі: збережено точну тотожність наявного хвоста.
; Порожнє () всередині списку є атомом, а (()) - складеним елементом.
; Людські виклики - повна українська проєкція Д1, Д3, Д4; текст - Д7.

(визначити суфікс-після-пари-та-атома
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (решта елементи)) (як-є ()))
   ((атом? (перше елементи))
    (суфікс-після-пари-та-атома (решта елементи)))
   ((атом? (перше (решта елементи)))
    (решта (решта елементи)))
   ((атом? (як-є ())) (суфікс-після-пари-та-атома (решта елементи))))))

; Тотожність Д3 ніколи не отримує пару; структури звіряються рекурсивно.
(визначити дерева-суфікса-однакові?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     ((атом? (як-є ())) ні)))
   ((атом? праве) ні)
   ((дерева-суфікса-однакові? (перше ліве) (перше праве))
    (дерева-суфікса-однакові? (решта ліве) (решта праве)))
   ((атом? (як-є ())) ні))))

; У разі хибного результату виконується реальна помилка СЕНС,
; а не створюється пасивний список умовних успіхів і відмов.
(визначити довести-суфікс-пари-та-атома
 (функція (вхід очікуваний)
  (за-умовою
   ((дерева-суфікса-однакові?
     (суфікс-після-пари-та-атома вхід) очікуваний) так)
   ((атом? (як-є ())) (перше (як-є ()))))))

; Відсутність збігу: порожній, одиночний, атомарний, складений.
(довести-суфікс-пари-та-атома (як-є ()) (як-є ()))
(довести-суфікс-пари-та-атома
 (список (як-є атом?)) (як-є ()))
(довести-суфікс-пари-та-атома
 (список (список (як-є атом?))) (як-є ()))
(довести-суфікс-пари-та-атома
 (список (список (як-є атом?)) (як-є решта)) (як-є ()))
(довести-суфікс-пари-та-атома
 (список (як-є атом?) (як-є решта) (як-є сполучити)) (як-є ()))
(довести-суфікс-пари-та-атома
 (список (список (як-є атом?)) (список (як-є решта))
         (список (як-є сполучити))) (як-є ()))

; Перша знайдена пара визначає хвіст, а не остання.
(довести-суфікс-пари-та-атома
 (список (список (як-є атом?)) (як-є решта) (як-є сполучити))
 (список (як-є сполучити)))
(довести-суфікс-пари-та-атома
 (список (як-є атом?) (список (як-є решта)) (як-є сполучити) (як-є тотожне?))
 (список (як-є тотожне?)))
(довести-суфікс-пари-та-атома
 (список (список (як-є атом?)) (список (як-є решта))
         (як-є сполучити) (як-є тотожне?))
 (список (як-є тотожне?)))
(довести-суфікс-пари-та-атома
 (список (як-є атом?) (список (як-є решта)) (як-є сполучити)
         (список (як-є тотожне?)))
 (список (список (як-є тотожне?))))

; Порожній атом () відрізняється від складеного (()).
(довести-суфікс-пари-та-атома
 (список (список (як-є ())) (як-є ()) (як-є атом?))
 (список (як-є атом?)))
(довести-суфікс-пари-та-атома
 (список (список (як-є ())) (як-є ())) (як-є ()))
(довести-суфікс-пари-та-атома
 (список (як-є атом?) (список (як-є ())) (як-є ()))
 (як-є ()))

; Негативний свідок: неправильний очікуваний хвіст має дати Д1 ні.
(за-умовою
 ((дерева-суфікса-однакові?
   (суфікс-після-пари-та-атома
    (список (список (як-є атом?)) (як-є решта) (як-є сполучити)))
   (список (як-є решта)))
  (перше (як-є ())))
 ((атом? (як-є ())) так))
