; Непарний останній елемент лишається останнім, порядок пар зберігається.
; Друковані українські імена; виконання належить СЕНС, фізичні байти - Зіг і Т5М.
(визначити обміняти-сусідів
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) елементи)
      ((атом? (як-є ()))
       (сполучити (друге елементи)
         (сполучити (перше елементи)
           (обміняти-сусідів (решта (решта елементи)))))))))

(визначити обміняна-четвірка
  (обміняти-сусідів
    (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?))))
(визначити обміняна-трійка
  (обміняти-сусідів
    (список (як-є атом?) (як-є решта) (як-є сполучити))))
(визначити обміняна-одиниця
  (обміняти-сусідів (список (як-є тотожне?))))

