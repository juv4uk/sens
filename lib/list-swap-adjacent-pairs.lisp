  ((тотожне? (друге обміняна-четвірка) (як-є атом?))
    (за-умовою
  ((тотожне? (перше (решта (решта обміняна-четвірка))) (як-є тотожне?))
    (за-умовою
  ((тотожне? (друге (решта (решта обміняна-четвірка))) (як-є сполучити))
    (за-умовою
  ((порожній? (решта (решта (решта (решта обміняна-четвірка)))))
    (за-умовою
  ((тотожне? (перше обміняна-трійка) (як-є решта))
    (за-умовою
  ((тотожне? (друге обміняна-трійка) (як-є атом?))
    (за-умовою
  ((тотожне? (перше (решта (решта обміняна-трійка))) (як-є сполучити))
    (за-умовою
  ((порожній? (решта (решта (решта обміняна-трійка))))
    (за-умовою
  ((тотожне? (перше обміняна-одиниця) (як-є тотожне?))
    (за-умовою
  ((порожній? (решта обміняна-одиниця))
    (за-умовою
  ((порожній? (обміняти-сусідів (як-є ())))
    (за-умовою
  ((хибне? (тотожне? (перше обміняна-четвірка) (як-є атом?)))
    (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ())))))
