; D3/D5: переставити місцями кожну сусідню пару елементів списку.
; Непарний останній елемент лишається останнім, порядок пар зберігається.
; Друковані українські імена; виконання належить SENS, фізичні байти — Zig/T5M.
(визначити обміняти-сусідів
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) елементи)
      ((атом? (як-є ()))
       (сполучити (друге елементи)
         (сполучити (перше елементи)
           (обміняти-сусідів (решта (решта елементи)))))))))

(визначити обміняна-четвірка
  (обміняти-сусідів
    (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?))))
(визначити обміняна-трійка
  (обміняти-сусідів
    (список (як-є атом?) (як-є решта) (як-є сполучити))))
(визначити обміняна-одиниця
  (обміняти-сусідів (список (як-є тотожне?))))

; Тринадцять реальних законів: парна/непарна довжина, одиничний,
; порожній список, негативна перестановка. Помилка — CAR(NIL) у SENS.

(за-умовою
  ((тотожне? (перше обміняна-четвірка) (як-є решта))
    (за-умовою
  ((тотожне? (друге обміняна-четвірка) (як-є атом?))
    (за-умовою
  ((тотожне? (перше (решта (решта обміняна-четвірка))) (як-є тотожне?))
    (за-умовою
  ((тотожне? (друге (решта (решта обміняна-четвірка))) (як-є сполучити))
    (за-умовою
  ((порожній? (решта (решта (решта (решта обміняна-четвірка)))))
    (за-умовою
  ((тотожне? (перше обміняна-трійка) (як-є решта))
    (за-умовою
  ((тотожне? (друге обміняна-трійка) (як-є атом?))
    (за-умовою
  ((тотожне? (перше (решта (решта обміняна-трійка))) (як-є сполучити))
    (за-умовою
  ((порожній? (решта (решта (решта обміняна-трійка))))
    (за-умовою
  ((тотожне? (перше обміняна-одиниця) (як-є тотожне?))
    (за-умовою
  ((порожній? (решта обміняна-одиниця))
    (за-умовою
  ((порожній? (обміняти-сусідів (як-є ())))
    (за-умовою
  ((хибне? (тотожне? (перше обміняна-четвірка) (як-є атом?)))
    (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ())))))
