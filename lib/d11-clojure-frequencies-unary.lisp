; Д11: бібліотечний закон частот за ідеєю Clojure frequencies.
; Першоджерело: https://clojure.github.io/clojure/branch-master/clojure.core-api.html
; Clojure повертає map ключ -> число. Тут свідомо інша проєкція SENS:
; впорядкований список (ключ (о ...)); кратність — унарні CONS-комірки.
; Ключі йдуть за першою появою, несуміжні рівні ключі об'єднуються.
; Це чиста композиція вже визначеного групування, не новий D11 opcode.
; Аргументи — скінченний правильний список і чисте SENS-замикання ключа.
; Під час групування функція ключа може викликатися повторно.
; Ні D24-літералів, ні host-арифметики, ні семантики Python/JSON.

(визначити побудувати-унарну-кратність
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (як-є о)
         (побудувати-унарну-кратність (решта елементи)))))))

(визначити перетворити-групи-на-частоти
  (функція (групи)
    (за-умовою
      ((атом? групи) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (список
           (перше (перше групи))
           (побудувати-унарну-кратність (друге (перше групи))))
         (перетворити-групи-на-частоти (решта групи)))))))

(визначити частоти-за-ключем-унарно
  (функція (функція-ключа елементи)
    (перетворити-групи-на-частоти
      (згрупувати-елементи-за-ключем функція-ключа елементи))))

(визначити частоти-елементів-унарно
  (функція (елементи)
    (частоти-за-ключем-унарно
      (функція (елемент) елемент)
      елементи)))
