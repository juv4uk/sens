; Д11: бібліотечний закон частот за ідеєю Кложур частоти.
; Ідея запозичена з бібліотеки Кложур (частоти).
; Кложур повертає мапу ключ дає число. Тут свідомо інша проєкція СЕНС:
; впорядкований список (ключ (о ...)); кратність - унарні пари-комірки.
; Ключі йдуть за першою появою, несуміжні рівні ключі об'єднуються.
; Це чиста композиція вже визначеного групування, не новий Д11 коду операції.
; Аргументи - скінченний правильний список і чисте СЕНС-замикання ключа.
; Під час групування функція ключа може викликатися повторно.
; Ні Д24-літералів, ні зовнішньої арифметики, ні семантики пітона і джейсона.

(визначити побудувати-унарну-кратність
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (як-є о)
         (побудувати-унарну-кратність (решта елементи)))))))

(визначити перетворити-групи-на-частоти
  (функція (групи)
    (за-умовою
      ((атом? групи) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (список
           (перше (перше групи))
           (побудувати-унарну-кратність (друге (перше групи))))
         (перетворити-групи-на-частоти (решта групи)))))))

(визначити частоти-за-ключем-унарно
  (функція (функція-ключа елементи)
    (перетворити-групи-на-частоти
      (згрупувати-елементи-за-ключем функція-ключа елементи))))

(визначити частоти-елементів-унарно
  (функція (елементи)
    (частоти-за-ключем-унарно
      (функція (елемент) елемент)
      елементи)))
