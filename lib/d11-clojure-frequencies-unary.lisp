; Д11: бібліотечний закон частот за ідеєю Кложур частоти.
; Ідея запозичена з бібліотеки Кложур (частоти).
; Кложур повертає мапу ключ дає число. Тут свідомо інша проєкція СЕНС:
; впорядкований список (ключ (о ...)); кратність - унарні пари-комірки.
; Ключі йдуть за першою появою, несуміжні рівні ключі об'єднуються.
; Це чиста композиція вже визначеного групування, не новий Д11 коду операції.
; Аргументи - скінченний правильний список і чисте СЕНС-замикання ключа.
; Під час групування функція ключа може викликатися повторно.
; У D11 правильний список закінчується лише D3 (), не довільним атомом.
; Інакший хвіст дійде до D3 ПЕРШЕ та викличе Type власного SENS.
; Ні Д24-літералів, ні зовнішньої арифметики, ні семантики пітона і джейсона.

(визначити побудувати-унарну-кратність
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (як-є о)
         (побудувати-унарну-кратність (решта елементи)))))))

; D11-пропозиція: ядро отримує вже перевірений зовнішній D3-список груп.
; Структура групування гарантує правильну форму груп і кратностей.
; Ключ може бути D1:ні або D3:(), бо це ДАНІ, а не кінець списку.
; D11: рівно два поля (ключ елементи); зайві дані не обрізаємо.
; Не підтримувана форма завершується справжнім D3 CAR Type.
(визначити підтвердити-пару-групи-для-частот
  (функція (група)
    (за-умовою
      ((порожній? група) (перше група))
      ((атом? група) (перше група))
      ((порожній? (решта група)) (перше (решта група)))
      ((атом? (решта група)) (перше (решта група)))
      ((порожній? (решта (решта група))) група)
      (так (перше (як-є ()))))))

(визначити створити-частоту-з-групи
  (функція (група)
    (список
      (перше група)
      (побудувати-унарну-кратність (друге група)))))

(визначити перетворити-групи-на-частоти-ядро
  (функція (групи)
    (за-умовою
      ((порожній? групи) (як-є ()))
      (так
       (сполучити
         (створити-частоту-з-групи
           (підтвердити-пару-групи-для-частот (перше групи)))
         (перетворити-групи-на-частоти-ядро (решта групи)))))))

; Прямий SENS-вхід: спочатку весь D3-ланцюг, лише потім кратності.
; Не створюємо іншого валідатора: чинний GROUP-BY вже надає preflight.
(визначити перетворити-групи-на-частоти
  (функція (групи)
    (перетворити-групи-на-частоти-ядро
      (підтвердити-список-для-групування групи групи))))

(визначити частоти-за-ключем-унарно
  (функція (функція-ключа елементи)
    (перетворити-групи-на-частоти-ядро
      (згрупувати-елементи-за-ключем функція-ключа елементи))))

(визначити частоти-елементів-унарно
  (функція (елементи)
    (частоти-за-ключем-унарно
      (функція (елемент) елемент)
      елементи)))
