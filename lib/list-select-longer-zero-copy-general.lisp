; СЕНС: вибрати початковий (не скопійований) довший із двох правильних списків.
; Час лінійний за меншим, додаткових пар немає; за рівної довжини обираємо лівий.
; Порівнюємо довжини через решта, а не через зовнішній лічильник чи Д7.
(визначити вибрати-довший-стан
 (функція (лівий правий лівий-хвіст правий-хвіст)
  (за-умовою
   ((атом? лівий-хвіст)
    (за-умовою
     ((атом? правий-хвіст) лівий)
     (так правий)))
   ((атом? правий-хвіст) лівий)
   (так
    (вибрати-довший-стан лівий правий
     (решта лівий-хвіст) (решта правий-хвіст))))))

(визначити вибрати-довший-без-копіювання
 (функція (лівий правий)
  (вибрати-довший-стан лівий правий лівий правий)))

; Відхилення хибного закону - виконання першого від порожнього у самому СЕНС.
(за-умовою
 ((порожній? (вибрати-довший-без-копіювання (як-є ()) (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (вибрати-довший-без-копіювання
    (як-є ()) (список (як-є решта)))) (як-є решта)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (вибрати-довший-без-копіювання
    (список (як-є атом?)) (як-є ()))) (як-є атом?)) так)
 (так (перше (як-є ()))))

; Неправильна пара й окремий атом не викликають РЕШТА від атома.
; Д3 АТОМ? - межа обходу; жодних хостових перевірок чи Д7-чисел.
(за-умовою
 ((тотожне? (вибрати-довший-без-копіювання (як-є атом?) (як-є решта))
             (як-є атом?)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (вибрати-довший-без-копіювання
    (як-є атом?) (список (як-є решта)))) (як-є решта)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (друге (вибрати-довший-без-копіювання
    (сполучити (як-є атом?) (як-є решта))
    (список (як-є решта) (як-є сполучити))))
   (як-є сполучити)) так)
 (так (перше (як-є ()))))

; Порівняння коротшого та довшого в обидва боки.
(за-умовою
 ((тотожне? (друге (вибрати-довший-без-копіювання
    (список (як-є атом?))
    (список (як-є решта) (як-є сполучити))))
   (як-є сполучити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (друге (вибрати-довший-без-копіювання
    (список (як-є атом?) (як-є тотожне?))
    (список (як-є решта))))
   (як-є тотожне?)) так)
 (так (перше (як-є ()))))

; Рівні довжини: лівий має пріоритет, незалежно від вмісту.
(за-умовою
 ((тотожне? (перше (вибрати-довший-без-копіювання
    (список (як-є атом?) (як-є сполучити))
    (список (як-є решта) (як-є сполучити))))
   (як-є атом?)) так)
 (так (перше (як-є ()))))

; Порожній - повноцінний елемент, вкладений список також один елемент.
(за-умовою
 ((порожній? (перше (вибрати-довший-без-копіювання
    (список (як-є ()) (як-є решта))
    (список (як-є атом?))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (атом? (перше (вибрати-довший-без-копіювання
    (список (список (як-є атом?)) (як-є решта))
    (список (як-є сполучити)))))) так)
 (так (перше (як-є ()))))

; Негатив: помилкове трактування вкладеної пари як двох елементів.
(за-умовою
 ((хибне? (тотожне? (перше (вибрати-довший-без-копіювання
    (список (список (як-є атом?)))
    (список (як-є решта) (як-є сполучити))))
   (як-є атом?))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
