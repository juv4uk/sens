; Пониження зовнішніх виконавців після вибору допущеного механізму SENS.
;
; Точна ідентичність належить ратифікованому домену, а не старому сід8.
; Цей модуль не виводить домен із байта, не визначає арифметику та
; не створює резервного виконавця. Він перетворює вже вибраний маршрут
; на точну пару операндів, зберігаючи протокольні поля.
;
; Виконувані голови мають повну ратифіковану проєкцію «укр»:
; визначити, функція, за-умовою, атом?, тотожне?, як-є, список,
; перше, четверте, сполучити, список.
; Локальні назви функцій і параметрів пишуться українською.
; Іноземні назви виконавців, механізмів і станів — лише цитовані
; атоми зовнішнього протоколу, НЕ виклики.
;
; Залежність: lib/mechanism-selector.lisp (вибрати-механізм).
; Zig/T5M фізично пакує точні слова, але не обирає семантику.
;
; Жодних машинних літералів, псевдонімів сід8/сенс8 або прихованого
; перенесення історичних кодів у сучасний Д8.

; Два точні числові операнди залишаються числовими об'єктами
; Д24+ до межі виконавця: жодних недопущених рядкових літералів
; або Unicode-сурогатів для T5M. Зовнішній транспорт може створити
; текст лише після допущеного механізму, семантику не обирає.
; Усі чотири підтримувані виконавці отримують однакову пару.
(визначити острів-аргументи-додавання
  (функція (виконавець лівий правий)
    (за-умовою
      ((хибне? (атом? виконавець)) (як-є ()))
      ((тотожне? виконавець (як-є common-lisp)) (список лівий правий))
      ((тотожне? виконавець (як-є prolog)) (список лівий правий))
      ((тотожне? виконавець (як-є datalog)) (список лівий правий))
      ((тотожне? виконавець (як-є clips)) (список лівий правий))
      ((атом? (як-є ())) (як-є ())))))

; Формат протокольної відповіді незмінний.
(визначити острів-відхилити-вибір
  (функція (ідентичність виконавець причина)
    (список
      (як-є island-lowering-failure)
      причина
      ідентичність виконавець)))

(визначити острів-відхилити-механізм
  (функція (ідентичність виконавець механізм причина)
    (список
      (як-є island-lowering-failure)
      причина
      ідентичність виконавець механізм)))

(визначити острів-завершити-пониження
  (функція (ідентичність виконавець механізм аргументи)
    (за-умовою
      ((атом? аргументи)
       (за-умовою
         ((тотожне? аргументи (як-є ()))
          (острів-відхилити-механізм
            ідентичність виконавець механізм
            (як-є unsupported-executor)))
         ((атом? (як-є ()))
          (список
            (як-є island-lowering-result)
            ідентичність виконавець механізм аргументи))))
      ((атом? (як-є ()))
       (список
         (як-є island-lowering-result)
         ідентичність виконавець механізм аргументи)))))

; Відомий і підтверджений механізм додавання має лише один
; транспортний формат. Невідомі механізми не виконуються.
(визначити острів-знизити-вибраний-механізм
  (функція (ідентичність виконавець лівий правий механізм)
    (за-умовою
      ((хибне? (атом? механізм))
       (острів-відхилити-механізм
         ідентичність виконавець механізм
         (як-є unsupported-selected-mechanism)))
      ((тотожне? механізм (як-є bounded-exact-add))
       (острів-завершити-пониження
         ідентичність виконавець механізм
         (острів-аргументи-додавання виконавець лівий правий)))
      ((атом? (як-є ()))
       (острів-відхилити-механізм
         ідентичність виконавець механізм
         (як-є unsupported-selected-mechanism))))))

; До D6 «четверте» звертаємося тільки після перевірки пари
; на кожному кроці. Пошкоджений маршрут не є виконавчим законом.
; Предикати повертають живі біти Д1, а не псевдоніми чи порожній список.
(визначити острів-є-четверте-поле?
  (функція (запис)
    (за-умовою
      ((атом? запис) (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (решта запис)) (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (решта (решта запис))) (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (решта (решта (решта запис)))) (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (як-є ())) (атом? (як-є ()))))))

; Якщо маршрутизатор повідомив відмову, повертаємо її без
; повторного вибору механізму та без запасного шляху.
(визначити острів-обробити-вибір
  (функція (ідентичність виконавець лівий правий вибір)
    (за-умовою
      ((атом? вибір)
       (острів-відхилити-вибір
         ідентичність виконавець (як-є malformed-selection)))
      ((хибне? (атом? (перше вибір))) вибір)
      ((тотожне? (перше вибір) (як-є mechanism-selected))
       (за-умовою
         ((острів-є-четверте-поле? вибір)
          (острів-знизити-вибраний-механізм
            ідентичність виконавець лівий правий
            (четверте вибір)))
         ((атом? (як-є ()))
          (острів-відхилити-вибір
            ідентичність виконавець (як-є malformed-selection)))))
      ((атом? (як-є ())) вибір))))

; Єдиний відкритий мовний виклик нового модуля.
; «ідентичність» — типізований точнодоменний об'єкт від
; чинного SENS, не байт колишнього реєстру.
(визначити острів-знизити-двійковий-вираз
  (функція (ідентичність виконавець лівий правий)
    (острів-обробити-вибір
      ідентичність виконавець лівий правий
      (вибрати-механізм ідентичність виконавець))))
