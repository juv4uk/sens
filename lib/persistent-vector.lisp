; Персистентний вектор СЕНС зі структурним спільним використанням вузлів.
; Значення вектора є парою: кількість елементів та корінь дерева.
; Вузол дерева містить індекс, значення, висоту, ліве і праве піддерева.
; Додавання не змінює попереднього вектора, а повертає нове значення.
; Повороти підтримують збалансовану висоту дерева.
; Пошук за індексом повертає порожній список за відсутності елемента,
; а для знайденого елемента повертає одноелементний список.
; Перетворення зі списку зберігає початковий порядок значень.
; Основні визначення мають повну ратифіковану проєкцію укр домену Д9.
; Назви інших мов не дублюються в цій українській бібліотеці.
; Перевірка поведінки належить справжньому обчислювачу СЕНС.


(визначити вектор-порожній (сполучити 0 (як-є ())))
(визначити вектор-кількість (функція (вектор-лічильника) (перше вектор-лічильника)))
(визначити отримати-дерево-вектора (функція (вектор-дерева) (решта вектор-дерева)))

(визначити вектор-вузол-індекс (функція (вузол-для-індексу) (перше вузол-для-індексу)))
(визначити вектор-вузол-значення (функція (вузол-для-значення) (друге вузол-для-значення)))
(визначити вектор-вузол-висота (функція (вузол-для-висоти) (третє вузол-для-висоти)))
(визначити вектор-вузол-ліве-піддерево
  (функція (вузол-лівого-піддерева)
    (третє (решта вузол-лівого-піддерева))))
(визначити вектор-вузол-праве-піддерево
  (функція (вузол-правого-піддерева)
    (третє (решта (решта вузол-правого-піддерева)))))

(визначити вектор-висота-піддерева
  (функція (вузол-для-визначення-висоти) (за-умовою 
                    ((атом? вузол-для-визначення-висоти)  0) ((атом? (як-є ())) (вектор-вузол-висота вузол-для-визначення-висоти)))))

(визначити вектор-більша-висота
  (функція (ліва-висота права-висота)
    (за-умовою
      ((менше? ліва-висота права-висота)  права-висота)
      ((хибне? (менше? ліва-висота права-висота)) ліва-висота))))

(визначити вектор-створити-збалансований-вузол
  (функція (індекс-нового-вузла значення-нового-вузла ліве-піддерево праве-піддерево)
    (список індекс-нового-вузла значення-нового-вузла (додати 1 (вектор-більша-висота (вектор-висота-піддерева ліве-піддерево) (вектор-висота-піддерева праве-піддерево))) ліве-піддерево праве-піддерево)))

(визначити вектор-коефіцієнт-балансу
  (функція (вузол-коефіцієнта-балансу) (відняти (вектор-висота-піддерева (вектор-вузол-ліве-піддерево вузол-коефіцієнта-балансу)) (вектор-висота-піддерева (вектор-вузол-праве-піддерево вузол-коефіцієнта-балансу)))))

(визначити вектор-повернути-ліворуч-зі-правим
  (функція (вузол-лівого-повороту праве-піддерево-лівого-повороту)
    (вектор-створити-збалансований-вузол
      (вектор-вузол-індекс праве-піддерево-лівого-повороту)
      (вектор-вузол-значення праве-піддерево-лівого-повороту)
      (вектор-створити-збалансований-вузол
        (вектор-вузол-індекс вузол-лівого-повороту)
        (вектор-вузол-значення вузол-лівого-повороту)
        (вектор-вузол-ліве-піддерево вузол-лівого-повороту)
        (вектор-вузол-ліве-піддерево праве-піддерево-лівого-повороту))
      (вектор-вузол-праве-піддерево праве-піддерево-лівого-повороту))))

(визначити вектор-повернути-ліворуч
  (функція (вузол-лівого-повороту)
    (вектор-повернути-ліворуч-зі-правим
      вузол-лівого-повороту
      (вектор-вузол-праве-піддерево вузол-лівого-повороту))))

(визначити вектор-повернути-праворуч-зі-лівим
  (функція (вузол-правого-повороту ліве-піддерево-правого-повороту)
    (вектор-створити-збалансований-вузол
      (вектор-вузол-індекс ліве-піддерево-правого-повороту)
      (вектор-вузол-значення ліве-піддерево-правого-повороту)
      (вектор-вузол-ліве-піддерево ліве-піддерево-правого-повороту)
      (вектор-створити-збалансований-вузол
        (вектор-вузол-індекс вузол-правого-повороту)
        (вектор-вузол-значення вузол-правого-повороту)
        (вектор-вузол-праве-піддерево ліве-піддерево-правого-повороту)
        (вектор-вузол-праве-піддерево вузол-правого-повороту)))))

(визначити вектор-повернути-праворуч
  (функція (вузол-правого-повороту)
    (вектор-повернути-праворуч-зі-лівим
      вузол-правого-повороту
      (вектор-вузол-ліве-піддерево вузол-правого-повороту))))

(визначити вектор-збалансувати
  (функція (вузол-для-балансування)
    (за-умовою

      ((атом? вузол-для-балансування)  вузол-для-балансування)
      ((більше? (вектор-коефіцієнт-балансу вузол-для-балансування) 1) 
       (за-умовою
         ((менше? (вектор-коефіцієнт-балансу (вектор-вузол-ліве-піддерево вузол-для-балансування)) 0) 
          (вектор-повернути-праворуч (вектор-створити-збалансований-вузол (вектор-вузол-індекс вузол-для-балансування) (вектор-вузол-значення вузол-для-балансування)
                           (вектор-повернути-ліворуч (вектор-вузол-ліве-піддерево вузол-для-балансування)) (вектор-вузол-праве-піддерево вузол-для-балансування))))
         ((атом? (як-є ())) (вектор-повернути-праворуч вузол-для-балансування))))
      ((менше? (вектор-коефіцієнт-балансу вузол-для-балансування) -1) 
       (за-умовою
         ((більше? (вектор-коефіцієнт-балансу (вектор-вузол-праве-піддерево вузол-для-балансування)) 0) 
          (вектор-повернути-ліворуч (вектор-створити-збалансований-вузол (вектор-вузол-індекс вузол-для-балансування) (вектор-вузол-значення вузол-для-балансування)
                          (вектор-вузол-ліве-піддерево вузол-для-балансування) (вектор-повернути-праворуч (вектор-вузол-праве-піддерево вузол-для-балансування)))))

         ((атом? (як-є ())) (вектор-повернути-ліворуч вузол-для-балансування))))
      ((атом? (як-є ())) вузол-для-балансування))))

(визначити вставити-в-дерево-вектора
  (функція (індекс-вставки-вектора значення-вставки-вектора дерево-вставки-вектора)
    (за-умовою

      ((атом? дерево-вставки-вектора)  (вектор-створити-збалансований-вузол індекс-вставки-вектора значення-вставки-вектора (як-є ()) (як-є ())))
      ((тотожне? індекс-вставки-вектора (вектор-вузол-індекс дерево-вставки-вектора))
       (вектор-створити-збалансований-вузол індекс-вставки-вектора значення-вставки-вектора (вектор-вузол-ліве-піддерево дерево-вставки-вектора) (вектор-вузол-праве-піддерево дерево-вставки-вектора)))
      ((менше? індекс-вставки-вектора (вектор-вузол-індекс дерево-вставки-вектора)) 
       (вектор-збалансувати (вектор-створити-збалансований-вузол (вектор-вузол-індекс дерево-вставки-вектора) (вектор-вузол-значення дерево-вставки-вектора)
                   (вставити-в-дерево-вектора індекс-вставки-вектора значення-вставки-вектора (вектор-вузол-ліве-піддерево дерево-вставки-вектора))
                   (вектор-вузол-праве-піддерево дерево-вставки-вектора))))
      ((атом? (як-є ()))
       (вектор-збалансувати (вектор-створити-збалансований-вузол (вектор-вузол-індекс дерево-вставки-вектора) (вектор-вузол-значення дерево-вставки-вектора)
                   (вектор-вузол-ліве-піддерево дерево-вставки-вектора)
                   (вставити-в-дерево-вектора індекс-вставки-вектора значення-вставки-вектора (вектор-вузол-праве-піддерево дерево-вставки-вектора))))))))

(визначити отримати-з-дерева-вектора
  (функція (шуканий-індекс-вектора дерево-пошуку-вектора)
    (за-умовою

      ((атом? дерево-пошуку-вектора)  (як-є ()))
      ((тотожне? шуканий-індекс-вектора (вектор-вузол-індекс дерево-пошуку-вектора)) (список (вектор-вузол-значення дерево-пошуку-вектора)))
      ((менше? шуканий-індекс-вектора (вектор-вузол-індекс дерево-пошуку-вектора))  (отримати-з-дерева-вектора шуканий-індекс-вектора (вектор-вузол-ліве-піддерево дерево-пошуку-вектора)))
      ((атом? (як-є ())) (отримати-з-дерева-вектора шуканий-індекс-вектора (вектор-вузол-праве-піддерево дерево-пошуку-вектора))))))

(визначити вектор-н-тий
  (функція (індекс-для-читання-вектора вектор-для-читання) (отримати-з-дерева-вектора індекс-для-читання-вектора (отримати-дерево-вектора вектор-для-читання))))

(визначити вектор-додати
  (функція (значення-для-додавання-вектора вектор-до-додавання)
    (сполучити (додати 1 (вектор-кількість вектор-до-додавання))
          (вставити-в-дерево-вектора (вектор-кількість вектор-до-додавання) значення-для-додавання-вектора (отримати-дерево-вектора вектор-до-додавання)))))

(визначити перетворити-дерево-вектора-на-список
  (функція (дерево-для-проєкції-списку)
    (за-умовою

      ((атом? дерево-для-проєкції-списку)  (як-є ()))
      ((атом? (як-є ())) (приєднати (перетворити-дерево-вектора-на-список (вектор-вузол-ліве-піддерево дерево-для-проєкції-списку))
                 (сполучити (вектор-вузол-значення дерево-для-проєкції-списку)
                       (перетворити-дерево-вектора-на-список (вектор-вузол-праве-піддерево дерево-для-проєкції-списку))))))))

(визначити вектор-список
  (функція (вектор-для-проєкції-списку) (перетворити-дерево-вектора-на-список (отримати-дерево-вектора вектор-для-проєкції-списку))))

(визначити створити-вектор-зі-списку-до
  (функція (список-для-побудови-вектора накопичувач-побудови-вектора)
    (за-умовою

      ((атом? список-для-побудови-вектора)  накопичувач-побудови-вектора)
      ((атом? (як-є ())) (створити-вектор-зі-списку-до (решта список-для-побудови-вектора) (вектор-додати (перше список-для-побудови-вектора) накопичувач-побудови-вектора))))))

(визначити вектор-з-список
  (функція (вхідний-список-вектора) (створити-вектор-зі-списку-до вхідний-список-вектора вектор-порожній)))

; Кінцевий виклик-свідок: файл виконується при завантаженні, а не лише визначає.
(вектор-кількість вектор-порожній)
