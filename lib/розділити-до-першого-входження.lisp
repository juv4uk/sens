; Реальне розділення власного скінченного списку атомів за ПЕРШИМ входженням.
; Перша частина не містить роздільника, друга починається з нього.
; Якщо збігу немає, суфікс порожній; при збігу в голові префікс порожній.
; Лише D3/D4 закони, ніякого нового резидента чи host-фільтра.
(визначити взяти-до-першого-входження
  (функція (зупинка елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((тотожне? (перше елементи) зупинка) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (перше елементи)
         (взяти-до-першого-входження зупинка (решта елементи)))))))

(визначити залишити-від-першого-входження
  (функція (зупинка елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((тотожне? (перше елементи) зупинка) елементи)
      ((атом? (як-є ()))
       (залишити-від-першого-входження зупинка (решта елементи))))))

(визначити поділ-за-першим-входженням
  (функція (зупинка елементи)
    (список
      (взяти-до-першого-входження зупинка елементи)
      (залишити-від-першого-входження зупинка елементи))))

(визначити вхідний-список
  (список (як-є атом?) (як-є решта) (як-є сполучити)
          (як-є тотожне?) (як-є сполучити)))
(визначити поділене-за-першим
  (поділ-за-першим-входженням (як-є сполучити) вхідний-список))
(визначити збіг-в-голові
  (поділ-за-першим-входженням (як-є сполучити)
    (список (як-є сполучити) (як-є атом?))))
(визначити збіг-відсутній
  (поділ-за-першим-входженням (як-є список) вхідний-список))
(визначити порожній-поділ
  (поділ-за-першим-входженням (як-є атом?) (як-є ())))

; Живе D1-свідчення: перший збіг, повторний роздільник у суфіксі,
; порядок префікса й суфікса, порожній/незнайдений випадки, негатив.
(за-умовою
  ((тотожне? (перше (перше поділене-за-першим)) (як-є атом?))
    (за-умовою
      ((тотожне? (друге (перше поділене-за-першим)) (як-є решта))
        (за-умовою
          ((атом? (решта (решта (перше поділене-за-першим))))
            (за-умовою
              ((тотожне? (перше (друге поділене-за-першим)) (як-є сполучити))
                (за-умовою
                  ((тотожне? (друге (друге поділене-за-першим)) (як-є тотожне?))
                    (за-умовою
                      ((тотожне? (третє (друге поділене-за-першим)) (як-є сполучити))
                        (за-умовою
                          ((атом? (решта (решта (решта (друге поділене-за-першим)))))
                            (за-умовою
                              ((хибне? (тотожне? (перше (перше поділене-за-першим)) (як-є сполучити)))
                                (за-умовою
                                  ((порожній? (перше збіг-в-голові))
                                    (за-умовою
                                      ((тотожне? (перше (друге збіг-в-голові)) (як-є сполучити))
                                        (за-умовою
                                          ((порожній? (друге збіг-відсутній))
                                            (за-умовою
                                              ((тотожне? (третє (перше збіг-відсутній)) (як-є сполучити))
                                                (за-умовою
                                                  ((порожній? (перше порожній-поділ))
                                                    (за-умовою
                                                      ((порожній? (друге порожній-поділ))
                                                        (атом? (як-є ())))
                                                      ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                                                  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                                              ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                                          ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                                      ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                                  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                              ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                          ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                      ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
              ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
          ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
      ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
