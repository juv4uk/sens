; Д3 і Д4: оборотний поділ скінченного списку перед ОСТАННІМ збігом.
; Результат (префікс суфікс): жодне входження не втрачається.
; За відсутності збігу (початковий-список порожній), порожній дає (порожній порожній).
; Виконання - СЕНС, фізичні байти - Зіг і Т5М; без пітон і джейсон.
(визначити долучити-голову-до-останнього-поділу
  (функція (елементи хвостовий-поділ)
    (список
      (сполучити (перше елементи) (перше хвостовий-поділ))
      (друге хвостовий-поділ))))

(визначити вибрати-останній-поділ
  (функція (елементи шукане хвостовий-поділ)
    (за-умовою
      ((хибне? (порожній? (друге хвостовий-поділ)))
       (долучити-голову-до-останнього-поділу елементи хвостовий-поділ))
      ((тотожне? (перше елементи) шукане)
       (список (як-є ()) елементи))
      ((атом? (як-є ()))
       (долучити-голову-до-останнього-поділу елементи хвостовий-поділ)))))

(визначити поділ-перед-останнім
  (функція (елементи шукане)
    (за-умовою
      ((атом? елементи) (список (як-є ()) (як-є ())))
      ((атом? (як-є ()))
       (вибрати-останній-поділ
         елементи шукане
         (поділ-перед-останнім (решта елементи) шукане))))))

(визначити зібрати-останній-поділ
  (функція (поділ)
    (приєднати (перше поділ) (друге поділ))))

