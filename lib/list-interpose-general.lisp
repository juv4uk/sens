; Д3 і Д4: вставити роздільник між елементами скінченного правильного списку.
; Інверсія лише на образі цієї операції: вилучення вставлених роздільників.
; Усі значення - чинні коди атомів, роздільник не є друкованим Унісоде.
; Ні ЗІП-ресідент, ні пітон і джейсон в обчисленні не беруть участі.

(визначити вставити-роздільник-між
  (функція (роздільник елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((порожній? (решта елементи)) елементи)
      ((атом? (як-є ()))
       (сполучити
         (перше елементи)
         (сполучити роздільник
           (вставити-роздільник-між роздільник (решта елементи))))))))

(визначити вилучити-роздільники-між
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((порожній? (решта елементи)) елементи)
      ((атом? (як-є ()))
       (сполучити (перше елементи)
         (вилучити-роздільники-між (решта-решти елементи)))))))

(визначити початкова-четвірка
  (список (як-є атом?) (як-є сполучити) (як-є решта) (як-є тотожне?)))
(визначити зі-роздільниками
  (вставити-роздільник-між (як-є хибне?) початкова-четвірка))
(визначити відновлена-четвірка
  (вилучити-роздільники-між зі-роздільниками))

; 7 позицій після вставлення, 4 після вилучення,
; обидві порожні основи, одноелементна основа й негатив.
(за-умовою
  ((тотожне? (перше зі-роздільниками) (як-є атом?))
   (за-умовою
     ((тотожне? (перше (решта зі-роздільниками)) (як-є хибне?))
      (за-умовою
        ((тотожне? (перше (решта (решта зі-роздільниками))) (як-є сполучити))
         (за-умовою
           ((тотожне? (перше (решта (решта (решта зі-роздільниками)))) (як-є хибне?))
            (за-умовою
              ((тотожне? (перше (решта (решта (решта (решта зі-роздільниками))))) (як-є решта))
               (за-умовою
                 ((тотожне? (перше (решта (решта (решта (решта (решта зі-роздільниками)))))) (як-є хибне?))
                  (за-умовою
                    ((тотожне? (перше (решта (решта (решта (решта (решта (решта зі-роздільниками))))))) (як-є тотожне?))
                     (за-умовою
                       ((тотожне? (перше відновлена-четвірка) (як-є атом?))
                        (за-умовою
                          ((тотожне? (перше (решта відновлена-четвірка)) (як-є сполучити))
                           (за-умовою
                             ((тотожне? (перше (решта (решта відновлена-четвірка))) (як-є решта))
                              (за-умовою
                                ((тотожне? (перше (решта (решта (решта відновлена-четвірка)))) (як-є тотожне?))
                                 (за-умовою
                                   ((порожній? (вставити-роздільник-між (як-є хибне?) (як-є ())))
                                    (за-умовою
                                      ((порожній? (вилучити-роздільники-між (як-є ())))
                                       (за-умовою
                                         ((тотожне? (перше (вставити-роздільник-між (як-є хибне?) (список (як-є атом?)))) (як-є атом?))
                                          (за-умовою
                                            ((хибне? (тотожне? (перше відновлена-четвірка) (як-є хибне?)))
                                             (атом? (як-є ())))
                                            ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                                         ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                                      ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                                   ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                                ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                             ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                          ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                       ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                    ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                 ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
              ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
           ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
        ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
     ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
