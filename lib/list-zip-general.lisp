; Довільна довжина: спарування двох правильних списків однакової довжини.
; Д3 CONS/CAR/CDR та Д4 LIST; порожній базис повертає порожній список.
; Без окремого резидента ZIP або додаткового машинного опкоду.
; Дані пари містять точкові CONS-хвости, а не друковане представлення.

(визначити спарувати-скінченні-списки
  (функція (ліві праві)
    (за-умовою
      ((порожній? ліві) (як-є ()))
      (так
       (сполучити (сполучити (перше ліві) (перше праві))
         (спарувати-скінченні-списки (решта ліві) (решта праві)))))))

(визначити ліві-зі-спарованих
  (функція (пари)
    (за-умовою
      ((порожній? пари) (як-є ()))
      (так
       (сполучити (перше (перше пари))
         (ліві-зі-спарованих (решта пари)))))))

(визначити праві-зі-спарованих
  (функція (пари)
    (за-умовою
      ((порожній? пари) (як-є ()))
      (так
       (сполучити (решта (перше пари))
         (праві-зі-спарованих (решта пари)))))))

(визначити розпарувати-скінченні-списки
  (функція (пари)
    (список (ліві-зі-спарованих пари)
            (праві-зі-спарованих пари))))

(визначити вхідні-ліві
  (список (як-є атом?) (як-є тотожне?) (як-є сполучити) (як-є решта)))
(визначити вхідні-праві
  (список (як-є порожній?) (як-є хибне?) (як-є як-є) (як-є список)))
(визначити спаровані-списки
  (спарувати-скінченні-списки вхідні-ліві вхідні-праві))
(визначити відновлені-списки
  (розпарувати-скінченні-списки спаровані-списки))

; 8 позицій відновлення, 2 порожні базові випадки та негативний доказ.
; Виконує SENS D1:1, інакше реальний D1:0, не host-правда й не NIL.
(за-умовою
  ((тотожне? (перше (перше відновлені-списки)) (як-є атом?))
   (за-умовою
     ((тотожне? (перше (решта (перше відновлені-списки))) (як-є тотожне?))
      (за-умовою
        ((тотожне? (перше (решта (решта (перше відновлені-списки)))) (як-є сполучити))
         (за-умовою
           ((тотожне? (перше (решта (решта (решта (перше відновлені-списки))))) (як-є решта))
            (за-умовою
              ((тотожне? (перше (друге відновлені-списки)) (як-є порожній?))
               (за-умовою
                 ((тотожне? (перше (решта (друге відновлені-списки))) (як-є хибне?))
                  (за-умовою
                    ((тотожне? (перше (решта (решта (друге відновлені-списки)))) (як-є як-є))
                     (за-умовою
                       ((тотожне? (перше (решта (решта (решта (друге відновлені-списки))))) (як-є список))
                        (за-умовою
                          ((порожній? (перше (розпарувати-скінченні-списки (спарувати-скінченні-списки (як-є ()) (як-є ())))))
                           (за-умовою
                             ((порожній? (друге (розпарувати-скінченні-списки (спарувати-скінченні-списки (як-є ()) (як-є ())))))
                              (за-умовою
                                ((хибне? (тотожне? (перше (перше відновлені-списки)) (як-є решта)))
                                 так)
                                (так ні)))
                             (так ні)))
                          (так ні)))
                       (так ні)))
                    (так ні)))
                 (так ні)))
              (так ні)))
           (так ні)))
        (так ні)))
     (так ні)))
  (так ні))
