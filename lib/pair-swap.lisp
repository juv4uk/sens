; Д3/Д4: переставити частини точної CONS-пари без текстового перекодування.
; Закон: перше(переставити(a . b)) = b, решта = a,
; а дві перестановки повертають початкову пару.
(визначити переставити-частини-пари
  (функція (пара)
    (сполучити (решта пара) (перше пара))))

; Виконуваний SENS-свідок: два позитивні спостереження,
; подвійна перестановка і негатив проти незміненого порядку.
(за-умовою
  ((тотожне?
     (перше (переставити-частини-пари
               (сполучити (як-є атом?) (як-є тотожне?))))
     (як-є тотожне?))
   (за-умовою
     ((тотожне?
        (решта (переставити-частини-пари
                  (сполучити (як-є атом?) (як-є тотожне?))))
        (як-є атом?))
      (за-умовою
        ((тотожне?
           (перше
             (переставити-частини-пари
               (переставити-частини-пари
                 (сполучити (як-є атом?) (як-є тотожне?)))))
           (як-є атом?))
         (хибне?
           (тотожне?
             (перше
               (переставити-частини-пари
                 (сполучити (як-є атом?) (як-є тотожне?))))
             (як-є атом?))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
