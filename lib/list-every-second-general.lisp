; Кожен другий елемент правильного скінченного списку, позиції 2, 4, 6...
; Зберігаємо складені значення без розгортання, не змінюємо вхідних пар.
; Один прохід, без числового лічильника та без зовнішнього обчислювача.
; Непорожня пара потрібна перед кожним другим доступом.
(визначити кожен-другий-елемент
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((порожній? (решта елементи)) (як-є ()))
      (так
       (сполучити
         (друге елементи)
         (кожен-другий-елемент (решта (решта елементи))))))))

; Позитивні свідки обчислює СЕНС, негативне порівняння також у СЕНС.
(за-умовою
  ((порожній? (кожен-другий-елемент (як-є ()))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (кожен-другий-елемент (список (як-є атом?)))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне?
     (перше (кожен-другий-елемент
       (список (як-є атом?) (як-є решта))))
     (як-є решта)) так)
  (так (перше (як-є ()))))
(визначити парні-позиції
  (кожен-другий-елемент
    (список (як-є атом?) (як-є решта) (як-є сполучити)
            (список (як-є тотожне?) (як-є за-умовою))
            (як-є функція) (як-є визначити) (як-є список))))
(за-умовою
  ((тотожне? (перше парні-позиції) (як-є решта)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне? (атом? (друге парні-позиції))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (друге парні-позиції)) (як-є тотожне?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (третє парні-позиції) (як-є визначити)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (решта (решта (решта парні-позиції)))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне? (тотожне? (перше парні-позиції) (як-є атом?))) так)
  (так (перше (як-є ()))))
(атом? (як-є ()))
