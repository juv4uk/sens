; СЕНС Д3–Д5: ліве згортання першокласною двоаргументною функцією.
; Функція «дія» — точний викликуваний доменний код як значення.
; Один прохід: на кожний вхід рівно один виклик дії, без службових CONS.
; Правильний скінченний список; початкове значення задає викликач.
; Фізичні T5M-байти пакує Zig, а закон і обчислення належать СЕНС.

(визначити згорнути-зліва-першокласним-кодом
  (функція (дія накопичене елементи)
    (за-умовою
      ((порожній? елементи) накопичене)
      (так
        (згорнути-зліва-першокласним-кодом
          дія
          (дія накопичене (перше елементи))
          (решта елементи))))))

; Д3 СПОЛУЧИТИ — справжня функція-значення.
; Для трьох атомів послідовність станів: (() . А), ((() . А) . Б),
; (((() . А) . Б) . В); не створюємо проміжних списків для обходу.
(визначити результат-лівого-згортання
  (згорнути-зліва-першокласним-кодом
    сполучити
    (як-є ())
    (список (як-є атом?) (як-є решта) (як-є сполучити))))

; Останній атом має бути у хвості зовнішньої пари.
(за-умовою
  ((тотожне? (решта результат-лівого-згортання) (як-є сполучити)) так)
  (так (перше (як-є ()))))

; Передостанній атом не загубився, порядок строго лівосторонній.
(за-умовою
  ((тотожне? (решта (перше результат-лівого-згортання)) (як-є решта)) так)
  (так (перше (як-є ()))))

; Перший атом зберігається в найглибшій парі.
(за-умовою
  ((тотожне?
     (решта (перше (перше результат-лівого-згортання)))
     (як-є атом?)) так)
  (так (перше (як-є ()))))

; Початкова порожнеча не перетворюється на рядок, число чи хостову істину.
(за-умовою
  ((порожній? (перше (перше (перше результат-лівого-згортання)))) так)
  (так (перше (як-є ()))))

; Порожній вхід повертає дослівне початкове значення, без виклику дії.
(за-умовою
  ((тотожне?
     (згорнути-зліва-першокласним-кодом
       сполучити (як-є решта) (як-є ()))
     (як-є решта)) так)
  (так (перше (як-є ()))))

; Негатив: останній атом — не перший, тобто згортання не обернуло порядок.
(за-умовою
  ((хибне?
     (тотожне? (решта результат-лівого-згортання) (як-є атом?))) так)
  (так (перше (як-є ()))))

; Реальний обчислений Д1-свідок у самому SENS.
(атом? (як-є ()))
