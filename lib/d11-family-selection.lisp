; Д11 — ЗАКОН СІМЕЙСТВА ВІДБОРУ (d11-family-selection).
;
; Генератор: предикат над елементом. Функції сімейства: фільтрувати, відкинути,
; розділити. Це КОМПОЗИЦІЇ чинних функцій драбин, не нові примітиви:
;   порожнє? (D4), атом? (D3), за-умовою (D3), перше/решта/сполучити (D3).
; Координата null; машинного opcode не додає. Закон сімейства, не cross-width-lift.
;
; Закон: фільтрувати(p, xs) та відкинути(p, xs) дають стабільні підпослідовності.
; Обидва результати зберігають локальний порядок, але APPEND НЕ повертає
; глобальне чергування. Відновлення за слідом Д1 — d11-family-selection-trace.
;
; Походження: Д1–Д10 мають map і fold, але загального відбору за предикатом не мають
; (є лише окремі відфільтровані-* та розділити-суміжні-*). Це заповнення пропуску.

; Лишити елементи, для яких предикат істинний (у вихідному порядку).
(визначити фільтрувати
  (функція (предикат список)
    (за-умовою
      ((порожнє? список) (як-є ()))
      ((атом? (як-є ()))
       (за-умовою
         ((предикат (перше список))
          (сполучити (перше список)
                     (фільтрувати предикат (решта список))))
         ((атом? (як-є ()))
          (фільтрувати предикат (решта список))))))))

; Лишити елементи, для яких предикат хибний.
(визначити відкинути-за-предикатом
  (функція (предикат список)
    (за-умовою
      ((порожнє? список) (як-є ()))
      ((атом? (як-є ()))
       (за-умовою
         ((предикат (перше список))
          (відкинути-за-предикатом предикат (решта список)))
         ((атом? (як-є ()))
          (сполучити (перше список)
                     (відкинути-за-предикатом предикат (решта список)))))))))

; Пара: (відібрані . відкинуті) — як пара двох списків.
(визначити розділити
  (функція (предикат список)
    (сполучити (фільтрувати предикат список)
               (сполучити (відкинути-за-предикатом предикат список) (як-є ())))))
