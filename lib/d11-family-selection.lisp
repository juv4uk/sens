; Д11 — СЕНС-сімейство стабільного відбору. Лише композиція D1/D3/D4.
; Вхід: скінченний правильний список та чистий предикат, що повертає D1.
; Порожній список — лише D3 (), сторонній атомний хвіст — помилка SENS.
; Неправильний атомний хвіст відхиляє D3 ПЕРШЕ з Type,
; а не виклик невикличного атома D1:ні.
; Правило структурної межі SENS: спочатку D3 АТОМ?, потім точне
; D3 ТОТОЖНЕ? з (), і лише тоді порожній результат.
; D1 так/ні не є D3 (), тому переходить у справжню D3 Type через ПЕРШЕ.
; Предикат не викликається для порожнього списку або неправильного атома.
; Повну форму перевіряємо один раз ДО першого виклику предиката.
; Координата null: цей закон не створює нового машинного коду D11.
; Кожна частина зберігає відносний порядок своїх елементів.
; Просте приєднання двох частин НЕ відновлює загальний порядок входу.


; Тільки D3:() закриває правильний список; D1:ні та D7 не підміняють ().
; ПЕРШЕ на неправильному атомному хвості дає точний SENS Type.
(визначити підтвердити-список-стабільного-відбору
  (функція (поточний початковий)
    (за-умовою
      ((порожній? поточний) початковий)
      ((атом? поточний) (перше поточний))
      (так
       (підтвердити-список-стабільного-відбору
         (решта поточний) початковий)))))

(визначити фільтрувати-ядро
  (функція (предикат елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((предикат (перше елементи))
       (сполучити
         (перше елементи)
         (фільтрувати-ядро предикат (решта елементи))))
      (так (фільтрувати-ядро предикат (решта елементи))))))

(визначити фільтрувати
  (функція (предикат елементи)
    (фільтрувати-ядро
      предикат
      (підтвердити-список-стабільного-відбору
        елементи елементи))))

(визначити відкинути-за-предикатом-ядро
  (функція (предикат елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((предикат (перше елементи))
       (відкинути-за-предикатом-ядро
         предикат (решта елементи)))
      (так
       (сполучити
         (перше елементи)
         (відкинути-за-предикатом-ядро
           предикат (решта елементи)))))))

(визначити відкинути-за-предикатом
  (функція (предикат елементи)
    (відкинути-за-предикатом-ядро
      предикат
      (підтвердити-список-стабільного-відбору
        елементи елементи))))

; Один результат D1 предиката класифікує елемент рівно один раз.
(визначити додати-до-розділу
  (функція (елемент обрати частини)
    (за-умовою
      (обрати
       (список
         (сполучити елемент (перше частини))
         (друге частини)))
      (так
       (список
         (перше частини)
         (сполучити елемент (друге частини)))))))

(визначити розділити-ядро
  (функція (предикат елементи)
    (за-умовою
      ((порожній? елементи)
       (список (як-є ()) (як-є ())))
      (так
       (додати-до-розділу
         (перше елементи)
         (предикат (перше елементи))
         (розділити-ядро предикат (решта елементи)))))))

(визначити розділити
  (функція (предикат елементи)
    (розділити-ядро
      предикат
      (підтвердити-список-стабільного-відбору
        елементи елементи))))
