; Д11 — СЕНС-сімейство стабільного відбору. Лише композиція D1/D3/D4.
; Вхід: скінченний правильний список та чистий предикат, що повертає D1.
; Порожній список — лише D3 (), сторонній атомний хвіст — помилка SENS.
; Координата null: цей закон не створює нового машинного коду D11.
; Кожна частина зберігає відносний порядок своїх елементів.
; Просте приєднання двох частин НЕ відновлює загальний порядок входу.

(визначити фільтрувати
  (функція (предикат елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((атом? елементи) (ні))
      ((предикат (перше елементи))
       (сполучити
         (перше елементи)
         (фільтрувати предикат (решта елементи))))
      (так (фільтрувати предикат (решта елементи))))))

(визначити відкинути-за-предикатом
  (функція (предикат елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((атом? елементи) (ні))
      ((предикат (перше елементи))
       (відкинути-за-предикатом предикат (решта елементи)))
      (так
       (сполучити
         (перше елементи)
         (відкинути-за-предикатом предикат (решта елементи)))))))

; Одне вже обчислене D1-рішення додає елемент рівно до однієї частини.
; «частини» — правильний двоелементний список (відібрані відкинуті).
(визначити додати-до-розділу
  (функція (елемент обрати частини)
    (за-умовою
      (обрати
       (список
         (сполучити елемент (перше частини))
         (друге частини)))
      (так
       (список
         (перше частини)
         (сполучити елемент (друге частини)))))))

; Один рекурсивний прохід; предикат викликається один раз на елемент.
; Результат: (відібрані відкинуті), а не два незалежні обходи.
(визначити розділити
  (функція (предикат елементи)
    (за-умовою
      ((порожній? елементи)
       (список (як-є ()) (як-є ())))
      ((атом? елементи) (ні))
      (так
       (додати-до-розділу
         (перше елементи)
         (предикат (перше елементи))
         (розділити предикат (решта елементи)))))))
