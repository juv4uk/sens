; СЕНС: вилучити першу вкладену пару з правильного списку.
; Атоми (зокрема порожній) зберігаються; після першої пари хвіст без копій.
; Один прохід, О(н) часу та О(к) нових пари лише для префікса.
(визначити вилучити-першу-пару
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи))
    (сполучити (перше елементи)
     (вилучити-першу-пару (решта елементи))))
   (так (решта елементи)))))

; Точне структурне порівняння дерев власним СЕНС, без зовнішнє-екуал.
(визначити однакові-дерева-вилучення?
 (функція (лівий правий)
  (за-умовою
   ((атом? лівий)
    (за-умовою
     ((атом? правий) (тотожне? лівий правий))
     (так ні)))
   ((атом? правий) ні)
   ((однакові-дерева-вилучення? (перше лівий) (перше правий))
    (однакові-дерева-вилучення? (решта лівий) (решта правий)))
   (так ні))))

(визначити довести-вилучення
 (функція (вхід очікуваний)
  (за-умовою
   ((однакові-дерева-вилучення?
      (вилучити-першу-пару вхід) очікуваний)
    (атом? (як-є ())))
   (так (перше (як-є ()))))))

