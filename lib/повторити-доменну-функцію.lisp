; СЕНС: піднести першокласну доменну функцію до числа структурних кроків.
; Кроки — правильний список; ніяких десяткових лічильників чи плоских історичних кодів; D7
; диспетчерів чи допоміжних CONS-пар під час обходу.
; Код Д3 РЕШТА передається як справжня функція-значення, а не назва.
(визначити повторити-доменну-функцію
  (функція (дія кроки значення)
    (за-умовою
      ((порожній? кроки) значення)
      (так
       (повторити-доменну-функцію
         дія (решта кроки) (дія значення))))))

; Два застосування Д3 РЕШТА залишають лише третій вихідний атом.
(за-умовою
  ((тотожне?
     (перше
       (повторити-доменну-функцію
         решта (список (як-є атом?) (як-є решта))
         (список (як-є атом?) (як-є решта) (як-є сполучити))))
     (як-є сполучити)) так)
  (так (перше (як-є ()))))

; Нуль кроків не викликає функцію: початок не змінено.
(за-умовою
  ((тотожне?
     (перше
       (повторити-доменну-функцію
         решта (як-є ())
         (список (як-є атом?) (як-є решта))))
     (як-є атом?)) так)
  (так (перше (як-є ()))))

; Три кроки для трьох елементів дають точний структурний NIL Д3.
(порожній?
  (повторити-доменну-функцію
    решта
    (список (як-є атом?) (як-є решта) (як-є сполучити))
    (список (як-є атом?) (як-є решта) (як-є сполучити))))

; Негатив: одне застосування не є двома.
(за-умовою
  ((хибне?
     (тотожне?
       (перше
         (повторити-доменну-функцію
           решта (список (як-є атом?))
           (список (як-є атом?) (як-є решта) (як-є сполучити))))
       (як-є сполучити))) так)
  (так (перше (як-є ()))))

; Результат обчислює SENS, Zig/T5M забезпечує лише зворотний носій.
(атом? (як-є ()))
