; Усі префікси скінченного правильного списку атомів від порожнього до повного.
; Порядок зростає додаванням одного початкового атома, жодне входження не губиться.
; Після усієї побудови останній префікс тотожний початковому списку за атомами.
; Виконуваний закон Д3 та Д4 СЕНС, Д7 є людською проєкцією.

(визначити додати-голову-до-кожного-префікса
  (функція (голова префікси)
    (за-умовою
      ((порожній? префікси) (як-є ()))
      (так
       (сполучити
         (сполучити голова (перше префікси))
         (додати-голову-до-кожного-префікса голова (решта префікси)))))))

(визначити усі-префікси
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (список (як-є ())))
      (так
       (сполучити
         (як-є ())
         (додати-голову-до-кожного-префікса
           (перше елементи)
           (усі-префікси (решта елементи))))))))

(визначити початковий-список-префіксів
  (список (як-є атом?) (як-є решта) (як-є атом?) (як-є сполучити)))
(визначити префікси-прикладу (усі-префікси початковий-список-префіксів))

