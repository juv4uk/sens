; Взяти суфікс від першої вкладеної пари в правильному списку.
; Звичайні атоми й порожні значення пропускаються, решта не змінюється.
; Результат обчислює СЕНС через власні визначення Д3 і Д5.

(визначити суфікс-від-першої-пари
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи))
    (суфікс-від-першої-пари (решта елементи)))
   (так елементи))))

(визначити однакові-дерева-суфікса?
 (функція (лівий правий)
  (за-умовою
   ((атом? лівий)
    (за-умовою
     ((атом? правий) (тотожне? лівий правий))
     (так ні)))
   ((атом? правий) ні)
   ((однакові-дерева-суфікса? (перше лівий) (перше правий))
    (однакові-дерева-суфікса? (решта лівий) (решта правий)))
   (так ні))))

(визначити довести-суфікс
 (функція (елементи очікуваний)
  (за-умовою
   ((однакові-дерева-суфікса?
     (суфікс-від-першої-пари елементи)
     очікуваний)
    (атом? (як-є ())))
   (так (перше (як-є ()))))))

; Атомарне джерело та неправильна відкрита пара не викликають ПЕРШЕ від атома.
; Два живі закони СЕНС, без хостового оракула.
(довести-суфікс (як-є атом?) (як-є ()))
(довести-суфікс
 (сполучити (як-є атом?) (як-є решта)) (як-є ()))

; Порожній та повністю атомний список не містить вкладеної пари.
(довести-суфікс (як-є ()) (як-є ()))
(довести-суфікс
 (список (як-є атом?)) (як-є ()))
(довести-суфікс
 (список (як-є атом?) (як-є решта) (як-є сполучити)) (як-є ()))
(довести-суфікс
 (список (як-є ()) (як-є атом?) (як-є ())) (як-є ()))

; Вкладена пара є першим елементом.
(довести-суфікс
 (список (список (як-є атом?)))
 (список (список (як-є атом?))))
(довести-суфікс
 (список (список (як-є атом?)) (як-є решта))
 (список (список (як-є атом?)) (як-є решта)))
(довести-суфікс
 (список (список (як-є ())) (як-є атом?))
 (список (список (як-є ())) (як-є атом?)))

; Складене значення може початися після довільної послідовності атомів.
(довести-суфікс
 (список (як-є атом?) (список (як-є решта)))
 (список (список (як-є решта))))
(довести-суфікс
 (список (як-є атом?) (як-є решта)
         (список (як-є сполучити)) (як-є тотожне?))
 (список (список (як-є сполучити)) (як-є тотожне?)))
(довести-суфікс
 (список (як-є ()) (як-є решта)
         (список (як-є ())) (список (як-є атом?)))
 (список (список (як-є ())) (список (як-є атом?))))
(довести-суфікс
 (список (як-є атом?) (список (як-є атом?))
         (список (як-є решта)) (як-є сполучити))
 (список (список (як-є атом?))
         (список (як-є решта)) (як-є сполучити)))
(довести-суфікс
 (список (як-є атом?) (як-є ()) (як-є решта)
         (список (список (як-є тотожне?))) (як-є сполучити))
 (список (список (список (як-є тотожне?))) (як-є сполучити)))

; Негативні випадки забороняють загубити пару або залишити префікс.
(за-умовою
 ((хибне? (однакові-дерева-суфікса?
   (суфікс-від-першої-пари
    (список (як-є атом?) (список (як-є решта))))
   (як-є ())))
  (атом? (як-є ())))
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (однакові-дерева-суфікса?
   (суфікс-від-першої-пари
    (список (як-є атом?) (список (як-є решта))))
   (список (як-є атом?) (список (як-є решта)))))
  (атом? (як-є ())))
 (так (перше (як-є ()))))

(атом? (як-є ()))
