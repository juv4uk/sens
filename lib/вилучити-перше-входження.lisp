; Рекурсивне вилучення лише ПЕРШОГО входження з власного списку.
; Друге входження зберігається. Лише ратифіковані Д3/Д4/Д5 закони.
(визначити вилучити-перше-входження
  (функція (значення елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((тотожне? (перше елементи) значення) (решта елементи))
      ((атом? (як-є ()))
       (сполучити (перше елементи)
         (вилучити-перше-входження значення (решта елементи)))))))

(визначити початковий-список
  (список (як-є атом?) (як-є решта) (як-є сполучити)
          (як-є решта) (як-є тотожне?)))
(визначити після-вилучення
  (вилучити-перше-входження (як-є решта) початковий-список))
(визначити без-збігу
  (вилучити-перше-входження (як-є порожній?) початковий-список))
(визначити вилучена-голова
  (вилучити-перше-входження (як-є атом?) початковий-список))

; Нативне Д1-свідчення порядку, відсутності, порожнього базису і негативу.
(за-умовою
  ((тотожне? (перше після-вилучення) (як-є атом?))
    (за-умовою
  ((тотожне? (друге після-вилучення) (як-є сполучити))
    (за-умовою
  ((тотожне? (третє після-вилучення) (як-є решта))
    (за-умовою
  ((тотожне? (перше (решта (решта (решта після-вилучення)))) (як-є тотожне?))
    (за-умовою
  ((атом? (решта (решта (решта (решта після-вилучення)))))
    (за-умовою
  ((хибне? (тотожне? (друге після-вилучення) (як-є решта)))
    (за-умовою
  ((тотожне? (перше без-збігу) (як-є атом?))
    (за-умовою
  ((тотожне? (друге без-збігу) (як-є решта))
    (за-умовою
  ((тотожне? (третє без-збігу) (як-є сполучити))
    (за-умовою
  ((тотожне? (перше вилучена-голова) (як-є решта))
    (за-умовою
  ((тотожне? (друге вилучена-голова) (як-є сполучити))
    (за-умовою
  ((порожній? (вилучити-перше-входження (як-є решта) (як-є ())))
    (за-умовою
  ((порожній? (вилучити-перше-входження (як-є решта) (список (як-є решта))))
    (атом? (як-є ())))
