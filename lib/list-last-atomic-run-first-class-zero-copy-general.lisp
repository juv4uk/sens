; СЕНС: останній суцільний пробіг атомів без копіювання пар.
; Повертає початковий суфікс ОСТАННЬОГО пробігу, а не новий список.
; Один обхід, жодного числового проміжного значення чи Unicode-коду.
; Критерій — першокласне значення точного Д3 АТОМ?, передане в Д5 замикання.

(визначити суфікс-останнього-пробігу-далі
  (функція (елементи критерій початок-пробігу знайдений-суфікс)
    (за-умовою
      ((атом? елементи) знайдений-суфікс)
      ((критерій (перше елементи))
       (за-умовою
         ((атом? початок-пробігу)
          (суфікс-останнього-пробігу-далі
            (решта елементи) критерій елементи елементи))
         (так
          (суфікс-останнього-пробігу-далі
            (решта елементи) критерій початок-пробігу знайдений-суфікс))))
      (так
       (суфікс-останнього-пробігу-далі
         (решта елементи) критерій (як-є ()) знайдений-суфікс)))))

(визначити суфікс-останнього-атомного-пробігу
  (функція (елементи)
    (суфікс-останнього-пробігу-далі
      елементи атом? (як-є ()) (як-є ()))))

; Позитивний SENS-закон: другий пробіг (в г) починається ПІСЛЯ
; вкладеної пари та ПЕРЕД останньою вкладеною парою.
; Немає обходу через Python/JSON або підміни поверненого хвоста.
(за-умовою
  ((тотожне?
     (перше
       (суфікс-останнього-атомного-пробігу
         (список
           (як-є а)
           (список (як-є б))
           (як-є в)
           (як-є г)
           (список (як-є д)))))
     (як-є в))
   (за-умовою
     ((тотожне?
        (друге
          (суфікс-останнього-атомного-пробігу
            (список
              (як-є а)
              (список (як-є б))
              (як-є в)
              (як-є г)
              (список (як-є д)))))
        (як-є г)) так)
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))

; Негативний край: якщо атомів немає, реальний Д3 NIL порожній.
(за-умовою
  ((порожній?
     (суфікс-останнього-атомного-пробігу
       (список (список (як-є а)) (список (як-є б))))) так)
  (так (перше (як-є ()))))

; Самостійний виконуваний результат — точне Д1:1, не просто DEFINE.
(за-умовою
  ((тотожне?
     (перше
       (суфікс-останнього-атомного-пробігу
         (список (як-є а) (список (як-є б)) (як-є в))))
     (як-є в)) так)
  (так (перше (як-є ()))))
