; СЕНС: останній суцільний пробіг атомів без копіювання пар.
; Повертає початковий суфікс ОСТАННЬОГО пробігу, а не новий список.
; Один обхід; усі цитовані атоми - чинні точні коди Д3/Д5, а не Д7-текст.
; Критерій - першокласне значення точного Д3 АТОМ?, передане в Д5 замикання.

(визначити суфікс-останнього-пробігу-далі
  (функція (елементи критерій початок-пробігу знайдений-суфікс)
    (за-умовою
      ((порожній? елементи) знайдений-суфікс)
      ((атом? елементи) (перше (як-є ())))
      ((критерій (перше елементи))
       (за-умовою
         ((порожній? початок-пробігу)
          (суфікс-останнього-пробігу-далі
            (решта елементи) критерій елементи елементи))
         (так
          (суфікс-останнього-пробігу-далі
            (решта елементи) критерій початок-пробігу знайдений-суфікс))))
      (так
       (суфікс-останнього-пробігу-далі
         (решта елементи) критерій (як-є ()) знайдений-суфікс)))))

(визначити суфікс-останнього-атомного-пробігу
  (функція (елементи)
    (суфікс-останнього-пробігу-далі
      елементи атом? (як-є ()) (як-є ()))))

; Позитивний СЕНС-закон: другий пробіг (СПОЛУЧИТИ ТОТОЖНЕ?) починається ПІСЛЯ
; вкладеної пари та ПЕРЕД останньою вкладеною парою.
; Немає обходу через сторонній обчислювач або підміни поверненого хвоста.
(за-умовою
  ((тотожне?
     (перше
       (суфікс-останнього-атомного-пробігу
         (список
           (як-є атом?)
           (список (як-є решта))
           (як-є сполучити)
           (як-є тотожне?)
           (список (як-є функція)))))
     (як-є сполучити))
   (за-умовою
     ((тотожне?
        (друге
          (суфікс-останнього-атомного-пробігу
            (список
              (як-є атом?)
              (список (як-є решта))
              (як-є сполучити)
              (як-є тотожне?)
              (список (як-є функція)))))
        (як-є тотожне?)) так)
     (так (перше (як-є ())))))
  (так (перше (як-є ()))))

; Негативний край: якщо атомів немає, реальний Д3 порожній об'єкт порожній.
(за-умовою
  ((порожній?
     (суфікс-останнього-атомного-пробігу
       (список (список (як-є атом?)) (список (як-є решта))))) так)
  (так (перше (як-є ()))))

; Самостійний виконуваний результат - точне Д1:1, не просто ВИЗНАЧИТИ.
(за-умовою
  ((тотожне?
     (перше
       (суфікс-останнього-атомного-пробігу
         (список (як-є атом?) (список (як-є решта)) (як-є сполучити))))
     (як-є сполучити)) так)
  (так (перше (як-є ()))))
; Першокласний Д3 предикат: D1:ні може бути ЕЛЕМЕНТОМ,
; але не може бути кінцевим хвостом Д3-списку.
(за-умовою
  ((тотожне?
     (перше
       (суфікс-останнього-атомного-пробігу
         (список (список (як-є атом?)) ні (як-є решта))))
     ні)
   так)
  (так (перше (як-є ()))))
