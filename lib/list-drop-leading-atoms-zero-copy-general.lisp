; СЕНС Д3–Д5: відкинути послідовність початкових атомних елементів.
; Єдиний лінійний обхід до першого складеного елемента, нуль нових пар.
; Повертаємо саму початкову хвостову структуру, а не її копію.
; Неправильний відкритий хвіст зберігаємо як дані, не викликаємо решта від атома.
(визначити хвіст-після-початкових-атомів
  (функція (ланки-списку)
    (за-умовою
      ((атом? ланки-списку) ланки-списку)
      ((атом? (перше ланки-списку))
       (хвіст-після-початкових-атомів (решта ланки-списку)))
      (так ланки-списку))))

; Реальні позитивні та негативні Д1 свідки — перевіряє виконавець СЕНС.
; Якщо будь-який закон хибний, відбудеться недопустиме (перше ()).
(за-умовою
  ((порожній? (хвіст-після-початкових-атомів (як-є ()))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (хвіст-після-початкових-атомів
                (список (як-є атом?) (як-є решта) (як-є атом?)))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (перше
                 (хвіст-після-початкових-атомів
                   (список (як-є атом?)
                           (список (як-є решта))
                           (як-є сполучити)))))
               (як-є решта)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (друге
                (хвіст-після-початкових-атомів
                  (список (як-є атом?)
                          (список (як-є решта))
                          (як-є сполучити))))
               (як-є сполучити)) так)
  (так (перше (як-є ()))))
; Перший елемент вже складений — не втрачати його та решту.
(за-умовою
  ((тотожне? (перше (перше
                (хвіст-після-початкових-атомів
                  (список (список (як-є атом?)) (як-є решта)))))
                (як-є атом?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (друге
                (хвіст-після-початкових-атомів
                  (список (список (як-є атом?)) (як-є решта))))
               (як-є решта)) так)
  (так (перше (як-є ()))))
; Порожній список як ЕЛЕМЕНТ теж атом і має бути пропущений.
(за-умовою
  ((тотожне? (перше (перше
                 (хвіст-після-початкових-атомів
                   (список (як-є ())
                           (список (як-є сполучити))))))
               (як-є сполучити)) так)
  (так (перше (як-є ()))))
; Відкритий атомний хвіст не втрачається і не викликає car/cdr помилки.
(за-умовою
  ((тотожне?
     (хвіст-після-початкових-атомів
       (сполучити (як-є атом?) (як-є решта)))
     (як-є решта)) так)
  (так (перше (як-є ()))))
; Негатив: повернення першого атома замість першої складеної ланки є помилкою.
(за-умовою
  ((хибне?
     (атом?
       (перше
         (хвіст-після-початкових-атомів
           (список (як-є атом?) (список (як-є решта))))))) так)
  (так (перше (як-є ()))))
(атом? (як-є ()))
