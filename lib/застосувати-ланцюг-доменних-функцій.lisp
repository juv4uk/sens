; Композиція довільної кількості першокласних функцій чинних доменів СЕНС.
; Коди — правильний список справжніх функціональних значень, не назви в D7
; і не історичні байти SID8/Sens8. Кожна дія отримує результат попередньої.
; Порожній ланцюг — тотожне відображення; додаткових CONS-пар не створюємо.
; Виконання визначає тільки обчислювач СЕНС; Zig/T5M — фізичний носій.

(визначити застосувати-ланцюг-доменних-функцій
  (функція (коди значення)
    (за-умовою
      ((порожній? коди) значення)
      (так
       (нехай ((дія (перше коди)))
         (застосувати-ланцюг-доменних-функцій
           (решта коди)
           (дія значення)))))))

; Д3: РЕШТА, потім ПЕРШЕ -> другий елемент.
(за-умовою
  ((тотожне?
     (застосувати-ланцюг-доменних-функцій
       (список решта перше)
       (список (як-є атом?) (як-є решта) (як-є сполучити)))
     (як-є решта)) так)
  (так (перше (як-є ()))))

; Три першокласні доменні дії: третій елемент.
(за-умовою
  ((тотожне?
     (застосувати-ланцюг-доменних-функцій
       (список решта решта перше)
       (список (як-є атом?) (як-є решта) (як-є сполучити)))
     (як-є сполучити)) так)
  (так (перше (як-є ()))))

; Порожня композиція нічого не робить навіть з атомом.
(за-умовою
  ((тотожне?
     (застосувати-ланцюг-доменних-функцій
       (як-є ()) (як-є атом?))
     (як-є атом?)) так)
  (так (перше (як-є ()))))

; Негатив: одна дія ПЕРШЕ не може дати другий елемент.
(за-умовою
  ((хибне?
     (тотожне?
       (застосувати-ланцюг-доменних-функцій
         (список перше)
         (список (як-є атом?) (як-є решта)))
       (як-є решта))) так)
  (так (перше (як-є ()))))

; Завершальний D1-позитив від реального СЕНС, не від host-тесту.
(атом? (як-є ()))
