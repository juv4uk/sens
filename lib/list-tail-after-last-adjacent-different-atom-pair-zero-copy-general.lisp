; СЕНС: суфікс ПІСЛЯ останньої пари суміжних різних атомів.
; Один прохід O(n), жодної нової пари у функції — повертається наявний хвіст.
; Складені елементи розривають суміжність атомів; () є атомом Д3.
; Немає старих восьмибітових тотожностей: лише точні Д3–Д5 та Д1.

(визначити хвіст-після-останньої-різної-пари-далі
 (функція (залишок знайдений)
  (за-умовою
   ((атом? залишок) знайдений)
   ((атом? (решта залишок)) знайдений)
   ((хибне? (атом? (перше залишок)))
    (хвіст-після-останньої-різної-пари-далі (решта залишок) знайдений))
   ((хибне? (атом? (друге залишок)))
    (хвіст-після-останньої-різної-пари-далі (решта залишок) знайдений))
   ((хибне? (тотожне? (перше залишок) (друге залишок)))
    (хвіст-після-останньої-різної-пари-далі
      (решта залишок) (решта (решта залишок))))
   (так
    (хвіст-після-останньої-різної-пари-далі (решта залишок) знайдений)))))

(визначити хвіст-після-останньої-різної-пари-атомів
 (функція (елементи)
  (хвіст-після-останньої-різної-пари-далі елементи (як-є ()))))

; Структурний оракул реалізовано в самому СЕНС. ТОТОЖНЕ? викликається
; винятково після перевірки атомності обох операндів.
(визначити рівні-хвости-різної-пари?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((рівні-хвости-різної-пари? (перше ліве) (перше праве))
    (рівні-хвости-різної-пари? (решта ліве) (решта праве)))
   (так ні))))

(визначити довести-хвіст-після-різної-пари
 (функція (вхід очікуване)
  (за-умовою
   ((рівні-хвости-різної-пари?
     (хвіст-після-останньої-різної-пари-атомів вхід) очікуване) так)
   (так (перше (як-є ()))))))

; Порожній, один атом, дві однакові позиції та неповна пара.
(довести-хвіст-після-різної-пари (як-є ()) (як-є ()))
(довести-хвіст-після-різної-пари (як-є атом?) (як-є ()))
(довести-хвіст-після-різної-пари
 (сполучити (як-є атом?) (як-є решта)) (як-є ()))
(довести-хвіст-після-різної-пари
 (список (як-є атом?) (як-є атом?)) (як-є ()))
(довести-хвіст-після-різної-пари
 (список (як-є атом?) (як-є решта)) (як-є ()))

; Два різні атоми і потім два однакові: повернути вихідні дві пари,
; а не першу різницю чи скопійований хвіст.
(довести-хвіст-після-різної-пари
 (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є сполучити))
 (список (як-є сполучити)))
(довести-хвіст-після-різної-пари
 (список (як-є атом?) (як-є решта) (як-є сполучити)
         (як-є сполучити) (як-є сполучити))
 (список (як-є сполучити) (як-є сполучити)))

; Складені елементи не порівнюються Д3 EQ як атоми.
(довести-хвіст-після-різної-пари
 (список (як-є атом?) (список (як-є решта))
         (як-є сполучити) (як-є сполучити))
 (як-є ()))
(довести-хвіст-після-різної-пари
 (список (як-є ()) (як-є решта) (як-є решта))
 (список (як-є решта)))

; Негативний свідок: не повертати суфікс від самої пари.
(за-умовою
 ((хибне? (рівні-хвости-різної-пари?
   (хвіст-після-останньої-різної-пари-атомів
    (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є сполучити)))
   (список (як-є решта) (як-є сполучити) (як-є сполучити)))) так)
 (так (перше (як-є ()))))

; Самостійний кінцевий результат — справжній Д1.
(атом? (як-є ()))
