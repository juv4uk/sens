; СЕНС Д3 і Д5: хвіст після другого складеного елемента правильного списку.
; Один прохід О(н), без проміжних списків і без сполучити.
; Різниця між атомом () та складеною парою (()) зберігається.
(визначити хвіст-після-наступної-пари
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-наступної-пари (решта елементи)))
   (так (решта елементи)))))

(визначити хвіст-після-другої-пари
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-другої-пари (решта елементи)))
   (так (хвіст-після-наступної-пари (решта елементи))))))

; Перевірки нативним СЕНС: помилка негайно стає перше порожнього списку.
(за-умовою
 ((порожній? (хвіст-після-другої-пари (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-другої-пари
   (список (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-другої-пари
   (список (список (як-є атом?)) (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-другої-пари
   (список (список (як-є атом?)) (список (як-є решта))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (перше (хвіст-після-другої-пари
     (список (список (як-є атом?)) (як-є решта)
             (список (як-є сполучити)) (як-є визначити))))
   (як-є визначити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (перше (хвіст-після-другої-пари
     (список (як-є ()) (список (як-є атом?))
             (як-є решта) (список (як-є сполучити))
             (як-є тотожне?) (список (як-є функція)))))
   (як-є тотожне?)) так)
 (так (перше (як-є ()))))
; Третю вкладену пару НЕ вважаємо другою, зберігаємо її у хвості.
(за-умовою
 ((хибне?
   (атом? (перше (хвіст-після-другої-пари
      (список (список (як-є атом?))
              (список (як-є решта))
              (список (як-є сполучити))))))) так)
 (так (перше (як-є ()))))
; Негативний свідок: префікс до другої пари не може лишитися у хвості.
(за-умовою
 ((хибне?
   (тотожне?
    (перше (хвіст-після-другої-пари
      (список (як-є атом?) (список (як-є решта))
              (список (як-є сполучити)) (як-є функція))))
    (як-є атом?))) так)
 (так (перше (як-є ()))))
(атом? (як-є ()))
