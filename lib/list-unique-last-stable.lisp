; Лишити останнє входження кожного атома у правильному скінченному списку.
; Закон Д3/Д5: викинути поточний атом, якщо той самий атом ще є у хвості.
; На виході зберігається початковий порядок саме останніх входжень.
; Виконує SENS, Zig/T5M лише транспортує точну двійкову програму.
(визначити є-далі-атом?
  (функція (шуканий хвіст)
    (за-умовою
      ((атом? хвіст) ні)
      ((тотожне? шуканий (перше хвіст)) так)
      ((атом? (як-є ())) (є-далі-атом? шуканий (решта хвіст))))))

(визначити залишити-останні-входження
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((є-далі-атом? (перше елементи) (решта елементи))
       (залишити-останні-входження (решта елементи)))
      ((атом? (як-є ()))
       (сполучити
         (перше елементи)
         (залишити-останні-входження (решта елементи)))))))

; А Б А В Б Г В Д -> А Б Г В Д, не перші входження.
(визначити початкові-вісім
  (список (як-є атом?) (як-є решта) (як-є атом?)
          (як-є сполучити) (як-є решта) (як-є тотожне?)
          (як-є сполучити) (як-є порожній?)))
(визначити останні-п'ять (залишити-останні-входження початкові-вісім))
(визначити остання-одна
  (залишити-останні-входження
    (список (як-є атом?) (як-є атом?) (як-є атом?))))
(визначити усі-різні
  (залишити-останні-входження
    (список (як-є атом?) (як-є решта) (як-є сполучити))))
(визначити чергування
  (залишити-останні-входження
    (список (як-є атом?) (як-є решта) (як-є атом?) (як-є решта))))

; 23 живих позитивних/негативних свідків: кожен провал спричиняє
; помилку SENS через недопустиме (перше (як-є ())), не хостове assert.
(за-умовою
  (((тотожне? (перше останні-п'ять) (як-є атом?)))
   (за-умовою
     (((тотожне? (друге останні-п'ять) (як-є решта)))
      (за-умовою
        (((тотожне? (третє останні-п'ять) (як-є тотожне?)))
         (за-умовою
           (((тотожне? (перше (решта (решта (решта останні-п'ять)))) (як-є сполучити)))
            (за-умовою
              (((тотожне? (перше (решта (решта (решта (решта останні-п'ять))))) (як-є порожній?)))
               (за-умовою
                 (((порожній? (решта (решта (решта (решта (решта останні-п'ять)))))))
                  (за-умовою
                    (((порожній? (залишити-останні-входження (як-є ()))))
                     (за-умовою
                       (((тотожне? (перше (залишити-останні-входження (список (як-є атом?)))) (як-є атом?)))
                        (за-умовою
                          (((порожній? (решта (залишити-останні-входження (список (як-є атом?))))))
                           (за-умовою
                             (((тотожне? (перше остання-одна) (як-є атом?)))
                              (за-умовою
                                (((порожній? (решта остання-одна)))
                                 (за-умовою
                                   (((тотожне? (перше усі-різні) (як-є атом?)))
                                    (за-умовою
                                      (((тотожне? (друге усі-різні) (як-є решта)))
                                       (за-умовою
                                         (((тотожне? (третє усі-різні) (як-є сполучити)))
                                          (за-умовою
                                            (((порожній? (решта (решта (решта усі-різні)))))
                                             (за-умовою
                                               (((тотожне? (перше чергування) (як-є атом?)))
                                                (за-умовою
                                                  (((тотожне? (друге чергування) (як-є решта)))
                                                   (за-умовою
                                                     (((порожній? (решта (решта чергування))))
                                                      (за-умовою
                                                        (((хибне? (є-далі-атом? (як-є тотожне?) (як-є ()))))
                                                         (за-умовою
                                                           (((є-далі-атом? (як-є атом?) (список (як-є решта) (як-є атом?))))
                                                            (за-умовою
                                                              (((хибне? (є-далі-атом? (як-є сполучити) (список (як-є атом?) (як-є решта)))))
                                                               (за-умовою
                                                                 (((хибне? (тотожне? (третє останні-п'ять) (як-є сполучити))))
                                                                  (за-умовою
                                                                    (((хибне? (тотожне? (друге чергування) (як-є атом?))))
                                                                     (атом? (як-є ())))
                                                                    ((атом? (як-є ())) (перше (як-є ())))))
                                                                 ((атом? (як-є ())) (перше (як-є ())))))
                                                              ((атом? (як-є ())) (перше (як-є ())))))
                                                           ((атом? (як-є ())) (перше (як-є ())))))
                                                        ((атом? (як-є ())) (перше (як-є ())))))
                                                     ((атом? (як-є ())) (перше (як-є ())))))
                                                  ((атом? (як-є ())) (перше (як-є ())))))
                                               ((атом? (як-є ())) (перше (як-є ())))))
                                            ((атом? (як-є ())) (перше (як-є ())))))
                                         ((атом? (як-є ())) (перше (як-є ())))))
                                      ((атом? (як-є ())) (перше (як-є ())))))
                                   ((атом? (як-є ())) (перше (як-є ())))))
                                ((атом? (як-є ())) (перше (як-є ())))))
                             ((атом? (як-є ())) (перше (як-є ())))))
                          ((атом? (як-є ())) (перше (як-є ())))))
                       ((атом? (як-є ())) (перше (як-є ())))))
                    ((атом? (як-є ())) (перше (як-є ())))))
                 ((атом? (як-є ())) (перше (як-є ())))))
              ((атом? (як-є ())) (перше (як-є ())))))
           ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
