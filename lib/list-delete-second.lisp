; Вилучити другий елемент зі списку, залишивши порядок інших.
; Закон Д3 і Д4: (а б в г)  до  (а в г). Вхід має два чи більше елементів.
; Тотожність решти-решти зберігається без текстового перекодування.
(визначити вилучити-другий
  (функція (елементи)
    (сполучити (перше елементи) (решта-решти елементи))))

(визначити початкова-четвірка
  (список (як-є атом?) (як-є сполучити) (як-є решта) (як-є тотожне?)))
(визначити трійка-без-другого
  (вилучити-другий початкова-четвірка))

; Нативний Д1: перше, друге і третє зберігають порядок,
; відновлення вилученого другого і негатив проти залишеного елемента.
(за-умовою
  ((тотожне? (перше трійка-без-другого) (як-є атом?))
   (за-умовою
     ((тотожне? (друге трійка-без-другого) (як-є решта))
      (за-умовою
        ((тотожне?
           (перше (решта-решти трійка-без-другого))
           (як-є тотожне?))
         (за-умовою
           ((тотожне?
              (друге
                (сполучити
                  (перше трійка-без-другого)
                  (сполучити
                    (друге початкова-четвірка)
                    (решта трійка-без-другого))))
              (друге початкова-четвірка))
            (хибне? (тотожне? (друге трійка-без-другого) (як-є сполучити))))
           ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))

; Структурне збереження хвоста після вилучення другого елемента.
(за-умовою
  ((тотожне? (перше (решта трійка-без-другого))
              (перше (решта-решти початкова-четвірка)))
   (хибне? (атом? (решта трійка-без-другого))))
  ((атом? (як-є ())) (перше (як-є ()))))

; Зворотне вставлення попереднього другого елемента повинно
; повернути і четвертий, не пересуваючи чи підміняючи хвіст.
(визначити відновлена-четвірка
  (сполучити (перше трійка-без-другого)
    (сполучити (друге початкова-четвірка)
      (решта трійка-без-другого))))
(за-умовою
  ((тотожне?
     (друге (решта-решти відновлена-четвірка))
     (друге (решта-решти початкова-четвірка)))
   (хибне? (тотожне? (друге трійка-без-другого)
                     (друге початкова-четвірка))))
  ((атом? (як-є ())) (перше (як-є ()))))
