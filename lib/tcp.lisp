; Мовна політика текстових з'єднань і публічної адреси слухання.
; Зовнішній виконавець забезпечує лише сокети та обмін байтами.
; Декодування й кодування належить мовному модулю Юнікоду.
; Точна позначка успішного декодування зберігається в ньому.
; Звичайне слухання приймає з'єднання на всіх адресах четвертої версії.
; Виклики за адресою використовують окрему функцію нижче.
; Залежність від бібліотеки кодування має бути завантажена раніше.

(визначити протокол-передавання-слухати-на
  (функція (вхідна-адреса мережевий-порт)
    (tcp-listen-raw вхідна-адреса мережевий-порт)))

(визначити протокол-передавання-слухати
  (функція (мережевий-порт)
    (протокол-передавання-слухати-на "0.0.0.0" мережевий-порт)))

(визначити протокол-передавання-читати-байти-текст
  (функція (вхідні-байти)
    ((функція (декодований-вміст)
       (за-умовою
         ((успішно-декодовано? декодований-вміст)
          (друге декодований-вміст))
         (так
          декодований-вміст)))
     (кодування-юнікод-8-декодувати-рядок вхідні-байти))))

(визначити протокол-передавання-читати
  (функція (мережеве-підключення)
    (протокол-передавання-читати-байти-текст (tcp-read-raw мережеве-підключення))))

(визначити протокол-передавання-записати-текст-байти
  (функція (вхідний-текст)
    (кодування-юнікод-8-кодувати-рядок вхідний-текст)))

; Після успішного запису повертаємо початковий текст.
; Це зберігає публічний результат, не передаючи зовнішньому виконавцю
; рішення про мовне кодування.
(визначити протокол-передавання-записати-через-сирий
  (функція (мережеве-підключення вхідний-текст)
    ((функція (записано-байтів) вхідний-текст)
     (tcp-write-raw мережеве-підключення (протокол-передавання-записати-текст-байти вхідний-текст)))))

(визначити протокол-передавання-записати
  (функція (мережеве-підключення вхідний-текст)
    (протокол-передавання-записати-через-сирий мережеве-підключення вхідний-текст)))

; Публічні поверхні прив'язуються після створення мовних функцій.
; Жодного дублювання виконавця або старого джерела семантики.
