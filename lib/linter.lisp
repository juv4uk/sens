; Аналізатор дерев СЕНС перевіряє розмір, вкладеність,
; складність, глобальні змінні та побічні ефекти.
; Історичну перевірку порожнього списку з восьмого домену
; замінено лише доведеним законом порожнечі четвертого домену.
; Порівняння викличної голови виконує захищена тотожність третього домену.
; Інші структурні порівняння восьмого домену мають власну тотожність.
; Історичне восьмибітне кодування не ототожнюється з третім доменом.
; Вердикти першого домену мають точні значення лінтер-число-один і 0.
; Складену пару не передають предикату атомарної тотожності.
; Гілки умовного вибору мають рівно по два поля.
; Ширина входить до тотожності, усі назви використовують повну проєкцію.
; Виконавчий свідок зберігається в окремому файлі перевірок.
; Українські голови розпізнаємо без втрати сумісності зі старими цитованими формами.

;; Голова форми для розпізнавання.
(визначити лінтер-число-нуль (довжина (як-є ())))
(визначити лінтер-число-один (довжина (як-є (а))))
(визначити лінтер-число-десять (довжина (як-є (а б в г ґ д е є ж з))))
(визначити лінтер-число-сто (помножити лінтер-число-десять лінтер-число-десять))
(визначити лінтер-число-тисяча (помножити лінтер-число-сто лінтер-число-десять))
(визначити лінтер-число-сто-тисяч (помножити лінтер-число-сто лінтер-число-тисяча))
(визначити лінтер-межа-за-замовчуванням (відняти лінтер-число-сто-тисяч лінтер-число-один))

(визначити аналіз-форма-голова
  (функція (дерево)
    (за-умовою
      ; Атом (зокрема порожній список D1) не має хвоста для аналізу.
      ; Спершу перевіряємо D3 ATOM, потім читаємо CAR/CDR лише пари.
      ((атом? дерево) (аналіз-голова дерево))
      ((атом? (решта дерево))
       (за-умовою
         ; Після ATOM? хвоста другий CDR був би зверненням до атома.
         ; Порожній хвіст одноелементного списку порівнюємо D3 EQ.
         ((тотожне? (решта дерево) (як-є ())) (аналіз-голова (перше дерево)))
         ((атом? (як-є ())) (лінтер-коротка-голова (перше дерево)))))
      ((атом? (як-є ())) (перше дерево)))))

(визначити лінтер-коротка-голова
  (функція (голова)
    (за-умовою
      ((хибне? (атом? голова)) голова)
      ((однакові? голова (як-є як-є)) (як-є як-є))
      ((однакові? голова (як-є за-умовою)) (як-є за-умовою))
      ((атом? (як-є ())) голова))))

(визначити аналіз-голова
  (функція (голова)
    (за-умовою
      ((хибне? (атом? голова)) голова)
      ((однакові? голова (як-є визначити)) (як-є визначити))
      ((однакові? голова (як-є функція)) (як-є функція))
      ((однакові? голова (як-є за-умовою)) (як-є за-умовою))
      ((однакові? голова (як-є як-є)) (як-є як-є))
      ((однакові? голова (як-є нехай)) (як-є нехай))
      ((однакові? голова (як-є нехай-послідовно)) (як-є нехай-послідовно))
      ((атом? (як-є ())) голова))))

(визначити лінтер-максимум-двох
  (функція (перше-значення друге-значення)
    (за-умовою
      ((більше? перше-значення друге-значення) перше-значення)
      ((атом? (як-є ())) друге-значення))))

(визначити аналіз-розмір
  (функція (дерево)
    (за-умовою
      ((атом? дерево) лінтер-число-один)
      ((атом? (як-є ()))
       (додати лінтер-число-один (додати (аналіз-розмір (перше дерево)) (аналіз-розмір (решта дерево))))))))

(визначити аналіз-вкладеність
  (функція (дерево)
    (за-умовою
      ((атом? дерево) лінтер-число-нуль)
      ((атом? (як-є ()))
       (лінтер-максимум-двох (додати лінтер-число-один (аналіз-вкладеність (перше дерево)))
                  (аналіз-вкладеність (решта дерево)))))))

(визначити аналіз-складність
  (функція (дерево)
    (за-умовою
      ((атом? дерево) лінтер-число-нуль)
      ; Цитовані дерева — дані D3 QUOTE, не виконувані гілки.
      ; Не додаємо їх до кількості умов у програмі.
      ((за-умовою
         ((атом? (аналіз-форма-голова дерево))
          (за-умовою
            ((однакові? (аналіз-форма-голова дерево) (як-є як-є))
             (атом? (як-є ())))
            ((однакові? (аналіз-форма-голова дерево) (як-є як-є))
             (атом? (як-є ())))
            ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
         ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
       лінтер-число-нуль)
      ((за-умовою
         ((атом? (аналіз-форма-голова дерево))
          (за-умовою
            ((однакові? (аналіз-форма-голова дерево) (як-є за-умовою)) (атом? (як-є ())))
            ((однакові? (аналіз-форма-голова дерево) (як-є за-умовою)) (атом? (як-є ())))
            ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
         ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
       (згорнути (функція (накопичення умова) (додати накопичення (аналіз-складність умова)))
               (довжина (решта дерево))
               (решта дерево)))
      ((атом? (як-є ()))
       (додати (аналіз-складність (перше дерево))
              (аналіз-складність (решта дерево)))))))

; Побічні дії розпізнаємо за чинними українськими викличними іменами.
; Незмінне конструювання світів і логічний висновок самі по собі не є ефектами.
; Англійські назви попередньої реалізації не визначають нової семантики.
(визначити лінтер-примітиви-з-ефектами
  (як-є (друкувати показати читати-файл записати-файл
         процес-запустити процес-запустити-текст повідомити-знання)))

; Цитовані форми — дані, тому виклики всередині них не мають побічних дій.
; Враховуємо українську форму Д3:001 та історичну форму в читаному корпусі.
(визначити аналіз-ефекти
  (функція (дерево)
    (за-умовою
      ((атом? дерево) (як-є ()))
      ((символ? (перше дерево))
       (за-умовою
         ((однакові? (перше дерево) (як-є як-є)) (як-є ()))
         ((однакові? (перше дерево) (як-є як-є)) (як-є ()))
         ((значення-у-списку? (перше дерево) лінтер-примітиви-з-ефектами)
          (сполучити дерево (аналіз-ефекти (решта дерево))))
         ((атом? (як-є ()))
          (приєднати (аналіз-ефекти (перше дерево)) (аналіз-ефекти (решта дерево))))))
      ((атом? (як-є ()))
       (приєднати (аналіз-ефекти (перше дерево)) (аналіз-ефекти (решта дерево)))))))

; Повна форма: голова, зв'язування, тіло. Наявні два послідовні
; перевірні стани не можуть затіняти роботу з лексичним оточенням.
(визначити зібрати-вільні-змінні-з-послідовного-зв'язування
  (функція (дерево звязані-змінні)
    (за-умовою
      ((атом? (решта дерево))
       (приєднати (зібрати-вільні-змінні (перше дерево) звязані-змінні)
             (зібрати-вільні-змінні (решта дерево) звязані-змінні)))
      ((атом? (решта (решта дерево)))
       (приєднати (зібрати-вільні-змінні (перше дерево) звязані-змінні)
             (зібрати-вільні-змінні (решта дерево) звязані-змінні)))
      ((атом? (як-є ()))
       (нехай ((привязки (перше (решта дерево)))
              (тіло (перше (решта (решта дерево)))))
         (за-умовою
           ((порожній? привязки)
            (зібрати-вільні-змінні тіло звязані-змінні))
           ((атом? (як-є ()))
            ((функція (привязка)
               (приєднати
                (зібрати-вільні-змінні (друге привязка) звязані-змінні)
                (зібрати-вільні-змінні-з-послідовного-зв'язування
                  (список (як-є нехай-послідовно) (решта привязки) тіло)
                  (сполучити (перше привязка) звязані-змінні))))
             (перше привязки)))))))))

; Для рекурсивної групи всі імена доступні в усіх правих частинах.
; Переходимо до тіла лише після формування спільного оточення.
(визначити зібрати-вільні-змінні-з-рекурсивного-зв'язування
  (функція (дерево звязані-змінні)
    (за-умовою
      ((атом? (решта дерево))
       (приєднати (зібрати-вільні-змінні (перше дерево) звязані-змінні)
             (зібрати-вільні-змінні (решта дерево) звязані-змінні)))
      ((атом? (решта (решта дерево)))
       (приєднати (зібрати-вільні-змінні (перше дерево) звязані-змінні)
             (зібрати-вільні-змінні (решта дерево) звязані-змінні)))
      ((атом? (як-є ()))
       (нехай ((привязки (перше (решта дерево)))
              (тіло (перше (решта (решта дерево)))))
         (нехай ((усі-імена
                 (відобразити (функція (друге-значення) (перше друге-значення)) привязки)))
           (нехай ((нові-звязані (приєднати усі-імена звязані-змінні)))
             (приєднати
               (згорнути приєднати (як-є ())
                       (відобразити (функція (друге-значення)
                              (зібрати-вільні-змінні (друге друге-значення) нові-звязані))
                            привязки))
               (зібрати-вільні-змінні тіло нові-звязані)))))))))

(визначити зібрати-вільні-змінні
  (функція (дерево звязані-змінні)
    (за-умовою
      ((атом? дерево)
       (за-умовою
         ((символ? дерево)
          (за-умовою
            ((значення-у-списку? дерево звязані-змінні) (як-є ()))
            ((значення-у-списку? дерево
                    (як-є (визначити визначити-макрос функція макрос нехай нехай-послідовно
                          список перше решта сполучити тотожне? однакові? атом? символ?
                          додати відняти помножити поділити частка поділити-націло остача
                          порожній? хибне? так ні)))
             (як-є ()))
            ((атом? (як-є ())) (список дерево))))))
      ((за-умовою
         ((однакові? (аналіз-форма-голова дерево) (як-є як-є)) (атом? (як-є ())))
         ((однакові? (аналіз-форма-голова дерево) (як-є як-є)) (атом? (як-є ())))
         ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
       (як-є ()))
      ((за-умовою
         ((однакові? (аналіз-форма-голова дерево) (як-є визначити)) (атом? (як-є ())))
         ((однакові? (аналіз-форма-голова дерево) (як-є def)) (атом? (як-є ())))
         ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
       (зібрати-вільні-змінні (перше (решта (решта дерево))) звязані-змінні))
      ((за-умовою
         ((однакові? (аналіз-форма-голова дерево) (як-є функція)) (атом? (як-є ())))
         ((однакові? (аналіз-форма-голова дерево) (як-є lambda)) (атом? (як-є ())))
         ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
       (нехай ((параметри (перше (решта дерево)))
              (тіло (перше (решта (решта дерево)))))
         (нехай ((імена-параметрів
                 (за-умовою
                   ((символ? параметри) (список параметри))
                   ((атом? (як-є ()))
                    (відобразити (функція (параметр) параметр) параметри)))))
           (зібрати-вільні-змінні тіло (приєднати імена-параметрів звязані-змінні)))))
      ((за-умовою
         ((однакові? (аналіз-форма-голова дерево) (як-є визначити-макрос)) (атом? (як-є ())))
         ((однакові? (аналіз-форма-голова дерево) (як-є defmacro)) (атом? (як-є ())))
         ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
       (нехай ((параметри (перше (решта (решта дерево))))
              (тіло (перше (решта (решта (решта дерево))))))
         (нехай ((імена-параметрів
                 (за-умовою
                   ((символ? параметри) (список параметри))
                   ((атом? (як-є ()))
                    (відобразити (функція (параметр) параметр) параметри)))))
           (зібрати-вільні-змінні тіло (приєднати імена-параметрів звязані-змінні)))))
      ((за-умовою
         ((однакові? (аналіз-форма-голова дерево) (як-є нехай)) (атом? (як-є ())))
         ((однакові? (аналіз-форма-голова дерево) (як-є let)) (атом? (як-є ())))
         ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
       (за-умовою
         ((атом? (решта дерево))
          (приєднати (зібрати-вільні-змінні (перше дерево) звязані-змінні)
                (зібрати-вільні-змінні (решта дерево) звязані-змінні)))
         ((символ? (перше (решта дерево)))
          (нехай ((імя (перше (решта дерево)))
                 (привязки (перше (решта (решта дерево))))
                 (тіло (перше (решта (решта (решта дерево))))))
            (нехай ((нові-звязані
                    (сполучити імя
                         (приєднати (відобразити (функція (друге-значення) (перше друге-значення)) привязки)
                               звязані-змінні))))
              (приєднати (згорнути приєднати (як-є ())
                           (відобразити (функція (друге-значення)
                                  (зібрати-вільні-змінні (друге друге-значення) звязані-змінні))
                                привязки))
                      (зібрати-вільні-змінні тіло нові-звязані)))))
         ((атом? (як-є ()))
          (нехай ((привязки (перше (решта дерево)))
                 (тіло (перше (решта (решта дерево)))))
            (нехай ((нові-звязані
                    (приєднати (відобразити (функція (друге-значення) (перше друге-значення)) привязки)
                          звязані-змінні)))
              (приєднати (згорнути приєднати (як-є ())
                           (відобразити (функція (друге-значення)
                                  (зібрати-вільні-змінні (друге друге-значення) звязані-змінні))
                                привязки))
                      (зібрати-вільні-змінні тіло нові-звязані)))))))
      ((за-умовою
         ((однакові? (аналіз-форма-голова дерево) (як-є нехай-послідовно)) (атом? (як-є ())))
         ((однакові? (аналіз-форма-голова дерево) (як-є let*)) (атом? (як-є ())))
         ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
       (зібрати-вільні-змінні-з-послідовного-зв'язування дерево звязані-змінні))
      ((однакові? (аналіз-форма-голова дерево) (як-є letrec))
       (зібрати-вільні-змінні-з-рекурсивного-зв'язування дерево звязані-змінні))
      ((атом? (як-є ()))
       (приєднати (зібрати-вільні-змінні (перше дерево) звязані-змінні)
             (зібрати-вільні-змінні (решта дерево) звязані-змінні))))))

(визначити аналіз-глобальні
  (функція (дерево)
    (згорнути
      (функція (унікальні елемент)
        (за-умовою
          ((значення-у-списку? елемент унікальні) унікальні)
          ((атом? (як-є ())) (сполучити елемент унікальні))))
      (як-є ())
      (зібрати-вільні-змінні дерево (як-є ())))))

(визначити аналіз-всі
  (функція (дерево)
    (список (список (як-є size) (аналіз-розмір дерево))
          (список (як-є nesting) (аналіз-вкладеність дерево))
          (список (як-є complexity) (аналіз-складність дерево))
          (список (як-є effects) (аналіз-ефекти дерево))
          (список (як-є free-vars) (аналіз-глобальні дерево)))))

(визначити взяти-межу
  (функція (ключ пороги типова-межа)
    (за-умовою
      ((порожній? пороги) типова-межа)
      ((однакові? (перше (перше пороги)) ключ) (решта (перше пороги)))
      ((атом? (як-є ())) (взяти-межу ключ (решта пороги) типова-межа)))))

(визначити аналіз-перевірити
  (функція (дерево пороги)
    (нехай ((метрики (аналіз-всі дерево)))
      (нехай ((розмір (друге (перше метрики)))
             (вкладеність (друге (друге метрики)))
             (складність (друге (третє метрики)))
             (ефекти (друге (четверте метрики)))
             (глобальні (друге (п'ятий метрики))))
        (приєднати
          (за-умовою ((більше? розмір (взяти-межу (як-є max-size) пороги лінтер-межа-за-замовчуванням))
                (список (список (як-є size-exceeded) розмір))))
          (приєднати
            (за-умовою ((більше? вкладеність (взяти-межу (як-є max-nesting) пороги лінтер-межа-за-замовчуванням))
                  (список (список (як-є nesting-exceeded) вкладеність))))
            (приєднати
              (за-умовою ((більше? складність (взяти-межу (як-є max-complexity) пороги лінтер-межа-за-замовчуванням))
                    (список (список (як-є complexity-exceeded) складність))))
              (приєднати
                (за-умовою ((більше? (довжина глобальні) (взяти-межу (як-є max-globals) пороги лінтер-межа-за-замовчуванням))
                      (список (список (як-є globals-exceeded) глобальні))))
                (за-умовою ((більше? (довжина ефекти) (взяти-межу (як-є max-effects) пороги лінтер-межа-за-замовчуванням))
                      (список (список (як-є effects-exceeded) ефекти))))))))))))

