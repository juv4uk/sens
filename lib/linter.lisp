; lib/linter.lisp — Linter for SENS ASTs.
; Analyzes size, nesting, complexity, globals, and effects.
; Exact migration: list-empty tests D8:11110111 EQUAL -> D4:0101 NULL;
; conditional head match D8:11110111 -> guarded D3:101 EQ.
; Only these proved narrower laws are substituted. Remaining D8 EQUAL calls
; retain their independent D8 identity; no universal SID8-to-D3 coercion.
; Exact D1 verdicts are 1 and 0; a pair is never passed to D3 EQ.
;
; Migrated: COND else (010 ()) → exact D1:1 (010 (001 ())).
; Width is identity. Full surface restored (no truncation).
; Semantic witness: tests/fixtures/linter-d1-witness.lisp

;; Голова форми для розпізнавання.
(визначити lint-form-head
  (функція (дерево)
    (за-умовою
      ((атом? (решта дерево))
       (за-умовою
         ((атом? (решта (решта дерево))) (аналіз-голова (перше дерево)))
         ((атом? (як-є ())) (lint-short-head (перше дерево)))))
      ((атом? (як-є ())) (перше дерево)))))

(визначити lint-short-head
  (функція (голова)
    (за-умовою
      ((хибне? (атом? голова)) голова)
      ((тотожне? голова 001) (як-є quote))
      ((тотожне? голова 110) (як-є cond))
      ((атом? (як-є ())) голова))))

(визначити lint-head
  (функція (голова)
    (за-умовою
      ((хибне? (атом? голова)) голова)
      ((тотожне? голова 0011) (як-є def))
      ((тотожне? голова 0010) (як-є lambda))
      ((тотожне? голова 110) (як-є cond))
      ((тотожне? голова 001) (як-є quote))
      ((тотожне? голова 001000) (як-є let))
      ((тотожне? голова 001001) (як-є let*))
      ((атом? (як-є ())) голова))))

(визначити lint-max2
  (функція (перше-значення друге-значення)
    (за-умовою
      ((більше? перше-значення друге-значення) перше-значення)
      ((атом? (як-є ())) друге-значення))))

(визначити lint-size
  (функція (дерево)
    (за-умовою
      ((атом? дерево) 1)
      ((атом? (як-є ()))
       (додати 1 (додати (аналіз-розмір (перше дерево)) (аналіз-розмір (решта дерево))))))))

(визначити lint-nesting
  (функція (дерево)
    (за-умовою
      ((атом? дерево) 0)
      ((атом? (як-є ()))
       (lint-max2 (додати 1 (аналіз-вкладеність (перше дерево)))
                  (аналіз-вкладеність (решта дерево)))))))

(визначити lint-complexity
  (функція (дерево)
    (за-умовою
      ((атом? дерево) 0)
      ((за-умовою
         ((атом? (аналіз-форма-голова дерево))
          (тотожне? (аналіз-форма-голова дерево) (як-є cond)))
         (так ні))
       (згорнути (функція (накопичення умова) (додати накопичення (аналіз-складність умова)))
               (довжина (решта дерево))
               (решта дерево)))
      ((атом? (як-є ()))
       (додати (аналіз-складність (перше дерево))
              (аналіз-складність (решта дерево)))))))

(визначити effectful-primitives
  (як-є ("print" "write-file" "process-run" "advise" "tell")))

(визначити lint-effects
  (функція (дерево)
    (за-умовою
      ((атом? дерево) (як-є ()))
      ((символ? (перше дерево))
       (за-умовою
         ((значення-у-списку? (символ-у-текст (перше дерево)) effectful-primitives)
          (сполучити дерево (аналіз-ефекти (решта дерево))))
         ((атом? (як-є ()))
          (приєднати (аналіз-ефекти (перше дерево)) (аналіз-ефекти (решта дерево))))))
      ((атом? (як-є ()))
       (приєднати (аналіз-ефекти (перше дерево)) (аналіз-ефекти (решта дерево)))))))

(визначити collect-free-vars-let*
  (функція (дерево звязані-змінні)
    (за-умовою
      ((хибне? (атом? (решта дерево)))
       (приєднати (зібрати-вільні-змінні (перше дерево) звязані-змінні)
             (зібрати-вільні-змінні (решта дерево) звязані-змінні)))
      ((атом? (решта дерево))
       (приєднати (зібрати-вільні-змінні (перше дерево) звязані-змінні)
             (зібрати-вільні-змінні (решта дерево) звязані-змінні)))
      ((хибне? (атом? (решта (решта дерево))))
       (приєднати (зібрати-вільні-змінні (перше дерево) звязані-змінні)
             (зібрати-вільні-змінні (решта дерево) звязані-змінні)))
      ((атом? (решта (решта дерево)))
       (приєднати (зібрати-вільні-змінні (перше дерево) звязані-змінні)
             (зібрати-вільні-змінні (решта дерево) звязані-змінні)))
      ((атом? (як-є ()))
       (нехай ((привязки (перше (решта дерево)))
              (тіло (перше (решта (решта дерево)))))
         (за-умовою
           ((порожній? привязки)
            (зібрати-вільні-змінні тіло звязані-змінні))
           ((атом? (як-є ()))
            ((функція (привязка)
               (приєднати
                (зібрати-вільні-змінні (друге привязка) звязані-змінні)
                (зібрати-вільні-змінні-з-послідовного-зв'язування
                  (список (як-є let*) (решта привязки) тіло)
                  (сполучити (символ-у-текст (перше привязка)) звязані-змінні))))
             (перше привязки)))))))))

(визначити collect-free-vars-letrec
  (функція (дерево звязані-змінні)
    (за-умовою
      ((хибне? (атом? (решта дерево)))
       (приєднати (зібрати-вільні-змінні (перше дерево) звязані-змінні)
             (зібрати-вільні-змінні (решта дерево) звязані-змінні)))
      ((атом? (решта дерево))
       (приєднати (зібрати-вільні-змінні (перше дерево) звязані-змінні)
             (зібрати-вільні-змінні (решта дерево) звязані-змінні)))
      ((хибне? (атом? (решта (решта дерево))))
       (приєднати (зібрати-вільні-змінні (перше дерево) звязані-змінні)
             (зібрати-вільні-змінні (решта дерево) звязані-змінні)))
      ((атом? (решта (решта дерево)))
       (приєднати (зібрати-вільні-змінні (перше дерево) звязані-змінні)
             (зібрати-вільні-змінні (решта дерево) звязані-змінні)))
      ((атом? (як-є ()))
       (нехай ((привязки (перше (решта дерево)))
              (тіло (перше (решта (решта дерево)))))
         (нехай ((усі-імена
                 (відобразити (функція (друге-значення) (символ-у-текст (перше друге-значення))) привязки)))
           (нехай ((нові-звязані (приєднати усі-імена звязані-змінні)))
             (приєднати
               (згорнути append (як-є ())
                       (відобразити (функція (друге-значення)
                              (зібрати-вільні-змінні (друге друге-значення) нові-звязані))
                            привязки))
               (зібрати-вільні-змінні тіло нові-звязані)))))))))

(визначити collect-free-vars
  (функція (дерево звязані-змінні)
    (за-умовою
      ((хибне? (відповідь-не (атом? дерево)))
       (за-умовою
         ((символ? дерево)
          (за-умовою
            ((значення-у-списку? (символ-у-текст дерево) звязані-змінні) (як-є ()))
            ((значення-у-списку? (символ-у-текст дерево)
                    (як-є ("t" "def" "defmacro" "lambda" "let" "let*" "letrec"
                          "cond" "quote" "list" "car" "cdr" "cons" "eq" "atom"
                          "+" "-" "*" "/" "<" ">" "=" "<=" ">=" "print" "read" "eval")))
             (як-є ()))
            ((атом? (як-є ())) (список дерево))))))
      ((однакові? (аналіз-форма-голова дерево) (як-є quote)) (як-є ()))
      ((однакові? (аналіз-форма-голова дерево) (як-є def))
       (зібрати-вільні-змінні (перше (решта (решта дерево))) звязані-змінні))
      ((однакові? (аналіз-форма-голова дерево) (як-є lambda))
       (нехай ((параметри (перше (решта дерево)))
              (тіло (перше (решта (решта дерево)))))
         (нехай ((імена-параметрів
                 (за-умовою
                   ((символ? параметри) (список (символ-у-текст параметри)))
                   ((атом? (як-є ()))
                    (відобразити (функція (параметр) (символ-у-текст параметр)) параметри)))))
           (зібрати-вільні-змінні тіло (приєднати імена-параметрів звязані-змінні)))))
      ((однакові? (аналіз-форма-голова дерево) (як-є defmacro))
       (нехай ((параметри (перше (решта (решта дерево))))
              (тіло (перше (решта (решта (решта дерево))))))
         (нехай ((імена-параметрів
                 (за-умовою
                   ((символ? параметри) (список (символ-у-текст параметри)))
                   ((атом? (як-є ()))
                    (відобразити (функція (параметр) (символ-у-текст параметр)) параметри)))))
           (зібрати-вільні-змінні тіло (приєднати імена-параметрів звязані-змінні)))))
      ((однакові? (аналіз-форма-голова дерево) (як-є let))
       (за-умовою
         ((хибне? (відповідь-не (атом? (решта дерево))))
          (приєднати (зібрати-вільні-змінні (перше дерево) звязані-змінні)
                (зібрати-вільні-змінні (решта дерево) звязані-змінні)))
         ((символ? (перше (решта дерево)))
          (нехай ((імя (символ-у-текст (перше (решта дерево))))
                 (привязки (перше (решта (решта дерево))))
                 (тіло (перше (решта (решта (решта дерево))))))
            (нехай ((нові-звязані
                    (сполучити імя
                         (приєднати (відобразити (функція (друге-значення) (символ-у-текст (перше друге-значення))) привязки)
                               звязані-змінні))))
              (приєднати (згорнути append (як-є ())
                           (відобразити (функція (друге-значення)
                                  (зібрати-вільні-змінні (друге друге-значення) звязані-змінні))
                                привязки))
                      (зібрати-вільні-змінні тіло нові-звязані)))))
         ((атом? (як-є ()))
          (нехай ((привязки (перше (решта дерево)))
                 (тіло (перше (решта (решта дерево)))))
            (нехай ((нові-звязані
                    (приєднати (відобразити (функція (друге-значення) (символ-у-текст (перше друге-значення))) привязки)
                          звязані-змінні)))
              (приєднати (згорнути append (як-є ())
                           (відобразити (функція (друге-значення)
                                  (зібрати-вільні-змінні (друге друге-значення) звязані-змінні))
                                привязки))
                      (зібрати-вільні-змінні тіло нові-звязані)))))))
      ((однакові? (аналіз-форма-голова дерево) (як-є let*))
       (зібрати-вільні-змінні-з-послідовного-зв'язування дерево звязані-змінні))
      ((однакові? (аналіз-форма-голова дерево) (як-є letrec))
       (зібрати-вільні-змінні-з-рекурсивного-зв'язування дерево звязані-змінні))
      ((атом? (як-є ()))
       (приєднати (зібрати-вільні-змінні (перше дерево) звязані-змінні)
             (зібрати-вільні-змінні (решта дерево) звязані-змінні))))))

(визначити lint-globals
  (функція (дерево)
    (згорнути
      (функція (унікальні елемент)
        (за-умовою
          ((значення-у-списку? елемент унікальні) унікальні)
          ((атом? (як-є ())) (сполучити елемент унікальні))))
      (як-є ())
      (зібрати-вільні-змінні дерево (як-є ())))))

(визначити lint-all
  (функція (дерево)
    (список (список (як-є size) (аналіз-розмір дерево))
          (список (як-є nesting) (аналіз-вкладеність дерево))
          (список (як-є complexity) (аналіз-складність дерево))
          (список (як-є effects) (аналіз-ефекти дерево))
          (список (як-є free-vars) (аналіз-глобальні дерево)))))

(визначити get-threshold
  (функція (ключ пороги типова-межа)
    (за-умовою
      ((порожній? пороги) типова-межа)
      ((однакові? (перше (перше пороги)) ключ) (решта (перше пороги)))
      ((атом? (як-є ())) (get-threshold ключ (решта пороги) типова-межа)))))

(визначити lint-check
  (функція (дерево пороги)
    (нехай ((метрики (lint-all дерево)))
      (нехай ((розмір (друге (перше метрики)))
             (вкладеність (друге (друге метрики)))
             (складність (друге (третє метрики)))
             (ефекти (друге (четверте метрики)))
             (глобальні (друге (п'ятий метрики))))
        (приєднати
          (за-умовою ((більше? розмір (get-threshold (як-є max-size) пороги 99999))
                (список (список (як-є size-exceeded) розмір))))
          (приєднати
            (за-умовою ((більше? вкладеність (get-threshold (як-є max-nesting) пороги 99999))
                  (список (список (як-є nesting-exceeded) вкладеність))))
            (приєднати
              (за-умовою ((більше? складність (get-threshold (як-є max-complexity) пороги 99999))
                    (список (список (як-є complexity-exceeded) складність))))
              (приєднати
                (за-умовою ((більше? (довжина глобальні) (get-threshold (як-є max-globals) пороги 99999))
                      (список (список (як-є globals-exceeded) глобальні))))
                (за-умовою ((більше? (довжина ефекти) (get-threshold (як-є max-effects) пороги 99999))
                      (список (список (як-є effects-exceeded) ефекти))))))))))))

