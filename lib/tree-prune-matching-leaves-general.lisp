; СЕНС Д3/Д5: вилучити конкретний атом з усіх рівнів правильного дерева списків.
; Зберігати порядок решти листків і самі вкладені порожні списки.
; Тотожність порівнює тільки атоми; структура D2 і значення належать СЕНС.
; D7 є лише українською людською проєкцією, Zig — лише T5M транспортом.

(визначити прибрати-збіги-у-дереві
  (функція (дерево шукане)
    (за-умовою
      ((порожній? дерево) (як-є ()))
      ((атом? (перше дерево))
       (за-умовою
         ((тотожне? (перше дерево) шукане)
          (прибрати-збіги-у-дереві (решта дерево) шукане))
         (так
          (сполучити (перше дерево)
            (прибрати-збіги-у-дереві (решта дерево) шукане)))))
      (так
       (сполучити
         (прибрати-збіги-у-дереві (перше дерево) шукане)
         (прибрати-збіги-у-дереві (решта дерево) шукане))))))

(визначити перевірити-очищення-дерева
  (функція (умова)
    (за-умовою
      (умова (атом? (як-є ())))
      (так (перше (як-є ()))))))

