; Останній АТОМ, повтор якого стався найпізніше в початковій послідовності.
; Наприклад (а б б в а) дає а: останнє повторне входження а пізніше від б.
; Вкладені неатомні елементи й порожні вузли не вважаємо атомами даних.
; Точний Д3 ЕК викликається тільки для атомів. Д7 - лише людська проєкція.
; Семантика - власна рекурсія Д3 і Д4 і Д5 у СЕНС, фізика - Зіг і Т5М.

(визначити атом-раніше-зустрічався?
  (функція (шукане попередні)
    (за-умовою
      ((порожній? попередні) ні)
      ((тотожне? шукане (перше попередні)) так)
      (так (атом-раніше-зустрічався? шукане (решта попередні))))))

(визначити останній-повторений-атом-обхід
  (функція (елементи бачені останній)
    (за-умовою
      ((порожній? елементи) останній)
      ((порожній? (перше елементи))
       (останній-повторений-атом-обхід (решта елементи) бачені останній))
      ((хибне? (атом? (перше елементи)))
       (останній-повторений-атом-обхід (решта елементи) бачені останній))
      ((атом-раніше-зустрічався? (перше елементи) бачені)
       (останній-повторений-атом-обхід
         (решта елементи) бачені (перше елементи)))
      (так
       (останній-повторений-атом-обхід
         (решта елементи) (сполучити (перше елементи) бачені) останній)))))

