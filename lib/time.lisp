        )
          (грегоріанська-дата-з-числа-днів дні))
      )
        (модульна-остача секунди-юнікс час-число-вісімдесят-шість-тисяч-чотириста))
    )
      (частка-через-подвоєння секунди-юнікс час-число-вісімдесят-шість-тисяч-чотириста))
  ))


