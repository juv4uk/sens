              )
                (відняти дні-ери (додати (помножити час-число-триста-шістдесят-п'ять роки-ери) (відняти (частка-через-подвоєння роки-ери час-число-чотири) (частка-через-подвоєння роки-ери час-число-сто)))))
            )
