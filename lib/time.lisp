       (тлумачити-поля-відповіді-часу
         (друге сирі-дані)
         (перше (решта (решта сирі-дані)))
         (перше (решта (решта (решта сирі-дані))))
         (перше (решта (решта (решта (решта сирі-дані)))))
         (перше (решта (решта (решта (решта (решта сирі-дані))))))))
      ((атом? (як-є ())) сирі-дані)))
)

