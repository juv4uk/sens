            )
          )
         )
       )
      )
      ((хибне? (тотожне? значення-часового-поясу (як-є ())))
       ; Порожній рядок також дозволяє перевірити запасне джерело.
       (за-умовою
         ((рядок-порожній? значення-часового-поясу)
          (за-умовою
            ((тотожне? значення-поясу-з-файлу (як-є ()))
