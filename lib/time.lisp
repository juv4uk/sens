          )
            (частка-через-подвоєння (відняти (додати дні-ери (частка-через-подвоєння дні-ери час-число-тридцять-шість-тисяч-п'ятсот-двадцять-чотири)) (додати (частка-через-подвоєння дні-ери час-число-одна-тисяча-чотириста-шістдесят) (частка-через-подвоєння дні-ери час-число-сто-сорок-шість-тисяч-дев'яносто-шість))) час-число-триста-шістдесят-п'ять))
        )
          (відняти зміщені-дні (помножити ера час-число-сто-сорок-шість-тисяч-дев'яносто-сім)))
