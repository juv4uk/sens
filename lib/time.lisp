            ((атом? (як-є ()))
             (сполучити (як-є accepted) (сполучити вузол (сполучити (відняти секунди-протоколу-часу час-число-два-мільярди-двісті-вісім-мільйонів-дев'ятсот-вісімдесят-вісім-тисяч-вісімсот) (сполучити (наносекунди-з-дробу-мережевого-часу дробова-частина) (як-є ()))))))))
