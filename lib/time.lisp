; Всі ці частки означають цілі невід'ємні компоненти календаря.
; D5 ЧАСТКА — точне дробове ділення; її не можна використовувати як FLOOR.
; Тут працює виключно SENS-означення частки через подвоєння (lib/core4.lisp),
; зовнішній механізм надає тільки сирі спостереження часу.

; Явні налаштування часового поясу є даними, а не зміною системи.

; Кількість цілих діб від початку 1970 року перетворюємо на дату
; пролептичного григоріанського календаря.
; Ця формула належить мові, а не зовнішньому обчислювачу.
; Область визначення — невід'ємні дні від початку епохи.
(визначити грегоріанська-дата-з-числа-днів
  (функція (дні-від-епохи)
    ((функція (зміщені-дні)
      ((функція (ера)
        ((функція (дні-ери)
          ((функція (роки-ери)
            ((функція (рік-в-ері)
              ((функція (дні-року)
                ((функція (місяць-проміжний)
                  ((функція (день)
                    ((функція (місяць)
                      ((функція (рік)
                        (сполучити рік (сполучити місяць (сполучити день (як-є ()))))
                      )
                        (додати рік-в-ері (за-умовою ((менше? місяць 3) 1) ((атом? (як-є ())) 0))))
                    )
                      (додати місяць-проміжний (за-умовою ((менше? місяць-проміжний 10) 3) ((атом? (як-є ())) -9))))
                  )
                    (додати (відняти дні-року (частка-через-подвоєння (додати (помножити 153 місяць-проміжний) 2) 5)) 1))
                )
                  (частка-через-подвоєння (додати (помножити 5 дні-року) 2) 153))
              )
                (відняти дні-ери (додати (помножити 365 роки-ери) (відняти (частка-через-подвоєння роки-ери 4) (частка-через-подвоєння роки-ери 100)))))
            )
              (додати роки-ери (помножити ера 400)))
          )
            (частка-через-подвоєння (відняти (додати дні-ери (частка-через-подвоєння дні-ери 36524)) (додати (частка-через-подвоєння дні-ери 1460) (частка-через-подвоєння дні-ери 146096))) 365))
        )
          (відняти зміщені-дні (помножити ера 146097)))
      )
        (частка-через-подвоєння зміщені-дні 146097))
    )
      (додати дні-від-епохи 719468))
  ))


; Канонічна D10:1010111110 проєкція укр того самого Lisp-замикання.

; Точна часова позначка перетворюється на календарні дані.
; Зовнішній механізм спостерігає час, а його календарне значення
; детерміновано визначає СЕНС.
(визначити узгоджений-час-з-юнікс
  (функція (секунди-юнікс наносекунди)
    ((функція (дні)
      ((функція (секунди-доби)
        ((функція (цивільна-дата)
          ((функція (година)
            ((функція (хвилина)
              ((функція (секунда-хвилини)
                (сполучити (як-є utc) (сполучити (перше цивільна-дата) (сполучити (перше (решта цивільна-дата)) (сполучити (перше (решта (решта цивільна-дата))) (сполучити година (сполучити хвилина (сполучити секунда-хвилини (сполучити наносекунди (як-є ())))))))))
              )
                (модульна-остача секунди-доби 60))
            )
              (частка-через-подвоєння (модульна-остача секунди-доби 3600) 60))
          )
            (частка-через-подвоєння секунди-доби 3600))
        )
          (грегоріанська-дата-з-числа-днів дні))
      )
        (модульна-остача секунди-юнікс 86400))
    )
      (частка-через-подвоєння секунди-юнікс 86400))
  ))


; Мінімальний зовнішній контракт надає секунди й наносекунди епохи.
; Календарне значення цього спостереження залишається у СЕНС.
(визначити юнікс-час-спостереження-узгоджений-час
  (функція (спостереження)
    (за-умовою
      ((тотожне? (перше спостереження) (як-є unix-time))
       (узгоджений-час-з-юнікс (перше (решта спостереження)) (перше (решта (решта спостереження)))))
      ((атом? (як-є ()))
       (сполучити (як-є rejected) (сполучити (як-є invalid-unix-time-observation) (як-є ()))))))
)

