; Повна відповідь мережевого протоколу часу містить поля сталої ширини.
; Пакетні операції та вилучення полів — тільки зовнішня механіка.
; Перевірка допустимості, перетворення епохи та дробової частини
; секунди на наносекунди належать мовній семантиці.
;
; Повна відповідь містить вузол, режим, рівень, секунди та дробову частину.
; Прийняте спостереження зберігає чинну форму результату.
; Числові порівняння повертають точні відповіді першого домену.
; Логічні операції використовують лише ці відповіді.
; Умовний вибір має рівно два поля в кожній гілці.
; Порожня структура й числові значення не замінюють істину.
(визначити інтернет-час-режим-припустимий?
  (функція (режим)
    (за-умовою
      ; D3 EQ має приймати атоми; списковий режим — точне D1:NO.
      ((хибне? (атом? режим)) (атом? (як-є (000))))
      ((тотожне? режим 4) (атом? (як-є ())))
      ((тотожне? режим 5) (атом? (як-є ())))
      ((атом? (як-є ())) (атом? (як-є (000))))))
)

(визначити інтернет-час-рівень-припустимий?
  (функція (рівень)
    (за-умовою
      ; Арифметика D24+ не визначена для складеного списку.
      ((хибне? (атом? рівень)) (атом? (як-є (000))))
      ((більше? рівень 0)
       (за-умовою
         ((менше? рівень 16) (атом? (як-є ())))
         ((атом? (як-є ())) (атом? (як-є (000))))))
      ((атом? (як-є ())) (атом? (як-є (000))))))
)

; Дробові 32 біти протоколу — це рівно floor(частина × 10^9 / 2^32).
; У D48 прямий добуток міг би розширитися до D96 перед діленням.
; Розбиваємо частину на дві 16-бітні половини; кожний проміжний
; добуток і додавання вміщається у знаковий D48 без втрати біта.
; Жодного неявного D48/D96 приведення і жодного зовнішнього обчислення.
(визначити наносекунди-з-дробу-мережевого-часу
  (функція (дробова-частина)
    ((функція (основа)
       ((функція (старша молодша)
          ((функція (старший-добуток молодший-добуток)
             (додати
               (частка-через-подвоєння старший-добуток основа)
               (частка-через-подвоєння
                 (додати
                   (помножити
                     (модульна-остача старший-добуток основа)
                     основа)
                   молодший-добуток)
                 4294967296)))
            (помножити старша 1000000000)
            (помножити молодша 1000000000)))
         (частка-через-подвоєння дробова-частина основа)
         (модульна-остача дробова-частина основа)))
      (додати 65536 (відняти 1000000000 1000000000)))))

(визначити тлумачити-поля-відповіді-часу
  (функція (вузол режим рівень секунди-протоколу-часу дробова-частина)
    (за-умовою
      ((інтернет-час-режим-припустимий? режим)
       (за-умовою
         ((інтернет-час-рівень-припустимий? рівень)
          (за-умовою
            ((менше? секунди-протоколу-часу 2208988800)
             (сполучити (як-є rejected) (сполучити (як-є invalid-epoch) (як-є ()))))
            ((атом? (як-є ()))
             (сполучити (як-є accepted) (сполучити вузол (сполучити (відняти секунди-протоколу-часу 2208988800) (сполучити (наносекунди-з-дробу-мережевого-часу дробова-частина) (як-є ()))))))))
         ((атом? (як-є ()))
          (сполучити (як-є rejected) (сполучити (як-є invalid-response) (як-є ()))))))
      ((атом? (як-є ()))
       (сполучити (як-є rejected) (сполучити (як-є invalid-response) (як-є ())))))))


; Мовна межа приймає п'ять полів зовнішнього спостереження
; або транспортну відмову з її причиною.
; Після цієї межі всі рішення про значення ухвалює СЕНС.
(визначити перетворити-сирі-дані-часу-на-спостереження
  (функція (сирі-дані)
