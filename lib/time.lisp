            )
          )
         )
       )
      )
      ((хибне? (тотожне? значення-часового-поясу (як-є ())))
       ; Порожній рядок також дозволяє перевірити запасне джерело.
       (за-умовою
         ((рядок-порожній? значення-часового-поясу)
          (за-умовою
            ((тотожне? значення-поясу-з-файлу (як-є ()))
             (сполучити (як-є unknown) (сполучити (як-є host-declaration-unavailable) (як-є ())))
            )
            ((хибне? (тотожне? значення-поясу-з-файлу (як-є ())))
             (за-умовою
               ((рядок-порожній? значення-поясу-з-файлу)
                (сполучити (як-є unknown) (сполучити (як-є host-declaration-unavailable) (як-є ())))
               )
               ((хибне? (рядок-порожній? значення-поясу-з-файлу))
                (сполучити (як-є detected) (сполучити значення-поясу-з-файлу (сполучити (як-є etc-timezone) (як-є ()))))
