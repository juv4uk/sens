; Закон Д3/Д4: кожен елемент скінченного списку має дві сусідні копії.
; Зворотний хід зберігає кожен перший елемент пари на образі прямого ходу.
; Код і рекурсію виконує лише SENS; Zig/T5M є точним фізичним транспортом.
(визначити повторити-елементи
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (як-є ()))
       (сполучити (перше елементи)
         (сполучити (перше елементи)
           (повторити-елементи (решта елементи))))))))

(визначити взяти-кожен-перший
  (функція (пари)
    (за-умовою
      ((атом? пари) (як-є ()))
      ((атом? (як-є ()))
       (сполучити (перше пари)
         (взяти-кожен-перший (решта-решти пари)))))))

(визначити початковий-список
  (список (як-є атом?) (як-є решта) (як-є сполучити)))
(визначити подвоєний-список (повторити-елементи початковий-список))
(визначити відновлений-список (взяти-кожен-перший подвоєний-список))

; Справжній позитив D1: усі позиції, точний кінець, нульовий та одиничний
; випадки; два негативи не можуть видати правильний порядок за випадковість.
(за-умовою
  ((тотожне? (перше подвоєний-список) (як-є атом?))
   (за-умовою
  ((тотожне? (друге подвоєний-список) (як-є атом?))
   (за-умовою
  ((тотожне? (перше (решта-решти подвоєний-список)) (як-є решта))
   (за-умовою
  ((тотожне? (друге (решта-решти подвоєний-список)) (як-є решта))
   (за-умовою
  ((тотожне? (перше (решта-решти (решта-решти подвоєний-список))) (як-є сполучити))
   (за-умовою
  ((тотожне? (друге (решта-решти (решта-решти подвоєний-список))) (як-є сполучити))
   (за-умовою
  ((атом? (решта-решти (решта-решти (решта-решти подвоєний-список))))
   (за-умовою
  ((тотожне? (перше відновлений-список) (як-є атом?))
   (за-умовою
  ((тотожне? (друге відновлений-список) (як-є решта))
   (за-умовою
  ((тотожне? (перше (решта-решти відновлений-список)) (як-є сполучити))
   (за-умовою
  ((атом? (решта (решта-решти відновлений-список)))
   (за-умовою
  ((атом? (повторити-елементи (як-є ())))
   (за-умовою
  ((атом? (взяти-кожен-перший (як-є ())))
   (за-умовою
  ((тотожне? (перше (взяти-кожен-перший (повторити-елементи (список (як-є тотожне?))))) (як-є тотожне?))
   (за-умовою
  ((атом? (решта (взяти-кожен-перший (повторити-елементи (список (як-є тотожне?))))))
   (за-умовою
  ((хибне? (тотожне? (друге подвоєний-список) (як-є решта)))
   (за-умовою
  ((хибне? (тотожне? (друге відновлений-список) (як-є атом?)))
   (атом? (як-є ())))
