; SENS D3/D4: замінити кожне точне входження атома без зміни порядку або довжини.
; Елементи — власні канонічні атоми; без D7-дублювання резидентів, чисел і зовнішнього виконавця.
; Зміни перевіряє сам SENS, Zig/T5M — лише фізичне перенесення.
(визначити замінити-всі-входження
  (функція (елементи шукане заміна)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((тотожне? (перше елементи) шукане)
       (сполучити заміна (замінити-всі-входження (решта елементи) шукане заміна)))
      ((атом? (як-є ()))
       (сполучити (перше елементи)
         (замінити-всі-входження (решта елементи) шукане заміна))))))

(визначити приклад-заміни (замінити-всі-входження (список (як-є атом?) (як-є решта) (як-є атом?) (як-є сполучити) (як-є атом?) (як-є тотожне?) (як-є решта)) (як-є атом?) (як-є за-умовою)))
(визначити приклад-всі (замінити-всі-входження (список (як-є атом?) (як-є атом?)) (як-є атом?) (як-є решта)))
(визначити приклад-відсутній (замінити-всі-входження (список (як-є решта) (як-є тотожне?)) (як-є атом?) (як-є сполучити)))

