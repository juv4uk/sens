; Аудит Д1-Д10: три бібліотечні закони поверх уже зайнятих доменів.
; Історичні джерела: Схема Р7РС та СРФІ-1; нових координат немає.
; Джерело - стандарт Схема Р7РС
; Джерело - СРФІ-1, списки й асоціації
; Пара? вже існує як ядро1-пара?; список? у Д10 приймає крапкові пари.
; Усі три закони тут - лише скінченні ациклічні структури СПОЛУЧИТИ/атом.
; Порівнювач - чисте двомісне замикання СЕНС із результатом Д1.

; Загальний правильний список: кожен решта завершується саме ().
; Не підміняти Д10 перевірку списку, який приймає довільну СПОЛУЧИТИ-пару.
(визначити правильний-список-загальний?
  (функція (значення)
    (за-умовою
      ((порожній? значення) так)
      ((атом? значення) ні)
      (так
       (правильний-список-загальний? (решта значення))))))

; порівняння дерев з компаратором атомних листків; СПОЛУЧИТИ-форми мусять
; збігатися точно, для крапкових пар порівнюються обидві гілки.
; На відміну від Д8 порівняння це не фіксована структурна рівність.
(визначити дерева-рівні-за-атомами?
  (функція (порівняти ліве праве)
    (за-умовою
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (порівняти ліве праве))
         (так ні)))
      ((атом? праве) ні)
      ((дерева-рівні-за-атомами?
         порівняти (перше ліве) (перше праве))
       (дерева-рівні-за-атомами?
         порівняти (решта ліве) (решта праве)))
      (так ні))))

; Чиста адаптація СРФІ-1, вилучення асоціацій: вилучити ВСІ пари з ключем.
; Записи - правильний список непорожніх СПОЛУЧИТИ-пар (ключ . значення).
; Збережені записи і їхній початковий порядок лишаються незмінними.
; Цей закон відрізняється від Д5 пошук асоціації, що шукає тільки перший запис.
; Д11: весь список записів перевіряємо ДО першого порівняння.
; Запис мусить бути D3 парою, його значенням може бути D1 ні або D3 ().
; Атомарний кінець дозволено тільки якщо це точний D3 ().
(визначити правильні-записи-для-вилучення?
  (функція (записи)
    (за-умовою
      ((атом? записи) (тотожне? записи (як-є ())))
      ((атом? (перше записи)) ні)
      (так
       (правильні-записи-для-вилучення? (решта записи))))))

; Ядро отримує лише скінченний правильний список справжніх записів.
; Порядок нецільових записів і їхнє кратне входження незмінні.
(визначити вилучити-асоціації-за-ключем-ядро
  (функція (порівняти шуканий записи)
    (за-умовою
      ((порожній? записи) (як-є ()))
      ((порівняти шуканий (перше (перше записи)))
       (вилучити-асоціації-за-ключем-ядро
         порівняти шуканий (решта записи)))
      (так
       (сполучити
         (перше записи)
         (вилучити-асоціації-за-ключем-ядро
           порівняти шуканий (решта записи)))))))

(визначити вилучити-асоціації-за-ключем
  (функція (порівняти шуканий записи)
    (за-умовою
      ((правильні-записи-для-вилучення? записи)
       (вилучити-асоціації-за-ключем-ядро
         порівняти шуканий записи))
      ; Збій саме D3 CAR, а не false, reader error чи host-перевірка.
      (так (перше (як-є ()))))))

; Живий доказ першокласного Д3:101 ТОТОЖНЕ? як функції-значення.
; Передаємо код з повної проєкції "укр" у параметр порівняти:
; позитивна структурна рівність та негативна відмінність хвоста.
; Не реєстр текстових імен, не старий байтовий код, не зовнішній обчислювач.
(за-умовою
  ((дерева-рівні-за-атомами?
     тотожне?
     (сполучити (як-є атом?) (як-є решта))
     (сполучити (як-є атом?) (як-є решта)))
   (хибне?
     (дерева-рівні-за-атомами?
       тотожне?
       (сполучити (як-є атом?) (як-є решта))
       (сполучити (як-є атом?) (як-є сполучити)))))
  (так (перше (як-є ()))))
