; Аудит Д1–Д10: три бібліотечні закони поверх уже зайнятих доменів.
; Історичні джерела: R7RS Scheme та SRFI-1; нових координат немає.
; https://standards.scheme.org/r7rs-html5/index.html
; https://srfi.schemers.org/srfi-1/srfi-1.html
; Пара? вже існує як ядро1-пара?; список? у Д10 приймає крапкові пари.
; Усі три закони тут — лише скінченні ациклічні структури CONS/атом.
; Порівнювач — чисте двомісне замикання СЕНС із результатом Д1.

; Загальний правильний список: кожен решта завершується саме ().
; Не підміняти Д10 LISTP, який приймає довільну CONS-пару.
(визначити правильний-список-загальний?
  (функція (значення)
    (за-умовою
      ((порожній? значення) так)
      ((атом? значення) ні)
      (так
       (правильний-список-загальний? (решта значення))))))

; TREE-EQUAL з компаратором атомних листків; CONS-форми мусять
; збігатися точно, для крапкових пар порівнюються обидві гілки.
; На відміну від Д8 EQUAL це не фіксована структурна рівність.
(визначити дерева-рівні-за-атомами?
  (функція (порівняти ліве праве)
    (за-умовою
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (порівняти ліве праве))
         (так ні)))
      ((атом? праве) ні)
      ((дерева-рівні-за-атомами?
         порівняти (перше ліве) (перше праве))
       (дерева-рівні-за-атомами?
         порівняти (решта ліве) (решта праве)))
      (так ні))))

; Чиста адаптація SRFI-1 ALIST-DELETE: вилучити ВСІ пари з ключем.
; Записи — правильний список непорожніх CONS-пар (ключ . значення).
; Збережені записи і їхній початковий порядок лишаються незмінними.
; Цей закон відрізняється від Д5 ASSOC, що шукає тільки перший запис.
(визначити вилучити-асоціації-за-ключем
  (функція (порівняти шуканий записи)
    (за-умовою
      ((порожній? записи) (як-є ()))
      ((порівняти шуканий (перше (перше записи)))
       (вилучити-асоціації-за-ключем
         порівняти шуканий (решта записи)))
      (так
       (сполучити
         (перше записи)
         (вилучити-асоціації-за-ключем
           порівняти шуканий (решта записи)))))))
