; СЕНС: узагальнення оборотного спарювання з двійки до трійки.
; Два власні трьохелементні списки → три CONS-пари → дві початкові трійки.
; Жодного нового опкода, Python/JSON чи Unicode у фізичних T5M-словах.
(визначити спарувати-три-позиції
  (функція (ліві праві)
    (список
      (сполучити (перше ліві) (перше праві))
      (сполучити (друге ліві) (друге праві))
      (сполучити (третє ліві) (третє праві)))))

(визначити розпарувати-три-позиції
  (функція (пари)
    (список
      (список
        (перше (перше пари))
        (перше (друге пари))
        (перше (третє пари)))
      (список
        (решта (перше пари))
        (решта (друге пари))
        (решта (третє пари))))))

(визначити ліва-початкова-трійка
  (список (як-є атом?) (як-є тотожне?) (як-є решта)))
(визначити права-початкова-трійка
  (список (як-є сполучити) (як-є за-умовою) (як-є хибне?)))
(визначити три-спаровані-позиції
  (спарувати-три-позиції ліва-початкова-трійка права-початкова-трійка))
(визначити дві-відновлені-трійки
  (розпарувати-три-позиції три-спаровані-позиції))

; Позитивні свідки: кожна з шести відновлених позицій.
; Негативний свідок: не можна поміняти місцями першу ліву й праву.
; Справжній SENS повертає Д1 так лише при виконанні всіх семи умов.
(за-умовою
  ((тотожне? (перше (перше дві-відновлені-трійки)) (як-є атом?))
    (за-умовою
      ((тотожне? (друге (перше дві-відновлені-трійки)) (як-є тотожне?))
        (за-умовою
          ((тотожне? (третє (перше дві-відновлені-трійки)) (як-є решта))
            (за-умовою
              ((тотожне? (перше (друге дві-відновлені-трійки)) (як-є сполучити))
                (за-умовою
                  ((тотожне? (друге (друге дві-відновлені-трійки)) (як-є за-умовою))
                    (за-умовою
                      ((тотожне? (третє (друге дві-відновлені-трійки)) (як-є хибне?))
                        (хибне? (тотожне? (перше (перше дві-відновлені-трійки))
                                           (перше (друге дві-відновлені-трійки)))))
                      (так ні)))
                  (так ні)))
              (так ні)))
          (так ні)))
      (так ні)))
  (так ні))
