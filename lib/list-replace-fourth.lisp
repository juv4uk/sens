; СЕНС: функціональна заміна четвертого елемента четвірки.
; Четвірка з новим четвертим значенням не змінює початкового списку.
; Область: правильний список рівно з чотирьох елементів.

(визначити замінити-четвертий-четвірки
  (функція (четвірка нове)
    (список
      (перше четвірка)
      (друге четвірка)
      (третє четвірка)
      нове)))

(визначити початкова-четвірка-заміни (список (як-є атом?) (як-є тотожне?) (як-є решта) (як-є сполучити)))
(визначити замінена-четвірка
  (замінити-четвертий-четвірки початкова-четвірка-заміни (як-є за-умовою)))

; Нативний Д1-свідок трьох незмінних елементів, заміни й негативного збігу.
(за-умовою
  ((тотожне? (перше замінена-четвірка) (як-є атом?))
   (за-умовою
  ((тотожне? (друге замінена-четвірка) (як-є тотожне?))
   (за-умовою
  ((тотожне? (третє замінена-четвірка) (як-є решта))
   (за-умовою
  ((тотожне? (четверте замінена-четвірка) (як-є за-умовою))
   (за-умовою
  ((тотожне? (четверте початкова-четвірка-заміни) (як-є сполучити))
   (за-умовою
  ((хибне? (тотожне? (четверте замінена-четвірка) (як-є сполучити)))
   (атом? (як-є ())))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ())))))
