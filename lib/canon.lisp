; КАНОН 0+7: мовний семантичний контракт із точними викличними головами Д3.
; Саме СЕНС визначає закони; зовнішні виконавці реалізують механізми,
; що мають відповідати вже наявному незмінному Канону.
; Цей файл не створює і не перевизначає канонічних імен.
; Двійковий свідок збережено окремо у точному носії СЕНС.
; Викличні голови Д3: точні трирозрядні слова; цитовані імена
; залишаються символами проєкції до допуску Д7/Т5.
; Контракт 6.0: (), як-є, атом?, тотожне?, сполучити, перше, решта
; та за-умовою надає незмінний розв'язувач Канону.
; Тут визначено тільки свідків і закони над цією основою.
; Нульовий елемент Канону не має лексичного псевдоніма;
; свідок порожнього списку перебуває поза зарезервованими іменами.

(визначити канон-порожній-список (як-є ()))

; 'Як-є' та 'за-умовою' керують обчисленням, а не є звичайними значеннями.
; Викличні примітиви Канону мають незмінні значення операцій.
;
; Символьна поверхня української клавіатури:
;   '  .?  =?  :  :п  :р  ?:
; Це інші написання тотожностей 0+7, а не додаткові примітиви.

; --- Записи результатів Канону версії2 -----------------------------------
; Закон повертає явний запис даних Лісп, а не універсальну істину чи хибу.

(визначити канон-закон-результат
  (функція (закон стан)
    (сполучити
      (як-є канон-закон-результат)
      (сполучити закон (сполучити стан (як-є ()))))))

(визначити канон-закон-виконаний
  (функція (закон)
    (канон-закон-результат закон (як-є виконано))))

(визначити канон-закон-порушений
  (функція (закон)
    (канон-закон-результат закон (як-є порушено))))

(визначити канон-закон-стан
  (функція (результат)
    (перше (решта (решта результат)))))

(визначити канон-відповідність-результат
  (функція (стан)
    (сполучити
      (як-є канон-відповідність)
      (сполучити стан (як-є ())))))

; --- Основоположні закони ------------------------------------------------
; Кожна гілка використовує поточні голови Д3:110 за-умовою,
; Д3:010 атом? і Д3:101 тотожне? через українську проєкцію;
; керування лише точним однобітним значенням-предикатом Д1.
; Структурне () не є хибним предикатом.

(визначити канон-закон-порожній-список
  (функція ()
    (за-умовою
      ((тотожне? канон-порожній-список (як-є ()))
       (канон-закон-виконаний (як-є порожній-список)))
      (так
       (канон-закон-порушений (як-є порожній-список))))))

(визначити канон-закон-атом-пара
  (функція (ліве праве)
    (за-умовою
      ((атом? (сполучити ліве праве))
       (канон-закон-порушений (як-є атом-пара)))
      (так
       (канон-закон-виконаний (як-є атом-пара))))))

(визначити канон-закон-перше-пара
  (функція (ліве праве)
    (за-умовою
      ((тотожне? (перше (сполучити ліве праве)) ліве)
       (канон-закон-виконаний (як-є перше-пара)))
      (так
       (канон-закон-порушений (як-є перше-пара))))))

(визначити канон-закон-решта-пара
  (функція (ліве праве)
    (за-умовою
      ((тотожне? (решта (сполучити ліве праве)) праве)
       (канон-закон-виконаний (як-є решта-пара)))
      (так
       (канон-закон-порушений (як-є решта-пара))))))

(визначити канон-закон-рівність-рефлексивний-атом
  (функція (атом-значення)
    (за-умовою
      ((атом? атом-значення)
       (за-умовою
         ((тотожне? атом-значення атом-значення)
          (канон-закон-виконаний (як-є тотожність-рефлексивний-атом)))
         (так
          (канон-закон-порушений (як-є тотожність-рефлексивний-атом)))))
      (так
       (канон-закон-порушений (як-є тотожність-рефлексивний-атом))))))

; 'Решта' є хвостом пари, а не другим елементом у звичайній мові.
(визначити канон-закон-решта-крапковий
  (функція ()
    (за-умовою
      ((тотожне?
         (решта (сполучити (як-є кіт) (як-є хвіст)))
         (як-є хвіст))
       (канон-закон-виконаний (як-є решта-крапковий)))
      (так
       (канон-закон-порушений (як-є решта-крапковий))))))

; Тотожне? перевіряє тотожність допустимих атомів, включно зі структурним ().
; Завершення правильного списку доводимо явним порівнянням із ().
(визначити канон-закон-решта-правильний
  (функція ()
    (за-умовою
      ((тотожне?
         (перше (решта (як-є (кіт пес кінь))))
         (як-є пес))
       (за-умовою
         ((тотожне?
            (перше (решта (решта (як-є (кіт пес кінь)))))
            (як-є кінь))
          (за-умовою
            ((тотожне?
               (решта (решта (решта (як-є (кіт пес кінь)))))
               (як-є ()))
             (канон-закон-виконаний (як-є решта-правильний)))
            (так
             (канон-закон-порушений (як-є решта-правильний)))))
         (так
          (канон-закон-порушений (як-є решта-правильний)))))
      (так
       (канон-закон-порушений (як-є решта-правильний))))))

; Тотожність Д3 визначено для атомів; неправильний хвіст перевіряємо як атом.
(визначити канон-закон-решта-неправильний
  (функція ()
    (за-умовою
      ((тотожне?
         (перше (решта (як-є (кіт пес . кінь))))
         (як-є пес))
       (за-умовою
         ((тотожне?
            (решта (решта (як-є (кіт пес . кінь))))
            (як-є кінь))
          (канон-закон-виконаний (як-є решта-неправильний)))
         (так
          (канон-закон-порушений (як-є решта-неправильний)))))
      (так
       (канон-закон-порушений (як-є решта-неправильний))))))

; Цитовані й невибрані невідомі символи не можна обчислювати.
; Передчасне обчислення спричинить помилку до запису результату закону.
(визначити канон-закон-цитування-пригнічує-обчислення
  (функція ()
    (за-умовою
      ((тотожне? (як-є ніколи-не-визначений-символ-канону)
                  (як-є ніколи-не-визначений-символ-канону))
       (канон-закон-виконаний (як-є цитування-пригнічує-обчислення)))
      (так
       (канон-закон-порушений (як-є цитування-пригнічує-обчислення))))))

(визначити канон-закон-умова-перший-збіг-короткий-ланцюг
  (функція ()
    (за-умовою
      ((тотожне?
         (за-умовою
           (так (як-є вибрано))
           ((ніколи-не-визначений-канон-предикат) (як-є заборонено)))
         (як-є вибрано))
       (канон-закон-виконаний (як-є умова-перший-збіг-короткий-ланцюг)))
      (так
       (канон-закон-порушений (як-є умова-перший-збіг-короткий-ланцюг))))))

; Коротка українська поверхня означає ті самі сім операцій.
; Історичне ім'я свідка збережено для сумісності; голови Д3 точні.
; Відповідність написань перевіряється окремо.
; Історична неявна істинність так/ні тут неприпустима.
(визначити канон-закон-символьний-поверхня
  (функція ()
    (за-умовою
      ((тотожне?
         (за-умовою
           ((атом? (як-є атом))
            (за-умовою
              ((тотожне? (перше (сполучити (як-є ліве) (як-є праве))) (як-є ліве))
               (решта (сполучити (як-є ліве) (як-є праве)))))))
         (як-є праве))
       (канон-закон-виконаний (як-є символьна-поверхня)))
      (так
       (канон-закон-порушений (як-є символьна-поверхня))))))

; Записи результатів збираються рекурсивно. Порожній список
; завершує структуру результатів, а не означає логічну хибу.
(визначити канон-відповідність-з
  (функція (результати)
    (за-умовою
      ((атом? результати)
       (за-умовою
         ((тотожне? результати (як-є ()))
          (канон-відповідність-результат (як-є виконано)))
         (так
          (канон-відповідність-результат (як-є порушено)))))
      (так
       (за-умовою
         ((тотожне?
            (канон-закон-стан (перше результати))
            (як-є виконано))
          (канон-відповідність-з (решта результати)))
         (так
          (канон-відповідність-результат (як-є порушено))))))))

; Єдиний явний мовний запис відповідності для спостерігачів виконавця.
(визначити канон-відповідає?
  (функція ()
    (канон-відповідність-з
      (сполучити
        (канон-закон-порожній-список)
        (сполучити
          (канон-закон-атом-пара (як-є ліве) (як-є праве))
          (сполучити
            (канон-закон-перше-пара (як-є ікс) (як-є ігрек))
            (сполучити
              (канон-закон-решта-пара (як-є ікс) (як-є ігрек))
              (сполучити
                (канон-закон-рівність-рефлексивний-атом (як-є ікс))
                (сполучити
                  (канон-закон-решта-крапковий)
                  (сполучити
                    (канон-закон-решта-правильний)
                    (сполучити
                      (канон-закон-решта-неправильний)
                      (сполучити
                        (канон-закон-цитування-пригнічує-обчислення)
                        (сполучити
                          (канон-закон-умова-перший-збіг-короткий-ланцюг)
                          (сполучити
                            (канон-закон-символьний-поверхня)
                            (як-є ())))))))))))))))
