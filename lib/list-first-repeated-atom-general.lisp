; Перший за позицією атом, який трапляється повторно далі у списку.
; Це не лише сусідні повтори. Складені елементи не передаємо у тотожне?.
; Результат за відсутності повтору - порожній список.
; Семантику виконує СЕНС. Д7 є людською проєкцією, Зіг кодує носій.

(визначити повтор-атома-праворуч?
  (функція (шуканий елементи)
    (за-умовою
      ((порожній? елементи) ні)
      ((хибне? (атом? (перше елементи)))
       (повтор-атома-праворуч? шуканий (решта елементи)))
      ((тотожне? шуканий (перше елементи)) так)
      (так (повтор-атома-праворуч? шуканий (решта елементи))))))

(визначити перший-повторений-атом
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((хибне? (атом? (перше елементи)))
       (перший-повторений-атом (решта елементи)))
      ((повтор-атома-праворуч? (перше елементи) (решта елементи))
       (перше елементи))
      (так (перший-повторений-атом (решта елементи))))))

