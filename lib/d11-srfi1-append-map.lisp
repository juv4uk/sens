; Д11-пропозиція · SRFI-1 APPEND-MAP / MAP-APPEND.
; Новий композиційний закон, а не новий opcode чи координата D11.
; Джерело: https://srfi.schemers.org/srfi-1/srfi-1.html
; Залежність: lib/list-append-general.lisp, визначене в SENS
; приєднати-два-списки-ядро. Жодної хостової семантики.
; Вхід: чисте одномісне SENS-замикання та скінченний правильний список.
; Кожен результат замикання — теж скінченний правильний D3-список.
; Неправильний хвіст входу викликає D3 CAR Type ДО замикання.
; Неправильний результат викликає D3 CAR Type ДО конкатенації.
; D1:ні є повноправним елементом, але НЕ D3:().
; Порядок елементів і кратність зберігаються.
; Окремі кроки: передумова -> map рівно по одному разу -> append.
; Складність O(n + сума довжин усіх відображених списків).

(визначити підтвердити-список-для-приєднаного-відображення
  (функція (поточний початковий)
    (за-умовою
      ((атом? поточний)
       (за-умовою
         ((тотожне? поточний (як-є ())) початковий)
         (так (перше поточний))))
      (так
       (підтвердити-список-для-приєднаного-відображення
         (решта поточний) початковий)))))

; Вихід користувацької функції обчислюється тільки один раз.
(визначити підтвердити-вихід-приєднаного-відображення
  (функція (отримане)
    (підтвердити-список-для-приєднаного-відображення
      отримане отримане)))

; Усі виклики користувацької функції отримують підтверджений вхід.
; Кожен повернутий список перевіряється до формування результату.
(визначити відобразити-у-списки-ядро
  (функція (перетворити елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      (так
       (сполучити
         (підтвердити-вихід-приєднаного-відображення
           (перетворити (перше елементи)))
         (відобразити-у-списки-ядро
           перетворити (решта елементи)))))))

; Список списків уже перевірений: використовуємо чинне ядро APPEND.
; Це не повторне визначення D3 або функції приєднати.
(визначити приєднати-списки-відображення-ядро
  (функція (вкладені)
    (за-умовою
      ((порожній? вкладені) (як-є ()))
      (так
       (приєднати-два-списки-ядро
         (перше вкладені)
         (приєднати-списки-відображення-ядро
           (решта вкладені)))))))

(визначити відобразити-та-приєднати-списки
  (функція (перетворити елементи)
    (приєднати-списки-відображення-ядро
      (відобразити-у-списки-ядро
        перетворити
        (підтвердити-список-для-приєднаного-відображення
          елементи елементи)))))
