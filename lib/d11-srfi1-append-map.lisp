; Д11-пропозиція · контрольований композиційний профіль D10 MAPPEND.
; Джерело: https://srfi.schemers.org/srfi-1/srfi-1.html
; Чинна функція: D10:0011001010 відобразити-й-додати (san citra-saṃyojana).
; Залежність: lib/core4-parts/core4-language.lisp (визначення D10 MAPPEND).
; Жодної нової координати, дубля APPEND або машинного opcode.
; Новий закон: повна перевірка вхідного D3-ланцюга ДО callback;
; кожен результат callback є правильним D3-списком, інакше D3 CAR Type.
; D1:ні у вмісті не є структурним D3:(); порядок і кратність збережені.
; Функцію перетворення обчислюємо один раз на елемент; чисті callback.
; На відміну від прямого D10 MAPPEND, тут перевірка всього входу
; має пріоритет над ранньою помилкою або раннім успіхом callback.

(визначити підтвердити-список-для-приєднаного-відображення
  (функція (поточний початковий)
    (за-умовою
      ((атом? поточний)
       (за-умовою
         ((тотожне? поточний (як-є ())) початковий)
         (так (перше поточний))))
      (так
       (підтвердити-список-для-приєднаного-відображення
         (решта поточний) початковий)))))

; Значення callback передається як аргумент, без другого виклику.
(визначити підтвердити-вихід-приєднаного-відображення
  (функція (отримане)
    (підтвердити-список-для-приєднаного-відображення
      отримане отримане)))

; Спочатку створити підтверджені результати, потім виконати D10.
(визначити відобразити-у-списки-ядро
  (функція (перетворити елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      (так
       (сполучити
         (підтвердити-вихід-приєднаного-відображення
           (перетворити (перше елементи)))
         (відобразити-у-списки-ядро
           перетворити (решта елементи)))))))

; Фактична конкатенація — вже ратифікований D10 MAPPEND.
; Функція-тотожність не викликає жодного користувацького callback.
(визначити відобразити-та-приєднати-списки
  (функція (перетворити елементи)
    (відобразити-й-додати
      (функція (готовий-список) готовий-список)
      (відобразити-у-списки-ядро
        перетворити
        (підтвердити-список-для-приєднаного-відображення
          елементи елементи)))))
