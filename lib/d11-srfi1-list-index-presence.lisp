; Д11: SRFI-1 LIST-INDEX, суто виконувана композиція мовою SENS.
; Контракт: лівий перший збіг, індекс у точній числовій родині Д24+.
; Д1:ні не означає число нуль. Результат: (так індекс) або (ні ()).
; На відміну від Scheme #f, відсутність тут має явний прапорець.
; Скінченні правильні D3-списки перевіряються ПЕРЕД predicate callback.
; Для двох списків зупинка на коротшому, але перевірка обох — повна.
; Жодного нового коду D11, D7 дубліката або host-арифметики.

(визначити підтвердити-д3-список-індексу
  (функція (поточний початковий)
    (за-умовою
      ; D3 NULL — структура, а не D3 EQ з довільним атомом.
      ((порожній? поточний) початковий)
      ; D1:ні, D7 та інші атомні хвости відхиляє точний D3 CAR.
      ((атом? поточний) (перше поточний))
      (так
       (підтвердити-д3-список-індексу
         (решта поточний) початковий)))))

; Лише доведений D3-список надходить до ядра.
; Точне D12+ число не порівнюється атомним D3 EQ.
(визначити індекс-першого-збігу-ядро
  (функція (умова елементи номер)
    (за-умовою
      ((порожній? елементи) (список ні (як-є ())))
      ((умова (перше елементи)) (список так номер))
      (так
       (індекс-першого-збігу-ядро
         умова (решта елементи) (додати номер число-один))))))

(визначити знайти-індекс-із-наявністю
  (функція (умова елементи)
    (індекс-першого-збігу-ядро
      умова
      (підтвердити-д3-список-індексу елементи елементи)
      число-нуль)))

; Бінарний SRFI-1 LIST-INDEX: позиційна пара, потім крок обох хвостів.
(визначити індекс-першої-пари-ядро
  (функція (умова ліві праві номер)
    (за-умовою
      ((порожній? ліві) (список ні (як-є ())))
      ((порожній? праві) (список ні (як-є ())))
      ((умова (перше ліві) (перше праві))
       (список так номер))
      (так
       (індекс-першої-пари-ядро
         умова (решта ліві) (решта праві)
         (додати номер число-один))))))

; Обидві структури валідовані до першого предиката, навіть коли
; лівий список порожній або вже перша пара збігається.
(визначити знайти-індекс-пари-із-наявністю
  (функція (умова ліві праві)
    (індекс-першої-пари-ядро
      умова
      (підтвердити-д3-список-індексу ліві ліві)
      (підтвердити-д3-список-індексу праві праві)
      число-нуль)))
