; Д11 · перший елемент із явною ознакою наявності.
; Сімейство F11-EXPLICIT-PRESENCE. Нова бібліотечна композиція,
; а НЕ призначення координати чи машинного opcode Д11.
; Вхід: чистий предикат Value→Д1 та скінченний правильний список.
; Вихід: (так значення) при першому збігу; (ні ()) за відсутності.
; Д1 ні та структурне () можуть бути знайденими значеннями.
; Тільки D3:() завершує список; форма перевіряється один раз
; до виклику предиката, навіть коли перший елемент уже підходить.
; Реалізація не змінює стану та зупиняється на першому збігу.

; Одна перевірка D3-ланцюга, без копіювання списку.
(визначити перевірити-список-для-наявності
  (функція (поточний початковий)
    (за-умовою
      ; Тільки точне D3:() завершує перевірений хребет.
      ; D1:ні чи D7-атом відхиляємо через справжній D3 CAR Type.
      ((порожній? поточний) початковий)
      ((атом? поточний) (перше поточний))
      (так
       (перевірити-список-для-наявності
         (решта поточний) початковий)))))

; Після перевірки предикат завершує пошук на першому збігу.
(визначити знайти-перший-із-наявністю-ядро
  (функція (умова елементи)
    (за-умовою
      ((порожній? елементи) (список ні (як-є ())))
      ((умова (перше елементи)) (список так (перше елементи)))
      (так (знайти-перший-із-наявністю-ядро
             умова (решта елементи))))))

(визначити знайти-перший-із-наявністю
  (функція (умова елементи)
    (знайти-перший-із-наявністю-ядро
      умова (перевірити-список-для-наявності
              елементи елементи))))
