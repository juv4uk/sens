; Д11 · перший елемент із явною ознакою наявності.
; Сімейство F11-EXPLICIT-PRESENCE. Нова бібліотечна композиція,
; а НЕ призначення координати чи машинного opcode Д11.
; Вхід: чистий предикат Value→Д1 та скінченний правильний список.
; Вихід: (так значення) при першому збігу; (ні ()) за відсутності.
; Д1 ні та структурне () можуть бути знайденими значеннями.
; Порожній список — єдина ознака завершення. Неправильний атомний
; хвіст відхиляється через чинну помилку Д3 ПЕРШЕ, а не маскується.
; Реалізація не змінює стану та зупиняється на першому збігу.

(визначити знайти-перший-із-наявністю
  (функція (умова елементи)
    (за-умовою
      ((порожній? елементи) (список ні (як-є ())))
      ((атом? елементи) (перше елементи))
      ((умова (перше елементи))
       (список так (перше елементи)))
      (так
       (знайти-перший-із-наявністю
         умова (решта елементи))))))

; Точний D1:ні — знайдене значення, НЕ невдалий пошук.
(за-умовою
  ((однакові?
     (знайти-перший-із-наявністю
       (функція (елемент) (хибне? елемент))
       (список так ні так))
     (список так ні))
   так)
  (так (перше (як-є ()))))

; Структурний () також є допустимим знайденим елементом.
(за-умовою
  ((однакові?
     (знайти-перший-із-наявністю
       порожній?
       (список (як-є атом?) (як-є ())))
     (список так (як-є ())))
   так)
  (так (перше (як-є ()))))

; Відсутній атом дає (ні ()), а не (так ()).
(за-умовою
  ((однакові?
     (знайти-перший-із-наявністю
       (функція (елемент)
         (тотожне? елемент (як-є відсутній)))
       (як-є (перший другий)))
     (список ні (як-є ())))
   так)
  (так (перше (як-є ()))))

; Порожній список без виклику предиката — відсутність.
(за-умовою
  ((однакові?
     (знайти-перший-із-наявністю
       (функція (елемент) (перше (як-є ())))
       (як-є ()))
     (список ні (як-є ())))
   так)
  (так (перше (як-є ()))))

; Коротке замикання: не читаємо неправильний атомний хвіст
; після вже знайденого атома.
(за-умовою
  ((однакові?
     (знайти-перший-із-наявністю
       (функція (елемент)
         (тотожне? елемент (як-є знайдений)))
       (сполучити (як-є знайдений) (як-є не-список)))
     (список так (як-є знайдений)))
   так)
  (так (перше (як-є ()))))

; Негативний мутант: не можна прирівнювати знайдене НІ
; до відсутнього елемента.
(за-умовою
  ((хибне?
     (однакові?
       (знайти-перший-із-наявністю
         (функція (елемент) (хибне? елемент))
         (список ні))
       (список ні (як-є ()))))
   так)
  (так (перше (як-є ()))))

; Завершальний мовний вердикт.
(атом? (як-є ()))
