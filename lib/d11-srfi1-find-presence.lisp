; Д11 · перший елемент із явною ознакою наявності.
; Сімейство F11-EXPLICIT-PRESENCE. Нова бібліотечна композиція,
; а НЕ призначення координати чи машинного opcode Д11.
; Вхід: чистий предикат Value→Д1 та скінченний правильний список.
; Вихід: (так значення) при першому збігу; (ні ()) за відсутності.
; Д1 ні та структурне () можуть бути знайденими значеннями.
; Порожній список — єдина ознака завершення. Неправильний атомний
; хвіст відхиляється через чинну помилку Д3 ПЕРШЕ, а не маскується.
; Реалізація не змінює стану та зупиняється на першому збігу.

(визначити знайти-перший-із-наявністю
  (функція (умова елементи)
    (за-умовою
      ((порожній? елементи) (список ні (як-є ())))
      ((атом? елементи) (перше елементи))
      ((умова (перше елементи))
       (список так (перше елементи)))
      (так
       (знайти-перший-із-наявністю
         умова (решта елементи))))))

; У фізичному SENS Д3 EQ порівнює лише атоми.
; Списковий результат розбираємо через Д3 ПЕРШЕ/Д4 ДРУГЕ,
; а не застосовуємо атомну тотожність до цілої пари.

; Знайдений Д1:НІ є елементом, а не відсутністю.
((функція (результат)
   (за-умовою
     ((перше результат)
      (за-умовою
        ((хибне? (друге результат)) так)
        (так (перше (як-є ())))))
     (так (перше (як-є ())))))
 (знайти-перший-із-наявністю
   (функція (елемент) (хибне? елемент))
   (список так ні так)))

; Структурне () — знайдене значення із незалежним прапорцем ТАК.
((функція (результат)
   (за-умовою
     ((перше результат)
      (за-умовою
        ((порожній? (друге результат)) так)
        (так (перше (як-є ())))))
     (так (перше (як-є ())))))
 (знайти-перший-із-наявністю
   порожній?
   (список (як-є атом?) (як-є ()))))

; Відсутність: на списку тільки з Д1 ТАК предикат НЕ знаходить Д1 НІ.
((функція (результат)
   (за-умовою
     ((хибне? (перше результат))
      (за-умовою
        ((порожній? (друге результат)) так)
        (так (перше (як-є ())))))
     (так (перше (як-є ())))))
 (знайти-перший-із-наявністю
   (функція (елемент) (хибне? елемент))
   (список так так)))

; Порожній список не обчислює предикат із помилковим тілом.
((функція (результат)
   (за-умовою
     ((хибне? (перше результат))
      (за-умовою
        ((порожній? (друге результат)) так)
        (так (перше (як-є ())))))
     (так (перше (як-є ())))))
 (знайти-перший-із-наявністю
   (функція (елемент) (перше (як-є ())))
   (як-є ())))

; Коротке замикання: після знайденого Д1 НІ
; неправильний атомний хвіст не розіменовується.
((функція (результат)
   (за-умовою
     ((перше результат)
      (за-умовою
        ((хибне? (друге результат)) так)
        (так (перше (як-є ())))))
     (так (перше (як-є ())))))
 (знайти-перший-із-наявністю
   (функція (елемент) (хибне? елемент))
   (сполучити ні (як-є не-список))))

; Негативний мутант: коли знайдено НІ, прапорець НЕ стає НІ.
((функція (результат)
   (за-умовою
     ((хибне? (перше результат)) (перше (як-є ())))
     ((хибне? (друге результат)) так)
     (так (перше (як-є ())))))
 (знайти-перший-із-наявністю
   (функція (елемент) (хибне? елемент))
   (список ні)))

; Завершальний мовний вердикт.
(атом? (як-є ()))
