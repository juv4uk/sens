; СЕНС Д3 і Д5: стійко поділити власний список за будовою елементів.
; Перша частина - атоми (включно з порожній), друга - непорожні пари-списки.
; Порядок і кратність збережено; складені елементи не порівнюємо через ЕК.
; Розподіл обчислює СЕНС, Д7 є лише людською проєкцією, Зіг - транспорт.

(визначити вибрати-атомні-елементи
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((атом? (перше елементи))
       (сполучити (перше елементи)
         (вибрати-атомні-елементи (решта елементи))))
      (так (вибрати-атомні-елементи (решта елементи))))))

(визначити вибрати-складені-елементи
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((атом? (перше елементи))
       (вибрати-складені-елементи (решта елементи)))
      (так (сполучити (перше елементи)
             (вибрати-складені-елементи (решта елементи)))))))

(визначити розподілити-атоми-та-списки
  (функція (елементи)
    (список
      (вибрати-атомні-елементи елементи)
      (вибрати-складені-елементи елементи))))

; Кожен закон перевіряє власний СЕНС. Неправда викликає перше(порожній).
(визначити перевірити-розподіл
  (функція (умова)
    (за-умовою
      (умова (атом? (як-є ())))
      (так (перше (як-є ()))))))

(визначити змішаний-вхід
  (список
    (як-є атом?)
    (список (як-є решта) (як-є сполучити))
    (як-є ())
    (як-є тотожне?)
    (список (як-є сполучити))))
(визначити змішаний-розподіл (розподілити-атоми-та-списки змішаний-вхід))
(визначити атомна-частина (перше змішаний-розподіл))
(визначити складена-частина (друге змішаний-розподіл))

(визначити поділ-повторів
  (розподілити-атоми-та-списки
    (список (як-є решта) (список (як-є атом?))
            (як-є решта) (список (як-є атом?)))))
(визначити поділ-атомів
  (розподілити-атоми-та-списки
    (список (як-є решта) (як-є атом?))))
(визначити поділ-складених
  (розподілити-атоми-та-списки
    (список (список (як-є атом?)) (список (як-є решта)))))
(визначити поділ-порожнього
  (розподілити-атоми-та-списки (як-є ())))
(визначити поділ-вкладеної-порожнечі
  (розподілити-атоми-та-списки
    (список (список (як-є ())) (як-є ()))))

; Справжні позитивні та негативні предметні свідки.
(перевірити-розподіл (тотожне? (перше атомна-частина) (як-є атом?)))
(перевірити-розподіл (порожній? (друге атомна-частина)))
(перевірити-розподіл (тотожне? (третє атомна-частина) (як-є тотожне?)))
(перевірити-розподіл (порожній? (решта (решта (решта атомна-частина)))))
(перевірити-розподіл (хибне? (тотожне? (перше атомна-частина) (як-є тотожне?))))
(перевірити-розподіл (хибне? (порожній? атомна-частина)))
(перевірити-розподіл (хибне? (атом? (перше складена-частина))))
(перевірити-розподіл (тотожне? (перше (перше складена-частина)) (як-є решта)))
(перевірити-розподіл (тотожне? (друге (перше складена-частина)) (як-є сполучити)))
(перевірити-розподіл (порожній? (решта (решта (перше складена-частина)))))
(перевірити-розподіл (тотожне? (перше (друге складена-частина)) (як-є сполучити)))
(перевірити-розподіл (порожній? (решта (друге складена-частина))))
(перевірити-розподіл (порожній? (решта (решта складена-частина))))
(перевірити-розподіл (хибне? (тотожне? (перше (перше складена-частина)) (як-є атом?))))
(перевірити-розподіл (порожній? (перше поділ-порожнього)))
(перевірити-розподіл (порожній? (друге поділ-порожнього)))
(перевірити-розподіл (тотожне? (перше (перше поділ-атомів)) (як-є решта)))
(перевірити-розподіл (тотожне? (друге (перше поділ-атомів)) (як-є атом?)))
(перевірити-розподіл (порожній? (друге поділ-атомів)))
(перевірити-розподіл (порожній? (перше поділ-складених)))
(перевірити-розподіл (тотожне? (перше (перше (друге поділ-складених))) (як-є атом?)))
(перевірити-розподіл (тотожне? (перше (друге (друге поділ-складених))) (як-є решта)))
(перевірити-розподіл (порожній? (решта (решта (друге поділ-складених)))))
(перевірити-розподіл (тотожне? (перше (перше поділ-повторів)) (як-є решта)))
(перевірити-розподіл (тотожне? (друге (перше поділ-повторів)) (як-є решта)))
(перевірити-розподіл (порожній? (решта (решта (перше поділ-повторів)))))
(перевірити-розподіл (тотожне? (перше (перше (друге поділ-повторів))) (як-є атом?)))
(перевірити-розподіл (тотожне? (перше (друге (друге поділ-повторів))) (як-є атом?)))
(перевірити-розподіл (порожній? (решта (решта (друге поділ-повторів)))))
(перевірити-розподіл (порожній? (перше (перше поділ-вкладеної-порожнечі))))
(перевірити-розподіл (порожній? (перше (перше (друге поділ-вкладеної-порожнечі)))))
(перевірити-розподіл (порожній? (решта (друге поділ-вкладеної-порожнечі))))
(перевірити-розподіл (порожній? (решта (перше поділ-вкладеної-порожнечі))))
(перевірити-розподіл (хибне? (порожній? (друге поділ-вкладеної-порожнечі))))

(атом? (як-є ()))
