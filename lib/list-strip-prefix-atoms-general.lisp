; Д3 і Д5: зняти точний атомний префікс, якщо зразок збігається.
; При невідповідності початковий список НЕ змінюється.
; Обчислення лише СЕНС; Д7 - людська проєкція.
(визначити збіг-префікса-для-зняття?
  (функція (зразок вхід)
    (за-умовою
      ((порожній? зразок) так)
      ((порожній? вхід) ні)
      ((тотожне? (перше зразок) (перше вхід))
       (збіг-префікса-для-зняття? (решта зразок) (решта вхід)))
      ((атом? (як-є ())) ні))))

(визначити зняти-довжину-префікса
  (функція (зразок вхід)
    (за-умовою
      ((порожній? зразок) вхід)
      ((атом? (як-є ()))
       (зняти-довжину-префікса (решта зразок) (решта вхід))))))

(визначити зняти-атомний-префікс
  (функція (зразок вхід)
    (за-умовою
      ((збіг-префікса-для-зняття? зразок вхід)
       (зняти-довжину-префікса зразок вхід))
      ((атом? (як-є ())) вхід))))

(визначити знятий-хвіст
  (зняти-атомний-префікс
    (список (як-є атом?) (як-є решта))
    (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є атом?))))
(визначити невідповідний-вхід
  (зняти-атомний-префікс
    (список (як-є атом?) (як-є сполучити))
    (список (як-є атом?) (як-є решта) (як-є сполучити))))
(визначити задовгий-зразок
  (зняти-атомний-префікс
    (список (як-є атом?) (як-є решта))
    (список (як-є атом?))))

