; UTF-8 encoding and decoding semantics owned by Lisp.
; Семантика кодування й декодування UTF-8, якою володіє Lisp.
;
; Decoder input is a proper list of exact byte integers 0..255 and returns:
;   (decoded (codepoint ...))
; or
;   (rejected invalid-byte)
;   (rejected invalid-utf8)
;
; Encoder input is a runtime String and returns its exact UTF-8 bytes as a
; proper list of integers 0..255. Unicode sequence validation and both
; byte<->scalar interpretations stay here in Lisp. The runtime exposes only
; the minimal scalar/string bridges `codepoint->string` and
; `string->codepoint`; neither bridge knows UTF-8.

; UTF-8 predicate verdicts are direct D1 bits: #d1:1 / #d1:0.
; Structural () remains data; byte arithmetic remains in its admitted numeric roles.
(визначити utf8-in-range?
  (функція (value low high)
    (за-умовою
      ((менше? value low)  ні)
      ((хибне? (менше? value low))
       (за-умовою
         ((хибне? (менше? high value))  так)
         ((хибне? (хибне? (менше? high value))) ні))))))

(визначити utf8-continuation-byte?
  (функція (b)
    (за-умовою
      ((кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? b 128 191)  так)
      ((хибне? (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? b 128 191)) ні))))

(визначити utf8-byte?
  (функція (b)
    (за-умовою
      ((кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? b 0 255) 
       (за-умовою
         ((тотожне? (модульна-остача b 1) 0)  так)
         ((хибне? (тотожне? (модульна-остача b 1) 0)) ні)))
      ((хибне? (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? b 0 255)) ні))))

(визначити utf8-all-bytes?
  (функція (bytes)
    (за-умовою
      ((атом? bytes)
       (за-умовою
         ((тотожне? bytes (як-є ()))  так)
         ((хибне? (тотожне? bytes (як-є ()))) ні)))
      ((хибне? (атом? bytes))
       (за-умовою
         ((це-допустимий-байт-кодування-юнікод-8? (перше bytes)) 
          (усі-елементи-є-байтами-кодування-юнікод-8? (решта bytes)))
         ((хибне? (це-допустимий-байт-кодування-юнікод-8? (перше bytes))) ні))))))

(визначити utf8-three-byte-second-ok?
  (функція (b1 b2)
    (за-умовою
      ((тотожне? b1 224) 
       (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? b2 160 191))
      ((хибне? (тотожне? b1 224))
       (за-умовою
         ((тотожне? b1 237) 
          (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? b2 128 159))
         ((хибне? (тотожне? b1 237))
          (це-байт-продовження-кодування-юнікод-8? b2)))))))

(визначити utf8-four-byte-second-ok?
  (функція (b1 b2)
    (за-умовою
      ((тотожне? b1 240) 
       (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? b2 144 191))
      ((хибне? (тотожне? b1 240))
       (за-умовою
         ((тотожне? b1 244) 
          (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? b2 128 143))
         ((хибне? (тотожне? b1 244))
          (це-байт-продовження-кодування-юнікод-8? b2)))))))

(визначити utf8-two-continuations?
  (функція (b3 b4)
    (за-умовою
      ((це-байт-продовження-кодування-юнікод-8? b3) 
       (за-умовою
         ((це-байт-продовження-кодування-юнікод-8? b4)  так)
         ((хибне? (це-байт-продовження-кодування-юнікод-8? b4)) ні)))
      ((хибне? (це-байт-продовження-кодування-юнікод-8? b3)) ні))))

(визначити utf8-decode-onto
  (функція (bytes out)
    (за-умовою
      ((атом? bytes)
       (список (як-є decoded) (зворот out)))
      ((хибне? (атом? bytes))
       (нехай-послідовно ((b1 (перше bytes))
              (r1 (решта bytes)))
         (за-умовою
           ; ASCII
           ((хибне? (менше? 127 b1)) 
            (utf8-decode-onto r1 (сполучити b1 out)))
           ((хибне? (хибне? (менше? 127 b1)))
            (за-умовою
              ; 2-byte sequence: C2..DF 80..BF
              ((кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? b1 194 223) 
               (за-умовою
                 ((атом? r1)
                  (список (як-є rejected) (як-є invalid-utf8)))
                 ((хибне? (атом? r1))
                  (нехай ((b2 (перше r1)))
                    (за-умовою
                      ((це-байт-продовження-кодування-юнікод-8? b2) 
                       (utf8-decode-onto
                         (решта r1)
                         (сполучити (додати (помножити (відняти b1 192) 64)
                                  (відняти b2 128))
                               out)))
                      ((хибне? (це-байт-продовження-кодування-юнікод-8? b2))
                       (список (як-є rejected) (як-є invalid-utf8))))))))
              ((хибне? (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? b1 194 223))
               (за-умовою
                 ; 3-byte sequence with overlong/surrogate exclusions.
                 ((кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? b1 224 239) 
                  (за-умовою
                    ((атом? r1)
                     (список (як-є rejected) (як-є invalid-utf8)))
                    ((хибне? (атом? r1))
                     (нехай ((r2 (решта r1)))
                       (за-умовою
                         ((атом? r2)
                          (список (як-є rejected) (як-є invalid-utf8)))
                         ((хибне? (атом? r2))
                          (нехай-послідовно ((b2 (перше r1))
                                 (b3 (перше r2)))
                            (за-умовою
                              ((другий-байт-трибайтової-послідовності-кодування-юнікод-8-коректний? b1 b2) 
                               (за-умовою
                                 ((це-байт-продовження-кодування-юнікод-8? b3) 
                                  (utf8-decode-onto
                                    (решта r2)
                                    (сполучити (додати (додати (помножити (відняти b1 224) 4096)
                                                (помножити (відняти b2 128) 64))
                                             (відняти b3 128))
                                          out)))
                                 ((хибне? (це-байт-продовження-кодування-юнікод-8? b3))
                                  (список (як-є rejected)
                                        (як-є invalid-utf8)))))
                              ((хибне? (другий-байт-трибайтової-послідовності-кодування-юнікод-8-коректний? b1 b2))
                               (список (як-є rejected)
                                     (як-є invalid-utf8)))))))))))
                 ((хибне? (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? b1 224 239))
                  (за-умовою
                    ; 4-byte sequence, restricted to Unicode scalar <= 10FFFF.
                    ((кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? b1 240 244) 
                     (за-умовою
                       ((атом? r1)
                        (список (як-є rejected) (як-є invalid-utf8)))
                       ((хибне? (атом? r1))
                        (нехай ((r2 (решта r1)))
                          (за-умовою
                            ((атом? r2)
                             (список (як-є rejected) (як-є invalid-utf8)))
                            ((хибне? (атом? r2))
                             (нехай ((r3 (решта r2)))
                               (за-умовою
                                 ((атом? r3)
                                  (список (як-є rejected) (як-є invalid-utf8)))
                                 ((хибне? (атом? r3))
                                  (нехай-послідовно ((b2 (перше r1))
                                         (b3 (перше r2))
                                         (b4 (перше r3)))
                                    (за-умовою
                                      ((другий-байт-чотирибайтової-послідовності-кодування-юнікод-8-коректний? b1 b2) 
                                       (за-умовою
                                         ((наявні-два-байти-продовження-кодування-юнікод-8? b3 b4) 
                                          (utf8-decode-onto
                                            (решта r3)
                                            (сполучити (додати (додати (додати (помножити (відняти b1 240) 262144)
                                                           (помножити (відняти b2 128) 4096))
                                                        (помножити (відняти b3 128) 64))
                                                     (відняти b4 128))
                                                  out)))
                                         ((хибне? (наявні-два-байти-продовження-кодування-юнікод-8? b3 b4))
                                          (список (як-є rejected)
                                                (як-є invalid-utf8)))))
                                      ((хибне? (другий-байт-чотирибайтової-послідовності-кодування-юнікод-8-коректний? b1 b2))
                                       (список (як-є rejected)
                                             (як-є invalid-utf8))))))))))))
                         ))
                    ((хибне? (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? b1 240 244))
                     (список (як-є rejected) (як-є invalid-utf8)))))
              )))
          )))
    ))))

(визначити utf8-decode
  (функція (bytes)
    (за-умовою
      ((усі-елементи-є-байтами-кодування-юнікод-8? bytes) 
       (utf8-decode-onto bytes (як-є ())))
      ((хибне? (усі-елементи-є-байтами-кодування-юнікод-8? bytes))
       (список (як-є rejected) (як-є invalid-byte))))))

(визначити utf8-valid?
  (функція (bytes)
    (тотожне? (перше (кодування-юнікод-8-декодувати bytes)) (як-є decoded))))

; Keep text materialization in tail position.
(визначити unicode-scalars->string-onto
  (функція (scalars out)
    (за-умовою
      ((атом? scalars)
       out)
      ((хибне? (атом? scalars))
       (unicode-scalars->string-onto
         (решта scalars)
         (рядок-додати out (символ-за-кодом (перше scalars))))))))

(визначити unicode-scalars->string
  (функція (scalars)
    (unicode-scalars->string-onto scalars "")))

; D6 LET is ratified but this path does not infer executable binding
; from a bare numeric head. Use the admitted D4 LAMBDA application, like TCP.
; Decode once; the original two-branch semantic law remains SENS-owned.
(визначити utf8-decode-string
  (функція (bytes)
    ((функція (decoded)
       (за-умовою
         ((тотожне? (перше decoded) (як-є decoded))
          (список (як-є decoded)
                (unicode-scalars->string (перше (решта decoded)))))
         ((хибне? (тотожне? (перше decoded) (як-є decoded)))
          decoded)))
     (кодування-юнікод-8-декодувати bytes))))

(визначити utf8-encode-string-onto
  (функція (text out)
    (за-умовою
      ((рядок-порожній? text)
       
       (зворот out))
      ((хибне? (рядок-порожній? text))
       (нехай-послідовно ((character (рядок-перший text))
              (rest (рядок-решта text))
              (scalar (код-символу character)))
         (за-умовою
           ((хибне? (менше? 127 scalar)) 
            (utf8-encode-string-onto rest (сполучити scalar out)))
           ((хибне? (хибне? (менше? 127 scalar)))
            (за-умовою
              ((хибне? (менше? 2047 scalar)) 
               (utf8-encode-string-onto
                 rest
                 (сполучити (додати 128 (модульна-остача scalar 64))
                       (сполучити (додати 192 (округлити-вниз scalar 64)) out))))
              ((хибне? (хибне? (менше? 2047 scalar)))
               (за-умовою
                 ((хибне? (менше? 65535 scalar)) 
                  (utf8-encode-string-onto
                    rest
                    (сполучити (додати 128 (модульна-остача scalar 64))
                          (сполучити (додати 128 (модульна-остача (округлити-вниз scalar 64) 64))
                                (сполучити (додати 224 (округлити-вниз scalar 4096))
                                      out)))))
                 ((хибне? (хибне? (менше? 65535 scalar)))
                  (utf8-encode-string-onto
                    rest
                    (сполучити (додати 128 (модульна-остача scalar 64))
                          (сполучити (додати 128 (модульна-остача (округлити-вниз scalar 64) 64))
                                (сполучити (додати 128 (модульна-остача (округлити-вниз scalar 4096) 64))
                                      (сполучити (додати 240 (округлити-вниз scalar 262144))
                                            out))))))))))))))))

(визначити utf8-encode-string
  (функція (text)
    (utf8-encode-string-onto text (як-є ()))))

; D9 ratified UTF-8 Ukrainian projection; existing SENS Lisp codec is owner.
; These names do not assert direct D9 opcode callability.
; D9:000001001
(визначити utf8-декодувати utf8-decode)
; D9:000101011
(визначити utf8-чинний? utf8-valid?)
; D9:000100010
(визначити unicode-скаляри-рядок unicode-scalars->string)
; D9:000001010
(визначити utf8-декодувати-рядок utf8-decode-string)
; D9:000010101
(визначити utf8-кодувати-рядок utf8-encode-string)

