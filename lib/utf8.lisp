(визначити кодування-число-шістнадцять (довжина (як-є (а б в г ґ д е є ж з и і ї й к л))))
(визначити кодування-число-тридцять-два (помножити кодування-число-два кодування-число-шістнадцять))
(визначити кодування-число-шістдесят-чотири (помножити кодування-число-чотири (помножити кодування-число-чотири кодування-число-чотири)))
(визначити кодування-число-сто-двадцять-вісім (помножити кодування-число-два кодування-число-шістдесят-чотири))
(визначити кодування-число-сто-двадцять-сім (відняти кодування-число-сто-двадцять-вісім кодування-число-один))
(визначити кодування-число-сто-сорок-три (додати кодування-число-сто-двадцять-вісім кодування-число-п'ятнадцять))
(визначити кодування-число-сто-сорок-чотири (додати кодування-число-сто-двадцять-вісім кодування-число-шістнадцять))
(визначити кодування-число-тридцять-один (додати кодування-число-шістнадцять кодування-число-п'ятнадцять))
(визначити кодування-число-сто-п'ятдесят-дев'ять (додати кодування-число-сто-двадцять-вісім кодування-число-тридцять-один))
(визначити кодування-число-сто-шістдесят (додати кодування-число-сто-двадцять-вісім кодування-число-тридцять-два))
(визначити кодування-число-сто-дев'яносто-два (помножити кодування-число-три кодування-число-шістдесят-чотири))
(визначити кодування-число-сто-дев'яносто-один (відняти кодування-число-сто-дев'яносто-два кодування-число-один))
(визначити кодування-число-сто-дев'яносто-чотири (додати кодування-число-сто-дев'яносто-два кодування-число-два))
(визначити кодування-число-двісті-двадцять-чотири (помножити кодування-число-сім кодування-число-тридцять-два))
(визначити кодування-число-двісті-двадцять-три (відняти кодування-число-двісті-двадцять-чотири кодування-число-один))
(визначити кодування-число-двісті-тридцять-сім (додати кодування-число-двісті-двадцять-чотири кодування-число-тринадцять))
(визначити кодування-число-двісті-тридцять-дев'ять (додати кодування-число-двісті-двадцять-чотири кодування-число-п'ятнадцять))
(визначити кодування-число-двісті-сорок (додати кодування-число-двісті-двадцять-чотири кодування-число-шістнадцять))
(визначити кодування-число-двісті-сорок-чотири (додати кодування-число-двісті-сорок кодування-число-чотири))
(визначити кодування-число-двісті-п'ятдесят-шість (помножити кодування-число-шістнадцять кодування-число-шістнадцять))
(визначити кодування-число-двісті-п'ятдесят-п'ять (відняти кодування-число-двісті-п'ятдесят-шість кодування-число-один))
(визначити кодування-число-дві-тисячі-сорок-сім (відняти (помножити кодування-число-тридцять-два кодування-число-шістдесят-чотири) кодування-число-один))
(визначити кодування-число-чотири-тисячі-дев'яносто-шість (помножити кодування-число-шістдесят-чотири кодування-число-шістдесят-чотири))
(визначити кодування-число-шістдесят-п'ять-тисяч-п'ятсот-тридцять-шість (помножити кодування-число-двісті-п'ятдесят-шість кодування-число-двісті-п'ятдесят-шість))
(визначити кодування-число-шістдесят-п'ять-тисяч-п'ятсот-тридцять-п'ять (відняти кодування-число-шістдесят-п'ять-тисяч-п'ятсот-тридцять-шість кодування-число-один))
(визначити кодування-число-двісті-шістдесят-дві-тисячі-сто-сорок-чотири (помножити кодування-число-чотири-тисячі-дев'яносто-шість кодування-число-шістдесят-чотири))

(визначити кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні?
  (функція (величина нижня-межа верхня-межа)
    (за-умовою
      ((менше? величина нижня-межа)  (атом? (як-є (()))))
      ((хибне? (менше? величина нижня-межа))
       (за-умовою
         ((хибне? (менше? верхня-межа величина))  (атом? (як-є ())))
         ((хибне? (хибне? (менше? верхня-межа величина))) (атом? (як-є (())))))))))

(визначити це-байт-продовження-кодування-юнікод-8?
  (функція (байт)
    (за-умовою
      ((кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? байт кодування-число-сто-двадцять-вісім кодування-число-сто-дев'яносто-один)  (атом? (як-є ())))
      ((хибне? (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? байт кодування-число-сто-двадцять-вісім кодування-число-сто-дев'яносто-один)) (атом? (як-є (())))))))

(визначити це-допустимий-байт-кодування-юнікод-8?
  (функція (байт)
    (за-умовою
      ((кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? байт кодування-число-нуль кодування-число-двісті-п'ятдесят-п'ять) 
       (за-умовою
         ((тотожне? (модульна-остача байт кодування-число-один) кодування-число-нуль)  (атом? (як-є ())))
         ((хибне? (тотожне? (модульна-остача байт кодування-число-один) кодування-число-нуль)) (атом? (як-є (()))))))
      ((хибне? (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? байт кодування-число-нуль кодування-число-двісті-п'ятдесят-п'ять)) (атом? (як-є (())))))))

(визначити усі-елементи-є-байтами-кодування-юнікод-8?
  (функція (вхідні-байти)
    (за-умовою
      ((атом? вхідні-байти)
       (порожній? вхідні-байти))
      ((хибне? (атом? вхідні-байти))
       (за-умовою
         ((це-допустимий-байт-кодування-юнікод-8? (перше вхідні-байти)) 
          (усі-елементи-є-байтами-кодування-юнікод-8? (решта вхідні-байти)))
         ((хибне? (це-допустимий-байт-кодування-юнікод-8? (перше вхідні-байти))) (атом? (як-є (())))))))))

(визначити другий-байт-трибайтової-послідовності-кодування-юнікод-8-коректний?
  (функція (перший-байт другий-байт)
    (за-умовою
      ((тотожне? перший-байт кодування-число-двісті-двадцять-чотири) 
       (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? другий-байт кодування-число-сто-шістдесят кодування-число-сто-дев'яносто-один))
      ((хибне? (тотожне? перший-байт кодування-число-двісті-двадцять-чотири))
       (за-умовою
         ((тотожне? перший-байт кодування-число-двісті-тридцять-сім) 
          (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? другий-байт кодування-число-сто-двадцять-вісім кодування-число-сто-п'ятдесят-дев'ять))
         ((хибне? (тотожне? перший-байт кодування-число-двісті-тридцять-сім))
          (це-байт-продовження-кодування-юнікод-8? другий-байт)))))))

(визначити другий-байт-чотирибайтової-послідовності-кодування-юнікод-8-коректний?
  (функція (перший-байт другий-байт)
    (за-умовою
      ((тотожне? перший-байт кодування-число-двісті-сорок) 
       (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? другий-байт кодування-число-сто-сорок-чотири кодування-число-сто-дев'яносто-один))
      ((хибне? (тотожне? перший-байт кодування-число-двісті-сорок))
       (за-умовою
         ((тотожне? перший-байт кодування-число-двісті-сорок-чотири) 
          (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? другий-байт кодування-число-сто-двадцять-вісім кодування-число-сто-сорок-три))
         ((хибне? (тотожне? перший-байт кодування-число-двісті-сорок-чотири))
          (це-байт-продовження-кодування-юнікод-8? другий-байт)))))))

(визначити наявні-два-байти-продовження-кодування-юнікод-8?
  (функція (третій-байт четвертий-байт)
    (за-умовою
      ((це-байт-продовження-кодування-юнікод-8? третій-байт) 
       (за-умовою
         ((це-байт-продовження-кодування-юнікод-8? четвертий-байт)  (атом? (як-є ())))
         ((хибне? (це-байт-продовження-кодування-юнікод-8? четвертий-байт)) (атом? (як-є (()))))))
      ((хибне? (це-байт-продовження-кодування-юнікод-8? третій-байт)) (атом? (як-є (())))))))

(визначити кодування-юнікод-8-декодувати-до
  (функція (вхідні-байти накопичені-байти)
    (за-умовою
      ((атом? вхідні-байти)
       (список (як-є decoded) (зворот накопичені-байти)))
      ((хибне? (атом? вхідні-байти))
       (нехай-послідовно ((перший-байт (перше вхідні-байти))
              (решта-байтів (решта вхідні-байти)))
         (за-умовою
           ; Однобайтове значення
           ((хибне? (менше? кодування-число-сто-двадцять-сім перший-байт)) 
            (кодування-юнікод-8-декодувати-до решта-байтів (сполучити перший-байт накопичені-байти)))
           ((хибне? (хибне? (менше? кодування-число-сто-двадцять-сім перший-байт)))
            (за-умовою
              ; Двобайтова послідовність із перевіркою продовження
              ((кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? перший-байт кодування-число-сто-дев'яносто-чотири кодування-число-двісті-двадцять-три) 
               (за-умовою
                 ((атом? решта-байтів)
                  (список (як-є rejected) (як-є invalid-utf8)))
                 ((хибне? (атом? решта-байтів))
                  (нехай ((другий-байт (перше решта-байтів)))
                    (за-умовою
                      ((це-байт-продовження-кодування-юнікод-8? другий-байт) 
                       (кодування-юнікод-8-декодувати-до
                         (решта решта-байтів)
                         (сполучити (додати (помножити (відняти перший-байт кодування-число-сто-дев'яносто-два) кодування-число-шістдесят-чотири)
                                  (відняти другий-байт кодування-число-сто-двадцять-вісім))
                               накопичені-байти)))
                      ((хибне? (це-байт-продовження-кодування-юнікод-8? другий-байт))
                       (список (як-є rejected) (як-є invalid-utf8))))))))
              ((хибне? (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? перший-байт кодування-число-сто-дев'яносто-чотири кодування-число-двісті-двадцять-три))
               (за-умовою
                 ; Трибайтова послідовність без надлишкового кодування й сурогатів
                 ((кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? перший-байт кодування-число-двісті-двадцять-чотири кодування-число-двісті-тридцять-дев'ять) 
                  (за-умовою
                    ((атом? решта-байтів)
                     (список (як-є rejected) (як-є invalid-utf8)))
                    ((хибне? (атом? решта-байтів))
                     (нехай ((решта-решти-байтів (решта решта-байтів)))
                       (за-умовою
                         ((атом? решта-решти-байтів)
                          (список (як-є rejected) (як-є invalid-utf8)))
                         ((хибне? (атом? решта-решти-байтів))
                          (нехай-послідовно ((другий-байт (перше решта-байтів))
                                 (третій-байт (перше решта-решти-байтів)))
                            (за-умовою
                              ((другий-байт-трибайтової-послідовності-кодування-юнікод-8-коректний? перший-байт другий-байт) 
                               (за-умовою
                                 ((це-байт-продовження-кодування-юнікод-8? третій-байт) 
                                  (кодування-юнікод-8-декодувати-до
                                    (решта решта-решти-байтів)
                                    (сполучити (додати (додати (помножити (відняти перший-байт кодування-число-двісті-двадцять-чотири) кодування-число-чотири-тисячі-дев'яносто-шість)
                                                (помножити (відняти другий-байт кодування-число-сто-двадцять-вісім) кодування-число-шістдесят-чотири))
                                             (відняти третій-байт кодування-число-сто-двадцять-вісім))
                                          накопичені-байти)))
                                 ((хибне? (це-байт-продовження-кодування-юнікод-8? третій-байт))
                                  (список (як-є rejected)
                                        (як-є invalid-utf8)))))
                              ((хибне? (другий-байт-трибайтової-послідовності-кодування-юнікод-8-коректний? перший-байт другий-байт))
                               (список (як-є rejected)
                                     (як-є invalid-utf8)))))))))))
                 ((хибне? (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? перший-байт кодування-число-двісті-двадцять-чотири кодування-число-двісті-тридцять-дев'ять))
                  (за-умовою
                    ; Чотирибайтова послідовність тільки для скалярів Юнікоду
                    ((кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? перший-байт кодування-число-двісті-сорок кодування-число-двісті-сорок-чотири) 
                     (за-умовою
                       ((атом? решта-байтів)
                        (список (як-є rejected) (як-є invalid-utf8)))
                       ((хибне? (атом? решта-байтів))
                        (нехай ((решта-решти-байтів (решта решта-байтів)))
                          (за-умовою
                            ((атом? решта-решти-байтів)
                             (список (як-є rejected) (як-є invalid-utf8)))
                            ((хибне? (атом? решта-решти-байтів))
                             (нехай ((решта-після-третього-байта (решта решта-решти-байтів)))
                               (за-умовою
                                 ((атом? решта-після-третього-байта)
                                  (список (як-є rejected) (як-є invalid-utf8)))
                                 ((хибне? (атом? решта-після-третього-байта))
                                  (нехай-послідовно ((другий-байт (перше решта-байтів))
                                         (третій-байт (перше решта-решти-байтів))
                                         (четвертий-байт (перше решта-після-третього-байта)))
                                    (за-умовою
                                      ((другий-байт-чотирибайтової-послідовності-кодування-юнікод-8-коректний? перший-байт другий-байт) 
                                       (за-умовою
                                         ((наявні-два-байти-продовження-кодування-юнікод-8? третій-байт четвертий-байт) 
                                          (кодування-юнікод-8-декодувати-до
                                            (решта решта-після-третього-байта)
                                            (сполучити (додати (додати (додати (помножити (відняти перший-байт кодування-число-двісті-сорок) кодування-число-двісті-шістдесят-дві-тисячі-сто-сорок-чотири)
                                                           (помножити (відняти другий-байт кодування-число-сто-двадцять-вісім) кодування-число-чотири-тисячі-дев'яносто-шість))
                                                        (помножити (відняти третій-байт кодування-число-сто-двадцять-вісім) кодування-число-шістдесят-чотири))
                                                     (відняти четвертий-байт кодування-число-сто-двадцять-вісім))
                                                  накопичені-байти)))
                                         ((хибне? (наявні-два-байти-продовження-кодування-юнікод-8? третій-байт четвертий-байт))
                                          (список (як-є rejected)
                                                (як-є invalid-utf8)))))
                                      ((хибне? (другий-байт-чотирибайтової-послідовності-кодування-юнікод-8-коректний? перший-байт другий-байт))
                                       (список (як-є rejected)
                                             (як-є invalid-utf8))))))))))))
                         ))
                    ((хибне? (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? перший-байт кодування-число-двісті-сорок кодування-число-двісті-сорок-чотири))
                     (список (як-є rejected) (як-є invalid-utf8)))))
              )))
          )))
    ))))

; Декодування використовує безпосереднє українське визначення,
; без проміжного латинського псевдоніма.

(визначити кодування-юнікод-8-декодувати
  (функція (вхідні-байти)
    (за-умовою
      ((усі-елементи-є-байтами-кодування-юнікод-8? вхідні-байти) 
       (кодування-юнікод-8-декодувати-до вхідні-байти (як-є ())))
      ((хибне? (усі-елементи-є-байтами-кодування-юнікод-8? вхідні-байти))
       (список (як-є rejected) (як-є invalid-byte))))))

(визначити кодування-юнікод-8-чинний?
  (функція (вхідні-байти)
    (однакові? (перше (кодування-юнікод-8-декодувати вхідні-байти)) (як-є decoded))))

; Побудова рядка залишається у хвостовій позиції
(визначити юнікод-скаляри-рядок-до
  (функція (скаляри)
    (за-умовою
      ((атом? скаляри)
       "")
      ((хибне? (атом? скаляри))
       (за-умовою
         ((атом? (решта скаляри))
          (символ-за-кодом (перше скаляри)))
         ((хибне? (атом? (решта скаляри)))
          (рядок-додати
            (символ-за-кодом (перше скаляри))
            (юнікод-скаляри-рядок-до (решта скаляри)))))))))

(визначити юнікод-скаляри-рядок
  (функція (скаляри)
    (юнікод-скаляри-рядок-до скаляри)))

; Тільки зовнішня межа UTF-8/Unicode: D7 уже кодує
; українську клавіатуру семибітними координатами і не потребує
; повторного Unicode-перетворення всередині SENS.
; Декодування виконуємо один раз і передаємо результат іменованій
; SENS-функції: без недопущеного D5 value-call анонімної FUNCTION.
(визначити кодування-юнікод-8-результат-у-рядок
  (функція (розкодоване)
    (за-умовою
      ((однакові? (перше розкодоване) (як-є decoded))
       (список (як-є decoded)
               (юнікод-скаляри-рядок (перше (решта розкодоване)))))
      ((хибне? (однакові? (перше розкодоване) (як-є decoded)))
       розкодоване))))

(визначити кодування-юнікод-8-декодувати-рядок
  (функція (вхідні-байти)
    (кодування-юнікод-8-результат-у-рядок
      (кодування-юнікод-8-декодувати вхідні-байти))))

; UTF-8 є тільки зовнішнім байтовим кордоном; D7 всередині SENS
; не перетворюється на Юнікод заради клавіатурних символів.
; D5 «частка» — точне раціональне ділення, а не ціла частка;
; a - b*(a/b) занулює остачу. Для кодових точок 0..1114111
; та додатних дільників отримуємо цілі байти засобами самої SENS.
; Подвоєний блок обчислюється логарифмічно, без host-конвертації.
(визначити кодування-юнікод-8-знайти-блок
  (функція (число межа множник)
    (за-умовою
      ((менше? число (додати межа межа))
       (список межа множник))
      ((атом? (як-є ()))
       (кодування-юнікод-8-знайти-блок
         число (додати межа межа) (додати множник множник))))))

; Параметри числа і дільника передаються явно, а не захоплюються
; в ініціалізаторі НЕХАЙ. Це запобігає помилці відсутнього джерельного
; значення лексичного слота й зберігає логарифмічний пошук блока.
(визначити кодування-юнікод-8-ціла-частка-із-блоком
  (функція (число дільник знайдений-блок)
    (додати
      (друге знайдений-блок)
      (кодування-юнікод-8-ціла-частка
        (відняти число (перше знайдений-блок))
        дільник))))

(визначити кодування-юнікод-8-ціла-частка
  (функція (число дільник)
    (за-умовою
      ((менше? число дільник) кодування-число-нуль)
      ((атом? (як-є ()))
       (кодування-юнікод-8-ціла-частка-із-блоком
         число дільник
         (кодування-юнікод-8-знайти-блок
           число дільник кодування-число-один))))))

(визначити кодування-юнікод-8-ціла-остача
  (функція (число дільник)
    (відняти число
      (помножити дільник
        (кодування-юнікод-8-ціла-частка число дільник)))))

(визначити кодування-юнікод-8-кодувати-рядок-до
  (функція (текст накопичені-байти)
    (за-умовою
      ((рядок-порожній? текст)
       
       (зворот накопичені-байти))
      ((хибне? (рядок-порожній? текст))
       (нехай-послідовно ((символ (рядок-перший текст))
              (решта-рядка (рядок-решта текст))
              (кодова-точка (код-символу символ)))
         (за-умовою
           ((хибне? (менше? кодування-число-сто-двадцять-сім кодова-точка)) 
            (кодування-юнікод-8-кодувати-рядок-до решта-рядка (сполучити кодова-точка накопичені-байти)))
           ((хибне? (хибне? (менше? кодування-число-сто-двадцять-сім кодова-точка)))
            (за-умовою
              ((хибне? (менше? кодування-число-дві-тисячі-сорок-сім кодова-точка)) 
               (кодування-юнікод-8-кодувати-рядок-до
                 решта-рядка
                 (сполучити (додати кодування-число-сто-двадцять-вісім (кодування-юнікод-8-ціла-остача кодова-точка кодування-число-шістдесят-чотири))
                       (сполучити (додати кодування-число-сто-дев'яносто-два (кодування-юнікод-8-ціла-частка кодова-точка кодування-число-шістдесят-чотири)) накопичені-байти))))
              ((хибне? (хибне? (менше? кодування-число-дві-тисячі-сорок-сім кодова-точка)))
               (за-умовою
                 ((хибне? (менше? кодування-число-шістдесят-п'ять-тисяч-п'ятсот-тридцять-п'ять кодова-точка)) 
                  (кодування-юнікод-8-кодувати-рядок-до
                    решта-рядка
                    (сполучити (додати кодування-число-сто-двадцять-вісім (кодування-юнікод-8-ціла-остача кодова-точка кодування-число-шістдесят-чотири))
                          (сполучити (додати кодування-число-сто-двадцять-вісім (кодування-юнікод-8-ціла-остача (кодування-юнікод-8-ціла-частка кодова-точка кодування-число-шістдесят-чотири) кодування-число-шістдесят-чотири))
                                (сполучити (додати кодування-число-двісті-двадцять-чотири (кодування-юнікод-8-ціла-частка кодова-точка кодування-число-чотири-тисячі-дев'яносто-шість))
                                      накопичені-байти)))))
                 ((хибне? (хибне? (менше? кодування-число-шістдесят-п'ять-тисяч-п'ятсот-тридцять-п'ять кодова-точка)))
                  (кодування-юнікод-8-кодувати-рядок-до
                    решта-рядка
                    (сполучити (додати кодування-число-сто-двадцять-вісім (кодування-юнікод-8-ціла-остача кодова-точка кодування-число-шістдесят-чотири))
                          (сполучити (додати кодування-число-сто-двадцять-вісім (кодування-юнікод-8-ціла-остача (кодування-юнікод-8-ціла-частка кодова-точка кодування-число-шістдесят-чотири) кодування-число-шістдесят-чотири))
                                (сполучити (додати кодування-число-сто-двадцять-вісім (кодування-юнікод-8-ціла-остача (кодування-юнікод-8-ціла-частка кодова-точка кодування-число-чотири-тисячі-дев'яносто-шість) кодування-число-шістдесят-чотири))
                                      (сполучити (додати кодування-число-двісті-сорок (кодування-юнікод-8-ціла-частка кодова-точка кодування-число-двісті-шістдесят-дві-тисячі-сто-сорок-чотири))
                                            накопичені-байти))))))))))))))))

(визначити кодування-юнікод-8-кодувати-рядок
  (функція (текст)
    (кодування-юнікод-8-кодувати-рядок-до текст (як-є ()))))

; Ратифікована драбина D9 визначає канонічні українські назви
; кодека та перевірки коректності. Похідна реалізація вище не створює
; самостійного машинного коду й не потребує латинських псевдонімів.
; Історичні бітові координати звіряємо тільки за чинною таблицею D9.
