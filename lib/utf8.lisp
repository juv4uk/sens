; UTF-8 encoding and decoding semantics owned by Lisp.
; Семантика кодування й декодування UTF-8, якою володіє Lisp.
;
; Decoder input is a proper list of exact byte integers 0..255 and returns:
;   (decoded (codepoint ...))
; or
;   (rejected invalid-byte)
;   (rejected invalid-utf8)
;
; Encoder input is a runtime String and returns its exact UTF-8 bytes as a
; proper list of integers 0..255. Unicode sequence validation and both
; byte<->scalar interpretations stay here in Lisp. The runtime exposes only
; the minimal scalar/string bridges `codepoint->string` and
; `string->codepoint`; neither bridge knows UTF-8.

; UTF-8 predicate verdicts are direct D1 bits: #d1:1 / #d1:0.
; Structural () remains data; byte arithmetic remains in its admitted numeric roles.
(визначити utf8-in-range?
  (функція (величина нижня-межа верхня-межа)
    (за-умовою
      ((менше? величина нижня-межа)  ні)
      ((хибне? (менше? величина нижня-межа))
       (за-умовою
         ((хибне? (менше? верхня-межа величина))  так)
         ((хибне? (хибне? (менше? верхня-межа величина))) ні))))))

(визначити utf8-continuation-byte?
  (функція (байт)
    (за-умовою
      ((кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? байт 128 191)  так)
      ((хибне? (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? байт 128 191)) ні))))

(визначити utf8-byte?
  (функція (байт)
    (за-умовою
      ((кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? байт 0 255) 
       (за-умовою
         ((тотожне? (модульна-остача байт 1) 0)  так)
         ((хибне? (тотожне? (модульна-остача байт 1) 0)) ні)))
      ((хибне? (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? байт 0 255)) ні))))

(визначити utf8-all-bytes?
  (функція (вхідні-байти)
    (за-умовою
      ((атом? вхідні-байти)
       (за-умовою
         ((тотожне? вхідні-байти (як-є ()))  так)
         ((хибне? (тотожне? вхідні-байти (як-є ()))) ні)))
      ((хибне? (атом? вхідні-байти))
       (за-умовою
         ((це-допустимий-байт-кодування-юнікод-8? (перше вхідні-байти)) 
          (усі-елементи-є-байтами-кодування-юнікод-8? (решта вхідні-байти)))
         ((хибне? (це-допустимий-байт-кодування-юнікод-8? (перше вхідні-байти))) ні))))))

(визначити utf8-three-byte-second-ok?
  (функція (перший-байт другий-байт)
    (за-умовою
      ((тотожне? перший-байт 224) 
       (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? другий-байт 160 191))
      ((хибне? (тотожне? перший-байт 224))
       (за-умовою
         ((тотожне? перший-байт 237) 
          (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? другий-байт 128 159))
         ((хибне? (тотожне? перший-байт 237))
          (це-байт-продовження-кодування-юнікод-8? другий-байт)))))))

(визначити utf8-four-byte-second-ok?
  (функція (перший-байт другий-байт)
    (за-умовою
      ((тотожне? перший-байт 240) 
       (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? другий-байт 144 191))
      ((хибне? (тотожне? перший-байт 240))
       (за-умовою
         ((тотожне? перший-байт 244) 
          (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? другий-байт 128 143))
         ((хибне? (тотожне? перший-байт 244))
          (це-байт-продовження-кодування-юнікод-8? другий-байт)))))))

(визначити utf8-two-continuations?
  (функція (третій-байт четвертий-байт)
    (за-умовою
      ((це-байт-продовження-кодування-юнікод-8? третій-байт) 
       (за-умовою
         ((це-байт-продовження-кодування-юнікод-8? четвертий-байт)  так)
         ((хибне? (це-байт-продовження-кодування-юнікод-8? четвертий-байт)) ні)))
      ((хибне? (це-байт-продовження-кодування-юнікод-8? третій-байт)) ні))))

(визначити utf8-decode-onto
  (функція (вхідні-байти накопичені-байти)
    (за-умовою
      ((атом? вхідні-байти)
       (список (як-є decoded) (зворот накопичені-байти)))
      ((хибне? (атом? вхідні-байти))
       (нехай-послідовно ((перший-байт (перше вхідні-байти))
              (r1 (решта вхідні-байти)))
         (за-умовою
           ; ASCII
           ((хибне? (менше? 127 перший-байт)) 
            (utf8-decode-onto r1 (сполучити перший-байт накопичені-байти)))
           ((хибне? (хибне? (менше? 127 перший-байт)))
            (за-умовою
              ; 2-byte sequence: C2..DF 80..BF
              ((кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? перший-байт 194 223) 
               (за-умовою
                 ((атом? r1)
                  (список (як-є rejected) (як-є invalid-utf8)))
                 ((хибне? (атом? r1))
                  (нехай ((другий-байт (перше r1)))
                    (за-умовою
                      ((це-байт-продовження-кодування-юнікод-8? другий-байт) 
                       (utf8-decode-onto
                         (решта r1)
                         (сполучити (додати (помножити (відняти перший-байт 192) 64)
                                  (відняти другий-байт 128))
                               накопичені-байти)))
                      ((хибне? (це-байт-продовження-кодування-юнікод-8? другий-байт))
                       (список (як-є rejected) (як-є invalid-utf8))))))))
              ((хибне? (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? перший-байт 194 223))
               (за-умовою
                 ; 3-byte sequence with overlong/surrogate exclusions.
                 ((кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? перший-байт 224 239) 
                  (за-умовою
                    ((атом? r1)
                     (список (як-є rejected) (як-є invalid-utf8)))
                    ((хибне? (атом? r1))
                     (нехай ((r2 (решта r1)))
                       (за-умовою
                         ((атом? r2)
                          (список (як-є rejected) (як-є invalid-utf8)))
                         ((хибне? (атом? r2))
                          (нехай-послідовно ((другий-байт (перше r1))
                                 (третій-байт (перше r2)))
                            (за-умовою
                              ((другий-байт-трибайтової-послідовності-кодування-юнікод-8-коректний? перший-байт другий-байт) 
                               (за-умовою
                                 ((це-байт-продовження-кодування-юнікод-8? третій-байт) 
                                  (utf8-decode-onto
                                    (решта r2)
                                    (сполучити (додати (додати (помножити (відняти перший-байт 224) 4096)
                                                (помножити (відняти другий-байт 128) 64))
                                             (відняти третій-байт 128))
                                          накопичені-байти)))
                                 ((хибне? (це-байт-продовження-кодування-юнікод-8? третій-байт))
                                  (список (як-є rejected)
                                        (як-є invalid-utf8)))))
                              ((хибне? (другий-байт-трибайтової-послідовності-кодування-юнікод-8-коректний? перший-байт другий-байт))
                               (список (як-є rejected)
                                     (як-є invalid-utf8)))))))))))
                 ((хибне? (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? перший-байт 224 239))
                  (за-умовою
                    ; 4-byte sequence, restricted to Unicode scalar <= 10FFFF.
                    ((кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? перший-байт 240 244) 
                     (за-умовою
                       ((атом? r1)
                        (список (як-є rejected) (як-є invalid-utf8)))
                       ((хибне? (атом? r1))
                        (нехай ((r2 (решта r1)))
                          (за-умовою
                            ((атом? r2)
                             (список (як-є rejected) (як-є invalid-utf8)))
                            ((хибне? (атом? r2))
                             (нехай ((r3 (решта r2)))
                               (за-умовою
                                 ((атом? r3)
                                  (список (як-є rejected) (як-є invalid-utf8)))
                                 ((хибне? (атом? r3))
                                  (нехай-послідовно ((другий-байт (перше r1))
                                         (третій-байт (перше r2))
                                         (четвертий-байт (перше r3)))
                                    (за-умовою
                                      ((другий-байт-чотирибайтової-послідовності-кодування-юнікод-8-коректний? перший-байт другий-байт) 
                                       (за-умовою
                                         ((наявні-два-байти-продовження-кодування-юнікод-8? третій-байт четвертий-байт) 
                                          (utf8-decode-onto
                                            (решта r3)
                                            (сполучити (додати (додати (додати (помножити (відняти перший-байт 240) 262144)
                                                           (помножити (відняти другий-байт 128) 4096))
                                                        (помножити (відняти третій-байт 128) 64))
                                                     (відняти четвертий-байт 128))
                                                  накопичені-байти)))
                                         ((хибне? (наявні-два-байти-продовження-кодування-юнікод-8? третій-байт четвертий-байт))
                                          (список (як-є rejected)
                                                (як-є invalid-utf8)))))
                                      ((хибне? (другий-байт-чотирибайтової-послідовності-кодування-юнікод-8-коректний? перший-байт другий-байт))
                                       (список (як-є rejected)
                                             (як-є invalid-utf8))))))))))))
                         ))
                    ((хибне? (кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? перший-байт 240 244))
                     (список (як-є rejected) (як-є invalid-utf8)))))
              )))
          )))
    ))))

(визначити utf8-decode
  (функція (вхідні-байти)
    (за-умовою
      ((усі-елементи-є-байтами-кодування-юнікод-8? вхідні-байти) 
       (utf8-decode-onto вхідні-байти (як-є ())))
      ((хибне? (усі-елементи-є-байтами-кодування-юнікод-8? вхідні-байти))
       (список (як-є rejected) (як-є invalid-byte))))))

(визначити utf8-valid?
  (функція (вхідні-байти)
    (тотожне? (перше (кодування-юнікод-8-декодувати вхідні-байти)) (як-є decoded))))

; Keep text materialization in tail position.
(визначити unicode-scalars->string-onto
  (функція (скаляри накопичені-байти)
    (за-умовою
      ((атом? скаляри)
       накопичені-байти)
      ((хибне? (атом? скаляри))
       (юнікод-скаляри-рядок-onto
         (решта скаляри)
         (рядок-додати накопичені-байти (символ-за-кодом (перше скаляри))))))))

(визначити unicode-scalars->string
  (функція (скаляри)
    (unicode-scalars->string-onto скаляри "")))

; D6 LET is ratified but this path does not infer executable binding
; from a bare numeric head. Use the admitted D4 LAMBDA application, like TCP.
; Decode once; the original two-branch semantic law remains SENS-owned.
(визначити utf8-decode-string
  (функція (вхідні-байти)
    ((функція (розкодоване)
       (за-умовою
         ((тотожне? (перше розкодоване) (як-є decoded))
          (список (як-є decoded)
                (юнікод-скаляри-рядок (перше (решта розкодоване)))))
         ((хибне? (тотожне? (перше розкодоване) (як-є decoded)))
          розкодоване)))
     (кодування-юнікод-8-декодувати вхідні-байти))))

(визначити utf8-encode-string-onto
  (функція (текст накопичені-байти)
    (за-умовою
      ((рядок-порожній? текст)
       
       (зворот накопичені-байти))
      ((хибне? (рядок-порожній? текст))
       (нехай-послідовно ((character (рядок-перший текст))
              (rest (рядок-решта текст))
              (scalar (код-символу character)))
         (за-умовою
           ((хибне? (менше? 127 scalar)) 
            (utf8-encode-string-onto rest (сполучити scalar накопичені-байти)))
           ((хибне? (хибне? (менше? 127 scalar)))
            (за-умовою
              ((хибне? (менше? 2047 scalar)) 
               (utf8-encode-string-onto
                 rest
                 (сполучити (додати 128 (модульна-остача scalar 64))
                       (сполучити (додати 192 (округлити-вниз scalar 64)) накопичені-байти))))
              ((хибне? (хибне? (менше? 2047 scalar)))
               (за-умовою
                 ((хибне? (менше? 65535 scalar)) 
                  (utf8-encode-string-onto
                    rest
                    (сполучити (додати 128 (модульна-остача scalar 64))
                          (сполучити (додати 128 (модульна-остача (округлити-вниз scalar 64) 64))
                                (сполучити (додати 224 (округлити-вниз scalar 4096))
                                      накопичені-байти)))))
                 ((хибне? (хибне? (менше? 65535 scalar)))
                  (utf8-encode-string-onto
                    rest
                    (сполучити (додати 128 (модульна-остача scalar 64))
                          (сполучити (додати 128 (модульна-остача (округлити-вниз scalar 64) 64))
                                (сполучити (додати 128 (модульна-остача (округлити-вниз scalar 4096) 64))
                                      (сполучити (додати 240 (округлити-вниз scalar 262144))
                                            накопичені-байти))))))))))))))))

(визначити utf8-encode-string
  (функція (текст)
    (utf8-encode-string-onto текст (як-є ()))))

; D9 ratified UTF-8 Ukrainian projection; existing SENS Lisp codec is owner.
; These names do not assert direct D9 opcode callability.
; D9:000001001
(визначити utf8-декодувати utf8-decode)
; D9:000101011
(визначити utf8-чинний? utf8-valid?)
; D9:000100010
(визначити unicode-скаляри-рядок unicode-scalars->string)
; D9:000001010
(визначити utf8-декодувати-рядок utf8-decode-string)
; D9:000010101
(визначити utf8-кодувати-рядок utf8-encode-string)

; Повні ратифіковані поверхні укр для тих самих замикань D9.
; Короткі ук та англійські публічні імена лишаються сумісними.
; D9:000001010 — utf8-decode-string
(визначити кодування-юнікод-8-декодувати-рядок utf8-decode-string)
; D9:000010101 — utf8-encode-string
(визначити кодування-юнікод-8-кодувати-рядок utf8-encode-string)
; D9:000100010 — unicode-scalars->string
(визначити юнікод-скаляри-рядок unicode-scalars->string)
; D9:000101011 — utf8-valid?
(визначити кодування-юнікод-8-чинний? utf8-valid?)

; opt-in повна укр-поверхня: exact identity = lib/domains/d*.lisp; DEFINE-аліас, без нової диспетчеризації.
(визначити усі-елементи-є-байтами-кодування-юнікод-8? utf8-all-bytes?)
(визначити це-допустимий-байт-кодування-юнікод-8? utf8-byte?)
(визначити це-байт-продовження-кодування-юнікод-8? utf8-continuation-byte?)
(визначити кодування-юнікод-8-декодувати utf8-decode)
(визначити другий-байт-чотирибайтової-послідовності-кодування-юнікод-8-коректний? utf8-four-byte-second-ok?)
(визначити кодова-одиниця-кодування-юнікод-8-у-допустимому-діапазоні? utf8-in-range?)
(визначити другий-байт-трибайтової-послідовності-кодування-юнікод-8-коректний? utf8-three-byte-second-ok?)
(визначити наявні-два-байти-продовження-кодування-юнікод-8? utf8-two-continuations?)
