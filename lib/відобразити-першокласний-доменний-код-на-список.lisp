; СЕНС: MAP для будь-якої ратифікованої першокласної унарної функції.
; Кожний елемент обчислює саме викликуваний код домену СЕНС.
; Точні Д3 СПОЛУЧИТИ, ПЕРШЕ, РЕШТА й Д4 ФУНКЦІЯ — виклики через «укр»,
; без непрозорого хостового циклу, D7 лише для справжнього тексту.
; На правильному скінченному списку — O(n) викликів та O(n) нових пар.

(визначити відобразити-першокласний-доменний-код
 (функція (дія елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   (так
    (сполучити
     (дія (перше елементи))
     (відобразити-першокласний-доменний-код
      дія (решта елементи)))))))

; Порожня послідовність має лишатися порожньою навіть для функції.
(за-умовою
 ((порожній?
   (відобразити-першокласний-доменний-код атом? (як-є ()))) так)
 (так (перше (як-є ()))))

; Д3 АТОМ? — реальне першокласне значення: істина, хиба, істина.
(визначити свідок-відображення-атомів
 (відобразити-першокласний-доменний-код
  атом?
  (список (як-є атом?)
          (список (як-є решта))
          (як-є сполучити))))

(за-умовою
 ((перше свідок-відображення-атомів) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (друге свідок-відображення-атомів)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((третє свідок-відображення-атомів) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта (решта (решта свідок-відображення-атомів)))) так)
 (так (перше (як-є ()))))

; Незалежний першокласний Д3 РЕШТА: зберегти тільки хвости пар.
(визначити свідок-відображення-хвостів
 (відобразити-першокласний-доменний-код
  решта
  (список (список (як-є атом?) (як-є решта))
          (список (як-є сполучити) (як-є тотожне?)))))

(за-умовою
 ((тотожне?
   (перше (перше свідок-відображення-хвостів))
   (як-є решта)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (перше (друге свідок-відображення-хвостів))
   (як-є тотожне?)) так)
 (так (перше (як-є ()))))

; Негативний SENS-закон: складену пару НЕ називати атомом.
(за-умовою
 ((хибне?
   (перше
    (відобразити-першокласний-доменний-код
     атом? (список (список (як-є атом?)))))) так)
 (так (перше (як-є ()))))

; Завершальний нативний Д1-позитив.
(атом? (як-є ()))
