; СЕНС: найкоротший суфікс, що починається з ПЕРШОГО успішного предиката.
; Алгоритм O(n) у гіршому разі, O(1) додаткової пам'яті на CONS;
; нуль нових пар — повертається вже наявний хвіст вхідного списку.
; Першокласне значення «умова» — точний доменний код, а не SID8/Sens8,
; D7 чи таблиця псевдонімів. Зіг/T5M транспортує, СЕНС виконує.
; Вхід: скінченний правильний список; умова: функція елемент -> D1.

(визначити суфікс-від-першого-за-доменним-предикатом
  (функція (умова залишок)
    (за-умовою
      ((порожній? залишок) (як-є ()))
      ((умова (перше залишок)) залишок)
      (так
        (суфікс-від-першого-за-доменним-предикатом
          умова (решта залишок))))))

; Точний код Д3 ATOM передається як функція-значення. На першій
; вкладеній парі Д1 = ні, на наступному атомі Д1 = так.
(визначити перевірений-суфікс-атомів
  (функція (елементи)
    (суфікс-від-першого-за-доменним-предикатом атом? елементи)))

; Дві вкладені пари, тоді два атоми: повертається первісний хвіст.
(визначити свідок-предиката-суфікса
  (функція (елементи)
    (за-умовою
      ((тотожне? (перше (перевірений-суфікс-атомів елементи))
                  (як-є сполучити))
       (за-умовою
         ((тотожне?
            (перше (решта (перевірений-суфікс-атомів елементи)))
            (як-є решта))
          (порожній? (решта (решта
             (перевірений-суфікс-атомів елементи)))))
         (так ні)))
      (так ні))))
(за-умовою
  ((свідок-предиката-суфікса
    (список (список (як-є атом?))
            (список (як-є функція))
            (як-є сполучити) (як-є решта))) так)
  (так (перше (як-є ()))))

; Позитивний порожній вхід: предикат нічого не створює.
(за-умовою
  ((порожній?
    (суфікс-від-першого-за-доменним-предикатом
      атом? (як-є ()))) так)
  (так (перше (як-є ()))))

; Усі елементи складені: нема збігу і нема нових пар.
(за-умовою
  ((порожній?
    (суфікс-від-першого-за-доменним-предикатом
      атом?
      (список (список (як-є атом?))
              (список (як-є решта))))) так)
  (так (перше (як-є ()))))

; Перший уже задовольняє код: повертається увесь початковий хвіст.
(за-умовою
  ((тотожне?
    (перше (перевірений-суфікс-атомів
      (список (як-є атом?) (список (як-є решта)))))
    (як-є атом?)) так)
  (так (перше (як-є ()))))

; Негатив: початковий складений елемент не може бути першим.
(за-умовою
  ((хибне? (тотожне?
      (перше (перевірений-суфікс-атомів
        (список (список (як-є атом?)) (як-є решта))))
      (як-є атом?))) так)
  (так (перше (як-є ()))))

; Нативний фінальний результат, а не коментарний або Python PASS.
(атом? (як-є ()))
