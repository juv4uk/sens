; СЕНС: найкоротший суфікс, що починається з ПЕРШОГО успішного предиката.
; Алгоритм лінійний час у гіршому разі, стала додаткова пам'ять додаткової пам'яті на СПОЛУЧИТИ;
; нуль нових пар - повертається вже наявний хвіст вхідного списку.
; Першокласне значення "умова" - точний доменний код, а не старий байтовий код/старий універсальний код,
; Д7 чи таблиця псевдонімів. Зіг/Т5М транспортує, СЕНС виконує.
; Вхід: скінченний правильний список; умова: функція елемент до Д1.

; Перевірка всього списку до виклику першокласного предиката.
; Атомарний хвіст, навіть точне Д1:ні, не є завершенням Д3:().
(визначити суфікс-правильний-список?
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) так)
      ((атом? елементи) ні)
      (так (суфікс-правильний-список? (решта елементи))))))

(визначити суфікс-пошук-першого-далі
  (функція (умова залишок)
    (за-умовою
      ((порожній? залишок) (як-є ()))
      ((умова (перше залишок)) залишок)
      (так (суфікс-пошук-першого-далі
             умова (решта залишок))))))

; Зберігає справжній початковий суфікс; не копіює СПОЛУЧИТИ-пари.
; Некоректний хвіст відхиляємо до предиката: СЕНС CAR на Д3:().
(визначити суфікс-від-першого-за-доменним-предикатом
  (функція (умова залишок)
    (за-умовою
      ((суфікс-правильний-список? залишок)
       (суфікс-пошук-першого-далі умова залишок))
      (так (перше (як-є ()))))))

; Точний код Д3 АТОМ передається як функція-значення. На першій
; вкладеній парі Д1 = ні, на наступному атомі Д1 = так.
(визначити перевірений-суфікс-атомів
  (функція (елементи)
    (суфікс-від-першого-за-доменним-предикатом атом? елементи)))

; Дві вкладені пари, тоді два атоми: повертається первісний хвіст.
(визначити свідок-предиката-суфікса
  (функція (елементи)
    (за-умовою
      ((тотожне? (перше (перевірений-суфікс-атомів елементи))
                  (як-є сполучити))
       (за-умовою
         ((тотожне?
            (перше (решта (перевірений-суфікс-атомів елементи)))
            (як-є решта))
          (порожній? (решта (решта
             (перевірений-суфікс-атомів елементи)))))
         (так ні)))
      (так ні))))
(за-умовою
  ((свідок-предиката-суфікса
    (список (список (як-є атом?))
            (список (як-є функція))
            (як-є сполучити) (як-є решта))) так)
  (так (перше (як-є ()))))

; Позитивний порожній вхід: предикат нічого не створює.
(за-умовою
  ((порожній?
    (суфікс-від-першого-за-доменним-предикатом
      атом? (як-є ()))) так)
  (так (перше (як-є ()))))

; Усі елементи складені: нема збігу і нема нових пар.
(за-умовою
  ((порожній?
    (суфікс-від-першого-за-доменним-предикатом
      атом?
      (список (список (як-є атом?))
              (список (як-є решта))))) так)
  (так (перше (як-є ()))))

; Перший уже задовольняє код: повертається увесь початковий хвіст.
(за-умовою
  ((тотожне?
    (перше (перевірений-суфікс-атомів
      (список (як-є атом?) (список (як-є решта)))))
    (як-є атом?)) так)
  (так (перше (як-є ()))))

; Негатив: початковий складений елемент не може бути першим.
(за-умовою
  ((хибне? (тотожне?
      (перше (перевірений-суфікс-атомів
        (список (список (як-є атом?)) (як-є решта))))
      (як-є атом?))) так)
  (так (перше (як-є ()))))

; Нативний фінальний результат, а не коментарний або підміна доказу.
(атом? (як-є ()))

; Д1-свідки: неправильний D1-хвіст не можна сплутати з Д3:().
; Локальний guard повертає D1:ні — повний виклик відхиляє помилковий список.
(за-умовою
  ((хибне?
    (суфікс-правильний-список?
      (сполучити (як-є атом?) ні))) так)
  (так (перше (як-є ()))))

; D1:ні всередині ПРАВИЛЬНОГО списку є даними і зберігається.
(за-умовою
  ((тотожне?
     (перше
       (суфікс-від-першого-за-доменним-предикатом
         атом?
         (список (список (як-є атом?)) ні (як-є решта))))
     ні) так)
  (так (перше (як-є ()))))

; Зупинка лише на порожній структурі, а не довільному атомі.
(за-умовою
  ((суфікс-правильний-список? (як-є ())) так)
  (так (перше (як-є ()))))

(за-умовою
  ((хибне? (суфікс-правильний-список? ні)) так)
  (так (перше (як-є ()))))

; Негатив структурної класифікації після кількох коректних пар.
(за-умовою
  ((хибне?
     (суфікс-правильний-список?
       (сполучити (як-є атом?)
         (сполучити (як-є решта) ні)))) так)
  (так (перше (як-є ()))))
