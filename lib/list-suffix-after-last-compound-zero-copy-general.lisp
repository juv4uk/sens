; СЕНС D3–D5: наявний хвіст після останнього складеного елемента.
; Один прохід, без сполучити: нуль нових пар у самому алгоритмі.
; Структурне () не є D1 хибою; історичні SID8/Sens8 не беруть участі.
(визначити хвіст-після-останньої-пари-обхід
 (функція (елементи кандидат)
  (за-умовою
   ((порожній? елементи) кандидат)
   ((атом? (перше елементи))
    (хвіст-після-останньої-пари-обхід (решта елементи) кандидат))
   (так
    (хвіст-після-останньої-пари-обхід
     (решта елементи) (решта елементи))))))

(визначити хвіст-після-останньої-пари
 (функція (елементи)
  (хвіст-після-останньої-пари-обхід елементи елементи)))

(хвіст-після-останньої-пари (список (як-є а) (список (як-є б)) (як-є в)))
