; СЕНС Д3-Д5: наявний хвіст після останнього складеного елемента.
; Один прохід, без сполучити: нуль нових пар у самому алгоритмі.
; Структурне () не є Д1 хибою; історичні сід8 і сенс8 не беруть участі.
(визначити хвіст-після-останньої-пари-обхід
 (функція (елементи кандидат)
  (за-умовою
   ((атом? елементи) кандидат)
   ((атом? (перше елементи))
    (хвіст-після-останньої-пари-обхід (решта елементи) кандидат))
   (так
    (хвіст-після-останньої-пари-обхід
     (решта елементи) (решта елементи))))))

(визначити хвіст-після-останньої-пари
 (функція (елементи)
  (хвіст-після-останньої-пари-обхід елементи елементи)))

; Нативні позитивні й негативні свідки: хибний суфікс викликає
; (перше ()) у тому самому СЕНС, а не приховується хостовим тестом.
; На порожньому вході хвіст порожній.
(за-умовою
 ((порожній? (хвіст-після-останньої-пари (як-є ()))) так)
 (так (перше (як-є ()))))

; Якщо складених елементів немає, зберігаємо початковий список.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-останньої-пари
             (список (як-є атом?) (як-є решта))))
   (як-є атом?)) так)
 (так (перше (як-є ()))))

; Одна складена пара на початку: хвіст починається після неї.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-останньої-пари
            (список (список (як-є атом?))
                    (як-є решта) (як-є сполучити))))
   (як-є решта)) так)
 (так (перше (як-є ()))))

; Дві вкладені пари: повертаємо хвіст після ОСТАННЬОЇ,
; не після першої (негативний свідок вибору неправильного суфікса).
(за-умовою
 ((тотожне?
   (перше (хвіст-після-останньої-пари
            (список (список (як-є атом?))
                    (як-є решта)
                    (список (як-є сполучити))
                    (як-є визначити))))
   (як-є визначити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне?
   (тотожне?
    (перше (хвіст-після-останньої-пари
             (список (список (як-є атом?))
                     (як-є решта)
                     (список (як-є сполучити))
                     (як-є визначити))))
    (як-є решта))) так)
 (так (перше (як-є ()))))

; Якщо останній елемент складений, праворуч від нього немає хвоста.
(за-умовою
 ((порожній? (хвіст-після-останньої-пари
              (список (як-є атом?)
                      (список (як-є решта))))) так)
 (так (перше (як-є ()))))

; Натомість атомарний вхід не допускає (перше атом). Це живі
; свідки СЕНС: пряме повернення атома й раніше обраного хвоста.
(за-умовою
 ((тотожне? (хвіст-після-останньої-пари (як-є атом?))
             (як-є атом?)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (перше
    (хвіст-після-останньої-пари-обхід
     (як-є атом?) (список (як-є сполучити))))
   (як-є сполучити)) так)
 (так (перше (як-є ()))))

; Єдине публічне значення файла - перевірений Д1 труе,
; а не друк структурної порожнечі замість результату свідків.
(атом? (як-є ()))
