; Суфікс після ОСТАННЬОГО складеного елемента правильного списку.
; Немає складених елементів — повернути вихідний список без копії.
; Один лінійний обхід, один кандидат на наявний хвіст, нуль нових пар.
; Структурне () є атомом D3, а «ні» є точним значенням D1.

(визначити хвіст-після-останньої-пари-обхід
 (функція (елементи кандидат)
  (за-умовою
   ((порожній? елементи) кандидат)
   ((атом? (перше елементи))
    (хвіст-після-останньої-пари-обхід (решта елементи) кандидат))
   (так
    (хвіст-після-останньої-пари-обхід
      (решта елементи) (решта елементи))))))

(визначити хвіст-після-останньої-пари
 (функція (елементи)
  (хвіст-після-останньої-пари-обхід елементи елементи)))

; Порожній вхід і остання пара в кінці дають структурне ().
(за-умовою
 ((порожній? (хвіст-після-останньої-пари (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-останньої-пари
              (список (список (як-є атом?))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-останньої-пари
              (список (як-є решта) (список (як-є атом?))))) так)
 (так (перше (як-є ()))))

; Без складених елементів повертається сам початковий список.
(за-умовою
 ((тотожне? (перше (хвіст-після-останньої-пари
                    (список (як-є атом?) (як-є решта))))
             (як-є атом?)) так)
 (так (перше (як-є ()))))

; Після єдиної складеної пари лишається саме її вихідний хвіст.
(за-умовою
 ((тотожне? (перше (хвіст-після-останньої-пари
                    (список (список (як-є атом?))
                            (як-є решта) (як-є сполучити))))
             (як-є решта)) так)
 (так (перше (як-є ()))))

; Після двох вкладених пар обирається права, а не ліва.
(за-умовою
 ((тотожне? (перше (хвіст-після-останньої-пари
                    (список (список (як-є атом?))
                            (як-є решта)
                            (список (як-є сполучити))
                            (як-є функція))))
             (як-є функція)) так)
 (так (перше (як-є ()))))

; Вкладене () — пара, але голе () лишається атомом.
(за-умовою
 ((тотожне? (перше (хвіст-після-останньої-пари
                    (список (список (як-є атом?))
                            (як-є ())
                            (як-є решта))))
             (як-є ())) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (хвіст-після-останньої-пари
                    (список (як-є ()) (як-є атом?)
                            (список (як-є ()))
                            (як-є решта))))
             (як-є решта)) так)
 (так (перше (як-є ()))))

; Негатив: ліва пара не може переважити праву.
(за-умовою
 ((хибне? (тотожне?
  (перше (хвіст-після-останньої-пари
          (список (список (як-є атом?))
                  (як-є решта)
                  (список (як-є сполучити))
                  (як-є функція))))
  (як-є решта))) так)
 (так (перше (як-є ()))))

; Останнє слово програми — справжній позитивний D1 від SENS.
(атом? (як-є ()))
