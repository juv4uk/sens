; СЕНС D3–D5: наявний хвіст після останнього складеного елемента.
; Один прохід, без сполучити: нуль нових пар у самому алгоритмі.
; Структурне () не є D1 хибою; історичні SID8/Sens8 не беруть участі.
(визначити хвіст-після-останньої-пари-обхід
 (функція (елементи кандидат)
  (за-умовою
   ((порожній? елементи) кандидат)
   ((атом? (перше елементи))
    (хвіст-після-останньої-пари-обхід (решта елементи) кандидат))
   (так
    (хвіст-після-останньої-пари-обхід
     (решта елементи) (решта елементи))))))

(визначити хвіст-після-останньої-пари
 (функція (елементи)
  (хвіст-після-останньої-пари-обхід елементи елементи)))

; Лише D3 EQ для атомів, вкладені пари порівнює рекурсія SENS.
(визначити рівні-хвости-після-останньої-пари?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((рівні-хвости-після-останньої-пари?
     (перше ліве) (перше праве))
    (рівні-хвости-після-останньої-пари?
     (решта ліве) (решта праве)))
   (так ні))))

; Свідок завершується помилкою самого SENS, якщо закон не виконується.
(визначити довести-хвіст-після-останньої-пари
 (функція (вхід очікуване)
  (за-умовою
   ((рівні-хвости-після-останньої-пари?
     (хвіст-після-останньої-пари вхід) очікуване) так)
   (так (перше (як-є ()))))))

; Порожній вхід, лише атоми, складена пара наприкінці.
(довести-хвіст-після-останньої-пари (як-є ()) (як-є ()))
(довести-хвіст-після-останньої-пари
 (список (як-є атом?) (як-є решта))
 (список (як-є атом?) (як-є решта)))
(довести-хвіст-після-останньої-пари
 (список (список (як-є атом?))) (як-є ()))
(довести-хвіст-після-останньої-пари
 (список (як-є решта) (список (як-є атом?))) (як-є ()))

; Середня пара: хвіст не копіюється, справа лишаються два атоми.
(довести-хвіст-після-останньої-пари
 (список (список (як-є атом?)) (як-є решта) (як-є сполучити))
 (список (як-є решта) (як-є сполучити)))
; Правіша пара перемагає ліву; внутрішній список не розкладаємо.
(довести-хвіст-після-останньої-пари
 (список (список (як-є атом?))
         (як-є решта)
         (список (як-є сполучити))
         (як-є функція))
 (список (як-є функція)))
; Порожній як елемент лишається атомом, але (()) — пара.
(довести-хвіст-після-останньої-пари
 (список (список (як-є атом?)) (як-є ()) (як-є решта))
 (список (як-є ()) (як-є решта)))
(довести-хвіст-після-останньої-пари
 (список (як-є ()) (як-є атом?) (список (як-є ())) (як-є решта))
 (список (як-є решта)))
; Жодної пари: повертається весь вихідний список, включно з ().
(довести-хвіст-після-останньої-пари
 (список (як-є ()) (як-є атом?))
 (список (як-є ()) (як-є атом?)))

; Негативний свідок: заборонено повертати хвіст після лівої пари.
(за-умовою
 ((хибне?
   (рівні-хвости-після-останньої-пари?
    (хвіст-після-останньої-пари
     (список (список (як-є атом?))
             (як-є решта)
             (список (як-є сполучити))
             (як-є функція)))
    (список (як-є решта) (список (як-є сполучити))
            (як-є функція))))
  так)
 (так (перше (як-є ()))))

; Остаточну D1 істину обчислює сам SENS, не Python/JSON.
(атом? (як-є ()))
