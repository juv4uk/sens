; Закон 12: два збіги - залишок не порожній.
(за-умовою
  ((хибне? (порожній? (решта підрахунок-два))) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 13: три збіги - останній існує.
(за-умовою
  ((хибне? (порожній? (решта (решта підрахунок-три)))) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 14: два порожніх як значення.
(за-умовою
  ((порожній? (решта (решта підрахунок-порожніх))) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 15: два порожніх - не нуль.
(за-умовою
  ((хибне? (порожній? підрахунок-порожніх)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 16: вкладений список не збіг.
(за-умовою
  ((порожній? (решта підрахунок-вкладених)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 17: плоский атом серед вкладень є збіг.
(за-умовою
  ((хибне? (порожній? підрахунок-вкладених)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 18: лише вкладений збіг дає нуль.
(за-умовою
  ((порожній? (порахувати-атом-унарно (як-є атом?) (список (список (як-є атом?))))) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 19: інша ціль обирає тільки власний збіг.
(за-умовою
  ((порожній? (решта (порахувати-атом-унарно (як-є решта) (список (як-є атом?) (як-є решта))))) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 20: негатив: різні атоми не тотожні.
(за-умовою
  ((хибне? (тотожне? (перше підрахунок-один) (як-є решта))) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 21: негатив: два збіги не нуль.
(за-умовою
  ((хибне? (порожній? (решта підрахунок-два))) (атом? (як-є ())))
