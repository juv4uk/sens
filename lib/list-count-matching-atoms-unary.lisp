; Рекурсивний унарний підрахунок точних атомів у скінченному правильному списку.
; Унарна кількість - список повторів ратифікованого атома, без десяткових
; машинних літералів. Вкладений список не дорівнює атомові-цілі.
; СЕНС виконує визначення й закони, а Зіг лише переносить точні слова.

(визначити порахувати-атом-унарно
  (функція (ціль елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ; D3 EQ приймає лише атоми. Вкладена пара є окремим елементом
      ; списку, а не атомним збігом: не передаємо її у тотожне?.
      ((хибне? (атом? (перше елементи)))
       (порахувати-атом-унарно ціль (решта елементи)))
      ((хибне? (атом? (перше елементи)))
       (порахувати-атом-унарно ціль (решта елементи)))
      ((тотожне? (перше елементи) ціль)
       (сполучити (як-є атом?)
         (порахувати-атом-унарно ціль (решта елементи))))
      ((атом? (як-є ()))
       (порахувати-атом-унарно ціль (решта елементи))))))

(визначити підрахунок-нуль
  (порахувати-атом-унарно (як-є атом?) (як-є ())))
(визначити підрахунок-жоден
  (порахувати-атом-унарно (як-є атом?)
    (список (як-є решта) (як-є сполучити) (як-є тотожне?))))
(визначити підрахунок-один
  (порахувати-атом-унарно (як-є атом?)
    (список (як-є решта) (як-є атом?) (як-є сполучити))))
(визначити підрахунок-два
  (порахувати-атом-унарно (як-є атом?)
    (список (як-є атом?) (як-є решта) (як-є атом?) (як-є тотожне?))))
(визначити підрахунок-три
  (порахувати-атом-унарно (як-є атом?)
    (список (як-є атом?) (як-є атом?) (як-є решта)
            (як-є атом?) (як-є сполучити))))
(визначити підрахунок-порожніх
  (порахувати-атом-унарно (як-є ())
    (список (як-є ()) (як-є атом?) (як-є ()))))
(визначити підрахунок-вкладених
  (порахувати-атом-унарно (як-є атом?)
    (список (список (як-є атом?)) (як-є атом?) (як-є ()))))

; Кожний закон виконується у СЕНС. Хибний закон бере перше з порожнього.

; Закон 1: порожній вхід.
(за-умовою
  ((порожній? підрахунок-нуль) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 2: відсутність збігів.
(за-умовою
  ((порожній? підрахунок-жоден) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 3: один збіг - значення.
(за-умовою
  ((тотожне? (перше підрахунок-один) (як-є атом?)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 4: один збіг - довжина.
(за-умовою
  ((порожній? (решта підрахунок-один)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 5: два збіги - перший.
(за-умовою
  ((тотожне? (перше підрахунок-два) (як-є атом?)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 6: два збіги - другий.
(за-умовою
  ((тотожне? (перше (решта підрахунок-два)) (як-є атом?)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 7: два збіги - завершення.
(за-умовою
  ((порожній? (решта (решта підрахунок-два))) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 8: три збіги - перший.
(за-умовою
  ((тотожне? (перше підрахунок-три) (як-є атом?)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 9: три збіги - третій.
(за-умовою
  ((тотожне? (перше (решта (решта підрахунок-три))) (як-є атом?)) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ()))))

; Закон 10: три збіги - завершення.
(за-умовою
  ((порожній? (решта (решта (решта підрахунок-три)))) (атом? (як-є ())))
