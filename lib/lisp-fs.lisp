; Незмінне файлове сховище СЕНС для WSM — мовна модель об'єктів
; і кореневих станів, не драйвер диска та не інтерфейс POSIX.
;
; Знімок файлової системи має протокольну форму
; (fs objects bindings revision). Об'єкти зберігаються за адресою вмісту;
; зв'язування зіставляють імена з адресами. Кожен запис повертає
; новий знімок та адресу й не змінює попереднього стану.
; Невідоме ім'я дає (not-found name), а не неозначений nil.
; Англомовні ключі та маркери — дані протоколу, не викличні голови.
; Завершальні гілки COND мають точний Д1-предикат «так»,
; а не обчислений історичний предикат порожнього списку.

; Ключі пакетів є структурними D7-даними, тому читаємо й порівнюємо їх
; структурно. Вони не є D3-атомами та не проходять через EQ.
(визначити фс-об'єкти
  (функція (система) (перше система)))
(визначити фс-зв'язки
  (функція (система) (друге система)))
(визначити фс-ревізія
  (функція (система) (третє система)))

(визначити фс-число-нуль (довжина (як-є ())))
(визначити фс-число-один (довжина (як-є (а))))

(визначити фс-порожній
  (функція ()
    (список (порожній-вміст-сховище) (мапа-порожній) фс-число-нуль)))

(визначити фс-корінь-адреса
  (функція (система)
    (знання-вміст-адреса
      (список (як-є wsm-fs-root)
            (фс-зв'язки система)))))

; Запис повертає (new-fs content-address): новий незмінний стан
; і адресу вмісту. Викликач сам обирає, чи зберегти старий корінь;
; це дозволяє створювати незалежні гілки стану й відновлювати попередні.
; Упорядкований SENS-прохід: адресу обчислюємо один раз.
; D6 LET* не є допустимою прямою викличною головою фізичного T5M.
; Власник адреси та логіки — мовна функція, а не Rust/Zig.
(визначити фс-записати-із-адресою
  (функція (система назва значення адреса)
    (список
      (список
        (вміст-сховище-покласти (фс-об'єкти система) адреса значення)
        (внутрішня-мапа-вставити назва адреса (фс-зв'язки система))
        (додати-1 (фс-ревізія система)))
      адреса)))

(визначити фс-записати
  (функція (система назва значення)
    (фс-записати-із-адресою
      система назва значення (знання-вміст-адреса значення))))

; Читання повертає протокольні дані (found value address)
; або (not-found name); значення маркерів не перейменовуємо.
; Спочатку встановлюємо наявність зв'язку, після цього перевіряємо
; рівно одну адресу. Збережене () є даними, не сигналом «не знайдено».
(визначити фс-читати-за-адресою
  (функція (система назва адреса)
    (за-умовою
      ((хибне? (вміст-сховище-містить? (фс-об'єкти система) адреса))
       (список (як-є not-found) назва))
      (так
       (список
         (як-є found)
         (перше (вміст-сховище-отримати (фс-об'єкти система) адреса))
         адреса)))))

(визначити фс-читати-зі-зв'язком
  (функція (система назва зв'язок)
    (за-умовою
      ((порожній? зв'язок) (список (як-є not-found) назва))
      ((атом? зв'язок) (список (як-є not-found) назва))
      (так (фс-читати-за-адресою система назва (перше зв'язок))))))

(визначити фс-читати
  (функція (система назва)
    (фс-читати-зі-зв'язком
      система назва
      (внутрішня-мапа-отримати назва (фс-зв'язки система)))))

(визначити фс-список
  (функція (система)
    (внутрішня-мапа-список (фс-зв'язки система))))

(визначити фс-містить?
  (функція (система назва)
    (хибне? (атом? (внутрішня-мапа-отримати назва (фс-зв'язки система))))))

; Версіоновані оболонки є звичайними списками пар із даними.
; Файлова система не обчислює їх як програмні форми.
(визначити *версія-формату-фс* (список фс-число-нуль фс-число-один))

(визначити фс-об'єкт-пакет
  (функція (значення)
    (список
      (сполучити (як-є format) (як-є wsm-fs-object))
      (сполучити (як-є version) *версія-формату-фс*)
      (сполучити (як-є address) (знання-вміст-адреса значення))
      (сполучити (як-є value) значення))))

(визначити фс-корінь-пакет
  (функція (система)
    (список
      (сполучити (як-є format) (як-є wsm-fs-root))
      (сполучити (як-є version) *версія-формату-фс*)
      (сполучити (як-є revision) (фс-ревізія система))
      (сполучити (як-є bindings) (внутрішня-мапа-список (фс-зв'язки система)))
      (сполучити (як-є objects) (фс-об'єкт-адреси (внутрішня-мапа-список (фс-об'єкти система)))))))

(визначити фс-об'єкт-адреси
  (функція (записи)
    (за-умовою
      ((порожній? записи) (як-є ()))
      ((хибне? (атом? записи))
       (сполучити (перше (перше записи))
                 (фс-об'єкт-адреси (решта записи)))))))

; Внутрішня перевірка точної відповіді Д1 українською.
(визначити фс-д1-ні?
  (функція (значення)
    (хибне? значення)))


; Структурний пошук у списку пар похідний від законів Д3 і Д4.
; Одна лише резидентність Д5 ASSOC не дозволяє обходити перевірку
; полів оболонки події. Ключі є атомами, а повернений хвіст — це
; початкове значення даних, а не обчислена вихідна форма.
; Невідомі й некоректні записи не отримують вигаданих значень.
; Селектори застосовують лише після перевірки форми пари.
; Це правило діє і поза рішенням щодо події журналу;
; істинність належить Д1, нового числового механізму Д24 немає.
(визначити фс-пакет-поле
  (функція (назва пакет)
    (за-умовою
      ((порожній? пакет) (як-є ()))
      ((атом? пакет) (як-є ()))
      ((атом? (перше пакет)) (як-є ()))
      ((порожній? (перше (перше пакет))) (як-є ()))
      ((однакові? назва (перше (перше пакет))) (решта (перше пакет)))
      (так (фс-пакет-поле назва (решта пакет))))))
(визначити рішення-щодо-пакета-об'єкта-файлової-системи
  (функція (пакет)
    (за-умовою
      ((атом? пакет)
       (список (як-є rejected) (як-є invalid-package)))
      ; Присутність кожного поля перевіряється ОКРЕМО від його значення.
      ; Існуюче D3:() є допустимими даними, відсутність ключа — ні.
      ((хибне? (фс-пакет-має-поле? (як-є format) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне? (фс-пакет-має-поле? (як-є version) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне? (фс-пакет-має-поле? (як-є address) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне? (фс-пакет-має-поле? (як-є value) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне?
         (однакові? (фс-пакет-поле (як-є format) пакет) (як-є wsm-fs-object)))
       (список (як-є rejected) (як-є invalid-format)))
      ((хибне?
         (фс-версія-журналу-чинна? (фс-пакет-поле (як-є version) пакет)))
       (список (як-є rejected) (як-є unsupported-version)))
      ((хибне?
         (однакові? (фс-пакет-поле (як-є address) пакет)
                   (знання-вміст-адреса (фс-пакет-поле (як-є value) пакет))))
       (список (як-є rejected) (як-є address-mismatch)))
      ((однакові? (фс-пакет-поле (як-є address) пакет)
                 (знання-вміст-адреса (фс-пакет-поле (як-є value) пакет)))
       (список (як-є accepted) (фс-пакет-поле (як-є value) пакет))))))
(визначити фс-серіалізувати-об'єкт
  (функція (значення)
    (значення-у-текст (фс-об'єкт-пакет значення))))

(визначити фс-десеріалізувати-об'єкт
  (функція (текст)
    (рішення-щодо-пакета-об'єкта-файлової-системи (прочитати текст))))

; Коренева оболонка F2 перевіряє власні формат, версію, ревізію,
; зв'язування та об'єкти. Поля адреси й значення об'єктової оболонки
; не є полями кореневої оболонки.
; Історичний предикат правильного списку повертав істину хоста;
; це не дозволено використовувати як результат умови D3.
; Локальний закон D1: порожній список правильний, для пари
; перевіряємо хвіст рекурсивно, інші атоми не є правильним списком.
(визначити внутрішній-правильний-список?
  (функція (значення)
    (за-умовою
      ((порожній? значення) так)
      ((атом? значення) ні)
      (так (внутрішній-правильний-список? (решта значення))))))

(визначити рішення-щодо-кореневого-пакета-файлової-системи
  (функція (пакет)
    (за-умовою
      ((атом? пакет)
       (список (як-є rejected) (як-є invalid-package)))
      ; Присутність кожного поля перевіряється ОКРЕМО від його значення.
      ; Існуюче D3:() є допустимими даними, відсутність ключа — ні.
      ((хибне? (фс-пакет-має-поле? (як-є format) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне? (фс-пакет-має-поле? (як-є version) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне? (фс-пакет-має-поле? (як-є revision) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне? (фс-пакет-має-поле? (як-є bindings) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне? (фс-пакет-має-поле? (як-є objects) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне?
         (однакові? (фс-пакет-поле (як-є format) пакет) (як-є wsm-fs-root)))
       (список (як-є rejected) (як-є invalid-format)))
      ((хибне?
         (фс-версія-журналу-чинна? (фс-пакет-поле (як-є version) пакет)))
       (список (як-є rejected) (як-є unsupported-version)))
      ((хибне? (внутрішній-правильний-список? (фс-пакет-поле (як-є bindings) пакет)))
       (список (як-є rejected) (як-є invalid-bindings)))
      ((хибне? (внутрішній-правильний-список? (фс-пакет-поле (як-є objects) пакет)))
       (список (як-є rejected) (як-є invalid-objects)))
      ((внутрішній-правильний-список? (фс-пакет-поле (як-є objects) пакет))
       (список (як-є accepted) пакет)))))
(визначити фс-серіалізувати-корінь
  (функція (система)
    (значення-у-текст (фс-корінь-пакет система))))

(визначити фс-десеріалізувати-корінь
  (функція (текст)
    (рішення-щодо-кореневого-пакета-файлової-системи (прочитати текст))))

; Відновлюємо знімок у пам'яті лише з оболонок-даних.
; Жодна оболонка не виконується. Якщо посилання веде на відсутній
; об'єкт, відновлення відхиляється до повернення стану:
; викликач бачить атомарний результат.
; Обхід закінчується лише на структурній порожнечі.
; Кожен пакет непорожнього правильного списку треба перевірити
; і додати; непорожній атом відхиляємо. Старий тест заперечення
; атомарності помилково пропускав будь-який непорожній список.
; Рішення кожного пакета перевіряємо перед зміною нового знімка.
; Відхилений пакет не додає до сховища жодного часткового об'єкта.
(визначити фс-додати-перевірений-об'єкт
  (функція (пакети сховище рішення)
    (за-умовою
      ((хибне? (однакові? (перше рішення) (як-є accepted))) рішення)
      (так
       (фс-побудувати-об'єкт-сховище
         (решта пакети)
         (вміст-сховище-покласти
           сховище
           (знання-вміст-адреса (друге рішення))
           (друге рішення)))))))

(визначити фс-побудувати-об'єкт-сховище
  (функція (пакети сховище)
    (за-умовою
      ((порожній? пакети) (список (як-є accepted) сховище))
      ((атом? пакети) (список (як-є rejected) (як-є invalid-object-packages)))
      (так
       (фс-додати-перевірений-об'єкт
         пакети сховище
         (рішення-щодо-пакета-об'єкта-файлової-системи
           (перше пакети)))))))

; Перевірки наявності всіх адрес є згортками з точними результатами D1:
; порожній список дає істину, неправильний хвіст або відсутній
; вміст — хибу. Не допускаються істина хоста, підміна порожнечею
; або неявне перетворення довільних значень на предикатний результат.
(визначити усі-адреси-об'єктів-файлової-системи-наявні?
  (функція (адреси сховище)
    (за-умовою
      ((порожній? адреси) так)
      ((атом? адреси) ні)
      ((хибне? (вміст-сховище-містить? сховище (перше адреси)))
       ні)
      (так (усі-адреси-об'єктів-файлової-системи-наявні? (решта адреси) сховище)))))

(визначити усі-адреси-зв'язувань-у-файловій-системі-наявні?
  (функція (записи сховище)
    (за-умовою
      ((порожній? записи) так)
      ((атом? записи) ні)
      ((хибне? (вміст-сховище-містить? сховище (решта (перше записи))))
       ні)
      (так (усі-адреси-зв'язувань-у-файловій-системі-наявні? (решта записи) сховище)))))

; Після кореневого допуску перевіряємо ВСІ адреси об'єктів та
; зв'язувань. Немає часткового прийняття або обчислення LET* у хості.
(визначити фс-відновити-корінь-із-об'єктами
  (функція (кореневий-пакет рішення-об'єктів)
    (за-умовою
      ((хибне? (однакові? (перше рішення-об'єктів) (як-є accepted)))
       рішення-об'єктів)
      ((хибне? (усі-адреси-об'єктів-файлової-системи-наявні?
                  (фс-пакет-поле (як-є objects) кореневий-пакет)
                  (друге рішення-об'єктів)))
       (список (як-є rejected) (як-є missing-object)))
      ((хибне? (усі-адреси-зв'язувань-у-файловій-системі-наявні?
                  (фс-пакет-поле (як-є bindings) кореневий-пакет)
                  (друге рішення-об'єктів)))
       (список (як-є rejected) (як-є missing-object)))
      (так
       (список
         (як-є accepted)
         (список
           (друге рішення-об'єктів)
           (фс-зв'язки-з-список
             (фс-пакет-поле (як-є bindings) кореневий-пакет)
             (мапа-порожній))
           (фс-пакет-поле (як-є revision) кореневий-пакет)))))))

(визначити фс-відновити-корінь-із-рішенням
  (функція (кореневий-пакет пакети-об'єктів рішення-кореня)
    (за-умовою
      ((хибне? (однакові? (перше рішення-кореня) (як-є accepted)))
       рішення-кореня)
      (так
       (фс-відновити-корінь-із-об'єктами
         кореневий-пакет
         (фс-побудувати-об'єкт-сховище
           пакети-об'єктів (порожній-вміст-сховище)))))))

(визначити фс-відновити-корінь
  (функція (кореневий-пакет пакети-об'єктів)
    (фс-відновити-корінь-із-рішенням
      кореневий-пакет пакети-об'єктів
      (рішення-щодо-кореневого-пакета-файлової-системи
        кореневий-пакет))))

(визначити фс-зв'язки-з-список
  (функція (записи зв'язки)
    (за-умовою
      ((порожній? записи) зв'язки)
      ((атом? записи) зв'язки)
      (так (фс-зв'язки-з-список
           (решта записи)
           (внутрішня-мапа-вставити (перше (перше записи)) (решта (перше записи)) зв'язки))))))

; Записи журналу F3 є лише даними, події додаються без стирання історії.
; Відтворення починається з порожнього стану файлової системи
; й повертає (accepted fs) або (rejected reason) як дані протоколу.
; Невідомі та пошкоджені події не можуть створювати частковий стан.
(визначити *версія-журналу-фс* (список фс-число-нуль фс-число-один))

(визначити фс-журнал-подія
  (функція (операція поля)
    (сполучити
      (сполучити (як-є format) (як-є wsm-fs-event))
      (сполучити
        (сполучити (як-є version) *версія-журналу-фс*)
        (сполучити (сполучити (як-є op) операція) поля)))))

(визначити фс-журнал-записати-подія
  (функція (назва значення)
    (фс-журнал-подія
      (як-є write)
      (список (сполучити (як-є name) назва) (сполучити (як-є value) значення)))))

(визначити фс-журнал-зв'язати-подія
  (функція (назва адреса)
    (фс-журнал-подія
      (як-є bind)
      (список (сполучити (як-є name) назва) (сполучити (як-є address) адреса)))))

(визначити фс-журнал-розв'язати-подія
  (функція (назва)
    (фс-журнал-подія (як-є unbind) (список (сполучити (як-є name) назва)))))

(визначити фс-журнал-корінь-коміт-подія
  (функція (кореневий-пакет)
    (фс-журнал-подія
      (як-є root-commit)
      (список (сполучити (як-є root) кореневий-пакет)))))

(визначити фс-журнал-додати
  (функція (журнал подія)
    (приєднати журнал (список подія))))

; Перевірка журналу — мовне виведення з точною істинністю D1,
; без запозичення недоведеної викличності похідних операцій D8.
; Наявність поля перевіряється окремо від його значення:
; структурна порожнеча, записана в поле, не означає відсутності поля.
; Перед вкладеними селекторами завжди перевіряємо форму даних.
(визначити фс-пакет-має-поле?
  (функція (назва пакет)
    (за-умовою
      ((порожній? пакет) ні)
      ((атом? пакет) ні)
      ((атом? (перше пакет)) ні)
      ((порожній? (перше (перше пакет))) ні)
      ((однакові? назва (перше (перше пакет))) так)
      (так (фс-пакет-має-поле? назва (решта пакет))))))

; Версія F3 складається рівно з двох атомарних елементів: нуль і один.
; Перед селекторами перевіряємо форму, а кожна гілка повертає
; точне предикатне значення D1.
(визначити фс-версія-журналу-чинна?
  (функція (кандидат)
    (за-умовою
      ((атом? кандидат) ні)
      ((атом? (решта кандидат)) ні)
      ((порожній? (решта (решта кандидат)))
       (за-умовою
         ((однакові? (перше кандидат) фс-число-нуль)
          (однакові? (перше (решта кандидат)) фс-число-один))
         (так ні)))
      (так ні))))

; Структурна форма alist перевіряється ДО селекторів полів.
; Ключ — непорожнє D7-значення; значення може бути EMPTY.
; D1-вердикт належить самому SENS; ратифікації нової координати немає.
(визначити фс-журнал-список-пар?
  (функція (записи)
    (за-умовою
      ((порожній? записи) так)
      ((атом? записи) ні)
      ((атом? (перше записи)) ні)
      ((порожній? (перше (перше записи))) ні)
      ((хибне? (атом? (перше (перше записи)))) ні)
      (так (фс-журнал-список-пар? (решта записи))))))

(визначити рішення-щодо-події-журналу-файлової-системи
  (функція (подія)
    (за-умовою
      ; Загальний порожній alist коректний як структура, але не як подія.
      ((порожній? подія) (список (як-є rejected) (як-є invalid-event)))
      ((хибне? (фс-журнал-список-пар? подія))
       (список (як-є rejected) (як-є invalid-event)))
      ((хибне? (однакові? (фс-пакет-поле (як-є format) подія) (як-є wsm-fs-event)))
       (список (як-є rejected) (як-є invalid-format)))
      ((хибне? (фс-версія-журналу-чинна? (фс-пакет-поле (як-є version) подія)))
       (список (як-є rejected) (як-є unsupported-version)))
      ((порожній? (фс-пакет-поле (як-є op) подія))
       (список (як-є rejected) (як-є missing-operation)))
      ((однакові? (фс-пакет-поле (як-є op) подія) (як-є write))
       (за-умовою
         ((хибне? (фс-пакет-має-поле? (як-є name) подія))
          (список (як-є rejected) (як-є incomplete-write)))
         ((хибне? (фс-пакет-має-поле? (як-є value) подія))
          (список (як-є rejected) (як-є incomplete-write)))
         (так (список (як-є accepted) подія))))
      ((однакові? (фс-пакет-поле (як-є op) подія) (як-є bind))
       (за-умовою
         ((хибне? (фс-пакет-має-поле? (як-є name) подія))
          (список (як-є rejected) (як-є incomplete-bind)))
         ((хибне? (фс-пакет-має-поле? (як-є address) подія))
          (список (як-є rejected) (як-є incomplete-bind)))
         (так (список (як-є accepted) подія))))
      ((однакові? (фс-пакет-поле (як-є op) подія) (як-є unbind))
       (за-умовою
         ((хибне? (фс-пакет-має-поле? (як-є name) подія))
          (список (як-є rejected) (як-є incomplete-unbind)))
         (так (список (як-є accepted) подія))))
      ((однакові? (фс-пакет-поле (як-є op) подія) (як-є root-commit))
       (за-умовою
         ((хибне? (фс-пакет-має-поле? (як-є root) подія))
          (список (як-є rejected) (як-є incomplete-root-commit)))
         (так (список (як-є accepted) подія))))
      (так (список (як-є rejected) (як-є unknown-event))))))
(визначити фс-зв'язки-без-імені
  (функція (записи назва результат)
    (за-умовою
      ((порожній? записи) результат)
      ((атом? записи) результат)
      ((однакові? (перше (перше записи)) назва)
       (фс-зв'язки-без-імені (решта записи) назва результат))
      (так
        (фс-зв'язки-без-імені
          (решта записи)
          назва
          (внутрішня-мапа-вставити (перше (перше записи)) (решта (перше записи)) результат))))))

(визначити фс-розв'язати
  (функція (система назва)
    (список
      (фс-об'єкти система)
      (фс-зв'язки-без-імені (внутрішня-мапа-список (фс-зв'язки система)) назва (мапа-порожній))
      (додати-1 (фс-ревізія система)))))

; Тотожність зафіксованих коренів незмінних дерев випливає
; зі структурних законів D3 і D4; кожен рівень рекурсії
; повертає точне предикатне значення D1.
(визначити внутрішня-рівність-структур
  (функція (ліве праве)
    (за-умовою
      ((порожній? ліве) (порожній? праве))
      ((порожній? праве) ні)
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (тотожне? ліве праве))
         (так ні)))
      ((атом? праве) ні)
      ((внутрішня-рівність-структур (перше ліве) (перше праве))
       (внутрішня-рівність-структур (решта ліве) (решта праве)))
      (так ні))))

(визначити фс-журнал-відтворити-подію
  (функція (система подія)
    (нехай-послідовно ((рішення (рішення-щодо-події-журналу-файлової-системи подія)))
      (за-умовою
        ((хибне? (однакові? (перше рішення) (як-є accepted))) рішення)
        (так
          (нехай-послідовно ((операція (фс-пакет-поле (як-є op) подія)))
            (за-умовою
              ((однакові? операція (як-є write))
               (нехай-послідовно ((записано (фс-записати система
                                        (фс-пакет-поле (як-є name) подія)
                                        (фс-пакет-поле (як-є value) подія))))
                 (список (як-є accepted) (перше записано))))
              ((однакові? операція (як-є bind))
               (нехай-послідовно ((адреса (фс-пакет-поле (як-є address) подія)))
                 (за-умовою
                   ((хибне? (вміст-сховище-містить? (фс-об'єкти система) адреса))
                    (список (як-є rejected) (як-є missing-object)))
                   (так
                     (список
                       (як-є accepted)
                       (список
                         (фс-об'єкти система)
                         (внутрішня-мапа-вставити (фс-пакет-поле (як-є name) подія)
                                     адреса
                                     (фс-зв'язки система))
                         (додати-1 (фс-ревізія система))))))))
              ((однакові? операція (як-є unbind))
               (список (як-є accepted)
                     (фс-розв'язати система (фс-пакет-поле (як-є name) подія))))
              ((однакові? операція (як-є root-commit))
               (за-умовою
                 ((внутрішня-рівність-структур (фс-корінь-пакет система)
                           (фс-пакет-поле (як-є root) подія))
                  (список (як-є accepted) система))
                 (так (список (як-є rejected) (як-є root-mismatch)))))
              (так (список (як-є rejected) (як-є unknown-event))))))))))

(визначити фс-журнал-відтворити-на-стан
  (функція (журнал система)
    (за-умовою
      ((порожній? журнал) (список (як-є accepted) система))
      ((атом? журнал)  (список (як-є rejected) (як-є invalid-event)))
      (так
        (нехай-послідовно ((рішення (фс-журнал-відтворити-подію система (перше журнал))))
          (за-умовою
            ((хибне? (однакові? (перше рішення) (як-є accepted))) рішення)
            (так (фс-журнал-відтворити-на-стан (решта журнал) (друге рішення)))))))))

(визначити фс-журнал-повторити
  (функція (журнал)
    (фс-журнал-відтворити-на-стан журнал (фс-порожній))))

(визначити фс-серіалізувати-журнал
  (функція (журнал)
    (значення-у-текст журнал)))

(визначити фс-десеріалізувати-журнал
  (функція (текст)
    (фс-журнал-повторити (прочитати текст))))

; Межа фіксації F4: об'єкти та журнал дозволено записати раніше,
; але знімок стає видимим лише після завершення етапу кореневого
; покажчика. Перевірка допустимості етапу повертає точне D1,
; а не істину хоста чи неявну порожнечу.
(визначити фс-етап-коміту?
  (функція (етап)
    (за-умовою
      ((однакові? етап (як-є objects)) так)
      ((однакові? етап (як-є journal)) так)
      ((однакові? етап (як-є root-pointer)) так)
      (так ні))))
(визначити відновити-завершену-фіксацію-файлової-системи
  (функція (стара-система нова-система завершений-етап)
    (за-умовою
      ((хибне? (фс-етап-коміту? завершений-етап))
       (список (як-є rejected) (як-є unknown-commit-stage)))
      ((однакові? завершений-етап (як-є root-pointer))
       (список (як-є recovered) нова-система))
      (так (список (як-є recovered) стара-система)))))

(визначити відновити-кореневий-пакет-файлової-системи
  (функція (старий-пакет пакет-кандидат завершений-етап)
    (за-умовою
      ; root-pointer можна порівнювати через D3 EQ лише після ATOM.
      ; Список або крапкова пара завжди зберігають попередній пакет.
      ((атом? завершений-етап)
       (за-умовою
         ((однакові? завершений-етап (як-є root-pointer))
          (нехай-послідовно ((рішення (рішення-щодо-кореневого-пакета-файлової-системи пакет-кандидат)))
            (за-умовою
              ((однакові? (перше рішення) (як-є accepted))
               (список (як-є recovered) пакет-кандидат))
              (так
               (список (як-є recovered) старий-пакет (як-є rejected-candidate))))))
         (так (список (як-є recovered) старий-пакет))))
      (так (список (як-є recovered) старий-пакет)))))

; Функції файлової системи визначено українськими SENS-замиканнями вище.
; Ідентичності D9/D10 належать lib/domains/d9.lisp і d10.lisp, а не
; дубльованим латинським DEFINE у виконуваному джерелі.
; Протокольні мітки (fs, wsm-fs-*) залишаються незмінними цитованими даними.
; SENS_PAIR_REGEN: 2026-10-25 mint lib/lisp-fs after physical T5M source drift.
