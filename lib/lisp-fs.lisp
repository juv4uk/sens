; Незмінне файлове сховище СЕНС для WSM — мовна модель об'єктів
; і кореневих станів, не драйвер диска та не інтерфейс POSIX.
;
; Знімок файлової системи має протокольну форму
; (fs objects bindings revision). Об'єкти зберігаються за адресою вмісту;
; зв'язування зіставляють імена з адресами. Кожен запис повертає
; новий знімок та адресу й не змінює попереднього стану.
; Невідоме ім'я дає (not-found name), а не неозначений nil.
; Англомовні ключі та маркери — дані протоколу, не викличні голови.
; Завершальні гілки COND мають точний Д1-предикат «так»,
; а не обчислений історичний предикат порожнього списку.

; Фізичний Core4/T5M вже визначає ратифіковані D9 мапа-вставити,
; мапа-отримати та мапа-список мовою СЕНС. Приватні псевдоніми
; lib/persistent-map.lisp не завантажуються у складеному F6 law-runner;
; не посилаємося на незв'язаний Text7-символ під час WRITE→READ.
; Ключі пакетів є структурними D7-даними, тому читаємо й порівнюємо їх
; структурно. Вони не є D3-атомами та не проходять через EQ.
(визначити фс-об'єкти
  (функція (система) (перше система)))
(визначити фс-зв'язки
  (функція (система) (друге система)))
(визначити фс-ревізія
  (функція (система) (третє система)))

; D24: корені нуля й одиниці без похідного D6 LENGTH на шляху F6.
; Фізичний WRITE→READ використовує ті самі канонічні числа, що й Core4.
(визначити фс-число-нуль число-нуль)
(визначити фс-число-один число-один)

(визначити фс-порожній
  (функція ()
    (список (порожній-вміст-сховище) (мапа-порожній) фс-число-нуль)))

(визначити фс-корінь-адреса
  (функція (система)
    (знання-вміст-адреса
      (список (як-є wsm-fs-root)
            (фс-зв'язки система)))))

; Запис повертає (new-fs content-address): новий незмінний стан
; і адресу вмісту. Викликач сам обирає, чи зберегти старий корінь;
; це дозволяє створювати незалежні гілки стану й відновлювати попередні.
; Упорядкований SENS-прохід: адресу обчислюємо один раз.
; D6 LET* не є допустимою прямою викличною головою фізичного T5M.
; Власник адреси та логіки — мовна функція, а не Rust/Zig.
(визначити фс-записати-із-адресою
  (функція (система назва значення адреса)
    (список
      (список
        (вміст-сховище-покласти (фс-об'єкти система) адреса значення)
        (мапа-вставити назва адреса (фс-зв'язки система))
        (додати-1 (фс-ревізія система)))
      адреса)))

(визначити фс-записати
  (функція (система назва значення)
    (фс-записати-із-адресою
      система назва значення (знання-вміст-адреса значення))))

; Читання повертає протокольні дані (found value address)
; або (not-found name); значення маркерів не перейменовуємо.
; Спочатку встановлюємо наявність зв'язку, після цього перевіряємо
; рівно одну адресу. Збережене () є даними, не сигналом «не знайдено».
(визначити фс-читати-за-адресою
  (функція (система назва адреса)
    (за-умовою
      ((хибне? (вміст-сховище-містить? (фс-об'єкти система) адреса))
       (список (як-є not-found) назва))
      (так
       (список
         (як-є found)
         (перше (вміст-сховище-отримати (фс-об'єкти система) адреса))
         адреса)))))

(визначити фс-читати-зі-зв'язком
  (функція (система назва зв'язок)
    (за-умовою
      ; D3:() і будь-який атомний носій не є адресним зв'язком.
      ((атом? зв'язок) (список (як-є not-found) назва))
      (так (фс-читати-за-адресою система назва (перше зв'язок))))))

(визначити фс-читати
  (функція (система назва)
    (фс-читати-зі-зв'язком
      система назва
      (мапа-отримати назва (фс-зв'язки система)))))

(визначити фс-список
  (функція (система)
    (мапа-список (фс-зв'язки система))))

(визначити фс-містить?
  (функція (система назва)
    (хибне? (атом? (мапа-отримати назва (фс-зв'язки система))))))

; Версіоновані оболонки є звичайними списками пар із даними.
; Файлова система не обчислює їх як програмні форми.
(визначити *версія-формату-фс* (список фс-число-нуль фс-число-один))

(визначити фс-об'єкт-пакет
  (функція (значення)
    (список
      (сполучити (як-є format) (текст-у-символ "wsm-fs-object"))
      (сполучити (як-є version) *версія-формату-фс*)
      (сполучити (як-є address) (знання-вміст-адреса значення))
      (сполучити (як-є value) значення))))

(визначити фс-корінь-пакет
  (функція (система)
    (список
      (сполучити (як-є format) (текст-у-символ "wsm-fs-root"))
      (сполучити (як-є version) *версія-формату-фс*)
      (сполучити (як-є revision) (фс-ревізія система))
      (сполучити (як-є bindings) (мапа-список (фс-зв'язки система)))
      (сполучити (як-є objects) (фс-об'єкт-адреси (мапа-список (фс-об'єкти система)))))))

; Д9 F6: повертаємо адреси тільки з правильного D3-списку.
; D1:ні не є D3:(). Неправильний хвіст і атомарний запис
; спричиняють чинний D3 CAR Type до повернення результату.
; Д9/F6: структурне D3:() завершує правильний список.
; Порожня адреса D3:() — помилка Type, а не допустиме посилання
; на вигаданий вміст. D7-адреси та порядок чинних пар незмінні.
(визначити фс-об'єкт-адреси
  (функція (записи)
    (за-умовою
      ; D3:() перевіряємо лише після визначення атомного кінця списку.
      ((атом? записи)
       (за-умовою
         ((порожній? записи) (як-є ()))
         (так (перше записи))))
      ; Адреса може бути структурним D7-носієм. Порожнечу перевіряємо
      ; лише для атомної адреси; явна порожня адреса лишається Type.
      ((атом? (перше (перше записи)))
       (за-умовою
         ((порожній? (перше (перше записи)))
          (перше (перше (перше записи))))
         (так
          (сполучити
            (перше (перше записи))
            (фс-об'єкт-адреси (решта записи))))))
      (так
       (сполучити
         (перше (перше записи))
         (фс-об'єкт-адреси (решта записи)))))))

; Внутрішня перевірка точної відповіді Д1 українською.
(визначити фс-д1-ні?
  (функція (значення)
    (хибне? значення)))


; Структурний пошук у списку пар похідний від законів Д3 і Д4.
; Одна лише резидентність Д5 ASSOC не дозволяє обходити перевірку
; полів оболонки події. Ключі є атомами, а повернений хвіст — це
; початкове значення даних, а не обчислена вихідна форма.
; Невідомі й некоректні записи не отримують вигаданих значень.
; Селектори застосовують лише після перевірки форми пари.
; Це правило діє і поза рішенням щодо події журналу;
; істинність належить Д1, нового числового механізму Д24 немає.
; D9/F6: тільки відомі ключі пакетного ПРОТОКОЛУ мають D8 READ-проєкцію.
; Довільна назва не стає новою семантичною чи викличною тотожністю.
; SENS_PAIR_REGEN: F6 та стала мапа змінили перевірки D3; обидві фізичні пари треба оновити нативно.
; RELEASE GATE: після D8 EQUAL у фс-канонічний-ключ фізичні .sens і view перемайнюються лише SENS/Zig T5M; F6 producer→consumer мусить пройти на тому самому HEAD.
; RELEASE REPAIR: повторний exact-main mint + F6 producer→consumer proof обов'язковий.
(визначити фс-канонічний-ключ
  (функція (ключ)
    (за-умовою
      ; D7-імена з фізичного READ розпізнаємо структурно й відразу
      ; проєктуємо лише десять відомих назв у відповідні D8-символи.
      ((хибне? (атом? ключ))
       (за-умовою
         ((внутрішня-рівність-структур ключ (як-є format)) (текст-у-символ "format"))
         ((внутрішня-рівність-структур ключ (прочитати "format")) (текст-у-символ "format"))
         ((внутрішня-рівність-структур ключ (як-є version)) (текст-у-символ "version"))
         ((внутрішня-рівність-структур ключ (прочитати "version")) (текст-у-символ "version"))
         ((внутрішня-рівність-структур ключ (як-є revision)) (текст-у-символ "revision"))
         ((внутрішня-рівність-структур ключ (прочитати "revision")) (текст-у-символ "revision"))
         ((внутрішня-рівність-структур ключ (як-є bindings)) (текст-у-символ "bindings"))
         ((внутрішня-рівність-структур ключ (прочитати "bindings")) (текст-у-символ "bindings"))
         ((внутрішня-рівність-структур ключ (як-є objects)) (текст-у-символ "objects"))
         ((внутрішня-рівність-структур ключ (прочитати "objects")) (текст-у-символ "objects"))
         ((внутрішня-рівність-структур ключ (як-є address)) (текст-у-символ "address"))
         ((внутрішня-рівність-структур ключ (прочитати "address")) (текст-у-символ "address"))
         ((внутрішня-рівність-структур ключ (як-є value)) (текст-у-символ "value"))
         ((внутрішня-рівність-структур ключ (прочитати "value")) (текст-у-символ "value"))
         ((внутрішня-рівність-структур ключ (як-є op)) (текст-у-символ "op"))
         ((внутрішня-рівність-структур ключ (прочитати "op")) (текст-у-символ "op"))
         ((внутрішня-рівність-структур ключ (як-є name)) (текст-у-символ "name"))
         ((внутрішня-рівність-структур ключ (прочитати "name")) (текст-у-символ "name"))
         ((внутрішня-рівність-структур ключ (як-є root)) (текст-у-символ "root"))
         ((внутрішня-рівність-структур ключ (прочитати "root")) (текст-у-символ "root"))
         (так ключ)))
      ; D8-символ уже атомний. Нормалізуємо тільки точний білий список.
      ((однакові? ключ (текст-у-символ "format")) (текст-у-символ "format"))
      ((однакові? ключ (текст-у-символ "version")) (текст-у-символ "version"))
      ((однакові? ключ (текст-у-символ "revision")) (текст-у-символ "revision"))
      ((однакові? ключ (текст-у-символ "bindings")) (текст-у-символ "bindings"))
      ((однакові? ключ (текст-у-символ "objects")) (текст-у-символ "objects"))
      ((однакові? ключ (текст-у-символ "address")) (текст-у-символ "address"))
      ((однакові? ключ (текст-у-символ "value")) (текст-у-символ "value"))
      ((однакові? ключ (текст-у-символ "op")) (текст-у-символ "op"))
      ((однакові? ключ (текст-у-символ "name")) (текст-у-символ "name"))
      ((однакові? ключ (текст-у-символ "root")) (текст-у-символ "root"))
      (так ключ))))

(визначити фс-пакет-однаковий-ключ?
  (функція (лівий правий)
    (за-умовою
      ; Невідомий складений ключ не доходить до атомної рівності.
      ((хибне? (атом? (фс-канонічний-ключ лівий))) ні)
      ((хибне? (атом? (фс-канонічний-ключ правий))) ні)
      (так
        (однакові?
          (фс-канонічний-ключ лівий)
          (фс-канонічний-ключ правий))))))

; D9/F6: D7-кодоване ім'я може бути скінченним списком гліфів.
; Атомні ключі зберігають попередній допуск; структурні ключі
; допускаємо ТІЛЬКИ для десяти канонічних імен протоколу.
; Довільна вкладена пара не є іменем поля.
(визначити фс-пакет-ключ-допустимий?
  (функція (ключ)
    (за-умовою
      ; Спершу розрізняємо D7-структуру й атом. Порожній? — лише для атома.
      ((хибне? (атом? ключ))
       (за-умовою
         ((хибне? (атом? (фс-канонічний-ключ ключ))) ні)
         ((однакові? (фс-канонічний-ключ ключ) (текст-у-символ "format")) так)
         ((однакові? (фс-канонічний-ключ ключ) (текст-у-символ "version")) так)
         ((однакові? (фс-канонічний-ключ ключ) (текст-у-символ "revision")) так)
         ((однакові? (фс-канонічний-ключ ключ) (текст-у-символ "bindings")) так)
         ((однакові? (фс-канонічний-ключ ключ) (текст-у-символ "objects")) так)
         ((однакові? (фс-канонічний-ключ ключ) (текст-у-символ "address")) так)
         ((однакові? (фс-канонічний-ключ ключ) (текст-у-символ "value")) так)
         ((однакові? (фс-канонічний-ключ ключ) (текст-у-символ "op")) так)
         ((однакові? (фс-канонічний-ключ ключ) (текст-у-символ "name")) так)
         ((однакові? (фс-канонічний-ключ ключ) (текст-у-символ "root")) так)
         (так ні)))
      ((порожній? ключ) ні)
      ; Атомний ключ допускається лише за точним D8-іменем зі списку.
      ((однакові? ключ (текст-у-символ "format")) так)
      ((однакові? ключ (текст-у-символ "version")) так)
      ((однакові? ключ (текст-у-символ "revision")) так)
      ((однакові? ключ (текст-у-символ "bindings")) так)
      ((однакові? ключ (текст-у-символ "objects")) так)
      ((однакові? ключ (текст-у-символ "address")) так)
      ((однакові? ключ (текст-у-символ "value")) так)
      ((однакові? ключ (текст-у-символ "op")) так)
      ((однакові? ключ (текст-у-символ "name")) так)
      ((однакові? ключ (текст-у-символ "root")) так)
      (так ні))))

(визначити фс-пакет-поле
  (функція (назва пакет)
    (за-умовою
      ; Пакет і його хвіст перевіряємо як структуру до будь-яких D3-операцій.
      ((атом? пакет) (як-є ()))
      ; Елемент пакета — dotted pair (ключ . значення), не список (ключ значення).
      ((атом? (перше пакет)) (як-є ()))
      ; Ключ може бути багатоклітинною D7-парою, тому не передаємо його
      ; в атомну перевірку порожнечі. Значення повертаємо як увесь хвіст,
      ; зокрема явне D3:() не плутаємо з відсутнім полем.
      ((фс-пакет-однаковий-ключ? назва (перше (перше пакет)))
       (решта (перше пакет)))
      (так (фс-пакет-поле назва (решта пакет))))))
; D9 F6: цей source SHA є єдиним входом canonical SENS→Zig/T5M remint.
; Зовнішній рядковий envelope має бути String або Text7, явно наданий SENS;
; Rust не перетворює довільний Pair на текст і не вирішує пакетну семантику.
; D9 F6: відповідність мітки зовнішнього формату після WRITE → READ.
; Канонічні D7-структурні дані та відновлений D8-символ розрізняємо,
; але обидва мають одну й ту саму назву ФІКСОВАНОГО протоколу.
; Довільні значення не перетворюємо на мітки і не приймаємо.
; D9/F6: READ із зовнішнього фізичного String може повернути власне
; D7-значення, відмінне від готового D8 символу. Дозволений тільки
; рівно той самий закритий маркер із канонічного SENS READ.
(визначити фс-формат-об'єкта?
  (функція (значення)
    (за-умовою
      ; У фізичному пакеті маркер може бути D7-парою, а не атомом.
      ; Структурна рівність порівнює атоми й пари, не передаючи пару до D3 EQ.
      ((внутрішня-рівність-структур значення (як-є wsm-fs-object)) так)
      ((внутрішня-рівність-структур значення (текст-у-символ "wsm-fs-object")) так)
      ((внутрішня-рівність-структур значення (прочитати "wsm-fs-object")) так)
      ; Єдиний дозволений фізичний D7-носій — поле format еталонного SENS-пакета.
      ((внутрішня-рівність-структур
         значення
         (фс-пакет-поле (як-є format)
           (прочитати
             (значення-у-текст
               (фс-об'єкт-пакет (як-є ()))))))
       так)
      ; Точне READ(WRITE(symbol)); ніякої довільної серіалізації.
      (так
       (внутрішня-рівність-структур
         значення
         (прочитати
           (значення-у-текст (текст-у-символ "wsm-fs-object"))))))))

; D9/F6: коренева мітка рівно одна; READ-проєкція не є новим
; псевдонімом або дозволом сторонніх текстових форматів.
(визначити фс-формат-кореня?
  (функція (значення)
    (за-умовою
      ; У фізичному пакеті маркер може бути D7-парою, а не атомом.
      ; Структурна рівність порівнює атоми й пари, не передаючи пару до D3 EQ.
      ((внутрішня-рівність-структур значення (як-є wsm-fs-root)) так)
      ((внутрішня-рівність-структур значення (текст-у-символ "wsm-fs-root")) так)
      ((внутрішня-рівність-структур значення (прочитати "wsm-fs-root")) так)
      ; Єдиний дозволений фізичний D7-носій — поле format еталонного SENS-пакета.
      ((внутрішня-рівність-структур
         значення
         (фс-пакет-поле (як-є format)
           (прочитати
             (значення-у-текст
               (фс-корінь-пакет (фс-порожній))))))
       так)
      ; Точне READ(WRITE(symbol)); ніякої довільної серіалізації.
      (так
       (внутрішня-рівність-структур
         значення
         (прочитати
           (значення-у-текст (текст-у-символ "wsm-fs-root"))))))))

(визначити рішення-щодо-пакета-об'єкта-файлової-системи
  (функція (пакет)
    (за-умовою
      ((атом? пакет)
       (список (як-є rejected) (як-є invalid-package)))
      ; Унікальність стосується також невідомих полів-розширень.
      ((хибне? (фс-пакет-унікальні-ключі? пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ; Присутність кожного поля перевіряється ОКРЕМО від його значення.
      ; Існуюче D3:() є допустимими даними, відсутність ключа — ні.
      ((хибне? (фс-пакет-єдине-поле? (як-є format) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне? (фс-пакет-єдине-поле? (як-є version) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне? (фс-пакет-єдине-поле? (як-є address) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне? (фс-пакет-єдине-поле? (як-є value) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне? (фс-формат-об'єкта?
                   (фс-пакет-поле (як-є format) пакет)))
       (список (як-є rejected) (як-є invalid-format)))
      ((хибне?
         (фс-версія-журналу-чинна? (фс-пакет-поле (як-є version) пакет)))
       (список (як-є rejected) (як-є unsupported-version)))
      ((хибне?
         (однакові? (фс-пакет-поле (як-є address) пакет)
                   (знання-вміст-адреса (фс-пакет-поле (як-є value) пакет))))
       (список (як-є rejected) (як-є address-mismatch)))
      ((однакові? (фс-пакет-поле (як-є address) пакет)
                 (знання-вміст-адреса (фс-пакет-поле (як-є value) пакет)))
       (список (як-є accepted) (фс-пакет-поле (як-є value) пакет))))))
(визначити фс-серіалізувати-об'єкт
  (функція (значення)
    (значення-у-текст (фс-об'єкт-пакет значення))))

(визначити фс-десеріалізувати-об'єкт
  (функція (текст)
    (рішення-щодо-пакета-об'єкта-файлової-системи (прочитати текст))))

; Будь-яка зміна цього джерела вимагає native SENS → Zig/T5M remint
; lib/lisp-fs.sens до semantic-law sweep; source/physical drift — RED.
; RELEASE REPAIR 2026-10-25: mint and F6 producer→consumer proof must use
; this exact post-D9-key-order source and one exact main SHA.
; F6: список зв'язувань містить ЛИШЕ пари (ім'я . адреса).
; Д3:() завершує обхід; атомний запис або хвіст не приймаються.
; Тут перевіряємо форму, не перейменовуємо і не обчислюємо D7-адреси.
(визначити фс-зв'язки-правильні?
  (функція (записи)
    (за-умовою
      ((атом? записи)
       (за-умовою
         ((порожній? записи) так)
         (так ні)))
      ((атом? (перше записи)) ні)
      ; Запис є парою (ім'я . адреса); атомне ім'я допустиме.
      ; Неправильний одиночний запис відхиляє попередня перевірка
      ; (атом? (перше записи)), а весь хвіст перевіряє рекурсія.
      (так (фс-зв'язки-правильні? (решта записи))))))

; Коренева оболонка F2 перевіряє власні формат, версію, ревізію,
; зв'язування та об'єкти. Поля адреси й значення об'єктової оболонки
; не є полями кореневої оболонки.
; Історичний предикат правильного списку повертав істину хоста;
; це не дозволено використовувати як результат умови D3.
; Локальний закон D1: порожній список правильний, для пари
; перевіряємо хвіст рекурсивно, інші атоми не є правильним списком.
(визначити внутрішній-правильний-список?
  (функція (значення)
    (за-умовою
      ((атом? значення)
       (за-умовою
         ((порожній? значення) так)
         (так ні)))
      (так (внутрішній-правильний-список? (решта значення))))))

(визначити рішення-щодо-кореневого-пакета-файлової-системи
  (функція (пакет)
    (за-умовою
      ((атом? пакет)
       (список (як-є rejected) (як-є invalid-package)))
      ; Унікальність стосується також невідомих полів-розширень.
      ((хибне? (фс-пакет-унікальні-ключі? пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ; Присутність кожного поля перевіряється ОКРЕМО від його значення.
      ; Існуюче D3:() є допустимими даними, відсутність ключа — ні.
      ((хибне? (фс-пакет-єдине-поле? (як-є format) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне? (фс-пакет-єдине-поле? (як-є version) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне? (фс-пакет-єдине-поле? (як-є revision) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне? (фс-пакет-єдине-поле? (як-є bindings) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне? (фс-пакет-єдине-поле? (як-є objects) пакет))
       (список (як-є rejected) (як-є invalid-package)))
      ((хибне? (фс-формат-кореня?
                   (фс-пакет-поле (як-є format) пакет)))
       (список (як-є rejected) (як-є invalid-format)))
      ((хибне?
         (фс-версія-журналу-чинна? (фс-пакет-поле (як-є version) пакет)))
       (список (як-є rejected) (як-є unsupported-version)))
      ((хибне? (фс-зв'язки-правильні? (фс-пакет-поле (як-є bindings) пакет)))
       (список (як-є rejected) (як-є invalid-bindings)))
      ((хибне? (внутрішній-правильний-список? (фс-пакет-поле (як-є objects) пакет)))
       (список (як-є rejected) (як-є invalid-objects)))
      ((внутрішній-правильний-список? (фс-пакет-поле (як-є objects) пакет))
       (список (як-є accepted) пакет)))))
(визначити фс-серіалізувати-корінь
  (функція (система)
    (значення-у-текст (фс-корінь-пакет система))))

(визначити фс-десеріалізувати-корінь
  (функція (текст)
    (рішення-щодо-кореневого-пакета-файлової-системи (прочитати текст))))

; Відновлюємо знімок у пам'яті лише з оболонок-даних.
; Жодна оболонка не виконується. Якщо посилання веде на відсутній
; об'єкт, відновлення відхиляється до повернення стану:
; викликач бачить атомарний результат.
; Обхід закінчується лише на структурній порожнечі.
; Кожен пакет непорожнього правильного списку треба перевірити
; і додати; непорожній атом відхиляємо. Старий тест заперечення
; атомарності помилково пропускав будь-який непорожній список.
; Рішення кожного пакета перевіряємо перед зміною нового знімка.
; Відхилений пакет не додає до сховища жодного часткового об'єкта.
(визначити фс-додати-перевірений-об'єкт
  (функція (пакети сховище рішення)
    (за-умовою
      ((хибне? (однакові? (перше рішення) (як-є accepted))) рішення)
      (так
       (фс-побудувати-об'єкт-сховище
         (решта пакети)
         (вміст-сховище-покласти
           сховище
           (знання-вміст-адреса (друге рішення))
           (друге рішення)))))))

(визначити фс-побудувати-об'єкт-сховище
  (функція (пакети сховище)
    (за-умовою
      ((атом? пакети)
       (за-умовою
         ((порожній? пакети) (список (як-є accepted) сховище))
         (так (список (як-є rejected) (як-є invalid-object-packages)))))
      (так
       (фс-додати-перевірений-об'єкт
         пакети сховище
         (рішення-щодо-пакета-об'єкта-файлової-системи
           (перше пакети)))))))

; Перевірки наявності всіх адрес є згортками з точними результатами D1:
; порожній список дає істину, неправильний хвіст або відсутній
; вміст — хибу. Не допускаються істина хоста, підміна порожнечею
; або неявне перетворення довільних значень на предикатний результат.
(визначити усі-адреси-об'єктів-файлової-системи-наявні?
  (функція (адреси сховище)
    (за-умовою
      ((атом? адреси)
       (за-умовою
         ((порожній? адреси) так)
         (так ні)))
      ((хибне? (вміст-сховище-містить? сховище (перше адреси)))
       ні)
      (так (усі-адреси-об'єктів-файлової-системи-наявні? (решта адреси) сховище)))))

(визначити усі-адреси-зв'язувань-у-файловій-системі-наявні?
  (функція (записи сховище)
    (за-умовою
      ((атом? записи)
       (за-умовою
         ((порожній? записи) так)
         (так ні)))
      ((атом? (перше записи)) ні)
      ((хибне? (вміст-сховище-містить? сховище (друге (перше записи))))
       ні)
      (так (усі-адреси-зв'язувань-у-файловій-системі-наявні? (решта записи) сховище)))))

; Після кореневого допуску перевіряємо ВСІ адреси об'єктів та
; зв'язувань. Немає часткового прийняття або обчислення LET* у хості.
(визначити фс-відновити-корінь-із-об'єктами
  (функція (кореневий-пакет рішення-об'єктів)
    (за-умовою
      ((хибне? (однакові? (перше рішення-об'єктів) (як-є accepted)))
       рішення-об'єктів)
      ((хибне? (усі-адреси-об'єктів-файлової-системи-наявні?
                  (фс-пакет-поле (як-є objects) кореневий-пакет)
                  (друге рішення-об'єктів)))
       (список (як-є rejected) (як-є missing-object)))
      ((хибне? (усі-адреси-зв'язувань-у-файловій-системі-наявні?
                  (фс-пакет-поле (як-є bindings) кореневий-пакет)
                  (друге рішення-об'єктів)))
       (список (як-є rejected) (як-є missing-object)))
      (так
       (список
         (як-є accepted)
         (список
           (друге рішення-об'єктів)
           (фс-зв'язки-з-список
             (фс-пакет-поле (як-є bindings) кореневий-пакет)
             (мапа-порожній))
           (фс-пакет-поле (як-є revision) кореневий-пакет)))))))

(визначити фс-відновити-корінь-із-рішенням
  (функція (кореневий-пакет пакети-об'єктів рішення-кореня)
    (за-умовою
      ((хибне? (однакові? (перше рішення-кореня) (як-є accepted)))
       рішення-кореня)
      (так
       (фс-відновити-корінь-із-об'єктами
         кореневий-пакет
         (фс-побудувати-об'єкт-сховище
           пакети-об'єктів (порожній-вміст-сховище)))))))

(визначити фс-відновити-корінь
  (функція (кореневий-пакет пакети-об'єктів)
    (фс-відновити-корінь-із-рішенням
      кореневий-пакет пакети-об'єктів
      (рішення-щодо-кореневого-пакета-файлової-системи
        кореневий-пакет))))

(визначити фс-зв'язки-з-список
  (функція (записи зв'язки)
    (за-умовою
      ; Спершу відрізняємо атомний кінець від пари; інший атом
      ; не стає успішним кінцем списку.
      ((атом? записи)
       (за-умовою
         ((порожній? записи) зв'язки)
         (так (перше записи))))
      (так (фс-зв'язки-з-список
           (решта записи)
           (мапа-вставити (перше (перше записи)) (друге (перше записи)) зв'язки))))))

; Записи журналу F3 є лише даними, події додаються без стирання історії.
; Відтворення починається з порожнього стану файлової системи
; й повертає (accepted fs) або (rejected reason) як дані протоколу.
; Невідомі та пошкоджені події не можуть створювати частковий стан.
(визначити *версія-журналу-фс* (список фс-число-нуль фс-число-один))

(визначити фс-журнал-подія
  (функція (операція поля)
    (сполучити
      (сполучити (як-є format) (як-є wsm-fs-event))
      (сполучити
        (сполучити (як-є version) *версія-журналу-фс*)
        (сполучити (сполучити (як-є op) операція) поля)))))

(визначити фс-журнал-записати-подія
  (функція (назва значення)
    (фс-журнал-подія
      (як-є write)
      (список (сполучити (як-є name) назва) (сполучити (як-є value) значення)))))

(визначити фс-журнал-зв'язати-подія
  (функція (назва адреса)
    (фс-журнал-подія
      (як-є bind)
      (список (сполучити (як-є name) назва) (сполучити (як-є address) адреса)))))

(визначити фс-журнал-розв'язати-подія
  (функція (назва)
    (фс-журнал-подія (як-є unbind) (список (сполучити (як-є name) назва)))))

(визначити фс-журнал-корінь-коміт-подія
  (функція (кореневий-пакет)
    (фс-журнал-подія
      (як-є root-commit)
      (список (сполучити (як-є root) кореневий-пакет)))))

(визначити фс-журнал-додати
  (функція (журнал подія)
    (приєднати журнал (список подія))))

; Перевірка журналу — мовне виведення з точною істинністю D1,
; без запозичення недоведеної викличності похідних операцій D8.
; Наявність поля перевіряється окремо від його значення:
; структурна порожнеча, записана в поле, не означає відсутності поля.
; Перед вкладеними селекторами завжди перевіряємо форму даних.
(визначити фс-пакет-має-поле?
  (функція (назва пакет)
    (за-умовою
      ; Порожній список і неправильний атомний хвіст відхиляються без EQ над парою.
      ((атом? пакет) ні)
      ((атом? (перше пакет)) ні)
      ; Ключ може бути структурним D7-ланцюгом: його перевіряє канонічний порівнювач.
      ((фс-пакет-однаковий-ключ? назва (перше (перше пакет))) так)
      (так (фс-пакет-має-поле? назва (решта пакет))))))

; D9 F6/F3: значення поля може бути D3:(), але метадані повинні
; мати РІВНО ОДИН запис із кожним обов'язковим ключем.
; Д1-свідок передається окремо; перевірка не стирає дублікати.
(визначити фс-пакет-єдине-поле-ядро
  (функція (назва пакет знайдено)
    (за-умовою
      ; Розрізняємо атомний кінець і пару перед перевіркою порожнечі.
      ((атом? пакет)
       (за-умовою
         ((порожній? пакет) знайдено)
         (так ні)))
      ((атом? (перше пакет)) ні)
      ; Допуск ключа відхиляє (), атоми поза білим списком і довільні вкладені пари.
      ; Не викликаємо порожній? на D7-ланцюгу ключа.
      ((хибне? (фс-пакет-ключ-допустимий? (перше (перше пакет)))) ні)
      ((фс-пакет-однаковий-ключ? назва (перше (перше пакет)))
       (за-умовою
         (знайдено ні)
         (так
          (фс-пакет-єдине-поле-ядро
            назва (решта пакет) так))))
      (так
       (фс-пакет-єдине-поле-ядро
         назва (решта пакет) знайдено)))))

(визначити фс-пакет-єдине-поле?
  (функція (назва пакет)
    (фс-пакет-єдине-поле-ядро назва пакет ні)))

; Версія F3 складається рівно з двох атомарних елементів: нуль і один.
; Перед селекторами перевіряємо форму, а кожна гілка повертає
; точне предикатне значення D1.
(визначити фс-версія-журналу-чинна?
  (функція (кандидат)
    (за-умовою
      ((атом? кандидат) ні)
      ((атом? (решта кандидат)) ні)
      ; Неправильний довгий хвіст відхиляємо до D3 порожності.
      ((хибне? (атом? (решта (решта кандидат)))) ні)
      ((порожній? (решта (решта кандидат)))
       (за-умовою
         ((однакові? (перше кандидат) фс-число-нуль)
          (однакові? (перше (решта кандидат)) фс-число-один))
         (так ні)))
      (так ні))))

; Структурна форма alist перевіряється ДО селекторів полів.
; Ключ — непорожнє D7-значення; значення може бути EMPTY.
; D1-вердикт належить самому SENS; ратифікації нової координати немає.
(визначити фс-журнал-список-пар?
  (функція (записи)
    (за-умовою
      ; D3:() — кінець; інший атомний хвіст не є списком.
      ((атом? записи)
       (за-умовою
         ((порожній? записи) так)
         (так ні)))
      ((атом? (перше записи)) ні)
      ; Допуск ключа нижче перевіряє пусті та довільні ключі без EQ над D7-парами.
      ((хибне? (фс-пакет-ключ-допустимий? (перше (перше записи)))) ні)
      (так (фс-журнал-список-пар? (решта записи))))))

; Д9 F3: обов'язкові поля пакета журналу не можуть мати двох значень.
; Після структурного доказу перевіряємо КОЖНИЙ ключ, а не лише format.
; Дубль навіть необов'язкового ключа робить подію неоднозначною.
; Ні текстових підмін, ні зовнішнього числового лічильника.
(визначити фс-пакет-унікальні-ключі?
  (функція (записи)
    (за-умовою
      ; D3:() — кінець списку; перевіряємо його тільки для атома.
      ((атом? записи)
       (за-умовою
         ((порожній? записи) так)
         (так ні)))
      ((атом? (перше записи)) ні)
      ((хибне? (фс-пакет-ключ-допустимий? (перше (перше записи)))) ні)
      ((фс-пакет-має-поле?
         (перше (перше записи)) (решта записи))
       ні)
      (так
       (фс-пакет-унікальні-ключі? (решта записи))))))

(визначити рішення-щодо-події-журналу-файлової-системи
  (функція (подія)
    (за-умовою
      ; Будь-який атом, зокрема D3:(), не є оболонкою події.
      ((атом? подія) (список (як-є rejected) (як-є invalid-event)))
      ((хибне? (фс-журнал-список-пар? подія))
       (список (як-є rejected) (як-є invalid-event)))
      ((хибне? (фс-пакет-унікальні-ключі? подія))
       (список (як-є rejected) (як-є duplicate-event-field)))
      ((хибне?
         (внутрішня-рівність-структур
           (фс-пакет-поле (як-є format) подія)
           (як-є wsm-fs-event)))
       (список (як-є rejected) (як-є invalid-format)))
      ((хибне? (фс-версія-журналу-чинна? (фс-пакет-поле (як-є version) подія)))
       (список (як-є rejected) (як-є unsupported-version)))
      ; Операція має бути атомом до перевірки порожнечі та порівняння.
      ((хибне? (атом? (фс-пакет-поле (як-є op) подія)))
       (список (як-є rejected) (як-є invalid-operation)))
      ((порожній? (фс-пакет-поле (як-є op) подія))
       (список (як-є rejected) (як-є missing-operation)))
      ((однакові? (фс-пакет-поле (як-є op) подія) (як-є write))
       (за-умовою
         ((хибне? (фс-пакет-має-поле? (як-є name) подія))
          (список (як-є rejected) (як-є incomplete-write)))
         ((хибне? (фс-пакет-має-поле? (як-є value) подія))
          (список (як-є rejected) (як-є incomplete-write)))
         (так (список (як-є accepted) подія))))
      ((однакові? (фс-пакет-поле (як-є op) подія) (як-є bind))
       (за-умовою
         ((хибне? (фс-пакет-має-поле? (як-є name) подія))
          (список (як-є rejected) (як-є incomplete-bind)))
         ((хибне? (фс-пакет-має-поле? (як-є address) подія))
          (список (як-є rejected) (як-є incomplete-bind)))
         (так (список (як-є accepted) подія))))
      ((однакові? (фс-пакет-поле (як-є op) подія) (як-є unbind))
       (за-умовою
         ((хибне? (фс-пакет-має-поле? (як-є name) подія))
          (список (як-є rejected) (як-є incomplete-unbind)))
         (так (список (як-є accepted) подія))))
      ((однакові? (фс-пакет-поле (як-є op) подія) (як-є root-commit))
       (за-умовою
         ((хибне? (фс-пакет-має-поле? (як-є root) подія))
          (список (як-є rejected) (як-є incomplete-root-commit)))
         (так (список (як-є accepted) подія))))
      (так (список (як-є rejected) (як-є unknown-event))))))
(визначити фс-зв'язки-без-імені
  (функція (записи назва результат)
    (за-умовою
      ; Атомний кінець перевіряється раніше за порожнечу.
      ((атом? записи)
       (за-умовою
         ((порожній? записи) результат)
         (так результат)))
      ((однакові? (перше (перше записи)) назва)
       (фс-зв'язки-без-імені (решта записи) назва результат))
      (так
        (фс-зв'язки-без-імені
          (решта записи)
          назва
          (мапа-вставити (перше (перше записи)) (решта (перше записи)) результат))))))

(визначити фс-розв'язати
  (функція (система назва)
    (список
      (фс-об'єкти система)
      (фс-зв'язки-без-імені (мапа-список (фс-зв'язки система)) назва (мапа-порожній))
      (додати-1 (фс-ревізія система)))))

; Тотожність зафіксованих коренів незмінних дерев випливає
; зі структурних законів D3 і D4; кожен рівень рекурсії
; повертає точне предикатне значення D1.
(визначити внутрішня-рівність-структур
  (функція (ліве праве)
    ; D3 EQ / порожній? діє лише на атомах: спочатку відділяємо
    ; атомний випадок від пар, не передаючи пару в порожній?.
    ; Одночасно атомна гілка покриває NIL/NIL через однакові?.
    (за-умовою
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (однакові? ліве праве))
         (так ні)))
      ((атом? праве) ні)
      ((внутрішня-рівність-структур (перше ліве) (перше праве))
       (внутрішня-рівність-структур (решта ліве) (решта праве)))
      (так ні))))

(визначити фс-журнал-відтворити-подію
  (функція (система подія)
    (нехай-послідовно ((рішення (рішення-щодо-події-журналу-файлової-системи подія)))
      (за-умовою
        ((хибне? (однакові? (перше рішення) (як-є accepted))) рішення)
        (так
          (нехай-послідовно ((операція (фс-пакет-поле (як-є op) подія)))
            (за-умовою
              ((однакові? операція (як-є write))
               (нехай-послідовно ((записано (фс-записати система
                                        (фс-пакет-поле (як-є name) подія)
                                        (фс-пакет-поле (як-є value) подія))))
                 (список (як-є accepted) (перше записано))))
              ((однакові? операція (як-є bind))
               (нехай-послідовно ((адреса (фс-пакет-поле (як-є address) подія)))
                 (за-умовою
                   ((хибне? (вміст-сховище-містить? (фс-об'єкти система) адреса))
                    (список (як-є rejected) (як-є missing-object)))
                   (так
                     (список
                       (як-є accepted)
                       (список
                         (фс-об'єкти система)
                         (мапа-вставити (фс-пакет-поле (як-є name) подія)
                                     адреса
                                     (фс-зв'язки система))
                         (додати-1 (фс-ревізія система))))))))
              ((однакові? операція (як-є unbind))
               (список (як-є accepted)
                     (фс-розв'язати система (фс-пакет-поле (як-є name) подія))))
              ((однакові? операція (як-є root-commit))
               (за-умовою
                 ((внутрішня-рівність-структур (фс-корінь-пакет система)
                           (фс-пакет-поле (як-є root) подія))
                  (список (як-є accepted) система))
                 (так (список (як-є rejected) (як-є root-mismatch)))))
              (так (список (як-є rejected) (як-є unknown-event))))))))))

(визначити фс-журнал-відтворити-на-стан
  (функція (журнал система)
    (за-умовою
      ((атом? журнал)
       (за-умовою
         ((порожній? журнал) (список (як-є accepted) система))
         (так (список (як-є rejected) (як-є invalid-event)))))
      (так
        (нехай-послідовно ((рішення (фс-журнал-відтворити-подію система (перше журнал))))
          (за-умовою
            ((хибне? (однакові? (перше рішення) (як-є accepted))) рішення)
            (так (фс-журнал-відтворити-на-стан (решта журнал) (друге рішення)))))))))

(визначити фс-журнал-повторити
  (функція (журнал)
    (фс-журнал-відтворити-на-стан журнал (фс-порожній))))

(визначити фс-серіалізувати-журнал
  (функція (журнал)
    (значення-у-текст журнал)))

(визначити фс-десеріалізувати-журнал
  (функція (текст)
    (фс-журнал-повторити (прочитати текст))))

; Межа фіксації F4: об'єкти та журнал дозволено записати раніше,
; але знімок стає видимим лише після завершення етапу кореневого
; покажчика. Перевірка допустимості етапу повертає точне D1,
; а не істину хоста чи неявну порожнечу.
(визначити фс-етап-коміту?
  (функція (етап)
    (за-умовою
      ((однакові? етап (як-є objects)) так)
      ((однакові? етап (як-є journal)) так)
      ((однакові? етап (як-є root-pointer)) так)
      (так ні))))
(визначити відновити-завершену-фіксацію-файлової-системи
  (функція (стара-система нова-система завершений-етап)
    (за-умовою
      ((хибне? (фс-етап-коміту? завершений-етап))
       (список (як-є rejected) (як-є unknown-commit-stage)))
      ((однакові? завершений-етап (як-є root-pointer))
       (список (як-є recovered) нова-система))
      (так (список (як-є recovered) стара-система)))))

(визначити відновити-кореневий-пакет-файлової-системи
  (функція (старий-пакет пакет-кандидат завершений-етап)
    (за-умовою
      ; root-pointer можна порівнювати через D3 EQ лише після ATOM.
      ; Список або крапкова пара завжди зберігають попередній пакет.
      ((атом? завершений-етап)
       (за-умовою
         ((однакові? завершений-етап (як-є root-pointer))
          (нехай-послідовно ((рішення (рішення-щодо-кореневого-пакета-файлової-системи пакет-кандидат)))
            (за-умовою
              ((однакові? (перше рішення) (як-є accepted))
               (список (як-є recovered) пакет-кандидат))
              (так
               (список (як-є recovered) старий-пакет (як-є rejected-candidate))))))
         (так (список (як-є recovered) старий-пакет))))
      (так (список (як-є recovered) старий-пакет)))))

; Функції файлової системи визначено українськими SENS-замиканнями вище.
; Ідентичності D9/D10 належать lib/domains/d9.lisp і d10.lisp, а не
; дубльованим латинським DEFINE у виконуваному джерелі.
; Протокольні мітки (fs, wsm-fs-*) залишаються незмінними цитованими даними.
; SENS_PAIR_REGEN: 2026-10-25 mint lib/lisp-fs after physical T5M source drift.
; SENS_REMINT_RELEASE_REASONING_F6: повторно карбувати точне джерело після виправлення циклу залежностей; фізичний F6 ще не засвідчено.
