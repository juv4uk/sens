; SENS: епістемічний модуль з українськими виконуваними викликами.
; Джерело семантики: ратифіковані домени D1, D3–D5, D9 і D10.
; Точні D1 істина/хиба з D3 тотожне?; порожня структура не є довільною
; логічною істиною. Локальні значення не залежать від host-констант.
; Для порівняння структур D3 EQ застосовується лише до двох атомів.
; Джерельні теги полів і маркери доказів лишаються цитованими даними.
; Викличні назви беруться з чинних українських проєкцій D9 і D10.
; Модуль не запускає наміри, не виконує зовнішніх дій і не змінює рушій.
; Жодних сід8/сенс8, нератифікованих машинних голів або numeric bridge.

; Bare SENS не вводить глобальних символів «так» та «ні» у сеансі.
; Це локальні імена для ТОЧНИХ D1 результатів ратифікованого D3 EQ,
; а не нові константи числового D24 або прихований host-предикат.
(визначити епістеміка--так (тотожне? (як-є ()) (як-є ())))
(визначити епістеміка--ні (тотожне? (як-є ()) (як-є відсутнє)))

; Існуюче зв'язування повного українського імені конструктора твердження.
(визначити створити-структуроване-твердження створити-твердження)


; Перевірка форми посилання. Теги — дані, а не виклики.
; Після перевірки атомарності кінцевий хвіст повинен бути саме порожнім.
; Крапкова пара з непорожнім атомним хвостом не є двопольовим записом.
(визначити це-належне-посилання-на-джерело?
  (функція (значення)
    (за-умовою
      ((атом? значення) епістеміка--ні)
      ((атом? (решта значення)) епістеміка--ні)
      ((хибне? (атом? (решта (решта значення)))) епістеміка--ні)
      ((хибне? (тотожне? (решта (решта значення)) (як-є ()))) епістеміка--ні)
      ((хибне? (атом? (перше значення))) епістеміка--ні)
      ((тотожне? (перше значення) (як-є digest)) епістеміка--так)
      ((тотожне? (перше значення) (як-є proof)) епістеміка--так)
      ((тотожне? (перше значення) (як-є test)) епістеміка--так)
      ((тотожне? (перше значення) (як-є observation)) епістеміка--так)
      (епістеміка--так епістеміка--ні))))

(визначити епістеміка--посилання-на-твердження?
  (функція (значення)
    (за-умовою
      ((атом? значення) епістеміка--ні)
      ((атом? (решта значення)) епістеміка--ні)
      ((хибне? (атом? (решта (решта значення)))) епістеміка--ні)
      ((хибне? (тотожне? (решта (решта значення)) (як-є ()))) епістеміка--ні)
      ((хибне? (атом? (перше значення))) епістеміка--ні)
      ((тотожне? (перше значення) (як-є claim-ref)) епістеміка--так)
      (епістеміка--так епістеміка--ні))))

; Доступ до полів записів за допомогою ратифікованих селекторів.
(визначити твердження-твердження (функція (твердження) (друге (знайти-за-ключем (як-є statement) (решта твердження)))))
(визначити твердження-перевірка (функція (твердження) (друге (знайти-за-ключем (як-є review) (решта твердження)))))
(визначити доказ-підсумок (функція (доказ) (друге (знайти-за-ключем (як-є outcome) (решта доказ)))))
(визначити отримати-посилання-на-джерело-доказу (функція (доказ) (друге (знайти-за-ключем (як-є source-ref) (решта доказ)))))
(визначити намір-ціль (функція (намір) (друге (знайти-за-ключем (як-є goal) (решта намір)))))

(визначити отримати-джерело-спостереження (функція (спостереження) (друге (знайти-за-ключем (як-є source) (решта спостереження)))))
(визначити спостереження-твердження (функція (спостереження) (друге (знайти-за-ключем (як-є statement) (решта спостереження)))))
(визначити отримати-посилання-доказу-на-твердження (функція (доказ) (друге (знайти-за-ключем (як-є claim-ref) (решта доказ)))))
(визначити доказ-метод (функція (доказ) (друге (знайти-за-ключем (як-є method) (решта доказ)))))
(визначити отримати-необхідні-можливості-наміру (функція (намір) (друге (знайти-за-ключем (як-є requires) (решта намір)))))
(визначити отримати-умови-зупинки-наміру (функція (намір) (друге (знайти-за-ключем (як-є stop-on) (решта намір)))))
(визначити отримати-очікувані-результати-наміру (функція (намір) (друге (знайти-за-ключем (як-є produces) (решта намір)))))

; Рекурсивне порівняння атомів і пар без D8-підміни.
(визначити епістеміка--рівні-посилання?
  (функція (лівий правий)
    (за-умовою
      ((атом? лівий)
       (за-умовою
         ((атом? правий) (тотожне? лівий правий))
         (епістеміка--так епістеміка--ні)))
      ((атом? правий) епістеміка--ні)
      ((епістеміка--рівні-посилання? (перше лівий) (перше правий))
       (епістеміка--рівні-посилання? (решта лівий) (решта правий)))
      (епістеміка--так епістеміка--ні))))

; Пошук доказу, що підтримує саме запитане посилання.
(визначити підтверджувальний-доказ
  (функція (доказ посилання-на-твердження)
    (за-умовою
      ((хибне? (доказ? доказ)) (як-є ()))
      ((хибне? (епістеміка--посилання-на-твердження? посилання-на-твердження)) (як-є ()))
      ((хибне? (тотожне? (доказ-підсумок доказ) (як-є supports))) (як-є ()))
      ((хибне? (епістеміка--рівні-посилання? (отримати-посилання-доказу-на-твердження доказ) посилання-на-твердження)) (як-є ()))
      (епістеміка--так доказ))))

; Перевірка кожної необхідної можливості засобами SENS.
; Тільки порожній список завершує перелік вимог успішно.
; Інший атом у хвості, зокрема (вимога . стороннє), є пошкодженою
; структурою і не може доводити виконання необхідних можливостей.
(визначити епістеміка--усі-вимоги-наявні?
  (функція (вимоги доступні-можливості)
    (за-умовою
      ((атом? вимоги) (тотожне? вимоги (як-є ())))
      ((хибне? (значення-у-списку? (перше вимоги) доступні-можливості)) епістеміка--ні)
      (епістеміка--так
       (епістеміка--усі-вимоги-наявні? (решта вимоги) доступні-можливості)))))

(визначити усі-необхідні-можливості-наміру-забезпечені?
  (функція (намір доступні-можливості)
    (за-умовою
      ((хибне? (намір? намір)) епістеміка--ні)
      (епістеміка--так
       (епістеміка--усі-вимоги-наявні? (отримати-необхідні-можливості-наміру намір) доступні-можливості)))))
