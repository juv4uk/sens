; Д11: чисті композиції з Кложур редустіонс та Схем СРФІ-1 паір-фолд.
; Нормативні історичні джерела:
; гттпс: і  і кложур.гітгуб.іо і кложур і брансг-мастер і кложур.соре-апі.гтмл
; гттпс: і  і срфі.ссгемерс.орг і срфі-1 і срфі-1.гтмл
; СЕНС: тільки правильні скінченні списки, Д1 і Д3 і Д5 замикання.
; Не нові код операції, не Д24-арифметика і не пітон і джейсон виконавець.
; Тільки D3:000 завершує правильний список; будь-який інший атом
; у корені чи хвості мусить дати Type через D3 ПЕРШЕ, не тихий успіх.
;
; Кложур редустіонс (ф ініт солл): початковий стан завжди перший
; елемент результату, після кожного входу - рівно один новий стан.
; Тут еагер пропер-ліст, НЕ лазу сек чи трансдусер.
;; D11: один доказ ВСЬОГО D3-списку перед першим користувацьким кроком.
;; D3:000 () єдиний законний кінець; D1:ні чи атом D7 — CAR Type.
;; Жоден елемент не копіюється, перевірений корінь повертаємо без змін.
(визначити підтвердити-список-для-історичного-згортання
  (функція (поточний початковий)
    (за-умовою
      ; D3:000 — точний кінець, а не результат EQ над атомами.
      ; Інший атом, зокрема D1:ні, відхиляємо D3 CAR Type.
      ((порожній? поточний) початковий)
      ((атом? поточний) (перше поточний))
      (так
       (підтвердити-список-для-історичного-згортання
         (решта поточний) початковий)))))

;; Після одного D3-доказу ядра більше не перевіряють хвости.
;; Кожен крок отримує саме попередній стан та наступний елемент.
(визначити накопичити-проміжні-стани-ядро
  (функція (крок початковий елементи)
    (сполучити
      початковий
      (за-умовою
        ((порожній? елементи) (як-є ()))
        (так
         (накопичити-проміжні-стани-ядро
           крок
           (крок початковий (перше елементи))
           (решта елементи)))))))

(визначити накопичити-проміжні-стани
  (функція (крок початковий елементи)
    (накопичити-проміжні-стани-ядро
      крок початковий
      (підтвердити-список-для-історичного-згортання
        елементи елементи))))

;; SRFI-1 pair-fold: крок отримує вихідний D3-суфікс.
;; Структура вже підтверджена, тому додаткового обходу немає.
(визначити згорнути-по-хвостах-зліва-ядро
  (функція (крок початковий елементи)
    (за-умовою
      ((порожній? елементи) початковий)
      (так
       (згорнути-по-хвостах-зліва-ядро
         крок
         (крок елементи початковий)
         (решта елементи))))))

(визначити згорнути-по-хвостах-зліва
  (функція (крок початковий елементи)
    (згорнути-по-хвостах-зліва-ядро
      крок початковий
      (підтвердити-список-для-історичного-згортання
        елементи елементи))))

;; Праве згортання передає кроку поточну пару та готовий правий стан.
(визначити згорнути-по-хвостах-справа-ядро
  (функція (крок початковий елементи)
    (за-умовою
      ((порожній? елементи) початковий)
      (так
       (крок
         елементи
         (згорнути-по-хвостах-справа-ядро
           крок початковий (решта елементи)))))))

(визначити згорнути-по-хвостах-справа
  (функція (крок початковий елементи)
    (згорнути-по-хвостах-справа-ядро
      крок початковий
      (підтвердити-список-для-історичного-згортання
        елементи елементи))))
