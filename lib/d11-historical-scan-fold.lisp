; D11: чисті композиції з Clojure reductions та Scheme SRFI-1 pair-fold.
; Нормативні історичні джерела:
; https://clojure.github.io/clojure/branch-master/clojure.core-api.html
; https://srfi.schemers.org/srfi-1/srfi-1.html
; SENS: тільки правильні скінченні списки, D1/D3/D5 замикання.
; Не нові opcode, не D24-арифметика і не Python/JSON виконавець.
;
; Clojure reductions (f init coll): початковий стан завжди перший
; елемент результату, після кожного входу — рівно один новий стан.
; Тут eager proper-list, НЕ lazy seq чи transducer.
(визначити накопичити-проміжні-стани
  (функція (крок початковий елементи)
    (сполучити
      початковий
      (за-умовою
        ((атом? елементи) (як-є ()))
        ((атом? (як-є ()))
         (накопичити-проміжні-стани
           крок
           (крок початковий (перше елементи))
           (решта елементи)))))))

; SRFI-1 pair-fold: на кроці передається сама поточна пара/суфікс,
; не її CAR; конструювання не змінює жодного вихідного вузла.
; Спочатку збережено наступний хвіст, далі виклик кроку.
(визначити згорнути-по-хвостах-зліва
  (функція (крок початковий елементи)
    (за-умовою
      ((атом? елементи) початковий)
      ((атом? (як-є ()))
       (згорнути-по-хвостах-зліва
         крок
         (крок елементи початковий)
         (решта елементи))))))

; SRFI-1 pair-fold-right: передає в крок увесь поточний суфікс,
; а стан уже згорнутого правого хвоста — другим аргументом.
(визначити згорнути-по-хвостах-справа
  (функція (крок початковий елементи)
    (за-умовою
      ((атом? елементи) початковий)
      ((атом? (як-є ()))
       (крок
         елементи
         (згорнути-по-хвостах-справа
           крок початковий (решта елементи)))))))
