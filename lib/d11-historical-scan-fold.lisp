; Д11: чисті композиції з Кложур редустіонс та Схем СРФІ-1 паір-фолд.
; Нормативні історичні джерела:
; гттпс: і  і кложур.гітгуб.іо і кложур і брансг-мастер і кложур.соре-апі.гтмл
; гттпс: і  і срфі.ссгемерс.орг і срфі-1 і срфі-1.гтмл
; СЕНС: тільки правильні скінченні списки, Д1 і Д3 і Д5 замикання.
; Не нові код операції, не Д24-арифметика і не пітон і джейсон виконавець.
;
; Кложур редустіонс (ф ініт солл): початковий стан завжди перший
; елемент результату, після кожного входу - рівно один новий стан.
; Тут еагер пропер-ліст, НЕ лазу сек чи трансдусер.
(визначити накопичити-проміжні-стани
  (функція (крок початковий елементи)
    (сполучити
      початковий
      (за-умовою
        ((атом? елементи) (як-є ()))
        ((атом? (як-є ()))
         (накопичити-проміжні-стани
           крок
           (крок початковий (перше елементи))
           (решта елементи)))))))

; СРФІ-1 паір-фолд: на кроці передається сама поточна пара і суфікс,
; не її перше; конструювання не змінює жодного вихідного вузла.
; Спочатку збережено наступний хвіст, далі виклик кроку.
(визначити згорнути-по-хвостах-зліва
  (функція (крок початковий елементи)
    (за-умовою
      ((атом? елементи) початковий)
      ((атом? (як-є ()))
       (згорнути-по-хвостах-зліва
         крок
         (крок елементи початковий)
         (решта елементи))))))

; СРФІ-1 паір-фолд-ріггт: передає в крок увесь поточний суфікс,
; а стан уже згорнутого правого хвоста - другим аргументом.
(визначити згорнути-по-хвостах-справа
  (функція (крок початковий елементи)
    (за-умовою
      ((атом? елементи) початковий)
      ((атом? (як-є ()))
       (крок
         елементи
         (згорнути-по-хвостах-справа
           крок початковий (решта елементи)))))))
