; Останній елемент довільного правильного скінченного списку.
; Для порожнього списку результат - (); для непорожнього - останнє значення.
; Закон Д3: останнє((х))=х; останнє((х у ...))=останнє((у ...)).
; Не копіюємо жодної пари: хвостова рекурсія тільки через решта.
; Доменні операції виконуються СЕНС; Зіг і Т5М лише переносять слова.
(визначити останній-елемент-списку
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((порожній? (решта елементи)) (перше елементи))
      (так (останній-елемент-списку (решта елементи))))))

; Незалежні позитивні й негативні перевірки виконує реальний СЕНС.
; Складений останній елемент повертається цілком, без сплощення.
(за-умовою
  ((порожній? (останній-елемент-списку (як-є ()))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (останній-елемент-списку (список (як-є атом?)))
              (як-є атом?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (останній-елемент-списку
               (список (як-є атом?) (як-є решта)))
              (як-є решта)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (останній-елемент-списку
               (список (як-є атом?) (як-є решта)
                       (як-є сполучити) (як-є тотожне?)))
              (як-є тотожне?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне? (тотожне? (останній-елемент-списку
                      (список (як-є атом?) (як-є решта)))
                    (як-є атом?))) так)
  (так (перше (як-є ()))))

(визначити складений-останній
  (останній-елемент-списку
    (список (як-є атом?) (як-є сполучити)
            (список (як-є решта) (як-є тотожне?)))))
(за-умовою
  ((хибне? (атом? складений-останній)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше складений-останній) (як-є решта)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (друге складений-останній) (як-є тотожне?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (решта (решта складений-останній))) так)
  (так (перше (як-є ()))))

; Непорожній власний список з чотирьох елементів та негативний
; свідок перевірені вище. Останнє значення - точна істина Д1.
(атом? (як-є ()))
