; Найдовший спільний суфікс двох скінченних правильних списків атомів.
; Закон: С(х,у) є найбільшим спільним кінцевим фрагментом х та у.
; С((),у)=С(х,())=(); С(х,х)=х; порядок атомів зберігається.
; Обернення з акумулятором дає спільний префікс дає обернення.
; Семантика тільки Д3 і Д4 і Д5 СЕНС; Д7 є проєкцією; Зіг лише пакує Т5М.

(визначити обернути-для-суфікса
  (функція (елементи накопичене)
    (за-умовою
      ((атом? елементи) накопичене)
      ((атом? (як-є ()))
       (обернути-для-суфікса (решта елементи)
         (сполучити (перше елементи) накопичене))))))

(визначити спільний-префікс-для-суфікса
  (функція (лівий правий)
    (за-умовою
      ((атом? лівий) (як-є ()))
      ((атом? правий) (як-є ()))
      ((тотожне? (перше лівий) (перше правий))
       (сполучити (перше лівий)
         (спільний-префікс-для-суфікса (решта лівий) (решта правий))))
      ((атом? (як-є ())) (як-є ())))))

(визначити спільний-суфікс-атомів
  (функція (лівий правий)
    (обернути-для-суфікса
      (спільний-префікс-для-суфікса
        (обернути-для-суфікса лівий (як-є ()))
        (обернути-для-суфікса правий (як-є ())))
      (як-є ()))))

(визначити суфікс-ліве
  (список (як-є атом?) (як-є решта) (як-є тотожне?) (як-є сполучити)))
(визначити суфікс-праве
  (список (як-є як-є) (як-є тотожне?) (як-є сполучити)))
(визначити суфікс-збіг
  (спільний-суфікс-атомів суфікс-ліве суфікс-праве))
(визначити суфікс-повний
  (спільний-суфікс-атомів
    (список (як-є атом?) (як-є решта) (як-є сполучити))
    (список (як-є атом?) (як-є решта) (як-є сполучити))))
(визначити суфікс-різний
  (спільний-суфікс-атомів
    (список (як-є атом?) (як-є решта))
    (список (як-є як-є) (як-є сполучити))))
(визначити суфікс-повтори
  (спільний-суфікс-атомів
    (список (як-є атом?) (як-є решта) (як-є решта))
    (список (як-є сполучити) (як-є решта) (як-є решта))))
(визначити суфікс-один
  (спільний-суфікс-атомів
    (список (як-є атом?))
    (список (як-є сполучити) (як-є атом?))))
(визначити суфікс-порожній-ліворуч
  (спільний-суфікс-атомів (як-є ()) суфікс-праве))
(визначити суфікс-порожній-праворуч
  (спільний-суфікс-атомів суфікс-ліве (як-є ())))
(визначити суфікс-обидва-порожні
  (спільний-суфікс-атомів (як-є ()) (як-є ())))

