; СЕНС: доведення цілей, структурна уніфікація й пояснення походження.
; Виконувані функції мають українські назви, ядро спирається на домени від третього до десятого.
; Історичні англомовні дублікати та обхідні застарілі коди тут не використовуються.
; Незмінний індекс — лише прискорення; за непевного предиката виконуємо
; вихідний послідовний перегляд усіх правил у тому самому порядку.
; Відсутність доказу не перетворюється на доказ заперечення.
;
; Залежності: основне ядро та мовна бібліотека уніфікації.
; кон'юнкції визначені там, тому тут не перевизначаються.
;
; Локальне обернення правильного списку самою SENS.
; D5:10100 має ім'я «зворот», але value-call ще не допущено машиною.
; У міркуванні порядок доказів не повинен залежати від такого обходу.
; Точні D24+ корені: колишня LENGTH-ініціалізація помилково давала один і два.
(визначити довідка-число-нуль число-нуль)
(визначити довідка-число-один число-один)

(визначити міркування-зворот-накопичувач
  (функція (залишок накопичено)
    (за-умовою
      ((порожній? залишок) накопичено)
      ; D1/D7-атомний хвіст не є кінцем D3-списку.
      ((атом? залишок) (перше залишок))
      (так
       (міркування-зворот-накопичувач
         (решта залишок)
         (сполучити (перше залишок) накопичено))))))

(визначити міркування-зворот
  (функція (елементи)
    (міркування-зворот-накопичувач елементи (як-є ()))))

(визначити схема-індексу-міркування (як-є reason-index-1))
; 64 структурні комірки-бюджети, без числової арифметики.
; Один НОВИЙ предикат споживає одну комірку, повторний — жодної.
; Це звичайні цитовані дані (64 порожні списки), не 64 функції.
(визначити паливо-індексу-міркування
  (як-є
    (() () () () () () () () () () () () () () () ()
     () () () () () () () () () () () () () () () ()
     () () () () () () () () () () () () () () () ()
     () () () () () () () () () () () () () () () ())))

; Форма запису індексу: схема, режим, початкові правила, кошики.
; Кошик містить предикат і впорядковані правила.
; Селектори третього, четвертого і п'ятого доменів уже ратифіковано.
; Індекс зберігає оригінальні правила та кошики без зміни порядку.
; Селектор четвертого елемента шостого домену не викликається без доказу.
(визначити режим-індексу-міркування
  (функція (індекс-правил)
    (друге індекс-правил)))
(визначити правила-індексу-міркування
  (функція (індекс-правил)
    (третє індекс-правил)))
(визначити кошики-індексу-міркування
  (функція (індекс-правил)
    (третє (решта індекс-правил))))

; Точний D1-вердикт: D7 схема reason-index-1 може бути складеною.
; D3 АТОМ? дозволений тільки для перевірки контейнера, не мітки D7.
; Після непорожнього D3 CONS зіставлення робить чинний D8 ОДНАКОВІ?.
(визначити індекс-міркування?
  (функція (вхідне-значення)
    (за-умовою
      ; Схема D7 сама по собі ще не є повним індексом.
      ((порожній? вхідне-значення) ні)
      ((атом? вхідне-значення) ні)
      ((хибне? (однакові?
                 (перше вхідне-значення)
                 схема-індексу-міркування))
       ні)
      ; Чотири обов'язкові поля D3: схема, режим, правила, кошики.
      ((атом? (решта вхідне-значення)) ні)
      ((атом? (решта (решта вхідне-значення))) ні)
      ((атом? (решта (решта (решта вхідне-значення)))) ні)
      ; Після четвертого поля допускається лише D3:().
      (так
       (порожній?
         (решта (решта (решта (решта вхідне-значення)))))))))
(визначити міркування-підтвердити-кошики
  (функція (залишок початкове)
    (за-умовою
      ; Структурне D3:() завершує список; його не передаємо як другий аргумент EQ.
      ((порожній? залишок) початкове)
      ; Некоректний атомарний хвіст зберігає Type-поведінку, а не дає успіх.
      ((атом? залишок) (перше залишок))
      (так
       (міркування-підтвердити-кошики
         (решта залишок) початкове)))))

; Лінійне ядро зберігає перший збіг і структурну D8 рівність D7.
(визначити міркування-пошук-кошика-ядро
  (функція (предикат кошики)
    (за-умовою
      ((порожній? кошики) (як-є ()))
      ((атом? кошики) (перше кошики))
      ((атом? (перше кошики))
       (міркування-пошук-кошика-ядро предикат (решта кошики)))
      ((однакові? предикат (перше-першого кошики)) (перше кошики))
      (так (міркування-пошук-кошика-ядро предикат (решта кошики))))))

(визначити міркування-пошук-кошика
  (функція (предикат кошики)
    (міркування-пошук-кошика-ядро
      предикат
      (міркування-підтвердити-кошики кошики кошики))))

(визначити лінійний-індекс-міркування
  (функція (правила)
    (список схема-індексу-міркування (як-є linear) правила (як-є ()))))

; Логічну змінну не можна безпечно обмежити одним кошиком.
; Єдиний чинний SENS-закон D7 «мфк» уже визначений у lib/unify.lisp:
; він перевіряє точну форму, а не атомність структурної D7-голови.
(визначити міркування-змінний-терм?
  (функція (терм)
    (змінна? терм)))

; Невідомі/складені голови залишаються на лінійному шляху.
(визначити предикат-терма-міркування
  (функція (терм)
    (за-умовою
      ((атом? терм) (як-є ()))
      ((міркування-змінний-терм? терм) (як-є ()))
      ((атом? (перше терм)) (перше терм))
      (так (як-є ())))))

(визначити предикат-правила-міркування
  (функція (поточне-правило)
    (за-умовою
      
      ((атом? поточне-правило)  (як-є ()))
      (так (предикат-терма-міркування (перше поточне-правило))))))

; Кошики спочатку накопичуються у зворотному порядку.
; Скінченний структурний бюджет обмежує кількість різних предикатів.
(визначити додати-правило-до-оберненого-індексу
  (функція (предикат поточне-правило кошики)
    (за-умовою
      
      ((порожній? кошики) (список (список предикат поточне-правило)))
      ; Новий кошик дозволено додати тільки після D3:().
      ((атом? кошики) (перше кошики))
      ((однакові? предикат (перше-першого кошики))
       (сполучити
         (сполучити предикат (сполучити поточне-правило (решта-першого кошики)))
         (решта кошики)))
      (так
       (сполучити
         (перше кошики)
         (додати-правило-до-оберненого-індексу предикат поточне-правило (решта кошики)))))))

(визначити упорядкувати-кошики-індексу-міркування
  (функція (кошики)
    (за-умовою
      
      ((порожній? кошики) (як-є ()))
      ; Некоректний хвіст не закінчує сортування.
      ((атом? кошики) (перше кошики))
      (так
       (сполучити
         (сполучити (перше-першого кошики) (міркування-зворот (решта-першого кошики)))
         (упорядкувати-кошики-індексу-міркування (решта кошики)))))))

(визначити сканувати-індекс-міркування
  (функція (залишок початкове кошики паливо)
    (за-умовою
      
      ((порожній? залишок) (список
         схема-індексу-міркування
         (як-є indexed)
         початкове
         (упорядкувати-кошики-індексу-міркування кошики)))
      ; Список правил із D1-хвостом некоректний.
      ((атом? залишок) (перше залишок))
      (так
       ((функція (предикат)
         (за-умовою
           ; Навіть одна голова поза індексом вимагає повного історичного
           ; пошуку, бо вона може уніфікуватися поза вибраним кошиком.
           ((порожній? предикат) (лінійний-індекс-міркування початкове))
           (так
            ((функція (запис)
              (за-умовою
                
                ; Новий ключ за вичерпаного бюджету використовує послідовний обхід.
                ((атом? запис)
                 (за-умовою
                   ((атом? паливо) (лінійний-індекс-міркування початкове))
                   (так
                    (сканувати-індекс-міркування
                      (решта залишок)
                      початкове
                      (додати-правило-до-оберненого-індексу
                        предикат (перше залишок) кошики)
                      (решта паливо)))))
                ; Повторений ключ не займає жодного нового біта бюджету.
                (так
                 (сканувати-індекс-міркування
                   (решта залишок)
                   початкове
                   (додати-правило-до-оберненого-індексу
                     предикат (перше залишок) кошики)
                   паливо))))
        (міркування-пошук-кошика предикат кошики)))))
        (предикат-правила-міркування (перше залишок)))))))

(визначити побудувати-індекс-міркування
  (функція (правила)
    (сканувати-індекс-міркування правила правила (як-є ()) паливо-індексу-міркування)))

(визначити забезпечити-індекс-міркування
  (функція (правила-або-індекс)
    (за-умовою
      ((індекс-міркування? правила-або-індекс) правила-або-індекс)
      (так (побудувати-індекс-міркування правила-або-індекс)))))

; За безпечного індексу придатні тільки правила того самого предиката.
; У кошику повністю зберігається порядок початкових правил.
; Небезпечна мета або вимкнений індекс повертають повний список.
(визначити кандидати-індексу-міркування
  (функція (ціль правила-або-індекс)
    ((функція (індекс-правил)
      (за-умовою
        ((однакові? (режим-індексу-міркування індекс-правил) (як-є linear))
         (правила-індексу-міркування індекс-правил))
        (так
         ((функція (предикат)
           (за-умовою
             ((порожній? предикат) (правила-індексу-міркування індекс-правил))
             (так
              ((функція (запис)
                (за-умовою
                  
                  ((атом? запис)  (як-є ()))
                  (так (решта запис))))
        (міркування-пошук-кошика предикат (кошики-індексу-міркування індекс-правил))))))
        (предикат-терма-міркування ціль)))))
        (забезпечити-індекс-міркування правила-або-індекс))))

; Окремий структурний лічильник перейменування: початкова цитована
; Глибина подається структурно, а не прихованою машинною арифметикою.
; Дані про глибину не є однобітною відповіддю.
; Публічна функція приймає звичайні правила або готовий індекс.
; Повторні запити можуть перевикористовувати незмінний індекс.
; Побудова індексу для кожної вкладеної мети не потрібна.
; Прихованого кешу чи автоматичного скидання немає.
; Індекс завжди описує саме той список правил, з якого його створено.
(визначити міркувати
  (функція (ціль правила-або-індекс)
    ((функція (індекс-правил)
      (довести-ціль
        ціль
        (кандидати-індексу-міркування ціль індекс-правил)
        (як-є ())
        індекс-правил
        (як-є (()))))
        (забезпечити-індекс-міркування правила-або-індекс))))

; Додаємо результати одного правила до зворотного накопичувача.
; Послідовний обхід зліва направо з побудовою пар
; зберігає накопичені результати у зворотному порядку.
(визначити накопичити-результати-доведення
  (функція (результати накопичувач)
    (за-умовою
      
      ((порожній? результати) накопичувач)
      ; Тільки D3:() завершує накопичення.
      ((атом? результати) (перше результати))
      (так (накопичити-результати-доведення
           (решта результати)
           (сполучити (перше результати) накопичувач))))))

; Хвостова рекурсія переглядає правила або готовий індекс.
; Форма входу нормалізується рівно один раз.
; Вкладені цілі повторно використовують той самий індекс.
(визначити довести-ціль
  (функція (ціль правила привязки повні-правила рівень-глибини)
    (сканувати-правила-доведення
      ціль
      правила
      привязки
      (забезпечити-індекс-міркування повні-правила)
      рівень-глибини
      (як-є ()))))

(визначити сканувати-правила-доведення
  (функція (ціль правила привязки повні-правила рівень-глибини накопичувач)
    (за-умовою
      
      ((порожній? правила) (міркування-зворот накопичувач))
      ; Не втрачати пошкоджені D1-хвости правил.
      ((атом? правила) (перше правила))
      (так
       ((функція (результати-правила)
         (сканувати-правила-доведення
           ціль
           (решта правила)
           привязки
           повні-правила
           рівень-глибини
           (накопичити-результати-доведення результати-правила накопичувач)))
        (застосувати-правило-для-доведення-мети ціль (перше правила) привязки повні-правила рівень-глибини))))))

; Рекурсивно перейменовуємо змінні терма з урахуванням глибини.
(визначити розрізнити-логічні-змінні-правила-на-глибині
  (функція (терм рівень-глибини)
    (за-умовою
      ((атом? терм) терм)
      ((міркування-змінний-терм? терм)
       (список (як-є var) (сполучити (друге терм) рівень-глибини)))
      (так (сполучити (розрізнити-логічні-змінні-правила-на-глибині (перше терм) рівень-глибини)
                   (розрізнити-логічні-змінні-правила-на-глибині (решта терм) рівень-глибини))))))

; Вищий порядок використовує лексичне замикання, не D5:00001 FUNCTION.
; Ім'я параметра не повинно збігатися з ратифікованою D5-ідентичністю.
(визначити зіставити-докази
  (функція (перетворювач-доказу список-даних)
    (за-умовою
      ((порожній? список-даних) (як-є ()))
      ; Некоректний атомний хвіст не є завершенням зіставлення.
      ((атом? список-даних) (перше список-даних))
      (так
       (сполучити
         (перетворювач-доказу (перше список-даних))
         (зіставити-докази перетворювач-доказу (решта список-даних)))))))

; Ратифікована українська голова належить десятому домену.
; Після спроби застосувати правило кожне успішне виведення
(визначити застосувати-правило-для-доведення-мети
  (функція (мета правило підстановки усі-правила глибина)
    ((функція (перейменоване-правило)
      ((функція (нова-підстановка)
        (за-умовою
          ((підстановка-позначає-невдачу? нова-підстановка) (як-є ()))
          (так
           ((функція (результати-тіла)
             (зіставити-докази
               (функція (результат)
                 (список
                   (перше результат)
                   (список
                     (як-є proved)
                     мета
                     (перше перейменоване-правило)
                     (друге результат))))
               результати-тіла))
        (довести-цілі
                     (решта перейменоване-правило)
                     нова-підстановка
                     усі-правила
                     (сполучити (як-є ()) глибина))))))
        (уніфікувати мета (перше перейменоване-правило) підстановки)))
        (розрізнити-логічні-змінні-правила-на-глибині правило глибина))))

; Кон'юнкцію доводимо зі збереженням підстановки та доказів.
; Обхід використовує спільну бібліотеку уніфікації.

(визначити довести-цілі
  (функція (цілі привязки повні-правила рівень-глибини)
    (потік-виконання-кон'юнкція
      цілі
      (список привязки (як-є ()))
      (функція (ціль стан)
        (довести-мету-зі-збереженням-підстановок-та-доказів ціль стан повні-правила рівень-глибини)))))

; Заперечена мета також залишається звичайною метою міркування.
; Відсутність доказу не означає доказ заперечення.
; Тільки явне негативне свідчення може встановити заперечення.
; Правило або факт із заперечною головою дає таке свідчення.
(визначити довести-мету-зі-збереженням-підстановок-та-доказів
  (функція (ціль стан повні-правила рівень-глибини)
    ((функція (привязки доведення індекс-правил)
      (приєднати-докази-до-кожної-успішної-підстановки
        (довести-ціль
          ціль
          (кандидати-індексу-міркування ціль індекс-правил)
          привязки
          індекс-правил
          рівень-глибини)
        доведення))
        (перше стан)
        (друге стан)
        (забезпечити-індекс-міркування повні-правила))))

(визначити приєднати-докази-до-кожної-успішної-підстановки
  (функція (результати доведення)
    (за-умовою
      
      ((порожній? результати) (як-є ()))
      ; Пошкоджений хвіст не є відсутністю доказів.
      ((атом? результати) (перше результати))
      (так
       (сполучити
         (список
           (перше-першого результати)
           (приєднати доведення (список (друге (перше результати)))))
         (приєднати-докази-до-кожної-успішної-підстановки (решта результати) доведення))))))

(визначити пояснити-доказ
  (функція (доказ)
    (пояснити-вузол-доказу доказ довідка-число-нуль)))

(визначити пояснити-вузол-доказу
  (функція (вузол рівень)
    (за-умовою
      ((однакові? (перше вузол) (як-є proved))
       
         ((функція (_2)
         ((функція (_3)
         ((функція (_4)
         ((функція (_5)
         ((функція (_6)
         (пояснити-список-доказів (четверте вузол) (додати рівень довідка-число-один)))
        (друкувати (третє вузол))))
        (друкувати (як-є правилом:))))
        (друкувати (як-є за))))
        (друкувати (друге вузол))))
        (друкувати (як-є Доведено:))))
      ((однакові? (перше вузол) (як-є proved-not))
       
         ((функція (_2)
         ((функція (_3)
         ((функція (_4)
         ((функція (_5)
         ((функція (_6)
         (як-є ()))
        (друкувати (друге вузол))))
        (друкувати (як-є не))))
        (друкувати (як-є невдачу:))))
        (друкувати (як-є через))))
        (друкувати (як-є Доведено))))
      )))

(визначити пояснити-список-доказів
  (функція (вузли рівень)
    (за-умовою
      ((порожній? вузли) (як-є ()))
      ; Друк не має перетворювати зламане дерево на повний доказ.
      ((атом? вузли) (перше вузли))
      (так
       
         ((функція (_1)
         ((функція (_2)
         ((функція (_3)
         (пояснити-список-доказів (решта вузли) рівень))
        (пояснити-вузол-доказу (перше вузли) рівень)))
        (друкувати (як-є висновок))))
        (друкувати-відступ рівень))))))

(визначити друкувати-відступ
  (функція (рівень)
    (за-умовою
      ((тотожне? рівень довідка-число-нуль) (як-є ()))
      (так
       ((функція (_)
         (друкувати-відступ (відняти рівень довідка-число-один)))
        (друкувати (як-є ..)))))))

; Позначка висновку — український цитований атом Д7, без рядкового
; літерала. Пояснення є друкованою проєкцією, не семантикою доведення.
; Пояснення для людини сумісне з історичною поверхнею.
; Структуровані результати міркування надаються окремо.
(визначити міркувати-пояснити
  (функція (ціль правила)
    ((функція (результати)
      (за-умовою
        
        ((атом? результати)  
           ((функція (_1)
         ((функція (_2)
         ((функція (_3)
         (як-є ()))
        (друкувати ціль)))
        (друкувати (як-є довести:))))
        (друкувати (як-є Не-вдається))))
        (так (пояснити-доказ (друге (перше результати))))))
        (міркувати ціль правила))))

(визначити додати-використання-правила
  (функція (запис асоціативний-список)
    (за-умовою
      ((порожній? асоціативний-список) (список запис))
      ; Неправильний атомний хвіст не означає вільне місце.
      ((атом? асоціативний-список) (перше асоціативний-список))
      ((уніфікація-рівні? (перше-першого асоціативний-список) (перше запис))
       (сполучити
         (сполучити
           (перше запис)
           (додати (решта запис) (решта (перше асоціативний-список))))
         (решта асоціативний-список)))
      (так (сполучити (перше асоціативний-список) (додати-використання-правила запис (решта асоціативний-список)))))))

(визначити підсумувати-лічильники-використання-правил
  (функція (ліве праве)
    (за-умовою
      ((порожній? ліве) праве)
      ; Не губити правило через пошкоджений хвіст у лівому лічильнику.
      ((атом? ліве) (перше ліве))
      (так (підсумувати-лічильники-використання-правил (решта ліве) (додати-використання-правила (перше ліве) праве))))))

(визначити порахувати-правила-у-дереві-доказу
  (функція (вузол)
    (за-умовою
      ((однакові? (перше вузол) (як-є proved))
       (додати-використання-правила
         (сполучити (третє вузол) довідка-число-один)
         (порахувати-використання-списку (четверте вузол))))
      ; Недоведений вузол не є використанням правила.
      (так (як-є ())))))

(визначити порахувати-використання-списку
  (функція (вузли)
    (за-умовою
      ((порожній? вузли) (як-є ()))
      ; Непорожній атом не завершує перелік. D3 ПЕРШЕ дає Type.
      ((атом? вузли) (перше вузли))
      (так
       (підсумувати-лічильники-використання-правил
         (порахувати-правила-у-дереві-доказу (перше вузли))
         (порахувати-використання-списку (решта вузли)))))))

; Лише точний D3:() визначає листок як fact.
; Інші атомні хвости відхиляє ратифіковане D3 ПЕРШЕ Type.
(визначити джерело-вузла-доказу
  (функція (вузол)
    (за-умовою
      ((порожній? (четверте вузол)) (як-є fact))
      ((атом? (четверте вузол)) (перше (четверте вузол)))
      (так (як-є rule)))))

(визначити побудувати-походження-вузла
  (функція (вузол)
    (за-умовою
      ((однакові? (перше вузол) (як-є proved))
       (список
         (як-є statement)
         (друге вузол)
         (список (як-є source) (джерело-вузла-доказу вузол))
         (список (як-є rule) (третє вузол))
         (список
           (як-є derived-from)
           (походження-списку (четверте вузол)))))
      (так
       (список
         (як-є statement)
         (друге вузол)
         (список (як-є source) (як-є not-proved)))))))

(визначити походження-списку
  (функція (вузли)
    (за-умовою
      ((порожній? вузли) (як-є ()))
      ; Не перетворювати зіпсований D1/D7 хвіст на відсутність доказу.
      ((атом? вузли) (перше вузли))
      (так
       (сполучити
         (побудувати-походження-вузла (перше вузли))
         (походження-списку (решта вузли)))))))
