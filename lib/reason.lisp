; СЕНС: доведення цілей, структурна уніфікація й пояснення походження.
; Виконувані функції мають українські назви, ядро спирається на домени від третього до десятого.
; Історичні англомовні дублікати та обхідні застарілі коди тут не використовуються.
; Незмінний індекс — лише прискорення; за непевного предиката виконуємо
; вихідний послідовний перегляд усіх правил у тому самому порядку.
; Відсутність доказу не перетворюється на доказ заперечення.
;
; Залежності: основне ядро та мовна бібліотека уніфікації.
; кон'юнкції визначені там, тому тут не перевизначаються.
;
; Локальне обернення правильного списку самою SENS.
; D5:10100 має ім'я «зворот», але value-call ще не допущено машиною.
; У міркуванні порядок доказів не повинен залежати від такого обходу.
(визначити міркування-зворот-накопичувач
  (функція (залишок накопичено)
    (за-умовою
      ((атом? залишок) накопичено)
      ((атом? (як-є ()))
       (міркування-зворот-накопичувач
         (решта залишок)
         (сполучити (перше залишок) накопичено))))))

(визначити міркування-зворот
  (функція (елементи)
    (міркування-зворот-накопичувач елементи (як-є ()))))

(визначити схема-індексу-міркування (як-є reason-index-1))
; 64 структурні комірки-бюджети, без числової арифметики.
; Один НОВИЙ предикат споживає одну комірку, повторний — жодної.
; Це звичайні цитовані дані (64 порожні списки), не 64 функції.
(визначити паливо-індексу-міркування
  (як-є
    (() () () () () () () () () () () () () () () ()
     () () () () () () () () () () () () () () () ()
     () () () () () () () () () () () () () () () ()
     () () () () () () () () () () () () () () () ())))

; Форма запису індексу: схема, режим, початкові правила, кошики.
; Кошик містить предикат і впорядковані правила.
; Селектори третього, четвертого і п'ятого доменів уже ратифіковано.
; Індекс зберігає оригінальні правила та кошики без зміни порядку.
; Селектор четвертого елемента шостого домену не викликається без доказу.
(визначити режим-індексу-міркування
  (функція (індекс-правил)
    (друге індекс-правил)))
(визначити правила-індексу-міркування
  (функція (індекс-правил)
    (третє індекс-правил)))
(визначити кошики-індексу-міркування
  (функція (індекс-правил)
    (третє (решта індекс-правил))))

; Повертаємо точну відповідь першого домену без обхідної перевірки.
; Порівнюємо схему тільки після перевірки атомарності.
(визначити індекс-міркування?
  (функція (вхідне-значення)
    (за-умовою
      ((атом? вхідне-значення) ні)
      ((порожній? вхідне-значення) ні)
      ; Звичайне правило може починатися складеною головою.
      ; Порівняння атомів допустиме лише після перевірки голови.
      ((атом? (перше вхідне-значення))
       (за-умовою
         ((тотожне? (перше вхідне-значення) схема-індексу-міркування) так)
         (так ні)))
      (так ні))))

; Кошик шукаємо власним точним обходом третього домену.
; До вибірки зі складеної структури перевіряємо її непорожність.
; Голова кошика має бути атомарною; зіпсований кошик не приховує
; наступні правильні записи. Відсутність збігу не вигадує правила.
; Вкладені селектори беруться з ратифікованого четвертого домену.
; Вибір першого з першого та решти першого має точні координати.
; Це виконувані селектори; символи клавіатури є лише даними.

(визначити міркування-пошук-кошика
  (функція (предикат кошики)
    (за-умовою
      ((атом? кошики) (як-є ()))
      ((атом? (перше кошики))
       (міркування-пошук-кошика предикат (решта кошики)))
      ((атом? (перше-першого кошики))
       (за-умовою
         ((тотожне? предикат (перше-першого кошики)) (перше кошики))
         ((атом? (як-є ())) (міркування-пошук-кошика предикат (решта кошики)))))
      ((атом? (як-є ())) (міркування-пошук-кошика предикат (решта кошики))))))

(визначити лінійний-індекс-міркування
  (функція (правила)
    (список схема-індексу-міркування (як-є linear) правила (як-є ()))))

; Для ключів індексу годяться тільки складені терми з атомарною головою.
; Логічна змінна не може бути безпечно обмежена одним кошиком.
; Для змінної зберігаємо повний послідовний перегляд правил.
; Предикат логічної змінної належить мовній бібліотеці.
; Перед порівнянням голови з атомом перевіряємо обидві форми.
(визначити міркування-змінний-терм?
  (функція (терм)
    (за-умовою
      ((атом? терм) (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (перше терм))
       (за-умовою
         ((тотожне? (перше терм) (як-є var)) (атом? (як-є ())))
         ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
      ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ())))))))

; Невідомі/складені голови залишаються на лінійному шляху.
(визначити предикат-терма-міркування
  (функція (терм)
    (за-умовою
      ((атом? терм) (як-є ()))
      ((міркування-змінний-терм? терм) (як-є ()))
      ((атом? (перше терм)) (перше терм))
      ((атом? (як-є ())) (як-є ())))))

(визначити предикат-правила-міркування
  (функція (поточне-правило)
    (за-умовою
      
      ((атом? поточне-правило)  (як-є ()))
      ((атом? (як-є ())) (предикат-терма-міркування (перше поточне-правило))))))

; Кошики спочатку накопичуються у зворотному порядку.
; Скінченний структурний бюджет обмежує кількість різних предикатів.
(визначити додати-правило-до-оберненого-індексу
  (функція (предикат поточне-правило кошики)
    (за-умовою
      
      ((атом? кошики)  (список (список предикат поточне-правило)))
      ((тотожне? предикат (перше-першого кошики))
       (сполучити
         (сполучити предикат (сполучити поточне-правило (решта-першого кошики)))
         (решта кошики)))
      ((атом? (як-є ()))
       (сполучити
         (перше кошики)
         (додати-правило-до-оберненого-індексу предикат поточне-правило (решта кошики)))))))

(визначити упорядкувати-кошики-індексу-міркування
  (функція (кошики)
    (за-умовою
      
      ((атом? кошики)  (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (сполучити (перше-першого кошики) (міркування-зворот (решта-першого кошики)))
         (упорядкувати-кошики-індексу-міркування (решта кошики)))))))

(визначити сканувати-індекс-міркування
  (функція (залишок початкове кошики паливо)
    (за-умовою
      
      ((атом? залишок)  (список
         схема-індексу-міркування
         (як-є indexed)
         початкове
         (упорядкувати-кошики-індексу-міркування кошики)))
      ((атом? (як-є ()))
       ((функція (предикат)
         (за-умовою
           ; Навіть одна голова поза індексом вимагає повного історичного
           ; пошуку, бо вона може уніфікуватися поза вибраним кошиком.
           ((тотожне? предикат (як-є ())) (лінійний-індекс-міркування початкове))
           ((атом? (як-є ()))
            ((функція (запис)
              (за-умовою
                
                ; Новий ключ за вичерпаного бюджету використовує послідовний обхід.
                ((атом? запис)
                 (за-умовою
                   ((атом? паливо) (лінійний-індекс-міркування початкове))
                   ((атом? (як-є ()))
                    (сканувати-індекс-міркування
                      (решта залишок)
                      початкове
                      (додати-правило-до-оберненого-індексу
                        предикат (перше залишок) кошики)
                      (решта паливо)))))
                ; Повторений ключ не займає жодного нового біта бюджету.
                ((атом? (як-є ()))
                 (сканувати-індекс-міркування
                   (решта залишок)
                   початкове
                   (додати-правило-до-оберненого-індексу
                     предикат (перше залишок) кошики)
                   паливо))))
        (міркування-пошук-кошика предикат кошики)))))
        (предикат-правила-міркування (перше залишок)))))))

(визначити побудувати-індекс-міркування
  (функція (правила)
    (сканувати-індекс-міркування правила правила (як-є ()) паливо-індексу-міркування)))

(визначити забезпечити-індекс-міркування
  (функція (правила-або-індекс)
    (за-умовою
      ((індекс-міркування? правила-або-індекс) правила-або-індекс)
      ((атом? (як-є ())) (побудувати-індекс-міркування правила-або-індекс)))))

; За безпечного індексу придатні тільки правила того самого предиката.
; У кошику повністю зберігається порядок початкових правил.
; Небезпечна мета або вимкнений індекс повертають повний список.
(визначити кандидати-індексу-міркування
  (функція (ціль правила-або-індекс)
    ((функція (індекс-правил)
      (за-умовою
        ((тотожне? (режим-індексу-міркування індекс-правил) (як-є linear))
         (правила-індексу-міркування індекс-правил))
        ((атом? (як-є ()))
         ((функція (предикат)
           (за-умовою
             ((тотожне? предикат (як-є ())) (правила-індексу-міркування індекс-правил))
             ((атом? (як-є ()))
              ((функція (запис)
                (за-умовою
                  
                  ((атом? запис)  (як-є ()))
                  ((атом? (як-є ())) (решта запис))))
        (міркування-пошук-кошика предикат (кошики-індексу-міркування індекс-правил))))))
        (предикат-терма-міркування ціль)))))
        (забезпечити-індекс-міркування правила-або-індекс))))

; Окремий структурний лічильник перейменування: початкова цитована
; Глибина подається структурно, а не прихованою машинною арифметикою.
; Дані про глибину не є однобітною відповіддю.
; Публічна функція приймає звичайні правила або готовий індекс.
; Повторні запити можуть перевикористовувати незмінний індекс.
; Побудова індексу для кожної вкладеної мети не потрібна.
; Прихованого кешу чи автоматичного скидання немає.
; Індекс завжди описує саме той список правил, з якого його створено.
(визначити міркувати
  (функція (ціль правила-або-індекс)
    ((функція (індекс-правил)
      (довести-ціль
        ціль
        (кандидати-індексу-міркування ціль індекс-правил)
        (як-є ())
        індекс-правил
        (як-є (()))))
        (забезпечити-індекс-міркування правила-або-індекс))))

; Додаємо результати одного правила до зворотного накопичувача.
; Послідовний обхід зліва направо з побудовою пар
; зберігає накопичені результати у зворотному порядку.
(визначити накопичити-результати-доведення
  (функція (результати накопичувач)
    (за-умовою
      
      ((атом? результати)  накопичувач)
      ((атом? (як-є ())) (накопичити-результати-доведення
           (решта результати)
           (сполучити (перше результати) накопичувач))))))

; Хвостова рекурсія переглядає правила або готовий індекс.
; Форма входу нормалізується рівно один раз.
; Вкладені цілі повторно використовують той самий індекс.
(визначити довести-ціль
  (функція (ціль правила привязки повні-правила рівень-глибини)
    (сканувати-правила-доведення
      ціль
      правила
      привязки
      (забезпечити-індекс-міркування повні-правила)
      рівень-глибини
      (як-є ()))))

(визначити сканувати-правила-доведення
  (функція (ціль правила привязки повні-правила рівень-глибини накопичувач)
    (за-умовою
      
      ((атом? правила)  (міркування-зворот накопичувач))
      ((атом? (як-є ()))
       ((функція (результати-правила)
         (сканувати-правила-доведення
           ціль
           (решта правила)
           привязки
           повні-правила
           рівень-глибини
           (накопичити-результати-доведення результати-правила накопичувач)))
        (застосувати-правило-для-доведення-мети ціль (перше правила) привязки повні-правила рівень-глибини))))))

; Рекурсивно перейменовуємо змінні терма з урахуванням глибини.
(визначити розрізнити-логічні-змінні-правила-на-глибині
  (функція (терм рівень-глибини)
    (за-умовою
      ((атом? терм) терм)
      ((міркування-змінний-терм? терм)
       (список (як-є var) (сполучити (друге терм) рівень-глибини)))
      ((атом? (як-є ())) (сполучити (розрізнити-логічні-змінні-правила-на-глибині (перше терм) рівень-глибини)
                   (розрізнити-логічні-змінні-правила-на-глибині (решта терм) рівень-глибини))))))

; Вищий порядок використовує лексичне замикання, не D5:00001 FUNCTION.
; Ім'я параметра не повинно збігатися з ратифікованою D5-ідентичністю.
(визначити зіставити-докази
  (функція (перетворювач-доказу список-даних)
    (за-умовою
      ((атом? список-даних) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (перетворювач-доказу (перше список-даних))
         (зіставити-докази перетворювач-доказу (решта список-даних)))))))

; Ратифікована українська голова належить десятому домену.
; Після спроби застосувати правило кожне успішне виведення
(визначити застосувати-правило-для-доведення-мети
  (функція (мета правило підстановки усі-правила глибина)
    ((функція (перейменоване-правило)
      ((функція (нова-підстановка)
        (за-умовою
          ((підстановка-позначає-невдачу? нова-підстановка) (як-є ()))
          ((атом? (як-є ()))
           ((функція (результати-тіла)
             (зіставити-докази
               (функція (результат)
                 (список
                   (перше результат)
                   (список
                     (як-є proved)
                     мета
                     (перше перейменоване-правило)
                     (друге результат))))
               результати-тіла))
        (довести-цілі
                     (решта перейменоване-правило)
                     нова-підстановка
                     усі-правила
                     (сполучити (як-є ()) глибина))))))
        (уніфікувати мета (перше перейменоване-правило) підстановки)))
        (розрізнити-логічні-змінні-правила-на-глибині правило глибина))))

; Кон'юнкцію доводимо зі збереженням підстановки та доказів.
; Обхід використовує спільну бібліотеку уніфікації.

(визначити довести-цілі
  (функція (цілі привязки повні-правила рівень-глибини)
    (потік-виконання-кон'юнкція
      цілі
      (список привязки (як-є ()))
      (функція (ціль стан)
        (довести-мету-зі-збереженням-підстановок-та-доказів ціль стан повні-правила рівень-глибини)))))

; Заперечена мета також залишається звичайною метою міркування.
; Відсутність доказу не означає доказ заперечення.
; Тільки явне негативне свідчення може встановити заперечення.
; Правило або факт із заперечною головою дає таке свідчення.
(визначити довести-мету-зі-збереженням-підстановок-та-доказів
  (функція (ціль стан повні-правила рівень-глибини)
    ((функція (привязки доведення індекс-правил)
      (приєднати-докази-до-кожної-успішної-підстановки
        (довести-ціль
          ціль
          (кандидати-індексу-міркування ціль індекс-правил)
          привязки
          індекс-правил
          рівень-глибини)
        доведення))
        (перше стан)
        (друге стан)
        (забезпечити-індекс-міркування повні-правила))))

(визначити приєднати-докази-до-кожної-успішної-підстановки
