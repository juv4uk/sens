; Позначка висновку — український цитований атом Д7, без рядкового
; літерала. Пояснення є друкованою проєкцією, не семантикою доведення.
; Пояснення для людини сумісне з історичною поверхнею.
; Структуровані результати міркування надаються окремо.
(визначити міркувати-пояснити
  (функція (ціль правила)
    ((функція (результати)
      (за-умовою
        
        ((атом? результати)  
           ((функція (_1)
         ((функція (_2)
         ((функція (_3)
         (як-є ()))
        (друкувати ціль)))
        (друкувати (як-є довести:))))
        (друкувати (як-є Не-вдається))))
        ((атом? (як-є ())) (пояснити-доказ (друге (перше результати))))))
        (міркувати ціль правила))))

(визначити додати-використання-правила
  (функція (запис асоціативний-список)
    (за-умовою
      
      ((атом? асоціативний-список)  (список запис))
      ((однакові? (перше-першого асоціативний-список) (перше запис))
       (сполучити
         (сполучити
           (перше запис)
           (додати (решта запис) (решта (перше асоціативний-список))))
         (решта асоціативний-список)))
      ((атом? (як-є ())) (сполучити (перше асоціативний-список) (додати-використання-правила запис (решта асоціативний-список)))))))

