(визначити пояснити-вузол-доказу
  (функція (вузол рівень)
    (за-умовою
      ((тотожне? (перше вузол) (як-є proved))
       
         ((функція (_2)
         ((функція (_3)
         ((функція (_4)
         ((функція (_5)
         ((функція (_6)
         (пояснити-список-доказів (четверте вузол) (додати рівень 1)))
        (друкувати (третє вузол))))
        (друкувати (як-є правилом:))))
        (друкувати (як-є за))))
        (друкувати (друге вузол))))
        (друкувати (як-є Доведено:))))
      ((тотожне? (перше вузол) (як-є proved-not))
       
         ((функція (_2)
         ((функція (_3)
         ((функція (_4)
         ((функція (_5)
         ((функція (_6)
         (як-є ()))
        (друкувати (друге вузол))))
        (друкувати (як-є не))))
        (друкувати (як-є невдачу:))))
        (друкувати (як-є через))))
        (друкувати (як-є Доведено))))
      )))

(визначити пояснити-список-доказів
