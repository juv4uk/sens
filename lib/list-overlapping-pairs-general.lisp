; СЕНС: усі сусідні перекривні пари скінченного правильного списку.
; Один обхід решта, без індексів, побічних дій та зовнішнього виконавця.
; Пара сусідів зберігає початковий порядок; кінцевий одиночний елемент
; не породжує неповної пари. Реальність засвідчує тільки СЕНС + Зіг і Т5М.
(визначити сусідні-пари
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) (як-є ()))
      (так
        (сполучити
          (список (перше елементи) (перше (решта елементи)))
          (сусідні-пари (решта елементи)))))))

(визначити вхідні-елементи
  (список (як-є атом?) (як-є решта) (як-є тотожне?) (як-є сполучити)))
(визначити правильні-пари
  (список
    (список (як-є атом?) (як-є решта))
    (список (як-є решта) (як-є тотожне?))
    (список (як-є тотожне?) (як-є сполучити))))

; Позитив: точна структура всіх трьох пар, порожній та одиночний вхід.
; Негатив: помилково обрізаний список пар мусить відрізнятись.
; Кожне відхилення спричиняє справжню помилку СЕНС, не текстовий ПАСС.
(за-умовою
  ((однакові? (сусідні-пари вхідні-елементи) правильні-пари)
    (за-умовою
      ((атом? (сусідні-пари (як-є ())))
        (за-умовою
          ((атом? (сусідні-пари (список (як-є атом?))))
            (за-умовою
              ((хибне? (однакові?
                         (сусідні-пари вхідні-елементи)
                         (список (список (як-є атом?) (як-є решта)))))
                так)
              (так (перше (як-є ())))))
          (так (перше (як-є ())))))
      (так (перше (як-є ())))))
  (так (перше (як-є ()))))
