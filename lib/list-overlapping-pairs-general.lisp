; СЕНС: усі сусідні перекривні пари скінченного правильного списку.
; Один обхід решта, без індексів, побічних дій та зовнішнього виконавця.
; Пара сусідів зберігає початковий порядок; кінцевий одиночний елемент
; не породжує неповної пари. Реальність засвідчує тільки СЕНС + Зіг і Т5М.
(визначити сусідні-пари
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) (як-є ()))
      (так
        (сполучити
          (список (перше елементи) (перше (решта елементи)))
          (сусідні-пари (решта елементи)))))))

(визначити вхідні-елементи
  (список (як-є атом?) (як-є решта) (як-є тотожне?) (як-є сполучити)))

; Перевірка кожного елемента трьох пар, точного завершення та меж.
; Використано лише допущені тотожне?, атом?, хибне?, перше, друге, решта.
; Будь-яка розбіжність призводить до живої помилки СЕНС, не текстового PASS.
(визначити обчислені-пари (сусідні-пари вхідні-елементи))
(за-умовою
  ((тотожне? (перше (перше обчислені-пари)) (як-є атом?))
   (за-умовою
  ((тотожне? (друге (перше обчислені-пари)) (як-є решта))
   (за-умовою
  ((атом? (решта (решта (перше обчислені-пари))))
   (за-умовою
  ((тотожне? (перше (друге обчислені-пари)) (як-є решта))
   (за-умовою
  ((тотожне? (друге (друге обчислені-пари)) (як-є тотожне?))
   (за-умовою
  ((атом? (решта (решта (друге обчислені-пари))))
   (за-умовою
  ((тотожне? (перше (перше (решта (решта обчислені-пари)))) (як-є тотожне?))
   (за-умовою
  ((тотожне? (друге (перше (решта (решта обчислені-пари)))) (як-є сполучити))
   (за-умовою
  ((атом? (решта (решта (перше (решта (решта обчислені-пари))))))
   (за-умовою
  ((атом? (решта (решта (решта обчислені-пари))))
   (за-умовою
  ((атом? (сусідні-пари (як-є ())))
   (за-умовою
  ((атом? (сусідні-пари (список (як-є атом?))))
   (за-умовою
  ((хибне? (тотожне? (перше (друге обчислені-пари)) (як-є атом?)))
   так)
  (так (перше (як-є ())))))
  (так (перше (як-є ())))))
  (так (перше (як-є ())))))
  (так (перше (як-є ())))))
  (так (перше (як-є ())))))
  (так (перше (як-є ())))))
  (так (перше (як-є ())))))
  (так (перше (як-є ())))))
  (так (перше (як-є ())))))
  (так (перше (як-є ())))))
  (так (перше (як-є ())))))
  (так (перше (як-є ())))))
  (так (перше (як-є ()))))
