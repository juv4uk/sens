; СЕНС: перекривні сусідні пари; один хвостовий крок на кожне ребро.
; Пам'ять лише для вихідних пар, без індексу та подвійного проходу.
; Порожні й одноелементні входи не створюють жодної пари.
; Мовний свідок перевіряє шість координат, три точні довжини,
; завершення та дві межі; помилка кидається самим СЕНС.
(визначити сусідні-пари
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) (як-є ()))
      (так
        (сполучити
          (список (перше елементи) (перше (решта елементи)))
          (сусідні-пари (решта елементи)))))))

(визначити проба
  (сусідні-пари
    (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є перше))))

(за-умовою
    ((тотожне? (перше (перше проба)) (як-є атом?)) (за-умовою
    ((тотожне? (друге (перше проба)) (як-є решта)) (за-умовою
    ((тотожне? (перше (друге проба)) (як-є решта)) (за-умовою
    ((тотожне? (друге (друге проба)) (як-є сполучити)) (за-умовою
    ((тотожне? (перше (перше (решта (решта проба)))) (як-є сполучити)) (за-умовою
    ((тотожне? (друге (перше (решта (решта проба)))) (як-є перше)) (за-умовою
    ((порожній? (решта (решта (перше проба)))) (за-умовою
    ((порожній? (решта (решта (друге проба)))) (за-умовою
    ((порожній? (решта (решта (перше (решта (решта проба)))))) (за-умовою
    ((порожній? (решта (решта (решта проба)))) (за-умовою
    ((порожній? (сусідні-пари (як-є ()))) (за-умовою
    ((порожній? (сусідні-пари (список (як-є атом?)))) (за-умовою
    ((хибне? (тотожне? (перше (друге проба)) (як-є атом?))) так)
