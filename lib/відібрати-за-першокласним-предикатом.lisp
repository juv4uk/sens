; СЕНС: FILTER без хостового обчислювача й без SID8/Sens8.
; Предикат — справжнє першокласне викличне значення ратифікованого домену.
; Для правильного скінченного списку з n елементів і k збігів:
; O(n) викликів предиката, рівно k нових CONS-пар; порядок незмінний.
; Не створюємо зайвого проміжного списку. Д7 тут нічого не кодує.

(визначити відібрати-за-першокласним-предикатом
 (функція (умова елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((умова (перше елементи))
    (сполучити
     (перше елементи)
     (відібрати-за-першокласним-предикатом
      умова (решта елементи))))
   (так
    (відібрати-за-першокласним-предикатом
     умова (решта елементи))))))

; Порожній список завжди має нуль результатів.
(за-умовою
 ((порожній?
   (відібрати-за-першокласним-предикатом атом? (як-є ()))) так)
 (так (перше (як-є ()))))

; Д3 АТОМ? як перший клас: складена пара відкидається,
; порожній атом зберігається поруч із двома непорожніми атомами.
(визначити відібрані-атомні-елементи
 (відібрати-за-першокласним-предикатом
  атом?
  (список (як-є атом?)
          (список (як-є решта))
          (як-є ())
          (як-є сполучити))))

(за-умовою
 ((тотожне? (перше відібрані-атомні-елементи) (як-є атом?)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (друге відібрані-атомні-елементи)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (третє відібрані-атомні-елементи) (як-є сполучити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній?
   (решта (решта (решта відібрані-атомні-елементи)))) так)
 (так (перше (як-є ()))))

; Інший точний першокласний код Д4 ПОРОЖНІЙ?:
; це не еквівалент Д3 АТОМ?, отже результат мусить бути іншим.
(визначити відібрані-порожні-елементи
 (відібрати-за-першокласним-предикатом
  порожній?
  (список (як-є ()) (як-є атом?)
          (список (як-є решта)) (як-є ()))))

(за-умовою
 ((порожній? (перше відібрані-порожні-елементи)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (друге відібрані-порожні-елементи)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта (решта відібрані-порожні-елементи))) так)
 (так (перше (як-є ()))))

; Немає збігів: жодної нової пари. Позитивне повернення всіх атомів.
(за-умовою
 ((порожній?
   (відібрати-за-першокласним-предикатом атом?
    (список (список (як-є атом?))
            (список (як-є решта))))) так)
 (так (перше (як-є ()))))

; Негативний закон: FILTER не може повертати відкинуту вкладену пару
; й не може плутати порожній атом з усіма атомами.
(за-умовою
 ((хибне?
   (тотожне?
    (друге відібрані-атомні-елементи)
    (як-є сполучити))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне?
   (тотожне?
    (перше відібрані-порожні-елементи)
    (як-є атом?))) так)
 (так (перше (як-є ()))))

; Лише реальний SENS закінчує нативне виконання значенням Д1:1.
(атом? (як-є ()))
