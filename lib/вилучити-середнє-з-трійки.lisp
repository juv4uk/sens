; Д3/Д4: вилучити середній елемент трійки без втрати крайніх.
(визначити вилучити-середнє-з-трійки
  (функція (трійка)
    (список (перше трійка) (перше (решта-решти трійка)))))
(визначити пара-без-середнього
  (вилучити-середнє-з-трійки
    (список (як-є атом?) (як-є тотожне?) (як-є решта))))
(за-умовою
  ((тотожне? (перше пара-без-середнього) (як-є атом?))
   (за-умовою
     ((тотожне? (друге пара-без-середнього) (як-є решта))
      (хибне? (тотожне? (друге пара-без-середнього) (як-є тотожне?))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
