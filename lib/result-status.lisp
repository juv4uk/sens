; Українські первинні визначення дев'ятого та десятого доменів.
; Для трьох історичних викликів досі бракує підтвердженого
; шляху від повного українського імені до виконавчого замикання.
; Поточні бітові виклики наведено лише як стан міграції;
; їх не можна ототожнювати з координатами іншого домену.

; Мовне подання результатів міркування не додає винятків
; або нового виду значень зовнішнього виконавця.
; Звичайні виклики міркування зберігають сумісні результати.
; Окремі функції спостереження явно розрізняють стан знання
; та зберігають усі альтернативи доказу.
;
; Канонічні форми результату:
; доведене твердження з результатами;
; невідомий предмет;
; часткове значення з межею;
; призупинене міркування з причиною;
; суперечливі свідчення;
; неправильний вхід із поясненням.
;
; Однобітні предикати походять від доведених законів
; третього та четвертого доменів, а не від порівняння
; цитованих списків цифр. Істина й хиба — точні біти.
; Порожнє значення третього домену — дані, не число нуль.
; Умови мають рівно два поля, ширина входить до тотожності.
; Невизнані допоміжні функції не отримують вигаданих
; координат чи неявної заміни історичними кодами.

(визначити створити-доведений
  (функція (твердження результати)
    (список (як-є proved) твердження результати)))

(визначити створити-невідоме
  (функція (предмет)
    (список (як-є unknown) предмет)))

(визначити створити-частковий
  (функція (значення межа)
    (список (як-є partial) значення межа)))

(визначити створити-заблокований
  (функція (причина)
    (список (як-є blocked) причина)))

(визначити створити-спірний
  (функція (доказ)
    (список (як-є disputed) доказ)))

(визначити створити-некоректний
  (функція (причина вміст)
    (список (як-є invalid) причина вміст)))

; Мітка є результатом лише в належному списку.
; Крапкова пара (proved . хвіст) не є канонічним результатом міркування.
(визначити результат-позначений?
  (функція (результат)
    (за-умовою
      ((атом? результат) ні)
      ((хибне? (результат-є-правильним-списком? результат)) ні)
      ((хибне? (атом? (перше результат))) ні)
      ((тотожне? (перше результат) (як-є proved)) так)
      ((тотожне? (перше результат) (як-є unknown)) так)
      ((тотожне? (перше результат) (як-є partial)) так)
      ((тотожне? (перше результат) (як-є blocked)) так)
      ((тотожне? (перше результат) (як-є disputed)) так)
      ((тотожне? (перше результат) (як-є invalid)) так)
      (так ні))))

(визначити результат-стан
  (функція (результат)
    (за-умовою
      ((результат-позначений? результат) (перше результат))
      (так (як-є ())))))

(визначити результат-вміст
  (функція (результат)
    (за-умовою
      ((результат-позначений? результат) (решта результат))
      (так (як-є ())))))

; Перевірку правильного списку починаємо з атомарності.
; Атомна тотожність не приймає складену пару лише
; заради з'ясування, чи є вона порожнім списком.
(визначити результат-є-правильним-списком?
  (функція (значення)
    (за-умовою
      ((атом? значення)
       (за-умовою
         ((тотожне? значення (як-є ())) так)
         (так ні)))
      (так
       (результат-є-правильним-списком? (решта значення))))))

; Історичний заперечний запис зберігається як цитована форма.
; Чинна форма предиката має окрему ратифіковану назву.
(визначити результат-не-є-головою-правила?
  (функція (голова)
    (за-умовою
      ((тотожне? голова (як-є not?)) так)
      ((тотожне? голова (як-є not)) так)
      (так ні))))

; Мінімальна перевірка правильно сформованої цілі:
; виклична голова має бути символом, аргументи — правильним списком.
; Заперечення допускає рівно одну правильну вкладену ціль.
; Хвіст має містити одну пару, а її хвіст — бути порожнім.
; Неповне чи надлишкове заперечення не визнається невідомим.
; Арність перевіряємо засобами третього та четвертого доменів.
(визначити результат-ціль?
  (функція (ціль)
    (за-умовою
      ((атом? ціль) ні)
      ((хибне? (результат-є-правильним-списком? ціль)) ні)
      ((хибне? (символ? (перше ціль))) ні)
      ((результат-не-є-головою-правила? (перше ціль))
       (за-умовою
         ((хибне? (атом? (решта ціль)))
          (за-умовою
            ((атом? (решта-решти ціль)) (результат-ціль? (друге ціль)))
            (так ні)))
         (так ні)))
      (так так))))

; Заперечна ціль є явним логічним протилежним твердженням.
; Правильний заперечний запит перевіряє додатну ціль;
; інші цілі отримують явне заперечення.
(визначити результат-заперечений-ціль?
  (функція (ціль)
    (за-умовою
      ((хибне? (результат-ціль? ціль)) ні)
      ((результат-не-є-головою-правила? (перше ціль)) так)
      (так ні))))

(визначити результат-протилежний-ціль
  (функція (ціль)
    (за-умовою
      ((результат-заперечений-ціль? ціль) (друге ціль))
      (так (список (як-є not?) ціль)))))

; Додатний і протилежний запити використовують одну
; ратифіковану функцію дев'ятого домену та спільний
; незмінний індекс міркування. Це прибирає зайві виклики
; обчислювача доказів. Числова глибина належить точній
; математиці, а не значенню істини першого домену.
; Спостереження одного запиту не відкидає альтернативні докази.
; Додатний доказ дає доведений результат.
; Окремий протилежний доказ доводить протилежне.
; Обидва докази означають суперечність.
; Відсутність обох доказів повертає порожню структуру,
; якщо інший доведений контракт не встановив інший стан.
;
; Вхід може містити історичний список правил або
; явно підготовлений незмінний індекс.
; Обидва запити використовують той самий скінченний знімок.
; Звичайні виклики створюють індекс один раз на спостереження.
; Повторні виклики можуть самі зберігати готовий індекс.
; Прихованого кешу немає; знімок відповідає правилам
; на момент його підготовки.
(визначити міркувати-спостерігати
  (функція (ціль правила-або-індекс)
    (за-умовою
      ((хибне? (результат-ціль? ціль))
       (створити-некоректний (як-є invalid-goal) ціль))
      (так
       (нехай-послідовно ((протилежне (результат-протилежний-ціль ціль))
              (індекс (забезпечити-індекс-міркування правила-або-індекс))
              (позитивні-результати (міркувати ціль індекс))
              (протилежні-результати (міркувати протилежне індекс)))
         (за-умовою
           ((за-умовою
              ((хибне? (атом? позитивні-результати))
               (хибне? (атом? протилежні-результати)))
              (так ні))
            (створити-спірний
              (список
                (створити-доведений ціль позитивні-результати)
                (створити-доведений протилежне протилежні-результати))))
           ((хибне? (атом? позитивні-результати))
            (створити-доведений ціль позитивні-результати))
           ((хибне? (атом? протилежні-результати))
            (створити-доведений протилежне протилежні-результати))
           (так (як-є ()))))))))

; Перевірка вхідної цілі передує пошуку модуля знань.
; Неправильна форма завжди дає відмову, навіть якщо модуля немає.
; Відсутність добре названого модуля у журналі вже встановлена:
; це відома незадоволена передумова, а не невідоме знання.
(визначити міркувати-у-спостерігати
  (функція (назва-модуля ціль)
    (за-умовою
      ((хибне? (символ? назва-модуля))
       (створити-некоректний (як-є invalid-module) назва-модуля))
      ((хибне? (результат-ціль? ціль))
       (створити-некоректний (як-є invalid-goal) ціль))
      ((модуль-відомий? назва-модуля)
       (міркувати-спостерігати ціль (модуль-клаузи-зараз назва-модуля)))
      (так
       (створити-заблокований
         (список (як-є module-not-found) назва-модуля))))))


; Конструктори, спостереження й розпакування результатів
; мають лише повні українські викличні назви з чинних доменів.
; Старі латинські псевдоніми не визначаються повторно;
; зовнішні протокольні позначки у цитованих даних незмінні.
