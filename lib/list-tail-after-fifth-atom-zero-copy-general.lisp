; СЕНС: хвіст після п'ятого атомного елемента без копіювання пар.
; П'ять фаз Д3-Д5, один прохід, нуль числових операцій Д24+.
; Вкладені пари не рахуються, порожній елемент () - атом.
; Перше і решта викликаються лише після перевірки на атом.
; Українська проєкція; Зіг і Т5М - носій, не семантичний оракул.

(визначити хвіст-після-одного-для-пятого
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи)) (решта елементи))
   (так (хвіст-після-одного-для-пятого (решта елементи))))))

(визначити хвіст-після-двох-для-пятого
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-одного-для-пятого (решта елементи)))
   (так (хвіст-після-двох-для-пятого (решта елементи))))))

(визначити хвіст-після-трьох-для-пятого
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-двох-для-пятого (решта елементи)))
   (так (хвіст-після-трьох-для-пятого (решта елементи))))))

(визначити хвіст-після-чотирьох-для-пятого
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-трьох-для-пятого (решта елементи)))
   (так (хвіст-після-чотирьох-для-пятого (решта елементи))))))

(визначити хвіст-після-пятого-атома
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-чотирьох-для-пятого (решта елементи)))
   (так (хвіст-після-пятого-атома (решта елементи))))))

; Справжні закони СЕНС: за порушення виконується помилкове перше ().
; Порожнє та атомарне джерело, неправильний хвіст, брак п'ятого.
(за-умовою
 ((порожній? (хвіст-після-пятого-атома (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-пятого-атома (як-є атом?))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній?
   (хвіст-після-пятого-атома
    (сполучити (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній?
   (хвіст-після-пятого-атома
    (список (як-є атом?) (як-є решта)
            (як-є сполучити) (як-є функція)))) так)
 (так (перше (як-є ()))))

; П'ятий атом видалено, шостий та сьомий лишаються в оригінальному хвості.
(визначити пятий-хвіст
 (хвіст-після-пятого-атома
  (список (як-є атом?) (як-є решта) (як-є сполучити)
          (як-є функція) (як-є визначити)
          (як-є за-умовою) (як-є тотожне?))))
(за-умовою
 ((тотожне? (перше пятий-хвіст) (як-є за-умовою)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (друге пятий-хвіст) (як-є тотожне?)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта (решта пятий-хвіст))) так)
 (так (перше (як-є ()))))

; Негатив: початковий елемент не повинен лишатися в суфіксі.
(за-умовою
 ((хибне? (тотожне? (перше пятий-хвіст) (як-є атом?))) так)
 (так (перше (як-є ()))))

; Складені елементи не рахуються; результат починається після 5 атомів.
(визначити пятий-вкладений
 (хвіст-після-пятого-атома
  (список (список (як-є атом?)) (як-є решта)
          (список (як-є функція)) (як-є сполучити)
          (як-є функція) (як-є визначити)
          (як-є за-умовою) (як-є тотожне?))))
(за-умовою
 ((тотожне? (перше пятий-вкладений) (як-є тотожне?)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта пятий-вкладений)) так)
 (так (перше (як-є ()))))

; порожній як елемент зараховується як атом, не губиться.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-пятого-атома
    (список (як-є атом?) (як-є ()) (як-є решта)
            (як-є сполучити) (як-є визначити) (як-є функція))))
   (як-є функція)) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
