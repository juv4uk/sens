; Найдовший кінцевий суфікс однакових атомів скінченного правильного списку.
; Одна хода, O(n) часу, O(1) додаткових пар CONS: повертаємо наявний хвіст.
; На відміну від перевертання й повторних пошуків, значення не копіюються.
; Мовні закони — у SENS D1/D3/D5; D7 — видимі клавіатурні символи.
; Фізичний T5M створює Zig, а не Python, JSON чи Unicode-транспорт.

(визначити кінцева-серія-атомів-обхід
 (функція (залишок початок-серії попередній)
  (за-умовою
   ((порожній? залишок) початок-серії)
   ((тотожне? (перше залишок) попередній)
    (кінцева-серія-атомів-обхід (решта залишок) початок-серії попередній))
   (так
    (кінцева-серія-атомів-обхід (решта залишок) залишок (перше залишок))))))

(визначити кінцева-серія-однакових-атомів
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   (так (кінцева-серія-атомів-обхід
         (решта елементи) елементи (перше елементи))))))

; Незалежна структура результату: EQ застосовується тільки до атомів.
(визначити кінцеві-атомні-списки-однакові?
 (функція (ліві праві)
  (за-умовою
   ((порожній? ліві) (порожній? праві))
   ((порожній? праві) ні)
   ((тотожне? (перше ліві) (перше праві))
    (кінцеві-атомні-списки-однакові? (решта ліві) (решта праві)))
   (так ні))))

(визначити довести-кінцеву-серію
 (функція (вхід очікуване)
  (за-умовою
   ((кінцеві-атомні-списки-однакові?
      (кінцева-серія-однакових-атомів вхід) очікуване) так)
   (так (перше (як-є ()))))))

; Порожній список, один атом, однакові й різні атоми, зміна на межі.
(довести-кінцеву-серію (як-є ()) (як-є ()))
(довести-кінцеву-серію
 (список (як-є атом?)) (список (як-є атом?)))
(довести-кінцеву-серію
 (список (як-є атом?) (як-є атом?))
 (список (як-є атом?) (як-є атом?)))
(довести-кінцеву-серію
 (список (як-є атом?) (як-є решта))
 (список (як-є решта)))
(довести-кінцеву-серію
 (список (як-є атом?) (як-є решта) (як-є решта))
 (список (як-є решта) (як-є решта)))
(довести-кінцеву-серію
 (список (як-є атом?) (як-є решта) (як-є атом?))
 (список (як-є атом?)))
(довести-кінцеву-серію
 (список (як-є атом?) (як-є атом?) (як-є решта) (як-є решта) (як-є решта))
 (список (як-є решта) (як-є решта) (як-є решта)))
(довести-кінцеву-серію
 (список (як-є атом?) (як-є решта) (як-є решта) (як-є сполучити) (як-є сполучити))
 (список (як-є сполучити) (як-є сполучити)))
(довести-кінцеву-серію
 (список (як-є ()) (як-є ()) (як-є ()))
 (список (як-є ()) (як-є ()) (як-є ())))
(довести-кінцеву-серію
 (список (як-є атом?) (як-є ()) (як-є ()))
 (список (як-є ()) (як-є ())))
(довести-кінцеву-серію
 (список (як-є ()) (як-є атом?) (як-є ()))
 (список (як-є ())))
(довести-кінцеву-серію
 (список (як-є тотожне?) (як-є сполучити) (як-є решта) (як-є атом?)
         (як-є сполучити) (як-є сполучити) (як-є сполучити))
 (список (як-є сполучити) (як-є сполучити) (як-є сполучити)))

; Негативні оракули: порожня/коротша/чужа серія не є правильними.
(за-умовою
 ((хибне? (кінцеві-атомні-списки-однакові?
   (кінцева-серія-однакових-атомів
    (список (як-є атом?) (як-є решта) (як-є решта)))
   (список (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (кінцеві-атомні-списки-однакові?
   (кінцева-серія-однакових-атомів
    (список (як-є атом?) (як-є решта)))
   (список (як-є атом?)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (кінцеві-атомні-списки-однакові?
   (кінцева-серія-однакових-атомів (список (як-є атом?)))
   (як-є ()))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
