; СЕНС: суфікс від останньої пари різних сусідніх атомів.
; Один прохід, нуль нових пар, без копіювання вихідних хвостів.
; АТОМ? перевіряє обидві позиції до ПЕРШЕ/ДРУГЕ, в тому числі
; некоректний атомарний хвіст, без жодного виклику на неправильній парі.
; Д3 ТОТОЖНЕ? викликається лише для двох атомів; вкладені пари пропускаємо.
; Мовна проєкція - чинна українська Д3-Д5; Зіг лише пакує Т5М.

(визначити шукати-останню-сусідню-відмінність
 (функція (залишок останній)
  (за-умовою
   ((атом? залишок) останній)
   ((атом? (решта залишок)) останній)
   ((хибне? (атом? (перше залишок)))
    (шукати-останню-сусідню-відмінність (решта залишок) останній))
   ((хибне? (атом? (друге залишок)))
    (шукати-останню-сусідню-відмінність (решта залишок) останній))
   ((хибне? (тотожне? (перше залишок) (друге залишок)))
    (шукати-останню-сусідню-відмінність (решта залишок) залишок))
   (так
    (шукати-останню-сусідню-відмінність (решта залишок) останній)))))

(визначити суфікс-останньої-відмінності-сусідів
 (функція (елементи)
  (шукати-останню-сусідню-відмінність елементи (як-є ()))))

; Рекурсивна рівність дерев: для пар - Д3 ПЕРШЕ і РЕШТА.
(визначити рівні-дерева-сусідньої-відмінності?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((рівні-дерева-сусідньої-відмінності? (перше ліве) (перше праве))
    (рівні-дерева-сусідньої-відмінності? (решта ліве) (решта праве)))
   (так ні))))

