; Відібрати лише точні числові значення з різнорідного списку.
; Ратифікований предикат числа належить Д5, числа Д24 і вище.
; Символи, текст і вкладені списки не стають числами через вигляд.
; Відбір один раз проходить хвіст, не переписує дані і не має хоста.
; Константи будуються арифметикою D5 над точними D24+ нулем та одиницею.
; Жодних текстових undefined або прихованих десяткових проміжних значень.

(визначити точні-числа-значення-нуль число-нуль)
(визначити точні-числа-значення-один число-один)
(визначити точні-числа-значення-два (додати точні-числа-значення-один число-один))
(визначити точні-числа-значення-три (додати точні-числа-значення-два число-один))
(визначити точні-числа-значення-чотири (додати точні-числа-значення-три число-один))
(визначити точні-числа-значення-п'ять (додати точні-числа-значення-чотири число-один))
(визначити точні-числа-значення-шість (додати точні-числа-значення-п'ять число-один))
(визначити точні-числа-значення-сім (додати точні-числа-значення-шість число-один))

; Д3:() є єдиним кінцем. Інший атом у хвості — власна SENS Type.
(визначити залишити-точні-числа
  (функція (елементи)
    (за-умовою
      ((атом? елементи)
       (за-умовою
         ((тотожне? елементи (як-є ())) (як-є ()))
         (так (перше (як-є ())))))
      ((число? (перше елементи))
       (сполучити (перше елементи)
         (залишити-точні-числа (решта елементи))))
      (так (залишити-точні-числа (решта елементи))))))

(визначити відібране
  (залишити-точні-числа
    (список точні-числа-значення-сім (як-є атом?) (частка точні-числа-значення-сім точні-числа-значення-два) (як-є ()) точні-числа-значення-нуль)))

; Помилкова гілка виконує перше порожнього списку самим СЕНС.
(за-умовою
  ((число? (перше відібране)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((число? (друге відібране)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((число? (перше (решта-решти відібране))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (решта (решта-решти відібране))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (залишити-точні-числа (як-є ()))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (залишити-точні-числа
    (список (як-є атом?) (як-є ()) (список (як-є решта))))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне? (число? (як-є атом?))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне? (число? (як-є решта))) так)
  (так (перше (як-є ()))))

; Д5:01000 НУЛЬ? від різниці двох точних чисел D12+.
; Числова рівність a=b рівносильна a-b=0 в ратифікованому числовому
; домені. Не викликати D6:110100 / D6:110101: у фізичному D12-профілі
; ці адреси не допущено. Не підмінювати рівність D3 ТОТОЖНЕ? двох об'єктів.
(визначити точні-числа-рівні?
  (функція (ліве праве)
    (нуль? (відняти ліве праве))))

; Захист від колишніх undefined та зсуву всіх назв на одиницю.
; Кожна похідна перевіряється незалежним уже наявним числом Core4.
(за-умовою
  ((хибне? (точні-числа-рівні? точні-числа-значення-нуль число-нуль))
   (перше (як-є ())))
  ((хибне? (точні-числа-рівні? точні-числа-значення-один число-один))
   (перше (як-є ())))
  ((хибне? (точні-числа-рівні? точні-числа-значення-два число-два))
   (перше (як-є ())))
  ((хибне? (точні-числа-рівні? точні-числа-значення-три число-три))
   (перше (як-є ())))
  ((хибне? (точні-числа-рівні? точні-числа-значення-чотири число-чотири))
   (перше (як-є ())))
  ((хибне? (точні-числа-рівні? точні-числа-значення-п'ять число-п'ять))
   (перше (як-є ())))
  ((хибне? (точні-числа-рівні?
             точні-числа-значення-шість (додати число-п'ять число-один)))
   (перше (як-є ())))
  ((хибне? (точні-числа-рівні? точні-числа-значення-сім число-сім))
   (перше (як-є ())))
  ((хибне? (точні-числа-рівні? (перше відібране) число-сім))
   (перше (як-є ())))
  ((хибне? (точні-числа-рівні?
             (друге відібране) (частка число-сім число-два)))
   (перше (як-є ())))
  ((хибне? (точні-числа-рівні?
             (перше (решта-решти відібране)) число-нуль))
   (перше (як-є ())))
  (так так))

(число? (перше відібране))
