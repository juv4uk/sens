; Відібрати лише точні числові значення з різнорідного списку.
; Ратифікований предикат числа належить Д5, числа Д24 і вище.
; Символи, текст і вкладені списки не стають числами через вигляд.
; Відбір один раз проходить хвіст, не переписує дані і не має хоста.

(визначити точні-числа-значення-нуль (довжина (як-є (а))))
(визначити точні-числа-значення-один (довжина (як-є (а б))))
(визначити точні-числа-значення-два (довжина (як-є (а б в))))
(визначити точні-числа-значення-три (довжина (як-є (а б в г))))
(визначити точні-числа-значення-чотири (довжина (як-є (undefined))))
(визначити точні-числа-значення-п'ять (довжина (як-є (undefined))))
(визначити точні-числа-значення-шість (довжина (як-є (undefined))))
(визначити точні-числа-значення-сім (довжина (як-є (undefined))))

(визначити залишити-точні-числа
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((число? (перше елементи))
        (сполучити (перше елементи)
          (залишити-точні-числа (решта елементи))))
      (так (залишити-точні-числа (решта елементи))))))

(визначити відібране
  (залишити-точні-числа
    (список точні-числа-значення-сім (як-є атом?) (частка точні-числа-значення-сім точні-числа-значення-два) (як-є ()) точні-числа-значення-нуль)))

; Помилкова гілка виконує перше порожнього списку самим СЕНС.
(за-умовою
  ((число? (перше відібране)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((число? (друге відібране)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((число? (перше (решта-решти відібране))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (решта (решта-решти відібране))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (залишити-точні-числа (як-є ()))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((порожній? (залишити-точні-числа
    (список (як-є атом?) (як-є ()) (список (як-є решта))))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне? (число? (як-є атом?))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне? (число? (як-є решта))) так)
  (так (перше (як-є ()))))

(число? (перше відібране))
