; СЕНС: вилучити кожний п'ятий елемент правильного списку.
; Один структурний прохід, чотири нові пари на повну п'ятірку.
; Короткий хвіст повертається без копіювання; вкладені дані зберігаються.
; Лише ратифіковані виклики Д1–Д5 та українська клавіатурна проєкція.
(визначити вилучити-кожен-пятий
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (решта елементи)) елементи)
   ((атом? (решта (решта елементи))) елементи)
   ((атом? (решта (решта (решта елементи)))) елементи)
   ((атом? (решта (решта (решта (решта елементи))))) елементи)
   (так
    (сполучити (перше елементи)
     (сполучити (друге елементи)
      (сполучити (третє елементи)
       (сполучити (перше (решта (решта (решта елементи))))
        (вилучити-кожен-пятий
         (решта (решта (решта (решта (решта елементи))))))))))))))

; Структурна тотожність виконується мовою СЕНС, а не зовнішнім оракулом.
(визначити дерева-пятих-однакові?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((дерева-пятих-однакові? (перше ліве) (перше праве))
    (дерева-пятих-однакові? (решта ліве) (решта праве)))
   (так ні))))

(визначити перевірити-вилучення-пятого
