; СЕНС: повернути той самий суфікс після н-го атомного елемента.
; Д3 ПЕРШЕ і РЕШТА, Д4 ФУНКЦІЯ і ВИЗНАЧИТИ, математичні Д24+.
; Д7 використано тільки для локальних назв, без сід8 і сенс8.
; Один прохід, жодної нової пари: навіть вкладений список не копіюється.
; АТОМ? захищає ПЕРШЕ та РЕШТА на атомарних і неповних хвостах.
(визначити хвіст-атом-число-нуль (довжина (як-є ())))
(визначити хвіст-атом-число-один (довжина (як-є (а))))
(визначити хвіст-атом-число-два (довжина (як-є (а б))))
(визначити хвіст-атом-число-три (довжина (як-є (а б в))))
(визначити хвіст-атом-число-чотири (довжина (як-є (а б в г))))

(визначити хвіст-після-н-атомів
 (функція (елементи скільки)
  (за-умовою
   ((менше? скільки хвіст-атом-число-нуль) (перше (як-є ())))
   ((нуль? скільки) елементи)
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-н-атомів (решта елементи) (відняти скільки хвіст-атом-число-один)))
   (так (хвіст-після-н-атомів (решта елементи) скільки)))))

; Нативні СЕНС свідки: брак, точна межа, суфікс, вкладення, () і нуль.
; Безпечно завершуватися також на атомарному джерелі та неповній парі.
(за-умовою
 ((порожній? (хвіст-після-н-атомів (як-є атом?) хвіст-атом-число-два)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-н-атомів
   (сполучити (як-є атом?) (як-є решта)) хвіст-атом-число-три)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-н-атомів (як-є ()) хвіст-атом-число-чотири)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-н-атомів
   (список (як-є атом?) (як-є решта) (як-є сполучити)) хвіст-атом-число-чотири))
  так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-н-атомів
   (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є функція)) хвіст-атом-число-чотири))
  так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (перше (хвіст-після-н-атомів
     (список (як-є атом?) (як-є решта) (як-є сполучити)
             (як-є функція) (як-є визначити)) хвіст-атом-число-чотири))
   (як-є визначити))
  так)
 (так (перше (як-є ()))))
; Межі індексу належать точній математиці, а не атомній рівності Д3.
; Обидва свідки реально обчислюються СЕНС (помилка доходить до ПЕРШЕ ()).
(за-умовою
 ((тотожне?
   (перше (хвіст-після-н-атомів
     (список (як-є атом?) (як-є решта) (як-є функція)) хвіст-атом-число-один))
   (як-є решта)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (перше (хвіст-після-н-атомів
     (список (як-є атом?) (список (як-є решта))
             (як-є функція) (як-є визначити)) хвіст-атом-число-два))
   (як-є визначити)) так)
 (так (перше (як-є ()))))
; Вкладена пара не збільшує лічильника атомів.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-н-атомів
     (список (список (як-є атом?)) (як-є решта)
             (як-є сполучити) (як-є функція)
             (як-є визначити) (як-є за-умовою)) хвіст-атом-число-чотири))
   (як-є за-умовою))
  так)
 (так (перше (як-є ()))))
; Структурне () є атомом і має власну позицію.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-н-атомів
     (список (як-є ()) (як-є решта) (як-є сполучити)) хвіст-атом-число-один))
   (як-є решта))
  так)
 (так (перше (як-є ()))))
; Нуль: суфікс починається з першого елемента оригіналу.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-н-атомів (список (як-є атом?) (як-є решта)) хвіст-атом-число-нуль))
   (як-є атом?))
  так)
 (так (перше (як-є ()))))
так
