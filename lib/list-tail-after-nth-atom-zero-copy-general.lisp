; СЕНС: повернути той самий суфікс після н-го атомного елемента.
; Д3 ПЕРШЕ і РЕШТА, Д4 ФУНКЦІЯ і ВИЗНАЧИТИ, математичні Д24+.
; Д7 використано тільки для локальних назв, без сід8 і сенс8.
; Один прохід, жодної нової пари: навіть вкладений список не копіюється.
(визначити хвіст-після-н-атомів
 (функція (елементи скільки)
  (за-умовою
   ((менше? скільки 0) (перше (як-є ())))
   ((нуль? скільки) елементи)
   ((порожній? елементи) (як-є ()))
   ((атом? (перше елементи))
    (за-умовою
     ((тотожне? скільки 1) (решта елементи))
     (так (хвіст-після-н-атомів (решта елементи) (відняти скільки 1)))))
   (так (хвіст-після-н-атомів (решта елементи) скільки)))))

; Нативні СЕНС свідки: брак, точна межа, суфікс, вкладення, () і нуль.
(за-умовою
 ((порожній? (хвіст-після-н-атомів (як-є ()) 4)) (атом? (як-є ())))
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-н-атомів
   (список (як-є атом?) (як-є решта) (як-є сполучити)) 4))
  (атом? (як-є ())))
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-н-атомів
   (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є функція)) 4))
  (атом? (як-є ())))
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (перше (хвіст-після-н-атомів
     (список (як-є атом?) (як-є решта) (як-є сполучити)
             (як-є функція) (як-є визначити)) 4))
   (як-є визначити))
  (атом? (як-є ())))
 (так (перше (як-є ()))))
; Вкладена пара не збільшує лічильника атомів.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-н-атомів
     (список (список (як-є атом?)) (як-є решта)
             (як-є сполучити) (як-є функція)
             (як-є визначити) (як-є за-умовою)) 4))
   (як-є за-умовою))
  (атом? (як-є ())))
 (так (перше (як-є ()))))
; Структурне () є атомом і має власну позицію.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-н-атомів
     (список (як-є ()) (як-є решта) (як-є сполучити)) 1))
   (як-є решта))
  (атом? (як-є ())))
 (так (перше (як-є ()))))
; Нуль: суфікс починається з першого елемента оригіналу.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-н-атомів (список (як-є атом?) (як-є решта)) 0))
   (як-є атом?))
  (атом? (як-є ())))
 (так (перше (як-є ()))))
(атом? (як-є ()))
