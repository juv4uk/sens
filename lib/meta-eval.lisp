      ((хибне? (атом? (перше гілки-умов))) (my-cond-has-migration-clause? (решта гілки-умов)))
      ((атом? (перше гілки-умов))  (my-cond-has-migration-clause? (решта гілки-умов)))
      ((тотожне? (довжина (перше гілки-умов)) 2)  так)
