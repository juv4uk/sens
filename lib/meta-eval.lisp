(визначити порівняти-два-значення-мета
  (функція (оператор-виразу лівий правий)
    (за-умовою
      ((тотожне? оператор-виразу (як-є менше?)) (менше? лівий правий))
      ((тотожне? оператор-виразу (як-є однакові?)) (однакові? лівий правий))
      ((тотожне? оператор-виразу (як-є більше?)) (більше? лівий правий))
      (так ні))))

; Ланцюгове порівняння повертає точний D1 результат: кожна пара
; порівнюється зліва направо, а перша відповідь «ні» завершує перевірку.
(визначити усі-сусідні-значення-задовольняють-порівняння?
  (функція (оператор-виразу значення-списку)
    (за-умовою
      ((атом? (решта значення-списку)) так)
      ((тотожне? (порівняти-два-значення-мета оператор-виразу (перше значення-списку) (друге значення-списку)) так)
       (усі-сусідні-значення-задовольняють-порівняння? оператор-виразу (решта значення-списку)))
      (так ні))))

; Тотожність примітива є значенням самого Lisp.
; Ця функція пов'язує її тільки з допущеним механізмом виконання
; відповідної первинної операції, без нової семантичної тотожності.
(визначити застосувати-примітив-мета
  (функція (імя-символу аргументи)
    (за-умовою
      ((тотожне? імя-символу (як-є атом?)) (атом? (перше аргументи)))
      ((тотожне? імя-символу (як-є тотожне?)) (тотожне? (перше аргументи) (друге аргументи)))
      ((тотожне? імя-символу (як-є перше)) (перше (перше аргументи)))
      ((тотожне? імя-символу (як-є решта)) (решта (перше аргументи)))
      ((тотожне? імя-символу (як-є сполучити)) (сполучити (перше аргументи) (друге аргументи)))
      ((тотожне? імя-символу (як-є додати)) (додати (перше аргументи) (друге аргументи)))
      ((тотожне? імя-символу (як-є відняти)) (відняти (перше аргументи) (друге аргументи)))
      ((тотожне? імя-символу (як-є помножити)) (помножити (перше аргументи) (друге аргументи)))
      ((тотожне? імя-символу (як-є менше?)) (усі-сусідні-значення-задовольняють-порівняння? (як-є менше?) аргументи))
      ((тотожне? імя-символу (як-є однакові?)) (усі-сусідні-значення-задовольняють-порівняння? (як-є однакові?) аргументи))
      ((тотожне? імя-символу (як-є більше?)) (усі-сусідні-значення-задовольняють-порівняння? (як-є більше?) аргументи))
      ((тотожне? імя-символу (як-є значення-у-текст))
       (значення-у-текст (перше аргументи)))
      ((тотожне? імя-символу (як-є текст-у-символ))
       (текст-у-символ (перше аргументи)))
      ((тотожне? імя-символу (як-є символ-у-текст))
       (символ-у-текст (перше аргументи)))
      (так (список (як-є unknown-primitive) імя-символу)))))

; Арність списку параметрів виводиться з його власної структури Lisp:
;   (x y)        — рівно два аргументи;
;   (x y . rest) — не менше двох аргументів;
;   args         — довільна кількість від нуля.
; Метадані зовнішнього виконавця не потрібні.
; Арність — математичне число D24+, не неявне підвищення числа читачем.
; Єдиний структурний лічильник обчислює і потрібну, і отриману кількість.
(визначити порахувати-обов'язкові-параметри-лямбди
  (функція (параметри)
    (за-умовою
      ((атом? параметри) 0)
      (так (додати 1
                       (порахувати-обов'язкові-параметри-лямбди (решта параметри)))))))

(визначити лямбда-має-параметр-залишку?
  (функція (параметри)
    (за-умовою
      
      ((атом? параметри)  (за-умовою
         ((тотожне? параметри (як-є ())) ні)
         (так так)))
      (так (лямбда-має-параметр-залишку? (решта параметри))))))

(визначити арність-відповідає-аргументам?
  (функція (параметри одержані-аргументи)
    (нехай ((зафіксоване (порахувати-обов'язкові-параметри-лямбди параметри))
             (отримане (порахувати-обов'язкові-параметри-лямбди одержані-аргументи)))
      (за-умовою
        ((лямбда-має-параметр-залишку? параметри)
         (за-умовою
           ((менше? отримане зафіксоване) ні)
           ((хибне? (менше? отримане зафіксоване)) так)
           (так ні)))
        (так
         (за-умовою
           ((тотожне? отримане зафіксоване) так)
           (так ні)))))))

(визначити опис-очікуваної-та-одержаної-арності
  (функція (параметри одержані-аргументи)
    (нехай ((зафіксоване (порахувати-обов'язкові-параметри-лямбди параметри))
          (отримане (порахувати-обов'язкові-параметри-лямбди одержані-аргументи)))
      (список
        (як-є expected)
        (за-умовою
          ((лямбда-має-параметр-залишку? параметри) (список (як-є at-least) зафіксоване))
          (так (список (як-є exact) зафіксоване)))
        (як-є received)
        отримане))))

(визначити помилка-арності-мета
  (функція (параметри одержані-аргументи)
