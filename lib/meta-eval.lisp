; Metacircular evaluator: my-eval interprets my-lisp source as Lisp data.
;
; Contract 6.0 ownership boundary:
; the finite Canon 0+7 surface-name set is resolved before the metacircular
; lexical environment and cannot be used by language binders. Callable Canon
; spellings resolve to first-class `(primitive identity)` values; quote/cond
; remain syntax-only. Ordinary non-Canon primitives such as +, -, *, <, =, >
; still live in the metacircular environment model and remain shadowable.
;
; The actual primitive operation is still supplied by the native substrate;
; this evaluator owns name resolution, Canon-first lookup, ordinary lexical
; shadowing, application shape, macro expansion, closure environments, chained
; comparison policy, shared top-level definition-frame visibility, self-recursive
; and dependency-aware finite mutually recursive top-level function binding,
; variadic/dotted lambda parameter binding, and named failure observations for
; unresolved names, non-callable values, lambda/macro arity mismatch, invalid
; lambda-list structure, and reserved Canon binding attempts.
;
; This remains an explicit self-hosting witness, not the always-loaded runtime.
; Full named-error parity is still a known gap and must not be claimed as
; complete self-hosting.

(визначити my-primitive
  (функція (імя-символу)
    (список (як-є primitive) імя-символу)))

(визначити створити-структуровану-помилку
  (функція (вид подробиці)
    (список (як-є error) вид подробиці)))

; Internal evaluator outcomes carry provenance that interpreted Lisp data cannot
; forge. The tag is a native closure identity, not a symbol or list shape that
; a program could reproduce with quote/cons. Public my-eval/my-apply unwrap the
; envelope, so the observable interface stays unchanged.
(визначити my-result-ok-token
  (функція (значення-виразу) значення-виразу))

(визначити my-result-fail-token
  (функція (значення-виразу) значення-виразу))

(визначити власний-результат-успіх
  (функція (значення-виразу)
    (сполучити my-result-ok-token значення-виразу)))

(визначити власний-результат-невдача
  (функція (помилка)
    (сполучити my-result-fail-token помилка)))

(визначити це-результат-невдалого-обчислення?
  (функція (результат-виразу)
    (за-умовою
      
      ((атом? результат-виразу)  ні)
      (так (тотожне? (перше результат-виразу) my-result-fail-token)))))

(визначити my-result-value
  (функція (результат-виразу)
    (решта результат-виразу)))

; Зіставлення поверхонь повертає назву ратифікованого українського мешканця,
; а не число, виведене з бітів. Справжня ширина та домен належать таблицям
; lib/domains/d1.lisp … d10.lisp; однакові десяткові значення різних доменів
; не можуть стати однією ідентичністю.
(визначити my-surface-any?
  (функція (імя-символу кандидати)
    (за-умовою
      ((атом? кандидати) ні)
      ((тотожне? імя-символу (перше кандидати)) так)
      (так (my-surface-any? імя-символу (решта кандидати))))))

(визначити my-semantic-id-for-surface
  (функція (імя-символу)
    (за-умовою
      ((my-surface-any? імя-символу (як-є (quote як-є))) (як-є як-є))
      ((my-surface-any? імя-символу (як-є (atom? атом?))) (як-є атом?))
      ((my-surface-any? імя-символу (як-є (eq? тотожне?))) (як-є тотожне?))
      ((my-surface-any? імя-символу (як-є (cons сполучити))) (як-є сполучити))
      ((my-surface-any? імя-символу (як-є (car перше))) (як-є перше))
      ((my-surface-any? імя-символу (як-є (cdr решта))) (як-є решта))
      ((my-surface-any? імя-символу (як-є (cond за-умовою))) (як-є за-умовою))
      ((my-surface-any? імя-символу (як-є (lambda функція))) (як-є функція))
      ((my-surface-any? імя-символу (як-є (define визначити))) (як-є визначити))
      ((my-surface-any? імя-символу (як-є (defmacro визначити-макрос))) (як-є визначити-макрос))
      ((my-surface-any? імя-символу (як-є (plus додати +))) (як-є додати))
      ((my-surface-any? імя-символу (як-є (difference відняти -))) (як-є відняти))
      ((my-surface-any? імя-символу (як-є (times помножити *))) (як-є помножити))
      ((my-surface-any? імя-символу (як-є (lessp? менше? <))) (як-є менше?))
      ((my-surface-any? імя-символу (як-є (equal? однакові?))) (як-є однакові?))
      ((my-surface-any? імя-символу (як-є (greaterp? більше? >))) (як-є більше?))
      ((my-surface-any? імя-символу (як-є (write-to-string значення-у-текст))) (як-є значення-у-текст))
      ((my-surface-any? імя-символу (як-є (string->symbol текст-у-символ))) (як-є текст-у-символ))
      (так (як-є ())))))

(визначити my-semantic-id?
  (функція (імя-символу семантична-поверхня)
    (за-умовою
      ((хибне? (атом? імя-символу)) ні)
      ((тотожне? (my-semantic-id-for-surface імя-символу) семантична-поверхня) так)
      (так ні))))

; Canon — сім синтаксичних і примітивних форм, кожна порівнюється за власною
; українською поверхнею. Жодна ширина не стискається до десяткового номера.
(визначити my-canon-semantic-id
  (функція (імя-символу)
    (нехай ((поверхня (my-semantic-id-for-surface імя-символу)))
      (за-умовою
        ((тотожне? поверхня (як-є як-є)) (як-є як-є))
        ((тотожне? поверхня (як-є атом?)) (як-є атом?))
        ((тотожне? поверхня (як-є тотожне?)) (як-є тотожне?))
        ((тотожне? поверхня (як-є сполучити)) (як-є сполучити))
        ((тотожне? поверхня (як-є перше)) (як-є перше))
        ((тотожне? поверхня (як-є решта)) (як-є решта))
        ((тотожне? поверхня (як-є за-умовою)) (як-є за-умовою))
        (так (як-є ()))))))

(визначити my-canon-identity
  (функція (імя-символу)
    (my-canon-semantic-id імя-символу)))

(визначити my-lambda-name?
  (функція (імя-символу)
    (my-semantic-id? імя-символу (як-є функція))))

(визначити my-define-name?
  (функція (імя-символу)
    (my-semantic-id? імя-символу (як-є визначити))))

(визначити my-defmacro-name?
  (функція (імя-символу)
    (my-semantic-id? імя-символу (як-є визначити-макрос))))

(визначити my-canon-name?
  (функція (імя-символу)
    (хибне? (порожній? (my-canon-identity імя-символу)))))

(визначити my-canon-callable-identity?
  (функція (посилання-тотожності)
    (за-умовою
      ((тотожне? посилання-тотожності (як-є атом?)) так)
      ((тотожне? посилання-тотожності (як-є тотожне?)) так)
      ((тотожне? посилання-тотожності (як-є сполучити)) так)
      ((тотожне? посилання-тотожності (як-є перше)) так)
      ((тотожне? посилання-тотожності (як-є решта)) так)
      (так ні))))

(визначити my-canon-quote-name?
  (функція (імя-символу)
    (тотожне? (my-canon-identity імя-символу) (як-є як-є))))

(визначити my-canon-cond-name?
  (функція (імя-символу)
    (тотожне? (my-canon-identity імя-символу) (як-є за-умовою))))

(визначити my-canon-binding-error
  (функція (імя-символу)
    (створити-структуровану-помилку
      (як-є invalid-form)
      (список (як-є canonical-name-immutable) імя-символу))))

; Root primitive meanings are values containing the canonical Ukrainian
; resident, never its decimalized bits. Canon remains syntax-first.
(визначити my-default-binding
  (функція (імя-символу)
    (нехай ((посилання-тотожності (my-canon-identity імя-символу)))
      (за-умовою
        ((my-canon-callable-identity? посилання-тотожності) (my-primitive посилання-тотожності))
        ((my-canon-name? імя-символу) (my-canon-binding-error імя-символу))
        ((my-semantic-id? імя-символу (як-є додати)) (my-primitive (як-є додати))
        )
        ((my-semantic-id? імя-символу (як-є відняти)) (my-primitive (як-є відняти)))
        ((my-semantic-id? імя-символу (як-є помножити)) (my-primitive (як-є помножити)))
        ((my-semantic-id? імя-символу (як-є менше?)) (my-primitive (як-є менше?)))
        ((my-semantic-id? імя-символу (як-є однакові?)) (my-primitive (як-є однакові?)))
        ((my-semantic-id? імя-символу (як-є більше?)) (my-primitive (як-є більше?)))
        ((my-semantic-id? імя-символу (як-є значення-у-текст))
         (my-primitive (як-є значення-у-текст)))
        ((my-semantic-id? імя-символу (як-є текст-у-символ))
         (my-primitive (як-є текст-у-символ)))
        (так імя-символу)))))

; ADR-009 shared definition frame.
;
; The metacircular environment remains finite Lisp data. A binding whose key is
; the non-symbol internal sentinel 0 stores the mutable-in-the-language-model
; top-level frame as an ordinary alist:
;
;   ((0 . ((latest . value) ...)) . lexical-outer-env)
;
; User binders are symbols, so the sentinel cannot collide with a legal source
; binding. Local lexical bindings are consed before this marker. At closure call
; time only the marker payload is refreshed from the caller; local captured
; bindings before it are preserved. This models shared frame identity without
; dynamic scope and without a cyclic host object.
(визначити my-shared-frame-binding?
  (функція (привязка)
    (за-умовою
      
      ((атом? привязка)  ні)
      (так (тотожне? (перше привязка) 0)))))

(визначити ім'я-зв'язане-в-кадрі?
  (функція (імя-символу кадр)
    (за-умовою
      
      ((атом? кадр)  ні)
      ((тотожне? (перше (перше кадр)) імя-символу) так)
      (так (ім'я-зв'язане-в-кадрі? імя-символу (решта кадр))))))

(визначити знайти-значення-імені-в-рамці
  (функція (імя-символу кадр)
    (за-умовою
      ((тотожне? (перше (перше кадр)) імя-символу) (решта (перше кадр)))
      (так (знайти-значення-імені-в-рамці імя-символу (решта кадр))))))

(визначити my-env-has-shared-frame?
  (функція (посилання-оточення)
    (за-умовою
      
      ((атом? посилання-оточення)  ні)
      ((my-shared-frame-binding? (перше посилання-оточення)) так)
      (так (my-env-has-shared-frame? (решта посилання-оточення))))))

(визначити my-shared-frame-value
  (функція (посилання-оточення)
    (за-умовою
      
      ((атом? посилання-оточення)  (як-є ()))
      ((my-shared-frame-binding? (перше посилання-оточення)) (решта (перше посилання-оточення)))
      (так (my-shared-frame-value (решта посилання-оточення))))))

(визначити my-ensure-shared-frame
  (функція (посилання-оточення)
    (за-умовою
      ((my-env-has-shared-frame? посилання-оточення) посилання-оточення)
      (так (сполучити (сполучити 0 (як-є ())) посилання-оточення)))))

(визначити my-replace-shared-frame
  (функція (посилання-оточення кадр)
    (за-умовою
      
      ((атом? посилання-оточення)  посилання-оточення)
      ((my-shared-frame-binding? (перше посилання-оточення))
       (сполучити (сполучити 0 кадр) (решта посилання-оточення)))
      (так
       (сполучити (перше посилання-оточення)
             (my-replace-shared-frame (решта посилання-оточення) кадр))))))

(визначити оновити-спільний-кадр-замикання
  (функція (захоплене-оточення оточення-виклику)
    (за-умовою
      ((my-env-has-shared-frame? захоплене-оточення)
       (за-умовою
         ((my-env-has-shared-frame? оточення-виклику)
          (my-replace-shared-frame
            захоплене-оточення
            (my-shared-frame-value оточення-виклику)))
         (так захоплене-оточення)))
      (так захоплене-оточення))))

; Definitions update the shared marker when one is active. Outside
; my-eval-program this falls back to the historical plain-alist extension, so
; direct my-eval-top-form use remains compatible.
(визначити додати-визначення-до-оточення
  (функція (імя-символу значення-виразу посилання-оточення)
    (за-умовою
      
      ((атом? посилання-оточення)  (сполучити (сполучити імя-символу значення-виразу) посилання-оточення))
      ((my-shared-frame-binding? (перше посилання-оточення))
       (сполучити
         (сполучити 0
               (сполучити (сполучити імя-символу значення-виразу)
                     (решта (перше посилання-оточення))))
         (решта посилання-оточення)))
      (так
       (сполучити (перше посилання-оточення)
             (додати-визначення-до-оточення імя-символу значення-виразу (решта посилання-оточення)))))))

; Contract 6.0: Canon outranks the lexical alist even if a hostile/pre-existing
; environment contains the same text. Non-Canon names retain ordinary lookup.
(визначити знайти-значення-імені-в-лексичному-середовищі
  (функція (імя-символу посилання-оточення)
    (нехай ((посилання-тотожності (my-canon-identity імя-символу)))
      (за-умовою
        ((my-canon-callable-identity? посилання-тотожності) (my-primitive посилання-тотожності))
        ((my-canon-name? імя-символу) (my-canon-binding-error імя-символу))
        
        ((атом? посилання-оточення)  (my-default-binding імя-символу))
        ((my-shared-frame-binding? (перше посилання-оточення))
         (за-умовою
           ((ім'я-зв'язане-в-кадрі? імя-символу (решта (перше посилання-оточення)))
            (знайти-значення-імені-в-рамці імя-символу (решта (перше посилання-оточення))))
           (так (знайти-значення-імені-в-лексичному-середовищі імя-символу (решта посилання-оточення)))))
        ((тотожне? (перше (перше посилання-оточення)) імя-символу) (решта (перше посилання-оточення)))
        (так (знайти-значення-імені-в-лексичному-середовищі імя-символу (решта посилання-оточення)))))))

(визначити ім'я-визначене-в-оточенні?
  (функція (імя-символу посилання-оточення)
    (за-умовою
      ((my-canon-name? імя-символу) так)
      
      ((атом? посилання-оточення)  ні)
      ((my-shared-frame-binding? (перше посилання-оточення))
       (за-умовою
         ((ім'я-зв'язане-в-кадрі? імя-символу (решта (перше посилання-оточення))) так)
         (так (ім'я-визначене-в-оточенні? імя-символу (решта посилання-оточення)))))
      ((тотожне? (перше (перше посилання-оточення)) імя-символу) так)
      (так (ім'я-визначене-в-оточенні? імя-символу (решта посилання-оточення))))))

(визначити my-primitive?
  (функція (значення-виразу)
    (за-умовою
      
      ((атом? значення-виразу)  ні)
      (так (тотожне? (перше значення-виразу) (як-є primitive))))))

; UnknownSymbol belongs to name resolution, not application. A symbol produced
; as a value (for example by quote) is not an unresolved lookup and therefore
; must later fail as not-callable/Type if placed in operator position.
;
; `symbol?` itself is language-owned in core.lisp, derived without a Rust builtin,
; so this distinction adds no primitive to the closed Canon.
; This predicate crosses a D3:110 COND boundary: always yield the
; exact one-bit D1 result. () is data, never an implicit false predicate.
(визначити визначити-невирішене-ім'я-в-оточенні?
  (функція (імя-символу посилання-оточення)
    (за-умовою
      ((символ? імя-символу)
       (за-умовою
         ((тотожне? імя-символу так) ні)
         ((my-canon-name? імя-символу) ні)
         ((ім'я-визначене-в-оточенні? імя-символу посилання-оточення) ні)
         ((my-primitive? (my-default-binding імя-символу)) ні)
         (так так)))
      (так ні))))

(визначити my-macro?
  (функція (значення-виразу)
    (за-умовою
      
      ((атом? значення-виразу) ні)
      (так (тотожне? (перше значення-виразу) (як-є macro))))))

(визначити це-замикання?
  (функція (значення-виразу)
    (за-умовою
      
      ((атом? значення-виразу) ні)
      (так (тотожне? (перше значення-виразу) (як-є closure))))))

; A recursive closure is finite Lisp data. It does not require a cyclic host
; Environment. At call time my-apply reconstructs the one self-binding that
; the function needs. Contract 6 guarantees that this name is never Canon.
;
; Shape:
;   (recursive-closure name params body captured-env)
(визначити це-рекурсивне-замикання?
  (функція (значення-виразу)
    (за-умовою
      
      ((атом? значення-виразу) ні)
      (так (тотожне? (перше значення-виразу) (як-є recursive-closure))))))

; A mutually-recursive group is also finite Lisp data. Every member stores the
; same raw group and captured outer environment; my-apply reconstructs the
; group's bindings at call time rather than relying on a cyclic host object.
;
; Shape:
;   (recursive-group-closure name params body group captured-env)
(визначити це-замикання-рекурсивної-групи?
  (функція (значення-виразу)
    (за-умовою
      ((атом? значення-виразу) ні)
      (так (тотожне? (перше значення-виразу) (як-є recursive-group-closure))))))

(визначити перевірити-форму-лямбда?
  (функція (форма)
    (за-умовою
      ((атом? форма)  ні)
      ((атом? (перше форма))  (my-lambda-name? (перше форма)))
      (так ні))))

(визначити визначення-лямбди-на-верхньому-рівні?
  (функція (форма)
    (за-умовою
      ((атом? форма)  ні)
      ((my-define-name? (перше форма))
       (за-умовою
         ((my-canon-name? (друге форма)) ні)
