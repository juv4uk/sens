      (так (тотожне? (перше значення-виразу) (як-є primitive))))))

; Помилка UnknownSymbol стосується розв'язання імені, а не застосування.
; Символ, одержаний як значення (зокрема через цитування), не є
; нерозв'язаним іменем. У позиції виклику він має дати помилку типу.
;
; Предикат symbol? визначено в самій мові (core.lisp), без нового примітива Rust.
; Цей предикат перетинає межу COND домену Д3: повертаємо точне значення Д1.
; Порожній список () є даними, а не прихованою хибністю.
(визначити визначити-невирішене-ім'я-в-оточенні?
  (функція (імя-символу посилання-оточення)
    (за-умовою
      ((символ? імя-символу)
       (за-умовою
         ((тотожне? імя-символу так) ні)
         ((канонічне-ім'я-форми? імя-символу) ні)
         ((ім'я-визначене-в-оточенні? імя-символу посилання-оточення) ні)
         ((це-примітив? (типове-зв'язування-імені імя-символу)) ні)
         (так так)))
      (так ні))))

; Канонічні значення протокольних міток замикань.
