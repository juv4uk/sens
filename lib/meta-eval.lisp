; Перевірка параметрів лямбди належить синтаксичній семантиці,
; а не семантиці застосування.
; Договір 6 доповнює структурні перевірки відмовою для імен Канону.
(визначити чи-є-імя-серед-імен?
  (функція (імя-символу імена)
    (за-умовою
      ((атом? імена)  ні)
      ((тотожне? імя-символу (перше імена)) так)
      (так (чи-є-імя-серед-імен? імя-символу (решта імена))))))

(визначити помилка-параметрів-лямбди-у-списку
  (функція (параметри зустрінуті-імена)
    (за-умовою
      
      ((атом? параметри)  (за-умовою
         ((тотожне? параметри (як-є ())) (як-є ()))
         ((символ? параметри)
          (за-умовою
            ((канонічне-ім'я-форми? параметри)
             (список (як-є canonical-parameter) параметри))
            ((чи-є-імя-серед-імен? параметри зустрінуті-імена)
             (список (як-є duplicate-parameter) параметри))
            ))
         (так (список (як-є invalid-rest) параметри))))
      ((символ? (перше параметри))
       (за-умовою
         ((канонічне-ім'я-форми? (перше параметри))
          (список (як-є canonical-parameter) (перше параметри)))
         ((чи-є-імя-серед-імен? (перше параметри) зустрінуті-імена)
          (список (як-є duplicate-parameter) (перше параметри)))
         (так
          (помилка-параметрів-лямбди-у-списку
            (решта параметри)
            (сполучити (перше параметри) зустрінуті-імена)))))
      (так (список (як-є non-symbol-parameter) (перше параметри))))))

(визначити перевірити-параметри-лямбди
  (функція (параметри)
    (за-умовою
      
      ((атом? параметри)  (за-умовою
         ((тотожне? параметри (як-є ())) (як-є ()))
         ((символ? параметри)
          (за-умовою
            ((канонічне-ім'я-форми? параметри)
             (список (як-є canonical-parameter) параметри))
            ))
         (так (список (як-є invalid-parameters) параметри))))
      (так (помилка-параметрів-лямбди-у-списку параметри (як-є ()))))))

(визначити помилка-форми-лямбди
  (функція (проблема)
    (створити-структуровану-помилку
      (як-є invalid-form)
      (сполучити (як-є lambda-parameters) проблема))))

(визначити створити-лексичне-замикання-або-повернути-структуровану-помилку
  (функція (параметри тіло-функції посилання-оточення)
    (нехай ((проблема (перевірити-параметри-лямбди параметри)))
      (за-умовою
        
        ((атом? проблема)  (список (як-є closure) параметри тіло-функції посилання-оточення))
        (так (помилка-форми-лямбди проблема))))))

; Повертаємо перший некоректний список параметрів
; у взаєморекурсивній групі верхнього рівня.
; Визначення з іменами Канону до групи не потрапляють:
; предикат форми лямбда-визначення спершу спрямовує їх
; до звичайного відхилення верхньорівневої форми.
(визначити помилка-групи-визначень-лямбди
  (функція (форми)
    (за-умовою
      
      ((атом? форми)  (як-є ()))
      (так
       (нехай ((проблема
               (перевірити-параметри-лямбди (друге (третє (перше форми))))))
         (за-умовою
           
           ((атом? проблема)  (помилка-групи-визначень-лямбди (решта форми)))
           (так проблема)))))))

; Зв'язування параметрів застосовується лише після успішної перевірки.
; Арність і допустимість імен, зарезервованих Каноном, уже встановлено.
(визначити зв'язати-аргументи-з-лямбда-параметрами
  (функція (параметри одержані-аргументи посилання-оточення)
    (за-умовою
      
      ((атом? параметри)  (за-умовою
         ((тотожне? параметри (як-є ())) посилання-оточення)
         (так (сполучити (сполучити параметри одержані-аргументи) посилання-оточення))))
      (так (сполучити (сполучити (перше параметри) (перше одержані-аргументи))
               (зв'язати-аргументи-з-лямбда-параметрами (решта параметри) (решта одержані-аргументи) посилання-оточення))))))

(визначити обчислити-аргументи-з-явним-успіхом-або-помилкою
  (функція (вирази посилання-оточення)
    (за-умовою
      
      ((атом? вирази)  (власний-результат-успіх (як-є ())))
      (так
       (нехай ((результат-голови (обчислити-вираз-з-наслідком (перше вирази) посилання-оточення)))
         (за-умовою
           ((це-результат-невдалого-обчислення? результат-голови) результат-голови)
           (так
            (нехай ((результат-решти (обчислити-аргументи-з-явним-успіхом-або-помилкою (решта вирази) посилання-оточення)))
              (за-умовою
                ((це-результат-невдалого-обчислення? результат-решти) результат-решти)
                (так
                 (власний-результат-успіх
                   (сполучити
                     (решта результат-голови)
                     (решта результат-решти)))))))))))))

(визначити обчислити-список-мета
  (функція (вирази посилання-оточення)
    (решта (обчислити-аргументи-з-явним-успіхом-або-помилкою вирази посилання-оточення))))

; D10:0101100100: обчислювати всі форми тіла зліва направо.
; Остання успішна форма дає результат; перший збій завершує виконання.
; Умова лише одна для останньої форми: хвіст має бути атомарно порожнім.
(визначити обчислити-послідовне-тіло-з-раннім-збоєм
  (функція (тіло-функції посилання-оточення)
    (за-умовою
      ((атом? (решта тіло-функції))
       (обчислити-вираз-з-наслідком (перше тіло-функції) посилання-оточення))
      (так
       (нехай ((перший-результат
                 (обчислити-вираз-з-наслідком (перше тіло-функції) посилання-оточення)))
         (за-умовою
           ((це-результат-невдалого-обчислення? перший-результат)
            перший-результат)
           (так
            (обчислити-послідовне-тіло-з-раннім-збоєм
              (решта тіло-функції) посилання-оточення))))))))

(визначити обчислити-тіло-мета
  (функція (тіло-функції посилання-оточення)
    (решта (обчислити-послідовне-тіло-з-раннім-збоєм тіло-функції посилання-оточення))))

(визначити має-перехідну-гілку-за-умовою?
  (функція (гілки-умов)
    (за-умовою
      
      ((атом? гілки-умов) ні)
      ((хибне? (атом? (перше гілки-умов))) (має-перехідну-гілку-за-умовою? (решта гілки-умов)))
      ((атом? (перше гілки-умов))  (має-перехідну-гілку-за-умовою? (решта гілки-умов)))
      ((тотожне? (довжина (перше гілки-умов)) 2)  так)
      (так (має-перехідну-гілку-за-умовою? (решта гілки-умов))))))

(визначити режим-результату-за-умовою
  (функція (гілки-умов посилання-оточення режим-сумісності-міграції?)
    (за-умовою
      
      ((атом? гілки-умов)  (за-умовою
         (режим-сумісності-міграції? (власний-результат-успіх (як-є ())))
         (так
          (власний-результат-невдача
            (створити-структуровану-помилку (як-є unsatisfied-conditional) (як-є за-умовою))))))
      (так
       (нехай ((гілка-умови (перше гілки-умов)))
         (за-умовою
           ; #217: обчислюємо лише запит. Очікуваний результат уже є даними
           ; інтерпретованої програми, тому його не можна виконувати як код.
           ; Спершу порівнюємо результат структурно, потім виконуємо гілку.
           ((тотожне? (довжина гілка-умови) 3) 
            (нехай ((результат-перевірки (обчислити-вираз-з-наслідком (перше гілка-умови) посилання-оточення)))
              (за-умовою
                ((це-результат-невдалого-обчислення? результат-перевірки) результат-перевірки)
                ((однакові? (решта результат-перевірки) (друге гілка-умови))
                 
                 (обчислити-вираз-з-наслідком (третє гілка-умови) посилання-оточення))
                ((хибне? (однакові? (решта результат-перевірки) (друге гілка-умови)))
                 (режим-результату-за-умовою
                   (решта гілки-умов) посилання-оточення режим-сумісності-міграції?)))))
           ; Історичні двопольові гілки залишено тільки для міграції
           ; у відповідності до чинного обчислювача.
           ; Після переходу викликачів на явне зіставлення результатів
           ; цю тимчасову стару істинність слід усунути.
           ((тотожне? (довжина гілка-умови) 2) 
            (нехай ((результат-перевірки (обчислити-вираз-з-наслідком (перше гілка-умови) посилання-оточення)))
              (за-умовою
                ((це-результат-невдалого-обчислення? результат-перевірки) результат-перевірки)
                ((решта результат-перевірки)
                 (обчислити-вираз-з-наслідком (друге гілка-умови) посилання-оточення))
                (так
                 (режим-результату-за-умовою
                   (решта гілки-умов) посилання-оточення режим-сумісності-міграції?)))))
           (так
            (власний-результат-невдача
              (створити-структуровану-помилку
                (як-є invalid-form)
                (список (як-є cond-clause) гілка-умови))))))))))

(визначити результат-за-умовою
  (функція (гілки-умов посилання-оточення)
    (режим-результату-за-умовою
      гілки-умов посилання-оточення (має-перехідну-гілку-за-умовою? гілки-умов))))

(визначити обчислити-гілки-за-умовою
  (функція (гілки-умов посилання-оточення)
    (решта (результат-за-умовою гілки-умов посилання-оточення))))

(визначити взяти-групу-лямбда-визначень
  (функція (форми)
    (за-умовою
      
      ((атом? форми)  (як-є ()))
      ((визначення-лямбди-на-верхньому-рівні? (перше форми))
       (сполучити (перше форми)
             (взяти-групу-лямбда-визначень (решта форми))))
      )))

(визначити відкинути-групу-лямбда-визначень
  (функція (форми)
    (за-умовою
      
      ((атом? форми)  (як-є ()))
      ((визначення-лямбди-на-верхньому-рівні? (перше форми))
       (відкинути-групу-лямбда-визначень (решта форми)))
      (так форми))))

(визначити створити-замикання-взаєморекурсивної-групи
  (функція (форма група захоплене-оточення)
    (нехай ((форма-лямбди (третє форма)))
      (список (як-є recursive-group-closure)
            (друге форма)
            (друге форма-лямбди)
            (решта (решта форма-лямбди))
            група
            захоплене-оточення))))

; Під час застосування відновлюємо учасників сильно зв'язаної групи
; як лексичні зв'язування навколо оновленого спільного кадру.
; Так зберігається скінченне представлення взаємної рекурсії.
(визначити додати-зв'язки-в-оточення-рекурсивної-групи
  (функція (форми група захоплене-оточення накопичувач)
    (за-умовою
      
      ((атом? форми)  накопичувач)
      (так
       (нехай ((форма (перше форми)))
         (додати-зв'язки-в-оточення-рекурсивної-групи
           (решта форми)
           група
           захоплене-оточення
           (сполучити
             (сполучити (друге форма)
                   (створити-замикання-взаєморекурсивної-групи форма група захоплене-оточення))
             накопичувач)))))))

(визначити побудувати-лексичні-зв'язки-рекурсивної-групи
  (функція (група захоплене-оточення)
    (додати-зв'язки-в-оточення-рекурсивної-групи група група захоплене-оточення захоплене-оточення)))

; Під час встановлення програми учасники взаєморекурсивної групи
; є визначеннями верхнього рівня, тому належать спільному кадру.
; Вони не стають лексичним префіксом, який наступні замикання
; могли б захопити як застарілий знімок оточення.
(визначити встановити-зв'язування-групи-в-оточення
  (функція (форми група захоплене-оточення накопичувач)
    (за-умовою
      
      ((атом? форми)  накопичувач)
      (так
       (нехай ((форма (перше форми)))
         (встановити-зв'язування-групи-в-оточення
           (решта форми)
           група
           захоплене-оточення
           (додати-визначення-до-оточення
             (друге форма)
             (створити-замикання-взаєморекурсивної-групи форма група захоплене-оточення)
             накопичувач)))))))

(визначити встановити-взаєморекурсивні-замикання
  (функція (група захоплене-оточення)
    (встановити-зв'язування-групи-в-оточення група група захоплене-оточення захоплене-оточення)))

; Оточення викликача необов'язкове лише для сумісності
; з історичною експериментальною обгорткою meta-eval-mutual (назва протоколу).
; Основний обчислювач метавиразів передає його завжди.
; Воно лише оновлює спільну позначку верхнього рівня в захопленому оточенні.
; Внутрішнє застосування повертає оболонку результату, тому помилка
; обчислювача не плутається зі звичайними даними форми `(error ...)`.
(визначити застосувати-функцію-з-наслідком
  (функція (ціль-виклику аргументи оточення-виклику)
    (за-умовою
      
      ((атом? ціль-виклику)  (власний-результат-невдача (створити-структуровану-помилку (як-є not-callable) ціль-виклику)))
      ((це-примітив? ціль-виклику)
       (власний-результат-успіх (застосувати-примітив-мета (друге ціль-виклику) аргументи)))
      ((це-замикання? ціль-виклику)
       (за-умовою
         ((арність-відповідає-аргументам? (друге ціль-виклику) аргументи)
          (обчислити-послідовне-тіло-з-раннім-збоєм
            (третє ціль-виклику)
            (зв'язати-аргументи-з-лямбда-параметрами
              (друге ціль-виклику)
              аргументи
              (оновити-спільний-кадр-замикання
                (четверте ціль-виклику)
                оточення-виклику))))
         (так
          (власний-результат-невдача (помилка-арності-мета (друге ціль-виклику) аргументи)))))
      ((це-рекурсивне-замикання? ціль-виклику)
       (за-умовою
         ((арність-відповідає-аргументам? (третє ціль-виклику) аргументи)
          (нехай ((захоплений-кадр
                  (оновити-спільний-кадр-замикання
                    (п'ятий ціль-виклику)
                    оточення-виклику)))
            (нехай ((власне-оточення
                    (сполучити (сполучити (друге ціль-виклику) ціль-виклику)
                          захоплений-кадр)))
              (обчислити-послідовне-тіло-з-раннім-збоєм
                (четверте ціль-виклику)
                (зв'язати-аргументи-з-лямбда-параметрами
                  (третє ціль-виклику)
                  аргументи
                  власне-оточення)))))
         (так
          (власний-результат-невдача (помилка-арності-мета (третє ціль-виклику) аргументи)))))
      ((це-замикання-рекурсивної-групи? ціль-виклику)
       (за-умовою
         ((арність-відповідає-аргументам? (третє ціль-виклику) аргументи)
          (нехай ((захоплений-кадр
                  (оновити-спільний-кадр-замикання
                    (шосте-значення-групи ціль-виклику)
                    оточення-виклику)))
            (нехай ((оточення-групи
                    (побудувати-лексичні-зв'язки-рекурсивної-групи (п'ятий ціль-виклику) захоплений-кадр)))
              (обчислити-послідовне-тіло-з-раннім-збоєм
                (четверте ціль-виклику)
                (зв'язати-аргументи-з-лямбда-параметрами
                  (третє ціль-виклику)
                  аргументи
                  оточення-групи)))))
         (так
          (власний-результат-невдача (помилка-арності-мета (третє ціль-виклику) аргументи)))))
      ((це-макрос? ціль-виклику)
       (за-умовою
         ((арність-відповідає-аргументам? (друге ціль-виклику) аргументи)
          (обчислити-послідовне-тіло-з-раннім-збоєм
            (третє ціль-виклику)
            (зв'язати-аргументи-з-лямбда-параметрами
              (друге ціль-виклику)
              аргументи
              (оновити-спільний-кадр-замикання
                (четверте ціль-виклику)
                оточення-виклику))))
         (так
          (власний-результат-невдача (помилка-арності-мета (друге ціль-виклику) аргументи)))))
      (так
       (власний-результат-невдача (створити-структуровану-помилку (як-є not-callable) ціль-виклику))))))

(визначити застосувати-функцію-мета
  (функція (ціль-виклику аргументи . решта-оточення-виклику)
    (нехай ((оточення-виклику
            (за-умовою
              
              ((атом? решта-оточення-виклику)  (як-є ()))
              (так (перше решта-оточення-виклику)))))
      (решта (застосувати-функцію-з-наслідком ціль-виклику аргументи оточення-виклику)))))

; У звичайному застосуванні спочатку обчислюємо оператор,
; потім аргументи зліва направо.
; Рекурсивне обчислення лишається в каналі результатів,
; доки застосування не поверне значення або першу помилку.
(визначити результат-застосування-функції-мета
  (функція (вираз посилання-оточення)
    (нехай ((результат-функції (обчислити-вираз-з-наслідком (перше вираз) посилання-оточення)))
      (за-умовою
        ((це-результат-невдалого-обчислення? результат-функції) результат-функції)
        (так
         (нехай ((ціль-виклику (решта результат-функції)))
           (за-умовою
             ((це-макрос? ціль-виклику)
              (за-умовою
                ((арність-відповідає-аргументам? (друге ціль-виклику) (решта вираз))
                 (нехай ((результат-розгортання
                         (застосувати-функцію-з-наслідком ціль-виклику (решта вираз) посилання-оточення)))
                   (за-умовою
                     ((це-результат-невдалого-обчислення? результат-розгортання) результат-розгортання)
                     (так
                      (обчислити-вираз-з-наслідком
                        (решта результат-розгортання)
                        посилання-оточення)))))
                (так
                 (власний-результат-невдача
                   (помилка-арності-мета (друге ціль-виклику) (решта вираз))))))
             (так
              (нехай ((результат-аргументів
                      (обчислити-аргументи-з-явним-успіхом-або-помилкою (решта вираз) посилання-оточення)))
                (за-умовою
                  ((це-результат-невдалого-обчислення? результат-аргументів) результат-аргументів)
                  (так
                   (застосувати-функцію-з-наслідком
                     ціль-виклику
                     (решта результат-аргументів)
                     посилання-оточення))))))))))))

(визначити обчислити-вираз-з-наслідком
  (функція (вираз посилання-оточення)
    (за-умовою
      ((атом? вираз)  (за-умовою
         ((визначити-невирішене-ім'я-в-оточенні? вираз посилання-оточення)
          (власний-результат-невдача
            (створити-структуровану-помилку (як-є unbound-symbol) вираз)))
         (так
          (власний-результат-успіх (знайти-значення-імені-в-лексичному-середовищі вираз посилання-оточення)))))
      ((хибне? (атом? (перше вираз))) (за-умовою
         ((ім'я-форми-як-є? (перше вираз))
          (власний-результат-успіх (друге вираз)))
         ((ім'я-форми-за-умовою? (перше вираз))
          (результат-за-умовою (решта вираз) посилання-оточення))
         ((ім'я-форми-лямбда? (перше вираз))
          (нехай ((проблема (перевірити-параметри-лямбди (друге вираз))))
            (за-умовою
              
              ((атом? проблема)  (власний-результат-успіх
                 (створити-лексичне-замикання-або-повернути-структуровану-помилку
                   (друге вираз)
                   (решта (решта вираз))
                   посилання-оточення)))
              (так
               (власний-результат-невдача
                 (помилка-форми-лямбди проблема))))))
         (так
          (результат-застосування-функції-мета вираз посилання-оточення))))
      ((атом? (перше вираз))  (за-умовою
         ((ім'я-форми-як-є? (перше вираз))
          (власний-результат-успіх (друге вираз)))
         ((ім'я-форми-за-умовою? (перше вираз))
          (результат-за-умовою (решта вираз) посилання-оточення))
         ((ім'я-форми-лямбда? (перше вираз))
          (нехай ((проблема (перевірити-параметри-лямбди (друге вираз))))
            (за-умовою
              
              ((атом? проблема)  (власний-результат-успіх
                 (створити-лексичне-замикання-або-повернути-структуровану-помилку
                   (друге вираз)
                   (решта (решта вираз))
                   посилання-оточення)))
              (так
               (власний-результат-невдача
                 (помилка-форми-лямбди проблема))))))
         (так
          (результат-застосування-функції-мета вираз посилання-оточення))))
      (так
       (результат-застосування-функції-мета вираз посилання-оточення)))))

(визначити обчислити-мета-вираз
  (функція (вираз посилання-оточення)
    (решта (обчислити-вираз-з-наслідком вираз посилання-оточення))))

; Верхньорівневі форми передають оточення явно.
; Визначення функції й макроса повертають пару (нове-оточення . значення).
; Послідовність оновлює спільний кадр ADR-009; окремий виклик
; без його позначки зберігає звичайний асоціативний список.
; Договір 6 відхиляє визначення імен Канону до створення значення.
(визначити обчислити-форму-та-оновити-оточення
  (функція (форма посилання-оточення)
    (за-умовою
      ((атом? форма)  (сполучити посилання-оточення (обчислити-мета-вираз форма посилання-оточення)))
      ((ім'я-форми-визначити? (перше форма))
       (за-умовою
         ((канонічне-ім'я-форми? (друге форма))
          (сполучити посилання-оточення (помилка-незмінності-канонічного-імені (друге форма))))
         (так
          (нехай ((форма-значення (третє форма)))
            (за-умовою
              ((перевірити-форму-лямбда? форма-значення)
               (нехай ((проблема (перевірити-параметри-лямбди (друге форма-значення))))
                 (за-умовою
                   
                   ((атом? проблема)  (нехай ((значення-виразу
                            (список (як-є recursive-closure)
                                  (друге форма)
                                  (друге форма-значення)
                                  (решта (решта форма-значення))
                                  посилання-оточення)))
                      (сполучити
                        (додати-визначення-до-оточення (друге форма) значення-виразу посилання-оточення)
                        значення-виразу)))
                   (так (сполучити посилання-оточення (помилка-форми-лямбди проблема))))))
              (так
               (нехай ((значення-виразу (обчислити-мета-вираз форма-значення посилання-оточення)))
                 (сполучити
                   (додати-визначення-до-оточення (друге форма) значення-виразу посилання-оточення)
                   значення-виразу))))))))
      ((ім'я-форми-визначити-макрос? (перше форма))
       (за-умовою
         ((канонічне-ім'я-форми? (друге форма))
          (сполучити посилання-оточення (помилка-незмінності-канонічного-імені (друге форма))))
         (так
          (нехай ((значення-макросу
                  (список (як-є macro)
                        (третє форма)
                        (решта (решта (решта форма)))
                        посилання-оточення)))
            (сполучити
              (додати-визначення-до-оточення (друге форма) значення-макросу посилання-оточення)
              значення-макросу)))))
      (так (сполучити посилання-оточення (обчислити-мета-вираз форма посилання-оточення))))))

; Залежності верхньорівневих визначень залишаються даними Lisp.
; Запис графа: (ім'я залежності). Враховуємо лише вільні посилання
; на імена тієї самої неперервної групи визначень.
(визначити ім'я-зв'язане-формальними-параметрами?
  (функція (імя-символу параметри)
    (за-умовою
      
      ((атом? параметри)  (за-умовою
         ((тотожне? параметри (як-є ())) ні)
         ((тотожне? параметри імя-символу) так)
         (так ні)))
      ((тотожне? (перше параметри) імя-символу) так)
      (так (ім'я-зв'язане-формальними-параметрами? імя-символу (решта параметри))))))

(визначити форма-посилається-на-ім'я?
  (функція (форми імя-символу)
    (за-умовою
      
      ((атом? форми) ні)
      ((вільне-посилання-у-формі-з-урахуванням-цитат-та-затінення? (перше форми) імя-символу) так)
      (так (форма-посилається-на-ім'я? (решта форми) імя-символу)))))

(визначити вільне-посилання-у-формі-з-урахуванням-цитат-та-затінення?
  (функція (форма імя-символу)
    (за-умовою
      
      ((атом? форма)  (за-умовою
         ((символ? форма) (тотожне? форма імя-символу))
         (так ні)))
      ((хибне? (атом? (перше форма))) (за-умовою
         ; Цитовані дані не створюють лексичної залежності.
         ((ім'я-форми-як-є? (перше форма)) ні)
         ; Вкладена лямбда може затінити ім'я верхнього рівня.
         ((ім'я-форми-лямбда? (перше форма))
          (за-умовою
            ((ім'я-зв'язане-формальними-параметрами? імя-символу (друге форма)) ні)
            (так (форма-посилається-на-ім'я? (решта (решта форма)) імя-символу))))
         (так (форма-посилається-на-ім'я? форма імя-символу))))
      ((атом? (перше форма))  (за-умовою
         ; Цитовані дані не створюють лексичної залежності.
         ((ім'я-форми-як-є? (перше форма)) ні)
         ; Вкладена лямбда може затінити ім'я верхнього рівня.
         ((ім'я-форми-лямбда? (перше форма))
          (за-умовою
            ((ім'я-зв'язане-формальними-параметрами? імя-символу (друге форма)) ні)
            (так (форма-посилається-на-ім'я? (решта (решта форма)) імя-символу))))
         (так (форма-посилається-на-ім'я? форма імя-символу))))
      (так (форма-посилається-на-ім'я? форма імя-символу)))))

(визначити визначення-посилається-на-ім'я?
  (функція (форма імя-символу)
    (нехай ((форма-лямбди (третє форма)))
      (за-умовою
        ((ім'я-зв'язане-формальними-параметрами? імя-символу (друге форма-лямбди)) ні)
        (так (форма-посилається-на-ім'я? (решта (решта форма-лямбди)) імя-символу))))))

(визначити імена-визначень-лямбди
  (функція (форми)
    (за-умовою
      
      ((атом? форми)  (як-є ()))
      (так (сполучити (друге (перше форми))
               (імена-визначень-лямбди (решта форми)))))))

(визначити залежності-визначення-серед-кандидатів
  (функція (форма кандидати)
    (за-умовою
      
      ((атом? кандидати)  (як-є ()))
      ((визначення-посилається-на-ім'я? форма (перше кандидати))
       (сполучити (перше кандидати)
             (залежності-визначення-серед-кандидатів форма (решта кандидати))))
      (так (залежності-визначення-серед-кандидатів форма (решта кандидати))))))

(визначити побудувати-граф-залежностей-за-іменами
  (функція (форми імена)
    (за-умовою
      
      ((атом? форми)  (як-є ()))
      (так
       (сполучити
         (список
           (друге (перше форми))
           (залежності-визначення-серед-кандидатів (перше форми) імена))
         (побудувати-граф-залежностей-за-іменами (решта форми) імена))))))

(визначити побудувати-граф-залежностей-визначень
  (функція (форми)
    (нехай ((імена (імена-визначень-лямбди форми)))
      (побудувати-граф-залежностей-за-іменами форми імена))))

(визначити залежності-графа
  (функція (імя-символу граф)
    (за-умовою
      
      ((атом? граф)  (як-є ()))
      ((тотожне? імя-символу (перше (перше граф))) (друге (перше граф)))
      (так (залежності-графа імя-символу (решта граф))))))

(визначити досяжність-залежностей-графа?
  (функція (залежності ціль-операції граф відвідані)
    (за-умовою
      
      ((атом? залежності) ні)
      ((тотожне? (перше залежності) ціль-операції) так)
      ((чи-є-імя-серед-імен? (перше залежності) відвідані)
       (досяжність-залежностей-графа?
         (решта залежності) ціль-операції граф відвідані))
      ((вузол-графа-досяжний?
         (перше залежності)
         ціль-операції
         граф
         (сполучити (перше залежності) відвідані))
       так)
      (так
       (досяжність-залежностей-графа?
         (решта залежності) ціль-операції граф відвідані)))))

(визначити вузол-графа-досяжний?
  (функція (початковий-вузол ціль-операції граф відвідані)
    (досяжність-залежностей-графа?
      (залежності-графа початковий-вузол граф)
      ціль-операції
      граф
      (сполучити початковий-вузол відвідані))))

; Сильно зв'язана компонента містить усі імена, взаємно досяжні
; з поточного імені. Воно завжди належить власній компоненті,
; навіть без циклу. Лише компоненти із двох або більше учасників
; використовують замикання взаємної рекурсії.
(визначити імена-сильно-зв'язаної-компоненти
  (функція (імя-символу кандидати граф)
    (за-умовою
      
      ((атом? кандидати)  (як-є ()))
      ((тотожне? імя-символу (перше кандидати))
       (сполучити (перше кандидати)
             (імена-сильно-зв'язаної-компоненти імя-символу (решта кандидати) граф)))
      ((вузол-графа-досяжний? імя-символу (перше кандидати) граф (як-є ()))
       (за-умовою
         ((вузол-графа-досяжний? (перше кандидати) імя-символу граф (як-є ()))
          (сполучити (перше кандидати)
                (імена-сильно-зв'язаної-компоненти імя-символу (решта кандидати) граф)))
         (так (імена-сильно-зв'язаної-компоненти імя-символу (решта кандидати) граф))))
      (так (імена-сильно-зв'язаної-компоненти імя-символу (решта кандидати) граф)))))

(визначити відібрати-визначення-іменованої-групи
  (функція (форми імена)
    (за-умовою
      
      ((атом? форми)  (як-є ()))
      ((чи-є-імя-серед-імен? (друге (перше форми)) імена)
       (сполучити (перше форми)
             (відібрати-визначення-іменованої-групи (решта форми) імена)))
      (так (відібрати-визначення-іменованої-групи (решта форми) імена)))))

(визначити вилучити-з-блоку-визначення-заданих-імен
  (функція (форми імена)
    (за-умовою
      
      ((атом? форми)  (як-є ()))
      ((чи-є-імя-серед-імен? (друге (перше форми)) імена)
       (вилучити-з-блоку-визначення-заданих-імен (решта форми) імена))
      (так
       (сполучити (перше форми)
             (вилучити-з-блоку-визначення-заданих-імен (решта форми) імена))))))

(визначити останнє-ім'я-визначення-лямбди
  (функція (форми)
    (за-умовою
      ((хибне? (атом? (решта форми))) (друге (перше форми)))
      ((атом? (решта форми))  (друге (перше форми)))
      (так (останнє-ім'я-визначення-лямбди (решта форми))))))

(визначити обчислити-компоненти-лямбди
  (функція (форми граф посилання-оточення остаточне-імя)
    (за-умовою
      
      ((атом? форми)  (сполучити посилання-оточення (знайти-значення-імені-в-лексичному-середовищі остаточне-імя посилання-оточення)))
      (так
       (нехай ((імя-символу (друге (перше форми))))
         (нехай ((імена-компоненти
                 (імена-сильно-зв'язаної-компоненти
                   імя-символу
                   (імена-визначень-лямбди форми)
                   граф)))
           (за-умовою
              ; Одинарна компонента лишається на звичайному верхньому шляху:
              ; він уже створює скінченне замикання рекурсивного визначення
              ; і не вигадує неіснуючу групу взаємної рекурсії.
             ((хибне? (атом? (решта імена-компоненти))) (нехай ((результат-виразу (обчислити-форму-та-оновити-оточення (перше форми) посилання-оточення)))
                (обчислити-компоненти-лямбди
                  (решта форми)
                  граф
                  (перше результат-виразу)
                  остаточне-імя)))
             ((атом? (решта імена-компоненти))  (нехай ((результат-виразу (обчислити-форму-та-оновити-оточення (перше форми) посилання-оточення)))
                (обчислити-компоненти-лямбди
                  (решта форми)
                  граф
                  (перше результат-виразу)
                  остаточне-імя)))
             (так
              (нехай ((компонента
                      (відібрати-визначення-іменованої-групи форми імена-компоненти)))
                (нехай ((оточення-групи (встановити-взаєморекурсивні-замикання компонента посилання-оточення)))
                  (обчислити-компоненти-лямбди
                    (вилучити-з-блоку-визначення-заданих-імен форми імена-компоненти)
                    граф
                    оточення-групи
                    остаточне-імя)))))))))))

(визначити обчислити-блок-взаємних-визначень
  (функція (форми посилання-оточення)
    (нехай ((граф (побудувати-граф-залежностей-визначень форми))
          (остаточне-імя (останнє-ім'я-визначення-лямбди форми)))
      (обчислити-компоненти-лямбди форми граф посилання-оточення остаточне-імя))))

; Послідовність форм перевіряє неперервні групи верхньорівневих
; неканонічних лямбда-визначень і будує їхній граф залежностей.
; Лише сильно зв'язані компоненти з кількома учасниками
; отримують замикання взаємної рекурсії.
; Незалежні й однобічно залежні визначення залишаються поодинокими:
; близькість форм не є доказом рекурсії.
; Для непорожньої програми ADR-009 створює єдиний скінченний
; спільний кадр, повторно використаний у рекурсивних викликах.
; Порожня програма зберігає оточення без змін, як у свідку TASK-001.
(визначити обчислити-послідовність-форм
  (функція (форми посилання-оточення)
    (за-умовою
      ((атом? форми)  (сполучити посилання-оточення (як-є ())))
      (так
       (нехай ((оточення-програми (забезпечити-спільний-кадр посилання-оточення)))
         (за-умовою
           ((визначення-лямбди-на-верхньому-рівні? (перше форми))
            (нехай ((блок (взяти-групу-лямбда-визначень форми)))
              (нехай ((проблема (помилка-групи-визначень-лямбди блок)))
                (за-умовою
                  
                  ((атом? проблема)  (нехай ((решта-форм (відкинути-групу-лямбда-визначень форми)))
                     (нехай ((результат-блоку
                             (обчислити-блок-взаємних-визначень блок оточення-програми)))
                       (за-умовою
                         
                         ((атом? решта-форм)  результат-блоку)
                         (так
                          (обчислити-послідовність-форм
                            решта-форм
                            (перше результат-блоку)))))))
                  (так
                   (сполучити
                     оточення-програми
                     (помилка-форми-лямбди проблема)))))))
           (так
            (нехай ((результат-виразу (обчислити-форму-та-оновити-оточення (перше форми) оточення-програми)))
              (за-умовою
                
                ((атом? (решта форми))  результат-виразу)
                (так
                 (обчислити-послідовність-форм
                   (решта форми)
                   (перше результат-виразу))))))))))))

; «блок» у лексичному виразі — параметр, а не глобальне ім'я.
