; Метакруговий обчислювач СЕНС: український вхід читається як дані Ліспу.
;
; Межа володіння Каноном за контрактом 6.0:
; скінченні імена Канону 0+7 розпізнаються раніше за лексичне оточення
; метаобчислювача й не можуть бути параметрами чи локальними зв'язками. Викличні
; проєкції Канону стають значеннями-примітивами з канонічною тотожністю;
; як-є та за-умовою лишаються синтаксичними формами. Інші примітиви, зокрема
; математичні дії, залишаються затінюваними звичайними зв'язками оточення.
;
; Саму примітивну операцію виконує власний машинний механізм. Метаобчислювач задає пошук
; імен, пріоритет Канону, лексичне затінення, форму виклику, розгортання макросів,
; оточення замикань, ланцюгові порівняння, спільну верхньорівневу рамку,
; саморекурсивні й залежні взаємнорекурсивні визначення, варіативні й крапкові
; списки параметрів функцій, а також структуровані спостереження помилок.
;
; Це явний свідок самореалізації, а не постійно завантажуване ядро виконавця.
; Повна відповідність категорій і деталей помилок ще не доведена.

(визначити власний-примітив
  (функція (ім'я-символу)
    (список (як-є primitive) ім'я-символу)))

(визначити створити-структуровану-помилку
  (функція (вид подробиці)
    (список (як-є error) вид подробиці)))

; Внутрішній результат не можна підробити звичайними даними Ліспу: його мітка —
; тотожність машинного замикання, а не символ чи список, який можна відтворити
; через як-є або сполучити. Публічні обчислити-мета-вираз і застосувати-функцію-
; з-наслідком знімають цю оболонку на межі спостережуваного результату.
(визначити маркер-успішного-результату
  (функція (значення-виразу) значення-виразу))

(визначити маркер-невдалого-результату
  (функція (значення-виразу) значення-виразу))

(визначити власний-результат-успіх
  (функція (значення-виразу)
    (сполучити маркер-успішного-результату значення-виразу)))

(визначити власний-результат-невдача
  (функція (помилка)
    (сполучити маркер-невдалого-результату помилка)))

(визначити це-результат-невдалого-обчислення?
  (функція (результат-виразу)
    (за-умовою
      
      ((атом? результат-виразу)  ні)
      (так (тотожне? (перше результат-виразу) маркер-невдалого-результату)))))



; Ця скінченна таблиця зіставляє лише проєкції, потрібні Канону й цьому
; метаобчислювачу; вона не описує всю драбину. Належність перевіряємо за
; language-contract.lisp та чинними джерелами D1–24+. Ширина не виводиться з
; значення: однакові біти різних доменів зберігають різні тотожності.
(визначити поверхня-є-в-переліку?
  (функція (ім'я-символу кандидати)
    (за-умовою
      ((атом? кандидати) ні)
      ((тотожне? ім'я-символу (перше кандидати)) так)
      (так (поверхня-є-в-переліку? ім'я-символу (решта кандидати))))))

(визначити знайти-тотожність-за-поверхнею
  (функція (ім'я-символу)
    ; Лише явні проєкції, які цей обчислювач справді зіставляє з Каноном.
    ; Це не дозвіл виводити семантику з ширини або додавати резидентів.
    (за-умовою
      ((хибне? (атом? ім'я-символу)) (як-є ()))
      ((тотожне? ім'я-символу (як-є як-є)) (як-є як-є))
      ((тотожне? ім'я-символу (як-є атом?)) (як-є атом?))
      ((тотожне? ім'я-символу (як-є тотожне?)) (як-є тотожне?))
      ((тотожне? ім'я-символу (як-є сполучити)) (як-є сполучити))
      ((тотожне? ім'я-символу (як-є перше)) (як-є перше))
      ((тотожне? ім'я-символу (як-є решта)) (як-є решта))
      ((тотожне? ім'я-символу (як-є за-умовою)) (як-є за-умовою))
      ((тотожне? ім'я-символу (як-є функція)) (як-є функція))
      ((тотожне? ім'я-символу (як-є визначити)) (як-є визначити))
      ((тотожне? ім'я-символу (як-є визначити-макрос)) (як-є визначити-макрос))
      ((тотожне? ім'я-символу (як-є додати)) (як-є додати))
      ((тотожне? ім'я-символу (як-є відняти)) (як-є відняти))
      ((тотожне? ім'я-символу (як-є помножити)) (як-є помножити))
      ((тотожне? ім'я-символу (як-є менше?)) (як-є менше?))
      ((тотожне? ім'я-символу (як-є однакові?)) (як-є однакові?))
      ((тотожне? ім'я-символу (як-є більше?)) (як-є більше?))
      ((тотожне? ім'я-символу (як-є значення-у-текст)) (як-є значення-у-текст))
      ((тотожне? ім'я-символу (як-є текст-у-символ)) (як-є текст-у-символ))
      ((тотожне? ім'я-символу (як-є символ-у-текст)) (як-є символ-у-текст))
      (так (як-є ())))))

(визначити тотожність-відповідає-поверхні?
  (функція (ім'я-символу семантична-поверхня)
    (за-умовою
      ((хибне? (атом? ім'я-символу)) ні)
      ((тотожне? (знайти-тотожність-за-поверхнею ім'я-символу) семантична-поверхня) так)
      (так ні))))

; Канон — сім синтаксичних і примітивних форм, кожна зі своєю
; українською проєкцією. Жодна ширина не стискається до десяткового номера.
(визначити канонічна-семантична-тотожність
  (функція (ім'я-символу)
    (нехай ((поверхня (знайти-тотожність-за-поверхнею ім'я-символу)))
      (за-умовою
        ((тотожне? поверхня (як-є як-є)) (як-є як-є))
        ((тотожне? поверхня (як-є атом?)) (як-є атом?))
        ((тотожне? поверхня (як-є тотожне?)) (як-є тотожне?))
        ((тотожне? поверхня (як-є сполучити)) (як-є сполучити))
        ((тотожне? поверхня (як-є перше)) (як-є перше))
        ((тотожне? поверхня (як-є решта)) (як-є решта))
        ((тотожне? поверхня (як-є за-умовою)) (як-є за-умовою))
        (так (як-є ()))))))

(визначити канонічна-ідентичність
  (функція (ім'я-символу)
    (канонічна-семантична-тотожність ім'я-символу)))

(визначити ім'я-форми-лямбда?
  (функція (ім'я-символу)
    (тотожність-відповідає-поверхні? ім'я-символу (як-є функція))))

(визначити ім'я-форми-визначити?
  (функція (ім'я-символу)
    (тотожність-відповідає-поверхні? ім'я-символу (як-є визначити))))

(визначити ім'я-форми-визначити-макрос?
  (функція (ім'я-символу)
    (тотожність-відповідає-поверхні? ім'я-символу (як-є визначити-макрос))))

(визначити канонічне-ім'я-форми?
  (функція (ім'я-символу)
    (за-умовою
      ((хибне? (порожній? (канонічна-ідентичність ім'я-символу))) так)
      ((ім'я-форми-лямбда? ім'я-символу) так)
      ((ім'я-форми-визначити? ім'я-символу) так)
      ((ім'я-форми-визначити-макрос? ім'я-символу) так)
      (так ні))))

(визначити канонічна-виклична-тотожність?
  (функція (посилання-тотожності)
    (за-умовою
      ((тотожне? посилання-тотожності (як-є атом?)) так)
      ((тотожне? посилання-тотожності (як-є тотожне?)) так)
      ((тотожне? посилання-тотожності (як-є сполучити)) так)
      ((тотожне? посилання-тотожності (як-є перше)) так)
      ((тотожне? посилання-тотожності (як-є решта)) так)
      (так ні))))

(визначити ім'я-форми-як-є?
  (функція (ім'я-символу)
    (тотожне? (канонічна-ідентичність ім'я-символу) (як-є як-є))))

(визначити ім'я-форми-за-умовою?
  (функція (ім'я-символу)
    (тотожне? (канонічна-ідентичність ім'я-символу) (як-є за-умовою))))

(визначити помилка-незмінності-канонічного-імені
  (функція (ім'я-символу)
    (створити-структуровану-помилку
      (як-є invalid-form)
      (список (як-є canonical-name-immutable) ім'я-символу))))

; Кореневі примітиви містять канонічний український виконавчий об'єкт.
; Десятковий запис його бітів не стає значенням.
; Канон спочатку є синтаксисом.
(визначити типове-зв'язування-імені
  (функція (ім'я-символу)
    (нехай ((посилання-тотожності (канонічна-ідентичність ім'я-символу)))
      (за-умовою
        ((тотожне? ім'я-символу (як-є так)) (як-є так))
        ((тотожне? ім'я-символу (як-є ні)) (як-є ні))
        ((канонічна-виклична-тотожність? посилання-тотожності) (власний-примітив посилання-тотожності))
        ((канонічне-ім'я-форми? ім'я-символу) (помилка-незмінності-канонічного-імені ім'я-символу))
        ((тотожність-відповідає-поверхні? ім'я-символу (як-є додати)) (власний-примітив (як-є додати))
        )
        ((тотожність-відповідає-поверхні? ім'я-символу (як-є відняти)) (власний-примітив (як-є відняти)))
        ((тотожність-відповідає-поверхні? ім'я-символу (як-є помножити)) (власний-примітив (як-є помножити)))
        ((тотожність-відповідає-поверхні? ім'я-символу (як-є менше?)) (власний-примітив (як-є менше?)))
        ((тотожність-відповідає-поверхні? ім'я-символу (як-є однакові?)) (власний-примітив (як-є однакові?)))
        ((тотожність-відповідає-поверхні? ім'я-символу (як-є більше?)) (власний-примітив (як-є більше?)))
        ((тотожність-відповідає-поверхні? ім'я-символу (як-є значення-у-текст))
         (власний-примітив (як-є значення-у-текст)))
        ((тотожність-відповідає-поверхні? ім'я-символу (як-є текст-у-символ))
         (власний-примітив (як-є текст-у-символ)))
        (так ім'я-символу)))))

; ADR-009: спільний кадр визначень.
;
; Метациклічне оточення залишається скінченними даними Lisp. Прив'язка з
; несимвольним внутрішнім ключем 0 містить оновлюваний верхній кадр
; у звичайному асоціативному списку:
;
;   ((0 . ((latest . value) ...)) . lexical-outer-env)
;
; Імена користувацьких зв'язувань є символами, тому з маркером не збігаються.
; Локальні лексичні прив'язки стоять перед цим маркером.
; Під час виклику замикання оновлюється лише вміст спільного кадру:
; захоплені локальні прив'язки зберігаються. Це не динамічна область
; видимості й не циклічний об'єкт мови-господаря.
(визначити зв'язування-спільного-кадру?
  (функція (привязка)
    (за-умовою
      
      ((атом? привязка)  ні)
      (так (тотожне? (перше привязка) 0)))))

(визначити ім'я-зв'язане-в-кадрі?
  (функція (імя-символу кадр)
    (за-умовою
      
      ((атом? кадр)  ні)
      ((тотожне? (перше (перше кадр)) імя-символу) так)
      (так (ім'я-зв'язане-в-кадрі? імя-символу (решта кадр))))))

(визначити знайти-значення-імені-в-рамці
  (функція (імя-символу кадр)
    (за-умовою
      ((тотожне? (перше (перше кадр)) імя-символу) (решта (перше кадр)))
      (так (знайти-значення-імені-в-рамці імя-символу (решта кадр))))))

(визначити оточення-має-спільний-кадр?
  (функція (посилання-оточення)
    (за-умовою
      
      ((атом? посилання-оточення)  ні)
      ((зв'язування-спільного-кадру? (перше посилання-оточення)) так)
      (так (оточення-має-спільний-кадр? (решта посилання-оточення))))))

(визначити значення-спільного-кадру
  (функція (посилання-оточення)
    (за-умовою
      
      ((атом? посилання-оточення)  (як-є ()))
      ((зв'язування-спільного-кадру? (перше посилання-оточення)) (решта (перше посилання-оточення)))
      (так (значення-спільного-кадру (решта посилання-оточення))))))

(визначити забезпечити-спільний-кадр
  (функція (посилання-оточення)
    (за-умовою
      ((оточення-має-спільний-кадр? посилання-оточення) посилання-оточення)
      (так (сполучити (сполучити 0 (як-є ())) посилання-оточення)))))

(визначити замінити-спільний-кадр
  (функція (посилання-оточення кадр)
    (за-умовою
      
      ((атом? посилання-оточення)  посилання-оточення)
      ((зв'язування-спільного-кадру? (перше посилання-оточення))
       (сполучити (сполучити 0 кадр) (решта посилання-оточення)))
      (так
       (сполучити (перше посилання-оточення)
             (замінити-спільний-кадр (решта посилання-оточення) кадр))))))

(визначити оновити-спільний-кадр-замикання
  (функція (захоплене-оточення оточення-виклику)
    (за-умовою
      ((оточення-має-спільний-кадр? захоплене-оточення)
       (за-умовою
         ((оточення-має-спільний-кадр? оточення-виклику)
          (замінити-спільний-кадр
            захоплене-оточення
            (значення-спільного-кадру оточення-виклику)))
         (так захоплене-оточення)))
      (так захоплене-оточення))))

; За наявності спільного кадру нове визначення оновлює його.
; Поза обчисленням послідовності форм розширюємо звичайний список зв'язувань.
; Тому безпосереднє обчислення форми з оновленням оточення
; зберігає ту саму семантику.
(визначити додати-визначення-до-оточення
  (функція (імя-символу значення-виразу посилання-оточення)
    (за-умовою
      
      ((атом? посилання-оточення)  (сполучити (сполучити імя-символу значення-виразу) посилання-оточення))
      ((зв'язування-спільного-кадру? (перше посилання-оточення))
       (сполучити
         (сполучити 0
               (сполучити (сполучити імя-символу значення-виразу)
                     (решта (перше посилання-оточення))))
         (решта посилання-оточення)))
      (так
       (сполучити (перше посилання-оточення)
             (додати-визначення-до-оточення імя-символу значення-виразу (решта посилання-оточення)))))))

; Договір 6.0: Канон має перевагу над лексичним списком зв'язувань,
; навіть якщо попереднє чи навмисно підмінене оточення містить те саме ім'я.
; Для неканонічних імен залишається звичайний пошук.
(визначити знайти-значення-імені-в-лексичному-середовищі
  (функція (імя-символу посилання-оточення)
    (нехай ((посилання-тотожності (канонічна-ідентичність імя-символу)))
      (за-умовою
        ((канонічна-виклична-тотожність? посилання-тотожності) (власний-примітив посилання-тотожності))
        ((канонічне-ім'я-форми? імя-символу) (помилка-незмінності-канонічного-імені імя-символу))
        
        ((атом? посилання-оточення)  (типове-зв'язування-імені імя-символу))
        ((зв'язування-спільного-кадру? (перше посилання-оточення))
         (за-умовою
           ((ім'я-зв'язане-в-кадрі? імя-символу (решта (перше посилання-оточення)))
            (знайти-значення-імені-в-рамці імя-символу (решта (перше посилання-оточення))))
           (так (знайти-значення-імені-в-лексичному-середовищі імя-символу (решта посилання-оточення)))))
        ((тотожне? (перше (перше посилання-оточення)) імя-символу) (решта (перше посилання-оточення)))
        (так (знайти-значення-імені-в-лексичному-середовищі імя-символу (решта посилання-оточення)))))))

(визначити ім'я-визначене-в-оточенні?
  (функція (імя-символу посилання-оточення)
