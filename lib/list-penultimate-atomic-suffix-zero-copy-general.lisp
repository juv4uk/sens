; СЕНС: суфікс від передостаннього атомного елемента.
; Якщо атомних елементів менше двох, повернути порожній список.
; Один прохід Д3, два посилання на вихідні хвости, нуль нових пар.
; Ні старих сід8 і сенс8, ні текстових машинних кодів, ні зовнішніх обчислень.
(визначити хвіст-передостаннього-атома-далі
 (функція (елементи попередній кандидат-суфікс)
  (за-умовою
   ((атом? елементи) попередній)
   ((атом? (перше елементи))
    (хвіст-передостаннього-атома-далі
     (решта елементи) кандидат-суфікс елементи))
   (так
    (хвіст-передостаннього-атома-далі
     (решта елементи) попередній кандидат-суфікс)))))

(визначити хвіст-від-передостаннього-атома
 (функція (елементи)
  (хвіст-передостаннього-атома-далі
   елементи (як-є ()) (як-є ()))))

; Рівність дерев визначає СЕНС, а не зовнішній засіб.
; Д3 ТОТОЖНЕ? одержує тільки два атоми, ніколи пару.
(визначити дерева-передостаннього-атома-рівні?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((дерева-передостаннього-атома-рівні?
     (перше ліве) (перше праве))
    (дерева-передостаннього-атома-рівні?
     (решта ліве) (решта праве)))
   (так ні))))

(визначити довести-хвіст-передостаннього-атома
 (функція (вхід очікуваний)
  (за-умовою
   ((дерева-передостаннього-атома-рівні?
     (хвіст-від-передостаннього-атома вхід) очікуваний) так)
   (так (перше (як-є ()))))))

; Немає двох атомів: порожньо, один атом, відкритий хвіст,
; дві складені пари й тільки один атом серед пар.
(довести-хвіст-передостаннього-атома (як-є ()) (як-є ()))
(довести-хвіст-передостаннього-атома (як-є атом?) (як-є ()))
(довести-хвіст-передостаннього-атома (список (як-є атом?)) (як-є ()))
(довести-хвіст-передостаннього-атома
 (сполучити (як-є атом?) (як-є решта)) (як-є ()))
(довести-хвіст-передостаннього-атома
 (список (список (як-є атом?)) (список (як-є решта))) (як-є ()))
(довести-хвіст-передостаннього-атома
 (список (список (як-є атом?)) (як-є решта)
         (список (як-є сполучити))) (як-є ()))

; Два або три атоми: повернути саме існуючий хвіст.
(довести-хвіст-передостаннього-атома
 (список (як-є атом?) (як-є решта))
 (список (як-є атом?) (як-є решта)))
(довести-хвіст-передостаннього-атома
 (список (як-є атом?) (як-є решта) (як-є сполучити))
 (список (як-є решта) (як-є сполучити)))
(довести-хвіст-передостаннього-атома
 (список (як-є ()) (як-є атом?))
 (список (як-є ()) (як-є атом?)))

; Пари між атомами не є атомами та залишаються в хвості.
(довести-хвіст-передостаннього-атома
 (список (список (як-є атом?)) (як-є решта)
         (список (як-є сполучити)) (як-є функція)
         (список (як-є визначити)))
 (список (як-є решта) (список (як-є сполучити))
         (як-є функція) (список (як-є визначити))))

; Складний край: три атоми з двома складеними вставками між ними.
; Передостанній саме серед атомних елементів, а не передостанній вузол.
; Цей реальний SENS закон також перемайнює дрейфуючу фізичну T5M-пару.
(довести-хвіст-передостаннього-атома
 (список (як-є атом?)
         (список (як-є визначити))
         (як-є решта)
         (список (як-є функція))
         (як-є сполучити)
         (список (як-є тотожне?)))
 (список (як-є решта)
         (список (як-є функція))
         (як-є сполучити)
         (список (як-є тотожне?))))

; Порожнє Д3 () є першим атомним елементом, складена пара між
; ним та другим атомом не змінює позиції передостаннього суфікса.
(довести-хвіст-передостаннього-атома
 (список (як-є ()) (список (як-є атом?)) (як-є решта)
         (список (як-є сполучити)))
 (список (як-є ()) (список (як-є атом?)) (як-є решта)
         (список (як-є сполучити))))

; Негативний свідок: початок з останнього атома помилковий.
(за-умовою
 ((хибне?
   (дерева-передостаннього-атома-рівні?
    (хвіст-від-передостаннього-атома
     (список (як-є атом?) (як-є решта) (як-є сполучити)))
    (список (як-є сполучити)))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
