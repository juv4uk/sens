; СЕНС: суфікс із двох останніх елементів скінченного правильного списку.
; Для списків довжини 0 або 1 повертаємо сам вхід.
; Д3 АТОМ? безпечно завершує і на непарному атомному вході.
; Один лінійний прохід, жодного нового сполучити — точний існуючий хвіст.
(визначити останні-два
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((порожній? (решта елементи)) елементи)
      ((порожній? (решта (решта елементи))) елементи)
      (так (останні-два (решта елементи))))))

; Дійсні позитивні SENS-свідки: атом, 0, 1, 2, 3, 4, 5 елементів.
; При хибному законі викликається неприпустиме CAR від порожнього.
(за-умовою
 ((порожній? (останні-два (як-є атом?))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (останні-два (як-є решта))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (останні-два (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (останні-два (список (як-є атом?)))) (як-є атом?)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (останні-два
   (список (як-є атом?) (як-є решта)))) (як-є атом?)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (друге (останні-два
   (список (як-є атом?) (як-є решта)))) (як-є решта)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (останні-два
   (список (як-є атом?) (як-є решта) (як-є сполучити)))) (як-є решта)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (друге (останні-два
   (список (як-є атом?) (як-є решта) (як-є сполучити)))) (як-є сполучити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (останні-два
   (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є функція))))
   (як-є сполучити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (друге (останні-два
   (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є функція))))
   (як-є функція)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (останні-два
   (список (як-є атом?) (як-є решта) (як-є сполучити)
           (як-є функція) (як-є визначити))))
   (як-є функція)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (друге (останні-два
   (список (як-є атом?) (як-є решта) (як-є сполучити)
           (як-є функція) (як-є визначити))))
   (як-є визначити)) так)
 (так (перше (як-є ()))))

; Кінець суфікса зберігається точно, без зайвого елемента.
(за-умовою
 ((порожній? (решта (решта (останні-два
   (список (як-є атом?) (як-є решта) (як-є сполучити)))))) так)
 (так (перше (як-є ()))))

; Вкладена структура другого елемента не сплющується.
(за-умовою
 ((хибне? (атом? (друге (останні-два
   (список (як-є атом?) (як-є решта)
           (як-є сполучити) (список (як-є функція))))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (друге (останні-два
   (список (як-є атом?) (як-є решта)
           (як-є сполучити) (список (як-є функція))))))
   (як-є функція)) так)
 (так (перше (як-є ()))))

; Негативний SENS-свідок: у трійці голова суфікса не перша.
(за-умовою
 ((хибне? (тотожне? (перше (останні-два
   (список (як-є атом?) (як-є решта) (як-є сполучити))))
   (як-є атом?))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
