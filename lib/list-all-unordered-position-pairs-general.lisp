; Усі невпорядковані пари РІЗНИХ ПОЗИЦІЙ списку в початковому порядку.
; Значення атомів можуть повторюватися: (а а б) дає (а а), (а б), (а б).
; Жодної нумерації з хоста, жодного сортування чи втрати кратності.
; Сам СЕНС (Д3 і Д4 і Д5) обчислює пари й перевіряє закони Д1.
; Д7 передає лише людські імена, Зіг лише обернено кодує Т5М.

(визначити дописати-списки-пар
  (функція (ліві праві)
    (за-умовою
      ((порожній? ліві) праві)
      ((атом? (як-є ()))
       (сполучити (перше ліві)
                  (дописати-списки-пар (решта ліві) праві))))))

(визначити поєднати-перший-з-рештою
  (функція (перший решта-елементів)
    (за-умовою
      ((порожній? решта-елементів) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (список перший (перше решта-елементів))
         (поєднати-перший-з-рештою перший (решта решта-елементів)))))))

(визначити усі-неупорядковані-пари-позицій
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((атом? (як-є ()))
       (дописати-списки-пар
         (поєднати-перший-з-рештою (перше елементи) (решта елементи))
         (усі-неупорядковані-пари-позицій (решта елементи)))))))

; Двостороння структурна рівність: Д3 ЕК викликаємо лише для двох атомів.
(визначити пари-дерев-рівні?
  (функція (ліве праве)
    (за-умовою
      ((порожній? ліве) (порожній? праве))
      ((порожній? праве) (хибне? (атом? (як-є ()))))
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (тотожне? ліве праве))
         ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
      ((атом? праве) (хибне? (атом? (як-є ()))))
      ((пари-дерев-рівні? (перше ліве) (перше праве))
       (пари-дерев-рівні? (решта ліве) (решта праве)))
      ((атом? (як-є ())) (хибне? (атом? (як-є ())))))))

(визначити пари-трійки
