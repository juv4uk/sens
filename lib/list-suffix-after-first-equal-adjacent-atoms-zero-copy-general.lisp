; Найперший суфікс після двох СУСІДНІХ РІВНИХ атомів.
; Один прохід. Повертаємо наявний хвіст, без копіювання CONS.
; Д3 ТОТОЖНЕ? отримує тільки атоми, складені елементи пропускаються.
; Виконання і Д1-свідки належать СЕНС, Зіг переносить точні біти.

(визначити хвіст-після-сусідніх-рівних-атомів
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((порожній? (решта елементи)) (як-є ()))
   ((хибне? (атом? (перше елементи)))
    (хвіст-після-сусідніх-рівних-атомів (решта елементи)))
   ((хибне? (атом? (перше (решта елементи))))
    (хвіст-після-сусідніх-рівних-атомів (решта елементи)))
   ((тотожне? (перше елементи) (перше (решта елементи)))
    (решта (решта елементи)))
   (так (хвіст-після-сусідніх-рівних-атомів (решта елементи))))))

; Порожні й короткі входи не викликають ПЕРШЕ від порожнечі.
(за-умовою
 ((порожній? (хвіст-після-сусідніх-рівних-атомів (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-сусідніх-рівних-атомів
              (список (як-є атом?)))) так)
 (так (перше (як-є ()))))
; Сусідні різні атоми не означають успіх.
(за-умовою
 ((порожній? (хвіст-після-сусідніх-рівних-атомів
              (список (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))
; Рівна пара напочатку повертає незмінений хвіст після неї.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-сусідніх-рівних-атомів
            (список (як-є атом?) (як-є атом?) (як-є сполучити))))
   (як-є сполучити)) так)
 (так (перше (як-є ()))))
; Різний перший атом не заважає знайти наступну рівну пару.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-сусідніх-рівних-атомів
            (список (як-є атом?) (як-є решта)
                    (як-є решта) (як-є функція))))
   (як-є функція)) так)
 (так (перше (як-є ()))))
; Порівнювати пари CONS через Д3 ТОТОЖНЕ? заборонено.
; Складені елементи пропускаються перед наступною атомною парою.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-сусідніх-рівних-атомів
            (список (список (як-є атом?))
                    (список (як-є атом?))
                    (як-є решта) (як-є решта) (як-є функція))))
   (як-є функція)) так)
 (так (перше (як-є ()))))
; Пара порожніх елементів також рівна: NIL є атомом.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-сусідніх-рівних-атомів
            (список (як-є ()) (як-є ()) (як-є решта))))
   (як-є решта)) так)
 (так (перше (як-є ()))))
; Негатив: пропущені рівні атоми не з'являються у результаті.
(за-умовою
 ((хибне? (тотожне?
   (перше (хвіст-після-сусідніх-рівних-атомів
            (список (як-є атом?) (як-є атом?) (як-є решта))))
   (як-є атом?))) так)
 (так (перше (як-є ()))))
; Завершальний нативний D1 позитив.
так
