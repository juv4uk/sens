; СЕНС. Суфікс після останньої пари сусідніх однакових атомів.
; Порожній хвіст означає кінець або відсутність збігу.
; Один прохід, без створення чи копіювання пар.
; Тотожне? ніколи не отримує складеного елемента.

(визначити останній-хвіст-після-рівних-обхід
 (функція (елементи знайдений-хвіст)
  (за-умовою
   ((порожній? елементи) знайдений-хвіст)
   ((порожній? (решта елементи)) знайдений-хвіст)
   ((хибне? (атом? (перше елементи)))
    (останній-хвіст-після-рівних-обхід (решта елементи) знайдений-хвіст))
   ((хибне? (атом? (перше (решта елементи))))
    (останній-хвіст-після-рівних-обхід (решта елементи) знайдений-хвіст))
   ((тотожне? (перше елементи) (перше (решта елементи)))
    (останній-хвіст-після-рівних-обхід
     (решта елементи) (решта (решта елементи))))
   (так (останній-хвіст-після-рівних-обхід
         (решта елементи) знайдений-хвіст)))))

(визначити хвіст-після-останніх-сусідніх-рівних
 (функція (елементи)
  (останній-хвіст-після-рівних-обхід елементи (як-є ()))))

; Межі: жодного небезпечного ПЕРШЕ або РЕШТА над порожнім.
(за-умовою
 ((порожній? (хвіст-після-останніх-сусідніх-рівних (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-останніх-сусідніх-рівних
              (список (як-є атом?)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-останніх-сусідніх-рівних
              (список (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))
; Збіг на початку, незмінена голова хвоста.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-останніх-сусідніх-рівних
            (список (як-є атом?) (як-є атом?) (як-є сполучити)
                    (як-є функція))))
   (як-є сполучити)) так)
 (так (перше (як-є ()))))
; Друга пара перекриває першу.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-останніх-сусідніх-рівних
            (список (як-є атом?) (як-є атом?) (як-є решта)
                    (як-є решта) (як-є сполучити))))
   (як-є сполучити)) так)
 (так (перше (як-є ()))))
; Якщо остання пара стоїть в кінці, результат - порожній.
(за-умовою
 ((порожній? (хвіст-після-останніх-сусідніх-рівних
              (список (як-є атом?) (як-є решта) (як-є решта)))) так)
 (так (перше (як-є ()))))
; Складені голови не проходять через атомне ТОТОЖНЕ?.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-останніх-сусідніх-рівних
            (список (список (як-є атом?)) (список (як-є атом?))
                    (як-є решта) (як-є решта) (як-є функція))))
   (як-є функція)) так)
 (так (перше (як-є ()))))
; Порожні елементи є атомами і можуть утворювати рівну пару.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-останніх-сусідніх-рівних
            (список (як-є ()) (як-є ()) (як-є решта))))
   (як-є решта)) так)
 (так (перше (як-є ()))))
; Негатив: це не хвіст від першого збігу.
(за-умовою
 ((хибне? (тотожне?
   (перше (хвіст-після-останніх-сусідніх-рівних
            (список (як-є атом?) (як-є атом?) (як-є решта)
                    (як-є решта) (як-є сполучити))))
   (як-є решта))) так)
 (так (перше (як-є ()))))
; Після останнього збігу зберігається й другий елемент хвоста.
(за-умовою
 ((тотожне?
   (друге (хвіст-після-останніх-сусідніх-рівних
            (список (як-є решта) (як-є решта)
                    (як-є атом?) (як-є функція))))
   (як-є функція)) так)
 (так (перше (як-є ()))))
так
