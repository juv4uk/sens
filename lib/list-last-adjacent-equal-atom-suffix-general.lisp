; Конкурс оптимізації СЕНС: суфікс від останньої пари рівних сусідніх атомів.
; Один прохід скінченного правильного списку: час О(н).
; Зберігається посилання на наявний хвіст; нові пари для результату не створюються.
; Порожній список є атомом, але вкладена пара ним не є.
; АТОМ? захищає ДРУГЕ від непарного хвоста; рівність лише для атомів.
; Мова та закони - СЕНС; Д7 позначає людський запис, Зіґ переносить точні слова.

(визначити суфікс-останньої-сусідньої-пари-далі
 (функція (залишок знайдений)
  (за-умовою
   ((порожній? залишок) знайдений)
   ((атом? залишок) (перше залишок))
   ((порожній? (решта залишок)) знайдений)
   ((атом? (решта залишок)) (перше (решта залишок)))
   ((хибне? (атом? (перше залишок)))
    (суфікс-останньої-сусідньої-пари-далі (решта залишок) знайдений))
   ((хибне? (атом? (друге залишок)))
    (суфікс-останньої-сусідньої-пари-далі (решта залишок) знайдений))
   ((тотожне? (перше залишок) (друге залишок))
    (суфікс-останньої-сусідньої-пари-далі (решта залишок) залишок))
   (так
    (суфікс-останньої-сусідньої-пари-далі (решта залишок) знайдений)))))

(визначити суфікс-останньої-сусідньої-пари-атомів
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   (так (суфікс-останньої-сусідньої-пари-далі елементи (як-є ()))))))

; Нативні крайові свідки: одиничний атом та неправильна пара
; не можуть викликати ДРУГЕ від атома або створювати хибний збіг.
(за-умовою
 ((порожній?
   (суфікс-останньої-сусідньої-пари-атомів (як-є атом?))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній?
   (суфікс-останньої-сусідньої-пари-атомів
     (список (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))

; Структурна перевірка з охороною: жодного тотожне? над складеною парою.
(визначити однакові-дерева-сусіднього-суфікса?
 (функція (лівий правий)
  (за-умовою
   ((атом? лівий)
    (за-умовою
     ((атом? правий) (тотожне? лівий правий))
     (так ні)))
   ((атом? правий) ні)
   ((однакові-дерева-сусіднього-суфікса?
     (перше лівий) (перше правий))
    (однакові-дерева-сусіднього-суфікса?
     (решта лівий) (решта правий)))
   (так ні))))

(визначити довести-сусідній-суфікс
 (функція (елементи очікуваний)
  (за-умовою
   ((однакові-дерева-сусіднього-суфікса?
     (суфікс-останньої-сусідньої-пари-атомів елементи) очікуваний)
    (атом? (як-є ())))
   (так (перше (як-є ()))))))

(визначити спростувати-хибний-сусідній-суфікс
 (функція (елементи хибний)
  (за-умовою
   ((хибне? (однакові-дерева-сусіднього-суфікса?
     (суфікс-останньої-сусідньої-пари-атомів елементи) хибний))
    (атом? (як-є ())))
   (так (перше (як-є ()))))))

; Немає сусідньої пари: порожній результат.
(довести-сусідній-суфікс (як-є ()) (як-є ()))
(довести-сусідній-суфікс (список (як-є атом?)) (як-є ()))
(довести-сусідній-суфікс
 (список (як-є атом?) (як-є решта) (як-є атом?)) (як-є ()))

; Пара на початку, у хвості та серед трьох однакових.
(довести-сусідній-суфікс
 (список (як-є атом?) (як-є атом?))
 (список (як-є атом?) (як-є атом?)))
(довести-сусідній-суфікс
 (список (як-є атом?) (як-є атом?) (як-є решта))
 (список (як-є атом?) (як-є атом?) (як-є решта)))
(довести-сусідній-суфікс
 (список (як-є атом?) (як-є атом?) (як-є решта) (як-є решта))
 (список (як-є решта) (як-є решта)))
(довести-сусідній-суфікс
 (список (як-є атом?) (як-є атом?) (як-є атом?))
 (список (як-є атом?) (як-є атом?)))

; порожній у двох сусідніх елементах є рівним атомом, не "відсутністю".
(довести-сусідній-суфікс
 (список (як-є ()) (як-є ()) (як-є решта))
 (список (як-є ()) (як-є ()) (як-є решта)))

; Структурно однакові вкладені пари не можна передавати у тотожне?.
(довести-сусідній-суфікс
 (список (список (як-є атом?)) (список (як-є атом?)))
 (як-є ()))
(довести-сусідній-суфікс
 (список (як-є атом?) (список (як-є атом?)) (як-є атом?) (як-є атом?))
 (список (як-є атом?) (як-є атом?)))
(довести-сусідній-суфікс
 (список (як-є атом?) (як-є атом?) (список (як-є решта)))
 (список (як-є атом?) (як-є атом?) (список (як-є решта))))
(довести-сусідній-суфікс
 (список (список (як-є решта)) (як-є атом?) (як-є атом?)
         (список (як-є тотожне?)) (як-є решта) (як-є решта))
 (список (як-є решта) (як-є решта)))

; Негативні свідки: заборонено вигаданий збіг, першу замість останньої
; пари, і порівняння двох складених елементів як атомів.
(спростувати-хибний-сусідній-суфікс
 (список (як-є атом?) (як-є решта))
 (список (як-є атом?)))
(спростувати-хибний-сусідній-суфікс
 (список (як-є атом?) (як-є атом?) (як-є решта) (як-є решта))
 (список (як-є атом?) (як-є атом?) (як-є решта) (як-є решта)))
(спростувати-хибний-сусідній-суфікс
 (список (список (як-є атом?)) (список (як-є атом?)))
 (список (список (як-є атом?)) (список (як-є атом?))))

(атом? (як-є ()))
