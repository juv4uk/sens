; Д11 SRFI-1 APPEND-REVERSE: (append (reverse rev-head) tail).
; Тільки rev-head повинен бути правильним D3-списком.
; tail є ДАНИМИ: D3:(), D3-список або непорожній атом/D1:ні.
; Жодне значення tail не перетворюється на D3:().
; Перший вхід перевіряється ПОВНІСТЮ до складання результату.
; Два обходи O(n) без проміжного REVERSE/APPEND й нових машинних кодів.

(визначити перевірити-д3-голову-оберненого-додавання
  (функція (поточний початковий)
    (за-умовою
      ((атом? поточний)
       (за-умовою
         ((порожній? поточний) початковий)
         (так (перше поточний))))
      (так
       (перевірити-д3-голову-оберненого-додавання
         (решта поточний)
         початковий)))))

(визначити приєднати-обернену-голову-ядро
  (функція (голова хвіст)
    (за-умовою
      ((порожній? голова) хвіст)
      (так
       (приєднати-обернену-голову-ядро
         (решта голова)
         (сполучити (перше голова) хвіст))))))

(визначити приєднати-обернену-голову
  (функція (голова хвіст)
    (приєднати-обернену-голову-ядро
      (перевірити-д3-голову-оберненого-додавання
        голова голова)
      хвіст)))
