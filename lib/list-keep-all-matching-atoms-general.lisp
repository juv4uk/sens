; Д3 і Д5: залишити лише всі входження одного точного атома.
; Зберігає початковий порядок, кількість повторів і самі атоми.
; Д7 - лише текстова проєкція; закон і виконання належать СЕНС.
(визначити залишити-всі-збіги-атома
  (функція (елементи шукане)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((тотожне? (перше елементи) шукане)
       (сполучити (перше елементи)
         (залишити-всі-збіги-атома (решта елементи) шукане)))
      ((атом? (як-є ()))
       (залишити-всі-збіги-атома (решта елементи) шукане)))))

(визначити вхід-збігів
  (список (як-є атом?) (як-є решта) (як-є атом?)
          (як-є сполучити) (як-є атом?) (як-є решта)))
(визначити три-збіги
  (залишити-всі-збіги-атома вхід-збігів (як-є атом?)))
(визначити два-збіги
  (залишити-всі-збіги-атома вхід-збігів (як-є решта)))
(визначити один-збіг
  (залишити-всі-збіги-атома вхід-збігів (як-є сполучити)))
(визначити жодного-збігу
  (залишити-всі-збіги-атома вхід-збігів (як-є тотожне?)))
(визначити усі-збіги
  (залишити-всі-збіги-атома
    (список (як-є атом?) (як-є атом?) (як-є атом?)) (як-є атом?)))

; Кожний хибний закон зупиняє справжній СЕНС через перше порожній.
; Позитиви та негативи: повтори, порядок, початок і кінець,
; відсутність атома, порожній, одиничний і повністю збіжний список.
(за-умовою
  ((тотожне? (перше три-збіги) (як-є атом?))
   (за-умовою
  ((тотожне? (друге три-збіги) (як-є атом?))
   (за-умовою
  ((тотожне? (третє три-збіги) (як-є атом?))
   (за-умовою
  ((порожній? (решта (решта (решта три-збіги))))
   (за-умовою
  ((хибне? (тотожне? (перше три-збіги) (як-є решта)))
   (за-умовою
  ((тотожне? (перше два-збіги) (як-є решта))
   (за-умовою
  ((тотожне? (друге два-збіги) (як-є решта))
   (за-умовою
  ((порожній? (решта (решта два-збіги)))
   (за-умовою
  ((хибне? (тотожне? (перше два-збіги) (як-є атом?)))
   (за-умовою
  ((тотожне? (перше один-збіг) (як-є сполучити))
   (за-умовою
  ((порожній? (решта один-збіг))
   (за-умовою
  ((порожній? жодного-збігу)
   (за-умовою
  ((порожній? (залишити-всі-збіги-атома (як-є ()) (як-є атом?)))
   (за-умовою
  ((порожній? (залишити-всі-збіги-атома (список (як-є решта)) (як-є атом?)))
   (за-умовою
  ((тотожне? (перше (залишити-всі-збіги-атома (список (як-є атом?)) (як-є атом?))) (як-є атом?))
   (за-умовою
  ((порожній? (решта (залишити-всі-збіги-атома (список (як-є атом?)) (як-є атом?))))
   (за-умовою
  ((тотожне? (перше усі-збіги) (як-є атом?))
   (за-умовою
  ((тотожне? (третє усі-збіги) (як-є атом?))
   (за-умовою
  ((порожній? (решта (решта (решта усі-збіги))))
   (за-умовою
  ((тотожне? (перше вхід-збігів) (як-є атом?))
   (за-умовою
  ((тотожне? (друге вхід-збігів) (як-є решта))
   (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта (решта вхід-збігів)))))) (як-є решта))
   (атом? (як-є ())))
