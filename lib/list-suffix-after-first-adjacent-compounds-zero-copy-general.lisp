; СЕНС Д3 і Д5: суфікс після перших двох сусідніх складених елементів.
; Один прохід, сталий додатковий простір, без побудови нових пар.
; Порожнє () є атомом, а вкладене (()) є складеним елементом.
(визначити хвіст-після-сусідніх-складених
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((порожній? (решта елементи)) (як-є ()))
   ((хибне? (атом? (перше елементи)))
    (за-умовою
     ((хибне? (атом? (перше (решта елементи))))
      (решта (решта елементи)))
     (так (хвіст-після-сусідніх-складених (решта елементи)))))
   (так (хвіст-після-сусідніх-складених (решта елементи))))))

; Нуль, один або лише одна складена пара не утворюють збігу.
(за-умовою
 ((порожній? (хвіст-після-сусідніх-складених (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-сусідніх-складених
              (список (список (як-є атом?))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-сусідніх-складених
              (список (список (як-є атом?)) (як-є решта)))) так)
 (так (перше (як-є ()))))

; Дві сусідні складені пари наприкінці залишають порожній хвіст.
(за-умовою
 ((порожній? (хвіст-після-сусідніх-складених
              (список (список (як-є атом?))
                      (список (як-є решта))))) так)
 (так (перше (як-є ()))))

; Після збігу повертається вихідний суфікс, а не копія і префікс.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-сусідніх-складених
            (список (список (як-є атом?)) (список (як-є решта))
                    (як-є сполучити))))
   (як-є сполучити)) так)
 (так (перше (як-є ()))))

; Вкладений третій елемент лишається складеним.
(за-умовою
 ((хибне? (атом?
  (перше (хвіст-після-сусідніх-складених
           (список (список (як-є атом?)) (список (як-є решта))
                   (список (як-є сполучити))))))) так)
 (так (перше (як-є ()))))

; Атом посередині розриває пару; шукаємо наступну суміжну пару.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-сусідніх-складених
            (список (список (як-є атом?)) (як-є ())
                    (список (як-є решта))
                    (список (як-є сполучити))
                    (як-є визначити))))
   (як-є визначити)) так)
 (так (перше (як-є ()))))

; Негативний свідок: перша складена пара не лишається у відповіді.
(за-умовою
 ((хибне? (тотожне?
   (перше (хвіст-після-сусідніх-складених
            (список (список (як-є атом?)) (список (як-є решта))
                    (як-є сполучити))))
   (як-є атом?))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
