; Півоберт шести Д3 і Д4-значень: (а б в г ґ д) дає (г ґ д а б в).
; Два застосування повертають кожну початкову позицію.
; Точна українська СЕНС-проєкція, жодних додаткових резидентів та зовнішнє-семантики.
(визначити півоберт-шістки
  (функція (елементи)
    (список
      (перше (решта (решта (решта елементи))))
      (перше (решта (решта (решта (решта елементи)))))
      (перше (решта (решта (решта (решта (решта елементи))))))
      (перше елементи)
      (перше (решта елементи))
      (перше (решта (решта елементи))))))
(визначити вхідна-шістка
  (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?) (як-є порожній?) (як-є хибне?)))
(визначити повернута-шістка (півоберт-шістки вхідна-шістка))
(визначити відновлена-шістка (півоберт-шістки повернута-шістка))
; Виконує сама мова СЕНС: усі шість позицій, повне обернення, негатив перестановки.
(за-умовою
  ((тотожне? (перше повернута-шістка) (як-є тотожне?))
   (за-умовою
  ((тотожне? (перше (решта повернута-шістка)) (як-є порожній?))
   (за-умовою
  ((тотожне? (перше (решта (решта повернута-шістка))) (як-є хибне?))
   (за-умовою
  ((тотожне? (перше (решта (решта (решта повернута-шістка)))) (як-є атом?))
   (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта повернута-шістка))))) (як-є решта))
   (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта (решта повернута-шістка)))))) (як-є сполучити))
   (за-умовою
  ((тотожне? (перше відновлена-шістка) (як-є атом?))
   (за-умовою
  ((тотожне? (перше (решта відновлена-шістка)) (як-є решта))
   (за-умовою
  ((тотожне? (перше (решта (решта відновлена-шістка))) (як-є сполучити))
   (за-умовою
  ((тотожне? (перше (решта (решта (решта відновлена-шістка)))) (як-є тотожне?))
   (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта відновлена-шістка))))) (як-є порожній?))
   (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта (решта відновлена-шістка)))))) (як-є хибне?))
   (за-умовою
  ((хибне? (тотожне? (перше повернута-шістка) (як-є атом?)))
