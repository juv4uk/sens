; Д3 і Д4: розрізати правильний скінченний список перед першим збігом атома.
; Пара (префікс суфікс) зберігає усі елементи, включно зі збігом.
; Якщо збігу немає: (увесь-список порожній). Для порожній: (порожній порожній).
; Жодної нової координати домену; усю семантику виконує СЕНС.
(визначити додати-голову-до-розбиття
  (функція (елементи розбиття)
    (список
      (сполучити (перше елементи) (перше розбиття))
      (друге розбиття))))

(визначити розділити-перед-першим
  (функція (елементи шукане)
    (за-умовою
      ((атом? елементи) (список (як-є ()) (як-є ())))
      ((тотожне? (перше елементи) шукане)
       (список (як-є ()) елементи))
      ((атом? (як-є ()))
       (додати-голову-до-розбиття
         елементи
         (розділити-перед-першим (решта елементи) шукане))))))

(визначити зібрати-після-розбиття
  (функція (розбиття)
    (приєднати (перше розбиття) (друге розбиття))))

(визначити вхідний-список
  (список (як-є атом?) (як-є решта) (як-є тотожне?) (як-є сполучити)))
(визначити поділ-середини
  (розділити-перед-першим вхідний-список (як-є тотожне?)))
(визначити поділ-початку
  (розділити-перед-першим вхідний-список (як-є атом?)))
(визначити поділ-відсутнього
  (розділити-перед-першим вхідний-список (як-є за-умовою)))
(визначити поділ-порожнього
  (розділити-перед-першим (як-є ()) (як-є атом?)))
(визначити поділ-повторів
  (розділити-перед-першим
    (список (як-є решта) (як-є атом?) (як-є сполучити) (як-є атом?))
    (як-є атом?)))

; Кожен свідок виконується в СЕНС; хибний свідок є виконуваною помилкою перше порожній.
(за-умовою
  ((тотожне? (перше (перше поділ-середини)) (як-є атом?))
   (за-умовою
     ((тотожне? (друге (перше поділ-середини)) (як-є решта))
      (за-умовою
        ((порожній? (решта (решта (перше поділ-середини))))
         (за-умовою
           ((тотожне? (перше (друге поділ-середини)) (як-є тотожне?))
            (за-умовою
              ((тотожне? (друге (друге поділ-середини)) (як-є сполучити))
               (за-умовою
                 ((порожній? (решта (решта (друге поділ-середини))))
                  (за-умовою
                    ((тотожне? (перше (зібрати-після-розбиття поділ-середини)) (як-є атом?))
                     (за-умовою
                       ((тотожне? (друге (зібрати-після-розбиття поділ-середини)) (як-є решта))
                        (за-умовою
                          ((тотожне? (третє (зібрати-після-розбиття поділ-середини)) (як-є тотожне?))
                           (за-умовою
                             ((тотожне? (перше (решта (решта (решта (зібрати-після-розбиття поділ-середини))))) (як-є сполучити))
                              (за-умовою
                                ((порожній? (перше поділ-початку))
                                 (за-умовою
                                   ((тотожне? (перше (друге поділ-початку)) (як-є атом?))
                                    (за-умовою
                                      ((тотожне? (друге (друге поділ-початку)) (як-є решта))
                                       (за-умовою
                                         ((порожній? (друге поділ-відсутнього))
                                          (за-умовою
                                            ((тотожне? (перше (перше поділ-відсутнього)) (як-є атом?))
                                             (за-умовою
                                               ((тотожне? (третє (перше поділ-відсутнього)) (як-є тотожне?))
                                                (за-умовою
                                                  ((порожній? (перше поділ-порожнього))
                                                   (за-умовою
                                                     ((порожній? (друге поділ-порожнього))
                                                      (за-умовою
                                                        ((тотожне? (перше (перше поділ-повторів)) (як-є решта))
                                                         (за-умовою
                                                           ((порожній? (решта (перше поділ-повторів)))
                                                            (за-умовою
                                                              ((тотожне? (перше (друге поділ-повторів)) (як-є атом?))
                                                               (за-умовою
                                                                 ((тотожне? (третє (друге поділ-повторів)) (як-є атом?))
                                                                  (за-умовою
                                                                    ((хибне? (тотожне? (перше (перше поділ-середини)) (як-є тотожне?)))
                                                                     (атом? (як-є ())))
                                                                    ((атом? (як-є ())) (перше (як-є ())))))
                                                                 ((атом? (як-є ())) (перше (як-є ())))))
                                                              ((атом? (як-є ())) (перше (як-є ())))))
                                                           ((атом? (як-є ())) (перше (як-є ())))))
                                                        ((атом? (як-є ())) (перше (як-є ())))))
                                                     ((атом? (як-є ())) (перше (як-є ())))))
                                                  ((атом? (як-є ())) (перше (як-є ())))))
                                               ((атом? (як-є ())) (перше (як-є ())))))
                                            ((атом? (як-є ())) (перше (як-є ())))))
                                         ((атом? (як-є ())) (перше (як-є ())))))
                                      ((атом? (як-є ())) (перше (як-є ())))))
                                   ((атом? (як-є ())) (перше (як-є ())))))
                                ((атом? (як-є ())) (перше (як-є ())))))
                             ((атом? (як-є ())) (перше (як-є ())))))
                          ((атом? (як-є ())) (перше (як-є ())))))
                       ((атом? (як-є ())) (перше (як-є ())))))
                    ((атом? (як-є ())) (перше (як-є ())))))
                 ((атом? (як-є ())) (перше (як-є ())))))
              ((атом? (як-є ())) (перше (як-є ())))))
           ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
