; СЕНС Д3–Д5: спеціалізований лінійний zero-copy пошук першої
; суміжної трійки АТОМНИХ елементів (не обов'язково однакових).
; Це не «трійка рівних атомів»: для неї існує інша програма.
; Точні Д3 АТОМ?/ПЕРШЕ/РЕШТА визначають структуру, Д7 лише показує запис.
; O(n) часу, O(1) нових пар: результат — оригінальний суфікс, CONS немає.
; Ні SID8/Sens8, ні числового лічильника, ні Rust/Python/JSON семантики.

(визначити суфікс-від-першої-суміжної-трійки-атомів
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (решта елементи)) (як-є ()))
   ((атом? (решта (решта елементи))) (як-є ()))
   ((хибне? (атом? (перше елементи)))
    (суфікс-від-першої-суміжної-трійки-атомів (решта елементи)))
   ((хибне? (атом? (перше (решта елементи))))
    (суфікс-від-першої-суміжної-трійки-атомів (решта елементи)))
   ((хибне? (атом? (перше (решта (решта елементи)))))
    (суфікс-від-першої-суміжної-трійки-атомів (решта елементи)))
   (так елементи))))

; Кожен закон виконує сам СЕНС: хибна гілка — недозволений ПЕРШЕ від ().
; Порожнє, атомний хвіст та короткий список не дають уявної трійки.
(за-умовою
 ((порожній?
   (суфікс-від-першої-суміжної-трійки-атомів (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній?
   (суфікс-від-першої-суміжної-трійки-атомів (як-є атом?))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній?
   (суфікс-від-першої-суміжної-трійки-атомів
    (сполучити (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній?
   (суфікс-від-першої-суміжної-трійки-атомів
    (список (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))

; Без копіювання повертаємо саме ПОЧАТОК першої трійки, не хвіст після неї.
(визначити зразок-першої-трійки
 (суфікс-від-першої-суміжної-трійки-атомів
  (список (як-є атом?) (як-є решта) (як-є сполучити)
          (список (як-є функція)) (як-є тотожне?))))
(за-умовою
 ((тотожне? (перше зразок-першої-трійки) (як-є атом?)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (решта зразок-першої-трійки)) (як-є решта)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (решта (решта зразок-першої-трійки)))
            (як-є сполучити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (атом?
   (перше (решта (решта (решта зразок-першої-трійки)))))) так)
 (так (перше (як-є ()))))

; Складена голова і розрив середини пропускаються; шукаємо наступну трійку.
(визначити зразок-пропущених-пар
 (суфікс-від-першої-суміжної-трійки-атомів
  (список (список (як-є атом?)) (як-є решта)
          (список (як-є функція)) (як-є атом?)
          (як-є сполучити) (як-є тотожне?)
          (список (як-є решта)))))
(за-умовою
 ((тотожне? (перше зразок-пропущених-пар) (як-є атом?)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (решта зразок-пропущених-пар))
            (як-є сполучити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (решта (решта зразок-пропущених-пар)))
            (як-є тотожне?)) так)
 (так (перше (як-є ()))))

; () усередині списку є атомом, але (()) — складений елемент.
(за-умовою
 ((порожній?
   (перше (суфікс-від-першої-суміжної-трійки-атомів
     (список (як-є ()) (як-є атом?) (як-є решта))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній?
   (суфікс-від-першої-суміжної-трійки-атомів
    (список (список (як-є ())) (список (як-є ()))
            (список (як-є ()))))) так)
 (так (перше (як-є ()))))

; Негатив: окрема пара розриває пробіг; самі два атоми недостатні.
(за-умовою
 ((порожній?
   (суфікс-від-першої-суміжної-трійки-атомів
    (список (як-є атом?) (як-є решта)
            (список (як-є сполучити)) (як-є тотожне?)))) так)
 (так (перше (як-є ()))))

; Остаточне спостережне значення Д1, а не текстове «успішно».
(атом? (як-є ()))
