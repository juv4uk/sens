; Д11: строга похідна перевірка PREFIX? для двох D3-списків.
; НЕ нова ратифікована координата — лише SENS-композиція D1/D3/D8.
; Перш ніж порівнювати, перевіряємо ОБИДВА повні спискові хребти.
; D1:ні, D3:() та D7 значення дозволені як елементи списку.
; Сторонній атом у корені чи хвості — нормативна помилка D3 CAR Type.
; D11-пропозиція: повний попередній SENS-доказ структури, без нового коду.
(визначити д11-перевірити-повний-список
  (функція (залишок початковий)
    (за-умовою
      ((порожній? залишок) початковий)
      ((атом? залишок) (перше залишок))
      (так
       (д11-перевірити-повний-список
         (решта залишок) початковий)))))

; Зіставлення виконується тільки після доведення структури входів.
; Порожній префікс будь-якого правильного списку є префіксом.
; D11-пропозиція: рекурсивне зіставлення після D3-валідації.
(визначити д11-префікс-ядро
  (функція (префікс елементи)
    (за-умовою
      ((порожній? префікс) так)
      ((порожній? елементи) ні)
      ((однакові? (перше префікс) (перше елементи))
       (д11-префікс-ядро
         (решта префікс) (решта елементи)))
      (так ні))))

; D11-пропозиція: API-композиція двох SENS-помічників без нової координати.
(визначити список-префікс-строгий?
  (функція (префікс елементи)
    (д11-префікс-ядро
      (д11-перевірити-повний-список префікс префікс)
      (д11-перевірити-повний-список елементи елементи))))
