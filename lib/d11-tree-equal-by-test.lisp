; СЕНС · D11 F11-TREE-TEST · композиція ратифікованих D3/D4.
; Порівнювач листків — двоаргументна SENS-функція з результатом D1.
; Пара з парою: перевірити перше і решту; атом з парою: D1:ні.
; Жодного D11-opcode, Unicode-тотожності чи числових літералів.
; Циклічні дерева не входять до контракту цієї композиції.

(визначити дерева-рівні-за-тестом?
  (функція (ліве праве порівняти)
    (за-умовою
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (за-умовою ((порівняти ліве праве) так) (так ні)))
         (так ні)))
      ((атом? праве) ні)
      ((дерева-рівні-за-тестом?
         (перше ліве) (перше праве) порівняти)
       (дерева-рівні-за-тестом?
         (решта ліве) (решта праве) порівняти))
      (так ні))))

; Фізичний самосвідок бібліотеки: листки NIL порівнюються тим самим D3 EQ.
(дерева-рівні-за-тестом?
  (як-є ()) (як-є ())
  (функція (лівий-лист правий-лист)
    (тотожне? лівий-лист правий-лист)))
