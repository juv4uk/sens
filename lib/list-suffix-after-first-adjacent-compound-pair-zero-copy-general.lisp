; СЕНС. Суфікс після першої пари сусідніх складених елементів.
; Один лінійний обхід, без копіювання хвоста і нових доменних кодів.
; Порожній вкладений список є атомом, а не складеним елементом.
; Фізичні байти створює тільки справжній СЕНС та Зіг Т5М.

(визначити хвіст-після-сусідніх-складених
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((порожній? (решта елементи)) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-сусідніх-складених (решта елементи)))
   ((атом? (перше (решта елементи)))
    (хвіст-після-сусідніх-складених (решта елементи)))
   (так (решта (решта елементи))))))

; Порожній вхід, одна складена форма та рівно дві складені форми.
(за-умовою
 ((порожній? (хвіст-після-сусідніх-складених (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-сусідніх-складених
              (список (список (як-є атом?))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-сусідніх-складених
              (список (список (як-є атом?))
                      (список (як-є решта))))) так)
 (так (перше (як-є ()))))

; Справжній суфікс є хвостом вихідного списку, без сполучити.
(за-умовою
 ((тотожне? (перше (хвіст-після-сусідніх-складених
                   (список (список (як-є атом?))
                           (список (як-є решта))
                           (як-є сполучити))))
            (як-є сполучити)) так)
 (так (перше (як-є ()))))

; Атом між двома складеними формами змушує шукати далі.
(за-умовою
 ((тотожне? (перше (хвіст-після-сусідніх-складених
                   (список (список (як-є атом?))
                           (як-є решта)
                           (список (як-є сполучити))
                           (список (як-є тотожне?))
                           (як-є функція))))
            (як-є функція)) так)
 (так (перше (як-є ()))))

; Порожній вкладений список не утворює складеної пари.
(за-умовою
 ((порожній? (хвіст-після-сусідніх-складених
              (список (список (як-є атом?))
                      (як-є ())
                      (список (як-є решта))))) так)
 (так (перше (як-є ()))))

; Негативний свідок: перша форма не потрапляє у повернений хвіст.
(за-умовою
 ((хибне? (тотожне?
           (перше (хвіст-після-сусідніх-складених
                    (список (список (як-є атом?))
                            (список (як-є решта))
                            (як-є сполучити))))
           (як-є атом?))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
