; СЕНС: відкинути рівно три перші елементи правильного списку.
; Виконання Д3: лише три РЕШТА, без нових пар та копіювання.
; Для короткого або порожнього списку результат структурне ().
(визначити хвіст-після-трьох
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (решта елементи)) (як-є ()))
   ((атом? (решта (решта елементи))) (як-є ()))
   (так (решта (решта (решта елементи)))))))

; Позитивні та негативні свідки виконує лише справжній СЕНС.
; Жодна помилка не замінюється удаваним успіхом.
(за-умовою
 ((порожній? (хвіст-після-трьох (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-трьох (список (як-є атом?)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-трьох (список (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-трьох
              (список (як-є атом?) (як-є решта) (як-є сполучити)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (перше (хвіст-після-трьох
            (список (як-є атом?) (як-є решта)
                    (як-є сполучити) (як-є визначити))))
   (як-є визначити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (друге (хвіст-після-трьох
            (список (як-є атом?) (як-є решта)
                    (як-є сполучити) (як-є визначити)
                    (як-є функція))))
   (як-є функція)) так)
 (так (перше (як-є ()))))
; Відкидання двох замість трьох помилково поверне СПОЛУЧИТИ.
(за-умовою
 ((хибне?
   (тотожне?
    (перше (хвіст-після-трьох
             (список (як-є атом?) (як-є решта)
                     (як-є сполучити) (як-є визначити))))
    (як-є сполучити))) так)
 (так (перше (як-є ()))))
(атом? (як-є ()))
