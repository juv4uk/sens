; Унарний підрахунок листків довільного скінченного дерева списків.
; Кожний атомний листок додає один елемент списку-лічильника.
; Порожній список не є листком. Машинні числа не потрібні.
; Обчислення, рекурсія та перевірки виконуються тільки в СЕНС.

(визначити поєднати-унарні-лічильники
  (функція (лівий правий)
    (за-умовою
      ((атом? лівий) правий)
      ((атом? (як-є ()))
       (сполучити (перше лівий)
         (поєднати-унарні-лічильники (решта лівий) правий))))))

(визначити порахувати-листки-унарно
  (функція (дерево)
    (за-умовою
      ((порожній? дерево) (як-є ()))
      ((атом? дерево) (список (як-є атом?)))
      ((атом? (як-є ()))
       (поєднати-унарні-лічильники
         (порахувати-листки-унарно (перше дерево))
         (порахувати-листки-унарно (решта дерево)))))))

(визначити перевірити-листки
  (функція (правда)
    (за-умовою
      (правда (атом? (як-є ())))
      ((атом? (як-є ())) (перше (як-є ()))))))

; Чотири листки та три рівні вкладеності.
(визначити дерево-приклад
  (список
    (список (як-є атом?) (як-є решта))
    (як-є сполучити)
    (список (як-є тотожне?))))

(визначити підраховані-листки
  (порахувати-листки-унарно дерево-приклад))

; Нуль, одиниця, чотири та негативний укорочений лічильник.
(перевірити-листки
  (порожній? (порахувати-листки-унарно (як-є ()))))
(перевірити-листки
  (тотожне? (перше (порахувати-листки-унарно (як-є атом?)))
    (як-є атом?)))
(перевірити-листки
  (порожній? (решта (порахувати-листки-унарно (як-є атом?)))))
(перевірити-листки
  (тотожне? (перше підраховані-листки) (як-є атом?)))
(перевірити-листки
  (тотожне? (перше (решта підраховані-листки)) (як-є атом?)))
(перевірити-листки
  (тотожне?
    (перше (решта (решта підраховані-листки)))
    (як-є атом?)))
(перевірити-листки
  (тотожне?
    (перше (решта (решта (решта підраховані-листки))))
    (як-є атом?)))
(перевірити-листки
  (порожній?
    (решта (решта (решта (решта підраховані-листки))))))
(перевірити-листки
  (хибне?
    (порожній?
      (решта (решта (решта підраховані-листки))))))
(перевірити-листки
  (хибне?
    (порожній?
      (порахувати-листки-унарно
        (список (як-є атом?) (як-є ()))))))
(атом? (як-є ()))
