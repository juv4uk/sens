; Імплікація над точними значеннями Д1: тільки так і ні.
; Закон: ні => ні = так; ні => так = так; так => так = так; так => ні = ні.
; Д3 за-умовою виконує логіку СЕНС; Зіг/Т5М не визначає істинність.
(визначити імплікація-д1
  (функція (умова наслідок)
    (за-умовою
      ((хибне? умова) так)
      (так наслідок))))

; Нативний свідок: усі чотири комбінації, включно з негативним випадком.
; Будь-який неправильний випадок повертає Д1 ні, не фальшивий PASS.
(за-умовою
  ((імплікація-д1 ні ні)
    (за-умовою
      ((імплікація-д1 ні так)
        (за-умовою
          ((імплікація-д1 так так)
            (хибне? (імплікація-д1 так ні)))
          (так ні)))
      (так ні)))
  (так ні))
