; Бібліотека тверджень M1 — українська проєкція SENS.
; Суддя живе в мові: тест = функція → так|ні; раннер = рекурсія по списку.
; Лічильники — структурні (довжина списків), без числових літералів у семантиці.
; Поверхні: d1–d4 (так/ні, тотожне?, за-умовою, сполучити, перше, решта,
; порожній?, визначити, функція, хибне?).
; Не вводить SID8/Sens8 і не залежить від Python/JS.

; Рівність очікуваного і фактичного (D3 тотожне?).
(визначити рівне?
  (функція (очікуване фактичне)
    (тотожне? очікуване фактичне)))

; Запустити список уже обчислених свідків (так|ні).
; Повертає список лише тих, що пройшли (так).
(визначити зібрати-пройшли
  (функція (тести)
    (за-умовою
      ((порожній? тести) (як-є ()))
      (так
        (за-умовою
          ((перше тести)
           (сполучити (перше тести) (зібрати-пройшли (решта тести))))
          (так (зібрати-пройшли (решта тести))))))))

; Запустити список свідків; повернути лише ті, що впали (ні).
(визначити зібрати-впали
  (функція (тести)
    (за-умовою
      ((порожній? тести) (як-є ()))
      (так
        (за-умовою
          ((хибне? (перше тести))
           (сполучити (перше тести) (зібрати-впали (решта тести))))
          (так (зібрати-впали (решта тести))))))))

; Звіт: пара (пройшли . впали) — структурні списки, не числа.
(визначити звіт
  (функція (тести)
    (сполучити (зібрати-пройшли тести) (зібрати-впали тести))))

; Усі свідки пройшли?
(визначити усі-пройшли?
  (функція (тести)
    (порожній? (зібрати-впали тести))))

; Є хоча б один провал?
(визначити є-провал?
  (функція (тести)
    (хибне? (усі-пройшли? тести))))

; Запустити: зручний аліас — повний звіт.
(визначити запустити
  (функція (тести)
    (звіт тести)))

; Суперечність: свідок мусить бути ні (негативний свідок).
(визначити суперечність?
  (функція (свідок)
    (хибне? свідок)))

; Тавтологія: свідок мусить бути так.
(визначити тавтологія?
  (функція (свідок)
    (рівне? свідок так)))
