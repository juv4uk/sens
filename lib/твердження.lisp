; Бібліотека тверджень M1+M2 — українська проєкція SENS.
; Суддя живе в мові: тест = функція → так|ні; раннер = рекурсія по списку.
; Лічильники — структурні (довжина списків), без числових літералів у семантиці.
; Поверхні: d1–d4 (так/ні, тотожне?, за-умовою, сполучити, перше, решта,
; порожній?, визначити, функція, хибне?).
; Не вводить SID8/Sens8 і не залежить від Python/JS.

; Рівність очікуваного і фактичного — структурна операція D8.
; D3 тотожне? залишається атомною тотожністю; ним не порівнюємо списки.
(визначити рівне?
  (функція (очікуване фактичне)
    (однакові? очікуване фактичне)))

; Запустити список уже обчислених свідків (так|ні).
; Повертає список лише тих, що пройшли (так).
(визначити зібрати-пройшли
  (функція (тести)
    (за-умовою
      ((порожній? тести) (як-є ()))
      (так
        (за-умовою
          ((перше тести)
           (сполучити (перше тести) (зібрати-пройшли (решта тести))))
          (так (зібрати-пройшли (решта тести))))))))

; Запустити список свідків; повернути лише ті, що впали (ні).
(визначити зібрати-впали
  (функція (тести)
    (за-умовою
      ((порожній? тести) (як-є ()))
      (так
        (за-умовою
          ((хибне? (перше тести))
           (сполучити (перше тести) (зібрати-впали (решта тести))))
          (так (зібрати-впали (решта тести))))))))

; Звіт: пара (пройшли . впали) — структурні списки, не числа.
(визначити звіт
  (функція (тести)
    (сполучити (зібрати-пройшли тести) (зібрати-впали тести))))

; Усі свідки пройшли?
(визначити усі-пройшли?
  (функція (тести)
    (порожній? (зібрати-впали тести))))

; Є хоча б один провал?
(визначити є-провал?
  (функція (тести)
    (хибне? (усі-пройшли? тести))))

; Запустити: зручний аліас — повний звіт.
(визначити запустити
  (функція (тести)
    (звіт тести)))

; Суперечність: свідок мусить бути ні (негативний свідок).
(визначити суперечність?
  (функція (свідок)
    (хибне? свідок)))

; Тавтологія: свідок мусить бути так.
(визначити тавтологія?
  (функція (свідок)
    (рівне? свідок так)))

; === M2: негативні свідки (очікувана відмова) ===
; Культура мутантів: поганий вхід мусить бути відхилений.
; Негативний свідок = форма, чий результат — ні (або невиклик).
; «Успіх» негативного тесту = суперечність? дає так.

; Чи свідок є очікуваною відмовою (результат ні).
(визначити очікувана-відмова?
  (функція (свідок)
    (суперечність? свідок)))

; Усі свідки в списку — відмови (кожен ні).
(визначити усі-відхилені?
  (функція (тести)
    (порожній? (зібрати-пройшли тести))))

; Негативний звіт: пара (відхилені . несподівано-пройшли).
; Для негативного набору «пройшли» = помилка калібрування.
(визначити негативний-звіт
  (функція (тести)
    (сполучити (зібрати-впали тести) (зібрати-пройшли тести))))

; Негативний набір валідний: немає жодного «так».
(визначити негативний-набір-валідний?
  (функція (тести)
    (усі-відхилені? тести)))

; M1: runner виконує кожне тестове замикання у SENS.
; Лічильники — списки завершених свідків, а не хостові числа.
(визначити твердження-однаковості
  (функція (очікуване фактичне)
    (однакові? очікуване фактичне)))

; Звіт: (всього пройшли впали імена-провалів імена-помилок).
; PASS/FAIL рахуються лише для точних D1:так / D1:ні.
; Наприклад D3:() — не D1:ні: записуємо його окремо як ERROR.
(визначити зібрати-звіт-тверджень
  (функція (всього пройшли впали імена-провалів імена-помилок)
    (список всього пройшли впали імена-провалів імена-помилок)))

(визначити обійти-твердження
  (функція (тести всього пройшли впали імена-провалів імена-помилок)
    (за-умовою
      ((порожній? тести)
       (зібрати-звіт-тверджень
         всього пройшли впали імена-провалів імена-помилок))
      ((атом? тести) (перше тести))
      (так
       (за-умовою
         ((однакові? ((друге (перше тести))) так)
          (обійти-твердження
            (решта тести)
            (сполучити так всього)
            (сполучити так пройшли)
            впали імена-провалів імена-помилок))
         ((однакові? ((друге (перше тести))) ні)
          (обійти-твердження
            (решта тести)
            (сполучити так всього)
            пройшли
            (сполучити так впали)
            (сполучити (перше (перше тести)) імена-провалів)
            імена-помилок))
         (так
          (обійти-твердження
            (решта тести)
            (сполучити так всього)
            пройшли впали імена-провалів
            (сполучити (перше (перше тести)) імена-помилок))))))))

(визначити запустити-твердження
  (функція (тести)
    (обійти-твердження тести
      (як-є ()) (як-є ()) (як-є ()) (як-є ()) (як-є ()))))
