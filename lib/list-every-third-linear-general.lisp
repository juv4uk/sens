 (список (як-є сполучити) (як-є порожній?)))
(перевірити-третій
 (список (як-є атом?) (як-є решта) (як-є сполучити)
         (як-є функція) (як-є як-є) (як-є порожній?)
         (як-є за-умовою) (як-є визначити) (як-є тотожне?))
 (список (як-є сполучити) (як-є порожній?) (як-є тотожне?)))
(перевірити-третій
 (список (як-є атом?) (як-є решта) (список (як-є атом?) (як-є решта))
         (як-є функція) (як-є як-є) (як-є сполучити))
 (список (список (як-є атом?) (як-є решта)) (як-є сполучити)))
(перевірити-третій
