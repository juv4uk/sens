; Кожний третій елемент правильного списку: позиції 3, 6, 9, ...
; Один прохід, один пари на повну трійку; арифметики та хоста немає.
; Атоми, повтори і вкладені значення передаються без перезапису.
(визначити взяти-кожний-третій
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((порожній? (решта елементи)) (як-є ()))
      ((порожній? (решта (решта елементи))) (як-є ()))
      (так (сполучити (третє елементи)
             (взяти-кожний-третій (решта (решта (решта елементи)))))))))

; Результат порівнює сама мова, включно зі структурою вкладених пар.
(визначити ті-самі-дерева?
  (функція (ліве праве)
    (за-умовою
      ((атом? ліве)
       (за-умовою ((атом? праве) (тотожне? ліве праве))
                  (так ні)))
      ((атом? праве) ні)
      ((ті-самі-дерева? (перше ліве) (перше праве))
       (ті-самі-дерева? (решта ліве) (решта праве)))
      (так ні))))

; Порушений закон падає на перше порожнього списку в СЕНС.
(визначити перевірити-третій
  (функція (вхід очікуване)
    (за-умовою
      ((ті-самі-дерева? (взяти-кожний-третій вхід) очікуване) так)
      (так (перше (як-є ()))))))

; Границі 0, 2, 3, 4, 6, 9 та вкладені значення.
(перевірити-третій (як-є ()) (як-є ()))
(перевірити-третій
 (список (як-є атом?) (як-є решта)) (як-є ()))
(перевірити-третій
 (список (як-є атом?) (як-є решта) (як-є сполучити))
 (список (як-є сполучити)))
(перевірити-третій
 (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є функція))
