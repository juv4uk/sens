; Д3-Д5: повернути перший складений елемент правильного списку.
; Атомні елементи (включно з ()) пропускаються; якщо пари немає - ().
; Хвостова рекурсія, один прохід, нуль нових пар у самому алгоритмі.
; Тільки укр-проєкція чинної драбини, без сід8 і сенс8 та хостової семантики.
(визначити перший-складений-елемент-зліва
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи))
    (перший-складений-елемент-зліва (решта елементи)))
   (так (перше елементи)))))

; Незалежне деревне порівняння: ЕК лише для атомів, пари через Д3.
(визначити рівні-дерева-першого-складеного?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((рівні-дерева-першого-складеного? (перше ліве) (перше праве))
    (рівні-дерева-першого-складеного? (решта ліве) (решта праве)))
   (так ні))))

(визначити довести-перший-складений
 (функція (вхід очікуване)
  (за-умовою
   ((рівні-дерева-першого-складеного?
      (перший-складений-елемент-зліва вхід) очікуване) так)
   (так (перше (як-є ()))))))

; Позитивні: немає пари, порожній як елемент, пара першою і пізніше,
; перший із кількох, вкладений елемент та порожня складена пара.
(довести-перший-складений (як-є ()) (як-є ()))
(довести-перший-складений
 (список (як-є атом?) (як-є решта)) (як-є ()))
(довести-перший-складений
 (список (як-є ()) (як-є атом?)) (як-є ()))
(довести-перший-складений
 (список (список (як-є атом?))) (список (як-є атом?)))
(довести-перший-складений
 (список (як-є ()) (як-є решта) (список (як-є сполучити)))
 (список (як-є сполучити)))
(довести-перший-складений
 (список (список (як-є атом?)) (список (як-є решта)))
 (список (як-є атом?)))
(довести-перший-складений
 (список (список (список (як-є атом?))))
 (список (список (як-є атом?))))
(довести-перший-складений
 (список (список (як-є ())) (як-є решта))
 (список (як-є ())))

; Негативні СЕНС-свідки: не вибирати останню пару;
; не плутати порожній результат зі списком із порожнім елементом.
(за-умовою
 ((рівні-дерева-першого-складеного?
    (перший-складений-елемент-зліва
     (список (список (як-є атом?)) (список (як-є решта))))
    (список (як-є решта)))
  (перше (як-є ())))
 (так так))
(за-умовою
 ((рівні-дерева-першого-складеного?
    (перший-складений-елемент-зліва
     (список (як-є атом?) (як-є ())))
    (список (як-є ())))
  (перше (як-є ())))
 (так так))

; Виконується нативним СЕНС; фізичний Т5М генерує тільки Зіг.
(атом? (як-є ()))
