  ((тотожне? (перше без-пропуску) (як-є атом?))
   (за-умовою
  ((тотожне? (друге без-пропуску) (як-є атом?))
   (за-умовою
  ((тотожне? (перше (решта (решта без-пропуску))) (як-є решта))
   (за-умовою
  ((тотожне? (перше (решта (решта (решта без-пропуску)))) (як-є атом?))
   (за-умовою
  ((порожній? (решта (решта (решта (решта без-пропуску)))))
   (за-умовою
  ((порожній? все-пропущено)
   (за-умовою
  ((порожній? (пропустити-поки-атом (як-є ()) (як-є атом?)))
   (за-умовою
  ((тотожне? (перше (пропустити-поки-атом (список (як-є решта)) (як-є атом?))) (як-є решта))
   (за-умовою
  ((порожній? (решта (пропустити-поки-атом (список (як-є решта)) (як-є атом?))))
   (за-умовою
  ((порожній? (пропустити-поки-атом (список (як-є атом?)) (як-є атом?)))
   (за-умовою
  ((тотожне? (перше (пропустити-поки-атом (список (як-є атом?) (як-є решта)) (як-є атом?))) (як-є решта))
