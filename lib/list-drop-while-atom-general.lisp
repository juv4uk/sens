; Д3 і Д5: пропустити тільки початкову послідовність заданого атома.
; Перший відмінний атом зберігає весь суфікс, включно з повторами.
(визначити пропустити-поки-атом
  (функція (елементи шукане)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((тотожне? (перше елементи) шукане)
       (пропустити-поки-атом (решта елементи) шукане))
      ((атом? (як-є ())) елементи))))
(визначити вхід-поки-пропустити
  (список (як-є атом?) (як-є атом?) (як-є решта) (як-є атом?)))
(визначити суфікс-пропустити
  (пропустити-поки-атом вхід-поки-пропустити (як-є атом?)))
(визначити без-пропуску
  (пропустити-поки-атом вхід-поки-пропустити (як-є решта)))
(визначити все-пропущено
  (пропустити-поки-атом (список (як-є атом?) (як-є атом?)) (як-є атом?)))

