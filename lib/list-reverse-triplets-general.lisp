; СЕНС: обернути порядок усередині кожної повної трійки правильного списку.
; Один прохід, три нові пари на трійку; хвіст із одного або двох
; елементів повертається без копіювання. Вкладені значення не розгортаються.
; Обернення є інволюцією: два застосування відтворюють увесь список.
; Викличні голови — чинна повна українська проєкція Д1–Д5, без SID8.
(визначити обернути-кожну-трійку
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) елементи)
      ((атом? (решта-решти елементи)) елементи)
      (так
        (сполучити (третє елементи)
          (сполучити (друге елементи)
            (сполучити (перше елементи)
              (обернути-кожну-трійку
                (решта (решта-решти елементи))))))))))

; Порівняння довільних вкладених дерев виконує сам СЕНС.
; Тотожність атомів перевіряється тільки після перевірки атомарності.
(визначити однакові-дерева-трійок?
  (функція (ліве праве)
    (за-умовою
      ((атом? ліве)
        (за-умовою
          ((атом? праве) (тотожне? ліве праве))
          (так ні)))
      ((атом? праве) ні)
      ((однакові-дерева-трійок? (перше ліве) (перше праве))
        (однакові-дерева-трійок? (решта ліве) (решта праве)))
      (так ні))))

(визначити перевірити-обернення-трійок
  (функція (вхід очікуване)
    (за-умовою
      ((однакові-дерева-трійок?
         (обернути-кожну-трійку вхід) очікуване) так)
      (так (перше (як-є ()))))))

; Порожній, один, два та рівно три елементи.
(перевірити-обернення-трійок (як-є ()) (як-є ()))
(перевірити-обернення-трійок
  (список (як-є атом?))
  (список (як-є атом?)))
(перевірити-обернення-трійок
  (список (як-є атом?) (як-є решта))
  (список (як-є атом?) (як-є решта)))
(перевірити-обернення-трійок
  (список (як-є атом?) (як-є решта) (як-є сполучити))
  (список (як-є сполучити) (як-є решта) (як-є атом?)))

; Неповні хвости, дві повні трійки та повторені значення.
(перевірити-обернення-трійок
  (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?))
  (список (як-є сполучити) (як-є решта) (як-є атом?) (як-є тотожне?)))
(перевірити-обернення-трійок
  (список (як-є атом?) (як-є решта) (як-є сполучити)
          (як-є тотожне?) (як-є хибне?))
  (список (як-є сполучити) (як-є решта) (як-є атом?)
          (як-є тотожне?) (як-є хибне?)))
(перевірити-обернення-трійок
  (список (як-є атом?) (як-є решта) (як-є сполучити)
          (як-є тотожне?) (як-є хибне?) (як-є список))
  (список (як-є сполучити) (як-є решта) (як-є атом?)
          (як-є список) (як-є хибне?) (як-є тотожне?)))
(перевірити-обернення-трійок
  (список (як-є атом?) (як-є атом?) (як-є решта)
          (як-є решта) (як-є решта) (як-є атом?))
  (список (як-є решта) (як-є атом?) (як-є атом?)
          (як-є атом?) (як-є решта) (як-є решта)))

; Вкладений список і порожній елемент зберігаються як неподільні дані.
(перевірити-обернення-трійок
  (список (список (як-є атом?) (як-є решта))
          (як-є ()) (як-є тотожне?) (як-є сполучити))
  (список (як-є тотожне?) (як-є ())
          (список (як-є атом?) (як-є решта)) (як-є сполучити)))

; Повна оборотність на двох трійках із хвостом та вкладеним елементом.
(визначити обернення-трійок-вхід
  (список (як-є атом?) (як-є решта) (як-є сполучити)
          (список (як-є тотожне?) (як-є хибне?))
          (як-є ()) (як-є список) (як-є функція)))
(перевірити-обернення-трійок
  (обернути-кожну-трійку обернення-трійок-вхід)
  обернення-трійок-вхід)

; Негатив: перестановка тільки двох елементів не може видати PASS.
(за-умовою
  ((хибне?
     (однакові-дерева-трійок?
       (обернути-кожну-трійку
         (список (як-є атом?) (як-є решта) (як-є сполучити)))
       (список (як-є решта) (як-є атом?) (як-є сполучити)))) так)
  (так (перше (як-є ()))))

(атом? (як-є ()))
