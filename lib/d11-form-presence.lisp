; Д11: 8 корисних історичних НАС-* - СЕНС-композиції над деревом форм.
; Аргумент - УЖЕ РОЗІБРАНИЙ СЕНС С-вираз, не байти і не файл.
; Відповідність - тільки голова форми у чинній повній укр-проєкції.
; Цитована форма виявляється, але всередину цитованих даних не заглядаємо.
; Д3 ЕК визначено для атомів: перед тотожне? завжди атом? для голови.
; Єдиний рекурсивний закон для всіх восьми предикатів; Д1:так і ні.
; Жодного самовільного коду чи викличного примітива Д11.

; Д3: форми мають закінчуватися лише структурним (), а не D1 ні.
; Перевіряємо весь вкладений D3-хребет до раннього збігу, крім цитованих даних.
(визначити підтвердити-правильний-список-форми
  (функція (поточний)
    (за-умовою
      ((атом? поточний)
       (за-умовою
         ((тотожне? поточний (як-є ())) так)
         (так (перше (як-є ())))))
      (так (підтвердити-правильний-список-форми
             (решта поточний))))))

; Повний D3-доказ ДО пошуку: поверхневий прохід перевіряв лише
; зовнішній список та міг повернути ТАК, не побачивши вкладений D1-хвіст.
; Цитовані дані не є формою — усередину QUOTE не спускаємося.
(визначити підтвердити-вкладені-списки-форм
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) так)
      ((атом? елементи) (перше елементи))
      ((підтвердити-правильне-дерево-форм (перше елементи))
       (підтвердити-вкладені-списки-форм (решта елементи))))))

(визначити підтвердити-правильне-дерево-форм
  (функція (форма)
    (за-умовою
      ((атом? форма) так)
      ((підтвердити-правильний-список-форми форма)
       (за-умовою
         ((атом? (перше форма))
          (за-умовою
            ((тотожне? (перше форма) (як-є як-є)) так)
            (так (підтвердити-вкладені-списки-форм (решта форма)))))
         (так (підтвердити-вкладені-списки-форм форма)))))))

; Пошук над доведеним деревом: не перевіряти всю структуру знову
; на кожному вкладеному виклику, інакше з'явиться квадратичний обхід.
; Голова списку не є автоматично новою формою у кожному решта.
(визначити містить-канонічну-голову-ядро?
  (функція (голова форма)
    (за-умовою
      ((атом? форма) ні)
      ((атом? (перше форма))
       (за-умовою
         ((тотожне? (перше форма) голова) так)
         ((тотожне? (перше форма) (як-є як-є)) ні)
         ((містить-канонічну-голову-в-елементах? голова (решта форма)) так)
         ((атом? (як-є ())) ні)))
      ((містить-канонічну-голову-в-елементах? голова форма) так)
      ((атом? (як-є ())) ні))))

; Єдиний публічний вхід восьми НАС-*.
(визначити містить-канонічну-голову?
  (функція (голова форма)
    (за-умовою
      ((підтвердити-правильне-дерево-форм форма)
       (містить-канонічну-голову-ядро? голова форма))
      (так ні))))

; Окремий обхід АРГУМЕНТІВ, не плутати з головою виклику.
(визначити містить-канонічну-голову-в-елементах?
  (функція (голова елементи)
    (за-умовою
      ((атом? елементи)
       (за-умовою
         ((тотожне? елементи (як-є ())) ні)
         (так (перше (як-є ())))))
      ; Атом-аргумент - дані, не вкладена виклична форма.
      ; Не передавати його рекурсивному аналізу голів (зокрема "перше").
      ((атом? (перше елементи))
       (містить-канонічну-голову-в-елементах? голова (решта елементи)))
      ((містить-канонічну-голову-ядро? голова (перше елементи)) так)
      ((містить-канонічну-голову-в-елементах? голова (решта елементи)) так)
      ((атом? (як-є ())) ні))))

; НАС-ДЕФІНЕ: проєкція спільного закону.
(визначити містить-форму-визначити?
  (функція (дерево)
    (містить-канонічну-голову? (як-є визначити) дерево)))

; НАС-ЛАМВДА: проєкція спільного закону.
(визначити містить-форму-функція?
  (функція (дерево)
    (містить-канонічну-голову? (як-є функція) дерево)))

; НАС-КУОТЕ: проєкція спільного закону.
(визначити містить-форму-цитування?
  (функція (дерево)
    (містить-канонічну-голову? (як-є як-є) дерево)))

; НАС-пари: проєкція спільного закону.
(визначити містить-форму-сполучити?
  (функція (дерево)
    (містить-канонічну-голову? (як-є сполучити) дерево)))

; НАС-перше: проєкція спільного закону.
(визначити містить-форму-перше?
  (функція (дерево)
    (містить-канонічну-голову? (як-є перше) дерево)))

; НАС-АТОМ: проєкція спільного закону.
(визначити містить-форму-атом?
  (функція (дерево)
    (містить-канонічну-голову? (як-є атом?) дерево)))

; НАС-ЕК: проєкція спільного закону.
(визначити містить-форму-тотожне?
  (функція (дерево)
    (містить-канонічну-голову? (як-є тотожне?) дерево)))

; НАС-СОНД: проєкція спільного закону.
(визначити містить-форму-умов?
  (функція (дерево)
    (містить-канонічну-голову? (як-є за-умовою) дерево)))
