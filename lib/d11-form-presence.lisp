; D11: 8 корисних історичних HAS-* — SENS-композиції над деревом форм.
; Аргумент — УЖЕ РОЗІБРАНИЙ SENS S-вираз, не байти і не файл.
; Відповідність — тільки голова форми у чинній повній укр-проєкції.
; Цитована форма виявляється, але всередину цитованих даних не заглядаємо.
; D3 EQ визначено для атомів: перед тотожне? завжди атом? для голови.
; Єдиний рекурсивний закон для всіх восьми предикатів; D1:так/ні.
; Жодного самовільного коду чи викличного примітива D11.

; ЄДИНА форма: голова списку не є автоматично новою формою в кожному CDR.
(визначити містить-канонічну-голову?
  (функція (голова форма)
    (за-умовою
      ((атом? форма) ні)
      ((атом? (перше форма))
       (за-умовою
         ((тотожне? (перше форма) голова) так)
         ((тотожне? (перше форма) (як-є як-є)) ні)
         ((містить-канонічну-голову-в-елементах? голова (решта форма)) так)
         ((атом? (як-є ())) ні)))
      ((містить-канонічну-голову-в-елементах? голова форма) так)
      ((атом? (як-є ())) ні))))

; Окремий обхід АРГУМЕНТІВ, не плутати з головою виклику.
(визначити містить-канонічну-голову-в-елементах?
  (функція (голова елементи)
    (за-умовою
      ((атом? елементи) ні)
      ; Атом-аргумент — дані, не вкладена виклична форма.
      ; Не передавати його рекурсивному аналізу голів (зокрема «перше»).
      ((атом? (перше елементи))
       (містить-канонічну-голову-в-елементах? голова (решта елементи)))
      ((містить-канонічну-голову? голова (перше елементи)) так)
      ((містить-канонічну-голову-в-елементах? голова (решта елементи)) так)
      ((атом? (як-є ())) ні))))

; HAS-DEFINE: проєкція спільного закону.
(визначити містить-форму-визначити?
  (функція (дерево)
    (містить-канонічну-голову? (як-є визначити) дерево)))

; HAS-LAMBDA: проєкція спільного закону.
(визначити містить-форму-функція?
  (функція (дерево)
    (містить-канонічну-голову? (як-є функція) дерево)))

; HAS-QUOTE: проєкція спільного закону.
(визначити містить-форму-цитування?
  (функція (дерево)
    (містить-канонічну-голову? (як-є як-є) дерево)))

; HAS-CONS: проєкція спільного закону.
(визначити містить-форму-сполучити?
  (функція (дерево)
    (містить-канонічну-голову? (як-є сполучити) дерево)))

; HAS-CAR: проєкція спільного закону.
(визначити містить-форму-перше?
  (функція (дерево)
    (містить-канонічну-голову? (як-є перше) дерево)))

; HAS-ATOM: проєкція спільного закону.
(визначити містить-форму-атом?
  (функція (дерево)
    (містить-канонічну-голову? (як-є атом?) дерево)))

; HAS-EQ: проєкція спільного закону.
(визначити містить-форму-тотожне?
  (функція (дерево)
    (містить-канонічну-голову? (як-є тотожне?) дерево)))

; HAS-COND: проєкція спільного закону.
(визначити містить-форму-умов?
  (функція (дерево)
    (містить-канонічну-голову? (як-є за-умовою) дерево)))

