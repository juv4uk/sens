; СЕНС: оборотне спарування двох двоелементних списків.
; Закон Д3/Д4: ((а б) (в г)) -> ((а . в) (б . г)) -> ((а б) (в г)).
; Це обмежений вивід із ПЕРШЕ, РЕШТА, СПОЛУЧИТИ та СПИСОК,
; а не новий машинний опкод чи право виклику всього домену Д6.
; Область визначення: два правильні списки рівно з двох елементів.

(визначити спарувати-два-списки
  (функція (ліві праві)
    (список
      (сполучити (перше ліві) (перше праві))
      (сполучити (друге ліві) (друге праві)))))

(визначити розпарувати-два-списки
  (функція (пари)
    (список
      (список (перше (перше пари)) (перше (друге пари)))
      (список (решта (перше пари)) (решта (друге пари))))))

(визначити початкові-ліві
  (список (як-є атом?) (як-є тотожне?)))
(визначити початкові-праві
  (список (як-є решта) (як-є сполучити)))
(визначити оборотні-пари
  (спарувати-два-списки початкові-ліві початкові-праві))
(визначити відновлені-двійки
  (розпарувати-два-списки оборотні-пари))

; Справжній SENS повертає Д1:1 тільки коли всі чотири значення
; збереглись у початковому порядку і негативна перестановка відхилена.
(за-умовою
  ((тотожне? (перше (перше відновлені-двійки)) (як-є атом?))
   (за-умовою
     ((тотожне? (друге (перше відновлені-двійки)) (як-є тотожне?))
      (за-умовою
        ((тотожне? (перше (друге відновлені-двійки)) (як-є решта))
         (за-умовою
           ((тотожне? (друге (друге відновлені-двійки)) (як-є сполучити))
            (хибне?
              (тотожне?
                (перше (друге відновлені-двійки))
                (як-є атом?))))
           ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
        ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
     ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))) 
