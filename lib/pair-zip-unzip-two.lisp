; СЕНС: оборотне спарування двох двоелементних списків.
; Закон Д3/Д4: ((а б) (в г)) -> ((а . в) (б . г)) -> ((а б) (в г)).
; Це обмежений вивід із ПЕРШЕ, РЕШТА та СПОЛУЧИТИ;
; а не новий машинний опкод чи право виклику всього домену Д6.
; Область визначення: два правильні списки рівно з двох елементів.

; Двоелементний список — похідна композиція D3:111, а не хостовий LIST.
(визначити утворити-двійку
  (функція (голова хвіст)
    (сполучити голова (сполучити хвіст (як-є ())))))

(визначити спарувати-два-списки
  (функція (ліві праві)
    (утворити-двійку
      (сполучити (перше ліві) (перше праві))
      (сполучити (перше (решта ліві)) (перше (решта праві))))))

(визначити розпарувати-два-списки
  (функція (пари)
    (утворити-двійку
      (утворити-двійку
        (перше (перше пари))
        (перше (перше (решта пари))))
      (утворити-двійку
        (решта (перше пари))
        (решта (перше (решта пари)))))))

(визначити початкові-ліві
  (утворити-двійку (як-є атом?) (як-є тотожне?)))
(визначити початкові-праві
  (утворити-двійку (як-є решта) (як-є сполучити)))
(визначити оборотні-пари
  (спарувати-два-списки початкові-ліві початкові-праві))
(визначити відновлені-двійки
  (розпарувати-два-списки оборотні-пари))

; Справжній SENS повертає Д1:1 тільки коли всі чотири значення
; збереглись у початковому порядку і негативна перестановка відхилена.
(за-умовою
  ((тотожне? (перше (перше відновлені-двійки)) (як-є атом?))
   (за-умовою
     ((тотожне? (перше (решта (перше відновлені-двійки))) (як-є тотожне?))
      (за-умовою
        ((тотожне? (перше (перше (решта відновлені-двійки))) (як-є решта))
         (за-умовою
           ((тотожне? (перше (решта (перше (решта відновлені-двійки)))) (як-є сполучити))
            (хибне?
              (тотожне?
                (перше (перше (решта відновлені-двійки)))
                (як-є атом?))))
           ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
        ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
     ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))))
  ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))))) 
