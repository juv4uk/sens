; Похідні сталі міжнародної системи одиниць.
; Використовуються визначальні величини з попередньо завантаженого файла.
; Формули обчислюються точно, без округлення та проміжних наближень.
; Людські числа записуються десятково, фізичне пакування виконується окремо.
; Це визначення значень, а не нові машинні функції або адреси доменів.

(визначити сі:стала-фарадея
  (помножити
    сі:стала-авогадро
    сі:елементарний-заряд))

(визначити сі:молярна-газова-стала
  (помножити
    сі:стала-авогадро
    сі:стала-больцмана))

(визначити сі:стала-джозефсона
  (частка
    (помножити 2 сі:елементарний-заряд)
    сі:стала-планка))

(визначити сі:стала-фон-клітцинга
  (частка
    сі:стала-планка
    (помножити сі:елементарний-заряд сі:елементарний-заряд)))

(визначити сі:квант-магнітного-потоку
  (частка
    сі:стала-планка
    (помножити 2 сі:елементарний-заряд)))

(визначити сі:квант-електричної-провідності
  (частка
    (помножити
      2
      (помножити сі:елементарний-заряд сі:елементарний-заряд))
    сі:стала-планка))

(визначити сі:молярна-стала-планка
  (помножити
    сі:стала-авогадро
    сі:стала-планка))
