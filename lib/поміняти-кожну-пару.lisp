; Оборотний обмін сусідніх пар у власному списку парної довжини.
; Похідний закон Д3 та Д4: жодного нового резидента чи хостового виконавця.
; Для порожнього списку маємо порожній; для парного — рекурсивні пари.
(визначити поміняти-кожну-пару
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (як-є ()))
       (сполучити (друге елементи)
         (сполучити (перше елементи)
           (поміняти-кожну-пару (решта-решти елементи))))))))

(визначити початкова-шістка
  (список (як-є атом?) (як-є тотожне?) (як-є сполучити)
          (як-є решта) (як-є за-умовою) (як-є порожній?)))
(визначити переставлена-шістка
  (поміняти-кожну-пару початкова-шістка))
(визначити відновлена-шістка
  (поміняти-кожну-пару переставлена-шістка))

; Виконує сам СЕНС: порожній базис, шість позицій, інволюція та негатив.

(за-умовою
  ((порожній? (поміняти-кожну-пару (як-є ())))
   (за-умовою
  ((тотожне? (перше переставлена-шістка) (як-є тотожне?))
   (за-умовою
  ((тотожне? (друге переставлена-шістка) (як-є атом?))
   (за-умовою
  ((тотожне? (перше (решта-решти переставлена-шістка)) (як-є решта))
   (за-умовою
  ((тотожне? (друге (решта-решти переставлена-шістка)) (як-є сполучити))
   (за-умовою
  ((тотожне? (перше (решта-решти (решта-решти переставлена-шістка))) (як-є порожній?))
   (за-умовою
  ((тотожне? (друге (решта-решти (решта-решти переставлена-шістка))) (як-є за-умовою))
   (за-умовою
  ((тотожне? (перше відновлена-шістка) (як-є атом?))
   (за-умовою
  ((тотожне? (друге відновлена-шістка) (як-є тотожне?))
   (за-умовою
  ((тотожне? (перше (решта-решти (решта-решти відновлена-шістка))) (як-є за-умовою))
   (за-умовою
  ((хибне? (тотожне? (перше переставлена-шістка) (як-є атом?)))
   (за-умовою
  ((тотожне? (перше (поміняти-кожну-пару (список (як-є атом?) (як-є тотожне?)))) (як-є тотожне?))
   (атом? (як-є ())))
  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ())))))

; Контроль повної інволюції: середні позиції та точний NIL-хвіст.
(за-умовою
  ((тотожне? (перше (решта (решта відновлена-шістка))) (як-є сполучити)) (за-умовою
  ((тотожне? (перше (решта (решта (решта відновлена-шістка)))) (як-є решта)) (за-умовою
  ((порожній? (решта (решта (решта (решта (решта (решта відновлена-шістка))))))) (атом? (як-є ())))
  ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
