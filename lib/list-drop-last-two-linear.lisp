; Лінійно відкинути два останні елементи списку без хостової семантики.
(визначити без-двох-останніх
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((порожній? (решта елементи)) (як-є ()))
      ((порожній? (решта (решта елементи))) (як-є ()))
      (так (сполучити (перше елементи) (без-двох-останніх (решта елементи)))))))
(без-двох-останніх (список 1 2 3 4 5))
