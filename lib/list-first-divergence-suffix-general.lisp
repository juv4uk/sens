; Конкурс: перше розходження двох скінченних списків атомів.
; Замість створення спільного префіксу чи копії хвостів рухаємо два вказівники.
; Створюємо тільки пару двох вихідних хвостів; самі хвости не копіюємо.
; Час О(довжина спільного префіксу + 1); рекурсивний стек О(цього префіксу).
; Семантика належить СЕНС Д3 і Д4 і Д5. Д7 - лише людська проєкція;
; Зіг і Т5М - виключно оборотний фізичний транспорт.

(визначити хвости-першого-розходження
  (функція (лівий правий)
    (за-умовою
      ((порожній? лівий) (список лівий правий))
      ((порожній? правий) (список лівий правий))
      ((тотожне? (перше лівий) (перше правий))
       (хвости-першого-розходження (решта лівий) (решта правий)))
      (так (список лівий правий)))))

(визначити однакові-дерева-розходження?
  (функція (лівий правий)
    (за-умовою
      ((порожній? лівий) (порожній? правий))
      ((порожній? правий) ні)
      ((атом? лівий)
       (за-умовою
         ((атом? правий) (тотожне? лівий правий))
         (так ні)))
      ((атом? правий) ні)
      ((однакові-дерева-розходження? (перше лівий) (перше правий))
       (однакові-дерева-розходження? (решта лівий) (решта правий)))
      (так ні))))

