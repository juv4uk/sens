; #801 — мінімальний планувальник координації LIFE-1.
;
; Стан планувальника є звичайними даними Lisp. Він визначає лише
; момент активації; не тлумачить семантику Prolog, Datalog, CLIPS
; або Common Lisp.
;
; Форма очікуваного виклику (поля чинного протоколу не перекладати):
;   (pending-invocation
;     (producer datalog)
;     (trigger (projection-ready prolog-substitutions-to-datalog-facts))
;     (provenance-ref observation-42)
;     (priority ordinary)
;     (semantic-id додати)) ; чинна повна «укр» проєкція функції D5:01010
; Назва поля semantic-id є частиною зовнішнього протоколу; її не змінюємо.
; Значення використовує лише повну українську проєкцію «додати» домену Д5.
; У цьому модулі значення лише порівнюється як частина ключа, не виконується.
;
; Форма сповіщення про готовність проєкції:
;   (projection-ready
;     prolog-substitutions-to-datalog-facts
;     observation-42)
;
; Стан спокою описує життєвість і керування, а не логічну істину.
; Латинські назви всередині прикладів — точні значення протоколу
; обміну; їх не можна заміняти без одночасної зміни споживачів.
;
; Точне структурне порівняння ключів рою не виводить тотожність із самих бітів.
; Однакове бітове слово в різних доменах не робить тотожності однаковими.
; Використано українські назви чинних функцій: атом?, тотожне?, перше, решта, за-умовою;
; Відповідь — виключно значення істини/хиби домену Д1.
; Вхідне поле зовнішнього протоколу має ключ trigger; «умова-запуску» — локальне ім'я.
; Атоми порівнюються перед викликом тотожне?, пари — рекурсивно.
(визначити життя--рівні?
  (функція (ліве праве)
    (за-умовою
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (тотожне? ліве праве))
         ((атом? (як-є ())) ні)))
      ((атом? праве) ні)
      ((життя--рівні? (перше ліве) (перше праве))
       (життя--рівні? (решта ліве) (решта праве)))
      ((атом? (як-є ())) ні))))

; Іменовані D4 замикання замість двох анонімних D5 value-call.
; D3 перевірки, обхід запису та позначки протоколу збережено.
(визначити життя-поле-запису-продовжити
  (функція (запис поле рядки)
    (життя-поле-запису
      (сполучити (перше запис) (решта рядки)) поле)))

(визначити життя-поле-запису-рядок
  (функція (запис поле рядки рядок)
    (за-умовою
      ((атом? рядок)
       (життя-поле-запису-продовжити запис поле рядки))
      ((хибне? (атом? рядок))
       (за-умовою
         ; Лише рівно (ключ значення): без порожнього,
         ; зайвого або крапкового хвоста.
         ((атом? (решта рядок)) (як-є absent))
         ((хибне? (атом? (решта рядок)))
          (за-умовою
            ((життя--рівні? (решта (решта рядок)) (як-є ()))
             (за-умовою
               ((життя--рівні? поле (перше рядок))
                (перше (решта рядок)))
               ((хибне? (життя--рівні? поле (перше рядок)))
                (життя-поле-запису-продовжити запис поле рядки))))
            ((хибне? (життя--рівні? (решта (решта рядок)) (як-є ())))
             (як-є absent)))))))))

(визначити життя-поле-запису-рядки
  (функція (запис поле рядки)
    (за-умовою
      ((хибне? (атом? рядки))
       (життя-поле-запису-рядок запис поле рядки (перше рядки))))))

(визначити життя-поле-запису
  (функція (запис поле)
    (за-умовою
      ((хибне? (атом? запис))
       (життя-поле-запису-рядки запис поле (решта запис))))))

(визначити життя-ключ-виклику
  (функція (виклик)
    (список
      (життя-поле-запису виклик (як-є producer))
      (життя-поле-запису виклик (як-є trigger))
      (життя-поле-запису виклик (як-є provenance-ref))
      (життя-поле-запису виклик (як-є semantic-id)))))

(визначити життя-ключ-присутній?
  (функція (ключ ключі)
    (за-умовою
      ((атом? ключі) (як-є absent))
      ((хибне? (атом? ключі))
       (за-умовою
         ((життя--рівні? ключ (перше ключі))  (як-є present))
         ((хибне? (життя--рівні? ключ (перше ключі)))
          (життя-ключ-присутній? ключ (решта ключі))))))))

(визначити життя-очікування-без-повторів
  (функція (очікування відомі-ключі)
    (за-умовою
      
      ((хибне? (атом? очікування))
       (нехай-послідовно ((виклик (перше очікування))
              (ключ (життя-ключ-виклику виклик)))
         (за-умовою
           ((тотожне? (життя-ключ-присутній? ключ відомі-ключі) (як-є present))
            
            (життя-очікування-без-повторів (решта очікування) відомі-ключі))
           ((тотожне? (життя-ключ-присутній? ключ відомі-ключі) (як-є absent))
            
            (сполучити виклик
                  (життя-очікування-без-повторів
                    (решта очікування)
                    (сполучити ключ відомі-ключі))))))))))

(визначити життя-очікування
  (функція (очікування)
    (життя-очікування-без-повторів очікування (як-є ()))))

; Проєкцію порівнює безпосередньо SENS D3 COND: лише іменована
; функція, жодного D5 value-call через анонімне замикання.
(визначити життя-збіг-проєкції?
  (функція (очікувана-проєкція проєкції)
    (за-умовою
      ((атом? проєкції) (як-є absent))
      ((життя--рівні? очікувана-проєкція (перше проєкції))
       (як-є present))
      ((атом? (як-є ()))
       (життя-збіг-проєкції? очікувана-проєкція (решта проєкції))))))

; Визначення готовності — іменована семантика SENS.
; Не викликаємо анонімну FUNCTION як значення D5.
(визначити життя-проєкція-готова?
  (функція (виклик проєкції)
    (нехай-послідовно
      ((умова-запуску (життя-поле-запису виклик (як-є trigger)))
       (джерело-походження (життя-поле-запису виклик (як-є provenance-ref))))
      (за-умовою
        ((атом? умова-запуску) (як-є absent))
        ((атом? (решта умова-запуску)) (як-є absent))
        ((атом? (як-є ()))
         (життя-збіг-проєкції?
           (список
             (як-є projection-ready)
             (перше (решта умова-запуску))
             джерело-походження)
           проєкції))))))

; Вибір готового виклику — іменована D4-функція з прямим D3 COND.
; Немає повторного D9-виклику в окремій негативній гілці чи D5 value-call.
(визначити життя-обрати-готове
  (функція (очікування проєкції)
    (за-умовою
      ((атом? очікування)
       (як-є (scheduler-selection none)))
      ((тотожне?
         (життя-проєкція-готова? (перше очікування) проєкції)
         (як-є present))
       (список
         (як-є scheduler-selection)
         (як-є ready)
         (перше очікування)
         (решта очікування)))
      ((атом? (як-є ()))
       (життя-обрати-готове (решта очікування) проєкції)))))

(визначити життя-стан-спокою
  (функція (проєкції стан-життєвого-циклу)
    (за-умовою
      ((атом? проєкції)
       (за-умовою
         ((тотожне? стан-життєвого-циклу (як-є no-transition-required))
          
          (як-є (quiescence-state quiescent)))
         ((хибне? (тотожне? стан-життєвого-циклу (як-є no-transition-required)))
          (як-є (quiescence-state active)))))
      ((хибне? (атом? проєкції))
       (як-є (quiescence-state active))))))

(визначити життя-спокій
  (функція (очікування проєкції стан-життєвого-циклу)
    (за-умовою
      ((атом? очікування)
       (життя-стан-спокою проєкції стан-життєвого-циклу))
      ((хибне? (атом? очікування))
       (як-є (quiescence-state active))))))
(визначити життя-стан-планувальника
  (функція (очікування проєкції стан-життєвого-циклу)
    (список
      (як-є scheduler-state)
      (список (як-є очікування) (життя-очікування очікування))
      (список (як-є проєкції) проєкції)
      (список (як-є lifecycle) стан-життєвого-циклу)
      (життя-спокій
        (життя-очікування очікування)
        проєкції
        стан-життєвого-циклу))))
