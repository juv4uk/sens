    (за-умовою
  ((тотожне? (перше (решта (решта (решта сплющені-для-перевірки)))) (як-є тотожне?))
    (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта сплющені-для-перевірки))))) (як-є за-умовою))
    (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта (решта сплющені-для-перевірки)))))) (як-є як-є))
    (за-умовою
  ((атом? (решта (решта (решта (решта (решта (решта сплющені-для-перевірки)))))))
    (за-умовою
  ((атом? (сплющити-вкладений-список (як-є ())))
