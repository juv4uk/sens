  ((хибне? (тотожне? (перше (решта сплющені-для-перевірки)) (як-є атом?)))
    (за-умовою
  ((хибне? (атом? сплющені-для-перевірки))
    (за-умовою
  ((хибне? (тотожне? (перше (решта збережені-повтори)) (як-є решта)))
