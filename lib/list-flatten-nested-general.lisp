; Скінченні правильні вкладені списки: сплющити до атомів без втрати порядку.
; Закон: сплющити(())=(); сплющити(()::хс)=сплющити(хс);
; сплющити(а::хс)=а::сплющити(хс) для непорожнього атома а;
; сплющити(ус::хс)=дописати(сплющити(ус),сплющити(хс)) для списку ус.
; Порожні вкладення вилучаються через СЕНС-предикат, повторні атоми зберігаються.
; Виконує СЕНС Д3-Д5, Зіг пакує тільки фізичний Т5М.

(визначити додати-після-сплющення
  (функція (перші другі)
    (за-умовою
      ((атом? перші) другі)
      ((атом? (як-є ()))
        (сполучити (перше перші)
          (додати-після-сплющення (решта перші) другі))))))

(визначити сплющити-вкладений-список
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (перше елементи))
        (за-умовою
          ((порожній? (перше елементи))
            (сплющити-вкладений-список (решта елементи)))
          ((атом? (як-є ()))
            (сполучити (перше елементи)
              (сплющити-вкладений-список (решта елементи))))))
      ((атом? (як-є ()))
        (додати-після-сплющення
          (сплющити-вкладений-список (перше елементи))
          (сплющити-вкладений-список (решта елементи)))))))

(визначити вкладені-для-перевірки
  (список
    (список (як-є атом?) (як-є решта))
    (як-є ())
    (як-є сполучити)
    (список (як-є тотожне?)
      (список (як-є за-умовою) (як-є як-є)))))
(визначити сплющені-для-перевірки
  (сплющити-вкладений-список вкладені-для-перевірки))
(визначити тільки-вкладений-атом
  (сплющити-вкладений-список
    (список (як-є ()) (список (як-є ()))
      (список (список (як-є атом?))))))
(визначити плоскі-атомі
  (сплющити-вкладений-список
    (список (як-є атом?) (як-є решта))))
(визначити збережені-повтори
  (сплющити-вкладений-список
    (список (як-є атом?) (список (як-є атом?)) (як-є ()))))

; 20 живих Д1-свідків: усі позиції, базис, вкладені порожній, повтори, негативи.
; При хибності будь-якого свідка СЕНС виконує перше порожній і завершує з помилкою.
(за-умовою
  ((тотожне? (перше сплющені-для-перевірки) (як-є атом?))
