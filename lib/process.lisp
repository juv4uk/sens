; Інтерпретація текстового результату процесу належить мові СЕНС.
; Зовнішній виконавець запускає дозволені процеси й повертає сирі байти.
; Спільний мовний декодер визначає точні результати та відмови.
; Умовні форми мають дві частини, а істина належить першому домену.
; Використовується спільне визначення перевірки декодування.
; Бібліотеку кодування потрібно завантажити перед цим файлом.

(визначити отримати-сирий-код-виходу-процесу
  (функція (сирий-результат)
    (друге сирий-результат)))

(визначити отримати-сирі-байти-виводу-процесу
  (функція (сирий-результат)
    (третє сирий-результат)))

(визначити отримати-сирі-байти-помилок-процесу
  (функція (сирий-результат)
    (перше (решта (решта (решта сирий-результат))))))

; Зовнішні старі імена прив'язуються до тих самих значень, без другої реалізації.
(визначити process-raw-exit-code отримати-сирий-код-виходу-процесу)
(визначити process-raw-stdout-bytes отримати-сирі-байти-виводу-процесу)
(визначити process-raw-stderr-bytes отримати-сирі-байти-помилок-процесу)

(визначити процес-результат-текст
  (функція (сирий-результат)
    (за-умовою
      ((хибне? (тотожне? (перше сирий-результат) (як-є process-result)))
       (список (як-є rejected) (як-є invalid-process-result)))
      ((тотожне? (перше сирий-результат) (як-є process-result))
       ((функція (результат-виводу результат-помилок)
        (за-умовою
           ((хибне? (успішно-декодовано? результат-виводу))
            (список (як-є rejected) (як-є stdout-invalid-utf8)))
           ((успішно-декодовано? результат-виводу)
            (за-умовою
              ((хибне? (успішно-декодовано? результат-помилок))
               (список (як-є rejected) (як-є stderr-invalid-utf8)))
              ((успішно-декодовано? результат-помилок)
               (список
                 (як-є decoded-process)
                 (отримати-сирий-код-виходу-процесу сирий-результат)
                 (друге результат-виводу)
                 (друге результат-помилок)))
              (так
               (список (як-є rejected) (як-є stderr-invalid-utf8)))))
           (так
            (список (як-є rejected) (як-є stdout-invalid-utf8)))))
       (кодування-юнікод-8-декодувати-рядок (отримати-сирі-байти-виводу-процесу сирий-результат))
       (кодування-юнікод-8-декодувати-рядок (отримати-сирі-байти-помилок-процесу сирий-результат))))
      (так
       (список (як-є rejected) (як-є invalid-process-result))))))

(визначити процес-запустити-текст
  (функція (програма аргументи)
    (процес-результат-текст (process-run-raw програма аргументи))))

; Зовнішня сумісна поверхня повертає три поля для належного тексту.
; Пошкоджене кодування повертає явну відмову.
(визначити процес-публічний-вихід-код
  (функція (код)
    (за-умовою
      ((тотожне? код (як-є ())) -1)
      ((хибне? (тотожне? код (як-є ()))) код)
      (так -1))))

(визначити процес-запустити
  (функція (програма аргументи)
    ((функція (результат)
        (за-умовою
        ((тотожне? (перше результат) (як-є decoded-process))
         (список
           (процес-публічний-вихід-код (друге результат))
           (третє результат)
           (перше (решта (решта (решта результат))))))
        ((хибне? (тотожне? (перше результат) (як-є decoded-process)))
         результат)
        (так результат)))
       (процес-запустити-текст програма аргументи))))

; Додаткові публічні назви визначає чинне зв'язування з реєстру.
; Файл не створює нової машинної тотожності.
(як-є (postcore-materialization-debug skipped))
