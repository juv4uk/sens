; Інтерпретація текстового результату процесу належить мові СЕНС.
; Зовнішній виконавець запускає дозволені процеси й повертає сирі байти.
; Спільний мовний декодер визначає точні результати та відмови.
; Умовні форми мають рівно два поля; результати визначає Lisp/SENS.
; Бібліотеку кодування потрібно завантажити перед цим файлом.
; Іменовані D4-функції усувають залежність раннього T5M-bootstrap від
; D6 НЕХАЙ-ПОСЛІДОВНО; байти та семантику статусів не визначає Rust.

(визначити процес-скласти-декодований
  (функція (сирий-результат результат-виводу результат-помилок)
    (за-умовою
      ((однакові? (перше результат-виводу) (як-є decoded))
       (за-умовою
         ((однакові? (перше результат-помилок) (як-є decoded))
          (список
            (як-є decoded-process)
            (друге сирий-результат)
            (друге результат-виводу)
            (друге результат-помилок)))
         ((атом? (як-є ()))
          (список (як-є rejected) (як-є stderr-invalid-utf8)))))
      ((атом? (як-є ()))
       (список (як-є rejected) (як-є stdout-invalid-utf8))))))

(визначити процес-результат-текст
  (функція (сирий-результат)
    (за-умовою
      ((однакові? (перше сирий-результат) (як-є process-result))
       (процес-скласти-декодований
         сирий-результат
         (кодування-юнікод-8-декодувати-рядок
           (третє сирий-результат))
         (кодування-юнікод-8-декодувати-рядок
           (перше (решта (решта (решта сирий-результат)))))))
      ((атом? (як-є ()))
       (список (як-є rejected) (як-є invalid-process-result))))))

(визначити процес-запустити-текст
  (функція (назва-виконуваного-файла перелік-вхідних-значень)
    (процес-результат-текст
      (процес-запустити-сирий назва-виконуваного-файла перелік-вхідних-значень))))

; Зовнішня сумісна поверхня повертає три поля для належного тексту.
; Пошкоджене кодування повертає явну відмову.
(визначити процес-публічний-вихід-код
  (функція (код)
    (за-умовою
      ((тотожне? код (як-є ())) (відняти (довжина (як-є ())) (довжина (як-є (а)))))
      ((атом? (як-є ())) код))))

(визначити процес-розгорнути-публічний-результат
  (функція (результат)
    (за-умовою
      ((однакові? (перше результат) (як-є decoded-process))
       (список
         (процес-публічний-вихід-код (друге результат))
         (третє результат)
         (перше (решта (решта (решта результат))))))
      ((атом? (як-є ())) результат))))

(визначити процес-запустити
  (функція (назва-виконуваного-файла перелік-вхідних-значень)
    (процес-розгорнути-публічний-результат
      (процес-запустити-текст
        назва-виконуваного-файла перелік-вхідних-значень))))

; Додаткові публічні назви визначає чинне зв'язування з реєстру.
; Файл не створює нової машинної тотожності.
(як-є (postcore-materialization-debug skipped))
