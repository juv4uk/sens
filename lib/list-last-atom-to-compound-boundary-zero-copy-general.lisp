; СЕНС: суфікс після останньої межі "атом, складена пара".
; Одна хода по вихідному правильному списку: порядку н часу.
; Результат - наявний хвіст, жодної нової пари не створюється.
; Ратифіковані Д3-Д5; Д7 тільки для назв, без історичних машинних голів.

(визначити знайти-останню-межу-атома-і-пари
 (функція (залишок останній)
  (за-умовою
   ((атом? залишок) останній)
   ((атом? (решта залишок)) останній)
   ((хибне? (атом? (перше залишок)))
    (знайти-останню-межу-атома-і-пари (решта залишок) останній))
   ((хибне? (атом? (друге залишок)))
    (знайти-останню-межу-атома-і-пари (решта залишок) (решта залишок)))
   (так
    (знайти-останню-межу-атома-і-пари (решта залишок) останній)))))

(визначити суфікс-після-останньої-межі-атома-і-пари
 (функція (елементи)
  (знайти-останню-межу-атома-і-пари елементи (як-є ()))))

; Справжній структурний оракул на СЕНС: Д3 тотожне? лише для атомів.
(визначити рівні-дерева-межі-атома-і-пари?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((рівні-дерева-межі-атома-і-пари? (перше ліве) (перше праве))
    (рівні-дерева-межі-атома-і-пари? (решта ліве) (решта праве)))
   (так ні))))

(визначити довести-межу-атома-і-пари
 (функція (вхід очікуване)
  (за-умовою
   ((рівні-дерева-межі-атома-і-пари?
     (суфікс-після-останньої-межі-атома-і-пари вхід) очікуване) так)
   (так (перше (як-є ()))))))

(визначити спростувати-межу-атома-і-пари
 (функція (вхід хибне-очікуване)
  (за-умовою
   ((хибне? (рівні-дерева-межі-атома-і-пари?
     (суфікс-після-останньої-межі-атома-і-пари вхід)
     хибне-очікуване)) так)
   (так (перше (як-є ()))))))

; Не викликати РЕШТА від атома: джерело та відкритий хвіст.
; Це справжні виконувані свідки СЕНС; помилка доходить до ПЕРШЕ ().
(довести-межу-атома-і-пари (як-є атом?) (як-є ()))
(довести-межу-атома-і-пари
 (сполучити (як-є атом?) (як-є решта)) (як-є ()))

; Межі порожнього та одиничного списків.
(довести-межу-атома-і-пари (як-є ()) (як-є ()))
(довести-межу-атома-і-пари
 (список (як-є атом?)) (як-є ()))
(довести-межу-атома-і-пари
 (список (список (як-є атом?))) (як-є ()))
; Два атоми або дві складені пари не є шуканою межею.
(довести-межу-атома-і-пари
 (список (як-є атом?) (як-є решта)) (як-є ()))
(довести-межу-атома-і-пари
 (список (список (як-є атом?)) (список (як-є решта)))
 (як-є ()))

; Межа на початку або в кінці, без копіювання складеної структури.
(довести-межу-атома-і-пари
 (список (як-є атом?) (список (як-є решта)))
 (список (список (як-є решта))))
(довести-межу-атома-і-пари
 (список (як-є атом?) (список (як-є решта)) (як-є функція))
 (список (список (як-є решта)) (як-є функція)))
(довести-межу-атома-і-пари
 (список (список (як-є атом?)) (як-є решта) (список (як-є функція)))
 (список (список (як-є функція))))
; Дві межі: брати останню, а не першу.
(довести-межу-атома-і-пари
 (список (як-є атом?) (список (як-є решта))
         (як-є сполучити) (список (як-є функція)) (як-є тотожне?))
 (список (список (як-є функція)) (як-є тотожне?)))
; порожній усередині правильного списку є атомом і також утворює межу.
(довести-межу-атома-і-пари
 (список (як-є ()) (список (як-є решта)) (список (як-є функція)))
 (список (список (як-є решта)) (список (як-є функція))))

; Негативні свідки викривають вигадану межу і вибір першої замість останньої.
(спростувати-межу-атома-і-пари
 (список (як-є атом?) (як-є решта))
 (список (як-є решта)))
(спростувати-межу-атома-і-пари
 (список (як-є атом?) (список (як-є решта))
         (як-є сполучити) (список (як-є функція)))
 (список (список (як-є решта)) (як-є сполучити)
         (список (як-є функція))))

(атом? (як-є ()))
