; Д11: однозначний пошук як ПОХІДНА композиція SENS.
; Статус: бібліотечна функція, не новий ратифікований код D11.
; Контракт 12.0: Д1 має тільки так/ні; Д3:000 () є пустим списком.
; Рівно один збіг: повернути вихідний об'єкт, без жодного копіювання.
; Нуль або два й більше збігів: повернути (); не вдавати впевненість.
; Неправильний список: D3 ПЕРШЕ Type, а не "не знайдено".
; Користувацький предикат повинен повертати точний Д1, інакше COND Type.
;
; Перед застосуванням предиката перевірити ВСЕ скінченне D3-хребет.
; Попереднє підтвердження не дозволяє ранньому збігу приховати
; пізній неправильний хвіст, зокрема Д1:ні замість Д3:().
(визначити підтвердити-список-однозначного-пошуку
  (функція (поточний початковий)
    (за-умовою
      ((порожній? поточний) початковий)
      ((атом? поточний) (перше поточний))
      (так
       (підтвердити-список-однозначного-пошуку
         (решта поточний) початковий)))))

; Вже-є — точний Д1. Кандидат не порівнюємо з D3:(),
; бо допустимими ДАНИМИ можуть бути і (), і Д1:ні.
; Не кликати користувацький предикат після другого позитивного збігу.
(визначити єдиний-відповідний-елемент-ядро
  (функція (умова залишок вже-є кандидат)
    (за-умовою
      ((порожній? залишок)
       (за-умовою
         (вже-є кандидат)
         (так (як-є ()))))
      ((умова (перше залишок))
       (за-умовою
         (вже-є (як-є ()))
         (так
          (єдиний-відповідний-елемент-ядро
            умова (решта залишок) так (перше залишок)))))
      (так
       (єдиний-відповідний-елемент-ядро
         умова (решта залишок) вже-є кандидат)))))

(визначити єдиний-відповідний-елемент
  (функція (умова елементи)
    (єдиний-відповідний-елемент-ядро
      умова
      (підтвердити-список-однозначного-пошуку елементи елементи)
      ні
      (як-є ()))))

; Д11: пояснення за окремим запитом, без зміни швидкої відповіді ().
; Локальні маркери є ДАНИМИ похідного протоколу, НЕ новими кодами D11.
; (єдиний значення) — рівно один збіг у доведеному скінченному списку.
; (немає) — жодного збігу ТІЛЬКИ в цьому скінченному списку.
; (кілька) — знайдено щонайменше два збіги, єдиність спростована.
; Знайдене значення може бути () або Д1:ні без втрати цього факту.
; Не ототожнювати (немає) із доказом глобальної відсутності в світі.
; Повна перевірка D3-хребта завжди передує викликам предиката.
(визначити стан-однозначного-пошуку-ядро
  (функція (умова залишок вже-є кандидат)
    (за-умовою
      ((порожній? залишок)
       (за-умовою
         (вже-є (список (як-є єдиний) кандидат))
         (так (список (як-є немає)))))
      ((умова (перше залишок))
       (за-умовою
         (вже-є (список (як-є кілька)))
         (так
          (стан-однозначного-пошуку-ядро
            умова (решта залишок) так (перше залишок)))))
      (так
       (стан-однозначного-пошуку-ядро
         умова (решта залишок) вже-є кандидат)))))

(визначити стан-однозначного-пошуку
  (функція (умова елементи)
    (стан-однозначного-пошуку-ядро
      умова
      (підтвердити-список-однозначного-пошуку
        елементи елементи)
      ні
      (як-є ()))))

; Д11: за ОКРЕМИМ запитом два фактичні свідки неоднозначності.
; Жодного нового opcode, третьої істини чи глобального заперечення.
; Результат: (немає), (єдиний значення), (кілька перший другий).
; Прапорець знайдено — тільки D1; значення () та D1:ні є даними.
; Повний D3-preflight має випереджати предикат.
(визначити підстави-однозначного-пошуку-ядро
  (функція (умова залишок знайдено перший)
    (за-умовою
      ((порожній? залишок)
       (за-умовою
         (знайдено (список (як-є єдиний) перший))
         (так (список (як-є немає)))))
      ((умова (перше залишок))
       (за-умовою
         (знайдено
          (список (як-є кілька) перший (перше залишок)))
         (так
          (підстави-однозначного-пошуку-ядро
            умова (решта залишок) так (перше залишок)))))
      (так
       (підстави-однозначного-пошуку-ядро
         умова (решта залишок) знайдено перший)))))

(визначити підстави-однозначного-пошуку
  (функція (умова елементи)
    (підстави-однозначного-пошуку-ядро
      умова
      (підтвердити-список-однозначного-пошуку
        елементи елементи)
      ні
      (як-є ()))))
