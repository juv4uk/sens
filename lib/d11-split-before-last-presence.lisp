; Д11: поділ правильного D3-списку перед ОСТАННІМ збігом.
; Результат (так (префікс суфікс)), інакше (ні (вхід ())).
; Суфікс є оригінальним хвостом; не копіюється.
; Предикат чистий, обхід справа наліво до останнього збігу.
; Валідація D3 походить із lib/d11-srfi1-find-presence.lisp.
; Не створюється машинний opcode або D24-індекс.

(визначити продовжити-розділ-останнього-збігу
  (функція (умова елементи правий)
    (за-умовою
      ((перше правий)
       (список так
         (список
           (сполучити (перше елементи) (перше (друге правий)))
           (друге (друге правий)))))
      ((умова (перше елементи))
       (список так (список (як-є ()) елементи)))
      (так
       (список ні
         (список
           (сполучити (перше елементи) (перше (друге правий)))
           (як-є ())))))))

(визначити розділити-перед-останнім-збігом-ядро
  (функція (умова елементи)
    (за-умовою
      ((порожній? елементи)
       (список ні (список (як-є ()) (як-є ()))))
      (так
       (продовжити-розділ-останнього-збігу
         умова елементи
         (розділити-перед-останнім-збігом-ядро
           умова (решта елементи)))))))

(визначити розділити-перед-останнім-збігом
  (функція (умова елементи)
    (розділити-перед-останнім-збігом-ядро
      умова
      (перевірити-список-для-наявності елементи елементи))))
