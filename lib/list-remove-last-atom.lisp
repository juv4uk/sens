; Видалити ОСТАННЄ входження атома зі скінченного власного списку.
; Проміжний точний стан є Д3-парою: (Д1 знайдено? . Д3 список).
; Повернення праворуч-ліворуч зберігає всі попередні повтори і порядок.
; Ні Д6 ЛЕТ, ні зовнішнє-ЕКУАЛ, ні нового коду домену.
(визначити вилучити-останній-атом-далі
  (функція (голова шукане пізніший-стан)
    (за-умовою
      ((перше пізніший-стан)
       (сполучити (перше пізніший-стан)
         (сполучити голова (решта пізніший-стан))))
      ((тотожне? голова шукане)
       (сполучити (атом? (як-є ())) (решта пізніший-стан)))
      ((атом? (як-є ()))
       (сполучити (хибне? (атом? (як-є ())))
         (сполучити голова (решта пізніший-стан)))))))

(визначити вилучити-останній-атом-стан
  (функція (елементи шукане)
    (за-умовою
      ((атом? елементи)
       (сполучити (хибне? (атом? (як-є ()))) (як-є ())))
      ((атом? (як-є ()))
       (вилучити-останній-атом-далі
         (перше елементи) шукане
         (вилучити-останній-атом-стан (решта елементи) шукане))))))

(визначити вилучити-останній-атом
  (функція (елементи шукане)
    (решта (вилучити-останній-атом-стан елементи шукане))))

(визначити початкова-шістка
  (список (як-є атом?) (як-є тотожне?) (як-є атом?)
          (як-є решта) (як-є атом?) (як-є сполучити)))
(визначити скорочена-п'ятірка
  (вилучити-останній-атом початкова-шістка (як-є атом?)))
(визначити незмінна-пара
  (вилучити-останній-атом
    (список (як-є решта) (як-є сполучити)) (як-є атом?)))
(визначити прибрана-голова
  (вилучити-останній-атом
    (список (як-є атом?) (як-є решта) (як-є сполучити)) (як-є атом?)))
(визначити прибрана-середина
  (вилучити-останній-атом
    (список (як-є решта) (як-є атом?) (як-є сполучити)) (як-є атом?)))
(визначити скорочена-трійка
  (вилучити-останній-атом
    (список (як-є атом?) (як-є атом?) (як-є атом?)) (як-є атом?)))

; 23 живі точні Д1 перевірки. Неудача = нативна помилка перше порожній,
; тільки сам СЕНС виконує закон і перевіряє негативні сценарії.
(за-умовою
  ((тотожне? (перше скорочена-п'ятірка) (як-є атом?))
   (за-умовою
     ((тотожне? (друге скорочена-п'ятірка) (як-є тотожне?))
      (за-умовою
        ((тотожне? (третє скорочена-п'ятірка) (як-є атом?))
         (за-умовою
           ((тотожне? (четверте скорочена-п'ятірка) (як-є решта))
            (за-умовою
              ((тотожне? (перше (решта (решта (решта (решта скорочена-п'ятірка))))) (як-є сполучити))
               (за-умовою
                 ((порожній? (решта (решта (решта (решта (решта скорочена-п'ятірка))))))
                  (за-умовою
                    ((хибне? (тотожне? (третє скорочена-п'ятірка) (як-є решта)))
                     (за-умовою
                       ((тотожне? (перше незмінна-пара) (як-є решта))
                        (за-умовою
                          ((тотожне? (друге незмінна-пара) (як-є сполучити))
                           (за-умовою
                             ((порожній? (решта (решта незмінна-пара)))
                              (за-умовою
                                ((порожній? (вилучити-останній-атом (як-є ()) (як-є атом?)))
                                 (за-умовою
                                   ((порожній? (вилучити-останній-атом (список (як-є атом?)) (як-є атом?)))
                                    (за-умовою
                                      ((тотожне? (перше (вилучити-останній-атом (список (як-є решта)) (як-є атом?))) (як-є решта))
                                       (за-умовою
                                         ((тотожне? (перше прибрана-голова) (як-є решта))
                                          (за-умовою
                                            ((тотожне? (друге прибрана-голова) (як-є сполучити))
                                             (за-умовою
                                               ((порожній? (решта (решта прибрана-голова)))
                                                (за-умовою
                                                  ((тотожне? (перше прибрана-середина) (як-є решта))
                                                   (за-умовою
                                                     ((тотожне? (друге прибрана-середина) (як-є сполучити))
                                                      (за-умовою
                                                        ((порожній? (решта (решта прибрана-середина)))
                                                         (за-умовою
                                                           ((тотожне? (перше скорочена-трійка) (як-є атом?))
                                                            (за-умовою
                                                              ((тотожне? (друге скорочена-трійка) (як-є атом?))
                                                               (за-умовою
                                                                 ((порожній? (решта (решта скорочена-трійка)))
                                                                  (за-умовою
                                                                    ((хибне? (тотожне? (четверте скорочена-п'ятірка) (як-є атом?)))
                                                                     (атом? (як-є ())))
                                                                    ((атом? (як-є ())) (перше (як-є ())))))
                                                                 ((атом? (як-є ())) (перше (як-є ())))))
                                                              ((атом? (як-є ())) (перше (як-є ())))))
                                                           ((атом? (як-є ())) (перше (як-є ())))))
                                                        ((атом? (як-є ())) (перше (як-є ())))))
                                                     ((атом? (як-є ())) (перше (як-є ())))))
                                                  ((атом? (як-є ())) (перше (як-є ())))))
                                               ((атом? (як-є ())) (перше (як-є ())))))
                                            ((атом? (як-є ())) (перше (як-є ())))))
                                         ((атом? (як-є ())) (перше (як-є ())))))
                                      ((атом? (як-є ())) (перше (як-є ())))))
                                   ((атом? (як-є ())) (перше (як-є ())))))
                                ((атом? (як-є ())) (перше (як-є ())))))
                             ((атом? (як-є ())) (перше (як-є ())))))
                          ((атом? (як-є ())) (перше (як-є ())))))
                       ((атом? (як-є ())) (перше (як-є ())))))
                    ((атом? (як-є ())) (перше (як-є ())))))
                 ((атом? (як-є ())) (перше (як-є ())))))
              ((атом? (як-є ())) (перше (як-є ())))))
           ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
