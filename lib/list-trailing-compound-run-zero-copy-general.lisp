; Суфікс послідовних складених елементів. Один прохід, жодного копіювання пар.
; Початок послідовного суфікса - хвіст після останнього атомного елемента.
; Порожній елемент списку є атомом; вкладена непорожня пара - складений елемент.
; Уся семантика належить СЕНС Д3-Д5, без старих сід8 і хостових обчислень.
(визначити суфікс-складених-елементів-крок
 (функція (залишок початок)
  (за-умовою
   ((порожній? залишок) початок)
   ((атом? (перше залишок))
    (суфікс-складених-елементів-крок
     (решта залишок) (решта залишок)))
   (так (суфікс-складених-елементів-крок (решта залишок) початок)))))
(визначити суфікс-складених-елементів
 (функція (елементи)
  (суфікс-складених-елементів-крок елементи елементи)))

; Порівняння структур - тільки рекурсивні Д3 АТОМ і ЕК і перше і решта.
(визначити суфікси-однакові?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((суфікси-однакові? (перше ліве) (перше праве))
    (суфікси-однакові? (решта ліве) (решта праве)))
   (так ні))))
(визначити перевірити-суфікс-складених
 (функція (елементи очікуване)
  (за-умовою
   ((суфікси-однакові?
     (суфікс-складених-елементів елементи) очікуване)
    (атом? (як-є ())))
   (так (перше (як-є ()))))))

; Порожній і лише атоми: порожній суфікс.
(перевірити-суфікс-складених (як-є ()) (як-є ()))
(перевірити-суфікс-складених
 (список (як-є атом?) (як-є решта))
 (як-є ()))

; Лише пари: повертаємо весь вихідний список, без перебудови.
(перевірити-суфікс-складених
 (список (список (як-є атом?)) (список (як-є решта)))
 (список (список (як-є атом?)) (список (як-є решта))))

; Після атома повертаємо дві останні складені клітинки.
(перевірити-суфікс-складених
 (список (список (як-є атом?)) (як-є решта)
         (список (як-є сполучити)) (список (як-є тотожне?)))
 (список (список (як-є сполучити)) (список (як-є тотожне?))))

; Кінцевий атом обриває будь-який попередній складений суфікс.
(перевірити-суфікс-складених
 (список (список (як-є атом?)) (як-є решта))
 (як-є ()))

; порожній як елемент - атом; після нього рахуємо складені наново.
(перевірити-суфікс-складених
 (список (список (як-є атом?)) (як-є ())
         (список (як-є сполучити)))
 (список (список (як-є сполучити))))

; Негативний свідок: не можна повернути попередню пару через атомний розділювач.
(за-умовою
 ((суфікси-однакові?
   (суфікс-складених-елементів
    (список (список (як-є атом?)) (як-є решта)
            (список (як-є сполучити))))
   (список (список (як-є атом?)) (список (як-є сполучити))))
  (перше (як-є ())))
 (так (атом? (як-є ()))))
