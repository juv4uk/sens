; Незмінне сховище вмісту за адресою.
;
; Для кожного значення адреса однозначно визначає ключ. Повторне
; збереження однакового вмісту замінює той самий запис, а не створює
; зайвий елемент. Світи зберігаються без повторного вкладення предків.
;
; Функції нижче спираються на вже визначені механізми сталої мапи,
; адресування знань і адресування світів. Домени та їхні закони
; ратифіковано окремо; цей файл не вводить нових координат.
;
; Виконувані визначення мають лише повні українські назви.
; Історичні англійські псевдоніми не створюються: вони дублюють
; уже наявні українські замикання і не потрібні для виконання.
;
(визначити порожній-вміст-сховище
  (функція () мапа-порожній))

(визначити вміст-сховище-покласти
  (функція (сховище значення)
    (внутрішня-мапа-вставити (знання-вміст-адреса значення) значення сховище)))

(визначити вміст-сховище-отримати
  (функція (сховище адреса)
    (внутрішня-мапа-отримати адреса сховище)))

(визначити вміст-сховище-містить?
  (функція (сховище адреса)
    (внутрішня-мапа-містить адреса сховище)))

(визначити вміст-сховище-покласти-світ
  (функція (сховище світ)
    (внутрішня-мапа-вставити (знання-вміст-адреса (світ-адреса-вміст світ))
                (світ-адреса-вміст світ)
                сховище)))

(визначити вміст-сховище-розмір
  (функція (сховище)
    (довжина сховище)))

; Кінцевий виклик-свідок: файл виконується при завантаженні, а не лише визначає.
(атом? (як-є ()))
