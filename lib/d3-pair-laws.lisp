; Д3: власний мовний закон збереження голови й хвоста пари.
; Символи є точними ратифікованими об'єктами, а не рядками Unicode.
(визначити перевірити-обидві-сторони-пари
  (функція (голова хвіст)
    (за-умовою
      ((тотожне? (перше (сполучити голова хвіст)) голова)
       (тотожне? (решта (сполучити голова хвіст)) хвіст))
      ((атом? (як-є ())) (перше (як-є ()))))))

(перевірити-обидві-сторони-пари (як-є атом?) (як-є тотожне?))
