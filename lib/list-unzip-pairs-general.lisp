; СЕНС Д3-Д5: загальна обернена розшивка списку атомних пар.
; Передумова: скінченний правильний список, кожний запис - рівно два атоми.
; Розшивка двох незалежних потоків та зшивання не гублять порядку й кратності.
; Істина Д1 визначається безпосередньо СЕНС, Зіг і Т5М лише фізичний носій.
; Д7 лише читається людиною, ніяких Унісоде-байтів у внутрішніх словах.

(визначити розплести-перші-пари
  (функція (пари)
    (за-умовою
      ((атом? пари) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (перше (перше пари))
         (розплести-перші-пари (решта пари)))))))

(визначити розплести-другі-пари
  (функція (пари)
    (за-умовою
      ((атом? пари) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (друге (перше пари))
         (розплести-другі-пари (решта пари)))))))

(визначити зшити-дві-послідовності
  (функція (перші другі)
    (за-умовою
      ((атом? перші) (як-є ()))
      ((атом? другі) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (список (перше перші) (перше другі))
         (зшити-дві-послідовності (решта перші) (решта другі)))))))

(визначити вихідні-пари (список (список (як-є атом?) (як-є решта)) (список (як-є сполучити) (як-є тотожне?)) (список (як-є за-умовою) (як-є хибне?)) (список (як-є решта) (як-є атом?))))
(визначити перший-потік (розплести-перші-пари вихідні-пари))
(визначити другий-потік (розплести-другі-пари вихідні-пари))
(визначити зшиті-пари (зшити-дві-послідовності перший-потік другий-потік))

