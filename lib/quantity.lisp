      ((тотожне? (науковий-список-довжина-дорівнює? значення 3) ні) (як-є ()))
      ((тотожне? (перше значення) схема-розмірності)
       (за-умовою
         ((тотожне? (символ? (друге значення)) (як-є ())) (як-є ()))
         (так так)))
      (так (як-є ())))))

