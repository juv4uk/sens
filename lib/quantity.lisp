; Чинний D1-закон символу: D9 каталог сам не створює виконавця.
; Порівнюємо точну D3 ідентичність після D8 текстової проєкції.
; Порожнє й пари відхиляємо до D8, без неявної істинності host.
(визначити науковий-внутрішній-символ?
  (функція (значення)
    (за-умовою
      ((порожній? значення) (хибне? (атом? (як-є ()))))
      ((хибне? (атом? значення)) (хибне? (атом? (як-є ()))))
      ; D1:1 і D1:0 є атомами, але це не символи. D8 WRITE
      ; справедливо відмовляє в серіалізації предикатів.
      ((тотожне? значення (атом? (як-є ()))) (хибне? (атом? (як-є ()))))
      ((тотожне? значення (хибне? (атом? (як-є ()))))
       (хибне? (атом? (як-є ()))))
      ((тотожне? значення (текст-у-символ (значення-у-текст значення)))
       (атом? (як-є ())))
      ((атом? (як-є ())) (хибне? (атом? (як-є ())))))))

(визначити науковий-список-правильний?
  (функція (значення)
    (за-умовою
      ((атом? значення)
       (тотожне? значення (як-є ())))
      ((атом? (як-є ()))
       (науковий-список-правильний? (решта значення))))))

; Довжина — математичне D24+ значення. D3 EQ не порівнює числа.
; D3 NIL — завершення правильного списку, пошкоджений точковий хвіст — ні.
; Кожний шлях повертає справжній предикат D1, не незв'язані «так/ні».
(визначити науковий-список-довжина-дорівнює?
  (функція (елементи залишок)
    (за-умовою
      ((атом? елементи)
       (за-умовою
         ((хибне? (порожній? елементи)) (хибне? (атом? (як-є ()))))
         ((менше? залишок 0) (хибне? (атом? (як-є ()))))
         ((більше? залишок 0) (хибне? (атом? (як-є ()))))
         ((атом? (як-є ())) (атом? (як-є ())))))
      ((менше? залишок 1) (хибне? (атом? (як-є ()))))
      ((атом? (як-є ()))
       (науковий-список-довжина-дорівнює? (решта елементи) (відняти залишок 1))))))

