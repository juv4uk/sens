; REPL-семантика, написана мовою SENS з українською проєкцією.
;
; Звичайний REPL: уже прочитана форма SENS.
; Окремий репл-цикл-доменів читає лапковане точне бітове слово
; D1–D10 як Lisp-текст, поки машинний D10 reader не допущено.
; Це режим читання БІТІВ, а не обіцянка виконання всіх D10.
; Стан — пара (середовище . останній-результат); перше/решта без обгорток.
; Потрібне попереднє завантаження lib/meta-eval.lisp.
; Його чинна функція обчислити-форму-та-оновити-оточення уже повертає саме цю пару,
; тому тут немає іншого evaluator або другої таблиці ідентичностей.
;
; Джерело SENS/Lisp пишеться українською проєкцією: визначити,
; функція, як-є, атом?, перше, решта, тотожне?, за-умовою, сполучити.
; Первинні ідентичності залишаються точними D3/D4 словами драбини.
; Фізичний споживач кодів — Zig; SENS один визначає семантику.
; Підключення саме цього REPL до коридору Zig потребує окремого доказу.
; Читання й друк: D8:11101010 і D8:11011011 відповідно,
; через чинні українські викличні поверхні, без самовільного D8 lifting.
; Джерело проєкцій: lib/domains/d3.lisp, d4.lisp, d8.lisp, d10.lisp.
; Умови — тільки D1.
; Неправильний список форм відхиляється невикличним D1:0,
; замість того щоб тихо трактувати довільний атом як кінець списку.
;
; Єдиний цикл читання й друку належить SENS; він приймає
; і звичайні українські форми, і точні текстові слова D1–D10.
; Цикл читання й друку виконується тут самою мовою SENS.
; Сьогоднішній механізм прочитати читає ОДНУ форму в рядку.
; Його EOF і друк можуть бути буферизованими: безпечний вихід —
; окрема команда (репл-завершити), а не припущення про кінець файлу.
; Стійке відновлення після синтаксичної помилки ще не доведене.

; D1 має ратифіковані людські проєкції «ні» й «так».
; Перехідний текстовий reader ще не піднімає ці окремі слова до D1.
; Тут імена отримують саме D1-результат чинних ратифікованих
; предикатів SENS; це не новий код, таблиця чи host Bool.
; Після прямого admission source D1 ці прив'язки стануть зайвими.
(визначити так (атом? (як-є ())))
(визначити ні (хибне? так))

(визначити репл-почати
  (функція (початкове-оточення)
    (сполучити
      (додати-визначення-до-оточення (як-є так) так
        (додати-визначення-до-оточення (як-є ні) ні початкове-оточення))
      (як-є ()))))

; Використовуємо вже визначену в lib/meta-eval.lisp функцію
; обчислити-форму-та-оновити-оточення (повна ратифікована укр-проєкція
; D10:0100111111). Повторне DEFINE або латинський alias тут зайві.
; Це мовний виклик наявного замикання, не твердження про runtime
; допуск машинного D10 або незалежний механізм обчислення.

(визначити репл-крок
  (функція (форма стан)
    (обчислити-форму-та-оновити-оточення
      форма
      (перше стан))))

; Визначення функцій належить самій SENS/Lisp.
; D4:0010 функція та D4:0011 визначити є єдиними ратифікованими
; спеціальними формами. На рівні цитованих даних їхню українську
; проєкцію зберігаємо як символи: звичайне читання quoted 0010/0011
; НЕ має права мовчки піднімати їх до виконуваних D4 identity.
; Метаобчислювач SENS сам зіставляє ці символи з точними D4 кодами.
; Жодних нових кодів, десяткових посередників або зовнішньої семантики.
(визначити репл-форма-функція
  (функція (параметри тіло)
    (сполучити (як-є функція)
      (сполучити параметри
        (сполучити тіло (як-є ()))))))

(визначити репл-визначити
  (функція (ім'я вираз стан)
    (репл-крок
      (сполучити (як-є визначити)
        (сполучити ім'я
          (сполучити вираз (як-є ()))))
      стан)))

(визначити репл-визначити-функцію
  (функція (ім'я параметри тіло стан)
    (репл-визначити
      ім'я
      (репл-форма-функція параметри тіло)
      стан)))

; ПЕРШИЙ МОВНИЙ ЧИТАЧ точних бітових слів D1–D10.
; Носій на цьому етапі — текстові дані, а НЕ підміна
; виконавчого D10-об'єкта: штатний прочитати ще не піднімає
; десятибітні джерельні токени до типізованої DomainIdentity.
; Кожен біт читається буквально (D7 glyph "0" або "1").
; Ширина визначається КІЛЬКІСТЮ ЧЛЕНІВ, без десяткового
; посередника, відсікання нулів або домисленої callability.
;
; Ліміт — десять структурних комірок, а не число в обчисленні.
; Немає таблиці функцій або нового словника D1–D10.
(визначити репл-десять-комірок
  (як-є (біт біт біт біт біт біт біт біт біт біт)))

(визначити репл-бітовий-знак?
  (функція (знак)
    (за-умовою
      ((тотожне? (текст-у-символ знак) (текст-у-символ "0")) так)
      ((тотожне? (текст-у-символ знак) (текст-у-символ "1")) так)
      (так ні))))

(визначити репл-перевірити-біти
  (функція (текст комірки)
    (за-умовою
      ((текст-порожній? текст) так)
      ((атом? комірки) ні)
      ((репл-бітовий-знак? (перший-символ-тексту текст))
       (репл-перевірити-біти
         (решта-символів-тексту текст)
         (решта комірки)))
      (так ні))))

(визначити репл-доменне-слово?
  (функція (текст)
    (за-умовою
      ((текст-порожній? текст) ні)
      (так
       (репл-перевірити-біти
         текст репл-десять-комірок)))))

; Результат — список точних однобітних текстових даних.
; Список ЗБЕРІГАЄ кожен початковий нуль і точну ширину;
; він не вдає, що вже є машинним значенням D10.
(визначити репл-біти-списком
  (функція (текст)
    (за-умовою
      ((текст-порожній? текст) (як-є ()))
      (так
       (сполучити
         (перший-символ-тексту текст)
         (репл-біти-списком
           (решта-символів-тексту текст)))))))

(визначити репл-читати-доменне-слово
  (функція (текст)
    (за-умовою
      ((репл-доменне-слово? текст)
       (сполучити
         (як-є точне-бітове-слово)
         (репл-біти-списком текст)))
      (так ні))))

; Мовний побітовий свідок збереження порядку, нулів і довжини.
; Жодної десяткової арифметики; тільки D3 структура та D8 символ.
(визначити репл-біти-збігаються?
  (функція (біти текст)
    (за-умовою
      ; Після завершення тексту дозволено лише СТРУКТУРНО порожній
      ; список бітів: довільний атом не означає збіг ширини.
      ((текст-порожній? текст) (порожній? біти))
      ((атом? біти) ні)
      ((тотожне?
         (текст-у-символ (перше біти))
         (текст-у-символ (перший-символ-тексту текст)))
       (репл-біти-збігаються?
         (решта біти)
         (решта-символів-тексту текст)))
      (так ні))))

; Ширина Д1–Д10 визначається СТРУКТУРОЮ, не перетворенням у
; десяткове число і не числовим значенням payload.
; Позначки д1…д10 — тільки людські мітки прочитаного слова,
; НЕ машинні DomainIdentity і НЕ дозвіл на виконання.
(визначити репл-доменні-позначки
  (як-є (д1 д2 д3 д4 д5 д6 д7 д8 д9 д10)))

(визначити репл-домен-за-бітами
  (функція (біти позначки)
    (за-умовою
      ((атом? біти) (як-є ()))
      ((атом? позначки) (як-є ()))
      ((атом? (решта біти)) (перше позначки))
      (так
       (репл-домен-за-бітами
         (решта біти)
         (решта позначки))))))

(визначити репл-домен-рядка
  (функція (текст)
    (за-умовою
      ((репл-доменне-слово? текст)
       (репл-домен-за-бітами
         (репл-біти-списком текст)
         репл-доменні-позначки))
      (так (як-є ())))))

; Запис (дN "0" "1" ...) є ВІДОБРАЖЕННЯМ точного слова,
; а не присвоєнням D10 готової runtime callability.
(визначити репл-читати-слово-з-доменом
  (функція (текст)
    (за-умовою
      ((репл-доменне-слово? текст)
       (сполучити
         (репл-домен-рядка текст)
         (репл-біти-списком текст)))
      (так ні))))

; Один SENS крок — спільний для інтерактивного і тестового читання.
; Незаконне слово залишається явно позначеною помилкою в даних,
; а не перетворюється на іншу доменну тотожність.
(визначити репл-доменний-рядок
  (функція (текст)
    (за-умовою
      ((репл-доменне-слово? текст)
       (репл-читати-слово-з-доменом текст))
      (так (як-є (неправильне-доменне-слово))))))

; ЗАБОРОНА НЕЯВНОГО ПІДНЯТТЯ ЛІТЕРАЛІВ ДО ДОМЕНУ.
; Звичайне прочитане текстове значення залишається текстом,
; навіть якщо випадково містить 0/1. Власник заборонив вважати
; його кодом лише через написання: ширина і право виклику
; визначаються драбинoю, а не виглядом рядка.
; Для точних слів існують тільки ЯВНІ мовні команди
; (репл-слово домен (назви-D1)) / (репл-код домен назва),
; які проходять каталог усіх ратифікованих поверхонь.
; Текст як дані повертається без EVAL: навіть "0"/"1" не є
; способом викликати жоден домен. Обчислювач залишається єдиним.
(визначити репл-крок-з-доменами
  (функція (форма стан)
    (за-умовою
      ((текст? форма) (сполучити (перше стан) форма))
      (так (репл-крок форма стан)))))

; Детермінована черга рівно тих самих текстових даних; не потрібні
; додатковий host-парсер, Zig-реєстр чи другий обчислювач.
(визначити репл-доменна-черга
  (функція (рядки)
    (за-умовою
      ((атом? рядки)
       (за-умовою
         ((тотожне? рядки (як-є ())) (як-є ()))
         (так ні)))
      ((текст? (перше рядки))
       (сполучити
         (репл-доменний-рядок (перше рядки))
         (репл-доменна-черга (решта рядки))))
      (так ні))))

; Мовний свідок усіх десяти структурних ширин у черзі.
; Порівнює лише атомарні українські мітки, ніколи не здогадується
; про домен із десяткового payload чи довжини машинного буфера.
(визначити репл-мітки-черги?
  (функція (результати мітки)
    (за-умовою
      ; Атомарний непорожній хвіст черги є помилкою, а не EOF.
      ((порожній? результати) (порожній? мітки))
      ((атом? результати) ні)
      ((атом? мітки) ні)
      ((атом? (перше результати)) ні)
      ((тотожне? (перше (перше результати)) (перше мітки))
       (репл-мітки-черги?
         (решта результати)
         (решта мітки)))
      (так ні))))

; УСІ РАТИФІКОВАНІ ПОВЕРХНІ БЕЗ ДРУГОГО СЛОВНИКА.
; Домен і точні біти — первинні. Поля ук/укр/san/en/LISP/sym
; читаються безпосередньо з переданої domain-table/1.
; Відсутнє поле не домислюємо; () ніколи не стає викличним кодом.
(визначити репл-поверхня?
  (функція (поверхня)
    (за-умовою
      ((атом? поверхня)
       (за-умовою
         ((тотожне? поверхня (як-є ук)) так)
         ((тотожне? поверхня (як-є укр)) так)
         ((тотожне? поверхня (як-є san)) так)
         ((тотожне? поверхня (як-є en)) так)
         ((тотожне? поверхня (як-є LISP)) так)
         ((тотожне? поверхня (як-є sym)) так)
         (так ні)))
      (так ні))))

; Ключ уже є точним текстовим словом або кодом зі збереженою
; шириною; writer ніколи не наділяє слово семантикою.
(визначити репл-текст-ключа
  (функція (ключ)
    (за-умовою
      ((текст? ключ) ключ)
      (так (значення-у-текст ключ)))))

(визначити репл-поле-поверхні
  (функція (поверхня поля)
    (за-умовою
      ((атом? поля) (як-є ()))
      ((атом? (перше поля)) (як-є ()))
      ((тотожне? (перше (перше поля)) поверхня)
       (за-умовою
         ((атом? (решта (перше поля))) (як-є ()))
         (так (перше (решта (перше поля))))))
      (так (репл-поле-поверхні поверхня (решта поля))))))

(визначити репл-назва-із-рядків
  (функція (текст поверхня рядки)
    (за-умовою
      ((атом? рядки) (як-є ()))
      ((атом? (перше рядки)) (як-є ()))
      (так
       ((функція (ключ)
          (за-умовою
            ((репл-доменне-слово? ключ)
             (за-умовою
               ((репл-біти-збігаються?
                  (репл-біти-списком текст) ключ)
                (репл-поле-поверхні
                  поверхня (решта (перше рядки))))
               (так
                (репл-назва-із-рядків
                  текст поверхня (решта рядки)))))
            (так (як-є ()))))
        (репл-текст-ключа (перше (перше рядки))))))))

(визначити репл-назва-з-таблиці
  (функція (текст поверхня таблиця)
    (за-умовою
      ((репл-поверхня? поверхня)
       (за-умовою
         ((репл-доменне-слово? текст)
          (за-умовою
            ((атом? таблиця) (як-є ()))
            ((тотожне? (перше таблиця) (як-є domain-table/1))
             (репл-назва-із-рядків текст поверхня (решта таблиця)))
            (так (як-є ()))))
         (так (як-є ()))))
      (так (як-є ())))))

; Сумісне ім'я попереднього читача: жодної другої таблиці ук.
(визначити репл-українська-назва-з-таблиці
  (функція (текст таблиця)
    (репл-назва-з-таблиці текст (як-є укр) таблиця)))

; Зворотний напрямок — назва -> бітове слово. Це пошук
; ДАНИХ для REPL, не автоматичний дозвіл викликати координату.
; Якщо імен немає або вони повторені, ніякого коду не повертаємо.
(визначити репл-ключі-із-рядків
  (функція (назва поверхня рядки знайдено)
    (за-умовою
      ((тотожне? знайдено (як-є неоднозначно)) (як-є неоднозначно))
      ((атом? рядки) знайдено)
      ((атом? (перше рядки)) (як-є ()))
      (так
       ((функція (ключ)
          (за-умовою
            ((репл-доменне-слово? ключ)
             (за-умовою
               ((тотожне?
                  (репл-поле-поверхні
                    поверхня (решта (перше рядки)))
                  назва)
                (за-умовою
                  ((тотожне? знайдено (як-є ()))
                   (репл-ключі-із-рядків
                     назва поверхня (решта рядки) ключ))
                  (так (як-є неоднозначно))))
               (так
                (репл-ключі-із-рядків
                  назва поверхня (решта рядки) знайдено))))
            (так (як-є ()))))
        (репл-текст-ключа (перше (перше рядки))))))))

(визначити репл-код-з-таблиці
  (функція (назва поверхня таблиця)
    (за-умовою
      ((репл-поверхня? поверхня)
       (за-умовою
         ((атом? таблиця) (як-є ()))
         ((тотожне? (перше таблиця) (як-є domain-table/1))
          (за-умовою
            ((тотожне? назва (як-є ())) (як-є ()))
            (так ((функція (знайдено)
                (за-умовою
                  ((тотожне? знайдено (як-є неоднозначно))
                   (як-є ()))
                  (так знайдено)))
              (репл-ключі-із-рядків
                назва поверхня (решта таблиця) (як-є ()))))))
         (так (як-є ()))))
      (так (як-є ())))))

; Каталог складається з уже прочитаних ратифікованих таблиць:
; ((д1 domain-table/1 ...) ... (д10 domain-table/1 ...)).
; Такий носій не вимагає нового реєстру та зберігає ширину
; шляхом перевірки самих бітів (не десяткового числа).
(визначити репл-таблиця-домену
  (функція (позначка каталог)
    (за-умовою
      ((атом? каталог) (як-є ()))
      ((атом? (перше каталог)) (як-є ()))
      ((тотожне? (перше (перше каталог)) позначка)
       (за-умовою
         ((атом? (решта (перше каталог))) (як-є ()))
         (так (перше (решта (перше каталог))))))
      (так (репл-таблиця-домену позначка (решта каталог))))))

(визначити репл-показати-слово
  (функція (текст поверхня каталог)
    (за-умовою
      ((репл-доменне-слово? текст)
       ((функція (таблиця)
          (за-умовою
            ((атом? таблиця) (як-є ()))
            (так
             (репл-назва-з-таблиці текст поверхня таблиця))))
        (репл-таблиця-домену
          (репл-домен-рядка текст) каталог)))
      (так (як-є ())))))

; Зворотне читання імені ЗА ВКАЗАНИМ ДОMЕНОМ — без
; неоднозначного вибору коду за написанням. Схожі назви в
; різних доменах не склеюються.
(визначити репл-код-із-каталогу
  (функція (назва поверхня домен каталог)
    ((функція (таблиця)
       ((функція (ключ)
          (за-умовою
            ((атом? ключ) (як-є ()))
            ((тотожне? (репл-домен-рядка ключ) домен) ключ)
            (так (як-є ()))))
        (репл-код-з-таблиці назва поверхня таблиця)))
     (репл-таблиця-домену домен каталог))))

; Пряма проєкція між БУДЬ-ЯКИМИ ратифікованими поверхнями.
; Команда (репл-проєкція д4 LAMBDA ук) у режимі LISP бере
; точне слово лише з D4 та читає УК із тієї самої таблиці.
; Жодного перекладу через en/LISP і жодної таблиці у Zig/Rust.
; Відсутні, неоднозначні або не в тому домені назви => ().
(визначити репл-проєктувати-ім'я
  (функція (назва джерело домен призначення каталог)
    (за-умовою
      ((репл-поверхня? призначення)
       ((функція (код)
          (за-умовою
            ((атом? код)
             (за-умовою
               ((тотожне? код (як-є ())) (як-є ()))
               (так
                (репл-показати-слово
                  код призначення каталог))))
            (так (як-є ()))))
        (репл-код-із-каталогу
          назва джерело домен каталог)))
      (так (як-є ())))))

; Рівно чотири атомарні елементи:
; (репл-проєкція домен ім'я цільова-поверхня).
; Вкладені форми не виконуються як параметри керівної команди.
(визначити репл-команда-проєкції?
  (функція (форма)
    (за-умовою
      ((атом? форма) ні)
      ((атом? (перше форма))
       (за-умовою
         ((тотожне? (перше форма) (як-є репл-проєкція))
          (за-умовою
            ((атом? (решта форма)) ні)
            ((атом? (решта (решта форма))) ні)
            ((атом? (решта (решта (решта форма)))) ні)
            ((тотожне?
                (решта (решта (решта (решта форма))))
                (як-є ()))
             (за-умовою
               ((атом? (перше (решта форма)))
                (за-умовою
                  ((атом? (перше (решта (решта форма))))
                   (атом? (перше (решта (решта (решта форма))))))
                  (так ні)))
               (так ні)))
            (так ні)))
         (так ні)))
      (так ні))))

; Точне читання ІМЕНІ в обраній поверхні вимагає явного
; домену: (репл-код д4 LAMBDA) у режимі LISP.
; Без домену різні D1–D10 простори не можна ототожнювати.
(визначити репл-команда-коду?
  (функція (форма)
    (за-умовою
      ((атом? форма) ні)
      ((атом? (перше форма))
       (за-умовою
         ((тотожне? (перше форма) (як-є репл-код))
          (за-умовою
            ((атом? (решта форма)) ні)
            ((атом? (решта (решта форма))) ні)
            ((атом? (решта (решта (решта форма))))
             (за-умовою
               ((атом? (перше (решта форма)))
                (за-умовою
                  ((атом? (перше (решта (решта форма))))
                   (тотожне? (решта (решта (решта форма))) (як-є ())))
                  (так ні)))
               (так ні)))
            (так ні)))
         (так ні)))
      (так ні))))

; Безлітеральне точнодоменне введення у будь-якій проєкції:
; (репл-слово д4 (ні ні так ні)). `ні` і `так` — назви з D1,
; а НЕ числові літерали. Поточна поверхня визначає тільки
; написання бітових складових, а ратифікована D1 — їхній код.
(визначити репл-біт-д1?
  (функція (біт)
    (за-умовою
      ((тотожне? біт (як-є ні)) так)
      ((тотожне? біт (як-є так)) так)
      (так ні))))

(визначити репл-список-бітів-д1?
  (функція (біти)
    (за-умовою
      ((атом? біти)
       (тотожне? біти (як-є ())))
      ((репл-біт-д1? (перше біти))
       (репл-список-бітів-д1? (решта біти)))
      (так ні))))

; D1 складові читаємо через ратифіковану таблицю ПОТОЧНОЇ поверхні.
; Жодної додаткової таблиці ні/так, no/yes, na/ām або NIL/T.
; Незаповнена проєкція sym не отримує вигаданих бітових назв.
(визначити репл-список-бітів-поверхні?
  (функція (біти поверхня таблиця-д1)
    (за-умовою
      ((атом? біти) (тотожне? біти (як-є ())))
      (так
       ((функція (ключ)
          (за-умовою
            ((текст? ключ)
             (репл-список-бітів-поверхні?
               (решта біти) поверхня таблиця-д1))
            (так ні)))
        (репл-код-з-таблиці
          (перше біти) поверхня таблиця-д1))))))

; Точне слово складається лише з ключів D1 з поточної поверхні.
; Вибір мови не змінює біти, ширину або право виконувати код.
(визначити репл-біти-д1-до-слова
  (функція (біти поверхня таблиця-д1)
    (за-умовою
      ((атом? біти) (як-є ()))
      ((атом? (решта біти))
       (репл-код-з-таблиці (перше біти) поверхня таблиця-д1))
      (так
       ((функція (перший хвіст)
          (за-умовою
            ((текст? перший)
             (за-умовою
               ((текст? хвіст) (зчепити перший хвіст))
               (так (як-є ()))))
            (так (як-є ()))))
        (репл-код-з-таблиці (перше біти) поверхня таблиця-д1)
        (репл-біти-д1-до-слова
          (решта біти) поверхня таблиця-д1))))))

(визначити репл-команда-слова?
  (функція (форма)
    (за-умовою
      ((атом? форма) ні)
      ((атом? (перше форма))
       (за-умовою
         ((тотожне? (перше форма) (як-є репл-слово))
          (за-умовою
            ((атом? (решта форма)) ні)
            ((атом? (решта (решта форма))) ні)
            ((тотожне? (решта (решта (решта форма))) (як-є ()))
             (атом? (перше (решта форма))))
            (так ні)))
         (так ні)))
      (так ні))))

(визначити репл-слово-із-д1
  (функція (домен біти поверхня каталог)
    (за-умовою
      ((репл-список-бітів-поверхні?
         біти поверхня (репл-таблиця-домену (як-є д1) каталог))
       ((функція (слово)
          (за-умовою
            ((текст? слово)
             (за-умовою
               ((тотожне? (репл-домен-рядка слово) домен)
                (сполучити
                  (репл-показати-слово слово поверхня каталог)
                  (репл-доменний-рядок слово)))
               (так (як-є (неправильне-доменне-слово)))))
            (так (як-є (неправильне-доменне-слово)))))
        (репл-біти-д1-до-слова
          біти поверхня (репл-таблиця-домену (як-є д1) каталог))))
      (так (як-є (неправильне-доменне-слово))))))

; Погано сформована службова команда не повинна потрапити в
; звичайний Lisp-eval. Усі п'ять зарезервованих голів — лише
; українські імена команд самого SENS; не вводимо нових кодів.
(визначити репл-службова-голова?
  (функція (форма)
    (за-умовою
      ((атом? форма) ні)
      ((атом? (перше форма))
       (за-умовою
         ((тотожне? (перше форма) (як-є репл-мова)) так)
         ((тотожне? (перше форма) (як-є репл-код)) так)
         ((тотожне? (перше форма) (як-є репл-слово)) так)
         ((тотожне? (перше форма) (як-є репл-проєкція)) так)
         ((тотожне? (перше форма) (як-є репл-завершити)) так)
         (так ні)))
      (так ні))))

; Для точного слова використовуємо лише явні мовні команди
; (репл-слово д4 (ні ні так ні)) або (репл-код д4 функція).
; Довільний рядок, навіть текст із нулів і одиниць, НІКОЛИ
; не перетворюємо на код автоматично: це звичайні дані SENS.
; Ширину й домен визначає ратифікована таблиця, не вигляд рядка.
(визначити репл-крок-поверхні
  (функція (форма стан поверхня каталог)
    (за-умовою
      ((репл-команда-проєкції? форма)
       (сполучити
         (перше стан)
         (репл-проєктувати-ім'я
           (перше (решта (решта форма)))
           поверхня
           (перше (решта форма))
           (перше (решта (решта (решта форма))))
           каталог)))
      ((репл-команда-коду? форма)
       (сполучити
         (перше стан)
         (репл-код-із-каталогу
           (перше (решта (решта форма)))
           поверхня
           (перше (решта форма))
           каталог)))
      ((репл-команда-слова? форма)
       (сполучити
         (перше стан)
         (репл-слово-із-д1
           (перше (решта форма))
           (перше (решта (решта форма)))
           поверхня каталог)))
      ((репл-службова-голова? форма)
       (сполучити
         (перше стан)
         (як-є (неправильна-команда-репл))))
      (так (репл-крок форма стан)))))

; Власна команда мови — рівно (репл-мова назва).
; Це лише керування відображенням; середовище SENS зберігається.
; Мовна команда перемикання поверхні повинна мати атомарний
; аргумент: вкладений список не надходить у D3 EQ як псевдоім'я.
(визначити репл-команда-мови?
  (функція (форма)
    (за-умовою
      ((атом? форма) ні)
      ((атом? (перше форма))
       (за-умовою
         ((тотожне? (перше форма) (як-є репл-мова))
          (за-умовою
            ((атом? (решта форма)) ні)
            ((атом? (решта (решта форма)))
             (за-умовою
               ((тотожне? (решта (решта форма)) (як-є ()))
                (атом? (перше (решта форма))))
               (так ні)))
            (так ні)))
         (так ні)))
      (так ні))))

; Лише команда-форма з РІВНО одним словом завершує сеанс.
; Сам символ репл-завершити у звичайній програмі не є командою.
; Завершення перевіряємо за структурою й чинною D3 тотожністю.
(визначити репл-завершення?
  (функція (форма)
    (за-умовою
      ((атом? форма) ні)
      ((атом? (перше форма))
       (за-умовою
         ((тотожне? (перше форма) (як-є репл-завершити))
          (за-умовою
            ((атом? (решта форма))
             (тотожне? (решта форма) (як-є ())))
            (так ні)))
         (так ні)))
      (так ні))))

; Спільний SENS-перехід для всіх людських поверхонь.
; Результат: ((новий-стан . нова-поверхня) . видимий-результат).
; Стан і точні доменні координати ніколи не змінює сам вибір мови.
(визначити репл-перехід-поверхні
  (функція (форма стан поверхня каталог)
    (за-умовою
      ((репл-команда-мови? форма)
       ((функція (наступна)
          (за-умовою
            ((репл-поверхня? наступна)
             (сполучити (сполучити стан наступна) наступна))
            (так
             (сполучити
               (сполучити стан поверхня)
               (як-є невідома-поверхня)))))
        (перше (решта форма))))
      (так
       ((функція (наступний-стан)
          (сполучити
            (сполучити наступний-стан поверхня)
            (решта наступний-стан)))
        (репл-крок-поверхні форма стан поверхня каталог))))))

; Той самий мовний перехід у циклі термінала і в детермінованому
; свідку черги. Це не другий REPL/evaluator, а один SENS-крок.
; Чинний D8 READ на EOF повертає мовну помилку, а не порожній
; рядок; її НЕ можна помилково називати успішним завершенням.
; До окремого фізичного EOF-знака коректний вихід — тільки
; точна SENS-команда (репл-завершити).
(визначити репл-цикл-поверхонь
  (функція (стан поверхня каталог)
    ((функція (форма)
       (за-умовою
         ((репл-завершення? форма) стан)
         (так
          ((функція (перехід)
             (друкувати (решта перехід))
             (репл-цикл-поверхонь
               (перше (перше перехід))
               (решта (перше перехід))
               каталог))
           (репл-перехід-поверхні
             форма стан поверхня каталог)))))
     (прочитати))))

; Прогін уже прочитаних форм через точно той самий REPL.
; Повертаємо (стан . поточна-поверхня), щоб свідок міг
; довести перемикання ук/укр/san/en/LISP/sym без дубля логіки.
(визначити репл-пройти-поверхні
  (функція (форми стан поверхня каталог)
    (за-умовою
      ((атом? форми)
       (за-умовою
         ((тотожне? форми (як-є ())) (сполучити стан поверхня))
         (так ні)))
      ((репл-завершення? (перше форми))
       (сполучити стан поверхня))
      (так
       ((функція (перехід)
          (репл-пройти-поверхні
            (решта форми)
            (перше (перше перехід))
            (решта (перше перехід))
            каталог))
        (репл-перехід-поверхні
          (перше форми) стан поверхня каталог))))))

; Повний каталог рівно D1–D10, без дубльованих або відсутніх
; кімнат драбини. Це перевірка ФОРМИ каталогу, а не доказ
; точності його координат: цим володіє ратифікована драбина.
; Вхідні таблиці приходять готовими даними SENS, без нової
; таблиці імен у Zig, Rust або в самому REPL.
(визначити репл-порядок-доменів
  (як-є (д1 д2 д3 д4 д5 д6 д7 д8 д9 д10)))

; Точна ширина КОЖНОГО ключа драбини перевіряється самою SENS.
; Навіть повна кількість рядків не легалізує D9 слово всередині D10.
; Без арифметики, десяткових посередників і нової семантичної таблиці.
(визначити репл-рядки-точного-домену?
  (функція (рядки домен)
    (за-умовою
      ((атом? рядки) (тотожне? рядки (як-є ())))
      ((атом? (перше рядки)) ні)
      ((тотожне?
         (репл-домен-рядка
           (репл-текст-ключа (перше (перше рядки))))
         домен)
       (репл-рядки-точного-домену? (решта рядки) домен))
      (так ні))))

; Унікальність бітової координати — окремий мовний закон.
; Дерево з двома гілками використовує тільки D3-сполучити,
; решта й перше. Однакові 0/1 payload у різних D1–D10
; кімнатах не змішуються: дерево щоразу нове для одного домену.
; Складність проходу — одна гілка на один біт, а не попарні
; порівняння всіх 1024 рядків D10.
(визначити репл-вставити-біти
  (функція (біти дерево)
    (за-умовою
      ((атом? біти)
       (за-умовою
         ((тотожне? дерево (як-є ()))
          (сполучити так так))
         (так (сполучити ні дерево))))
      ((атом? дерево)
       (за-умовою
         ((тотожне? дерево (як-є ()))
          (репл-вставити-біти
            біти (сполучити (як-є ()) (як-є ()))))
         (так (сполучити ні дерево))))
      ((тотожне?
         (текст-у-символ (перше біти))
         (текст-у-символ "0"))
       ((функція (результат)
          (сполучити
            (перше результат)
            (сполучити
              (решта результат)
              (решта дерево))))
        (репл-вставити-біти
          (решта біти) (перше дерево))))
      (так
       ((функція (результат)
          (сполучити
            (перше результат)
            (сполучити
              (перше дерево)
              (решта результат))))
        (репл-вставити-біти
          (решта біти) (решта дерево)))))))

(визначити репл-унікальні-координати?
  (функція (рядки дерево)
    (за-умовою
      ((атом? рядки) (тотожне? рядки (як-є ())))
      ((атом? (перше рядки)) ні)
      (так
       ((функція (результат)
          (за-умовою
            ((перше результат)
             (репл-унікальні-координати?
               (решта рядки)
               (решта результат)))
            (так ні)))
        (репл-вставити-біти
          (репл-біти-списком
            (репл-текст-ключа
              (перше (перше рядки))))
          дерево))))))

(визначити репл-правильний-запис-домену?
  (функція (запис домен)
    (за-умовою
      ((атом? запис) ні)
      ((тотожне? (перше запис) домен)
       (за-умовою
         ((атом? (решта запис)) ні)
         ((тотожне? (решта (решта запис)) (як-є ()))
          ((функція (таблиця)
             (за-умовою
               ((атом? таблиця) ні)
               ((тотожне? (перше таблиця) (як-є domain-table/1))
                (за-умовою
                  ((репл-рядки-точного-домену?
                     (решта таблиця) домен)
                   (репл-унікальні-координати?
                     (решта таблиця) (як-є ())))
                  (так ні)))
               (так ні)))
           (перше (решта запис))))
         (так ні)))
      (так ні))))

(визначити репл-повний-каталог?
  (функція (каталог домени)
    (за-умовою
      ((атом? домени)
       (за-умовою
         ((тотожне? домени (як-є ()))
          (тотожне? каталог (як-є ())))
         (так ні)))
      ((атом? каталог) ні)
      ((репл-правильний-запис-домену?
         (перше каталог) (перше домени))
       (репл-повний-каталог?
         (решта каталог) (решта домени)))
      (так ні))))

; Шість полів — точна форма кожної кімнати D1–D10.
; Це схема ратифікованої таблиці, не друга таблиця функцій.
; Відсутню людську назву можна позначити (), але не пропускати поле.
(визначити репл-правильні-поля-рядка?
  (функція (поля очікувані)
    (за-умовою
      ((атом? очікувані) (тотожне? поля (як-є ())))
      ((атом? поля) ні)
      ((атом? (перше поля)) ні)
      ((атом? (перше (перше поля)))
       (за-умовою
         ((тотожне? (перше (перше поля)) (перше очікувані))
          (за-умовою
            ((атом? (решта (перше поля))) ні)
            ((тотожне? (решта (решта (перше поля))) (як-є ()))
             (за-умовою
               ((атом? (перше (решта (перше поля))))
                (репл-правильні-поля-рядка?
                  (решта поля) (решта очікувані)))
               (так ні)))
            (так ні)))
         (так ні)))
      (так ні))))

(визначити репл-правильні-поля-рядків?
  (функція (рядки)
    (за-умовою
      ((атом? рядки) (тотожне? рядки (як-є ())))
      ((атом? (перше рядки)) ні)
      ((репл-правильні-поля-рядка?
         (решта (перше рядки))
         (як-є (ук укр san en LISP sym)))
       (репл-правильні-поля-рядків? (решта рядки)))
      (так ні))))

(визначити репл-правильні-поля-каталогу?
  (функція (каталог)
    (за-умовою
      ((атом? каталог) (тотожне? каталог (як-є ())))
      ((атом? (перше каталог)) ні)
      ((атом? (решта (перше каталог))) ні)
      (так
       ((функція (таблиця)
          (за-умовою
            ((атом? таблиця) ні)
            ((репл-правильні-поля-рядків? (решта таблиця))
             (репл-правильні-поля-каталогу? (решта каталог)))
            (так ні)))
        (перше (решта (перше каталог))))))))

; Ємність кімнат драбини перевіряє сама мова: одна структурна
; комірка → подвоєння для D1 → подвоєння для D2 … → D10.
; Жодних десяткових констант, host арифметики чи саморобних SID.
; Однакова кількість не доводить унікальність координат — це
; незалежний закон ратифікованих lib/domains/d*.lisp.
(визначити репл-дописати-комірки
  (функція (початкова-частина кінець)
    (за-умовою
      ((атом? початкова-частина) кінець)
      (так
       (сполучити
         (перше початкова-частина)
         (репл-дописати-комірки (решта початкова-частина) кінець))))))

(визначити репл-однакова-місткість?
  (функція (ліва права)
    (за-умовою
      ((атом? ліва)
       (за-умовою
         ((тотожне? ліва (як-є ()))
          (тотожне? права (як-є ())))
         (так ні)))
      ((атом? права) ні)
      (так
       (репл-однакова-місткість?
         (решта ліва) (решта права))))))

(визначити репл-місткість-каталогу?
  (функція (каталог попередні-комірки)
    (за-умовою
      ((атом? каталог)
       (тотожне? каталог (як-є ())))
      ((атом? (перше каталог)) ні)
      ((атом? (решта (перше каталог))) ні)
      (так
       ((функція (очікувані)
          (за-умовою
            ((репл-однакова-місткість?
               (решта (перше (решта (перше каталог))))
               очікувані)
             (репл-місткість-каталогу?
               (решта каталог) очікувані))
            (так ні)))
        (репл-дописати-комірки
          попередні-комірки попередні-комірки))))))

; ЗАХИСТ БІТНОСТІ РАТИФІКОВАНИХ domain-table/1.
; Звичайний READ не має права перетворювати ключ 0000000001
; на числовий payload і втрачати початкові нулі.
; Ратифіковані файли мають рівно одну бітову голову рядка:
; пробіли, '(' , точне слово, пробіл, поля ук/укр/san/en/LISP/sym.
; Ця МОВНА лексична обгортка перетворює лише ключі даних на
; текстові токени для чинного READ. Вона не визначає ані коду,
; ані значення чи допустимості виконання; всі поля незмінні.
; Коментарі, назви, проєкції й решта вихідного тексту зберігаються.
(визначити репл-джерело-ключі-продовжити
  (функція (текст біти)
    (за-умовою
      ((текст-порожній? текст)
       біти)
      ((репл-бітовий-знак? (перший-символ-тексту текст))
       (репл-джерело-ключі-продовжити
         (решта-символів-тексту текст)
         (зчепити біти (перший-символ-тексту текст))))
      ((тотожне?
         (текст-у-символ (перший-символ-тексту текст))
         (текст-у-символ " "))
       (зчепити
         "\""
         (зчепити
           біти
           (зчепити
             "\""
             (репл-джерело-ключі-у-тексті текст ні)))))
      (так
       (зчепити біти (репл-джерело-ключі-у-тексті текст ні))))))

(визначити репл-джерело-ключі-після-дужки
  (функція (текст)
    (за-умовою
      ((текст-порожній? текст) "")
      ((репл-бітовий-знак? (перший-символ-тексту текст))
       (репл-джерело-ключі-продовжити текст ""))
      (так (репл-джерело-ключі-у-тексті текст ні)))))

(визначити репл-джерело-ключі-у-тексті
  (функція (текст початок-рядка)
    (за-умовою
      ((текст-порожній? текст) "")
      (так
       ((функція (знак)
          (за-умовою
            ((тотожне?
               (текст-у-символ знак) (текст-у-символ "\\n"))
             (зчепити знак
               (репл-джерело-ключі-у-тексті
                 (решта-символів-тексту текст) так)))
            (початок-рядка
             (за-умовою
               ((тотожне?
                  (текст-у-символ знак) (текст-у-символ " "))
                (зчепити знак
                  (репл-джерело-ключі-у-тексті
                    (решта-символів-тексту текст) так)))
               ((тотожне?
                  (текст-у-символ знак) (текст-у-символ "("))
                (зчепити знак
                  (репл-джерело-ключі-після-дужки
                    (решта-символів-тексту текст))))
               (так
                (зчепити знак
                  (репл-джерело-ключі-у-тексті
                    (решта-символів-тексту текст) ні)))))
            (так
             (зчепити знак
               (репл-джерело-ключі-у-тексті
                 (решта-символів-тексту текст) ні)))))
        (перший-символ-тексту текст))))))

; ФІЗИЧНИЙ ВХІД ДРАБИНИ: Zig/інший транспорт лише приносить
; десять незмінених UTF-8 текстів lib/domains/d1.lisp…d10.lisp.
; Сама SENS читає їх як ДАНІ, збирає домени в ратифікованому порядку
; й перевіряє схему, бітність кожного рядка та місткість.
; Читання не означає допуск до виконання D7/D8/D9/D10 механізмів.
; Ніякого англійського посередника або додаткового словника немає.
(визначити репл-каталог-з-текстів
  (функція (тексти домени)
    (за-умовою
      ((атом? домени)
       (за-умовою
         ((тотожне? домени (як-є ()))
          (за-умовою
            ((тотожне? тексти (як-є ())) (як-є ()))
            (так (як-є (порушена-кількість-доменів)))))
         (так (як-є (порушена-кількість-доменів)))))
      ((атом? тексти) (як-є (порушена-кількість-доменів)))
      ((текст? (перше тексти))
       (сполучити
         (сполучити
           (перше домени)
           (сполучити (прочитати (репл-джерело-ключі-у-тексті (перше тексти) так)) (як-є ())))
         (репл-каталог-з-текстів (решта тексти) (решта домени))))
      (так (як-є (неправильне-джерело-домену))))))

; Вхідна точка всіх поверхонь. Виклик отримує вже ПРОЧИТАНИЙ
; каталог ратифікованих D1–D10 таблиць; Zig/host лише транспортує
; їхні байти. Жодної прихованої таблиці в REPL немає.
(визначити репл-запустити-поверхні
  (функція (каталог)
    (за-умовою
      ((репл-повний-каталог? каталог репл-порядок-доменів)
       (за-умовою
         ((репл-правильні-поля-каталогу? каталог)
          (за-умовою
            ((репл-місткість-каталогу? каталог (як-є (комірка)))
             (репл-цикл-поверхонь
               (репл-почати (як-є ())) (як-є укр) каталог))
            (так (як-є (порушена-місткість-доменів)))))
         (так (як-є (порушена-схема-поверхонь)))))
      (так (як-є (неповний-каталог-доменів))))))

(визначити репл-запустити-з-текстів
  (функція (тексти)
    (репл-запустити-поверхні
      (репл-каталог-з-текстів
        тексти репл-порядок-доменів))))

(визначити репл-виконати
  (функція (форми стан)
    (за-умовою
      ((атом? форми)
       (за-умовою
         ((тотожне? форми (як-є ())) стан)
         (так ні)))
      (так
       (за-умовою
         ((репл-завершення? (перше форми)) стан)
         (так
          (репл-виконати
            (решта форми)
            (репл-крок (перше форми) стан))))))))

; Мовна обробка одного текстового рядка. Фізичне читання з термінала
; і друк залишаються чинними механізмами, а не новою мовою чи семантикою.
(визначити репл-обробити-рядок
  (функція (текст стан)
    (репл-крок (прочитати текст) стан)))

; READ–EVAL–PRINT–LOOP: єдиний виконавчий цикл визначено вище
; як репл-цикл-поверхонь. Імена нижче — лише посилання на ту саму
; SENS/Lisp-функцію: жодного повторного READ/EVAL/PRINT, жодного
; обходу обраної поверхні чи каталогу драбини.
;
; (репл-цикл стан поверхня каталог) вимагає ВЖЕ перевірений
; каталог D1–D10, тому не обходить мовний допуск.
(визначити репл-цикл репл-цикл-поверхонь)

; (репл-цикл-доменів каталог) — та сама мовна точка запуску,
; із перевіркою кількості, бітності та унікальності всіх доменів.
; Фізичний транспорт має передати справжні таблиці як дані SENS.
; Двійкові текстові літерали НЕ є вхідним API: для введення
; точних слів застосовується (репл-слово домен (назви-D1)).
(визначити репл-цикл-доменів репл-запустити-поверхні)

; Детермінований прохід через чергу текстових рядків.
; Повторює той самий мовний крок, що й інтерактивний репл-цикл;
; носій списку потрібен лише для перевірки циклу без живого stdin.
; Структурне () завершує чергу; неправильний хвіст — відмова D1:NO.
; Точна команда (репл-завершити) завершує сеанс достроково,
; тож жоден рядок після неї не читається й не обчислюється.
(визначити репл-черга
  (функція (рядки стан)
    (за-умовою
      ((атом? рядки)
       (за-умовою
         ((тотожне? рядки (як-є ())) стан)
         (так ні)))
      (так
       ((функція (прочитана-форма)
          (за-умовою
            ((репл-завершення? прочитана-форма) стан)
            (так
             ((функція (новий-стан)
                (друкувати (решта новий-стан))
                (репл-черга (решта рядки) новий-стан))
              (репл-крок-з-доменами прочитана-форма стан)))))
        (прочитати (перше рядки)))))))

; Функцію додати-визначення-до-оточення вже визначено у метаобчислювачі.
; Цей цикл використовує наявне українське визначення без повторного псевдоніма.
