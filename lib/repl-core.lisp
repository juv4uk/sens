; REPL-семантика, написана мовою SENS з українською проєкцією.
;
; Звичайний REPL: уже прочитана форма SENS.
; Окремий репл-цикл-доменів читає лапковане точне бітове слово
; D1–D10 як Lisp-текст, поки машинний D10 reader не допущено.
; Це режим читання БІТІВ, а не обіцянка виконання всіх D10.
; Стан — пара (середовище . останній-результат); перше/решта без обгорток.
; Потрібне попереднє завантаження lib/meta-eval.lisp.
; Його чинна функція my-eval-top-form уже повертає саме цю пару,
; тому тут немає іншого evaluator або другої таблиці ідентичностей.
;
; Джерело SENS/Lisp пишеться українською проєкцією: визначити,
; функція, як-є, атом?, перше, решта, тотожне?, за-умовою, сполучити.
; Первинні ідентичності залишаються точними D3/D4 словами драбини.
; Фізичний споживач кодів — Zig; SENS один визначає семантику.
; Підключення саме цього REPL до коридору Zig потребує окремого доказу.
; Читання й друк: D8:11101010 і D8:11011011 відповідно,
; через чинні українські викличні поверхні, без самовільного D8 lifting.
; Джерело проєкцій: lib/domains/d3.lisp, d4.lisp, d8.lisp, d10.lisp.
; Умови — тільки D1.
; Неправильний список форм відхиляється невикличним D1:0,
; замість того щоб тихо трактувати довільний атом як кінець списку.
;
; Єдиний цикл читання й друку належить SENS; він приймає
; і звичайні українські форми, і точні текстові слова D1–D10.
; Цикл читання й друку виконується тут самою мовою SENS.
; Сьогоднішній механізм прочитати читає ОДНУ форму в рядку.
; Його EOF і друк можуть бути буферизованими: безпечний вихід —
; окрема команда (репл-завершити), а не припущення про кінець файлу.
; Стійке відновлення після синтаксичної помилки ще не доведене.

; D1 має ратифіковані людські проєкції «ні» й «так».
; Перехідний текстовий reader ще не піднімає ці окремі слова до D1.
; Тут імена отримують саме D1-результат чинних ратифікованих
; предикатів SENS; це не новий код, таблиця чи host Bool.
; Після прямого admission source D1 ці прив'язки стануть зайвими.
(визначити так (атом? (як-є ())))
(визначити ні (хибне? так))

(визначити репл-почати
  (функція (початкове-оточення)
    (сполучити
      (my-env-define (як-є так) так
        (my-env-define (як-є ні) ні початкове-оточення))
      (як-є ()))))

; Д10:0100111111 обчислити-верхню-форму з ратифікованої драбини.
; Каталог і адреса ратифіковані, але пряма runtime-callability D10
; ще НЕ доведена. Це тимчасове ім'я для вже чинної SENS/Lisp функції,
; а НЕ самовільне підняття D10-коду до виконуваного механізму.
; Після доказової активації D10 ім'я має поступитися точному коду.
(визначити обчислити-верхню-форму my-eval-top-form)

(визначити репл-крок
  (функція (форма стан)
    (обчислити-верхню-форму
      форма
      (перше стан))))

; Визначення функцій належить самій SENS/Lisp.
; D4:0010 функція та D4:0011 визначити є єдиними ратифікованими
; спеціальними формами. На рівні цитованих даних їхню українську
; проєкцію зберігаємо як символи: звичайне читання quoted 0010/0011
; НЕ має права мовчки піднімати їх до виконуваних D4 identity.
; Метаобчислювач SENS сам зіставляє ці символи з точними D4 кодами.
; Жодних нових кодів, десяткових посередників або зовнішньої семантики.
(визначити репл-форма-функція
  (функція (параметри тіло)
    (сполучити (як-є функція)
      (сполучити параметри
        (сполучити тіло (як-є ()))))))

(визначити репл-визначити
  (функція (ім'я вираз стан)
    (репл-крок
      (сполучити (як-є визначити)
        (сполучити ім'я
          (сполучити вираз (як-є ()))))
      стан)))

(визначити репл-визначити-функцію
  (функція (ім'я параметри тіло стан)
    (репл-визначити
      ім'я
      (репл-форма-функція параметри тіло)
      стан)))

; ПЕРШИЙ МОВНИЙ ЧИТАЧ точних бітових слів D1–D10.
; Носій на цьому етапі — текстові дані, а НЕ підміна
; виконавчого D10-об'єкта: штатний прочитати ще не піднімає
; десятибітні джерельні токени до типізованої DomainIdentity.
; Кожен біт читається буквально (D7 glyph "0" або "1").
; Ширина визначається КІЛЬКІСТЮ ЧЛЕНІВ, без десяткового
; посередника, відсікання нулів або домисленої callability.
;
; Ліміт — десять структурних комірок, а не число в обчисленні.
; Немає таблиці функцій або нового словника D1–D10.
(визначити репл-десять-комірок
  (як-є (біт біт біт біт біт біт біт біт біт біт)))

(визначити репл-бітовий-знак?
  (функція (знак)
    (за-умовою
      ((тотожне? (текст-у-символ знак) (текст-у-символ "0")) так)
      ((тотожне? (текст-у-символ знак) (текст-у-символ "1")) так)
      (так ні))))

(визначити репл-перевірити-біти
  (функція (текст комірки)
    (за-умовою
      ((текст-порожній? текст) так)
      ((атом? комірки) ні)
      ((репл-бітовий-знак? (перший-символ-тексту текст))
       (репл-перевірити-біти
         (решта-символів-тексту текст)
         (решта комірки)))
      (так ні))))

(визначити репл-доменне-слово?
  (функція (текст)
    (за-умовою
      ((текст-порожній? текст) ні)
      (так
       (репл-перевірити-біти
         текст репл-десять-комірок)))))

; Результат — список точних однобітних текстових даних.
; Список ЗБЕРІГАЄ кожен початковий нуль і точну ширину;
; він не вдає, що вже є машинним значенням D10.
(визначити репл-біти-списком
  (функція (текст)
    (за-умовою
      ((текст-порожній? текст) (як-є ()))
      (так
       (сполучити
         (перший-символ-тексту текст)
         (репл-біти-списком
           (решта-символів-тексту текст)))))))

(визначити репл-читати-доменне-слово
  (функція (текст)
    (за-умовою
      ((репл-доменне-слово? текст)
       (сполучити
         (як-є точне-бітове-слово)
         (репл-біти-списком текст)))
      (так (ні)))))

; Мовний побітовий свідок збереження порядку, нулів і довжини.
; Жодної десяткової арифметики; тільки D3 структура та D8 символ.
(визначити репл-біти-збігаються?
  (функція (біти текст)
    (за-умовою
      ((текст-порожній? текст) (атом? біти))
      ((атом? біти) ні)
      ((тотожне?
         (текст-у-символ (перше біти))
         (текст-у-символ (перший-символ-тексту текст)))
       (репл-біти-збігаються?
         (решта біти)
         (решта-символів-тексту текст)))
      (так ні))))

; Ширина Д1–Д10 визначається СТРУКТУРОЮ, не перетворенням у
; десяткове число і не числовим значенням payload.
; Позначки д1…д10 — тільки людські мітки прочитаного слова,
; НЕ машинні DomainIdentity і НЕ дозвіл на виконання.
(визначити репл-доменні-позначки
  (як-є (д1 д2 д3 д4 д5 д6 д7 д8 д9 д10)))

(визначити репл-домен-за-бітами
  (функція (біти позначки)
    (за-умовою
      ((атом? біти) (як-є ()))
      ((атом? позначки) (як-є ()))
      ((атом? (решта біти)) (перше позначки))
      (так
       (репл-домен-за-бітами
         (решта біти)
         (решта позначки))))))

(визначити репл-домен-рядка
  (функція (текст)
    (за-умовою
      ((репл-доменне-слово? текст)
       (репл-домен-за-бітами
         (репл-біти-списком текст)
         репл-доменні-позначки))
      (так (як-є ())))))

; Запис (дN "0" "1" ...) є ВІДОБРАЖЕННЯМ точного слова,
; а не присвоєнням D10 готової runtime callability.
(визначити репл-читати-слово-з-доменом
  (функція (текст)
    (за-умовою
      ((репл-доменне-слово? текст)
       (сполучити
         (репл-домен-рядка текст)
         (репл-біти-списком текст)))
      (так (ні)))))

; Один SENS крок — спільний для інтерактивного і тестового читання.
; Незаконне слово залишається явно позначеною помилкою в даних,
; а не перетворюється на іншу доменну тотожність.
(визначити репл-доменний-рядок
  (функція (текст)
    (за-умовою
      ((репл-доменне-слово? текст)
       (репл-читати-слово-з-доменом текст))
      (так (як-є (неправильне-доменне-слово))))))

; ЄДИНИЙ МОВНИЙ КРОК для програм і точних слів D1–D10.
; Звичайні форми передаємо тому самому SENS-метаобчислювачу.
; Текст із бітів читаємо лише як структурні дані із точною
; шириною, не надаючи D8/D9/D10-координатам виконуваності.
; Оточення не змінюється, коли надійшло доменне слово.
(визначити репл-крок-з-доменами
  (функція (форма стан)
    (за-умовою
      ((текст? форма)
       (сполучити
         (перше стан)
         (репл-доменний-рядок форма)))
      (так
       (репл-крок форма стан)))))

; Детермінована черга рівно тих самих текстових даних; не потрібні
; додатковий host-парсер, Zig-реєстр чи другий обчислювач.
(визначити репл-доменна-черга
  (функція (рядки)
    (за-умовою
      ((атом? рядки)
       (за-умовою
         ((тотожне? рядки (як-є ())) (як-є ()))
         (так (ні))))
      ((текст? (перше рядки))
       (сполучити
         (репл-доменний-рядок (перше рядки))
         (репл-доменна-черга (решта рядки))))
      (так (ні)))))

; Мовний свідок усіх десяти структурних ширин у черзі.
; Порівнює лише атомарні українські мітки, ніколи не здогадується
; про домен із десяткового payload чи довжини машинного буфера.
(визначити репл-мітки-черги?
  (функція (результати мітки)
    (за-умовою
      ((атом? результати)
       (за-умовою
         ((тотожне? результати (як-є ()))
          (тотожне? мітки (як-є ())))
         (так ні)))
      ((атом? мітки) ні)
      ((атом? (перше результати)) ні)
      ((тотожне? (перше (перше результати)) (перше мітки))
       (репл-мітки-черги?
         (решта результати)
         (решта мітки)))
      (так ні))))

; УСІ РАТИФІКОВАНІ ПОВЕРХНІ БЕЗ ДРУГОГО СЛОВНИКА.
; Домен і точні біти — первинні. Поля ук/укр/san/en/LISP/sym
; читаються безпосередньо з переданої domain-table/1.
; Відсутнє поле не домислюємо; () ніколи не стає викличним кодом.
(визначити репл-поверхня?
  (функція (поверхня)
    (за-умовою
      ((тотожне? поверхня (як-є ук)) так)
      ((тотожне? поверхня (як-є укр)) так)
      ((тотожне? поверхня (як-є san)) так)
      ((тотожне? поверхня (як-є en)) так)
      ((тотожне? поверхня (як-є LISP)) так)
      ((тотожне? поверхня (як-є sym)) так)
      (так ні))))

; Ключ уже є точним текстовим словом або кодом зі збереженою
; шириною; writer ніколи не наділяє слово семантикою.
(визначити репл-текст-ключа
  (функція (ключ)
    (за-умовою
      ((текст? ключ) ключ)
      (так (значення-у-текст ключ)))))

(визначити репл-поле-поверхні
  (функція (поверхня поля)
    (за-умовою
      ((атом? поля) (як-є ()))
      ((атом? (перше поля)) (як-є ()))
      ((тотожне? (перше (перше поля)) поверхня)
       (за-умовою
         ((атом? (решта (перше поля))) (як-є ()))
         (так (перше (решта (перше поля))))))
      (так (репл-поле-поверхні поверхня (решта поля))))))

(визначити репл-назва-із-рядків
  (функція (текст поверхня рядки)
    (за-умовою
      ((атом? рядки) (як-є ()))
      ((атом? (перше рядки)) (як-є ()))
      (так
       ((функція (ключ)
          (за-умовою
            ((репл-доменне-слово? ключ)
             (за-умовою
               ((репл-біти-збігаються?
                  (репл-біти-списком текст) ключ)
                (репл-поле-поверхні
                  поверхня (решта (перше рядки))))
               (так
                (репл-назва-із-рядків
                  текст поверхня (решта рядки)))))
            (так (як-є ()))))
        (репл-текст-ключа (перше (перше рядки))))))))

(визначити репл-назва-з-таблиці
  (функція (текст поверхня таблиця)
    (за-умовою
      ((репл-поверхня? поверхня)
       (за-умовою
         ((репл-доменне-слово? текст)
          (за-умовою
            ((атом? таблиця) (як-є ()))
            ((тотожне? (перше таблиця) (як-є domain-table/1))
             (репл-назва-із-рядків текст поверхня (решта таблиця)))
            (так (як-є ()))))
         (так (як-є ()))))
      (так (як-є ())))))

; Сумісне ім'я попереднього читача: жодної другої таблиці ук.
(визначити репл-українська-назва-з-таблиці
  (функція (текст таблиця)
    (репл-назва-з-таблиці текст (як-є ук) таблиця)))

; Зворотний напрямок — назва -> бітове слово. Це пошук
; ДАНИХ для REPL, не автоматичний дозвіл викликати координату.
; Якщо імен немає або вони повторені, ніякого коду не повертаємо.
(визначити репл-ключі-із-рядків
  (функція (назва поверхня рядки знайдено)
    (за-умовою
      ((тотожне? знайдено (як-є неоднозначно)) (як-є неоднозначно))
      ((атом? рядки) знайдено)
      ((атом? (перше рядки)) (як-є ()))
      (так
       ((функція (ключ)
          (за-умовою
            ((репл-доменне-слово? ключ)
             (за-умовою
               ((тотожне?
                  (репл-поле-поверхні
                    поверхня (решта (перше рядки)))
                  назва)
                (за-умовою
                  ((тотожне? знайдено (як-є ()))
                   (репл-ключі-із-рядків
                     назва поверхня (решта рядки) ключ))
                  (так (як-є неоднозначно))))
               (так
                (репл-ключі-із-рядків
                  назва поверхня (решта рядки) знайдено))))
            (так (як-є ()))))
        (репл-текст-ключа (перше (перше рядки))))))))

(визначити репл-код-з-таблиці
  (функція (назва поверхня таблиця)
    (за-умовою
      ((репл-поверхня? поверхня)
       (за-умовою
         ((атом? таблиця) (як-є ()))
         ((тотожне? (перше таблиця) (як-є domain-table/1))
          (за-умовою
            ((тотожне? назва (як-є ())) (як-є ()))
            (так ((функція (знайдено)
                (за-умовою
                  ((тотожне? знайдено (як-є неоднозначно))
                   (як-є ()))
                  (так знайдено)))
              (репл-ключі-із-рядків
                назва поверхня (решта таблиця) (як-є ()))))))
         (так (як-є ()))))
      (так (як-є ())))))

; Каталог складається з уже прочитаних ратифікованих таблиць:
; ((д1 domain-table/1 ...) ... (д10 domain-table/1 ...)).
; Такий носій не вимагає нового реєстру та зберігає ширину
; шляхом перевірки самих бітів (не десяткового числа).
(визначити репл-таблиця-домену
  (функція (позначка каталог)
    (за-умовою
      ((атом? каталог) (як-є ()))
      ((атом? (перше каталог)) (як-є ()))
      ((тотожне? (перше (перше каталог)) позначка)
       (за-умовою
         ((атом? (решта (перше каталог))) (як-є ()))
         (так (перше (решта (перше каталог))))))
      (так (репл-таблиця-домену позначка (решта каталог))))))

(визначити репл-показати-слово
  (функція (текст поверхня каталог)
    (за-умовою
      ((репл-доменне-слово? текст)
       ((функція (таблиця)
          (за-умовою
            ((атом? таблиця) (як-є ()))
            (так
             (репл-назва-з-таблиці текст поверхня таблиця))))
        (репл-таблиця-домену
          (репл-домен-рядка текст) каталог)))
      (так (як-є ())))))

; Зворотне читання імені ЗА ВКАЗАНИМ ДОMЕНОМ — без
; неоднозначного вибору коду за написанням. Схожі назви в
; різних доменах не склеюються.
(визначити репл-код-із-каталогу
  (функція (назва поверхня домен каталог)
    ((функція (таблиця)
       ((функція (ключ)
          (за-умовою
            ((атом? ключ) (як-є ()))
            ((тотожне? (репл-домен-рядка ключ) домен) ключ)
            (так (як-є ()))))
        (репл-код-з-таблиці назва поверхня таблиця)))
     (репл-таблиця-домену домен каталог))))

; Точне читання ІМЕНІ в обраній поверхні вимагає явного
; домену: (репл-код д4 LAMBDA) у режимі LISP.
; Без домену різні D1–D10 простори не можна ототожнювати.
(визначити репл-команда-коду?
  (функція (форма)
    (за-умовою
      ((атом? форма) ні)
      ((атом? (перше форма))
       (за-умовою
         ((тотожне? (перше форма) (як-є репл-код))
          (за-умовою
            ((атом? (решта форма)) ні)
            ((атом? (решта (решта форма))) ні)
            ((атом? (решта (решта (решта форма))))
             (за-умовою
               ((атом? (перше (решта форма)))
                (за-умовою
                  ((атом? (перше (решта (решта форма))))
                   (тотожне? (решта (решта (решта форма))) (як-є ())))
                  (так ні)))
               (так ні)))
            (так ні)))
         (так ні)))
      (так ні))))

; Крок повертає (оточення . (людська-назва . точне-слово)).
; Біти не втрачаються, а відсутня проєкція залишається ().
; Виконуваність функції не виводиться з її назви.
(визначити репл-крок-поверхні
  (функція (форма стан поверхня каталог)
    (за-умовою
      ((текст? форма)
       (сполучити
         (перше стан)
         (сполучити
           (репл-показати-слово форма поверхня каталог)
           (репл-доменний-рядок форма))))
      ((репл-команда-коду? форма)
       (сполучити
         (перше стан)
         (репл-код-із-каталогу
           (перше (решта (решта форма)))
           поверхня
           (перше (решта форма))
           каталог)))
      (так (репл-крок форма стан)))))

; Власна команда мови — рівно (репл-мова назва).
; Це лише керування відображенням; середовище SENS зберігається.
(визначити репл-команда-мови?
  (функція (форма)
    (за-умовою
      ((атом? форма) ні)
      ((атом? (перше форма))
       (за-умовою
         ((тотожне? (перше форма) (як-є репл-мова))
          (за-умовою
            ((атом? (решта форма)) ні)
            ((атом? (решта (решта форма)))
             (тотожне? (решта (решта форма)) (як-є ())))
            (так ні)))
         (так ні)))
      (так ні))))

; Лише команда-форма з РІВНО одним словом завершує сеанс.
; Сам символ репл-завершити у звичайній програмі не є командою.
; Завершення перевіряємо за структурою й чинною D3 тотожністю.
(визначити репл-завершення?
  (функція (форма)
    (за-умовою
      ((атом? форма) ні)
      ((атом? (перше форма))
       (за-умовою
         ((тотожне? (перше форма) (як-є репл-завершити))
          (за-умовою
            ((атом? (решта форма))
             (тотожне? (решта форма) (як-є ())))
            (так ні)))
         (так ні)))
      (так ні))))

(визначити репл-цикл-поверхонь
  (функція (стан поверхня каталог)
    ((функція (форма)
       (за-умовою
         ((репл-завершення? форма) стан)
         ((репл-команда-мови? форма)
          ((функція (наступна)
             (за-умовою
               ((репл-поверхня? наступна)
                ((функція (надруковано)
                   (репл-цикл-поверхонь стан наступна каталог))
                 (друкувати наступна)))
               (так
                ((функція (надруковано)
                   (репл-цикл-поверхонь стан поверхня каталог))
                 (друкувати (як-є невідома-поверхня))))))
           (перше (решта форма))))
         (так
          ((функція (наступний-стан)
             (друкувати (решта наступний-стан))
             (репл-цикл-поверхонь
               наступний-стан поверхня каталог))
           (репл-крок-поверхні форма стан поверхня каталог)))))
     (прочитати))))

; Вхідна точка всіх поверхонь. Виклик отримує вже ПРОЧИТАНИЙ
; каталог ратифікованих D1–D10 таблиць; Zig/host лише транспортує
; їхні байти. Жодної прихованої таблиці в REPL немає.
(визначити репл-запустити-поверхні
  (функція (каталог)
    (репл-цикл-поверхонь
      (репл-почати (як-є ())) (як-є ук) каталог)))

(визначити репл-виконати
  (функція (форми стан)
    (за-умовою
      ((атом? форми)
       (за-умовою
         ((тотожне? форми (як-є ())) стан)
         (так (ні))))
      (так
       (за-умовою
         ((репл-завершення? (перше форми)) стан)
         (так
          (репл-виконати
            (решта форми)
            (репл-крок (перше форми) стан))))))))

; Мовна обробка одного текстового рядка. Фізичне читання з термінала
; і друк залишаються чинними механізмами, а не новою мовою чи семантикою.
(визначити репл-обробити-рядок
  (функція (текст стан)
    (репл-крок (прочитати текст) стан)))

; READ — EVAL — PRINT — LOOP написано Lisp українською проєкцією.
; Ратифіковані D8 проєкції прочитати/друкувати дають тільки I/O;
; стан і значення вирішують D3-код і єдина власна SENS Lisp-функція.
; Користувач завершує введенням (репл-завершити).
(визначити репл-цикл
  (функція (стан)
    ((функція (форма)
       (за-умовою
         ((репл-завершення? форма) стан)
         (так
          ((функція (наступний-стан)
             (друкувати (решта наступний-стан))
             (репл-цикл наступний-стан))
           (репл-крок-з-доменами форма стан)))))
     (прочитати))))

; Раніше це був окремий цикл, який дублював READ/PRINT і
; відхиляв звичайний Lisp. Тепер це сумісна українська назва
; того самого єдиного SENS REPL для форм і D1–D10.
; Бітові слова на теперішньому фізичному reader-вході вводяться
; як Lisp-рядки: "0100111111", без перетворення D10 у виклик.
(визначити репл-цикл-доменів
  (функція ()
    (репл-цикл (репл-почати (як-є ())))))

; Детермінований прохід через чергу текстових рядків.
; Повторює той самий мовний крок, що й інтерактивний репл-цикл;
; носій списку потрібен лише для перевірки циклу без живого stdin.
; Структурне () завершує чергу; неправильний хвіст — відмова D1:NO.
; Точна команда (репл-завершити) завершує сеанс достроково,
; тож жоден рядок після неї не читається й не обчислюється.
(визначити репл-черга
  (функція (рядки стан)
    (за-умовою
      ((атом? рядки)
       (за-умовою
         ((тотожне? рядки (як-є ())) стан)
         (так (ні))))
      (так
       ((функція (прочитана-форма)
          (за-умовою
            ((репл-завершення? прочитана-форма) стан)
            (так
             ((функція (новий-стан)
                (друкувати (решта новий-стан))
                (репл-черга (решта рядки) новий-стан))
              (репл-крок-з-доменами прочитана-форма стан)))))
        (прочитати (перше рядки)))))))
