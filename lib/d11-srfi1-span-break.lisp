; Д11: бібліотечні композиції за ідеями Схем СРФІ-1 СПАН і ВРЕАК.
; Джерело: гттпс: і  і срфі.ссгемерс.орг і срфі-1 і срфі-1.гтмл
; Дія обмежена правильними скінченними списками і СЕНС Д1-предикатами.
; Це НЕ Д10 ПАРТІТІОН-ІФ: тут зупинка на першій невідповідності
; і без копіювання повертається сам початковий хвіст (суффіх).
; Результат - пара (префікс . решта): перше і решта без зовнішнє семантики.
; Жодного Д11 машинного примітива або нової ратифікації.
; SENS_PAIR_REGEN: 2026-10-25 remint canonical D11 and Core4 pairs after exact D6 uk/ukr source routing.
; Фізичний reader SENS не викликає анонімну функцію в голові форми.
; Д5 допоміжна функція одержує вже обчислену пару (префікс . суфікс).
(визначити приєднати-голову-до-розділу
  (функція (голова частини)
    (сполучити
      (сполучити голова (перше частини))
      (решта частини))))

; D3/D4: правильний суфікс закінчується лише структурним ().
; Один прохід без копіювання зберігає той самий суфікс.
; Лише точний D3:() завершує список; D1:ні як хвіст є Type.
; Повний аудит відбувається ДО першого виклику предиката.
(визначити підтвердити-правильний-суфікс
  (функція (поточний початковий)
    (за-умовою
      ((атом? поточний)
       (за-умовою
         ((тотожне? поточний (як-є ())) початковий)
         (так (перше поточний))))
      (так
       (підтвердити-правильний-суфікс
         (решта поточний) початковий)))))

; Після повного D3-підтвердження SPAN може завершити предикат
; на першому незбігу. Повертаємо той самий хвіст, а не його копію.
(визначити розділити-поки-умова-ядро
  (функція (умова елементи)
    (за-умовою
      ((порожній? елементи)
       (сполучити (як-є ()) (як-є ())))
      ((умова (перше елементи))
       (приєднати-голову-до-розділу
         (перше елементи)
         (розділити-поки-умова-ядро умова (решта елементи))))
      (так (сполучити (як-є ()) елементи)))))

(визначити розділити-поки-умова
  (функція (умова елементи)
    (розділити-поки-умова-ядро
      умова
      (підтвердити-правильний-суфікс
        елементи елементи))))

; СРФІ-1 ВРЕАК = СПАН за запереченням предиката, не ПАРТІТІОН.
; Замикання гарантовано зберігає початкову умову й порядок.
(визначити розділити-перед-умовою
  (функція (умова елементи)
    (розділити-поки-умова
      (функція (елемент)
        (хибне? (умова елемент)))
      елементи)))

; Д11 TAKE-UNTIL / DROP-UNTIL: виконавчі проєкції наявного BREAK.
; Вхідний D3-список уже перевіряє BREAK до виклику предиката.
; Перша позитивна D1-умова належить суфіксу, а не префіксу.
; Не створюємо нових доменних координат та машинних opcode.
(визначити взяти-до-умови
  (функція (умова елементи)
    (перше
      (розділити-перед-умовою умова елементи))))

(визначити відкинути-до-умови
  (функція (умова елементи)
    (решта
      (розділити-перед-умовою умова елементи))))
