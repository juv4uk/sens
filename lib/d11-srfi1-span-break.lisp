; D11: бібліотечні композиції за ідеями Scheme SRFI-1 SPAN/BREAK.
; Джерело: https://srfi.schemers.org/srfi-1/srfi-1.html
; Дія обмежена правильними скінченними списками і SENS D1-предикатами.
; Це НЕ D10 PARTITION-IF: тут зупинка на першій невідповідності
; і без копіювання повертається сам початковий хвіст (suffix).
; Результат — пара (префікс . решта): перше/решта без host семантики.
; Жодного D11 машинного примітива або нової ратифікації.

(визначити розділити-поки-умова
  (функція (умова елементи)
    (за-умовою
      ((атом? елементи)
       (сполучити (як-є ()) (як-є ())))
      ((умова (перше елементи))
       ((функція (частини)
          (сполучити
            (сполучити (перше елементи) (перше частини))
            (решта частини)))
        (розділити-поки-умова умова (решта елементи))))
      ((атом? (як-є ()))
       (сполучити (як-є ()) елементи)))))

; SRFI-1 BREAK = SPAN за запереченням предиката, не PARTITION.
; Замикання гарантовано зберігає початкову умову й порядок.
(визначити розділити-перед-умовою
  (функція (умова елементи)
    (розділити-поки-умова
      (функція (елемент)
        (хибне? (умова елемент)))
      елементи)))
