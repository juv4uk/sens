; lib/macro.lisp — мовне визначення макросів SENS.
;
; Значенням усього файла є один макрос. Завантажувач сам прив'язує до
; нього ратифіковані поверхневі назви; цей файл їх не дублює.
;
; Побудова розгортки належить мові:
;   (визначити ім'я (make-macro (функція параметри тіло...)))
;
; Виконувані керувальні й спискові форми мають точні українські голови:
; як-є, атом?, решта, перше, за-умовою, сполучити та функція.
; Цитовані «визначити» й «функція» є даними до розгортання.
;
; make-macro — наявна вузька межа матеріалізації замикання в макрос.
; Їй не призначається нова доменна тотожність або старий SID8/Sens8 код.
;
; Порожня форма чи форма лише з іменем дає помилку арності від
; наявної межі make-macro. Список тіла не обчислюється перед розгортанням.

(make-macro
  (функція форми
    (за-умовою
      ((атом? форми)
       (make-macro))
      ((атом? (решта форми))
       (make-macro))
      (так
       (сполучити
         (як-є визначити)
         (сполучити
           (перше форми)
           (сполучити
             (сполучити
               (як-є make-macro)
               (сполучити
                 (сполучити (як-є функція) (решта форми))
                 (як-є ())))
             (як-є ()))))))))
