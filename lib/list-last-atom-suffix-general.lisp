; Конкурс оптимізації СЕНС: суфікс від останнього атомарного елемента.
; Для скінченного правильного списку: одна лінійна проходка О(н).
; Зберігаємо посилання на наявний хвіст, не копіюємо жодної пари пари.
; порожній як елемент - атом Д3, а (порожній) як елемент - складена пара.
; Семантика тільки СЕНС Д1 і Д3 і Д5; Зіг і Т5М - фізичний носій.

(визначити суфікс-останнього-атома-далі
 (функція (елементи знайдений)
  (за-умовою
   ((атом? елементи) знайдений)
   ((атом? (перше елементи))
    (суфікс-останнього-атома-далі (решта елементи) елементи))
   (так
    (суфікс-останнього-атома-далі (решта елементи) знайдений)))))

(визначити суфікс-від-останнього-атома
 (функція (елементи)
  (суфікс-останнього-атома-далі елементи (як-є ()))))

; Рекурсивна структурна тотожність: ЕК тільки для двох атомів.
(визначити дерева-останнього-атома-однакові?
 (функція (лівий правий)
  (за-умовою
   ((атом? лівий)
    (за-умовою
     ((атом? правий) (тотожне? лівий правий))
     (так ні)))
   ((атом? правий) ні)
   ((дерева-останнього-атома-однакові?
      (перше лівий) (перше правий))
    (дерева-останнього-атома-однакові?
      (решта лівий) (решта правий)))
   (так ні))))

(визначити довести-суфікс-останнього-атома
 (функція (елементи очікуваний)
  (за-умовою
   ((дерева-останнього-атома-однакові?
      (суфікс-від-останнього-атома елементи) очікуваний)
    (атом? (як-є ())))
   (так (перше (як-є ()))))))

; Порожнє джерело або тільки складені елементи не мають атомного суфікса.
(довести-суфікс-останнього-атома (як-є атом?) (як-є ()))
(довести-суфікс-останнього-атома (як-є решта) (як-є ()))
(довести-суфікс-останнього-атома (як-є ()) (як-є ()))
(довести-суфікс-останнього-атома
 (список (список (як-є атом?))) (як-є ()))
(довести-суфікс-останнього-атома
 (список (список (як-є атом?)) (список (як-є решта))) (як-є ()))
(довести-суфікс-останнього-атома
 (список (список (як-є ()))) (як-є ()))

; Одиночний атом і порожній атом порожній на місці елемента.
(довести-суфікс-останнього-атома
 (список (як-є атом?)) (список (як-є атом?)))
(довести-суфікс-останнього-атома
 (список (як-є ())) (список (як-є ())))
(довести-суфікс-останнього-атома
 (список (як-є атом?) (як-є решта) (як-є сполучити))
 (список (як-є сполучити)))

; Пара праворуч від останнього атома мусить зберегтись у суфіксі.
(довести-суфікс-останнього-атома
 (список (як-є атом?) (список (як-є решта)))
 (список (як-є атом?) (список (як-є решта))))
(довести-суфікс-останнього-атома
 (список (список (як-є атом?)) (як-є решта)
         (список (як-є сполучити)))
 (список (як-є решта) (список (як-є сполучити))))
(довести-суфікс-останнього-атома
 (список (як-є атом?) (список (як-є решта))
         (як-є тотожне?) (список (як-є сполучити)))
 (список (як-є тотожне?) (список (як-є сполучити))))

; порожній не можна пропускати, на відміну від складеного (порожній).
(довести-суфікс-останнього-атома
 (список (список (як-є атом?)) (як-є ())
         (список (як-є ())))
 (список (як-є ()) (список (як-є ()))))
(довести-суфікс-останнього-атома
 (список (як-є атом?) (список (як-є ())) (як-є ()))
 (список (як-є ())))
(довести-суфікс-останнього-атома
 (список (як-є ()) (список (як-є ())))
 (список (як-є ()) (список (як-є ()))))
(довести-суфікс-останнього-атома
 (список (список (як-є решта)) (як-є ())
         (список (як-є сполучити)) (як-є атом?))
 (список (як-є атом?)))

; Негативні закони: не вважати неатомарну пару атомом,
; не повертати перший, а не останній збіг, і не губити правий хвіст.
(за-умовою
 ((хибне? (дерева-останнього-атома-однакові?
    (суфікс-від-останнього-атома
      (список (список (як-є атом?)) (список (як-є решта))))
    (список (список (як-є решта)))))
  (атом? (як-є ())))
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (дерева-останнього-атома-однакові?
    (суфікс-від-останнього-атома
      (список (як-є атом?) (як-є решта)))
    (список (як-є атом?) (як-є решта))))
  (атом? (як-є ())))
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (дерева-останнього-атома-однакові?
    (суфікс-від-останнього-атома
      (список (як-є атом?) (список (як-є решта))))
    (список (як-є атом?))))
  (атом? (як-є ())))
 (так (перше (як-є ()))))

(атом? (як-є ()))
