; Д11 — знайти останній збіг із незалежною ознакою наявності.
; Бібліотечна композиція D1/D3/D4, без нової координати чи opcode.
; Залежність — чинна перевірка правильного списку FIND-PRESENCE.
; Повертає (так значення) або (ні ()); D1 ні може бути даними.
; Повний список перевіряється до першого виклику предиката.
; Тримати початковий D3-суфікс, не будувати (так значення)
; після кожного збігу; результат створюється лише на завершенні.
; Порожній суфікс означає відсутність, а D1:ні в парі — дані.
(визначити знайти-останній-із-наявністю-ядро
  (функція (умова залишок знайдений-хвіст)
    (за-умовою
      ((порожній? залишок)
       (за-умовою
         ((порожній? знайдений-хвіст) (список ні (як-є ())))
         (так (список так (перше знайдений-хвіст)))))
      ((умова (перше залишок))
       (знайти-останній-із-наявністю-ядро
         умова (решта залишок) залишок))
      (так
       (знайти-останній-із-наявністю-ядро
         умова (решта залишок) знайдений-хвіст)))))

(визначити знайти-останній-із-наявністю
  (функція (умова елементи)
    (знайти-останній-із-наявністю-ядро
      умова
      (перевірити-список-для-наявності елементи елементи)
      (як-є ()))))
