; СЕНС: знайти останній елемент за першокласним доменним предикатом.
; Одне проходження, O(1) додаткових пар: результат — початковий
; суфікс того самого списку. Ніякого копіювання, SID8 чи host-eval.
; Предикат — функція зі значенням Д1, а не текстова назва або D7-адреса.
; Для скінченного правильного списку відсутній збіг дає ().

(визначити суфікс-останнього-предиката-обхід
 (функція (умова елементи знайдений)
  (за-умовою
   ((порожній? елементи) знайдений)
   ((атом? елементи) знайдений)
   ((умова (перше елементи))
    (суфікс-останнього-предиката-обхід
     умова (решта елементи) елементи))
   (так
    (суфікс-останнього-предиката-обхід
     умова (решта елементи) знайдений)))))

(визначити суфікс-від-останнього-предиката
 (функція (умова елементи)
  (суфікс-останнього-предиката-обхід умова елементи (як-є ()))))

; Крайові випадки: немає вхідних пар, немає збігу, лише атом-джерело.
(за-умовою
 ((порожній? (суфікс-від-останнього-предиката атом? (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній?
   (суфікс-від-останнього-предиката атом?
    (список (список (як-є атом?)) (список (як-є решта))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (суфікс-від-останнього-предиката атом? (як-є атом?))) так)
 (так (перше (як-є ()))))

; Точний код Д3 АТОМ? передається як значення. Перемагає ОСТАННІЙ
; атом, хоча між ними є вкладені пари; правий хвіст не зникає.
(за-умовою
 ((тотожне?
   (перше
    (суфікс-від-останнього-предиката атом?
     (список (як-є атом?) (список (як-є решта))
             (як-є сполучити) (список (як-є визначити)))))
   (як-є сполучити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (перше (перше (решта
    (суфікс-від-останнього-предиката атом?
     (список (як-є атом?) (список (як-є решта))
             (як-є сполучити) (список (як-є визначити)))))))
   (як-є визначити)) так)
 (так (перше (як-є ()))))

; Інший першокласний предикат — мовне Д5-замикання. Він добирає
; тільки порожній об'єкт, не всі атоми. Так перевіряємо справжню
; параметризацію алгоритму, а не зашитий виклик АТОМ?.
(визначити лише-порожнє?
 (функція (значення) (порожній? значення)))
(за-умовою
 ((порожній?
   (перше
    (суфікс-від-останнього-предиката лише-порожнє?
     (список (як-є ()) (як-є атом?) (як-є ())
             (як-є решта))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (друге
    (суфікс-від-останнього-предиката лише-порожнє?
     (список (як-є ()) (як-є атом?) (як-є ())
             (як-є решта))))
   (як-є решта)) так)
 (так (перше (як-є ()))))

; Негативний закон: повернення першого збігу замість останнього — помилка.
(за-умовою
 ((хибне?
   (тотожне?
    (перше
     (суфікс-від-останнього-предиката атом?
      (список (як-є атом?) (як-є решта) (як-є сполучити))))
    (як-є атом?))) так)
 (так (перше (як-є ()))))

; Виконуваний Д1:1. СЕНС має виконати всі попередні закони, не хост.
(атом? (як-є ()))
