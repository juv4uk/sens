; Д3/Д4: вставити між двома елементами пари, зберігаючи порядок.
(визначити вставити-посеред-пари
  (функція (пара вставка)
    (список (перше пара) вставка (друге пара))))
(визначити трійка-після-вставлення
  (вставити-посеред-пари
    (список (як-є атом?) (як-є решта))
    (як-є тотожне?)))
(за-умовою
  ((тотожне? (перше трійка-після-вставлення) (як-є атом?))
   (за-умовою
     ((тотожне? (друге трійка-після-вставлення) (як-є тотожне?))
      (за-умовою
        ((тотожне? (перше (решта-решти трійка-після-вставлення)) (як-є решта))
         (хибне? (тотожне? (друге трійка-після-вставлення) (як-є решта))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
