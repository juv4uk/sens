; Зсув п'ятірки на дві позиції вліво. Обернення - зсув на три.
; Д3 і Д4: порядок зберігається циклічно, всі п'ять елементів повертаються.
; Реальне виконання СЕНС, без хостових боол, пітон і джейсон.
(визначити зсунути-п'ятірку-на-два
  (функція (елементи)
    (список (перше (решта (решта елементи)))
            (перше (решта (решта (решта елементи))))
            (перше (решта (решта (решта (решта елементи)))))
            (перше елементи)
            (перше (решта елементи)))))

(визначити зсунути-п'ятірку-на-три
  (функція (елементи)
    (список (перше (решта (решта (решта елементи))))
            (перше (решта (решта (решта (решта елементи)))))
            (перше елементи)
            (перше (решта елементи))
            (перше (решта (решта елементи))))))

(визначити початкова-п'ятірка
  (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?) (як-є порожній?)))
(визначити зсунута-п'ятірка
  (зсунути-п'ятірку-на-два початкова-п'ятірка))
(визначити відновлена-п'ятірка
  (зсунути-п'ятірку-на-три зсунута-п'ятірка))

; Позитиви: повна перестановка та зворотність кожної позиції.
; Негативи: результат відрізняється від початкової ідентичності.
; Будь-який провал доходить до недопустимого (перше (як-є ())).
(за-умовою
  ((тотожне? (перше зсунута-п'ятірка) (як-є сполучити)) (за-умовою
  ((тотожне? (перше (решта зсунута-п'ятірка)) (як-є тотожне?)) (за-умовою
  ((тотожне? (перше (решта (решта зсунута-п'ятірка))) (як-є порожній?)) (за-умовою
  ((тотожне? (перше (решта (решта (решта зсунута-п'ятірка)))) (як-є атом?)) (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта зсунута-п'ятірка))))) (як-є решта)) (за-умовою
  ((тотожне? (перше відновлена-п'ятірка) (як-є атом?)) (за-умовою
  ((тотожне? (перше (решта відновлена-п'ятірка)) (як-є решта)) (за-умовою
  ((тотожне? (перше (решта (решта відновлена-п'ятірка))) (як-є сполучити)) (за-умовою
  ((тотожне? (перше (решта (решта (решта відновлена-п'ятірка)))) (як-є тотожне?)) (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта відновлена-п'ятірка))))) (як-є порожній?)) (за-умовою
