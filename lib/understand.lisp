; Перетворення контрольованих речень на структуровані твердження знань.
; Джерела законів структур знань: lib/knowledge.lisp та lib/reason.lisp.
; Модуль реалізує перехід від послідовності слів до форми твердження,
; без статистичної мовної моделі й без самостійної семантики.
;
; Умовні форми мають дві складові. Безумовні гілки використовують
; точну істину першого домену; складені селектори належать чинній драбині.
; Назви і ширини функцій не виводяться зі збігу бітових суфіксів.
;
; Вхід — список слів, а не текстовий рядок. Розпізнаються лише три
; фіксовані структури: належність об'єкта до виду, тричленне
; відношення та загальне правило. Граматика є структурною.
; Англійські слова в цитуванні нижче — точні дані вхідного формату;
; їх переклад без зміни граматики порушив би сумісність.
;
; Запит також має фіксовану форму: належність об'єкта до виду
; або тричленне відношення. Вихід — структура цілі для міркування.

(визначити прибрати-артикль
  (функція (слова)
    (за-умовою
      ((атом? слова) (як-є ()))
      ((тотожне? (перше слова) (як-є a)) (решта слова))
      ((тотожне? (перше слова) (як-є an)) (решта слова))
      ((атом? (як-є ())) слова))))

(визначити побудувати-факт-є
  (функція (слова)
    (список (список (перше (прибрати-артикль (решта-решти слова))) (перше слова)))))

(визначити побудувати-факт-відношення
  (функція (слова)
    (список (список (друге слова) (перше слова) (третє слова)))))

(визначити побудувати-універсальне-правило
  (функція (слова)
    ; Виконуваний D9-помічник має власний D3-захист і прямих викликів.
    (за-умовою
      ((атом? слова) (як-є ()))
      ((атом? (решта слова)) (як-є ()))
      ((атом? (решта (решта слова))) (як-є ()))
      ((атом? (решта (решта (решта слова)))) (як-є ()))
      ((атом? (як-є ()))
       (список (список (як-є has) (список (як-є var) (як-є w)) (четверте слова))
               (список (друге слова) (список (як-є var) (як-є w))))))))

(визначити розібрати-контрольоване-твердження
  (функція (слова)
    (за-умовою
      ((атом? слова) (як-є ()))
      ; Дві D3 перевірки перед доступом до другого/третього слова.
      ((атом? (решта слова)) (як-є ()))
      ((атом? (решта (решта слова))) (як-є ()))
      ((тотожне? (перше слова) (як-є all))
       (розібрати-загальний слова))
      ((тотожне? (друге слова) (як-є is))
       (розібрати-є слова))
      ((атом? (як-є ()))
       (розібрати-відношення слова)))))

; Розбір запиту повертає форму цілі, доповнюючи розбір тверджень.
; Жодного морфологічного аналізу, мережевого звернення чи мовної моделі.
(визначити побудувати-запит-є
  (функція (слова)
    (список (перше (прибрати-артикль (решта-решти слова))) (друге слова))))

(визначити побудувати-запит-відношення
  (функція (слова)
    ; Четверте слово читаємо лише після перевірки всіх D3-хвостів.
    (за-умовою
      ((атом? слова) (як-є ()))
      ((атом? (решта слова)) (як-є ()))
      ((атом? (решта (решта слова))) (як-є ()))
      ((атом? (решта (решта (решта слова)))) (як-є ()))
      ((атом? (як-є ()))
       (список (третє слова) (друге слова) (четверте слова))))))

(визначити розібрати-контрольований-запит
  (функція (слова)
    (за-умовою
      ((атом? слова) (як-є ()))
      ; Неповний запит не запускає селектори відсутніх аргументів.
      ((атом? (решта слова)) (як-є ()))
      ((атом? (решта (решта слова))) (як-є ()))
      ((тотожне? (перше слова) (як-є is))
       (розібрати-запит-є слова))
      ((тотожне? (перше слова) (як-є does))
       (розібрати-запит-відношення слова))
      ((атом? (як-є ()))
       (як-є ())))))

; Виконувані українські назви дев'ятого домену звірено з
; lib/domains/d9.lisp; джерело законів — дослідницька таблиця
; knowledge/d9-semantic-layer-harvest-v1.json.
; Визначення прив'язують уже наявні мовні функції до ратифікованих назв.
; Нова машинна диспетчеризація дев'ятого домену тут не створюється.
; D9:000001011
(визначити розібрати-є побудувати-факт-є)
; D9:000001100
(визначити розібрати-відношення побудувати-факт-відношення)
; D9:000011111
(визначити розібрати-загальний побудувати-універсальне-правило)
; D9:000110001
(визначити розібрати розібрати-контрольоване-твердження)
; D9:000111001
(визначити розібрати-запит-є побудувати-запит-є)
; D9:000110000
(визначити розібрати-запит-відношення побудувати-запит-відношення)
; D9:000101010
(визначити розібрати-запит розібрати-контрольований-запит)

; Кінцевий виклик-свідок: файл виконується при завантаженні, а не лише визначає.
(прибрати-артикль (як-є (кіт собака)))
