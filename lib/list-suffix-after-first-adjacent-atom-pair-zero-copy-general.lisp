; СЕНС. Найперший суфікс після двох сусідніх атомних елементів.
; Один лінійний перегляд, жодного сполучити чи копіювання суфікса.
; Порожній елемент є атомом, вкладена пара атомом не є.
; Фізичні байти має створювати тільки нативний СЕНС та Зіг Т5М.

(визначити хвіст-після-сусідніх-атомів
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((порожній? (решта елементи)) (як-є ()))
   ((атом? (перше елементи))
    (за-умовою
     ((атом? (перше (решта елементи)))
      (решта (решта елементи)))
     (так (хвіст-після-сусідніх-атомів (решта елементи)))))
   (так (хвіст-після-сусідніх-атомів (решта елементи))))))

; Порожній, одноелементний та двоелементний входи.
(за-умовою
 ((порожній? (хвіст-після-сусідніх-атомів (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-сусідніх-атомів
              (список (як-є атом?)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-сусідніх-атомів
              (список (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))

; Перша пара атомів бере лише незмінений хвіст.
(за-умовою
 ((тотожне? (перше (хвіст-після-сусідніх-атомів
                    (список (як-є атом?) (як-є решта)
                            (як-є сполучити)))) (як-є сполучити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (друге (хвіст-після-сусідніх-атомів
                    (список (як-є атом?) (як-є решта)
                            (як-є сполучити) (як-є тотожне?))))
             (як-є тотожне?)) так)
 (так (перше (як-є ()))))

; Вкладені структури не утворюють атомної пари.
(за-умовою
 ((порожній? (хвіст-після-сусідніх-атомів
              (список (список (як-є атом?))
                      (список (як-є решта))
                      (як-є сполучити)))) так)
 (так (перше (як-є ()))))

; Пропустити складений елемент і зупинитись на першій справжній парі.
(за-умовою
 ((тотожне? (перше (хвіст-після-сусідніх-атомів
                    (список (список (як-є атом?))
                            (як-є решта) (як-є сполучити)
                            (як-є функція))))
             (як-є функція)) так)
 (так (перше (як-є ()))))

; Порожній вкладений елемент вважається атомом, а не кінцем списку.
(за-умовою
 ((тотожне? (перше (хвіст-після-сусідніх-атомів
                    (список (як-є ()) (як-є атом?)
                            (як-є решта)))) (як-є решта)) так)
 (так (перше (як-є ()))))

; Негативний свідок. Перший атом не входить у повернений суфікс.
(за-умовою
 ((хибне? (тотожне? (перше (хвіст-після-сусідніх-атомів
                           (список (як-є атом?) (як-є решта)
                                   (як-є сполучити))))
                    (як-є атом?))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
