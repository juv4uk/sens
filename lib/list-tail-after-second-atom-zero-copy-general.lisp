; СЕНС Д3 і Д5: повернути вихідний хвіст після другого атомного елемента.
; Атом () рахується, вкладений непорожній список - ні.
; Один прохід О(н), жодного сполучити та проміжного списку.
(визначити хвіст-після-наступного-атома
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи)) (решта елементи))
   (так (хвіст-після-наступного-атома (решта елементи))))))

(визначити хвіст-після-другого-атома
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-наступного-атома (решта елементи)))
   (так (хвіст-після-другого-атома (решта елементи))))))

; Неправильний атомарний хвіст також означає брак другого атома:
; не викликати ПЕРШЕ/РЕШТА від атома. Свідки обчислює сам СЕНС.
(за-умовою
 ((порожній? (хвіст-після-другого-атома (як-є решта))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-другого-атома
   (сполучити (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-другого-атома
   (сполучити (список (як-є атом?)) (як-є решта)))) так)
 (так (перше (як-є ()))))

; Позитиви та негативи виконуються тільки СЕНС, помилковий закон означає перше(порожній).
(за-умовою
 ((порожній? (хвіст-після-другого-атома (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-другого-атома
   (список (як-є атом?)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-другого-атома
   (список (список (як-є атом?))
           (список (як-є решта))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-другого-атома
   (список (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (перше (хвіст-після-другого-атома
     (список (як-є атом?) (список (як-є сполучити))
             (як-є решта) (як-є визначити))))
   (як-є визначити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (перше (хвіст-після-другого-атома
     (список (список (як-є атом?)) (як-є ())
             (список (як-є решта))
             (як-є визначити) (як-є сполучити))))
   (як-є сполучити)) так)
 (так (перше (як-є ()))))
; Третій атом зберігається, пропущені складені елементи не рахуються.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-другого-атома
     (список (список (як-є решта))
             (як-є атом?) (як-є сполучити) (як-є функція))))
   (як-є функція)) так)
 (так (перше (як-є ()))))
; Негатив: голова перед другим атомом не є частиною хвоста.
(за-умовою
 ((хибне?
   (тотожне?
     (перше (хвіст-після-другого-атома
       (список (як-є атом?) (як-є решта) (як-є функція))))
     (як-є атом?))) так)
 (так (перше (як-є ()))))
(атом? (як-є ()))
