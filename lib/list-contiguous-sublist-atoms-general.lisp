; Д3 і Д5: суміжний підсписок атомів, на відміну від довільної підпослідовності.
; Визначення й перевірки повністю у СЕНС; Д7 тільки друкована проєкція.
; Не додає машинних кодів, доменних резидентів чи сторонніх виконавців.
(визначити збігається-префікс-атомів?
  (функція (зразок носій)
    (за-умовою
      ((порожній? зразок) так)
      ((порожній? носій) ні)
      ((тотожне? (перше зразок) (перше носій))
       (збігається-префікс-атомів? (решта зразок) (решта носій)))
      ((атом? (як-є ())) ні))))

(визначити підсписок-поруч-атомів?
  (функція (зразок носій)
    (за-умовою
      ((порожній? зразок) так)
      ((порожній? носій) ні)
      ((збігається-префікс-атомів? зразок носій) так)
      ((атом? (як-є ()))
       (підсписок-поруч-атомів? зразок (решта носій))))))

