; Зворотний правий зсув четвірки: атом тотожне решта сполучити до сполучити атом тотожне решта.
; Лише ратифіковані Д3/Д4 операції, без текстових чи хостових кодів.
(визначити зсунути-четвірку-праворуч
  (функція (елементи)
    (список
      (друге (решта-решти елементи))
      (перше елементи)
      (друге елементи)
      (перше (решта-решти елементи)))))
(визначити четвірка-після-правого-зсуву
  (зсунути-четвірку-праворуч
    (список (як-є атом?) (як-є тотожне?) (як-є решта) (як-є сполучити))))
; П'ять позитивних D1 законів, включно з подвійним зсувом, і негатив проти незміненого порядку.
(визначити результат четвірка-після-правого-зсуву)
(за-умовою
  ((тотожне? (перше результат) (як-є сполучити))
   (за-умовою
     ((тотожне? (друге результат) (як-є атом?))
      (за-умовою
        ((тотожне? (перше (решта-решти результат)) (як-є тотожне?))
         (за-умовою
           ((тотожне? (друге (решта-решти результат)) (як-є решта))
            (за-умовою
              ((тотожне? (перше (зсунути-четвірку-праворуч результат)) (як-є решта))
               (хибне? (тотожне? (перше результат) (як-є атом?))))
              ((атом? (як-є ())) (перше (як-є ())))))
           ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))

; Обернений закон чотирьох послідовних циклічних зсувів.
(визначити відновлена-четвірка
  (зсунути-четвірку-праворуч
    (зсунути-четвірку-праворуч
      (зсунути-четвірку-праворуч результат))))
(за-умовою
  ((тотожне? (перше відновлена-четвірка) (як-є атом?))
   (за-умовою
     ((тотожне? (друге відновлена-четвірка) (як-є тотожне?))
      (за-умовою
        ((тотожне? (перше (решта-решти відновлена-четвірка)) (як-є решта))
         (тотожне? (друге (решта-решти відновлена-четвірка)) (як-є сполучити)))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
