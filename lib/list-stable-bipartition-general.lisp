; СЕНС Д3-Д5: стійкий двопотоковий поділ скінченного списку точних атомів.
; Перша частина містить усі входження атомів із набору, друга - решту.
; Порядок і повтори кожної частини не змінюються; стороння семантика відсутня.
; Д7 - лише людська поверхня, Зіг і Т5М - обернене фізичне перенесення.

(визначити належить-для-стійкого-поділу?
  (функція (атом набір)
    (за-умовою
      ((атом? набір) (хибне? (атом? (як-є ()))))
      ((тотожне? атом (перше набір)) (атом? (як-є ())))
      ((атом? (як-є ())) (належить-для-стійкого-поділу? атом (решта набір))))))

(визначити вибрати-наявні-атоми
  (функція (елементи набір)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((належить-для-стійкого-поділу? (перше елементи) набір)
       (сполучити (перше елементи)
         (вибрати-наявні-атоми (решта елементи) набір)))
      ((атом? (як-є ()))
       (вибрати-наявні-атоми (решта елементи) набір)))))

(визначити вибрати-відсутні-атоми
  (функція (елементи набір)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((належить-для-стійкого-поділу? (перше елементи) набір)
       (вибрати-відсутні-атоми (решта елементи) набір))
      ((атом? (як-є ()))
       (сполучити (перше елементи)
         (вибрати-відсутні-атоми (решта елементи) набір))))))

(визначити поділити-стійко-за-набором
  (функція (елементи набір)
    (список
      (вибрати-наявні-атоми елементи набір)
      (вибрати-відсутні-атоми елементи набір))))

(визначити початкові-атоми (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є атом?) (як-є хибне?) (як-є тотожне?) (як-є решта) (як-є як-є) (як-є атом?)))
(визначити набір-атомів (список (як-є атом?) (як-є хибне?) (як-є решта) (як-є хибне?)))
(визначити поділені-атоми (поділити-стійко-за-набором початкові-атоми набір-атомів))
(визначити перша-частина (перше поділені-атоми))
(визначити друга-частина (друге поділені-атоми))

