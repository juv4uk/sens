; Д11: дві ВУЗЬКІ чисті бібліотечні підзадачі історичних Interlisp DWIM/Masterscope.
; DWIM: тільки явні пропозиції з переданого контексту, без пошуку за схожістю,
; ніякої тихої заміни, неоднозначний вибір ніколи не вирішується навмання.
; Masterscope: тільки прямі синтаксичні виклики у скінченних S-виразах.
; QUOTE і лексично зв'язані параметри не утворюють виклик до зовнішньої цілі.
; Це НЕ повні DWIM, Masterscope, індексація робочого простору чи dynamic APPLY.
; Жодної нової ратифікації, D11-opcode, SID8, Python/JSON семантики.

(визначити dwim-варіант-у-списку?
  (функція (варіант варіанти)
    (за-умовою
      ((порожній? варіанти) ні)
      ((тотожне? варіант (перше варіанти)) так)
      (так (dwim-варіант-у-списку? варіант (решта варіанти))))))

; Кожний запис контексту — (помилкова-назва запропонована-назва).
; Повторне підтвердження того ж варіанта не створює неоднозначності.
(визначити dwim-зібрати-варіанти
  (функція (помилка записи)
    (за-умовою
      ((порожній? записи) (як-є ()))
      ((тотожне? помилка (перше (перше записи)))
       ((функція (хвіст)
          (за-умовою
            ((dwim-варіант-у-списку? (друге (перше записи)) хвіст) хвіст)
            (так (сполучити (друге (перше записи)) хвіст))))
        (dwim-зібрати-варіанти помилка (решта записи))))
      (так (dwim-зібрати-варіанти помилка (решта записи))))))

; Статус + початкова назва + можливий варіант. НІКОЛИ не виконує виправлення.
(визначити dwim-запропонувати-з-контексту
  (функція (помилка записи)
    ((функція (варіанти)
       (за-умовою
         ((порожній? варіанти)
          (список (як-є без-пропозиції) помилка))
         ((порожній? (решта варіанти))
          (список (як-є пропозиція) помилка (перше варіанти)))
         (так (список (як-є неоднозначно) помилка))))
     (dwim-зібрати-варіанти помилка записи))))

(визначити мастерскоп-зв'язане?
  (функція (ім'я зв'язані)
    (за-умовою
      ((порожній? зв'язані) ні)
      ((тотожне? ім'я (перше зв'язані)) так)
      (так (мастерскоп-зв'язане? ім'я (решта зв'язані))))))

(визначити мастерскоп-додати-параметри
  (функція (параметри зв'язані)
    (за-умовою
      ((порожній? параметри) зв'язані)
      (так
       (сполучити (перше параметри)
         (мастерскоп-додати-параметри (решта параметри) зв'язані))))))

(визначити мастерскоп-є-в-формах?
  (функція (ціль форми зв'язані)
    (за-умовою
      ((порожній? форми) ні)
      ((мастерскоп-є-прямий-виклик? ціль (перше форми) зв'язані) так)
      (так (мастерскоп-є-в-формах? ціль (решта форми) зв'язані)))))

(визначити мастерскоп-є-прямий-виклик?
  (функція (ціль форма зв'язані)
    (за-умовою
      ((атом? форма) ні)
      ((тотожне? (перше форма) (як-є як-є)) ні)
      ((тотожне? (перше форма) (як-є функція))
       (мастерскоп-є-в-формах?
         ціль (решта (решта форма))
         (мастерскоп-додати-параметри (друге форма) зв'язані)))
      ((атом? (перше форма))
       (за-умовою
         ((тотожне? (перше форма) ціль)
          (за-умовою
            ((мастерскоп-зв'язане? ціль зв'язані)
             (мастерскоп-є-в-формах? ціль (решта форма) зв'язані))
            (так так)))
         (так (мастерскоп-є-в-формах? ціль (решта форма) зв'язані))))
      (так (мастерскоп-є-в-формах? ціль форма зв'язані)))))

; Не граф цілого проєкту, а одна точна ознака прямого виклику.
(визначити мастерскоп-знайти-прямий-виклик?
  (функція (ціль форма)
    (мастерскоп-є-прямий-виклик? ціль форма (як-є ()))))
