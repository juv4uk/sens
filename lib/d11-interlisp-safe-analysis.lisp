; Д11: дві ВУЗЬКІ чисті бібліотечні підзадачі історичних Інтерлісп та його аналізу викликів.
; Підказки: тільки явні пропозиції з переданого контексту, без пошуку за схожістю,
; ніякої тихої заміни, неоднозначний вибір ніколи не вирішується навмання.
; Аналіз викликів: тільки прямі синтаксичні виклики у скінченних С-виразах.
; цитування і лексично зв'язані параметри не утворюють виклик до зовнішньої цілі.
; Це НЕ повні системи підказок, повна індексація чи динамічне застосування.
; Жодної нової ратифікації, машинної координати або зовнішньої семантики.
; Імена сьомого домену можуть бути фізичними гліфовими списками: для їх тотожності
; потрібна ратифікована рівність восьмого домену ОДНАКОВІ?, а не атомна тотожність третього домену.

(визначити підказка-варіант-у-списку?
  (функція (варіант варіанти)
    (за-умовою
      ((порожній? варіанти) (хибне? (порожній? (як-є ()))))
      ((однакові? варіант (перше варіанти)) (порожній? (як-є ())))
      ((порожній? (як-є ())) (підказка-варіант-у-списку? варіант (решта варіанти))))))

; Кожний запис контексту - (помилкова-назва запропонована-назва).
; Повторне підтвердження того ж варіанта не створює неоднозначності.
(визначити підказка-зібрати-варіанти
  (функція (помилка записи)
    (за-умовою
      ((порожній? записи) (як-є ()))
      ((однакові? помилка (перше (перше записи)))
       ((функція (хвіст)
          (за-умовою
            ((підказка-варіант-у-списку? (друге (перше записи)) хвіст) хвіст)
            ((порожній? (як-є ())) (сполучити (друге (перше записи)) хвіст))))
        (підказка-зібрати-варіанти помилка (решта записи))))
      ((порожній? (як-є ())) (підказка-зібрати-варіанти помилка (решта записи))))))

; Статус + початкова назва + можливий варіант. НІКОЛИ не виконує виправлення.
(визначити підказка-з-контексту
  (функція (помилка записи)
    ((функція (варіанти)
       (за-умовою
         ((порожній? варіанти)
          (список (як-є без-пропозиції) помилка))
         ((порожній? (решта варіанти))
          (список (як-є пропозиція) помилка (перше варіанти)))
         ((порожній? (як-є ())) (список (як-є неоднозначно) помилка))))
     (підказка-зібрати-варіанти помилка записи))))

(визначити мастерскоп-зв'язане?
  (функція (ім'я зв'язані)
    (за-умовою
      ((порожній? зв'язані) (хибне? (порожній? (як-є ()))))
      ((однакові? ім'я (перше зв'язані)) (порожній? (як-є ())))
      ((порожній? (як-є ())) (мастерскоп-зв'язане? ім'я (решта зв'язані))))))

(визначити мастерскоп-додати-параметри
  (функція (параметри зв'язані)
    (за-умовою
      ((порожній? параметри) зв'язані)
      ((порожній? (як-є ()))
       (сполучити (перше параметри)
         (мастерскоп-додати-параметри (решта параметри) зв'язані))))))

(визначити мастерскоп-є-в-формах?
  (функція (ціль форми зв'язані)
    (за-умовою
      ((порожній? форми) (хибне? (порожній? (як-є ()))))
      ((мастерскоп-є-прямий-виклик? ціль (перше форми) зв'язані) (порожній? (як-є ())))
      ((порожній? (як-є ())) (мастерскоп-є-в-формах? ціль (решта форми) зв'язані)))))

(визначити мастерскоп-є-прямий-виклик?
  (функція (ціль форма зв'язані)
    (за-умовою
      ((порожній? форма) (хибне? (порожній? (як-є ()))))
      ((атом? форма) (хибне? (порожній? (як-є ()))))
      ((однакові? (перше форма) (як-є як-є)) (хибне? (порожній? (як-є ()))))
      ((однакові? (перше форма) (як-є функція))
       (мастерскоп-є-в-формах?
         ціль (решта (решта форма))
         (мастерскоп-додати-параметри (друге форма) зв'язані)))
      ; Текстова голова сьомого домену не обов'язково є атомом третього домену.
      ; Перед перевіркою атомності третього домену впізнаємо точну ціль через восьмий домен.
      ((однакові? (перше форма) ціль)
       (за-умовою
         ((мастерскоп-зв'язане? ціль зв'язані)
          (мастерскоп-є-в-формах? ціль (решта форма) зв'язані))
         ((порожній? (як-є ())) (порожній? (як-є ())))))
      ; Незбігла голова сьомого домену — це послідовність гліфів, а не атом третього домену.
      ; Вона НЕ є новою формою для повторного входу: переглядаємо лише
      ; аргументи. Сканування «форма» замість «решта форма» повторно
      ; інтерпретувало текстову голову та ламало фізичний обхід п'ятитрійкового носія.
      ((порожній? (як-є ())) (мастерскоп-є-в-формах? ціль (решта форма) зв'язані)))))

; Не граф цілого проєкту, а одна точна ознака прямого виклику.
(визначити мастерскоп-знайти-прямий-виклик?
  (функція (ціль форма)
    (мастерскоп-є-прямий-виклик? ціль форма (як-є ()))))
