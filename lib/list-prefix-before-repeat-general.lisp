; Д3 і Д5. Взяти найдовший початковий відрізок без повторних атомів.
; Перший повтор зупиняє обхід до включення повторного атома.
; Семантику виконує лише СЕНС.

(визначити бачили-раніше?
  (функція (шуканий попередні)
    (за-умовою
      ((атом? попередні) ні)
      ((тотожне? шуканий (перше попередні)) так)
      (так (бачили-раніше? шуканий (решта попередні))))))

(визначити префікс-без-повторів-з-історією
  (функція (елементи попередні)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((бачили-раніше? (перше елементи) попередні) (як-є ()))
      (так
       (сполучити (перше елементи)
         (префікс-без-повторів-з-історією
           (решта елементи)
           (сполучити (перше елементи) попередні)))))))

(визначити префікс-без-повторів
  (функція (елементи)
    (префікс-без-повторів-з-історією елементи (як-є ()))))

(префікс-без-повторів (список (як-є а) (як-є б) (як-є а) (як-є в)))
