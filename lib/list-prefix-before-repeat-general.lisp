      ((тотожне? шуканий (перше попередні)) (атом? (як-є ())))
      ((атом? (як-є ())) (бачили-раніше? шуканий (решта попередні))))))

(визначити префікс-без-повторів-з-історією
  (функція (елементи попередні)
    (за-умовою
      ((атом? елементи) (як-є ()))
