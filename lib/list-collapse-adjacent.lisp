; СЕНС Д3 і Д4: стискати лише СУСІДНІ однакові атоми скінченного списку.
; Не видаляти несусідні повтори. Порядок груп і точні доменні коди зберігаються.
; Без пітон і джейсон і Унісоде-перекодування, нових кодів або резидентів.
(визначити стиснути-сусідні
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) елементи)
      ((тотожне? (перше елементи) (друге елементи))
       (стиснути-сусідні (решта елементи)))
      ((атом? (як-є ()))
       (сполучити (перше елементи)
         (стиснути-сусідні (решта елементи)))))))

(визначити початкова-вісімка
  (список (як-є атом?) (як-є атом?) (як-є решта) (як-є тотожне?) (як-є тотожне?) (як-є сполучити) (як-є порожній?) (як-є порожній?)))
(визначити стиснутий-список
  (стиснути-сусідні початкова-вісімка))
(визначити несусідні-повтори
  (стиснути-сусідні
    (список (як-є атом?) (як-є решта) (як-є атом?))))

(визначити незмінний-список
  (стиснути-сусідні
    (список (як-є атом?) (як-є решта) (як-є сполучити))))

; Реальне виконання в СЕНС: кожна позиція, точний кінець, порожній і
; одиничний базиси, повтори всіх елементів, відсутність злиття несусідніх.
; Негативи мають давати Д1:так лише коли хибні очікування відхилено.
(за-умовою
  ((тотожне? (перше стиснутий-список) (як-є атом?))
   (за-умовою
  ((тотожне? (перше (решта стиснутий-список)) (як-є решта))
   (за-умовою
  ((тотожне? (перше (решта (решта стиснутий-список))) (як-є тотожне?))
   (за-умовою
  ((тотожне? (перше (решта (решта (решта стиснутий-список)))) (як-є сполучити))
   (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта стиснутий-список))))) (як-є порожній?))
   (за-умовою
  ((атом? (решта (решта (решта (решта (решта стиснутий-список))))))
   (за-умовою
  ((атом? (стиснути-сусідні (як-є ())))
   (за-умовою
  ((тотожне? (перше (стиснути-сусідні (список (як-є атом?)))) (як-є атом?))
   (за-умовою
  ((атом? (решта (стиснути-сусідні (список (як-є атом?) (як-є атом?) (як-є атом?)))))
   (за-умовою
  ((тотожне? (перше (стиснути-сусідні (список (як-є атом?) (як-є атом?)))) (як-є атом?))
   (за-умовою
  ((тотожне? (перше незмінний-список) (як-є атом?))
   (за-умовою
  ((тотожне? (перше (решта незмінний-список)) (як-є решта))
   (за-умовою
  ((тотожне? (перше (решта (решта незмінний-список))) (як-є сполучити))
   (за-умовою
  ((хибне? (тотожне? (перше (решта стиснутий-список)) (як-є атом?)))
   (за-умовою
  ((хибне? (тотожне? (перше (решта (решта стиснутий-список))) (як-є решта)))
   (за-умовою
  ((тотожне? (перше (решта початкова-вісімка)) (як-є атом?))
   (за-умовою
     ((тотожне? (перше несусідні-повтори) (як-є атом?))
      (за-умовою
        ((тотожне? (друге несусідні-повтори) (як-є решта))
         (за-умовою
           ((тотожне? (перше (решта-решти несусідні-повтори)) (як-є атом?))
            (за-умовою
              ((атом? (решта (решта (решта несусідні-повтори))))
               (атом? (як-є ())))
              ((атом? (як-є ())) (перше (як-є ())))))
           ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
