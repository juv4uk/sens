; СЕНС сам перевіряє три негативні випадки з різною кратністю і порядком.
(визначити серійні-негативні-закони?
 (функція ()
  (за-умовою
   ((хибне? (однакові-вкладені-списки?
     (закодувати-унарні-серії (список (як-є атом?) (як-є атом?)))
     (закодувати-унарні-серії (список (як-є атом?)))))
    (за-умовою
     ((хибне? (однакові-вкладені-списки?
       (закодувати-унарні-серії (список (як-є атом?) (як-є решта) (як-є атом?)))
       (закодувати-унарні-серії (список (як-є атом?) (як-є атом?) (як-є решта)))))
      (за-умовою
       ((хибне? (однакові-вкладені-списки?
         (розкодувати-унарні-серії
          (закодувати-унарні-серії (список (як-є атом?) (як-є решта))))
         (список (як-є решта) (як-є атом?))))
        так)
       (так ні)))
     (так ні)))
   (так ні))))

