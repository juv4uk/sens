; Серійне кодування без втрати кратності для списків атомів СЕНС.
; Лічильники є унарними списками точних атомів, не чужими числами.
; Повну семантику обчислює СЕНС, Зіґ зберігає точний носій.

(визначити відокремити-серію-унарно
 (функція (елементи шукане лічильник)
  (за-умовою
   ((порожній? елементи) (список лічильник (як-є ())))
   ((тотожне? (перше елементи) шукане)
    (відокремити-серію-унарно
     (решта елементи) шукане
     (сполучити (як-є атом?) лічильник)))
   (так (список лічильник елементи)))))

(визначити додати-закодовану-серію
 (функція (значення розбір)
  (сполучити
   (список значення (перше розбір))
   (закодувати-унарні-серії (друге розбір)))))

(визначити закодувати-унарні-серії
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   (так (додати-закодовану-серію
         (перше елементи)
         (відокремити-серію-унарно
          (решта елементи) (перше елементи) (список (як-є атом?))))))))

(визначити розгорнути-унарну-серію
 (функція (значення лічильник хвіст)
  (за-умовою
   ((порожній? лічильник) хвіст)
   (так (сполучити значення
         (розгорнути-унарну-серію значення (решта лічильник) хвіст))))))

(визначити розкодувати-унарні-серії
 (функція (серії)
  (за-умовою
   ((порожній? серії) (як-є ()))
   (так (розгорнути-унарну-серію
         (перше (перше серії))
         (друге (перше серії))
         (розкодувати-унарні-серії (решта серії)))))))

(визначити однакові-вкладені-списки?
 (функція (лівий правий)
  (за-умовою
   ((атом? лівий)
    (за-умовою
     ((атом? правий) (тотожне? лівий правий))
     (так ні)))
   ((атом? правий) ні)
   ((однакові-вкладені-списки? (перше лівий) (перше правий))
    (однакові-вкладені-списки? (решта лівий) (решта правий)))
   (так ні))))

(визначити перевірити-унарні-серії
 (функція (випадки)
  (за-умовою
   ((порожній? випадки) так)
   ((однакові-вкладені-списки?
      (закодувати-унарні-серії (перше (перше випадки)))
      (друге (перше випадки)))
    (за-умовою
     ((однакові-вкладені-списки?
       (розкодувати-унарні-серії (друге (перше випадки)))
       (перше (перше випадки)))
      (перевірити-унарні-серії (решта випадки)))
     (так ні)))
   (так ні))))

