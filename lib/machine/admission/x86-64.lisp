(визначити машина-кодувати-допущену-команду
  (функція (форма)
    (за-умовою
      ((машина-допуск-збіг-шаблону? (як-є (ret)) форма)
       (машина-кодувати-повернення))
      ((машина-допуск-збіг-шаблону? (як-є (mov-r64-imm64 register immediate)) форма)
       (машина-кодувати-завантаження-числа-64-до-регістра (друге форма) (третє форма)))
      ((машина-допуск-збіг-шаблону? (як-є (mov-r64-r64 register register)) форма)
       (машина-кодувати-пересилання-регістрів-64 (друге форма) (третє форма)))
      ((машина-допуск-збіг-шаблону? (як-є (add-r64-r64 register register)) форма)
       (машина-кодувати-додавання-регістрів-64 (друге форма) (третє форма)))
      ((машина-допуск-збіг-шаблону? (як-є (or-r64-r64 register register)) форма)
       (машина-кодувати-або-регістрів-64 (друге форма) (третє форма)))
      ((машина-допуск-збіг-шаблону? (як-є (and-r64-r64 register register)) форма)
