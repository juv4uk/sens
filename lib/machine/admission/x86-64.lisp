       (машина-кодувати-векторне-додавання-подвійної-точності
         (друге форма) (третє форма) (перше (решта (решта (решта форма))))))
      ((машина-допуск-збіг-шаблону?
         (як-є
           (pclmulqdq-xmm-mem-disp8-imm8
             xmm-register register disp8 uimm8))
         форма)
       (машина-кодувати-множення-без-перенесення-память
         (друге форма) (третє форма) (перше (решта (решта (решта форма)))) (п'ятий форма)))
      ; Після допуску ця гілка недосяжна: повертаємо дані відмови,
      ; не вигадуючи запасного механізму кодування.
      ((атом? ()) (як-є ())))))

; Зіставлення команд залишається в алгебрі значень D3.
; Спільне тіло Core4 map-onto ще використовує сумісні предикати як умови COND.
(визначити машина-кодувати-список-команд
  (функція (форми)
    (за-умовою
      ((атом? форми) (як-є ()))
      ((хибне? (атом? форми))
       (сполучити
         (машина-кодувати-допущену-команду (перше форми))
         (машина-кодувати-список-команд (решта форми)))))))

(визначити машина-кодувати-допущену-програму
  (функція (форми)
    (машина-кодувати-програму-інструкцій (машина-кодувати-список-команд форми))))

; #177 — безпечна межа композиції. На відміну від
; x86-encode-admitted-program, цей вхід мусить довести допуск
; довільних структурованих машинних даних до створення байтів.
(визначити машина-кодувати-допущену-програму-або-відхилити
  (функція (форми)
    (за-умовою
      ((машина-програма-допущена? форми)
       (машина-кодувати-допущену-програму форми))
      ((атом? ())
       (список (як-є rejected)
             (як-є unadmitted-machine-form)
             (машина-перша-недопущена-форма форми))))))

(визначити викликати-допущену-машинну-програму
  (функція (форми байти-області)
    (за-умовою
      ((машина-програма-допущена? форми)
       (за-умовою
         ((тотожне? байти-області 0)
          (native-call-u64-raw (машина-кодувати-допущену-програму форми)))
         ((атом? ())
          (native-call-u64-raw (машина-кодувати-допущену-програму форми) байти-області))))
      ((атом? ())
       (список (як-є rejected)
             (як-є unadmitted-machine-form)
             (машина-перша-недопущена-форма форми))))))

