; `immediate`, `register`, `disp8` — шаблони місць операндів, не кодів операцій.
; `register` приймає лише 16 назв регістрів GPR, відомих x86-reg-code.
; Інші атоми, числові та вигадані символи не відповідають шаблону.
; Кодувальник Lisp перевіряє представність до звернення до хоста.
; Викличні голови D3: EQ=101, CAR=100, CDR=011; історичні псевдоніми не відновлюємо.
(визначити машина-допуск-збіг-шаблону?
  (функція (шаблон форма)
    (за-умовою
      
      ((атом? шаблон)  (за-умовою
         ((тотожне? шаблон (як-є immediate)) (атом? (як-є ())))
         ((тотожне? шаблон (як-є register))
          (за-умовою
            ((атом? форма)
             (за-умовою
               ((порожній? (машина-код-регістра форма)) (атом? (як-є (000))))
               ((атом? (машина-код-регістра форма))
                (атом? ()))
               ((атом? ()) (атом? (як-є (000))))))
            ((атом? ()) (атом? (як-є (000))))))
         ((тотожне? шаблон (як-є xmm-register))
          (за-умовою
            ((атом? форма)
             (за-умовою
               ((порожній? (машина-код-векторного-регістра форма)) (атом? (як-є (000))))
               ((атом? (машина-код-векторного-регістра форма))
                (атом? ()))
               ((атом? ()) (атом? (як-є (000))))))
            ((атом? ()) (атом? (як-є (000))))))
         ((тотожне? шаблон (як-є disp8))
          (за-умовою
            
            ((атом? форма)  (машина-допуск-зсув-8? форма))
            ((атом? ()) (атом? (як-є (000))))))
         ((тотожне? шаблон (як-є imm32))
          (за-умовою
            
            ((атом? форма)  (машина-допуск-число-32? форма))
            ((атом? ()) (атом? (як-є (000))))))
         ((тотожне? шаблон (як-є uimm8))
          (за-умовою
            
            ((атом? форма)  (машина-допуск-беззнакове-число-8? форма))
            ((атом? ()) (атом? (як-є (000))))))
         ((тотожне? шаблон (як-є rel32))
          (за-умовою
            
            ((атом? форма)  (машина-допуск-відносний-зсув-32? форма))
            ((атом? ()) (атом? (як-є (000))))))
         
         ((атом? форма)  (тотожне? шаблон форма))
         ((атом? ()) (атом? (як-є (000))))))
      
      ((атом? форма)  (атом? (як-є (000))))
      ((машина-допуск-збіг-шаблону? (перше шаблон) (перше форма))
       (машина-допуск-збіг-шаблону? (решта шаблон) (решта форма)))
      ((атом? ()) (атом? (як-є (000)))))))

(визначити машина-команда-відповідає-допуску?
  (функція (шаблони форма)
    (за-умовою
      
      ((атом? шаблони)  (атом? (як-є (000))))
      ((машина-допуск-збіг-шаблону? (перше шаблони) форма) (атом? (як-є ())))
      ((атом? ()) (машина-команда-відповідає-допуску? (решта шаблони) форма)))))

(визначити машина-команда-допущена?
  (функція (форма)
    (машина-команда-відповідає-допуску? машина-допущені-шаблони-команд форма)))

(визначити машина-перша-недопущена-форма
  (функція (форми)
    (за-умовою
      
      ((атом? форми)  (за-умовою
         ((порожній? форми) (як-є ()))
         ((атом? ()) форми)))
      ((машина-команда-допущена? (перше форми))
       (машина-перша-недопущена-форма (решта форми)))
      ((атом? ()) (перше форми)))))

(визначити машина-програма-допущена?
