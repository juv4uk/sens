; Поле disp8 приймає лише точне D24+ ціле в межах [-128,127].
; Ратифікований D6:111110 INTEGERP повертає D1:1/D1:0 без
; застарілого текстового протоколу передавання машинних значень.
; Рядки, дроби та цитовані структури не є машинними цілими.
(визначити машина-допуск-точне-ціле?
  (функція (значення)
    (ціле? значення)))

(визначити машина-допуск-ціле-у-включних-межах?
  (функція (значення нижня-межа верхня-межа)
    ; Договір 11.8: строгі порівняння D5 поєднуємо з точним D4 NOT.
    ; GEQ/LEQ є резидентами D6 без загальної викличності, їх не викликаємо.
    ; Обидві умови приймають і повертають тільки точний біт D1.
    (за-умовою
      ((хибне? (менше? значення нижня-межа))
       (за-умовою
         ((хибне? (більше? значення верхня-межа))
          (атом? (як-є ())))
         ((атом? (як-є ()))
          (атом? (як-є (000))))))
      ((атом? (як-є ()))
       (атом? (як-є (000)))))))

; disp8 — скінченне поле x86. Допуск використовує повну таблицю
; кодувальника Lisp, а не порівняння числової величини.
; Після D8-текстової проєкції перевіряємо усі цифри без host-оракула.
; EQ відрізняє маркер відмови NIL від допустимого байта 0.
(визначити машина-допуск-зсув-8?
  (функція (значення)
    (за-умовою
      ((машина-допуск-точне-ціле? значення)
       (хибне? (тотожне? (машина-байт-восьмибітного-зсуву значення) (як-є ()))))
      ((атом? ()) (атом? (як-є (000)))))))

(визначити машина-допуск-число-32?
  (функція (значення)
    (за-умовою
      ((машина-допуск-точне-ціле? значення)
       (машина-допуск-ціле-у-включних-межах? значення -2147483648 2147483647))
      ((атом? ()) (атом? (як-є (000)))))))

(визначити машина-допуск-беззнакове-число-8?
  (функція (значення)
