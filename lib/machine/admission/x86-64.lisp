      ((x86-admission-pattern-match? (як-є (ret)) form)
       (x86-encode-ret))
      ((x86-admission-pattern-match? (як-є (mov-r64-imm64 register immediate)) form)
       (x86-encode-mov-r64-imm64 (1001 form) (10011 form)))
