      ((машина-допуск-збіг-шаблону? (як-є (sub-r64-r64 register register)) форма)
       (машина-кодувати-віднімання-регістрів-64 (друге форма) (третє форма)))
      ((машина-допуск-збіг-шаблону? (як-є (xor-r64-r64 register register)) форма)
       (машина-кодувати-виключне-або-регістрів-64 (друге форма) (третє форма)))
      ((машина-допуск-збіг-шаблону? (як-є (cmp-r64-r64 register register)) форма)
       (машина-кодувати-порівняння-регістрів-64 (друге форма) (третє форма)))
      ((машина-допуск-збіг-шаблону? (як-є (test-r64-r64 register register)) форма)
       (машина-кодувати-перевірку-регістрів-64 (друге форма) (третє форма)))
      ((машина-допуск-збіг-шаблону? (як-є (push-r64 register)) форма)
       (машина-кодувати-покладання-регістра-64-у-стек (друге форма)))
      ((машина-допуск-збіг-шаблону? (як-є (pop-r64 register)) форма)
       (машина-кодувати-зняття-регістра-64-зі-стека (друге форма)))
      ((машина-допуск-збіг-шаблону? (як-є (inc-r64 register)) форма)
       (машина-кодувати-збільшення-регістра-64 (друге форма)))
      ((машина-допуск-збіг-шаблону? (як-є (dec-r64 register)) форма)
       (машина-кодувати-зменшення-регістра-64 (друге форма)))
      ((машина-допуск-збіг-шаблону? (як-є (not-r64 register)) форма)
       (машина-кодувати-побітове-заперечення-регістра-64 (друге форма)))
      ((машина-допуск-збіг-шаблону? (як-є (neg-r64 register)) форма)
       (машина-кодувати-зміну-знака-регістра-64 (друге форма)))
      ((машина-допуск-збіг-шаблону? (як-є (mov-mem-disp8-r64 register disp8 register)) форма)
       (машина-кодувати-запис-у-память-зі-зсувом-8 (друге форма) (третє форма) (перше (решта (решта (решта форма))))))
      ((машина-допуск-збіг-шаблону? (як-є (mov-r64-mem-disp8 register register disp8)) форма)
       (машина-кодувати-зчитування-памяті-зі-зсувом-8 (друге форма) (третє форма) (перше (решта (решта (решта форма))))))
      ((машина-допуск-збіг-шаблону? (як-є (lea-r64-mem-disp8 register register disp8)) форма)
       (машина-кодувати-обчислення-адреси-зі-зсувом-8 (друге форма) (третє форма) (перше (решта (решта (решта форма))))))
      ((машина-допуск-збіг-шаблону? (як-є (jo-rel8 disp8)) форма)
       (машина-кодувати-перехід-за-переповнення-зі-зсувом-8 (друге форма)))
