; A disp8 slot only admits an exact integer in [-128,127].
; Number identity uses the exact D8 word 11110100 WRITE-TO-STRING (not an SID alias)
; producing canonical #q2:<num>/<den> wire; D9 NUMBER->STRING callability
; is not inferred from its ratified nine-bit coordinate.
; never from human decimal presentation.  A reduced exact number is an
; integer exactly when its canonical denominator is 1.  Non-number values
; have no #q2: prefix and therefore fail closed before numeric comparisons.
; Use ratified D9 string identities here. The old W8 compatibility
; string predicates produce pair-shaped (0)/(1) answers, which strict D3 COND
; must never consume as PredicateBit controls.
(визначити x86-admission-wire-denominator-one?
  (функція (text)
    ; The admitted W8 string predicates return the current scalar D1 answer
    ; on valid strings. Keep these calls within the machine-source compatibility
    ; boundary; do not lift them to D9 without expanding the reader's scope.
    (за-умовою
      ((110011100 text) (010 (001 (000))))
      ((101 (110101011 text) "/")
       ((функція (rest)
         (за-умовою
           ((110011100 rest) (010 (001 (000))))
           ((101 (110101011 rest) "1")
            (за-умовою
              ((110011100 (110011101 rest)) (010 (001 ())))
              ((101 0 0) (010 (001 (000))))))
           ((101 0 0) (010 (001 (000))))))
        (110011101 text)))
      ((тотожне? 0 0)
       (x86-admission-wire-denominator-one? (110011101 text))))))
(визначити x86-admission-exact-integer?
  (функція (value)
    ((функція (wire)
      (за-умовою
        ((110101010 "#q2:" wire)
         (x86-admission-wire-denominator-one? wire))
        ((101 0 0) (010 (001 (000))))))
      (11110100 value))))
(визначити x86-admission-within-inclusive-integer-range?
  (функція (value lower upper)
    ; Contract 11.8: compose admitted D5 strict comparisons with exact D4 NOT.
    ; GEQ/LEQ are D6 residents without generic callability; do not invoke them.
    ; Both guards consume/return exact D1 PredicateBit, never Number 1 or host truth.
    (за-умовою
      ((0100 (11010 value lower))
       (за-умовою
         ((0100 (11011 value upper))
          (атом? (як-є ())))
         ((атом? (як-є ()))
          (010 (001 (000))))))
      ((атом? (як-є ()))
       (010 (001 (000)))))))

; disp8 is a finite x86 machine field, so admission reuses the
; Lisp-owned exhaustive encoder table instead of treating this bound check
; as numeric magnitude arithmetic. Exact-integer admission remains separate:
; NUMBER->STRING supplies canonical #q2 wire and denominator must be 1.
; EQ distinguishes the table's fail-closed NIL sentinel from the valid byte 0.
(визначити x86-admission-disp8?
  (функція (value)
    (за-умовою
      ((x86-admission-exact-integer? value)
       (хибне? (тотожне? (x86-disp8-byte value) (як-є ()))))
      ((010 ()) (010 (001 (000)))))))

(визначити x86-admission-imm32?
  (функція (value)
    (за-умовою
      ((x86-admission-exact-integer? value)
       (x86-admission-within-inclusive-integer-range? value -2147483648 2147483647))
      ((010 ()) (010 (001 (000)))))))

(визначити x86-admission-uimm8?
  (функція (value)
    (за-умовою
      ((x86-admission-exact-integer? value)
       (x86-admission-within-inclusive-integer-range? value 0 255))
      ((010 ()) (010 (001 (000)))))))

(визначити x86-admission-rel32?
  (функція (value)
    (за-умовою
      ((x86-admission-exact-integer? value)
       (x86-admission-within-inclusive-integer-range? value -2147483648 2147483647))
      ((010 ()) (010 (001 (000)))))))

; `immediate`, `register`, and `disp8` are operand-slot wildcards, not
; opcode wildcards. `register` only admits the 16 GPR names x86-reg-code
; knows about -- any other atom (a number, a made-up symbol) fails the
; match, the same way an out-of-range immediate would fail the encoder
; later. The selected Lisp encoder still validates whether the operand can
; be represented before the raw host capability is reachable.
; Current D3 call heads: EQ=101, CAR=100, CDR=011. Do not reintroduce legacy head aliases.
(визначити x86-admission-pattern-match?
  (функція (pattern form)
    (за-умовою
      
      ((атом? pattern)  (за-умовою
         ((тотожне? pattern (як-є immediate)) (атом? (як-є ())))
         ((тотожне? pattern (як-є register))
          (за-умовою
            ((атом? form)
             (за-умовою
               ((0101 (x86-reg-code form)) (010 (001 (000))))
               ((атом? (x86-reg-code form))
                (атом? ()))
               ((010 ()) (010 (001 (000))))))
            ((010 ()) (010 (001 (000))))))
         ((тотожне? pattern (як-є xmm-register))
          (за-умовою
            ((атом? form)
             (за-умовою
               ((0101 (x86-xmm-reg-code form)) (010 (001 (000))))
               ((атом? (x86-xmm-reg-code form))
                (атом? ()))
               ((010 ()) (010 (001 (000))))))
            ((010 ()) (010 (001 (000))))))
         ((тотожне? pattern (як-є disp8))
          (за-умовою
            
            ((атом? form)  (x86-admission-disp8? form))
            ((010 ()) (010 (001 (000))))))
         ((тотожне? pattern (як-є imm32))
          (за-умовою
            
            ((атом? form)  (x86-admission-imm32? form))
            ((010 ()) (010 (001 (000))))))
         ((тотожне? pattern (як-є uimm8))
          (за-умовою
            
            ((атом? form)  (x86-admission-uimm8? form))
            ((010 ()) (010 (001 (000))))))
         ((тотожне? pattern (як-є rel32))
          (за-умовою
            
            ((атом? form)  (x86-admission-rel32? form))
            ((010 ()) (010 (001 (000))))))
         
         ((атом? form)  (тотожне? pattern form))
         ((010 ()) (010 (001 (000))))))
      
      ((010 form)  (010 (001 (000))))
      ((x86-admission-pattern-match? (перше pattern) (перше form))
       (x86-admission-pattern-match? (решта pattern) (решта form)))
      ((010 ()) (010 (001 (000)))))))

(визначити x86-admitted-instruction-against?
  (функція (patterns form)
    (за-умовою
      
      ((010 patterns)  (010 (001 (000))))
      ((x86-admission-pattern-match? (перше patterns) form) (атом? (як-є ())))
      ((атом? ()) (x86-admitted-instruction-against? (решта patterns) form)))))

(визначити x86-admitted-instruction?
  (функція (form)
    (x86-admitted-instruction-against? x86-admitted-instruction-patterns form)))

(визначити x86-first-unadmitted-form
  (функція (forms)
    (за-умовою
      
      ((атом? forms)  (за-умовою
         ((порожній? forms) (як-є ()))
         ((атом? ()) forms)))
      ((x86-admitted-instruction? (перше forms))
       (x86-first-unadmitted-form (решта forms)))
      ((атом? ()) (перше forms)))))

(визначити x86-admitted-program?
  (функція (forms)
    (за-умовою
      
      ((атом? forms)  (за-умовою
         ((порожній? forms) (атом? (як-є ())))
         ((010 ()) (010 (001 (000))))))
      ((x86-admitted-instruction? (перше forms))
       (x86-admitted-program? (решта forms)))
      ((010 ()) (010 (001 (000)))))))

