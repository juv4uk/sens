         (1001 form) (10011 form) (100 (011 (011 (011 form))))))
      ((x86-admission-pattern-match?
         (як-є
           (vaddpd-xmm-xmm-xmm xmm-register xmm-register xmm-register))
         form)
       (x86-encode-vaddpd-xmm-xmm-xmm
         (1001 form) (10011 form) (100 (011 (011 (011 form))))))
      ((x86-admission-pattern-match?
         (як-є
           (pclmulqdq-xmm-mem-disp8-imm8
             xmm-register register disp8 uimm8))
         form)
       (x86-encode-pclmulqdq-xmm-mem-disp8-imm8
         (1001 form) (10011 form) (100 (011 (011 (011 form)))) (110110101 form)))
      ; Unreachable after admission. Keep fail-closed data instead of inventing
      ; a fallback encoder.
      ((атом? ()) (як-є ())))))

; Keep instruction mapping inside the current D3 value algebra. The shared
; Core4 map-onto body still uses compatibility predicates as COND control.
(визначити x86-encode-instruction-list
  (функція (forms)
    (за-умовою
      ((атом? forms) (як-є ()))
      ((хибне? (атом? forms))
       (сполучити
         (x86-encode-admitted-instruction (перше forms))
         (x86-encode-instruction-list (решта forms)))))))

(визначити x86-encode-admitted-program
  (функція (forms)
    (x86-encode-program (x86-encode-instruction-list forms))))

; #177 safe composition seam. Unlike x86-encode-admitted-program, this entry
; point is safe for callers holding arbitrary structured machine data: it must
; prove admission before any byte materialization can happen.
(визначити x86-encode-admitted-program-or-reject
  (функція (forms)
    (за-умовою
      ((x86-admitted-program? forms)
       (x86-encode-admitted-program forms))
      ((атом? ())
       (список (як-є rejected)
             (як-є unadmitted-machine-form)
             (x86-first-unadmitted-form forms))))))

(визначити x86-call-admitted-u64
  (функція (forms arena-bytes)
    (за-умовою
      ((x86-admitted-program? forms)
       (за-умовою
         ((тотожне? arena-bytes 0)
          (native-call-u64-raw (x86-encode-admitted-program forms)))
         ((атом? ())
          (native-call-u64-raw (x86-encode-admitted-program forms) arena-bytes))))
      ((атом? ())
       (список (як-є rejected)
             (як-є unadmitted-machine-form)
             (x86-first-unadmitted-form forms))))))
