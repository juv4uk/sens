; Українська поверхня машинних ефектів для чинних D3/D5/D9.
; Цільово-незалежні механізми не створюють нових доменних законів.
; Точні обмеження числа і результати відхилення не змінено.
; Цитовані теги фізичних ефектів і текстовий протокол залишаються даними.
; Умови керуються обчисленими точними D1-предикатами самого SENS.
; Не використовуємо ATOM від констант чи випадкові числові порівняння
; як обхідний механізм отримання логічного біта.

(визначити машинний-ефект-число-нуль (довжина (як-є ())))
(визначити машинний-ефект-число-один (довжина (як-є (а))))
(визначити машинний-ефект-число-два (довжина (як-є (а б))))
(визначити машинний-ефект-число-три (довжина (як-є (а б в))))
(визначити машинний-ефект-число-чотири (довжина (як-є (а б в г))))
(визначити машинний-ефект-число-вісім (помножити машинний-ефект-число-чотири машинний-ефект-число-два))
(визначити машинний-ефект-число-шістнадцять (помножити машинний-ефект-число-вісім машинний-ефект-число-два))
(визначити машинний-ефект-число-двісті-п'ятдесят-шість (помножити машинний-ефект-число-шістнадцять машинний-ефект-число-шістнадцять))
(визначити машинний-ефект-число-шістдесят-п'ять-тисяч-п'ятсот-тридцять-шість (помножити машинний-ефект-число-двісті-п'ятдесят-шість машинний-ефект-число-двісті-п'ятдесят-шість))
(визначити машинний-ефект-межа-беззнакова-32 (помножити машинний-ефект-число-шістдесят-п'ять-тисяч-п'ятсот-тридцять-шість машинний-ефект-число-шістдесят-п'ять-тисяч-п'ятсот-тридцять-шість))
(визначити машинний-ефект-макс-беззнакова-32 (відняти машинний-ефект-межа-беззнакова-32 машинний-ефект-число-один))
(визначити машинний-ефект-макс-беззнакова-64 (відняти (помножити машинний-ефект-межа-беззнакова-32 машинний-ефект-межа-беззнакова-32) машинний-ефект-число-один))

(визначити машинний-ефект-знаменник-одиниця?
  (функція (текст)
    (за-умовою
      ((рядок-порожній? текст) (атом? (як-є (()))))
      ((рядок-префікс? "/" текст)
       (нехай ((решта-тексту (рядок-решта текст)))
         (за-умовою
           ((рядок-порожній? решта-тексту) (атом? (як-є (()))))
           ((рядок-префікс? "1" решта-тексту)
            (за-умовою
              ((рядок-порожній? (рядок-решта решта-тексту)) (атом? (як-є ())))
              ((атом? (як-є ())) (атом? (як-є (()))))))
           ((атом? (як-є ())) (атом? (як-є (())))))))
      ((атом? (як-є ()))
       (машинний-ефект-знаменник-одиниця? (рядок-решта текст))))))

(визначити машинний-ефект-точне-ціле?
  (функція (значення)
    (нехай ((текстове-подання (значення-у-текст значення)))
      (за-умовою
        ((рядок-префікс? "#q2:" текстове-подання)
         (машинний-ефект-знаменник-одиниця? текстове-подання))
        ((атом? (як-є ())) (атом? (як-є (()))))))))

(визначити машинний-ефект-ціле-в-межах?
  (функція (значення нижня-межа верхня-межа)
    (за-умовою
      ((менше? значення нижня-межа) (атом? (як-є (()))))
      ((менше? верхня-межа значення) (атом? (як-є (()))))
      ((атом? (як-є ())) (атом? (як-є ()))))))

(визначити машинний-ефект-носій-беззнаковий-32?
  (функція (значення)
    (за-умовою
      ((машинний-ефект-точне-ціле? значення)
       (машинний-ефект-ціле-в-межах?
         значення машинний-ефект-число-нуль машинний-ефект-макс-беззнакова-32))
      ((атом? (як-є ()))
       (атом? (як-є (())))))))

(визначити машинний-ефект-форма-додавання-64?
  (функція (ефект)
    (за-умовою
      ((атом? ефект) (атом? (як-є (()))))
      ((тотожне? (довжина ефект) машинний-ефект-число-три)
       (тотожне? (перше ефект) (як-є bounded-u64-add)))
      ((атом? (як-є ()))
       (атом? (як-є (())))))))

(визначити машинний-ефект-додавання-64
  (функція (ліве праве)
    (за-умовою
      ((машинний-ефект-носій-беззнаковий-32? ліве)
       (за-умовою
         ((машинний-ефект-носій-беззнаковий-32? праве)
          (список (як-є bounded-u64-add) ліве праве))
         ((атом? (як-є ())) (як-є machine-effect-rejected))))
      ((атом? (як-є ())) (як-є machine-effect-rejected)))))

; Відтворення #4358: цільово-незалежні обмежені механізми
; віднімання та множення.
;
; Конструктори зберігають уже доведені області допустимих операндів:
;   віднімання — точні невід'ємні 64-бітні числа, ліве не менше правого;
;   множення — точні невід'ємні 32-бітні числа, добуток у межах 64 біт.
;
; Цей модуль не визначає процесор, набір команд, регістри, прапорці,
; машинне кодування, людську назву чи координату домену.

(визначити машинний-ефект-носій-беззнаковий-64?
  (функція (значення)
    (за-умовою
      ((машинний-ефект-точне-ціле? значення)
       (машинний-ефект-ціле-в-межах?
         значення машинний-ефект-число-нуль машинний-ефект-макс-беззнакова-64))
      ((атом? (як-є ()))
       (атом? (як-є (())))))))

(визначити машинний-ефект-форма-віднімання-64?
  (функція (ефект)
    (за-умовою
      ((атом? ефект) (атом? (як-є (()))))
      ((тотожне? (довжина ефект) машинний-ефект-число-три)
       (тотожне? (перше ефект) (як-є bounded-u64-sub)))
      ((атом? (як-є ()))
       (атом? (як-є (())))))))

(визначити машинний-ефект-форма-множення-64?
  (функція (ефект)
    (за-умовою
      ((атом? ефект) (атом? (як-є (()))))
      ((тотожне? (довжина ефект) машинний-ефект-число-три)
       (тотожне? (перше ефект) (як-є bounded-u64-mul)))
      ((атом? (як-є ()))
       (атом? (як-є (())))))))

