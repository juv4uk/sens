; Українська поверхня машинних ефектів для чинних D3/D5/D9.
; Цільово-незалежні механізми не створюють нових доменних законів.
; Точні обмеження числа і результати відхилення не змінено.
; Цитовані теги фізичних ефектів і текстовий протокол залишаються даними.

(визначити машинний-ефект-знаменник-одиниця?
  (функція (текст)
    (за-умовою
      ((рядок-порожній? текст) (атом? (як-є (()))))
      ((тотожне? (рядок-перший текст) "/")
       (нехай ((решта-тексту (рядок-решта текст)))
         (за-умовою
           ((рядок-порожній? решта-тексту) (атом? (як-є (()))))
           ((тотожне? (рядок-перший решта-тексту) "1")
            (за-умовою
              ((рядок-порожній? (рядок-решта решта-тексту)) (атом? (як-є ())))
              ((атом? (як-є ())) (атом? (як-є (()))))))
           ((атом? (як-є ())) (атом? (як-є (())))))))
      ((атом? (як-є ()))
       (машинний-ефект-знаменник-одиниця? (рядок-решта текст))))))

(визначити машинний-ефект-точне-ціле?
  (функція (значення)
    (нехай ((текстове-подання (значення-у-текст значення)))
      (за-умовою
        ((рядок-префікс? "#q2:" текстове-подання)
         (машинний-ефект-знаменник-одиниця? текстове-подання))
        ((атом? (як-є ())) (атом? (як-є (()))))))))

(визначити машинний-ефект-ціле-в-межах?
  (функція (значення нижня-межа верхня-межа)
    (за-умовою
      ((менше? значення нижня-межа) (менше? 1 0))
      ((менше? верхня-межа значення) (менше? 1 0))
      ((атом? ()) (менше? 0 1)))))

(визначити машинний-ефект-носій-беззнаковий-32?
  (функція (значення)
    (за-умовою
      ((машинний-ефект-точне-ціле? значення)
       (машинний-ефект-ціле-в-межах?
         значення 0 4294967295))
      ((атом? (як-є ()))
       (атом? (як-є (())))))))

(визначити машинний-ефект-форма-додавання-64?
  (функція (ефект)
    (за-умовою
      ((атом? ефект) (атом? (як-є (()))))
      ((тотожне? (довжина ефект) 3)
       (тотожне? (перше ефект) (як-є bounded-u64-add)))
      ((атом? (як-є ()))
       (атом? (як-є (())))))))

(визначити машинний-ефект-додавання-64
  (функція (ліве праве)
    (за-умовою
      ((машинний-ефект-носій-беззнаковий-32? ліве)
       (за-умовою
         ((машинний-ефект-носій-беззнаковий-32? праве)
          (список (як-є bounded-u64-add) ліве праве))
         ((атом? (як-є ())) (як-є machine-effect-rejected))))
      ((атом? (як-є ())) (як-є machine-effect-rejected)))))

; Відтворення #4358: цільово-незалежні обмежені механізми
; віднімання та множення.
;
; Конструктори зберігають уже доведені області допустимих операндів:
;   віднімання — точні невід'ємні 64-бітні числа, ліве не менше правого;
;   множення — точні невід'ємні 32-бітні числа, добуток у межах 64 біт.
;
; Цей модуль не визначає процесор, набір команд, регістри, прапорці,
; машинне кодування, людську назву чи координату домену.

(визначити машинний-ефект-носій-беззнаковий-64?
  (функція (значення)
    (за-умовою
      ((машинний-ефект-точне-ціле? значення)
       (машинний-ефект-ціле-в-межах?
         значення 0 18446744073709551615))
      ((атом? (як-є ()))
       (атом? (як-є (())))))))

(визначити машинний-ефект-форма-віднімання-64?
  (функція (ефект)
    (за-умовою
      ((атом? ефект) (атом? (як-є (()))))
      ((тотожне? (довжина ефект) 3)
       (тотожне? (перше ефект) (як-є bounded-u64-sub)))
      ((атом? (як-є ()))
       (атом? (як-є (())))))))

(визначити машинний-ефект-форма-множення-64?
  (функція (ефект)
    (за-умовою
      ((атом? ефект) (атом? (як-є (()))))
      ((тотожне? (довжина ефект) 3)
       (тотожне? (перше ефект) (як-є bounded-u64-mul)))
      ((атом? (як-є ()))
       (атом? (як-є (())))))))

; Застосовувати лише точні предикати D5/D6 як тести D3 COND.
; Історичні W8 числові порівняння не є D1 PredicateBit.
(визначити машинний-ефект-віднімання-64
  (функція (ліве праве)
    (за-умовою
      ((машинний-ефект-носій-беззнаковий-64? ліве)
       (за-умовою
         ((машинний-ефект-носій-беззнаковий-64? праве)
          (за-умовою
            ((менше? ліве праве)
             (як-є machine-effect-rejected))
            ((атом? ())
             (список (як-є bounded-u64-sub) ліве праве))))
         ((атом? (як-є ())) (як-є machine-effect-rejected))))
      ((атом? (як-є ())) (як-є machine-effect-rejected)))))

(визначити машинний-ефект-множення-64
  (функція (ліве праве)
    (за-умовою
      ((машинний-ефект-носій-беззнаковий-32? ліве)
       (за-умовою
         ((машинний-ефект-носій-беззнаковий-32? праве)
          (список (як-є bounded-u64-mul) ліве праве))
         ((атом? (як-є ())) (як-є machine-effect-rejected))))
      ((атом? (як-є ())) (як-є machine-effect-rejected)))))


; Сумісність для чинних зовнішніх споживачів: решта назв
; посилаються на ті самі українські замикання.
(визначити machine-effect-exact-integer? машинний-ефект-точне-ціле?)
(визначити machine-effect-within-inclusive-integer-range? машинний-ефект-ціле-в-межах?)
(визначити machine-effect-u32-carrier? машинний-ефект-носій-беззнаковий-32?)
(визначити machine-effect-bounded-u64-add-form? машинний-ефект-форма-додавання-64?)
(визначити machine-effect-bounded-u64-add машинний-ефект-додавання-64)
(визначити machine-effect-u64-carrier? машинний-ефект-носій-беззнаковий-64?)
(визначити machine-effect-bounded-u64-sub-form? машинний-ефект-форма-віднімання-64?)
(визначити machine-effect-bounded-u64-mul-form? машинний-ефект-форма-множення-64?)
(визначити machine-effect-bounded-u64-sub машинний-ефект-віднімання-64)
(визначити machine-effect-bounded-u64-mul машинний-ефект-множення-64)
