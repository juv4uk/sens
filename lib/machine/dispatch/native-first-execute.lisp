; Виконання вже класифікованих планів мовою SENS.
;
; Цей модуль не обирає інструкцій, не кодує байтів і не обходить
; машинний допуск. Класифікацію виконує native-first.lisp,
; машинне виконання — admission/x86-64.lisp, семантику — SENS.
;
; Залежності завантажує викликач:
; lib/machine/encoding/x86-64.lisp
; lib/machine/operands/x86-64.lisp
; lib/machine/admission/x86-64.lisp
; lib/machine/dispatch/native-first.lisp
;
; Чинний протокол зовнішнього споживача:
; (execution-route МАРШРУТ (status completed) (value ЗНАЧЕННЯ))
; (execution-route МАРШРУТ (status rejected) (detail ПРИЧИНА))
;
; Англомовні мітки тут є тільки цитованими протокольними даними.
; Викличні слова ядра — точні ратифіковані проєкції D3/D4/D5/D9.
; Зовнішні назви вже наявних машинних функцій залишено незмінними,
; щоб не створювати другого шлюзу й не ламати наявного споживача.

; Побудова коротких списків без будь-якого текстового або бітового коду.
(визначити нативний-список-двох
  (функція (перший-елемент другий-елемент)
    (сполучити
      перший-елемент
      (сполучити другий-елемент (як-є ())))))

(визначити нативний-список-чотирьох
  (функція (перший-елемент другий-елемент третій-елемент четвертий-елемент)
    (сполучити
      перший-елемент
      (сполучити
        другий-елемент
        (сполучити
          третій-елемент
          (сполучити четвертий-елемент (як-є ())))))))

; Єдиний конструктор протоколу — однакова форма для всіх маршрутів.
(визначити нативний-скласти-результат
  (функція (маршрут стан поле значення)
    (нативний-список-чотирьох
      (як-є execution-route)
      маршрут
      (нативний-список-двох (як-є status) стан)
      (нативний-список-двох поле значення))))

(визначити нативне-виконання-завершено
  (функція (маршрут значення)
    (нативний-скласти-результат
      маршрут (як-є completed) (як-є value) значення)))

(визначити нативне-виконання-відхилено
  (функція (маршрут причина)
    (нативний-скласти-результат
      маршрут (як-є rejected) (як-є detail) причина)))

; Відмови із планом зберігають його первісну структуру в полі detail.
; Додаємо мітку помилки тільки як цитовані дані, не як виклик функції.
(визначити нативне-відхилити-план
  (функція (маршрут причина план)
    (нативне-виконання-відхилено
      маршрут
      (нативний-список-двох причина план))))

; Форму перевіряємо до доступу до другого або третього поля.
; Атом, крапковий хвіст та зайві комірки відхиляються.
; Жодної арифметики чи доменної ширини з тексту не виводимо.
(визначити нативний-список-двох-елементів?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((атом? (решта значення)) ні)
      ((порожній? (решта (решта значення))) так)
      (так ні))))

(визначити нативний-список-трьох-елементів?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((атом? (решта значення)) ні)
      ((атом? (решта (решта значення))) ні)
      ((порожній? (решта (решта (решта значення)))) так)
      (так ні))))

; Тег плану порівнюємо через D3 ТОТОЖНЕ? лише після перевірки,
; що план є парою, а його перша комірка містить атом.
; same та distinct — внутрішні мітки, не заміна D1.
(визначити нативний-стан-мітки-плану
  (функція (план мітка)
    (за-умовою
      ((атом? план) (як-є distinct))
      ((атом? (перше план))
       (за-умовою
         ((тотожне? (перше план) мітка) (як-є same))
         (так (як-є distinct))))
      (так (як-є distinct)))))

; Результат чинного допуску класифікуємо лише один раз.
; Атомарний результат є значенням; rejected у голові складеного
; результату означає відмову; неатомарна голова — пошкодження.
; На жодному з цих шляхів не запускається запасний evaluator.
(визначити нативне-виконання-результат-плану
  (функція (план результат)
    (за-умовою
      ((атом? результат)
       (нативне-виконання-завершено
         (як-є native) результат))
      ((атом? (перше результат))
       (за-умовою
         ((тотожне? (перше результат) (як-є rejected))
          (нативне-виконання-відхилено
            (як-є native) результат))
         (так
          (нативне-виконання-завершено
            (як-є native) результат))))
      (так
       (нативне-виконання-відхилено
         (як-є native)
         (нативний-список-двох
           (як-є malformed-native-result)
           результат))))))

; Розпаковуємо тільки перевірений native-plan:
; (native-plan ФОРМИ АРЕНА).
; Admission лишається єдиним механізмом виконання машинних форм.
(визначити нативне-виконання-плану
  (функція (план)
    (нативне-виконання-результат-плану
      план
      (x86-call-admitted-u64
        (друге план)
        (третє план)))))

; Маршрут native не переходить у evaluator навіть за помилки.
; Маршрут evaluator допустимий лише для рівно двох полів плану.
; Для невідомого тегу немає умовного виконання або прихованого шляху.
(визначити нативне-виконати-план
  (функція (план)
    (за-умовою
      ((тотожне?
         (нативний-стан-мітки-плану план (як-є native-plan))
         (як-є same))
       (за-умовою
         ((нативний-список-трьох-елементів? план)
          (нативне-виконання-плану план))
         (так
          (нативне-відхилити-план
            (як-є native)
            (як-є malformed-native-plan)
            план))))
      ((тотожне?
         (нативний-стан-мітки-плану план (як-є evaluator-fallback))
         (як-є same))
       (за-умовою
         ((нативний-список-двох-елементів? план)
          (нативне-виконання-завершено
            (як-є evaluator)
            (обчислити (друге план))))
         (так
          (нативне-відхилити-план
            (як-є invalid-plan)
            (як-є malformed-evaluator-fallback-plan)
            план))))
      (так
       (нативне-відхилити-план
         (як-є invalid-plan)
         (як-є unknown-native-first-plan)
         план)))))

; Планування залишається у наявному SENS-класифікаторі native-first.
(визначити нативне-виконати-вираз
  (функція (вираз)
    (нативне-виконати-план
      (native-first-plan вираз))))

; Список вихідних форм обходимо по порядку.
; Некоректний непорожній атом у хвості не перетворюємо на EOF.
(визначити нативне-виконати-форми-джерела
  (функція (форми)
    (за-умовою
      ((атом? форми)
       (за-умовою
         ((тотожне? форми (як-є ())) (як-є ()))
         (так
          (сполучити
            (нативне-виконання-відхилено
              (як-є evaluator)
              (нативний-список-двох
                (як-є malformed-source-form-tail)
                форми))
            (як-є ())))))
      (так
       (сполучити
         (нативне-виконати-вираз (перше форми))
         (нативне-виконати-форми-джерела (решта форми)))))))

; D9 ЧИТАТИ-ВСІ — ратифікована українська поверхня читача SENS.
; Жодного дубльованого парсера, транспортного адаптера або fallback.
(визначити нативне-виконати-джерело
  (функція (текст-джерела)
    (нативний-список-двох
      (як-є source-execution)
      (нативне-виконати-форми-джерела
        (читати-всі текст-джерела)))))
