; Виконання планів native-first належить семантиці SENS.
;
; Модуль приймає тільки результат чинного класифікатора:
; (native-plan ФОРМИ АРЕНА) або (evaluator-fallback ВИРАЗ).
; Невідомі й пошкоджені плани ніколи не передаються машині.
; Після вибору native повторний запуск через evaluator заборонений.
;
; Перед завантаженням викликач підключає:
; lib/machine/encoding/x86-64.lisp
; lib/machine/operands/x86-64.lisp
; lib/machine/admission/x86-64.lisp
; lib/machine/dispatch/native-first.lisp
;
; Зовнішній протокол залишається незмінним:
; (execution-route МАРШРУТ (status completed) (value ЗНАЧЕННЯ))
; (execution-route МАРШРУТ (status rejected) (detail ПРИЧИНА))
;
; Цитовані англомовні ідентифікатори — дані протоколу, а не
; імена доменних операцій. Виконавчі слова ядра взято з укр-проєкції.
; Виклики наявних машинних постачальників залишаються їхнім контрактом.
; Жодного історичного інтерпретатора, додаткового пакувальника
; або таблиці старих кодів тут немає.

; Структурні побудови — D3 СПОЛУЧИТИ та ЯК-Є.
(визначити нативний-список-двох
  (функція (перший-елемент другий-елемент)
    (сполучити
      перший-елемент
      (сполучити другий-елемент (як-є ())))))

(визначити нативний-список-чотирьох
  (функція (перший-елемент другий-елемент третій-елемент четвертий-елемент)
    (сполучити
      перший-елемент
      (сполучити
        другий-елемент
        (сполучити
          третій-елемент
          (сполучити четвертий-елемент (як-є ())))))))

; Єдине місце конструювання публічного запису.
(визначити нативний-скласти-результат
  (функція (маршрут стан поле значення)
    (нативний-список-чотирьох
      (як-є execution-route)
      маршрут
      (нативний-список-двох (як-є status) стан)
      (нативний-список-двох поле значення))))

(визначити нативне-виконання-завершено
  (функція (маршрут значення)
    (нативний-скласти-результат
      маршрут
      (як-є completed)
      (як-є value)
      значення)))

(визначити нативне-виконання-відхилено
  (функція (маршрут причина)
    (нативний-скласти-результат
      маршрут
      (як-є rejected)
      (як-є detail)
      причина)))

; Помилку форми завжди повертаємо разом із первинним планом.
(визначити нативне-відхилити-план
  (функція (маршрут причина план)
    (нативне-виконання-відхилено
      маршрут
      (нативний-список-двох причина план))))

; Структурні предикати не обчислюють машинні розміри.
; До кожного звернення до РЕШТА підтверджено непорожню пару.
(визначити нативний-список-двох-елементів?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((атом? (решта значення)) ні)
      ((порожній? (решта (решта значення))) так)
      (так ні))))

(визначити нативний-список-трьох-елементів?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((атом? (решта значення)) ні)
      ((атом? (решта (решта значення))) ні)
      ((порожній? (решта (решта (решта значення)))) так)
      (так ні))))

; Точне D3 ТОТОЖНЕ? має право порівнювати лише атоми.
; Тому атомарність першої комірки перевіряємо раніше.
; SAME/DISTINCT не слід плутати з D1 ІСТИНА/ХИБА.
(визначити нативний-стан-мітки-плану
  (функція (план мітка)
    (за-умовою
      ((атом? план) (як-є distinct))
      ((атом? (перше план))
       (за-умовою
         ((тотожне? (перше план) мітка) (як-є same))
         (так (як-є distinct))))
      (так (як-є distinct)))))

; Прийнятий машиною маршрут не змінюється, навіть якщо її
; admission-шар повернув відмову. Значення і діагностику
; не перетворюємо на нові виклики SENS.
(визначити нативне-виконання-результат-плану
  (функція (план результат)
    (за-умовою
      ((атом? результат)
       (нативне-виконання-завершено
         (як-є native) результат))
      ((атом? (перше результат))
       (за-умовою
         ((тотожне? (перше результат) (як-є rejected))
          (нативне-виконання-відхилено
            (як-є native) результат))
         (так
          (нативне-виконання-завершено
            (як-є native) результат))))
      (так
       (нативне-виконання-відхилено
         (як-є native)
         (нативний-список-двох
           (як-є malformed-native-result)
           результат))))))

; Сторонній машинний шлюз викликається тільки після перевірки
; точного тричленного native-plan у функції нижче.
(визначити нативне-виконання-плану
  (функція (план)
    (нативне-виконання-результат-плану
      план
      (викликати-допущену-машинну-програму
        (друге план)
        (третє план)))))

; Випадки плану не перетинаються:
; native: перевірка трьох полів -> єдиний машинний допуск;
; evaluator-fallback: перевірка двох полів -> D4 ОБЧИСЛИТИ;
; інше: виразна відмова, без виклику жодного виконавця.
(визначити нативне-виконати-план
  (функція (план)
    (за-умовою
      ((тотожне?
         (нативний-стан-мітки-плану план (як-є native-plan))
         (як-є same))
       (за-умовою
         ((нативний-список-трьох-елементів? план)
          (нативне-виконання-плану план))
         (так
          (нативне-відхилити-план
            (як-є native)
            (як-є malformed-native-plan)
            план))))
      ((тотожне?
         (нативний-стан-мітки-плану план (як-є evaluator-fallback))
         (як-є same))
       (за-умовою
         ((нативний-список-двох-елементів? план)
          (нативне-виконання-завершено
            (як-є evaluator)
            (обчислити (друге план))))
         (так
          (нативне-відхилити-план
            (як-є invalid-plan)
            (як-є malformed-evaluator-fallback-plan)
            план))))
      (так
       (нативне-відхилити-план
         (як-є invalid-plan)
         (як-є unknown-класифікувати-нативний-вираз)
         план)))))

; Рішення про маршрут приймає існуючий класифікатор SENS.
(визначити нативне-виконати-вираз
  (функція (вираз)
    (нативне-виконати-план
      (класифікувати-нативний-вираз вираз))))

; Порядок виконання джерельних форм зберігаємо.
; Тільки порожній список є кінцем; неправильний атомарний хвіст
; дістає окрему помилку, а не зникає мовчки.
(визначити нативне-виконати-форми-джерела
  (функція (форми)
    (за-умовою
      ((атом? форми)
       (за-умовою
         ((порожній? форми) (як-є ()))
         (так
          (сполучити
            (нативне-виконання-відхилено
              (як-є evaluator)
              (нативний-список-двох
                (як-є malformed-source-form-tail)
                форми))
            (як-є ())))))
      (так
       (сполучити
         (нативне-виконати-вираз (перше форми))
         (нативне-виконати-форми-джерела (решта форми)))))))

; Чинний D9 ЧИТАТИ-ВСІ є єдиним читачем цього маршруту.
; Транспортування й фізичне пакування належать іншому шару.
(визначити нативне-виконати-джерело
  (функція (текст-джерела)
    (нативний-список-двох
      (як-є source-execution)
      (нативне-виконати-форми-джерела
        (читати-всі текст-джерела)))))
