; Виконання планів SENS: вибір маршруту належить мові,
; допуск машинної програми — тільки чинному admission-шару.
;
; Контракт результату:
; (execution-route МАРШРУТ (status completed) (value ЗНАЧЕННЯ))
; (execution-route МАРШРУТ (status rejected)  (detail ПРИЧИНА))
;
; Назви execution-route, status, value, detail, native, evaluator та інші
; мітки протоколу є цитованими даними, а не викличними головами.
; Імена наявних зовнішніх функцій збережено для справжніх споживачів.
; Виконавчі голови мови — ратифіковані українські D3/D4.
;
; Завантажити раніше:
; lib/machine/encoding/x86-64.lisp
; lib/machine/operands/x86-64.lisp
; lib/machine/admission/x86-64.lisp
; lib/machine/dispatch/native-first.lisp

; Побудова протокольних списків — точне D3 СПОЛУЧИТИ.
; Порожній хвіст цитуємо; жодного домисленого коду LIST.
(визначити нативний-список-двох
  (функція (ліве праве)
    (сполучити ліве
      (сполучити праве (як-є ())))))

(визначити нативний-список-чотирьох
  (функція (перше-поле друге-поле третє-поле четверте-поле)
    (сполучити перше-поле
      (сполучити друге-поле
        (сполучити третє-поле
          (сполучити четверте-поле (як-є ())))))))

; Єдина форма публічного результату: різняться тільки статус і поле.
(визначити нативний-результат
  (функція (маршрут стан назва-поля значення-поля)
    (нативний-список-чотирьох
      (як-є execution-route)
      маршрут
      (нативний-список-двох (як-є status) стан)
      (нативний-список-двох назва-поля значення-поля))))

(визначити native-first-execution-completed
  (функція (маршрут-виконання значення-відповіді)
    (нативний-результат
      маршрут-виконання
      (як-є completed)
      (як-є value)
      значення-відповіді)))

(визначити native-first-execution-rejected
  (функція (маршрут-виконання подробиці-відмови)
    (нативний-результат
      маршрут-виконання
      (як-є rejected)
      (як-є detail)
      подробиці-відмови)))

; Перевірки довжини — структурні, без арифметичних літералів.
; Крапковий хвіст або зайве поле не є правильним списком.
(визначити native-first-proper-list-length-2?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((атом? (решта значення)) ні)
      ((порожній? (решта (решта значення))) так)
      (так ні))))

(визначити нативний-список-трьох-елементів?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((атом? (решта значення)) ні)
      ((атом? (решта (решта значення))) ні)
      ((порожній? (решта (решта (решта значення)))) так)
      (так ні))))

; D3 ТОТОЖНЕ? застосовуємо тільки до атомарного тегу.
; distinct/same — звичайні значення історично видимого контракту.
(визначити native-first-plan-tag-state
  (функція (план-виконання мітка-плану)
    (за-умовою
      ((атом? план-виконання) (як-є distinct))
      ((атом? (перше план-виконання))
       (за-умовою
         ((тотожне? (перше план-виконання) мітка-плану)
          (як-є same))
         (так (як-є distinct))))
      (так (як-є distinct)))))

; Відхилення машинного шлюзу не можна виконувати другим шляхом.
; Атомарний результат — успішне значення (включно з порожнім).
; Для складеного результату перевіряємо атомарність його тегу
; до виклику ТОТОЖНЕ?. Некоректну мітку пари відхиляємо.
(визначити нативне-виконання-результат-плану
  (функція (план-виконання результат-виконання)
    (за-умовою
      ((атом? результат-виконання)
       (native-first-execution-completed
         (як-є native) результат-виконання))
      ((атом? (перше результат-виконання))
       (за-умовою
         ((тотожне? (перше результат-виконання) (як-є rejected))
          (native-first-execution-rejected
            (як-є native) результат-виконання))
         (так
          (native-first-execution-completed
            (як-є native) результат-виконання))))
      (так
       (native-first-execution-rejected
         (як-є native)
         (нативний-список-двох
           (як-є malformed-native-result)
           результат-виконання))))))

; Машинні форми й арена надходять тільки з перевіреного native-plan.
; Формування байтів не дублюємо, хост із цього файла не викликаємо.
(визначити нативне-виконання-плану
  (функція (план-виконання)
    (нативне-виконання-результат-плану
      план-виконання
      (x86-call-admitted-u64
        (друге план-виконання)
        (третє план-виконання)))))

; Окремо оформлюємо структурні відмови, не викликаючи обчислювача.
(визначити нативна-відмова-від-плану
  (функція (маршрут мітка-помилки план-виконання)
    (native-first-execution-rejected
      маршрут
      (нативний-список-двох мітка-помилки план-виконання))))

; Маршрут обираємо за тегом, а арність перевіряємо до взяття полів.
; native-plan: точно (native-plan ФОРМИ АРЕНА).
; evaluator-fallback: точно (evaluator-fallback ВИРАЗ).
; Невідомий тег і некоректна структура не стають виконуваною формою.
(визначити native-first-execute-plan
  (функція (план-виконання)
    (за-умовою
      ((тотожне?
         (native-first-plan-tag-state
           план-виконання (як-є native-plan))
         (як-є same))
       (за-умовою
         ((нативний-список-трьох-елементів? план-виконання)
          (нативне-виконання-плану план-виконання))
         (так
          (нативна-відмова-від-плану
            (як-є native)
            (як-є malformed-native-plan)
            план-виконання))))
      ((тотожне?
         (native-first-plan-tag-state
           план-виконання (як-є evaluator-fallback))
         (як-є same))
       (за-умовою
         ((native-first-proper-list-length-2? план-виконання)
          (native-first-execution-completed
            (як-є evaluator)
            (обчислити (друге план-виконання))))
         (так
          (нативна-відмова-від-плану
            (як-є invalid-plan)
            (як-є malformed-evaluator-fallback-plan)
            план-виконання))))
      (так
       (нативна-відмова-від-плану
         (як-є invalid-plan)
         (як-є unknown-native-first-plan)
         план-виконання)))))

; Для одиничного виразу план складає наявний мовний класифікатор.
(визначити native-first-execute-expression
  (функція (вираз-джерела)
    (native-first-execute-plan
      (native-first-plan вираз-джерела))))

; Читач повертає список форм; його неправильний непорожній хвіст
; не можна тихо прирівнювати до завершення вводу.
(визначити native-first-execute-source-forms
  (функція (форми-джерела)
    (за-умовою
      ((атом? форми-джерела)
       (за-умовою
         ((порожній? форми-джерела) (як-є ()))
         (так
          (сполучити
            (native-first-execution-rejected
              (як-є evaluator)
              (нативний-список-двох
                (як-є malformed-source-form-tail)
                форми-джерела))
            (як-є ())))))
      (так
       (сполучити
         (native-first-execute-expression (перше форми-джерела))
         (native-first-execute-source-forms (решта форми-джерела)))))))

; Джерельний текст читає чинний SENS reader, не локальний парсер.
(визначити native-first-execute-source
  (функція (текст-джерела)
    (нативний-список-двох
      (як-є source-execution)
      (native-first-execute-source-forms
        (читати-всі текст-джерела)))))
