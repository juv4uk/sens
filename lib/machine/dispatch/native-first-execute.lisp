; Виконавець із перевагою машинного шляху. Лише СЕНС визначає значення виразів і маршрути.
;
; Контракт плану:
;   (native-plan МАШИННІ-ФОРМИ АРЕНА)
;   (evaluator-fallback ВИРАЗ)
; Контракт відповіді:
;   (execution-route МАРШРУТ (status completed) (value ЗНАЧЕННЯ))
;   (execution-route МАРШРУТ (status rejected) (detail ПРИЧИНА))
;
; Цитовані назви маршрутів і полів — дані протоколу. Викличні голови
; належать чинній українській проєкції СЕНС. Машинний допуск виконує
; окремий постачальник, а не цей модуль. Відхилений машинний план ніколи
; не надходить до обчислювача; невідома форма не запускає жодного маршруту.
;
; Перед завантаженням під'єднуються чинні постачальники:
; lib/machine/encoding/x86-64.lisp
; lib/machine/operands/x86-64.lisp
; lib/machine/admission/x86-64.lisp
; lib/machine/dispatch/native-first.lisp
;
; Побудова списків не залежить від побічного подання NIL у мові виконавця.
(визначити нативний-список-двох
  (функція (перший-елемент другий-елемент)
    (сполучити перший-елемент
      (сполучити другий-елемент (як-є ())))))
(визначити нативний-список-чотирьох
  (функція (перший-елемент другий-елемент третій-елемент четвертий-елемент)
    (сполучити перший-елемент
      (сполучити другий-елемент
        (сполучити третій-елемент
          (сполучити четвертий-елемент (як-є ())))))))

; Одна форма складання зовнішньої відповіді для обох маршрутів.
(визначити нативний-скласти-результат
  (функція (маршрут стан поле значення)
    (нативний-список-чотирьох
      (як-є execution-route)
      маршрут
      (нативний-список-двох (як-є status) стан)
      (нативний-список-двох поле значення))))
(визначити нативне-виконання-завершено
  (функція (маршрут значення)
    (нативний-скласти-результат
      маршрут (як-є completed) (як-є value) значення)))
(визначити нативне-виконання-відхилено
  (функція (маршрут причина)
    (нативний-скласти-результат
      маршрут (як-є rejected) (як-є detail) причина)))
(визначити нативне-відхилити-план
  (функція (маршрут причина план)
    (нативне-виконання-відхилено
      маршрут (нативний-список-двох причина план))))

; Спершу перевіряється структура пари, а лише потім — її хвіст.
; Некоректна крапкова пара не може бути помилково прийнята за список.
(визначити нативний-список-двох-елементів?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((атом? (решта значення)) ні)
      ((порожній? (решта (решта значення))) так)
      (так ні))))
(визначити нативний-список-трьох-елементів?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((атом? (решта значення)) ні)
      ((атом? (решта (решта значення))) ні)
      ((порожній? (решта (решта (решта значення)))) так)
      (так ні))))

; Д3 «тотожне?» — закон атомів. Складена мітка є невідомою, а не
; приводом виконувати порівняння структур через атомарний оператор.
(визначити нативний-стан-мітки-плану
  (функція (план мітка)
    (за-умовою
      ((атом? план) (як-є distinct))
      ((атом? (перше план))
       (за-умовою
         ((тотожне? (перше план) мітка) (як-є same))
         (так (як-є distinct))))
      (так (як-є distinct)))))

; Результат шлюзу не запускається повторно через інший маршрут.
; Атомарний результат є значенням; явно відхилений результат зберігає
; оригінальну причину. Некоректна складена мітка відхиляється.
(визначити нативне-виконання-результат-плану
  (функція (план результат)
    (за-умовою
      ((атом? результат)
       (нативне-виконання-завершено (як-є native) результат))
      ((атом? (перше результат))
       (за-умовою
         ((тотожне? (перше результат) (як-є rejected))
          (нативне-виконання-відхилено (як-є native) результат))
         (так
          (нативне-виконання-завершено (як-є native) результат))))
      (так
       (нативне-виконання-відхилено
         (як-є native)
         (нативний-список-двох
           (як-є malformed-native-result) результат))))))

; Виклик машинного постачальника здійснюється винятково після
; перевірки трьохелементного машинного плану в маршрутизаторі нижче.
(визначити нативне-виконання-плану
  (функція (план)
    (нативне-виконання-результат-плану
      план
      (викликати-допущену-машинну-програму
        (друге план) (третє план)))))

; Рівно два дозволені маршрути. Не створюємо запасного маршруту після
; невдалого машинного виконання: відхилення зберігає початковий маршрут.
(визначити нативне-виконати-план
  (функція (план)
    (за-умовою
      ((тотожне?
         (нативний-стан-мітки-плану план (як-є native-plan))
         (як-є same))
       (за-умовою
         ((нативний-список-трьох-елементів? план)
          (нативне-виконання-плану план))
         (так
          (нативне-відхилити-план
            (як-є native) (як-є malformed-native-plan) план))))
      ((тотожне?
         (нативний-стан-мітки-плану план (як-є evaluator-fallback))
         (як-є same))
       (за-умовою
         ((нативний-список-двох-елементів? план)
          (нативне-виконання-завершено
            (як-є evaluator) (обчислити (друге план))))
         (так
          (нативне-відхилити-план
            (як-є invalid-plan)
            (як-є malformed-evaluator-fallback-plan)
            план))))
      (так
       (нативне-відхилити-план
         (як-є invalid-plan) (як-є unknown-native-plan) план)))))

; Класифікацію виконує чинний модуль СЕНС, а не зовнішній виконавець чи кодек.
(визначити нативне-виконати-вираз
  (функція (вираз)
    (нативне-виконати-план
      (класифікувати-нативний-вираз вираз))))

; Зберігаємо послідовність усіх форм і не губимо некоректного хвоста.
(визначити нативне-виконати-форми-джерела
  (функція (форми)
    (за-умовою
      ((атом? форми)
       (за-умовою
         ((порожній? форми) (як-є ()))
         (так
          (сполучити
            (нативне-виконання-відхилено
              (як-є evaluator)
              (нативний-список-двох
                (як-є malformed-source-form-tail) форми))
            (як-є ())))))
      (так
       (сполучити
         (нативне-виконати-вираз (перше форми))
         (нативне-виконати-форми-джерела (решта форми)))))))

; Читання — чинна операція СЕНС. Zig/T5M фізично пакує, але не
; визначає поведінку читача, обчислювача чи машинного маршруту.
(визначити нативне-виконати-джерело
  (функція (текст-джерела)
    (нативний-список-двох
      (як-є source-execution)
      (нативне-виконати-форми-джерела
        (читати-всі текст-джерела)))))
