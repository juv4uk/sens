; Виконання вже класифікованих машинних планів у SENS.
; Семантика належить SENS, вибір маршруту — native-first,
; допуск машинного коду — зовнішньому модулю приймання.
; Відхилений машинний маршрут не запускає обчислювач вдруге.
; Збережено зовнішню структуру спостереження для чинних споживачів.
;
; Залежності завантажуються викликачем:
; lib/machine/encoding/x86-64.lisp
; lib/machine/operands/x86-64.lisp
; lib/machine/admission/x86-64.lisp
; lib/machine/dispatch/native-first.lisp

; Конструктори списків використовують лише точні D3:111 і D3:001.
(визначити нативний-список-двох
  (функція (перший-елемент другий-елемент)
    (сполучити перший-елемент
      (сполучити другий-елемент (як-є ())))))

(визначити нативний-список-чотирьох
  (функція (перший-елемент другий-елемент третій-елемент четвертий-елемент)
    (сполучити перший-елемент
      (сполучити другий-елемент
        (сполучити третій-елемент
          (сполучити четвертий-елемент (як-є ())))))))

; Єдина оболонка успішного результату: (execution-route маршрут ...).
(визначити нативне-виконання-завершено
  (функція (маршрут значення)
    (нативний-список-чотирьох
      (як-є execution-route)
      маршрут
      (як-є (status completed))
      (нативний-список-двох (як-є value) значення))))

; Відмова не приховує ні маршрут, ні причину.
(визначити нативне-виконання-відхилено
  (функція (маршрут причина)
    (нативний-список-чотирьох
      (як-є execution-route)
      маршрут
      (як-є (status rejected))
      (нативний-список-двох (як-є detail) причина))))

; Предикати повертають виключно точний D1: так або ні.
; Крапковий хвіст або надлишкова комірка не проходять перевірку.
(визначити нативний-список-двох-елементів?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((атом? (решта значення)) ні)
      ((порожній? (решта (решта значення))) так)
      (так ні))))

(визначити нативний-список-трьох-елементів?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((атом? (решта значення)) ні)
      ((атом? (решта (решта значення))) ні)
      ((порожній? (решта (решта (решта значення)))) так)
      (так ні))))

; D3 EQ застосовуємо тільки до атомарного тега.
; Позначки same і distinct є протокольними даними, не D1.
(визначити нативний-стан-мітки-плану
  (функція (план мітка)
    (за-умовою
      ((атом? план) (як-є distinct))
      ((атом? (перше план))
       (за-умовою
         ((тотожне? (перше план) мітка) (як-є same))
         (так (як-є distinct))))
      (так (як-є distinct)))))

; Прийнятий native-маршрут уже незворотний: ніякого evaluator-fallback.
; Складена голова від машини є пошкодженим результатом.
(визначити нативне-виконання-результат-плану
  (функція (план результат)
    (за-умовою
      ((атом? результат)
       (нативне-виконання-завершено (як-є native) результат))
      ((атом? (перше результат))
       (за-умовою
         ((тотожне? (перше результат) (як-є rejected))
          (нативне-виконання-відхилено (як-є native) результат))
         (так
          (нативне-виконання-завершено (як-є native) результат))))
      (так
       (нативне-виконання-відхилено
         (як-є native)
         (нативний-список-двох
           (як-є malformed-native-result)
           результат))))))

; Тільки існуючий допуск виконує машинні форми й виділяє арену.
; Тут немає другого кодера або нативної семантики SENS.
(визначити нативне-виконання-плану
  (функція (план)
    (нативне-виконання-результат-плану
      план
      (x86-call-admitted-u64
        (друге план)
        (третє план)))))

; Перевірка маршруту перед розпакуванням плану.
; Неправильний native-plan відхиляється як native;
; неправильний evaluator-fallback відхиляється як invalid-plan.
(визначити нативне-виконати-план
  (функція (план)
    (за-умовою
      ((тотожне?
         (нативний-стан-мітки-плану план (як-є native-plan))
         (як-є same))
       (за-умовою
         ((нативний-список-трьох-елементів? план)
          (нативне-виконання-плану план))
         (так
          (нативне-виконання-відхилено
            (як-є native)
            (нативний-список-двох
              (як-є malformed-native-plan) план)))))
      ((тотожне?
         (нативний-стан-мітки-плану план (як-є evaluator-fallback))
         (як-є same))
       (за-умовою
         ((нативний-список-двох-елементів? план)
          (нативне-виконання-завершено
            (як-є evaluator)
            (обчислити (друге план))))
         (так
          (нативне-виконання-відхилено
            (як-є invalid-plan)
            (нативний-список-двох
              (як-є malformed-evaluator-fallback-plan) план)))))
      (так
       (нативне-виконання-відхилено
         (як-є invalid-plan)
         (нативний-список-двох
           (як-є unknown-native-first-plan) план))))))

; Обчислюємо лише план, який надав наявний класифікатор.
(визначити нативне-виконати-вираз
  (функція (вираз)
    (нативне-виконати-план (native-first-plan вираз))))

; Списки вихідних форм обходимо у порядку читання.
; Неправильний непорожній атом у хвості отримує явну відмову.
(визначити нативне-виконати-форми-джерела
  (функція (форми)
    (за-умовою
      ((атом? форми)
       (за-умовою
         ((тотожне? форми (як-є ())) (як-є ()))
         (так
          (сполучити
            (нативне-виконання-відхилено
              (як-є evaluator)
              (нативний-список-двох
                (як-є malformed-source-form-tail) форми))
            (як-є ())))))
      (так
       (сполучити
         (нативне-виконати-вираз (перше форми))
         (нативне-виконати-форми-джерела (решта форми)))))))

; Читання є наявним SENS-механізмом; цей модуль не парсить текст сам.
(визначити нативне-виконати-джерело
  (функція (текст-джерела)
    (нативний-список-двох
      (як-є source-execution)
      (нативне-виконати-форми-джерела
        (читати-всі текст-джерела)))))
