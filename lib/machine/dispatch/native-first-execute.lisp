; Виконання native-first-плану мовою SENS.
; Мова класифікує план, а механізм приймання вирішує, чи може машина його виконати.
; Native-відмова ніколи не перетворюється на повторне обчислення через evaluator.
; Доменні викличні голови: точні українські проєкції D3/D4.
; Структура результату залишається даними:
; (execution-route МАРШРУТ (status completed|rejected) (value|detail ЗНАЧЕННЯ)).
; Зовнішні імена маршрутів і полів є протоколом наявних споживачів,
; а не SID8/Sens8-кодами або новими доменними тотожностями.
;
; Перед завантаженням потрібні:
; lib/machine/encoding/x86-64.lisp
; lib/machine/operands/x86-64.lisp
; lib/machine/admission/x86-64.lisp
; lib/machine/dispatch/native-first.lisp

; Будуємо записи з точного D3 CONS, а не з несанкціонованого виклику LIST.
(визначити нативний-список-двох
  (функція (перший-елемент другий-елемент)
    (сполучити
      перший-елемент
      (сполучити другий-елемент (як-є ())))))

(визначити нативний-список-чотирьох
  (функція (перший-елемент другий-елемент третій-елемент четвертий-елемент)
    (сполучити
      перший-елемент
      (сполучити
        другий-елемент
        (сполучити
          третій-елемент
          (сполучити четвертий-елемент (як-є ())))))))

; Публічна структура успіху однакова для native та evaluator.
(визначити native-first-execution-completed
  (функція (маршрут-виконання значення-відповіді)
    (нативний-список-чотирьох
      (як-є execution-route)
      маршрут-виконання
      (як-є (status completed))
      (нативний-список-двох (як-є value) значення-відповіді))))

; Відмова зберігає маршрут виникнення, не запускаючи обхідний механізм.
(визначити native-first-execution-rejected
  (функція (маршрут-виконання подробиці-відмови)
    (нативний-список-чотирьох
      (як-є execution-route)
      маршрут-виконання
      (як-є (status rejected))
      (нативний-список-двох (як-є detail) подробиці-відмови))))

; Саме два елементи, без приймання довшого чи крапкового хвоста.
(визначити native-first-proper-list-length-2?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((атом? (решта значення)) ні)
      ((порожній? (решта (решта значення))) так)
      (так ні))))

; Для native-plan потрібні тег, список машинних форм і арена.
(визначити нативний-список-трьох-елементів?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      ((атом? (решта значення)) ні)
      ((атом? (решта (решта значення))) ні)
      ((порожній? (решта (решта (решта значення)))) так)
      (так ні))))

; Перед D3 EQ перевіряємо, що тег справді атом.
; Відповідь є позначкою стану даних, не машинним PredicateBit.
(визначити native-first-plan-tag-state
  (функція (план-виконання мітка-плану)
    (за-умовою
      ((атом? план-виконання) (як-є distinct))
      ((атом? (перше план-виконання))
       (за-умовою
         ((тотожне? (перше план-виконання) мітка-плану) (як-є same))
         (так (як-є distinct))))
      (так (як-є distinct)))))

; Уже обраний native-маршрут залишається native навіть за помилки.
; Складений тег native-результату — відмова, а не EQ над парою.
(визначити нативне-виконання-результат-плану
  (функція (план-виконання результат-виконання)
    (за-умовою
      ((атом? результат-виконання)
       (native-first-execution-completed (як-є native) результат-виконання))
      ((атом? (перше результат-виконання))
       (за-умовою
         ((тотожне? (перше результат-виконання) (як-є rejected))
          (native-first-execution-rejected (як-є native) результат-виконання))
         (так
          (native-first-execution-completed (як-є native) результат-виконання))))
      (так
       (native-first-execution-rejected
         (як-є native)
         (нативний-список-двох
           (як-є malformed-native-result)
           результат-виконання))))))

; Реальний механізм запуску належить admission; тут жодного другого encoder.
(визначити нативне-виконання-плану
  (функція (план-виконання)
    (нативне-виконання-результат-плану
      план-виконання
      (x86-call-admitted-u64
        (перше (решта план-виконання))
        (перше (решта (решта план-виконання)))))))

; Три неперетинні випадки: native, evaluator, невідомий план.
; native-план неправильної форми відхиляємо лише у native-маршруті.
; evaluator застосовує D4 EVAL лише до правильної двокоміркової форми.
(визначити native-first-execute-plan
  (функція (план-виконання)
    (за-умовою
      ((тотожне?
         (native-first-plan-tag-state план-виконання (як-є native-plan))
         (як-є same))
       (за-умовою
         ((нативний-список-трьох-елементів? план-виконання)
          (нативне-виконання-плану план-виконання))
         (так
          (native-first-execution-rejected
            (як-є native)
            (нативний-список-двох (як-є malformed-native-plan) план-виконання)))))
      ((тотожне?
         (native-first-plan-tag-state план-виконання (як-є evaluator-fallback))
         (як-є same))
       (за-умовою
         ((native-first-proper-list-length-2? план-виконання)
          (native-first-execution-completed
            (як-є evaluator)
            (обчислити (перше (решта план-виконання)))))
         (так
          (native-first-execution-rejected
            (як-є invalid-plan)
            (нативний-список-двох
              (як-є malformed-evaluator-fallback-plan)
              план-виконання)))))
      (так
       (native-first-execution-rejected
         (як-є invalid-plan)
         (нативний-список-двох
           (як-є unknown-native-first-plan)
           план-виконання))))))

(визначити native-first-execute-expression
  (функція (вираз-джерела)
    (native-first-execute-plan (native-first-plan вираз-джерела))))

; Відхилення некоректного хвоста є явним результатом, не хибним EOF.
(визначити native-first-execute-source-forms
  (функція (форми-джерела)
    (за-умовою
      ((атом? форми-джерела)
       (за-умовою
         ((тотожне? форми-джерела (як-є ())) (як-є ()))
         (так
          (сполучити
            (native-first-execution-rejected
              (як-є evaluator)
              (нативний-список-двох
                (як-є malformed-source-form-tail)
                форми-джерела))
            (як-є ())))))
      (так
       (сполучити
         (native-first-execute-expression (перше форми-джерела))
         (native-first-execute-source-forms (решта форми-джерела)))))))

(визначити native-first-execute-source
  (функція (текст-джерела)
    (нативний-список-двох
      (як-є source-execution)
      (native-first-execute-source-forms
        (читати-всі текст-джерела)))))
