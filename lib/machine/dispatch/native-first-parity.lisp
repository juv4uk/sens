; Диференційна перевірка native/evaluator належить SENS, а не host.
; Еталонне очікуване значення задає незалежний рядок корпусу.
; Для успіху потрібні обидва докази: значення обчислювача та точний
; маршрут native з завершеним результатом. Виконання evaluator не може
; удавати успішне native-виконання.
;
; Зовнішні назви функцій лишаються ідентифікаторами чинних споживачів.
; Викличні операції ядра — повні українські поверхні ратифікованих
; доменів. Результат логічних предикатів — точні так/ні домену D1.
; Порожня структура () не є ані так, ані ні.
;
; Формат корпусу: (назва вираз очікуване клас-ефекту клас-помилки).
; Формат вердикту: (native-parity-case назва pass ...), або fail з
; конкретним очікуваним і фактичним значенням.

(визначити native-first-parity-pass
  (функція (назва клас-ефекту клас-помилки)
    (список
      (як-є native-parity-case)
      назва
      (як-є pass)
      (список (як-є effect) клас-ефекту)
      (список (як-є error) клас-помилки))))

(визначити native-first-parity-fail
  (функція (назва різновид очікуване фактичне)
    (список
      (як-є native-parity-case)
      назва
      (як-є fail)
      (список (як-є kind) різновид)
      (список (як-є expected) очікуване)
      (список (як-є actual) фактичне))))

; Доступ до п'ятого поля дозволений лише для правильного списку
; рівно з п'яти елементів. Некоректний рядок поверне діагностику,
; а не дійде до evaluator або машинного шлюзу.
(визначити нативний-паритет-пятичленний?
  (функція (рядок)
    (за-умовою
      ((атом? рядок) ні)
      ((атом? (решта рядок)) ні)
      ((атом? (решта (решта рядок))) ні)
      ((атом? (решта (решта (решта рядок)))) ні)
      ((атом? (решта (решта (решта (решта рядок))))) ні)
      ((порожній?
         (решта (решта (решта (решта (решта рядок)))))) так)
      (так ні))))

; Справжнє порівняння структур виконує D8 однакові?, а не D3
; тотожне? для атомів. Порівнюємо з окремим зовнішнім очікуванням.
(визначити native-first-parity-case
  (функція (рядок)
    (за-умовою
      ((хибне? (нативний-паритет-пятичленний? рядок))
       (native-first-parity-fail
         (як-є malformed-corpus)
         (як-є malformed-row)
         (як-є ())
         рядок))
      (так
       (нехай-послідовно
         ((назва (перше рядок))
          (вираз (друге рядок))
          (очікуване (третє рядок))
          (клас-ефекту (четверте рядок))
          (клас-помилки
            (перше (решта (решта (решта (решта рядок))))))
          (результат-обчислювача (обчислити вираз))
          (результат-машини (нативне-виконати-вираз вираз))
          (очікуваний-результат-машини
            (список
              (як-є execution-route)
              (як-є native)
              (як-є (status completed))
              (список (як-є value) очікуване))))
         (за-умовою
           ((однакові? результат-обчислювача очікуване)
            (за-умовою
              ((однакові? результат-машини очікуваний-результат-машини)
               (native-first-parity-pass
                 назва клас-ефекту клас-помилки))
              (так
               (native-first-parity-fail
                 назва
                 (як-є native-or-route-mismatch)
                 очікуваний-результат-машини
                 результат-машини))))
           (так
            (native-first-parity-fail
              назва
              (як-є evaluator-evidence-mismatch)
              очікуване
              результат-обчислювача))))))))

; Порожній правильний корпус має порожній список вердиктів.
; Неправильний атомарний хвіст дає один явний fail.
(визначити native-first-parity-run
  (функція (рядки)
    (за-умовою
      ((порожній? рядки) (як-є ()))
      ((атом? рядки)
       (список
         (native-first-parity-fail
           (як-є malformed-corpus)
           (як-є malformed-tail)
           (як-є ())
           рядки)))
      (так
       (сполучити
         (native-first-parity-case (перше рядки))
         (native-first-parity-run (решта рядки)))))))

; Некоректний вердикт не проходить. Перевірка статусу D3
; застосовується лише до атомарного третього поля.
(визначити native-first-parity-verdict-pass?
  (функція (вердикт)
    (за-умовою
      ((атом? вердикт) ні)
      ((атом? (решта вердикт)) ні)
      ((атом? (решта (решта вердикт))) ні)
      ((хибне? (атом? (третє вердикт))) ні)
      ((тотожне? (третє вердикт) (як-є pass)) так)
      (так ні))))

; Лише всі підтверджені pass дають D1 так.
; Пошкоджений хвіст — D1 ні, а не мовчазне завершення.
(визначити native-first-parity-all-pass?
  (функція (вердикти)
    (за-умовою
      ((порожній? вердикти) так)
      ((атом? вердикти) ні)
      ((native-first-parity-verdict-pass? (перше вердикти))
       (native-first-parity-all-pass? (решта вердикти)))
      (так ні))))
