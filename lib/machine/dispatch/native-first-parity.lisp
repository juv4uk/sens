; Диференційна перевірка машинного виконання та обчислювача — повністю мовою СЕНС.
; Публічні імена є незмінними посиланнями на єдині замикання СЕНС.
; Усі активні внутрішні виклики тепер мають українські імена.
; Еталонне очікуване значення задає незалежний рядок корпусу.
; Для успіху потрібні обидва докази: значення обчислювача та точний
; машинний маршрут із завершеним результатом. Робота обчислювача не може
; видаватися за успішне машинне виконання.
;
; Зовнішні назви функцій лишаються ідентифікаторами чинних споживачів.
; Викличні операції ядра — повні українські поверхні ратифікованих
; доменів. Результат логічних предикатів — точні «так»/«ні» домену Д1.
; Порожня структура () не є ані так, ані ні.
;
; Формат корпусу: (назва вираз очікуване клас-ефекту клас-помилки).
; Формат вердикту: (native-parity-case назва pass ...), або позначка fail
; з конкретними очікуваним і фактичним значеннями.

(визначити нативний-паритет-успіх
  (функція (назва клас-ефекту клас-помилки)
    (список
      (як-є native-parity-case)
      назва
      (як-є pass)
      (список (як-є effect) клас-ефекту)
      (список (як-є error) клас-помилки))))

(визначити нативний-паритет-невдача
  (функція (назва різновид очікуване фактичне)
    (список
      (як-є native-parity-case)
      назва
      (як-є fail)
      (список (як-є kind) різновид)
      (список (як-є expected) очікуване)
      (список (як-є actual) фактичне))))

; Доступ до п'ятого поля дозволений лише для правильного списку
; рівно з п'яти елементів. Некоректний рядок поверне діагностику,
; а не передасться обчислювачу або машинному шлюзу.
(визначити нативний-паритет-пятичленний?
  (функція (рядок)
    (за-умовою
      ((атом? рядок) ні)
      ((атом? (решта рядок)) ні)
      ((атом? (решта (решта рядок))) ні)
      ((атом? (решта (решта (решта рядок)))) ні)
      ((атом? (решта (решта (решта (решта рядок))))) ні)
      ((порожній?
         (решта (решта (решта (решта (решта рядок)))))) так)
      (так ні))))

; Справжнє порівняння структур виконує Д8 «однакові?», а не Д3
; тотожне? для атомів. Порівнюємо з окремим зовнішнім очікуванням.
(визначити нативний-паритет-перевірити-випадок
  (функція (рядок)
    (за-умовою
      ((хибне? (нативний-паритет-пятичленний? рядок))
       (нативний-паритет-невдача
         (як-є malformed-corpus)
         (як-є malformed-row)
         (як-є ())
         рядок))
      (так
       (нехай-послідовно
         ((назва (перше рядок))
          (вираз (друге рядок))
          (очікуване (третє рядок))
          (клас-ефекту (четверте рядок))
          (клас-помилки
            (перше (решта (решта (решта (решта рядок))))))
          (результат-обчислювача (обчислити вираз))
          (результат-машини (нативне-виконати-вираз вираз))
          (очікуваний-результат-машини
            (список
              (як-є execution-route)
              (як-є native)
              (як-є (status completed))
              (список (як-є value) очікуване))))
         (за-умовою
           ((однакові? результат-обчислювача очікуване)
            (за-умовою
              ((однакові? результат-машини очікуваний-результат-машини)
               (нативний-паритет-успіх
                 назва клас-ефекту клас-помилки))
              (так
               (нативний-паритет-невдача
                 назва
                 (як-є native-or-route-mismatch)
                 очікуваний-результат-машини
                 результат-машини))))
           (так
            (нативний-паритет-невдача
              назва
              (як-є evaluator-evidence-mismatch)
              очікуване
              результат-обчислювача))))))))

; Порожній правильний корпус має порожній список вердиктів.
; Неправильний атомарний хвіст дає одну явну відмову fail.
(визначити нативний-паритет-перевірити-корпус
  (функція (рядки)
    (за-умовою
      ((порожній? рядки) (як-є ()))
      ((атом? рядки)
       (список
         (нативний-паритет-невдача
           (як-є malformed-corpus)
           (як-є malformed-tail)
           (як-є ())
           рядки)))
      (так
       (сполучити
         (нативний-паритет-перевірити-випадок (перше рядки))
         (нативний-паритет-перевірити-корпус (решта рядки)))))))

; Некоректний вердикт не проходить. Перевірка статусу Д3
; застосовується лише до атомарного третього поля.
(визначити нативний-паритет-вердикт-успішний?
  (функція (вердикт)
    (за-умовою
      ((атом? вердикт) ні)
      ((атом? (решта вердикт)) ні)
      ((атом? (решта (решта вердикт))) ні)
      ((хибне? (атом? (третє вердикт))) ні)
      ((тотожне? (третє вердикт) (як-є pass)) так)
      (так ні))))

; Лише всі підтверджені успіхи pass дають Д1 «так».
; Пошкоджений хвіст означає Д1 «ні», а не мовчазне завершення.
(визначити нативний-паритет-усі-вердикти-успішні?
  (функція (вердикти)
    (за-умовою
      ((порожній? вердикти) так)
      ((атом? вердикти) ні)
      ((нативний-паритет-вердикт-успішний? (перше вердикти))
       (нативний-паритет-усі-вердикти-успішні? (решта вердикти)))
      (так ні))))

; Усі виклики проходять через первинні українські визначення вище.
