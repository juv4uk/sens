; Класифікатор виконання native-first, реалізований мовою SENS.
;
; Вхід — програмні дані. Результат — лише план native-plan або
; evaluator-fallback. Цей модуль не визначає семантику мови,
; не кодує машинні байти й не виконує машинну програму.
;
; Класифікація завершується безпечно, якщо голови, арність,
; вкладені списки або типи операндів не відповідають доказу.
; Перевірений машинний операнд ніколи не конвертується повторно.
; Ніякого запасного інтерпретатора SID8/Sens8 немає.
;
; Цитовані назви маршрутів та u64-imm — протокольні дані.
; Викличні голови D3/D4 беруться з ратифікованої колонки «укр».
; Значення так/ні належать D1. Цілі числа — людський запис D24+.
;
; Механізми-постачальники:
; lib/machine/layout/pair-x86-64.lisp
; lib/machine/operands/x86-64.lisp
; lib/machine/lowering/semantic-x86-64.lisp

; Будь-яка недоведена форма повертається обчислювачу без змін.
(визначити нативний-повернути-до-обчислювача
  (функція (вираз-планування)
    (сполучити
      (як-є evaluator-fallback)
      (сполучити вираз-планування (як-є ())))))

; Native-план містить машинні форми і розмір арени.
(визначити нативний-скласти-план
  (функція (форми-машини байти-арени)
    (сполучити
      (як-є native-plan)
      (сполучити
        форми-машини
        (сполучити байти-арени (як-є ()))))))

; Перевіряємо структуру сполучення, перш ніж брати його аргументи.
(визначити нативний-план-перше-сполучити
  (функція (вираз-планування вираз-сполучення)
    (за-умовою
      ((атом? (решта вираз-сполучення))
       (нативний-повернути-до-обчислювача вираз-планування))
      (так
       (нативний-план-пари-ліва-частина
         вираз-планування
         (решта вираз-сполучення))))))

(визначити нативний-план-пари-ліва-частина
  (функція (вираз-планування аргументи-сполучення)
    (за-умовою
      ((атом? (решта аргументи-сполучення))
       (нативний-повернути-до-обчислювача вираз-планування))
      (так
       (нативний-план-пари-права-частина
         вираз-планування
         аргументи-сполучення
         (решта аргументи-сполучення))))))

; Рівно два аргументи сполучення. Беззнакові машинні операнди
; перевіряються до lowering і обчислюються по одному разу.
; Недопустимі або пошкоджені результати не одержують native-план.
(визначити нативний-план-пари-права-частина
  (функція (вираз-планування аргументи-сполучення залишок-після-лівого)
    (за-умовою
      ((хибне? (порожній? (решта залишок-після-лівого)))
       (нативний-повернути-до-обчислювача вираз-планування))
      (так
       ((функція (лівий-операнд правий-операнд)
          (за-умовою
            ((атом? лівий-операнд)
             (нативний-повернути-до-обчислювача вираз-планування))
            ((атом? правий-операнд)
             (нативний-повернути-до-обчислювача вираз-планування))
            ((хибне? (тотожне? (перше лівий-операнд) (як-є u64-imm)))
             (нативний-повернути-до-обчислювача вираз-планування))
            ((хибне? (тотожне? (перше правий-операнд) (як-є u64-imm)))
             (нативний-повернути-до-обчислювача вираз-планування))
            (так
             (нативний-скласти-план
               (x86-lower-cons-car-u64-forms
                 (x86-u64-imm-value лівий-операнд)
                 (x86-u64-imm-value правий-операнд))
               x86-pair-cell-bytes))))
        (x86-as-u64-imm (перше аргументи-сполучення))
        (x86-as-u64-imm (перше залишок-після-лівого)))))))

; У звичайному текстовому виклику аргументом ПЕРШЕ
; може бути лише правильна форма (сполучити ...).
(визначити нативний-план-першого-аргументу
  (функція (вираз-планування аргумент-виразу)
    (за-умовою
      ((атом? аргумент-виразу)
       (нативний-повернути-до-обчислювача вираз-планування))
      ((хибне? (атом? (перше аргумент-виразу)))
       (нативний-повернути-до-обчислювача вираз-планування))
      ((тотожне? (перше аргумент-виразу) (як-є сполучити))
       (нативний-план-перше-сполучити вираз-планування аргумент-виразу))
      (так
       (нативний-повернути-до-обчислювача вираз-планування)))))

(визначити нативний-план-першого
  (функція (вираз-планування)
    (за-умовою
      ((атом? (решта вираз-планування))
       (нативний-повернути-до-обчислювача вираз-планування))
      ((порожній? (решта (решта вираз-планування)))
       (нативний-план-першого-аргументу
         вираз-планування
         (перше (решта вираз-планування))))
      (так
       (нативний-повернути-до-обчислювача вираз-планування)))))

(визначити класифікувати-нативний-вираз
  (функція (вираз-планування)
    (за-умовою
      ((атом? вираз-планування)
       (нативний-повернути-до-обчислювача вираз-планування))
      ((хибне? (атом? (перше вираз-планування)))
       (нативний-повернути-до-обчислювача вираз-планування))
      ((тотожне? (перше вираз-планування) (як-є перше))
       (нативний-план-першого вираз-планування))
      (так
       (нативний-повернути-до-обчислювача вираз-планування)))))

; Доменно-кодований виклик надходить уже з точним DomainIdentity.
; Зовнішня форма отримує (ширина (біт біт біт)) або порожній список.
; Довжину перевіряємо до порівняння будь-якого біта.
(визначити нативна-форма-трибітного-ключа?
  (функція (форма-доменного-ключа біт-перший-очікуваний біт-другий-очікуваний біт-третій-очікуваний)
    (за-умовою
      ((атом? форма-доменного-ключа) ні)
      ((атом? (решта форма-доменного-ключа)) ні)
      ((хибне? (порожній? (решта (решта форма-доменного-ключа)))) ні)
      ((тотожне? (перше форма-доменного-ключа) 3)
       (нативні-біти-трибітного-ключа?
         (перше (решта форма-доменного-ключа))
         біт-перший-очікуваний
         біт-другий-очікуваний
         біт-третій-очікуваний))
      (так ні))))

(визначити нативні-біти-трибітного-ключа?
  (функція (біти-ключа-д3 біт-перший-очікуваний біт-другий-очікуваний біт-третій-очікуваний)
    (за-умовою
      ((атом? біти-ключа-д3) ні)
      ((атом? (решта біти-ключа-д3)) ні)
      ((атом? (решта (решта біти-ключа-д3))) ні)
      ((хибне? (порожній? (решта (решта (решта біти-ключа-д3))))) ні)
      ((хибне? (тотожне? (перше біти-ключа-д3) біт-перший-очікуваний)) ні)
      ((хибне? (тотожне? (перше (решта біти-ключа-д3)) біт-другий-очікуваний)) ні)
      (так
       (тотожне?
         (перше (решта (решта біти-ключа-д3)))
         біт-третій-очікуваний)))))

(визначити нативний-домен-перше?
  (функція (форма-або-порожньо значення-параметра)
    (нативна-форма-трибітного-ключа?
      (форма-або-порожньо значення-параметра)
      так ні ні)))

(визначити нативний-домен-сполучити?
  (функція (форма-або-порожньо значення-параметра)
    (нативна-форма-трибітного-ключа?
      (форма-або-порожньо значення-параметра)
      так так так)))

(визначити нативний-план-доменного-сполучення
  (функція (форма-або-порожньо вираз-планування аргумент-виразу)
    (за-умовою
      ((атом? аргумент-виразу)
       (нативний-повернути-до-обчислювача вираз-планування))
      ((нативний-домен-сполучити? форма-або-порожньо (перше аргумент-виразу))
       (нативний-план-перше-сполучити
         вираз-планування
         аргумент-виразу))
      (так
       (нативний-повернути-до-обчислювача вираз-планування)))))

(визначити нативний-план-доменного-першого
  (функція (форма-або-порожньо вираз-планування)
    (за-умовою
      ((атом? (решта вираз-планування))
       (нативний-повернути-до-обчислювача вираз-планування))
      ((порожній? (решта (решта вираз-планування)))
       (нативний-план-доменного-сполучення
         форма-або-порожньо
         вираз-планування
         (перше (решта вираз-планування))))
      (так
       (нативний-повернути-до-обчислювача вираз-планування)))))

(визначити класифікувати-нативний-доменний-вираз
  (функція (форма-або-порожньо вираз-планування)
    (за-умовою
      ((атом? вираз-планування)
       (нативний-повернути-до-обчислювача вираз-планування))
      ((нативний-домен-перше? форма-або-порожньо (перше вираз-планування))
       (нативний-план-доменного-першого
         форма-або-порожньо
         вираз-планування))
      (так
       (нативний-повернути-до-обчислювача вираз-планування)))))
