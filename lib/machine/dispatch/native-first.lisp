; Native-first: класифікація виразу мовою SENS.
;
; Цей модуль тільки обирає маршрут. Він не кодує машинних байтів,
; не виконує машинних інструкцій і не підміняє обчислювач SENS.
; Невідомі, пошкоджені та непідтверджені форми повертаються без змін.
;
; Виконувані слова ядра походять з ратифікованої колонки «укр».
; Назви u64-imm, native-plan, evaluator-fallback — дані протоколу.
; Наявні машинні постачальники визначають свої зовнішні імена окремо.
; Жодних сід8/сенс8, історичних запасних шляхів або бітових викличних голів.
;
; Залежності:
; lib/machine/layout/pair-x86-64.lisp
; lib/machine/operands/x86-64.lisp
; lib/machine/lowering/semantic-x86-64.lisp

; Непідтверджений вираз не обчислюємо завчасно.
(визначити нативний-повернути-до-обчислювача
  (функція (вираз)
    (сполучити
      (як-є evaluator-fallback)
      (сполучити вираз (як-є ())))))

; Машинний план складається лише після перевірки двох операндів.
(визначити нативний-скласти-план
  (функція (форми байти-арени)
    (сполучити
      (як-є native-plan)
      (сполучити форми
        (сполучити байти-арени (як-є ()))))))

; Перше розбирання СПОЛУЧИТИ: порожнє чи атомарне продовження
; не може бути списком аргументів.
(визначити нативний-план-перше-сполучити
  (функція (початковий-вираз вираз-сполучення)
    (за-умовою
      ((атом? вираз-сполучення)
       (нативний-повернути-до-обчислювача початковий-вираз))
      ((атом? (решта вираз-сполучення))
       (нативний-повернути-до-обчислювача початковий-вираз))
      ((атом? (як-є ()))
       (нативний-план-пари-ліва-частина
         початковий-вираз
         (решта вираз-сполучення))))))

; Другий аргумент має існувати як окрема комірка.
(визначити нативний-план-пари-ліва-частина
  (функція (початковий-вираз аргументи)
    (за-умовою
      ((атом? аргументи)
       (нативний-повернути-до-обчислювача початковий-вираз))
      ((атом? (решта аргументи))
       (нативний-повернути-до-обчислювача початковий-вираз))
      ((атом? (як-є ()))
       (нативний-план-пари-права-частина
         початковий-вираз
         аргументи
         (решта аргументи))))))

; Рівно два аргументи. Типізація кожного машинного операнда
; виконується один раз; відмова типізатора не може стати native-планом.
; СЕНС-виклик іменованої функції замість недопущеного D5:00001 value-call.
; Лівий і правий типізовані операнди передаються рівно один раз.
(визначити нативний-план-пари-типізовані-операнди
  (функція (початковий-вираз лівий правий)
          (за-умовою
            ((атом? лівий)
             (нативний-повернути-до-обчислювача початковий-вираз))
            ((атом? правий)
             (нативний-повернути-до-обчислювача початковий-вираз))
            ; Обидва типізовані операнди повинні мати рівно два поля.
            ; Ні відсутній, ні зайвий, ні крапковий хвіст не є u64-imm.
            ((атом? (решта лівий))
             (нативний-повернути-до-обчислювача початковий-вираз))
            ((хибне? (порожній? (решта (решта лівий))))
             (нативний-повернути-до-обчислювача початковий-вираз))
            ((атом? (решта правий))
             (нативний-повернути-до-обчислювача початковий-вираз))
            ((хибне? (порожній? (решта (решта правий))))
             (нативний-повернути-до-обчислювача початковий-вираз))
            ((хибне? (атом? (перше лівий)))
             (нативний-повернути-до-обчислювача початковий-вираз))
            ((хибне? (атом? (перше правий)))
             (нативний-повернути-до-обчислювача початковий-вираз))
            ((хибне? (тотожне? (перше лівий) (як-є u64-imm)))
             (нативний-повернути-до-обчислювача початковий-вираз))
            ((хибне? (тотожне? (перше правий) (як-є u64-imm)))
             (нативний-повернути-до-обчислювача початковий-вираз))
            ((атом? (як-є ()))
             (нативний-скласти-план
               (знизити-складену-пару-до-машинних-форм
                 (значення-беззнакового-машинного-операнда лівий)
                 (значення-беззнакового-машинного-операнда правий))
               машинна-пара-байти-комірки))))
)

(визначити нативний-план-пари-права-частина
  (функція (початковий-вираз аргументи залишок)
    (за-умовою
      ((атом? залишок)
       (нативний-повернути-до-обчислювача початковий-вираз))
      ((хибне? (порожній? (решта залишок)))
       (нативний-повернути-до-обчислювача початковий-вираз))
      ((атом? (як-є ()))
       (нативний-план-пари-типізовані-операнди
         початковий-вираз
         (типізувати-беззнаковий-машинний-операнд (перше аргументи))
         (типізувати-беззнаковий-машинний-операнд (перше залишок)))))))
; ПЕРШЕ допускається лише над прямою формою СПОЛУЧИТИ.
(визначити нативний-план-першого-аргументу
  (функція (початковий-вираз аргумент)
    (за-умовою
      ((атом? аргумент)
       (нативний-повернути-до-обчислювача початковий-вираз))
      ((хибне? (атом? (перше аргумент)))
       (нативний-повернути-до-обчислювача початковий-вираз))
      ((тотожне? (перше аргумент) (як-є сполучити))
       (нативний-план-перше-сполучити початковий-вираз аргумент))
      ((атом? (як-є ()))
       (нативний-повернути-до-обчислювача початковий-вираз)))))

; ПЕРШЕ повинно мати рівно один правильно структурований аргумент.
(визначити нативний-план-першого
  (функція (початковий-вираз)
    (за-умовою
      ((атом? початковий-вираз)
       (нативний-повернути-до-обчислювача початковий-вираз))
      ((атом? (решта початковий-вираз))
       (нативний-повернути-до-обчислювача початковий-вираз))
      ((порожній? (решта (решта початковий-вираз)))
       (нативний-план-першого-аргументу
         початковий-вираз
         (перше (решта початковий-вираз))))
      ((атом? (як-є ()))
       (нативний-повернути-до-обчислювача початковий-вираз)))))

; Людська українська форма: класифікація, але не виконання.
(визначити класифікувати-нативний-вираз
  (функція (вираз)
    (за-умовою
      ((атом? вираз)
       (нативний-повернути-до-обчислювача вираз))
      ((хибне? (атом? (перше вираз)))
       (нативний-повернути-до-обчислювача вираз))
      ((тотожне? (перше вираз) (як-є перше))
       (нативний-план-першого вираз))
      ((атом? (як-є ()))
       (нативний-повернути-до-обчислювача вираз)))))

; Машинний механізм лише відображає точний DomainIdentity у форму
; (ширина (предикат-біт предикат-біт предикат-біт)).
; Тут порівнюється ціла форма разом із шириною; це не сід8-байт.
; Кількість елементів форми перевіряється довжиною українського списку, а не кодом операції.
(визначити нативна-форма-трибітного-ключа?
  (функція (форма перший-біт другий-біт третій-біт)
    (за-умовою
      ((атом? форма) (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (решта форма)) (атом? (сполучити (як-є ()) (як-є ()))))
      ((хибне? (порожній? (решта (решта форма)))) (атом? (сполучити (як-є ()) (як-є ()))))
      ((хибне? (атом? (перше форма))) (атом? (сполучити (як-є ()) (як-є ()))))
      ((хибне? (тотожне? (перше форма) (довжина (як-є (а б в))))) (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (як-є ()))
       (нативні-біти-трибітного-ключа?
         (перше (решта форма))
         перший-біт другий-біт третій-біт)))))

; Повна довжина та атомарність усіх трьох бітів перевіряється
; перед D3 ТОТОЖНЕ?, яке не порівнює структурні списки.
(визначити нативні-біти-трибітного-ключа?
  (функція (біти перший-біт другий-біт третій-біт)
    (за-умовою
      ((атом? біти) (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (решта біти)) (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (решта (решта біти))) (атом? (сполучити (як-є ()) (як-є ()))))
      ((хибне? (порожній? (решта (решта (решта біти))))) (атом? (сполучити (як-є ()) (як-є ()))))
      ((хибне? (атом? (перше біти))) (атом? (сполучити (як-є ()) (як-є ()))))
      ((хибне? (атом? (перше (решта біти)))) (атом? (сполучити (як-є ()) (як-є ()))))
      ((хибне? (атом? (перше (решта (решта біти))))) (атом? (сполучити (як-є ()) (як-є ()))))
      ((хибне? (тотожне? (перше біти) перший-біт)) (атом? (сполучити (як-є ()) (як-є ()))))
      ((хибне? (тотожне? (перше (решта біти)) другий-біт)) (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (як-є ()))
       (тотожне? (перше (решта (решта біти))) третій-біт)))))

; Ратифіковані D3 ПЕРШЕ (100) та СПОЛУЧИТИ (111).
; Значення бітів представлені D1, без бітових викличних голів.
(визначити нативний-домен-перше?
  (функція (форма-або-порожньо значення)
    (нативна-форма-трибітного-ключа?
      (форма-або-порожньо значення)
      (атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ()))) (атом? (сполучити (як-є ()) (як-є ()))))))

(визначити нативний-домен-сполучити?
  (функція (форма-або-порожньо значення)
    (нативна-форма-трибітного-ключа?
      (форма-або-порожньо значення)
      (атом? (як-є ())) (атом? (як-є ())) (атом? (як-є ())))))

; Точна доменна голова СПОЛУЧИТИ перевіряється окремо:
; механічне подання не можна плутати з текстовим псевдонімом.
(визначити нативний-план-доменного-сполучення
  (функція (форма-або-порожньо початковий-вираз аргумент)
    (за-умовою
      ((атом? аргумент)
       (нативний-повернути-до-обчислювача початковий-вираз))
      ((нативний-домен-сполучити?
         форма-або-порожньо (перше аргумент))
       (нативний-план-перше-сполучити початковий-вираз аргумент))
      ((атом? (як-є ()))
       (нативний-повернути-до-обчислювача початковий-вираз)))))

(визначити нативний-план-доменного-першого
  (функція (форма-або-порожньо початковий-вираз)
    (за-умовою
      ((атом? початковий-вираз)
       (нативний-повернути-до-обчислювача початковий-вираз))
      ((атом? (решта початковий-вираз))
       (нативний-повернути-до-обчислювача початковий-вираз))
      ((порожній? (решта (решта початковий-вираз)))
       (нативний-план-доменного-сполучення
         форма-або-порожньо
         початковий-вираз
         (перше (решта початковий-вираз))))
      ((атом? (як-є ()))
       (нативний-повернути-до-обчислювача початковий-вираз)))))

(визначити класифікувати-нативний-доменний-вираз
  (функція (форма-або-порожньо вираз)
    (за-умовою
      ((атом? вираз)
       (нативний-повернути-до-обчислювача вираз))
      ((нативний-домен-перше? форма-або-порожньо (перше вираз))
       (нативний-план-доменного-першого
         форма-або-порожньо вираз))
      ((атом? (як-є ()))
       (нативний-повернути-до-обчислювача вираз)))))
