; Точне формування звіту покриття машинного кодувальника SENS.
; Джерела: ратифікований перелік машинних інструкцій та проєкція допусків.
; Цей модуль створює дані про перевірену реалізацію, а не мовні функції.
; Керувальні результати мають точні значення D1 «так» і «ні».
; Зіставлення списків визначено мовними операціями D3; числа — десяткові.
; Жодних старих кодів сід8/сенс8 або машинних бітових викличних голів.
; Значення полів ICLASS, extension, status і reason — протокольні дані.
;
(визначити покриття-кодувальника-поєднати-рядки
  (функція аргументи
    (згорнути (функція (накопичене фрагмент) (рядок-додати накопичене фрагмент)) "" аргументи)))

; Кожне керувальне рішення про покриття використовує точний D1 PredicateBit.
; Глибоку структурну рівність визначає СЕНС за чинними законами D3:
; ATOM розрізняє атом і пару, EQ порівнює допущені атоми.
; Історичні носії глибокої рівності не переходять межу повноважень.
; Власні D1:0/D1:1 проєкції — ні та так; EQ-маркери не потрібні.
(визначити покриття-кодувальника-тотожні-атоми?
  (функція (ліве-значення праве-значення)
    (тотожне? ліве-значення праве-значення)))

(визначити покриття-кодувальника-тотожні-структури?
  (функція (ліве-значення праве-значення)
    (за-умовою
      ((атом? ліве-значення)
       (за-умовою
         ((атом? праве-значення)
          (покриття-кодувальника-тотожні-атоми? ліве-значення праве-значення))
         ((атом? (як-є ()))
          (хибне? (атом? (як-є ()))))))
      ((атом? праве-значення)
       (хибне? (атом? (як-є ()))))
      ((покриття-кодувальника-тотожні-структури? (перше ліве-значення) (перше праве-значення))
       (покриття-кодувальника-тотожні-структури? (решта ліве-значення) (решта праве-значення)))
      ((атом? (як-є ()))
       (хибне? (атом? (як-є ())))))))

; Для обходу потрібна саме порожня структура EMPTY, а не ширший ATOM.
; Так зберігається відмінність D1:0 від D3:000;
; предикат ATOM не підміняє порожню структуру NIL.
(визначити покриття-кодувальника-порожній-список?
  (функція (значення)
    (покриття-кодувальника-тотожні-структури? значення (як-є ()))))

; Кількість елементів — математичне десяткове число D24+ від першої комірки.
; У вихідній програмі звичайні 0, 1 та 5; фізичне T5M-пакування належить Zig.
(визначити покриття-кодувальника-порахувати-до
  (функція (елементи кількість)
    (за-умовою
      ((покриття-кодувальника-порожній-список? елементи) кількість)
      ((атом? (як-є ()))
       (покриття-кодувальника-порахувати-до
         (решта елементи)
         (додати кількість 1))))))

(визначити покриття-кодувальника-кількість-елементів
  (функція (елементи)
    (покриття-кодувальника-порахувати-до елементи 0)))

(визначити покриття-кодувальника-кількість-збігається?
  (функція (двійкова-кількість елементи)
    (тотожне? двійкова-кількість
       (покриття-кодувальника-кількість-елементів елементи))))


; Кон'юнкція працює лише з допущеними відповідями предикатів.
; Структурна порожнеча EMPTY означає відсутність свідка чи вибору,
; а не загальну істинність T/NIL.
(визначити покриття-кодувальника-усі-підтверджені?
  (функція (відповіді)
    (за-умовою
      ((покриття-кодувальника-порожній-список? відповіді)
       (атом? (як-є ())))
      ((перше відповіді)
       (покриття-кодувальника-усі-підтверджені? (решта відповіді)))
      ((атом? (як-є ()))
       (хибне? (атом? (як-є ())))))))

(визначити покриття-кодувальника-тотожні-пари?
  (функція (ліве-значення праве-значення)
    (покриття-кодувальника-тотожні-структури? ліве-значення праве-значення)))
(визначити покриття-кодувальника-містить-елемент?
  (функція (елемент елементи)
    (за-умовою
      ((покриття-кодувальника-порожній-список? елементи) (хибне? (атом? (як-є ()))))
      ((покриття-кодувальника-тотожні-структури? елемент (перше елементи))
       (атом? (як-є ())))
      ((атом? (як-є ()))
       (покриття-кодувальника-містить-елемент? елемент (решта елементи))))))

; Попарне об'єднання формує збалансоване дерево сполучень.
; Це усуває копіювання дедалі більшого накопичувача (~200 КБ)
; під час формування кожного нового рядка покриття.
(визначити покриття-кодувальника-коло-поєднання
  (функція (рядки накопичені-рядки)
    (за-умовою
      ((покриття-кодувальника-порожній-список? рядки) (зворот накопичені-рядки))
      ((покриття-кодувальника-порожній-список? (решта рядки))
       (зворот-до накопичені-рядки (список (перше рядки))))
      ((атом? (як-є ()))
       (покриття-кодувальника-коло-поєднання
         (решта (решта рядки))
         (сполучити
           (рядок-додати (перше рядки) (друге рядки))
           накопичені-рядки))))))

(визначити покриття-кодувальника-збалансоване-поєднання
  (функція (рядки)
    (за-умовою
      ((покриття-кодувальника-порожній-список? рядки) "")
      ((покриття-кодувальника-порожній-список? (решта рядки)) (перше рядки))
      ((атом? (як-є ()))
       (покриття-кодувальника-збалансоване-поєднання
         (покриття-кодувальника-коло-поєднання
           рядки
           (як-є ())))))))

(визначити покриття-кодувальника-форма-проєкції-допусків
  (перше
    (читати-всі
      (читати-файл
        "lib/machine/encoding/admission-iclass-projection.lisp"))))

(визначити покриття-кодувальника-кількість-голів-проєкції
  (друге (друге покриття-кодувальника-форма-проєкції-допусків)))

(визначити покриття-кодувальника-кількість-часткових
  (друге (третє покриття-кодувальника-форма-проєкції-допусків)))

(визначити покриття-кодувальника-кількість-сиріт
  (друге (четверте покриття-кодувальника-форма-проєкції-допусків)))

(визначити покриття-кодувальника-часткові-записи
  (решта
    (решта
      (решта
        (решта покриття-кодувальника-форма-проєкції-допусків)))))

(визначити покриття-кодувальника-підстава-частковості
  "За структурованим допуском Lisp щонайменше одна форма відповідає закріпленому ICLASS; повне покриття операндів і способів адресації XED не підтверджене")

(визначити покриття-кодувальника-історична-форма
  (перше
    (читати-всі
      (читати-файл
        "knowledge/encoder-coverage-legacy-parity.lisp"))))

(визначити покриття-кодувальника-історична-кількість
  (друге (друге покриття-кодувальника-історична-форма)))

(визначити покриття-кодувальника-історична-кількість-наступників
  (друге (третє покриття-кодувальника-історична-форма)))

(визначити покриття-кодувальника-історичні-пари
  (решта (решта (решта покриття-кодувальника-історична-форма))))


; Обидва згенеровані набори мають однаковий канонічний порядок
; ICLASS і розширень. Достатньо перевірки рівності: за розбіжності
; просуваємо індекс допущених форм. Застарілий або переставлений
; частковий запис залишиться невикористаним і спричинить відмову
; після вичерпання індексу.
(визначити покриття-кодувальника-рівні-ключі-рядків?
  (функція (ліве-значення праве-значення)
    (покриття-кодувальника-усі-підтверджені?
      (список
        (покриття-кодувальника-тотожні-структури? (друге ліве-значення) (друге праве-значення))
        (покриття-кодувальника-тотожні-структури? (третє ліве-значення) (третє праве-значення))))))

(визначити покриття-кодувальника-підстава-відсутності
  (функція (розширення)
    (за-умовою
      ((покриття-кодувальника-містить-елемент? розширення (як-є (AVX AVX2 FMA3 BMI1 BMI2 F16C)))
       "Кодування з префіксом VEX ще не реалізовано")
      ((покриття-кодувальника-тотожні-структури? розширення (як-є X87))
       "Кодування стекових регістрів x87 ще не реалізовано")
      ((покриття-кодувальника-тотожні-структури? розширення (як-є MMX))
       "Кодування таблиці кодів операцій MMX ще не реалізовано")
      ((покриття-кодувальника-містить-елемент?
         розширення
         (як-є (SSE SSE2 SSE3 SSSE3 SSE4.1+SSE4.2)))
       "Кодування обов'язкового префікса й ModRM для SSE ще не реалізовано")
      ((покриття-кодувальника-містить-елемент? розширення (як-є (AES-NI PCLMULQDQ)))
       "Кодування криптографічних команд із префіксом SSE ще не реалізовано")
      ((покриття-кодувальника-тотожні-структури? розширення (як-є XSAVE))
       "Кодування стану керування XSAVE ще не реалізовано")
      ((покриття-кодувальника-тотожні-структури? розширення (як-є MPX))
       "Кодування регістрів BND ще не реалізовано")
      ((покриття-кодувальника-тотожні-структури? розширення (як-є SGX))
       "Кодування підфункцій ENCLS/ENCLU ще не реалізовано")
      ((покриття-кодувальника-містить-елемент? розширення (як-є (RDRAND RDSEED)))
       "Кодування таблиці команд 0F C7 ще не реалізовано")
      ((покриття-кодувальника-тотожні-структури? розширення (як-є CLFLUSHOPT))
       "Кодування команд керування кешем ще не реалізовано")
      ((покриття-кодувальника-тотожні-структури? розширення (як-є X86-64))
       "Форми BASE для 64-бітного режиму очікують поетапної реалізації")
      ((атом? (як-є ()))
       "Решта форм BASE очікує поетапної реалізації"))))

(визначити покриття-кодувальника-сформувати-рядок
  (функція (рядок-покриття частковий-запис)
    (нехай-послідовно ((розширення (друге рядок-покриття))
           (клас-інструкції (третє рядок-покриття))
           (стан-покриття
             (за-умовою
               ((покриття-кодувальника-порожній-список? частковий-запис) (як-є not-yet-implemented))
               ((атом? (як-є ())) (як-є partial))))
           (підстава
             (за-умовою
               ((покриття-кодувальника-порожній-список? частковий-запис)
                (покриття-кодувальника-підстава-відсутності розширення))
               ((атом? (як-є ())) покриття-кодувальника-підстава-частковості))))
      (покриття-кодувальника-поєднати-рядки
        "  (coverage\n"
        "    (iclass " (значення-у-текст клас-інструкції) ")\n"
        "    (extension " (символ-у-текст розширення) ")\n"
        "    (status " (символ-у-текст стан-покриття) ")\n"
        "    (reason " (значення-у-текст підстава) "))\n"))))

; Одне хвостоворекурсивне злиття впорядкованих підмножин
; класифікує рядки, знаходить застарілі часткові записи,
; формує вивід і рахує часткове покриття.
; Результат: (рядки кількість-часткових предикат-застарілості-D1).
(визначити покриття-кодувальника-побудувати-до
  (функція (рядки-індексу часткові-записи побудовані-рядки кількість)
    (за-умовою
      ((покриття-кодувальника-порожній-список? рядки-індексу)
       (за-умовою
         ((покриття-кодувальника-порожній-список? часткові-записи)
          (список (зворот побудовані-рядки) кількість (хибне? (атом? (як-є ())))))
         ((атом? (як-є ()))
          (список (зворот побудовані-рядки) кількість (атом? (як-є ()))))))
      ((покриття-кодувальника-порожній-список? часткові-записи)
       (покриття-кодувальника-побудувати-до
         (решта рядки-індексу)
         часткові-записи
         (сполучити
           (покриття-кодувальника-сформувати-рядок (перше рядки-індексу) (як-є ()))
           побудовані-рядки)
         кількість))
      ((атом? (як-є ()))
       (нехай ((рядок-індексу (перше рядки-індексу))
             (рядок-часткового-покриття (перше часткові-записи)))
         (за-умовою
           ((покриття-кодувальника-рівні-ключі-рядків? рядок-індексу рядок-часткового-покриття)
            (покриття-кодувальника-побудувати-до
              (решта рядки-індексу)
              (решта часткові-записи)
              (сполучити
                (покриття-кодувальника-сформувати-рядок рядок-індексу рядок-часткового-покриття)
                побудовані-рядки)
              (додати кількість 1)))
           ((атом? (як-є ()))
            (покриття-кодувальника-побудувати-до
              (решта рядки-індексу)
              часткові-записи
              (сполучити
                (покриття-кодувальника-сформувати-рядок рядок-індексу (як-є ()))
                побудовані-рядки)
              кількість))))))))

(визначити покриття-кодувальника-унікальний-індекс?
  (функція (рядки попередній-рядок)
    (за-умовою
      ((покриття-кодувальника-порожній-список? рядки) (атом? (як-є ())))
      ((покриття-кодувальника-порожній-список? попередній-рядок)
       (покриття-кодувальника-унікальний-індекс?
         (решта рядки)
         (перше рядки)))
      ((покриття-кодувальника-рівні-ключі-рядків? (перше рядки) попередній-рядок)
       (хибне? (атом? (як-є ()))))
      ((атом? (як-є ()))
       (покриття-кодувальника-унікальний-індекс?
         (решта рядки)
         (перше рядки))))))

(визначити покриття-кодувальника-форма-індексу
  (перше
    (читати-всі
      (читати-файл
        "lib/machine/encoding/admitted-iclass-index.lisp"))))

(визначити покриття-кодувальника-кількість-індексу
  (друге (друге покриття-кодувальника-форма-індексу)))

(визначити покриття-кодувальника-рядки-індексу
  (решта (решта покриття-кодувальника-форма-індексу)))

(визначити покриття-кодувальника-кількість-форм
  (покриття-кодувальника-кількість-елементів покриття-кодувальника-рядки-індексу))

(визначити покриття-кодувальника-часткові-коректні?
  (функція (рядки-індексу часткові-записи)
    (за-умовою
      ((покриття-кодувальника-порожній-список? часткові-записи) (атом? (як-є ())))
      ((покриття-кодувальника-порожній-список? рядки-індексу) (хибне? (атом? (як-є ()))))
      ((атом? (як-є ()))
       (нехай ((рядок-індексу (перше рядки-індексу))
             (рядок-часткового-покриття (перше часткові-записи)))
         (за-умовою
           ((покриття-кодувальника-рівні-ключі-рядків? рядок-індексу рядок-часткового-покриття)
            (покриття-кодувальника-часткові-коректні?
              (решта рядки-індексу)
              (решта часткові-записи)))
