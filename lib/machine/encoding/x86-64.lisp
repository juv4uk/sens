; RDRAND/RDSEED r64 — позитивний контроль для машинної грамматики generator-first #2372.
; Обидві команди походять від форми, підтвердженої XED:
; REX.W + 0F C7 /digit, MOD=3, RM=GPRv.
; Спільний допоміжний механізм визначає кодування;
; обгортки мнемонік є похідними проєкціями.
(визначити машина-кодувати-групу-нуль-еф-сім-регістр-64
  (функція (розширення-коду-операції регістр)
    (нехай ((код-регістра (машина-код-регістра регістр))
          (розширення-механізму
            (машина-проєктувати-три-біти-до-механізму розширення-коду-операції)))
      ; Байти сформованої інструкції належать машинному носію.
      ; Вхід розширення коду операції вище лишається канонічним (#b...).
      ; Не переносимо BinaryNumber у список машинних байтів:
      ; перевірка рівності навмисно розрізняє канонічний
      ; BinaryNumber та історичний машинний Number.
      (список
        (машина-кодувати-поле-рекс 1 0 0 (машина-старший-біт код-регістра))
        15
        199
        (машина-кодувати-модрм 3 розширення-механізму (машина-молодші-три-біти код-регістра))))))

