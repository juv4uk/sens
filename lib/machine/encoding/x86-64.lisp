; SETcc r8: код 0x0F 0x90+cc; ModRM: mod=3, reg=0, rm=молодші-3-біти(код).
; У 64-бітному режимі:
; - коди 0..3 (al, cl, dl, bl) не потребують префікса REX.
; - коди 4..7 (spl, bpl, sil, dil) потребують REX (0x40), щоб відрізнити
;   їх від історичних старших байтових регістрів (ah, ch, dh, bh).
; - коди 8..15 (r8b..r15b) потребують префікса з REX.B=1 (0x41).
(визначити машина-кодувати-встановлення-байта-за-умовою
  (функція (код-умови регістр)
    (нехай ((код (машина-код-регістра регістр)))
      ; Префікс REX обирає точний предикат D1; за замовчуванням
      ; використовуємо явне свідчення істини D1, не історичну форму.
      (за-умовою
        ((більше? код 3)
         (список
           (машина-кодувати-поле-рекс 0 0 0 (машина-старший-біт код))
           15
           (додати 144 код-умови)
           (машина-кодувати-модрм 3 0 (машина-молодші-три-біти код))))
        ((атом? (як-є ()))
         (список
           15
           (додати 144 код-умови)
           (машина-кодувати-модрм 3 0 (машина-молодші-три-біти код))))))))

