; Повторно використовуємо доведений у Lisp добувач байтів через ділення стовпчиком.
; Чотири ітерації задають фізичне подання imm32; старі голови W8
; для частки й остачі не мають повноважень у строгому D1 COND.
; Канонічний запис #q2 задає точну величину цілого.
; Біти чисельника читаємо тільки після перевірки тега та знаменника.
; Від'ємні, дробові, пошкоджені й завеликі числа явно відхиляємо.
(визначити машина-розділити-ціле-подання
  (функція (текст біти)
    (за-умовою
      ((рядок-порожній? текст) (як-є ()))
      ((рядок-префікс? "/" текст) (сполучити біти (рядок-решта текст)))
      ((рядок-префікс? "0" текст)
       (машина-розділити-ціле-подання (рядок-решта текст) (сполучити 0 біти)))
      ((рядок-префікс? "1" текст)
       (машина-розділити-ціле-подання (рядок-решта текст) (сполучити 1 біти)))
      ((атом? ()) (як-є ())))))

(визначити машина-подання-знаменник-одиниця?
  (функція (частини)
    (за-умовою
      ((рядок-префікс? "1" (решта частини))
       (за-умовою
         ((рядок-порожній? (рядок-решта (решта частини))) (атом? ()))
         ((атом? ()) (як-є ()))))
      ((атом? ()) (як-є ())))))

(визначити машина-біти-цілого-подання
  (функція (значення)
    ((функція (текстове-подання)
       (за-умовою
         ((рядок-префікс? "#q2:" текстове-подання)
          ((функція (частини)
             (за-умовою
               ((хибне? (атом? частини))
                (за-умовою
                  ((порожній? (перше частини)) (як-є ()))
                  ((атом? ())
                   (за-умовою
                     ((машина-подання-знаменник-одиниця? частини) (перше частини))
                     ((атом? ()) (як-є ())))))))
           (машина-розділити-ціле-подання
             (рядок-решта (рядок-решта (рядок-решта (рядок-решта текстове-подання)))
             (як-є ()))))
         ((атом? ()) (як-є ()))))
     (значення-у-текст значення))))))

