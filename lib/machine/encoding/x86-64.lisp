          (код-бази (машина-код-регістра база)))
      (нехай ((байт-модрм
              (машина-кодувати-модрм
                1
                (машина-молодші-три-біти код-призначення)
                (машина-молодші-три-біти код-бази)))
            (байт-зсуву (машина-байт-восьмибітного-зсуву зміщення)))
        ((функція (хвіст-адреси) (за-умовою
            ((менше? (додати (машина-старший-біт код-призначення) (машина-старший-біт код-бази)) 1)
             (приєднати
