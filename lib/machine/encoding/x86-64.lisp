      ; Exact-D1 predicate selects REX; structural default is the
      ; explicit D1 true witness, never legacy (query expected result).
      (за-умовою
        ((більше? код 3)
         (список
           (машина-кодувати-поле-рекс 0 0 0 (машина-старший-біт код))
           15
           (додати 144 код-умови)
           (машина-кодувати-модрм 3 0 (машина-молодші-три-біти код))))
        ((атом? (як-є ()))
         (список
           15
           (додати 144 код-умови)
           (машина-кодувати-модрм 3 0 (машина-молодші-три-біти код))))))))

