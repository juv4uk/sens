; Механічне, замкнене складання двох списків байтів із D3 CONS/CAR/CDR.
; Жодна історична W8 APPEND-голова не отримує права виклику.
; Byte-list traversal must feed exact PredicateBit values to D3 COND.
; Legacy surface aliases atom?/eq?/car/cdr/append retain answer/compatibility
; domains; the machine path uses the canonical 3-bit heads directly.
; Byte-list traversal drives exact D3 COND using only exact PredicateBit
; operations. ATOM distinguishes empty-list from pair; D4 NOT complements that
; bit for the recursive branch. Avoid D3 EQ here: compatibility EQ answers are
; graded lists and are intentionally invalid as D3 COND controls.
(визначити машина-сполучити-байти
  (функція (ліво право)
    (за-умовою
      ((атом? ліво) право)
      ((хибне? (атом? ліво))
       (сполучити
         (перше ліво)
         (машина-сполучити-байти (решта ліво) право))))))

(визначити машина-кодувати-програму-інструкцій
  (функція (інструкції)
    (за-умовою
      ((порожній? інструкції) (як-є ()))
      ((хибне? (атом? інструкції))
       (машина-сполучити-байти
         (перше інструкції)
         (машина-кодувати-програму-інструкцій (решта інструкції))))
      ((атом? інструкції)
       (список (як-є rejected) (як-є machine-operand) (як-є instruction-list) інструкції)))))

; #2372 reusable VEX3 XMM register law.
; byte1 = C4; byte2 = ~R ~X ~B m-mmmm; byte3 = W ~vvvv L pp.
; These are machine bytes in the exact Number carrier already used by the
; x86 encoder, so the instruction-set witness compares identity, not print.
(визначити машина-другий-байт-векс3
  (функція (поле-карти поле-регістра поле-індексу поле-бази)
    (додати
      (помножити (відняти 1 поле-регістра) 128)
      (додати
        (помножити (відняти 1 поле-індексу) 64)
        (додати
          (помножити (відняти 1 поле-бази) 32)
          поле-карти)))))

(визначити машина-третій-байт-векс3
  (функція (поле-ширини поле-інверсного-регістра поле-довжини поле-префікса)
    (додати
      (помножити поле-ширини 128)
      (додати
        (помножити (відняти 15 поле-інверсного-регістра) 8)
        (додати
          (помножити поле-довжини 4)
          поле-префікса)))))

(визначити машина-кодувати-векс3-три-векторні-регістри
  (функція (поле-карти поле-ширини поле-довжини поле-префікса код-операції призначення перше-джерело друге-джерело)
    (нехай
      ((код-призначення (машина-код-векторного-регістра призначення))
       (код-першого-джерела (машина-код-векторного-регістра перше-джерело))
       (код-другого-джерела (машина-код-векторного-регістра друге-джерело)))
      (список
        196
        (машина-другий-байт-векс3
          поле-карти
          (машина-старший-біт код-призначення)
          0
          (машина-старший-біт код-другого-джерела))
        (машина-третій-байт-векс3 поле-ширини код-першого-джерела поле-довжини поле-префікса)
        код-операції
        (машина-кодувати-модрм
          3
          (машина-молодші-три-біти код-призначення)
          (машина-молодші-три-біти код-другого-джерела))))))

