            число-п'ятнадцять машина-число-сто-сімдесят-сім (машина-кодувати-модрм число-три (машина-молодші-три-біти код-джерела) (машина-молодші-три-біти код-призначення))))))

; Механічне, замкнене складання двох списків байтів із D3 CONS/CAR/CDR.
; Жодна історична W8 APPEND-голова не отримує права виклику.
; Обхід списку байтів має передавати до D3 COND лише точні PredicateBit.
; Історичні назви atom?/eq?/car/cdr/append зберігають свої
; домени відповідей і сумісності. Машинний шлях використовує
; канонічні трьохбітні викличні голови безпосередньо.
; ATOM розрізняє порожній список і пару, D4 NOT доповнює
; цей біт для рекурсивного переходу. D3 EQ тут не застосовуємо:
; відповіді сумісного EQ — градуйовані списки, які не можна
; передавати як керувальні результати D3 COND.
(визначити машина-сполучити-байти
  (функція (ліво право)
    (за-умовою
      ((атом? ліво) право)
      ((хибне? (атом? ліво))
       (сполучити
         (перше ліво)
         (машина-сполучити-байти (решта ліво) право))))))

(визначити машина-кодувати-програму-інструкцій
  (функція (інструкції)
    (за-умовою
      ((порожній? інструкції) (як-є ()))
      ((хибне? (атом? інструкції))
       (машина-сполучити-байти
         (перше інструкції)
         (машина-кодувати-програму-інструкцій (решта інструкції))))
      ((атом? інструкції)
       (список (як-є rejected) (як-є machine-operand) (як-є instruction-list) інструкції)))))

; #2372 — повторно використовуваний закон регістрів XMM для VEX3.
; байт1 = C4; байт2 = ~R ~X ~B m-mmmm; байт3 = W ~vvvv L pp.
; Це машинні байти на тому самому носії Number, який уже
; використовує кодер x86. Свідок ISA перевіряє точну тотожність,
; а не текстове відображення.
(визначити машина-другий-байт-векс3
  (функція (поле-карти поле-регістра поле-індексу поле-бази)
    (додати
      (помножити (відняти число-один поле-регістра) машина-число-сто-двадцять-вісім)
      (додати
        (помножити (відняти число-один поле-індексу) машина-число-шістдесят-чотири)
        (додати
          (помножити (відняти число-один поле-бази) машина-число-тридцять-два)
          поле-карти)))))

(визначити машина-третій-байт-векс3
  (функція (поле-ширини поле-інверсного-регістра поле-довжини поле-префікса)
    (додати
      (помножити поле-ширини машина-число-сто-двадцять-вісім)
      (додати
        (помножити (відняти число-п'ятнадцять поле-інверсного-регістра) число-вісім)
        (додати
          (помножити поле-довжини число-чотири)
          поле-префікса)))))

(визначити машина-кодувати-векс3-три-векторні-регістри
  (функція (поле-карти поле-ширини поле-довжини поле-префікса код-операції призначення перше-джерело друге-джерело)
    (нехай
      ((код-призначення (машина-код-векторного-регістра призначення))
       (код-першого-джерела (машина-код-векторного-регістра перше-джерело))
       (код-другого-джерела (машина-код-векторного-регістра друге-джерело)))
      (список
        машина-число-сто-дев'яносто-шість
        (машина-другий-байт-векс3
          поле-карти
          (машина-старший-біт код-призначення)
          число-нуль
          (машина-старший-біт код-другого-джерела))
        (машина-третій-байт-векс3 поле-ширини код-першого-джерела поле-довжини поле-префікса)
        код-операції
        (машина-кодувати-модрм
          число-три
          (машина-молодші-три-біти код-призначення)
