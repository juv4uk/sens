                 102
                 (машина-кодувати-поле-рекс
                   0
                   (машина-старший-біт код-призначення)
                   0
                   (машина-старший-біт код-бази))
                 15
                 байт-карти
                 байт-коду-операції)
               хвіст-адреси)))) (за-умовою
                  ((тотожне? (машина-молодші-три-біти код-бази) 4)
                   (список байт-модрм (машина-кодувати-сіб 0 4 4) байт-зсуву))
                  ((атом? ())
