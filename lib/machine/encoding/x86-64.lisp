  (функція (розширення-коду-операції регістр)
    ((функція (код) (за-умовою
        ((тотожне? (машина-старший-біт код) 1)
          (список
            (машина-кодувати-поле-рекс 0 0 0 1)
            255
            (машина-кодувати-модрм 3 розширення-коду-операції (машина-молодші-три-біти код))))
        ((атом? ())
          (список
            255
            (машина-кодувати-модрм 3 розширення-коду-операції (машина-молодші-три-біти код)))))) (машина-код-регістра регістр))))

