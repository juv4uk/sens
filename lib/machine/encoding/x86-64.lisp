; у 64-бітному режимі ці байти є префіксами REX.
; Тому INC/DEC кодуємо тільки через ModRM групи 5.
(визначити машина-кодувати-збільшення-регістра-64
  (функція (регістр)
    ((функція (код) (список
        (машина-кодувати-поле-рекс число-один число-нуль число-нуль (машина-старший-біт код))
        машина-число-двісті-п'ятдесят-п'ять
        (машина-кодувати-модрм число-три число-нуль (машина-молодші-три-біти код)))) (машина-код-регістра регістр))))

