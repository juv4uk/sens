         ((рядок-порожній? (рядок-решта (решта частини))) (атом? ()))
         ((атом? ()) (як-є ()))))
      ((атом? ()) (як-є ())))))

(визначити машина-біти-цілого-подання
  (функція (значення)
    ((функція (текстове-подання)
       (за-умовою
         ((рядок-префікс? "#q2:" текстове-подання)
          ((функція (частини)
             (за-умовою
               ((хибне? (атом? частини))
                (за-умовою
                  ((порожній? (перше частини)) (як-є ()))
                  ((атом? ())
                   (за-умовою
                     ((машина-подання-знаменник-одиниця? частини) (перше частини))
                     ((атом? ()) (як-є ())))))))
           (машина-розділити-ціле-подання
             (рядок-решта (рядок-решта (рядок-решта (рядок-решта текстове-подання)))
             (як-є ()))))
         ((атом? ()) (як-є ()))))
     (значення-у-текст значення))))))

