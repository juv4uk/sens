; Чинна машинна проєкція для точних доменів і підтверджених шляхів x86-64.
; Рядки описують механізми, а не створюють закони мови чи нові резиденти.
; Ключ містить і точний домен, і повне викличне ім'я з колонки «укр».
; Це не спадкоємець плоскої таблиці та не ключ із самої ширини або числового слова.

(machine-domain-profile-3
  (target x86-64)
  (cpu intel-core-i5-6400)
  (key-shape domain+ukr-resident)
  (rows
    (домен-п'ятий нуль? proof "CMP+SETE+MOVZX / точний внутрішній біт цілого числа; межа Д1")
    (домен-п'ятий додати fast-path "ADD / беззнакові 32-бітні входи → точний 64-бітний результат")
    (домен-п'ятий відняти fast-path "SUB / 64-бітні беззнакові значення; ліве ≥ правого")
    (домен-п'ятий помножити fast-path "IMUL / беззнакові 32-бітні входи → точний 64-бітний результат")
    (домен-п'ятий частка fast-path "CQO+IDIV / додатні 64-бітні цілі; рівні операнди")
    (домен-п'ятий менше? proof "CMP+SETL+MOVZX / внутрішній біт; межа Д1")
    (домен-п'ятий більше? proof "CMP+SETG+MOVZX / внутрішній біт; межа Д1")
    (домен-шостий додати-1 fast-path "ADD / точний 64-бітний вхід не перевищує найбільше значення мінус два; правий операнд = 1")
    (домен-шостий відняти-1 fast-path "SUB / точний 64-бітний вхід не менший від одиниці; правий операнд = 1")
    (домен-третій тотожне? direct "CMP/SETE")
    (домен-третій за-умовою control "CMP+Jcc")
    (домен-третій сполучити runtime "STORE-pair-head+tail / записати голову й хвіст пари")
    (домен-третій перше direct "LOAD-pair-head / прочитати голову пари")
    (домен-третій решта direct "LOAD-pair-tail / прочитати хвіст пари")))
