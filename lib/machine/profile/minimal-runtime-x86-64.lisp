; #196 — мінімальні машинні профілі для обмежених свідків Lisp.
;
; Це не другий каталог ISA, таблиця кодів операцій, кодер або список допуску.
; Спостережені сімейства машинних команд походять від наявного зниження
; семантичних форм. Рядки залежностей лише пояснюють потребу кожного
; сімейства для конкретного обмеженого свідка.
;
; Межі свідків: перше(пара) у виділеній області пари,
; умовний вибір за рівністю для беззнакових чисел і складення
; умовного вибору з побудовою пари.
; Це не універсальний розподільник пам'яті, збирання сміття,
; розв'язування міток, угода викликів або повний компілятор.

(визначити мінімальна-машина-перше-пари-залежності
  (як-є
    ((materialize-value
       mov-r64-imm64
       required-for-minimal-runtime
       "підготувати поля пари з обмеженими 64-бітними беззнаковими значеннями")
     (store-pair-field
       mov-mem-disp8-r64
       required-for-minimal-runtime
       "записати перший елемент і решту пари в область пам'яті, надану виконавцем")
     (load-pair-field
       mov-r64-mem-disp8
       required-for-minimal-runtime
       "прочитати перший елемент обмеженої пари")
     (return-result
       ret
       required-for-minimal-runtime
       "повернути обмежений результат через двійковий інтерфейс виконавця"))))

(визначити мінімальна-машина-рівність-умова-залежності
  (як-є
    ((materialize-value
       mov-r64-imm64
       required-for-minimal-runtime
       "підготувати 64-бітні операнди предиката й значення обох гілок вибору")
     (compare-equality
       cmp-r64-r64
       required-for-minimal-runtime
       "обчислити умову тотожності для обмеженого предиката EQ")
     (branch-on-false
       jnz-rel8
       required-for-minimal-runtime
       "вибрати альтернативну гілку, коли умова тотожності хибна")
     (return-selected-result
       ret
       required-for-minimal-runtime
       "повернути вибраний обмежений результат через двійковий інтерфейс програми"))))

(визначити мінімальна-машина-рівність-умова-пара-залежності
  (як-є
    ((materialize-values
       mov-r64-imm64
       required-for-minimal-runtime
       "підготувати обмежені операнди EQ та поля пар кожної гілки, зокрема в регістрах r8–r11")
     (compare-equality
       cmp-r64-r64
       required-for-minimal-runtime
       "обчислити умову тотожності для обмеженого предиката EQ")
     (branch-on-false
       jnz-rel8
       required-for-minimal-runtime
       "вибрати структурну альтернативну гілку, коли тотожність хибна")
     (store-pair-field
       mov-mem-disp8-r64
       required-for-minimal-runtime
       "зберегти пару вибраної гілки в області пам'яті машинного виклику")
     (load-pair-car
       mov-r64-mem-disp8
       required-for-minimal-runtime
       "прочитати перший елемент пари вибраної гілки")
     (return-result
       ret
       required-for-minimal-runtime
       "повернути вибраний структурний результат через двійковий інтерфейс програми"))))

(визначити мінімальна-машина-містить-сімейство?
  (функція (сімейство сімейства)
    (за-умовою
      
      ((атом? сімейства)  ())
      ((тотожне? сімейство (перше сімейства)) так)
      ((атом? ()) (мінімальна-машина-містить-сімейство? сімейство (решта сімейства))))))

(визначити мінімальна-машина-унікальні-сімейства-форм
  (функція (форми переглянуті)
    (за-умовою
      
      ((атом? форми)  переглянуті)
      ((атом? ())
       (нехай ((сімейство (перше (перше форми))))
         (за-умовою
           ((мінімальна-машина-містить-сімейство? сімейство переглянуті)
            (мінімальна-машина-унікальні-сімейства-форм (решта форми) переглянуті))
           ((атом? ())
            (мінімальна-машина-унікальні-сімейства-форм
              (решта форми)
              (приєднати переглянуті (список сімейство))))))))))

