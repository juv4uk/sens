; Українська проєкція зниження семантики СЕНС до x86-64.
; Значення мови належить чинному контракту та ратифікованим законам доменів.
; Набір інструкцій і кодування належать lib/machine/isa та lib/machine/encoding.
; Цей файл визначає лише реалізацію вже наявної семантичної тотожності.
;
; Зниження повертає структуровані машинні форми. Фізичні байти створює
; окремий закритий шар допуску; прямого обхідного інтерфейсу тут немає.

; Перший виконуваний доказ зниження семантики до машинних команд.
; Семантична тотожність 00001100 існує до завантаження цього файлу.
; Ця функція не визначає додавання, а обирає обмежену реалізацію u64.
; Вона повертає лише структуровані машинні форми.
; Перетворення цих форм на виконувані байти належить шару допуску.
;
; За угодою SysV x86-64 результат повертається через RAX.
; Регістр RCX зберігає викликач, тому функція не порушує ABI
; перезаписом регістра, який мав би зберегти викликаний код.
(визначити машина-знизити-додавання-беззнакових-64-до-форм
  (функція (лівий-операнд-машини правий-операнд-машини)
    (список
      (список (як-є mov-r64-imm64) (як-є rax) лівий-операнд-машини)
      (список (як-є mov-r64-imm64) (як-є rcx) правий-операнд-машини)
      (список (як-є add-r64-r64) (як-є rax) (як-є rcx))
      (список (як-є ret)))))

; #4001 — обмежені докази точних операцій D5 DIFFERENCE і TIMES.
; Ці функції лише описують машинні форми. Вибір нижче спирається
; на точне обчислення D5: SUB та IMUL застосовуються тільки тоді,
; коли обидва операнди й точний результат поміщаються в u64.
(визначити машина-знизити-віднімання-беззнакових-64-до-форм
  (функція (лівий-операнд-машини правий-операнд-машини)
    (список
      (список (як-є mov-r64-imm64) (як-є rax) лівий-операнд-машини)
      (список (як-є mov-r64-imm64) (як-є rcx) правий-операнд-машини)
      (список (як-є sub-r64-r64) (як-є rax) (як-є rcx))
      (список (як-є ret)))))

(визначити машина-знизити-множення-беззнакових-64-до-форм
  (функція (лівий-операнд-машини правий-операнд-машини)
    (список
      (список (як-є mov-r64-imm64) (як-є rax) лівий-операнд-машини)
      (список (як-є mov-r64-imm64) (як-є rcx) правий-операнд-машини)
      (список (як-є imul-r64-r64) (як-є rax) (як-є rcx))
      (список (як-є ret)))))

; #4017 — перший машинний доказ точного часткового D5 QUOTIENT.
; Доведено лише x/x = 1 для додатних операндів зі знаком i64.
; Вузька умова гарантує точну подільність, не покладаючись
; на текстову назву, історичний SID8 чи усічення раціональної семантики.
(визначити машина-знизити-частку-знакових-64-до-форм
  (функція (лівий-операнд-машини правий-операнд-машини)
    (список
      (список (як-є mov-r64-imm64) (як-є rax) лівий-операнд-машини)
      (список (як-є mov-r64-imm64) (як-є rcx) правий-операнд-машини)
      (список (як-є cqo))
      (список (як-є idiv-r64) (як-є rcx))
      (список (як-є ret)))))

; #196 — обмежений доказ умовного вибору для наявної семантики EQ і COND.
; Функція не визначає рівність і не змінює умовне обчислення.
; Вона обирає реалізацію фіксованої ширини u64, щоб установити
; необхідний мінімум машинних ефектів для вибору з двох гілок.
;
; JNZ +11 пропускає рівно один MOV r64,imm64 (10 байтів) та RET (1 байт)
; і переходить до гілки ELSE. Це не загальний розв'язувач міток,
; збирач переходів чи правило компілятора. Повертаються лише
; структуровані форми; байти створюються тільки після закритого допуску.
(визначити машина-знизити-рівність-та-умову-64
  (функція (лівий-операнд правий-операнд значення-якщо-так значення-якщо-ні)
    (список
      (список (як-є mov-r64-imm64) (як-є rax) лівий-операнд)
      (список (як-є mov-r64-imm64) (як-є rcx) правий-операнд)
      (список (як-є cmp-r64-r64) (як-є rax) (як-є rcx))
      (список (як-є jnz-rel8) 11)
      (список (як-є mov-r64-imm64) (як-є rax) значення-якщо-так)
      (список (як-є ret))
      (список (як-є mov-r64-imm64) (як-є rax) значення-якщо-ні)
      (список (як-є ret)))))

; #196 — поєднання умовного вибору та структури пари.
; Кожна гілка створює обмежену пару в одній області native-call
; і повертає її CAR. Викликач обирає окремі розширені регістри
; загального призначення, за збереження яких відповідає викликач.
; Тому розширений допуск MOV imm64 із #207 перевіряється складенням
; семантики, а не окремим доказом ISA. Результат ABI лишається в RAX.
(визначити машина-знизити-обмежений-вибір-першого-пари-64
  (функція (лівий-операнд правий-операнд лівий-регістр правий-регістр)
    (список
      (список (як-є mov-r64-imm64) лівий-регістр лівий-операнд)
      (список
        (як-є mov-mem-disp8-r64)
        (як-є rdi)
        x86-пара-перше-зсув
        лівий-регістр)
      (список (як-є mov-r64-imm64) правий-регістр правий-операнд)
      (список
        (як-є mov-mem-disp8-r64)
        (як-є rdi)
        x86-пара-решта-зсув
        правий-регістр)
      (список
        (як-є mov-r64-mem-disp8)
        (як-є rax)
        (як-є rdi)
        x86-пара-перше-зсув)
      (список (як-є ret)))))

; Третій обмежений приклад #196: вибір COND/EQ зі структурними
; гілками CAR(CONS ...). Обсяг навмисно скінченний: JNZ +33 пропускає
; одну гілку CAR(CONS) із шести форм (10+4+10+4+4+1 байтів, база RDI).
; Кожна гілка повертає результат безпосередньо. Тут не заявлено
; розв'язування міток, розподілу регістрів, збирання сміття
; або загального рекурсивного зниження виразів.
(визначити машина-знизити-рівність-умову-та-пару-64
  (функція (лівий-операнд правий-операнд перше-якщо-так решта-якщо-так перше-якщо-ні решта-якщо-ні)
    (приєднати
      (список
        (список (як-є mov-r64-imm64) (як-є rax) лівий-операнд)
        (список (як-є mov-r64-imm64) (як-є rcx) правий-операнд)
        (список (як-є cmp-r64-r64) (як-є rax) (як-є rcx))
        (список (як-є jnz-rel8) 33))
      (приєднати
        (машина-знизити-обмежений-вибір-першого-пари-64
          перше-якщо-так решта-якщо-так (як-є r8) (як-є r9))
        (машина-знизити-обмежений-вибір-першого-пари-64
          перше-якщо-ні решта-якщо-ні (як-є r10) (як-є r11))))))

; Обмежене структурне свідчення для історичних ідентичностей 00000100/00000101/00000110.
; Хост надає лише адресу пам'яті в RDI для запису. Мова визначає
; розташування голови та решти пари через x86-пара-перше-зсув
; і x86-пара-решта-зсув. Тут створюються структуровані форми STORE/LOAD;
; допуск і кодувальник перетворюють їх на байти лише після перевірки.
;
; Це не дозволяє довільним парам залишати машинний виклик:
; pair-x86-64.lisp обмежує lifetime=native-call та escape=forbidden.

(визначити машина-знизити-запис-пари-64
  (функція (лівий-операнд правий-операнд)
    (список
      (список (як-є mov-r64-imm64) (як-є rax) лівий-операнд)
      (список
        (як-є mov-mem-disp8-r64)
        (як-є rdi)
        x86-пара-перше-зсув
        (як-є rax))
      (список (як-є mov-r64-imm64) (як-є rax) правий-операнд)
      (список
        (як-є mov-mem-disp8-r64)
        (як-є rdi)
        x86-пара-решта-зсув
        (як-є rax)))))

; Історичне внутрішнє ім'я збережено як явне замикання-переадресатор.
; Не підставляти голе позначення функції на місце значення:
; джерело повинно явно викликати функцію й зберігати структуру форм.

(визначити машина-знизити-інструкції-запису-пари-64
  (функція (лівий-операнд правий-операнд)
    (машина-знизити-запис-пари-64 лівий-операнд правий-операнд)))

; Скінченні списки машинних форм поєднуються чинними примітивами D3.
; Не спрямовувати цю межу через відкладені історичні reverse-onto/COND
; четвертого ядра: перевірки й семантичні повноваження залишаються в мові.

(визначити машина-приєднати-форми
  (функція (форми хвіст)
    (за-умовою
      ((атом? форми) хвіст)
      (так (сполучити (перше форми) (машина-приєднати-форми (решта форми) хвіст))))))

; Обмежене машинне свідчення пари має рівно шість інструкцій.
; Його будуємо безпосередньо, не через загальні append/reverse:
; обходи Core4 ще можуть використовувати градуйовані відповіді як COND.
; До перенесення адаптера предикатів вони повинні відмовляти безпечно.
; Це свідчення не залежить від незавершених загальних обходів.

(визначити знизити-складену-пару-до-машинних-форм
  (функція (лівий-операнд правий-операнд)
    (список
      (список (як-є mov-r64-imm64) (як-є rax) лівий-операнд)
      (список
        (як-є mov-mem-disp8-r64)
        (як-є rdi)
        x86-пара-перше-зсув
        (як-є rax))
      (список (як-є mov-r64-imm64) (як-є rax) правий-операнд)
      (список
        (як-є mov-mem-disp8-r64)
        (як-є rdi)
        x86-пара-решта-зсув
        (як-є rax))
      (список
        (як-є mov-r64-mem-disp8)
        (як-є rax)
        (як-є rdi)
        x86-пара-перше-зсув)
      (список (як-є ret)))))

(визначити x86-lower-cons-car-u64-forms знизити-складену-пару-до-машинних-форм)

(визначити машина-знизити-решту-пари-64
  (функція (лівий-операнд правий-операнд)
    (список
      (список (як-є mov-r64-imm64) (як-є rax) лівий-операнд)
      (список
        (як-є mov-mem-disp8-r64)
        (як-є rdi)
        x86-пара-перше-зсув
        (як-є rax))
      (список (як-є mov-r64-imm64) (як-є rax) правий-операнд)
      (список
        (як-є mov-mem-disp8-r64)
        (як-є rdi)
        x86-пара-решта-зсув
        (як-є rax))
      (список
        (як-є mov-r64-mem-disp8)
        (як-є rax)
        (як-є rdi)
        x86-пара-решта-зсув)
      (список (як-є ret)))))

; Обмежений семантичний вхід для свідчення CAR із Vertical Day.
; Канонічні CAR/CDR перевіряють пару і дають мовну помилку Type
; ще до створення машинного запиту. Лише після успішної перевірки
; поля u64 стають машинними формами, проходять допуск
; і надходять у хост, який не визначає семантику.
; Правила позначення й предикати пари тут не дублюються.

(визначити машина-викликати-семантичне-перше-64
  (функція (значення-пари)
    (викликати-допущену-машинну-програму
      (знизити-складену-пару-до-машинних-форм
        (перше значення-пари)
        (решта значення-пари))
      x86-пара-байти-комірки)))


; #3989/#4001: арифметика за точною семантичною адресою D5.
; Операцію визначає D5. Швидкий машинний шлях лише перевіряє
; доведені числові межі й не змінює мовного значення:
;   PLUS/TIMES: два точні цілі операнди в межах u32 — результат у межах u64;
;   DIFFERENCE: два точні цілі в межах u64, лівий операнд >= правого.
; За межами доведеного застосовується точний шлях Lisp/Q.
; Історичні SID8 та людські написання не вибирають операцію.

(визначити машина-поточний-д5-допустимі-входи-32?
  (функція (лівий-операнд правий-операнд)
    (за-умовою
      ((машина-допуск-точне-ціле? лівий-операнд)
       (за-умовою
         ((машина-допуск-ціле-у-включних-межах?
            лівий-операнд 0 4294967295)
          (за-умовою
            ((машина-допуск-точне-ціле? правий-операнд)
             (машина-допуск-ціле-у-включних-межах?
               правий-операнд 0 4294967295))
            (так (як-є ()))))
         (так (як-є ()))))
      (так (як-є ())))))

(визначити машина-поточний-д5-безпечна-різниця-64?
  (функція (лівий-операнд правий-операнд)
    (за-умовою
      ((машина-допуск-точне-ціле? лівий-операнд)
       (за-умовою
         ((машина-допуск-ціле-у-включних-межах?
            лівий-операнд 0 18446744073709551615)
          (за-умовою
            ((машина-допуск-точне-ціле? правий-операнд)
             (за-умовою
               ((машина-допуск-ціле-у-включних-межах?
                  правий-операнд 0 18446744073709551615)
                ; Inclusive order is derived from admitted D5 LESSP + D4 NOT.
                ; Exact D1 controls stay distinct from numeric 0/1 and host truth.
                (за-умовою
                  ((хибне? (менше? лівий-операнд правий-операнд)) так)
                  (так (як-є ()))))
               (так (як-є ()))))
            (так (як-є ()))))
         (так (як-є ()))))
      (так (як-є ())))))

; #4068: перевірка машинного ключа з явною шириною.
; Ширина та упаковані біти — окремі параметри механізму,
; отримані з Rust DomainIdentity; початкові нулі джерела не враховуються.

(визначити машинний-ключ-поточного-домену?
  (функція (ширина-домену біти-домену очікувана-ширина очікувані-біти)
    (за-умовою
      ((тотожне? ширина-домену очікувана-ширина)
       (тотожне? біти-домену очікувані-біти))
      (так (як-є ())))))

(визначити машина-знизити-поточну-двомісну-дію-64
  (функція (ширина-домену біти-домену лівий-операнд правий-операнд)
    (за-умовою
      ((машинний-ключ-поточного-домену? ширина-домену біти-домену 5 10)
       (за-умовою
         ((машина-поточний-д5-допустимі-входи-32? лівий-операнд правий-операнд)
          (машина-знизити-додавання-беззнакових-64-до-форм лівий-операнд правий-операнд))
         (так (як-є exact-d5-fallback-required))))
      ((машинний-ключ-поточного-домену? ширина-домену біти-домену 5 11)
       (за-умовою
         ((машина-поточний-д5-безпечна-різниця-64? лівий-операнд правий-операнд)
          (машина-знизити-віднімання-беззнакових-64-до-форм лівий-операнд правий-операнд))
         (так (як-є exact-d5-fallback-required))))
      ((машинний-ключ-поточного-домену? ширина-домену біти-домену 5 22)
       (за-умовою
         ((машина-поточний-д5-допустимі-входи-32? лівий-операнд правий-операнд)
          (машина-знизити-множення-беззнакових-64-до-форм лівий-операнд правий-операнд))
         (так (як-є exact-d5-fallback-required))))
      (так
       (як-є unsupported-current-domain-binary-u64)))))

(визначити машина-кодувати-поточну-двомісну-дію-64
  (функція (ширина-домену біти-домену лівий-операнд правий-операнд)
    ((функція (машинні-форми)
       (за-умовою
        ((тотожне? машинні-форми (як-є unsupported-current-domain-binary-u64))
         (як-є unsupported-current-domain-binary-u64))
        ((тотожне? машинні-форми (як-є exact-d5-fallback-required))
         (як-є exact-d5-fallback-required))
        (так
         (машина-кодувати-допущену-програму машинні-форми))))
      (машина-знизити-поточну-двомісну-дію-64
                    ширина-домену біти-домену лівий-операнд правий-операнд))))

