(визначити вісь-спроможностей-машини-версія-3
  (список
    (список вісь-спроможностей-число-п'ять вісь-спроможностей-число-вісім (як-є ((integer-zero-test bounded-nonnegative-u64 internal-bit-d1-boundary))))
    (список вісь-спроможностей-число-п'ять вісь-спроможностей-число-десять (як-є ((integer-add bounded-u32-inputs u64-result))))
    (список вісь-спроможностей-число-п'ять вісь-спроможностей-число-одинадцять (як-є ((integer-subtract bounded-u64 no-underflow))))
    (список вісь-спроможностей-число-п'ять вісь-спроможностей-число-двадцять-два (як-є ((integer-multiply bounded-u32-inputs u64-result))))
    (список вісь-спроможностей-число-п'ять вісь-спроможностей-число-двадцять-три (як-є ((integer-quotient bounded-positive-i64 equal-operands-only))))
    (список вісь-спроможностей-число-п'ять вісь-спроможностей-число-двадцять-шість (як-є ((integer-order-less bounded-nonnegative-i63 internal-bit-d1-boundary))))
    (список вісь-спроможностей-число-п'ять вісь-спроможностей-число-двадцять-сім (як-є ((integer-order-greater bounded-nonnegative-i63 internal-bit-d1-boundary))))
    (список вісь-спроможностей-число-шість вісь-спроможностей-число-чотирнадцять (як-є ((integer-increment bounded-u64 no-overflow))))
    (список вісь-спроможностей-число-шість вісь-спроможностей-число-п'ятнадцять (як-є ((integer-decrement bounded-u64 no-underflow))))
    (список вісь-спроможностей-число-три вісь-спроможностей-число-п'ять (як-є ((identity-compare bounded-u64))))
    (список вісь-спроможностей-число-три вісь-спроможностей-число-шість (як-є ((conditional-branch bounded-u64))))
    (список вісь-спроможностей-число-три вісь-спроможностей-число-сім (як-є ((pair-field-store head bounded-u64)
        (pair-field-store tail bounded-u64))))
    (список вісь-спроможностей-число-три вісь-спроможностей-число-чотири (як-є ((pair-field-load head bounded-u64))))
    (список вісь-спроможностей-число-три вісь-спроможностей-число-три (як-є ((pair-field-load tail bounded-u64))))))

(визначити свідки-цілей-спроможності-машини-версія-2
  (як-є
    ((x86-64
       (integer-zero-test bounded-nonnegative-u64 internal-bit-d1-boundary
         (admitted-form cmp-r64-r64)
         (admitted-form sete-r8)
         (admitted-form movzx-r64-r8)
         (lowering машина-знизити-перевірку-нуля-64))
       (integer-add bounded-u32-inputs u64-result
         (admitted-form add-r64-r64)
         (lowering машина-знизити-додавання-беззнакових-64-до-форм))
       (integer-subtract bounded-u64 no-underflow
         (admitted-form sub-r64-r64)
         (lowering машина-знизити-віднімання-беззнакових-64-до-форм))
       (integer-multiply bounded-u32-inputs u64-result
         (admitted-form imul-r64-r64)
         (lowering машина-знизити-множення-беззнакових-64-до-форм))
       (integer-quotient bounded-positive-i64 equal-operands-only
         (admitted-form cqo)
         (admitted-form idiv-r64)
         (lowering машина-знизити-частку-знакових-64-до-форм))
       (integer-order-less bounded-nonnegative-i63 internal-bit-d1-boundary
         (admitted-form cmp-r64-r64)
         (admitted-form setl-r8)
         (admitted-form movzx-r64-r8)
         (lowering машина-знизити-порівняння-порядку-64))
       (integer-order-greater bounded-nonnegative-i63 internal-bit-d1-boundary
         (admitted-form cmp-r64-r64)
         (admitted-form setg-r8)
         (admitted-form movzx-r64-r8)
         (lowering машина-знизити-порівняння-порядку-64))
       (integer-increment bounded-u64 no-overflow
         (admitted-form add-r64-r64)
         (lowering машина-знизити-додавання-беззнакових-64-до-форм))
       (integer-decrement bounded-u64 no-underflow
         (admitted-form sub-r64-r64)
         (lowering машина-знизити-віднімання-беззнакових-64-до-форм))
       (identity-compare bounded-u64
         (admitted-form cmp-r64-r64)
         (lowering машина-знизити-рівність-та-умову-64))
       (conditional-branch bounded-u64
         (admitted-form jnz-rel8)
         (lowering машина-знизити-рівність-та-умову-64))
       (pair-field-store head bounded-u64
         (admitted-form mov-mem-disp8-r64)
         (lowering машина-знизити-запис-пари-64))
       (pair-field-store tail bounded-u64
         (admitted-form mov-mem-disp8-r64)
         (lowering машина-знизити-запис-пари-64))
       (pair-field-load head bounded-u64
         (admitted-form mov-r64-mem-disp8)
         (lowering знизити-складену-пару-до-машинних-форм))
       (pair-field-load tail bounded-u64
         (admitted-form mov-r64-mem-disp8)
         (lowering машина-знизити-решту-пари-64))))))

(визначити статуси-свідків-цілей-машини-версія-1
