(визначити вісь-спроможностей-число-чотири (довжина (як-є (а б в г))))
(визначити вісь-спроможностей-число-п'ять (довжина (як-є (а б в г ґ))))
(визначити вісь-спроможностей-число-шість (довжина (як-є (а б в г ґ д))))
(визначити вісь-спроможностей-число-сім (довжина (як-є (а б в г ґ д е))))
(визначити вісь-спроможностей-число-вісім (довжина (як-є (а б в г ґ д е є))))
(визначити вісь-спроможностей-число-дев'ять (довжина (як-є (а б в г ґ д е є ж))))
