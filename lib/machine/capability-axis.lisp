(визначити вісь-спроможностей-число-дванадцять (довжина (як-є (а б в г ґ д е є ж з и і))))
(визначити вісь-спроможностей-число-тринадцять (довжина (як-є (а б в г ґ д е є ж з и і ї))))
(визначити вісь-спроможностей-число-чотирнадцять (довжина (як-є (а б в г ґ д е є ж з и і ї й))))
(визначити вісь-спроможностей-число-п'ятнадцять (довжина (як-є (а б в г ґ д е є ж з и і ї й к))))
(визначити вісь-спроможностей-число-двадцять-два (додати (помножити вісь-спроможностей-число-два вісь-спроможностей-число-десять) вісь-спроможностей-число-два))
(визначити вісь-спроможностей-число-двадцять-три (додати (помножити вісь-спроможностей-число-два вісь-спроможностей-число-десять) вісь-спроможностей-число-три))
(визначити вісь-спроможностей-число-двадцять-шість (додати (помножити вісь-спроможностей-число-два вісь-спроможностей-число-десять) вісь-спроможностей-число-шість))
