; не можуть засвідчувати можливість цільової машини.
(визначити можливість-правильний-рядок-цілі?
  (функція (рядок)
    (за-умовою
      ((атом? рядок) (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (решта рядок)) (атом? (сполучити (як-є ()) (як-є ()))))
      ((хибне? (порожній? (решта (решта рядок)))) (атом? (сполучити (як-є ()) (як-є ()))))
      ((хибне? (атом? (перше рядок))) (атом? (сполучити (як-є ()) (як-є ()))))
      ((хибне? (атом? (друге рядок))) (атом? (сполучити (як-є ()) (як-є ()))))
      ((тотожне? (друге рядок) (як-є witnessed)) (атом? (як-є ())))
      ((тотожне? (друге рядок) (як-є absent)) (атом? (як-є ())))
      ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ())))))))

(визначити можливість-знайти-рядок
  (функція (ключ-можливості рядки-можливостей)
    (за-умовою
      ((хибне? (атом? ключ-можливості)) (як-є ()))
      ((атом? рядки-можливостей) (як-є ()))
      ((хибне? (можливість-правильний-рядок-цілі?
                  (перше рядки-можливостей)))
       (можливість-знайти-рядок
         ключ-можливості (решта рядки-можливостей)))
      ((тотожне? ключ-можливості (перше (перше рядки-можливостей)))
       (перше рядки-можливостей))
      ((атом? (як-є ()))
       (можливість-знайти-рядок
         ключ-можливості (решта рядки-можливостей))))))

; За відсутності підтвердженого запису повертаємо absent, не PASS.
; Статус unknown означає absent; іменований D4 механізм не
; наділяє машинні записи правом виконання.
(визначити можливість-знайдений-рядок-цілі-статус
  (функція (знайдений-рядок)
    (за-умовою
      ((атом? знайдений-рядок) (як-є absent))
      ((атом? (як-є ())) (друге знайдений-рядок)))))

(визначити статус-свідка-цілі-машини
  (функція (цільова-платформа)
    (можливість-знайдений-рядок-цілі-статус
      (можливість-знайти-рядок
        цільова-платформа статуси-свідків-цілей-машини-версія-1))))
