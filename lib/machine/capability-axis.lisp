; Кожне зіставлення починається з перевірки повного запису.
; Доменною адресою є ПАРА (ширина, біти), а не окремий байт.
; Рядок мусить містити рівно три поля; неправильний хвіст,
; складені координати або не-список можливостей недопустимі.
(визначити можливість-правильний-рядок-домену?
  (функція (рядок)
    (за-умовою
      ((атом? рядок) (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (решта рядок)) (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (решта (решта рядок))) (атом? (сполучити (як-є ()) (як-є ()))))
      ((хибне? (порожній? (решта (решта (решта рядок))))) (атом? (сполучити (як-є ()) (як-є ()))))
      ((хибне? (атом? (перше рядок))) (атом? (сполучити (як-є ()) (як-є ()))))
      ((хибне? (атом? (друге рядок))) (атом? (сполучити (як-є ()) (як-є ()))))
      ; Наявний порожній перелік є допустимим, атомарна мітка — ні.
      ((атом? (третє рядок)) (порожній? (третє рядок)))
      ((атом? (як-є ())) (атом? (як-є ()))))))

; Числові координати — D24+ значення. D3 EQ перевіряє атомарну
; ідентичність, а однакові? структурні дані; обидва не є законом
; арифметичної рівності. Закон спирається на два строгі D5 порядки
; і повертає тільки виконувані результати D1.
(визначити можливість-числові-координати-рівні?
  (функція (ліве праве)
    (за-умовою
      ((менше? ліве праве) (атом? (сполучити (як-є ()) (як-є ()))))
      ((менше? праве ліве) (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (як-є ())) (атом? (як-є ()))))))

; Некоректний запит і пошкоджений рядок ніколи не стають допуском.
; Перед числовим порівнянням перевіряємо форму запису;
; ширина і біти залишаються двома незалежними координатами.
(визначити можливість-знайти-рядок-домену
  (функція (ширина-домену біти-домену рядки-доменів)
    (за-умовою
      ((хибне? (атом? ширина-домену)) (як-є ()))
      ((хибне? (атом? біти-домену)) (як-є ()))
      ((атом? рядки-доменів) (як-є ()))
      ((хибне? (можливість-правильний-рядок-домену?
                  (перше рядки-доменів)))
       (можливість-знайти-рядок-домену
         ширина-домену біти-домену (решта рядки-доменів)))
      ((можливість-числові-координати-рівні? ширина-домену (перше (перше рядки-доменів)))
       (за-умовою
         ((можливість-числові-координати-рівні? біти-домену (друге (перше рядки-доменів)))
          (перше рядки-доменів))
         ((атом? (як-є ()))
          (можливість-знайти-рядок-домену
            ширина-домену біти-домену (решта рядки-доменів)))))
      ((атом? (як-є ()))
       (можливість-знайти-рядок-домену
         ширина-домену біти-домену (решта рядки-доменів))))))

; Публічна проєкція: точний третій елемент або порожній список.
; Не додаємо адрес, не виводимо право виконання зі збігу байтів.
; Іменована D4 функція обробляє результат пошуку без недопущеного
; анонімного виклику функціонального значення.
(визначити можливість-знайдений-рядок-домену-спроможності
  (функція (знайдений-рядок)
    (за-умовою
      ((атом? знайдений-рядок) (як-є ()))
      ((атом? (як-є ())) (третє знайдений-рядок)))))

(визначити спроможності-для-домену
  (функція (ширина-домену біти-домену)
    (можливість-знайдений-рядок-домену-спроможності
      (можливість-знайти-рядок-домену
        ширина-домену біти-домену вісь-спроможностей-машини-версія-3))))

; Запис платформи мусить бути парою (ціль witnessed|absent).
