; Контракт x86-64 представлення пари для першого нативного доказу.
; Господар володіє лише сирим виділенням пам'яті та межею виклику.
; Зниження мовою СЕНС володіє зсувами полів і командами читання/запису,
; що інтерпретують область пам'яті як комірку пари.
;
; Це навмисно ще не загальна купа чи GC ABI. Комірка існує лише
; на час одного native-call-u64-raw і не має залишати цей виклик.

(визначити машинна-пара-число-шістдесят-чотири
  (помножити число-вісім число-вісім))

(визначити машинна-пара-байти-комірки число-шістнадцять)
(визначити машинна-пара-зсув-першого число-нуль)
(визначити машинна-пара-зсув-решти число-вісім)

(визначити машинна-пара-розклад
  (список
    (як-є machine-pair-layout-1)
    (список (як-є target) (як-є x86-64))
    (список (як-є word-bits) машинна-пара-число-шістдесят-чотири)
    (список (як-є cell-bytes) число-шістнадцять)
    (список
      (як-є fields)
      (список
        (список
          (як-є перше)
          (список (як-є offset-bytes) число-нуль)
          (список (як-є width-bits) машинна-пара-число-шістдесят-чотири)
        )
        (список
          (як-є решта)
          (список (як-є offset-bytes) число-вісім)
          (список (як-є width-bits) машинна-пара-число-шістдесят-чотири)
        )
      )
    )
    (список (як-є arena-argument-register) (як-є rdi))
    (список (як-є allocation) (як-є raw-host-arena))
    (список (як-є lifetime) (як-є native-call))
    (список (як-є escape) (як-є forbidden))
  ))



