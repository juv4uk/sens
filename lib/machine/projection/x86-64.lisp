; #4347 — явна проєкція канонічних машинних ефектів на конкретну ціль.
; Ідентичність ефекту не залежить від процесорної архітектури.
; Тільки цей модуль вибирає фізичні регістри та допустимі форми команд.
; Відмова проєкції відрізняється від відмови під час побудови ефекту.

; Одна побудова чотирьох машинних форм для трьох уже перевірених
; ефектів. Команда — цитовані дані після вибору точного SENS-предиката,
; а не новий машинний opcode чи перемикач семантики у хості.
(визначити проєктувати-двійковий-ефект-на-х86
  (функція (ефект команда)
    (нехай
      ((лівий (перше (решта ефект)))
       (правий (перше (решта (решта ефект)))))
      (список
        (список (як-є mov-r64-imm64) (як-є rax) лівий)
        (список (як-є mov-r64-imm64) (як-є rcx) правий)
        (список команда (як-є rax) (як-є rcx))
        (список (як-є ret))))))

(визначити проєктувати-машинний-ефект-на-х86
  (функція (ефект)
    (за-умовою
      ((машинний-ефект-форма-додавання-64? ефект)
       (проєктувати-двійковий-ефект-на-х86
         ефект (як-є add-r64-r64)))
      ((машинний-ефект-форма-віднімання-64? ефект)
       (проєктувати-двійковий-ефект-на-х86
         ефект (як-є sub-r64-r64)))
      ((машинний-ефект-форма-множення-64? ефект)
       (проєктувати-двійковий-ефект-на-х86
         ефект (як-є imul-r64-r64)))
      ((атом? ()) (як-є x86-projection-rejected)))))

(визначити закодувати-машинний-ефект-на-х86
  (функція (ефект)
    (нехай ((форми (проєктувати-машинний-ефект-на-х86 ефект)))
      (за-умовою
        ((атом? форми)
         (як-є x86-projection-rejected))
        ((атом? ())
         (машина-кодувати-допущену-програму форми))))))

