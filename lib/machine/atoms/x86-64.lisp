        ((атом? ())
         ((функція (типізоване-безпосереднє) (за-умовою
             ((x86-machine-rejected? типізоване-безпосереднє) типізоване-безпосереднє)
             ((атом? ())
              (список (як-є mov-r64-imm64)
                    (x86-gpr64-value типізований-регістр)
                    (x86-u64-imm-value типізоване-безпосереднє))))) (x86-as-u64-imm безпосереднє))))) (x86-as-gpr64 регістр))))

