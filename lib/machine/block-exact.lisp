; Машинний блок є впорядкованим списком структурованих форм.
; Він не визначає набору команд, машинних кодів або дозволу на виконання.
; Створення, додавання та поєднання не змінюють самі форми.
; Семантика шести операцій збережена від історичного оригіналу.
; Тут немає старих викличних кодів або назв для сумісності.

(визначити машинний-блок
  (функція (форми)
    форми))

(визначити порожній-машинний-блок
  (функція ()
    (як-є ())))

(визначити блок-з-однієї-форми
  (функція (форма)
    (сполучити форма (як-є ()))))

(визначити додати-форму-до-блоку
  (функція (блок форма)
    (приєднати блок (сполучити форма (як-є ())))))

(визначити поєднати-машинні-блоки
  (функція (лівий-блок правий-блок)
    (приєднати лівий-блок правий-блок)))

(визначити форми-машинного-блоку
  (функція (блок)
    блок))
