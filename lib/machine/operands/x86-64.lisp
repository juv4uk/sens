; Структура mem64-disp8 має рівно три поля: мітку, основу й зсув.
; Порожній хвіст і зайві поля відхиляємо до перевірки типізованих
; операндів. Умовний перехід використовує точні відповіді Д1.
(визначити машинна-память-64-зсув-8?
  (функція (операнд)
    (за-умовою
      ((атом? операнд) ні)
      ((хибне? (тотожне? (перше операнд) (як-є mem64-disp8))) ні)
      ((атом? (решта операнд)) ні)
      ((атом? (решта (решта операнд))) ні)
      ((хибне? (порожній? (решта (решта (решта операнд))))) ні)
      (так
       (та (машинний-регістр-64? (друге операнд))
           (машинний-зсув-8? (третє операнд)))))))

(визначити машинна-память-64-зсув-8
  (функція (основа зсув)
    (нехай ((типізована-основа (типізувати-машинний-регістр-64 основа)))
      (за-умовою
        ((машинний-операнд-відхилено? типізована-основа) типізована-основа)
        (так
         (нехай ((типізований-зсув (типізувати-машинний-зсув-8 зсув)))
           (за-умовою
             ((машинний-операнд-відхилено? типізований-зсув) типізований-зсув)
             (так
              (список (як-є mem64-disp8)
                    типізована-основа
                    типізований-зсув)))))))))

(визначити типізувати-машинну-память-64-зсув-8
  (функція (операнд)
    (за-умовою
      ((машинний-операнд-відхилено? операнд) операнд)
      ((машинна-память-64-зсув-8? операнд) операнд)
      (так (відхилення-машинного-операнда (як-є mem64-disp8) операнд)))))

(визначити основа-машинної-памяті-64
