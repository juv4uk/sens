; Операнд загального регістра на 32 біти є видом того самого фізичного
; регістра з канонічною 64-бітною назвою. Кодування регістрів уже належить
; машинному кодеру, а ширину визначає форма інструкції.
; Цей вид не створює другої таблиці адрес машинних регістрів.
(визначити назва-машинного-регістра-32?
  (функція (назва)
    (назва-машинного-регістра-64? назва)))

(визначити машинний-регістр-32?
  (функція (операнд)
    (за-умовою
      
      ((атом? операнд)  (як-є ()))
      ((тотожне? (перше операнд) (як-є gpr32))
       (за-умовою
         
         ((атом? (решта операнд))  (як-є ()))
         ((тотожне? (решта (решта операнд)) (як-є ()))
          (назва-машинного-регістра-32? (друге операнд)))
         ))
      )))

