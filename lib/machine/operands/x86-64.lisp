; Типізовані операнди машинної архітектури x86-64, описані мовою СЕНС.
; Цей модуль визначає форму операнда, але не допуск інструкцій і не кодування.
; Відповідність регістрів повторно використовує наявний машинний кодер.
; Другої таблиці загальних регістрів тут не створюємо.
; Коректна форма операнда не доводить, що інструкцію дозволено виконати.
; Безумовні розгалуження виконують «так», а фіксовану хибу — «ні».
; Структуру операнда перевіряємо явно, а не через ATOM порожнього списку.

(визначити відхилення-машинного-операнда
  (функція (очікуване фактичне)
    (список (як-є rejected) (як-є machine-operand) очікуване фактичне)))

(визначити машинний-операнд-відхилено?
  (функція (значення)
    (за-умовою
      ((атом? значення) (тотожне? (як-є ()) (як-є rejected)))
      (так (тотожне? (перше значення) (як-є rejected))))))

(визначити назва-машинного-регістра-8?
  (функція (назва)
    (за-умовою
      ((символ? назва)
       (значення-у-списку?
         назва
         (як-є
           (al cl dl bl spl bpl sil dil
               r8b r9b r10b r11b r12b r13b r14b r15b))))
      )))

(визначити назва-машинного-регістра-64?
  (функція (назва)
    (за-умовою
      ((символ? назва)
       (та
         (хибне? (тотожне? (машина-код-регістра назва) (як-є ())))
         (хибне? (назва-машинного-регістра-8? назва))))
      )))

(визначити машинний-регістр-8?
  (функція (операнд)
    (за-умовою
      
      ((атом? операнд)  (як-є ()))
      ((тотожне? (перше операнд) (як-є gpr8))
       (за-умовою
         
         ((атом? (решта операнд))  (як-є ()))
         ((тотожне? (решта (решта операнд)) (як-є ()))
          (назва-машинного-регістра-8? (друге операнд)))
         ))
      )))

(визначити машинний-регістр-8
  (функція (назва)
    (за-умовою
      ((назва-машинного-регістра-8? назва) (список (як-є gpr8) назва))
      (так (відхилення-машинного-операнда (як-є gpr8) назва)))))

(визначити типізувати-машинний-регістр-8
  (функція (операнд)
    (за-умовою
      ((машинний-операнд-відхилено? операнд) операнд)
      ((машинний-регістр-8? операнд) операнд)
      (так (машинний-регістр-8 операнд)))))

(визначити значення-машинного-регістра-8
  (функція (операнд)
    (друге операнд)))

