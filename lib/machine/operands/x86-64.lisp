    (друге операнд)))

; Розпізнавання точного цілого належить мові, не новому примітиву господаря.
; Фізичне представлення чисел не змінює математичної тотожності.
; Після скорочення точне раціональне число є цілим тоді й тільки тоді,
; коли його знаменник дорівнює одиниці.
(визначити знаменник-машинного-числа-одиниця?
  (функція (текст)
    (за-умовою
      ((рядок-порожній? текст) (як-є ()))
      ((тотожне? (рядок-перший текст) "/")
       (нехай ((решта-тексту (рядок-решта текст)))
         (за-умовою
           ((рядок-порожній? решта-тексту) (як-є ()))
           ((тотожне? (рядок-перший решта-тексту) "1")
            (за-умовою
              ((рядок-порожній? (рядок-решта решта-тексту)) так)
              (так (як-є ()))))
           (так (як-є ())))))
      (так (знаменник-машинного-числа-одиниця? (рядок-решта текст))))))

(визначити машинний-операнд-точне-ціле?
  (функція (значення)
    (нехай ((текстове-подання (значення-у-текст значення)))
      (за-умовою
        ((рядок-префікс? "#q2:" текстове-подання) (знаменник-машинного-числа-одиниця? текстове-подання))
        (так (як-є ()))))))

(визначити машинний-операнд-в-межах?
  (функція (значення нижня-межа верхня-межа)
    ; Числові результати порівняння не можна неявно вважати логічною хибою
    ; за їхнім нульовим значенням: це допускало переповнення операндів.
    ; Допустимість вимагає явного очікуваного домену результату
    ; та структурного предиката для умовного вибору.
    (за-умовою
      ((не-менше? значення нижня-межа) 
        (за-умовою
          ((не-більше? значення верхня-межа)  так)
          ))
      )))

(визначити машинне-безпосереднє-беззнакове-64?
  (функція (операнд)
    (за-умовою
      
      ((атом? операнд)  (як-є ()))
      ((тотожне? (перше операнд) (як-є u64-imm))
       (за-умовою
         
         ((атом? (решта операнд))  (як-є ()))
         ((тотожне? (решта (решта операнд)) (як-є ()))
          (нехай ((значення (друге операнд)))
            (за-умовою
              ((машинний-операнд-точне-ціле? значення)
               (машинний-операнд-в-межах? значення 0 18446744073709551615))
              )))
         ))
      )))

(визначити машинне-безпосереднє-беззнакове-64
  (функція (значення)
    (за-умовою
      ((машинний-операнд-точне-ціле? значення)
       (за-умовою
         ((машинний-операнд-в-межах? значення 0 18446744073709551615)
          (список (як-є u64-imm) значення))
         (так (відхилення-машинного-операнда (як-є u64-imm) значення))))
      (так (відхилення-машинного-операнда (як-є u64-imm) значення)))))

