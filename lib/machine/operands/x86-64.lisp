; Векторні регістри становлять окремий клас, хоча кодування використовує
; спільний простір чотирибітних полів. Допустимість визначає наявний
; кодер векторних регістрів, а не нова таблиця в цьому модулі.
(визначити назва-машинного-векторного-регістра?
  (функція (назва)
    (за-умовою
      ((символ? назва)
       (за-умовою
         ((тотожне? (машина-код-векторного-регістра назва) (як-є ()))
          ні)
         ((тотожне? (машина-код-векторного-регістра назва) (машина-код-векторного-регістра назва))
          так)
         (так ні)))
      (так ні))))
(визначити машинний-векторний-регістр?
  (функція (операнд)
    (за-умовою
      
      ((атом? операнд)  (як-є ()))
      ((тотожне? (перше операнд) (як-є xmm))
       (за-умовою
         
         ((атом? (решта операнд))  (як-є ()))
         ((тотожне? (решта (решта операнд)) (як-є ()))
          (назва-машинного-векторного-регістра? (друге операнд)))
         ))
      )))

(визначити машинний-векторний-регістр
