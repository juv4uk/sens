; СЕНС: хвіст після останнього складеного елемента.
; Один прохід, один вказівник на останній кандидат, жодного сполучити.
; Повертається наявний суфікс без копіювання; порожній елемент є атомом.
; Значення встановлює Д3/Д5 СЕНС, а не хост або фізичний кодек.

(визначити хвіст-після-останнього-складеного-крок
 (функція (залишок кандидат)
  (за-умовою
   ((атом? залишок) кандидат)
   ((атом? (перше залишок))
    (хвіст-після-останнього-складеного-крок (решта залишок) кандидат))
   (так
    (хвіст-після-останнього-складеного-крок
     (решта залишок) (решта залишок))))))

(визначити хвіст-після-останнього-складеного
 (функція (елементи)
  (хвіст-після-останнього-складеного-крок елементи елементи)))

; Справжня рекурсивна перевірка дерева, без позамовного оракула.
(визначити дерева-останнього-складеного-однакові?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((дерева-останнього-складеного-однакові?
     (перше ліве) (перше праве))
    (дерева-останнього-складеного-однакові?
     (решта ліве) (решта праве)))
   (так ні))))

(визначити перевірити-хвіст-останнього-складеного
 (функція (вхід очікуване)
  (за-умовою
   ((дерева-останнього-складеного-однакові?
     (хвіст-після-останнього-складеного вхід) очікуване) так)
   (так (перше (як-є ()))))))

; Позитиви: порожній, атом і список без складених елементів.
(перевірити-хвіст-останнього-складеного (як-є ()) (як-є ()))
(перевірити-хвіст-останнього-складеного (як-є атом?) (як-є атом?))
(перевірити-хвіст-останнього-складеного
 (список (як-є атом?) (як-є решта))
 (список (як-є атом?) (як-є решта)))

; Останній складений елемент зліва, посередині, справа.
(перевірити-хвіст-останнього-складеного
 (список (список (як-є атом?)) (як-є решта) (як-є сполучити))
 (список (як-є решта) (як-є сполучити)))
(перевірити-хвіст-останнього-складеного
 (список (як-є атом?) (список (як-є решта)) (як-є сполучити))
 (список (як-є сполучити)))
(перевірити-хвіст-останнього-складеного
 (список (як-є атом?) (список (як-є решта)))
 (як-є ()))

; Два складені елементи: перший не є остаточною межею.
(перевірити-хвіст-останнього-складеного
 (список (список (як-є атом?)) (як-є решта)
         (список (список (як-є сполучити)))
         (як-є функція) (як-є визначити))
 (список (як-є функція) (як-є визначити)))
(перевірити-хвіст-останнього-складеного
 (список (список (як-є атом?)) (список (як-є решта)))
 (як-є ()))

; Порожній елемент є атомом, а не складеною структурою.
(перевірити-хвіст-останнього-складеного
 (список (список (як-є атом?)) (як-є ()) (як-є решта))
 (список (як-є ()) (як-є решта)))

; Неправильний атомний хвіст повертається без обгортки у нову пару.
(перевірити-хвіст-останнього-складеного
 (сполучити (список (як-є атом?)) (як-є решта))
 (як-є решта))

; Негативи: заборонено залишати префікс і втрачати правий суфікс.
(за-умовою
 ((хибне? (дерева-останнього-складеного-однакові?
   (хвіст-після-останнього-складеного
    (список (як-є атом?) (список (як-є решта)) (як-є сполучити)))
   (список (як-є атом?) (список (як-є решта)) (як-є сполучити)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (дерева-останнього-складеного-однакові?
   (хвіст-після-останнього-складеного
    (список (список (як-є атом?)) (як-є решта)))
   (як-є ()))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
