; Д11: чистий одномісний СЕНС-профіль Кложур зшити.
; Історичне джерело: Clojure juxt; довільна арність/вектор не реалізовані.
; Аргумент — правильний список першокласних одномісних функцій.
; Результат — правильний список результатів у вихідному порядку.
; Семантика виклику належить СЕНС, а не сторонньому runtime чи Д11 opcode.
; Не зв'язуємо Д8 ЗНАЧЕННЯ як параметр і не ставимо анонімну форму в голову.

(визначити викликати-зіставлену-функцію
  (функція (поточна-функція вхід)
    (поточна-функція вхід)))

; Спочатку перевіряємо ВЕСЬ D3-список функцій, не викликаючи жодної.
; D1:ні як елемент списку дозволено структурно (його викличність окрема),
; але D1:ні як хвіст НЕ є D3:(). Неправильний хвіст -> D3 CAR Type.
; Повертаємо первісний об'єкт, щоб не копіювати список замикань.
(визначити підтвердити-набір-одномісних-функцій
  (функція (залишок початковий)
    (за-умовою
      ((атом? залишок)
       (за-умовою
         ((тотожне? залишок (як-є ())) початковий)
         (так (перше залишок))))
      (так
       (підтвердити-набір-одномісних-функцій
         (решта залишок) початковий)))))

; Ядро працює ЛИШЕ з уже перевіреним списком.
(визначити застосувати-набір-одномісних-функцій-ядро
  (функція (функції вхід)
    (за-умовою
      ((порожній? функції) (як-є ()))
      ((порожній? (як-є ()))
       (сполучити
         (викликати-зіставлену-функцію (перше функції) вхід)
         (застосувати-набір-одномісних-функцій-ядро
           (решта функції) вхід))))))

; Публічний виклик завжди підтверджує повну структуру до першого callback.
(визначити застосувати-набір-одномісних-функцій
  (функція (функції вхід)
    (застосувати-набір-одномісних-функцій-ядро
      (підтвердити-набір-одномісних-функцій функції функції)
      вхід)))

; Конструктор відхиляє неправильний хвіст у момент створення замикання.
; Після цього кожен виклик замикання повторної перевірки не потребує.
(визначити побудувати-зіставлення-після-перевірки
  (функція (перевірені-функції)
    (функція (вхід)
      (застосувати-набір-одномісних-функцій-ядро
        перевірені-функції вхід))))

(визначити побудувати-зіставлення-функцій
  (функція (функції)
    (побудувати-зіставлення-після-перевірки
      (підтвердити-набір-одномісних-функцій функції функції))))

; Д1-свідки: порожній перелік, позитиви й негативи першокласних Д3/Д4.
(за-умовою
  ((порожній?
     (застосувати-набір-одномісних-функцій (як-є ()) (як-є ()))) (порожній? (як-є ())))
  ((порожній? (як-є ())) (перше (як-є ()))))

(за-умовою
  ((перше
     (застосувати-набір-одномісних-функцій
       (список атом? порожній?) (як-є ()))) (порожній? (як-є ())))
  ((порожній? (як-є ())) (перше (як-є ()))))

(за-умовою
  ((друге
     (застосувати-набір-одномісних-функцій
       (список атом? порожній?) (як-є ()))) (порожній? (як-є ())))
  ((порожній? (як-є ())) (перше (як-є ()))))

(за-умовою
  ((хибне?
     (перше
       (застосувати-набір-одномісних-функцій
         (список атом? порожній?) (список (як-є атом?))))) (порожній? (як-є ())))
  ((порожній? (як-є ())) (перше (як-є ()))))

(за-умовою
  ((хибне?
     (друге
       (застосувати-набір-одномісних-функцій
         (список атом? порожній?) (список (як-є атом?))))) (порожній? (як-є ())))
  ((порожній? (як-є ())) (перше (як-є ()))))

(атом? (як-є ()))
