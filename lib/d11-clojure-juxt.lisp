; D11: чистий одномісний SENS-профіль Clojure juxt.
; Історичне джерело: https://clojure.github.io/clojure/branch-master/clojure.core-api.html
; Оригінальний juxt приймає довільну арність і повертає vector.
; Тут лише правильний список чистих одномісних замикань і одне значення.
; Повертається proper-list виходів у порядку функцій, включно з ().
; SENS визначає семантику; це не машинний opcode D11.

(визначити застосувати-набір-одномісних-функцій
  (функція (функції значення)
    (за-умовою
      ((атом? функції) (як-є ()))
      ((атом? (як-є ()))
       ((функція (поточна-функція)
          (сполучити
            (поточна-функція значення)
            (застосувати-набір-одномісних-функцій
              (решта функції) значення)))
        (перше функції))))))

; Повертається замикання, що зберігає список функцій для наступного виклику.
(визначити побудувати-зіставлення-функцій
  (функція (функції)
    (функція (значення)
      (застосувати-набір-одномісних-функцій функції значення))))
