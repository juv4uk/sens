; Обернене рекурсивне групування правильного списку трійками через закони Д3 і Д4.
; Передумова: вхід має скінченну довжину, кратну трьом; дефектний хвіст
; не видаємо за трійку. На образі групування розгортання повертає вихідні атоми.
; Семантика і Д1-свідки живуть у СЕНС; Зіг лише фізично пакує слова в Т5М.

(визначити згрупувати-трійками
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (список (перше елементи) (друге елементи) (третє елементи))
         (згрупувати-трійками (решта (решта (решта елементи)))))))))

(визначити розгорнути-трійки
  (функція (групи)
    (за-умовою
      ((атом? групи) (як-є ()))
      ((атом? (як-є ()))
       (сполучити (перше (перше групи))
         (сполучити (друге (перше групи))
           (сполучити (третє (перше групи))
             (розгорнути-трійки (решта групи)))))))))

(визначити вхідні-елементи
  (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?) (як-є за-умовою) (як-є як-є)))
(визначити групи-трійок (згрупувати-трійками вхідні-елементи))
(визначити розгорнуті-елементи (розгорнути-трійки групи-трійок))

; 20 змістових Д1-свідків: нульовий і одиничний і подвійний випадки,
; позиції та структури усіх трійок; два адресні негативи.
; Хибна гілка навмисно аварійна: не маскувати РЕД під "успішний" процес.
(за-умовою
  ((тотожне? (перше розгорнуті-елементи) (як-є атом?))
    (за-умовою
      ((тотожне? (перше (решта розгорнуті-елементи)) (як-є решта))
        (за-умовою
          ((тотожне? (перше (решта (решта розгорнуті-елементи))) (як-є сполучити))
            (за-умовою
              ((тотожне? (перше (решта (решта (решта розгорнуті-елементи)))) (як-є тотожне?))
                (за-умовою
                  ((тотожне? (перше (решта (решта (решта (решта розгорнуті-елементи))))) (як-є за-умовою))
                    (за-умовою
                      ((тотожне? (перше (решта (решта (решта (решта (решта розгорнуті-елементи)))))) (як-є як-є))
                        (за-умовою
                          ((тотожне? (перше (перше групи-трійок)) (як-є атом?))
                            (за-умовою
                              ((тотожне? (перше (решта (перше групи-трійок))) (як-є решта))
                                (за-умовою
                                  ((тотожне? (перше (решта (решта (перше групи-трійок)))) (як-є сполучити))
                                    (за-умовою
                                      ((тотожне? (перше (перше (решта групи-трійок))) (як-є тотожне?))
                                        (за-умовою
                                          ((тотожне? (перше (решта (перше (решта групи-трійок)))) (як-є за-умовою))
                                            (за-умовою
                                              ((тотожне? (перше (решта (решта (перше (решта групи-трійок))))) (як-є як-є))
                                                (за-умовою
                                                  ((атом? (решта (решта (решта (решта (решта (решта розгорнуті-елементи)))))))
                                                    (за-умовою
                                                      ((атом? (решта (решта групи-трійок)))
                                                        (за-умовою
                                                          ((атом? (згрупувати-трійками (як-є ())))
                                                            (за-умовою
                                                              ((атом? (розгорнути-трійки (як-є ())))
                                                                (за-умовою
                                                                  ((тотожне? (перше (решта (решта (розгорнути-трійки (згрупувати-трійками (список (як-є атом?) (як-є решта) (як-є сполучити))))))) (як-є сполучити))
                                                                    (за-умовою
                                                                      ((атом? (решта (решта (решта (розгорнути-трійки (згрупувати-трійками (список (як-є атом?) (як-є решта) (як-є сполучити))))))))
                                                                        (за-умовою
                                                                          ((хибне? (тотожне? (перше розгорнуті-елементи) (як-є решта)))
                                                                            (за-умовою
                                                                              ((хибне? (тотожне? (перше (перше (решта групи-трійок))) (як-є атом?)))
                                                                                (атом? (як-є ())))
                                                                              ((атом? (як-є ())) (перше (як-є ())))))
                                                                          ((атом? (як-є ())) (перше (як-є ())))))
                                                                      ((атом? (як-є ())) (перше (як-є ())))))
                                                                  ((атом? (як-є ())) (перше (як-є ())))))
                                                              ((атом? (як-є ())) (перше (як-є ())))))
                                                          ((атом? (як-є ())) (перше (як-є ())))))
                                                      ((атом? (як-є ())) (перше (як-є ())))))
                                                  ((атом? (як-є ())) (перше (як-є ())))))
                                              ((атом? (як-є ())) (перше (як-є ())))))
                                          ((атом? (як-є ())) (перше (як-є ())))))
                                      ((атом? (як-є ())) (перше (як-є ())))))
                                  ((атом? (як-є ())) (перше (як-є ())))))
                              ((атом? (як-є ())) (перше (як-є ())))))
                          ((атом? (як-є ())) (перше (як-є ())))))
                      ((атом? (як-є ())) (перше (як-є ())))))
                  ((атом? (як-є ())) (перше (як-є ())))))
              ((атом? (як-є ())) (перше (як-є ())))))
          ((атом? (як-є ())) (перше (як-є ())))))
      ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
