; Суфікс власного списку від останнього (правого) входження точного атома.
; Закон: для порожнього списку NIL; якщо у хвості знайдено суфікс,
; повертаємо саме його; інакше, якщо голова дорівнює шуканому,
; повертаємо поточний список; якщо збігів нема, NIL.
; Відповідь є точним збереженим підсписком; ні одного нового opcode.
(визначити суфікс-від-останнього
  (функція (елементи шукане)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (як-є ()))
       (нехай ((пізніший
                  (суфікс-від-останнього (решта елементи) шукане)))
         (за-умовою
           ((хибне? (атом? пізніший)) пізніший)
           ((тотожне? (перше елементи) шукане) елементи)
           ((атом? (як-є ())) (як-є ()))))))))

(визначити останній-суфікс
  (суфікс-від-останнього
    (список (як-є атом?) (як-є решта) (як-є атом?)
            (як-є сполучити) (як-є атом?) (як-є тотожне?) (як-є решта))
    (як-є атом?)))
(визначити остання-одиниця
  (суфікс-від-останнього
    (список (як-є сполучити) (як-є атом?) (як-є тотожне?) (як-є сполучити))
    (як-є сполучити)))
(визначити перший-суфікс
  (суфікс-від-останнього
    (список (як-є атом?) (як-є решта) (як-є сполучити)) (як-є атом?)))
(визначити відсутній-суфікс
  (суфікс-від-останнього
    (список (як-є решта) (як-є сполучити)) (як-є атом?)))

; Всі перевірки обчислює сам SENS: 17 позитивів/негативів,
; включно із трьома повтореннями, останнім збігом, NIL і одним елементом.
; Будь-яка невдача переходить до реального недозволеного CAR NIL.
(за-умовою
  ((тотожне? (перше останній-суфікс) (як-є атом?))
   (за-умовою
     ((тотожне? (друге останній-суфікс) (як-є тотожне?))
      (за-умовою
        ((тотожне? (третє останній-суфікс) (як-є решта))
         (за-умовою
           ((порожній? (решта (решта (решта останній-суфікс))))
            (за-умовою
              ((хибне? (тотожне? (друге останній-суфікс) (як-є решта)))
               (за-умовою
                 ((тотожне? (перше остання-одиниця) (як-є сполучити))
                  (за-умовою
                    ((порожній? (решта остання-одиниця))
                     (за-умовою
                       ((тотожне? (перше перший-суфікс) (як-є атом?))
                        (за-умовою
                          ((тотожне? (друге перший-суфікс) (як-є решта))
                           (за-умовою
                             ((тотожне? (третє перший-суфікс) (як-є сполучити))
                              (за-умовою
                                ((порожній? (решта (решта (решта перший-суфікс))))
                                 (за-умовою
                                   ((порожній? відсутній-суфікс)
                                    (за-умовою
                                      ((порожній? (суфікс-від-останнього (як-є ()) (як-є атом?)))
                                       (за-умовою
                                         ((тотожне? (перше (суфікс-від-останнього (список (як-є атом?)) (як-є атом?))) (як-є атом?))
                                          (за-умовою
                                            ((порожній? (решта (суфікс-від-останнього (список (як-є атом?)) (як-є атом?))))
                                             (за-умовою
                                               ((порожній? (суфікс-від-останнього (список (як-є решта)) (як-є атом?)))
                                                (за-умовою
                                                  ((хибне? (тотожне? (перше останній-суфікс) (як-є сполучити)))
                                                   (атом? (як-є ())))
                                                  ((атом? (як-є ())) (перше (як-є ())))))
                                               ((атом? (як-є ())) (перше (як-є ())))))
                                            ((атом? (як-є ())) (перше (як-є ())))))
                                         ((атом? (як-є ())) (перше (як-є ())))))
                                      ((атом? (як-є ())) (перше (як-є ())))))
                                   ((атом? (як-є ())) (перше (як-є ())))))
                                ((атом? (як-є ())) (перше (як-є ())))))
                             ((атом? (як-є ())) (перше (як-є ())))))
                          ((атом? (як-є ())) (перше (як-є ())))))
                       ((атом? (як-є ())) (перше (як-є ())))))
                    ((атом? (як-є ())) (перше (як-є ())))))
                 ((атом? (як-є ())) (перше (як-є ())))))
              ((атом? (як-є ())) (перше (як-є ())))))
           ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
