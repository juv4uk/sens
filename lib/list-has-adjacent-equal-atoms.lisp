; СЕНС: чи існують два сусідні тотожні атоми у правильному списку?
; Закон: порожній та одноелементний список -> D1:ні; несусідні
; повтори не зараховуються. Складені елементи не подаються до D3 EQ.
; Тільки чинні D3/D4/D5, D7 — дані, Zig/T5M — фізичний транспорт.

(визначити є-сусідні-однакові-атоми?
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) ні)
      ((порожній? (решта елементи)) ні)
      ((хибне? (атом? (перше елементи)))
       (є-сусідні-однакові-атоми? (решта елементи)))
      ((хибне? (атом? (друге елементи)))
       (є-сусідні-однакові-атоми? (решта елементи)))
      ((тотожне? (перше елементи) (друге елементи)) так)
      (так (є-сусідні-однакові-атоми? (решта елементи))))))

; Позитиви: початок та середина. Негативи: розділені повтори,
; порожній, один елемент і вкладена пара поруч з атомом.
; Зламаний закон має падати у самому SENS, а не у Python/JSON.
(за-умовою
  ((є-сусідні-однакові-атоми?
     (список (як-є атом?) (як-є атом?) (як-є решта)))
   (атом? (як-є ())))
  (так (перше (як-є ()))))

(за-умовою
  ((є-сусідні-однакові-атоми?
     (список (як-є решта) (як-є атом?) (як-є атом?)))
   (атом? (як-є ())))
  (так (перше (як-є ()))))

(за-умовою
  ((хибне? (є-сусідні-однакові-атоми?
              (список (як-є атом?) (як-є решта) (як-є атом?))))
   (атом? (як-є ())))
  (так (перше (як-є ()))))

(за-умовою
  ((хибне? (є-сусідні-однакові-атоми? (як-є ())))
   (атом? (як-є ())))
  (так (перше (як-є ()))))

(за-умовою
  ((хибне? (є-сусідні-однакові-атоми?
              (список (як-є атом?))))
   (атом? (як-є ())))
  (так (перше (як-є ()))))

(за-умовою
  ((хибне? (є-сусідні-однакові-атоми?
              (список (список (як-є атом?)) (як-є атом?))))
   (атом? (як-є ())))
  (так (перше (як-є ()))))
