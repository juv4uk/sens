; Д11: Scheme SRFI-1 count для одного й двох скінченних списків.
; Джерело: https://srfi.schemers.org/srfi-1/srfi-1.html
; Підрахунок за предикатом виконує SENS зліва направо.
; Результат — унарний список канонічних Д1 так, НЕ число D24+.
; Двоспискова версія зупиняється на коротшому списку.
; Порожній результат є структурним (), а не предикатом Д1 ні.
; Ця адаптація відрізняється від числових COUNT та COUNT-IF;
; нових машинних координат, host арифметики й прихованих чисел немає.

(визначити порахувати-за-умовою-унарно
  (функція (умова елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((умова (перше елементи))
       (сполучити
         так
         (порахувати-за-умовою-унарно
           умова (решта елементи))))
      (так
       (порахувати-за-умовою-унарно
         умова (решта елементи))))))

(визначити порахувати-пари-за-умовою-унарно
  (функція (умова лівий правий)
    (за-умовою
      ((порожній? лівий) (як-є ()))
      ((порожній? правий) (як-є ()))
      ((умова (перше лівий) (перше правий))
       (сполучити
         так
         (порахувати-пари-за-умовою-унарно
           умова (решта лівий) (решта правий))))
      (так
       (порахувати-пари-за-умовою-унарно
         умова (решта лівий) (решта правий))))))
