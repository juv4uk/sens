; D11: скінченний правильний список і унарний підрахунок мовою СЕНС.
; За мотивами SRFI-1 count, але SENS тут навмисне вимагає скінченні
; правильні списки та повертає не число, а список канонічних D1 так.
; Д3:000 () — єдиний законний кінець; D1 ні не є порожнім списком.
; Для двох списків предикат викликається тільки до кінця коротшого,
; але повна правильність ОБОХ входів перевіряється до виклику предиката.
; Жодних нових кодів D11 або хостової арифметики.

; D3 ПОРОЖНІЙ? точно визначає кінець до перевірки АТОМ?.
; D1 ні лишається допустимим елементом, але не термінатором списку.
(визначити правильний-список-для-підрахунку?
  (функція (елементи)
    (за-умовою
      ; Єдиний структурний кінець — D3:(); D1:ні не дорівнює йому.
      ((порожній? елементи) так)
      ; Будь-який інший атом, зокрема неправильний хвіст, не є списком.
      ((атом? елементи) ні)
      (так
       (правильний-список-для-підрахунку?
         (решта елементи))))))

; Внутрішній підрахунок отримує лише повністю перевірений список.
(визначити порахувати-за-умовою-унарно-ядро
  (функція (умова елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((умова (перше елементи))
       (сполучити
         так
         (порахувати-за-умовою-унарно-ядро
           умова (решта елементи))))
      (так
       (порахувати-за-умовою-унарно-ядро
         умова (решта елементи))))))

(визначити порахувати-за-умовою-унарно
  (функція (умова елементи)
    (за-умовою
      ((правильний-список-для-підрахунку? елементи)
       (порахувати-за-умовою-унарно-ядро умова елементи))
      ; Помилка саме в семантиці D3 ПЕРШЕ, не в host і не в reader.
      (так (перше (як-є ()))))))

; Синхронний обхід лише до закінчення коротшого правильного списку.
(визначити порахувати-пари-за-умовою-унарно-ядро
  (функція (умова лівий правий)
    (за-умовою
      ((порожній? лівий) (як-є ()))
      ((порожній? правий) (як-є ()))
      ((умова (перше лівий) (перше правий))
       (сполучити
         так
         (порахувати-пари-за-умовою-унарно-ядро
           умова (решта лівий) (решта правий))))
      (так
       (порахувати-пари-за-умовою-унарно-ядро
         умова (решта лівий) (решта правий))))))

(визначити порахувати-пари-за-умовою-унарно
  (функція (умова лівий правий)
    (за-умовою
      ((хибне? (правильний-список-для-підрахунку? лівий))
       (перше (як-є ())))
      ((хибне? (правильний-список-для-підрахунку? правий))
       (перше (як-є ())))
      (так
       (порахувати-пари-за-умовою-унарно-ядро
         умова лівий правий)))))
