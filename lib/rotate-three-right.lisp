; СЕНС: правий циклічний зсув рівно трьох елементів списку.
; Закон D3/D4: (a b c) → (c a b); довжина входу рівно три.
; Це зворотне до перенести-перший-у-кінець на цій області.
(визначити перенести-останній-трійки-на-початок
  (функція (елементи)
    (список
      (перше (решта-решти елементи))
      (перше елементи)
      (друге елементи))))

; Виконання: три позитивні спостереження порядку та негатив
; проти помилкового збереження першого елемента.
(за-умовою
  ((тотожне?
     (перше (перенести-останній-трійки-на-початок
               (список (як-є атом?) (як-є тотожне?) (як-є решта))))
     (як-є решта))
   (за-умовою
     ((тотожне?
        (друге (перенести-останній-трійки-на-початок
                  (список (як-є атом?) (як-є тотожне?) (як-є решта))))
        (як-є атом?))
      (за-умовою
        ((тотожне?
           (перше (решта-решти
                     (перенести-останній-трійки-на-початок
                       (список (як-є атом?) (як-є тотожне?) (як-є решта)))))
           (як-є тотожне?))
         (хибне?
           (тотожне?
             (перше (перенести-останній-трійки-на-початок
                       (список (як-є атом?) (як-є тотожне?) (як-є решта))))
             (як-є атом?))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
