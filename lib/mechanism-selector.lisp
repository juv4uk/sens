; Добір механізму після розв'язання тотожності функції.
; Модуль користується допущеними маршрутами; не встановлює семантику кодів.
; Умови — двопольові, предикати — точні значення першого домену.
; Безумовні переходи обчислюють точне Д1:1 через ATOM(QUOTE NIL).

(визначити реєстр-вибору-механізму
  (перше (читати-всі (читати-файл (символ-у-текст (як-є lib/surface/semantic-registry.lisp))))))

; Каталог починається з (визначити паспорт (як-є ТАБЛИЦЯ)).
; Отримуємо цитовані дані з AST; не виконуємо прочитаний DEFINE.
(визначити метадані-вибору-механізму
  (друге
    (третє
      (перше
        (читати-всі
          (читати-файл
            (символ-у-текст (як-є lib/function-table-mechanisms.lisp))))))))

(визначити рядки-реєстру-механізму
  реєстр-вибору-механізму)

(визначити механізм-знайти-секцію
  (функція (назва секції)
    (за-умовою
      ((атом? секції) (як-є ()))
      ((тотожне? (перше (перше секції)) назва) (перше секції))
      ((атом? (як-є ()))
       (механізм-знайти-секцію назва (решта секції))))))

(визначити маршрути-вибору-механізму
  (решта (механізм-знайти-секцію
         (як-є rows)
         метадані-вибору-механізму)))

(визначити реєстр-містить-ідентичність?
  (функція (ідентичність рядки)
    (за-умовою
      ((атом? рядки) (атом? (як-є (()))))
      ((тотожне? ідентичність (перше (перше рядки))) (атом? (як-є ())))
      ((атом? (як-є ()))
       (реєстр-містить-ідентичність? ідентичність (решта рядки))))))

(визначити механізм-знайти-маршрут
  (функція (ідентичність виконавець рядки)
    (за-умовою
      ((атом? рядки) (як-є ()))
      ((атом? (як-є ()))
       ((функція (рядок)
          (за-умовою
            ((тотожне? ідентичність (перше рядок))
             (за-умовою
               ((тотожне? виконавець (друге рядок)) рядок)
               ((атом? (як-є ()))
                (механізм-знайти-маршрут ідентичність виконавець (решта рядки)))))
            ((атом? (як-є ()))
             (механізм-знайти-маршрут ідентичність виконавець (решта рядки)))))
        (перше рядки))))))

(визначити вибрати-механізм
  (функція (ідентичність виконавець)
    (за-умовою
      ((тотожне?
         (реєстр-містить-ідентичність?
           ідентичність рядки-реєстру-механізму)
         (атом? (як-є (()))))
       (список
         (як-є mechanism-selection-failure)
         (як-є sid-not-in-function-table)
         ідентичність))
      ((атом? (як-є ()))
       ((функція (маршрут)
          (за-умовою
            ((атом? маршрут)
             (список (як-є mechanism-unavailable) ідентичність виконавець))
            ((атом? (як-є ()))
             (список (як-є mechanism-selected)
               ідентичність виконавець (третє маршрут)))))
        (механізм-знайти-маршрут
          ідентичність виконавець маршрути-вибору-механізму))))))


; Активна поверхня містить лише українські імена. Зовнішні маркери
; протоколу (rows, mechanism-selected) залишаються даними.
; Внутрішній предикат повертає обчислені Д1:1 або Д1:0.
; Англомовні дублікати тут більше не визначаються.
