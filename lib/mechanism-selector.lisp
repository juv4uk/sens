; Добір механізму за чинними українськими іменами ратифікованих доменів.
; Ідентичність не виводимо з плоских історичних таблиць: таблиця D1–D10 — влада
; значень, паспорт містить лише маршрути вже означених функцій.
; Зовнішні назви виконавців і стани є цитованими даними протоколу.
; Умови двопольові, результат предиката — точний D1.

; Самодостатня точна проєкція чинного паспорта маршрутів.
; SENS виконує лише цитовані українські функції D3-D5;
; жодних host-файлових викликів, Python/JSON чи дубльованої семантики у виконанні.
; Рядки звіряються з lib/function-table-mechanisms.lisp.
(визначити реєстр-вибору-механізму
  (як-є
    ((schema function-table-mechanisms-1)
     (authority д1-д10)
     (rows
       (як-є evaluator quote-form)
       (атом? evaluator atom-primitive)
       (тотожне? evaluator eq-primitive)
       (сполучити evaluator cons-primitive)
       (перше evaluator car-primitive)
       (решта evaluator cdr-primitive)
       (за-умовою evaluator cond-form)
       (функція evaluator lambda-form)
       (визначити evaluator define-form)
       (додати common-lisp bounded-exact-add)
       (додати prolog bounded-exact-add)
       (додати clips bounded-exact-add)
       (додати datalog bounded-exact-add))
     (profile-routes))))

(визначити метадані-вибору-механізму
  реєстр-вибору-механізму)

; У третьому полі паспорта — (rows (назва виконавець механізм) ...).
; Жоден числовий чи структурний сурогат не підміняє точний код домену.
(визначити рядки-реєстру-механізму
  (решта (третє метадані-вибору-механізму)))

; Порівняння D7-назв як точних списків знаків, а не D3 EQ на парах.
; Для атомів зберігаємо ратифіковане Д3 ТОТОЖНЕ?, для складених
; цитованих даних рекурсивно порівнюємо CAR і CDR самим СЕНС.
; Атомна рівність — точний Д3 EQ, лише після перевірки обох типів.
(визначити механізм-атомна-рівність?
  (функція (ліве праве)
    (за-умовою
      ((хибне? (атом? ліве)) (атом? (як-є (()))))
      ((хибне? (атом? праве)) (атом? (як-є (()))))
      ((атом? (як-є ())) (тотожне? ліве праве)))))

; Структурні протокольні об'єкти порівнює лише сам СЕНС.
(визначити механізм-однакові?
  (функція (ліве праве)
    (за-умовою
      ((порожній? ліве) (порожній? праве))
      ((порожній? праве) (атом? (як-є (()))))
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (механізм-атомна-рівність? ліве праве))
         ((атом? (як-є ())) (атом? (як-є (()))))))
      ((атом? праве) (атом? (як-є (()))))
      ((механізм-однакові? (перше ліве) (перше праве))
       (механізм-однакові? (решта ліве) (решта праве)))
      ((атом? (як-є ())) (атом? (як-є (())))))))

(визначити механізм-знайти-секцію
  (функція (назва секції)
    (за-умовою
      ((атом? секції) (як-є ()))
      ((механізм-однакові? (перше (перше секції)) назва) (перше секції))
      ((атом? (як-є ()))
       (механізм-знайти-секцію назва (решта секції))))))

; Паспорт має фіксоване третє поле rows, уже відкрите вище.
; Не шукаємо те саме поле вдруге через порівняння розгорнутих списків:
; D3 ТОТОЖНЕ? допускає лише атоми, а не порівняння AST із паспортом.
(визначити маршрути-вибору-механізму
  рядки-реєстру-механізму)

(визначити реєстр-містить-ідентичність?
  (функція (ідентичність рядки)
    (за-умовою
      ((атом? рядки) (атом? (як-є (()))))
      ((механізм-однакові? ідентичність (перше (перше рядки))) (атом? (як-є ())))
      ((атом? (як-є ()))
       (реєстр-містить-ідентичність? ідентичність (решта рядки))))))

(визначити механізм-зіставити-маршрут
  (функція (рядок ідентичність виконавець рядки)
    (за-умовою
      ((механізм-однакові? ідентичність (перше рядок))
       (за-умовою
         ((механізм-однакові? виконавець (друге рядок)) рядок)
         ((атом? (як-є ()))
          (механізм-знайти-маршрут ідентичність виконавець (решта рядки)))))
      ((атом? (як-є ()))
       (механізм-знайти-маршрут ідентичність виконавець (решта рядки))))))

(визначити механізм-знайти-маршрут
  (функція (ідентичність виконавець рядки)
    (за-умовою
      ((атом? рядки) (як-є ()))
      ((атом? (як-є ()))
       (механізм-зіставити-маршрут
         (перше рядки) ідентичність виконавець рядки)))))

(визначити механізм-оформити-вибір
  (функція (маршрут ідентичність виконавець)
    (за-умовою
      ((атом? маршрут)
       (список (як-є mechanism-unavailable) ідентичність виконавець))
      ((атом? (як-є ()))
       (список (як-є mechanism-selected)
         ідентичність виконавець (третє маршрут))))))

(визначити вибрати-механізм
  (функція (ідентичність виконавець)
    (за-умовою
      ((хибне?
         (реєстр-містить-ідентичність?
           ідентичність рядки-реєстру-механізму))
       (список
         (як-є mechanism-selection-failure)
         (як-є доменного-коду-немає-в-таблиці)
         ідентичність))
      ((атом? (як-є ()))
       (механізм-оформити-вибір
         (механізм-знайти-маршрут
           ідентичність виконавець маршрути-вибору-механізму)
         ідентичність виконавець)))))


; Д1-предикат не є D3-атомом для тотожне?: хибне? точно
; перевіряє Д1:0 без виклику EQ на предикатних результатах.
; Активна поверхня містить лише українські імена. Зовнішні маркери
; протоколу (rows, mechanism-selected) залишаються даними.
; Внутрішній предикат повертає обчислені Д1:1 або Д1:0.
; Англомовні дублікати тут більше не визначаються.
