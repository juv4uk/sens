; Д11: останнє значення із точним D1-прапорцем наявності.
; Композиція над наявним FIND-LAST-TAIL-PRESENCE без нової координати.
; Суфікс містить перший елемент збігу, навіть якщо він D1:ні або D3:().
; Структурний D3-доказ виконує вихідний пошук ДО предиката.
(визначити значення-останнього-хвоста-із-наявністю
  (функція (знайдено)
    (за-умовою
      ((перше знайдено)
       (список так (перше (друге знайдено))))
      (так (список ні (як-є ()))))))

; D11-пропозиція: нова композиція вже чинного FIND-LAST-TAIL-PRESENCE;
; не дублює код чи виклик D1–D10, відрізняє D1 наявність від D3 даних.
(визначити знайти-останнє-значення-із-наявністю
  (функція (умова елементи)
    (значення-останнього-хвоста-із-наявністю
      (знайти-останній-хвіст-із-наявністю умова елементи))))

; D11-пропозиція: значення з резервом — окрема композиція протоколу наявності.
; Значення D1:ні та D3:() є даними, а не сигналом для підстановки.
; Вхід уже нормалізований FIND-LAST-VALUE-PRESENCE до (D1-прапорець значення).
; Резерв — готове значення, не відкладене обчислення.
(визначити значення-останнього-збігу-або
  (функція (знайдено запасне)
    (за-умовою
      ((перше знайдено) (друге знайдено))
      (так запасне))))

; Повна D3-перевірка виконується пошуком ДО виклику умови.
; Результат наявного пошуку не повторно обчислюється.
(визначити знайти-останнє-значення-або
  (функція (умова елементи запасне)
    (значення-останнього-збігу-або
      (знайти-останнє-значення-із-наявністю умова елементи)
      запасне)))
