; Д11: Scheme SRFI-1 відношення множин (lset<=, lset=, lset-adjoin).
; Джерело: https://srfi.schemers.org/srfi-1/srfi-1.html
; З архівів: knowledge/d11/база-доступних-функцій/археологія-архівів-20261016.json
; Нижні домени вже мають тотожність атомів і сталі операції над списками.
; Тут НОВИЙ закон — переданий чистий двомісний предикат еквівалентності.
; Порівнювач у lset= одержує (лівий_елемент, правий_елемент)
; навіть коли перевіряється включення правого списку до лівого.
; Немає арифметики, зовнішніх наборів, host-обчислення чи нового opcode.
; Лише скінченні правильні списки. Повтори не змінюють відношення.

; Перед усіма публічними порівняннями перевіряємо ВСЮ форму множин.
; Неправильний ланцюг відхиляємо D3 ПЕРШЕ над D3 (),
; а не викликом D1 НІ як функції — лише Type, без хостового оракула.
; Одна множина теж має бути правильним списком: короткий шлях N<=1
; не може помилково видати ТАК для Д1:ні чи пошкодженого хвоста.
; Структурне () — єдиний правильний кінець списку.
; Структурний кінець — тільки D3:(), жоден інший D1-атом.
; EQ допустиме лише після атомного розгалуження.
(визначити правильна-множина?
  (функція (елементи)
    (за-умовою
      ((атом? елементи)
       (тотожне? елементи (як-є ())))
      (так (правильна-множина? (решта елементи))))))

; D1:ні в цілій послідовності або у хвості не дорівнює D3:().
(визначити правильний-ланцюг-множин?
  (функція (множини)
    (за-умовою
      ((атом? множини)
       (тотожне? множини (як-є ())))
      ((хибне? (правильна-множина? (перше множини))) ні)
      (так (правильний-ланцюг-множин? (решта множини))))))

; Спочатку перевірити цілу множину: ранній збіг не може
; приховати атомний хвіст. Внутрішній обхід не повторює перевірки.
(визначити належить-множині-ядро?
  (функція (порівняти шуканий множина)
    (за-умовою
      ((порожній? множина) ні)
      ((порівняти шуканий (перше множина)) так)
      (так
       (належить-множині-ядро?
         порівняти шуканий (решта множина))))))

(визначити належить-за-порівнянням-ядро?
  (функція (порівняти шуканий множина)
    (за-умовою
      ((правильна-множина? множина)
       (належить-множині-ядро? порівняти шуканий множина))
      (так (перше (як-є ()))))))

; Зовнішня функція відхиляє неправильні списки до порівняння.
(визначити належить-за-порівнянням?
  (функція (порівняти шуканий множина)
    (за-умовою
      ((хибне? (правильна-множина? множина)) (перше (як-є ())))
      (так (належить-за-порівнянням-ядро? порівняти шуканий множина)))))

; Валідовуємо обидва входи до вакуумного висновку (∅ ⊆ X).
; Між кроками не перечитуємо всю праву множину.
(визначити підмножина-множин-ядро?
  (функція (порівняти ліва права)
    (за-умовою
      ((порожній? ліва) так)
      ((належить-множині-ядро? порівняти (перше ліва) права)
       (підмножина-множин-ядро?
         порівняти (решта ліва) права))
      (так ні))))

(визначити підмножина-за-порівнянням-ядро?
  (функція (порівняти ліва права)
    (за-умовою
      ((хибне? (правильна-множина? ліва))
       (перше (як-є ())))
      ((хибне? (правильна-множина? права))
       (перше (як-є ())))
      (так (підмножина-множин-ядро? порівняти ліва права)))))

; Зовнішня функція відхиляє неправильні списки до порівняння.
(визначити підмножина-за-порівнянням?
  (функція (порівняти ліва права)
    (за-умовою
      ((хибне? (правильна-множина? ліва)) (перше (як-є ())))
      ((хибне? (правильна-множина? права)) (перше (як-є ())))
      (так (підмножина-за-порівнянням-ядро? порівняти ліва права)))))

(визначити ланцюг-підмножин-ядро?
  (функція (порівняти множини)
    (за-умовою
      ((порожній? множини) так)
      ((порожній? (решта множини)) так)
      ((підмножина-за-порівнянням-ядро?
         порівняти (перше множини) (друге множини))
       (ланцюг-підмножин-ядро?
         порівняти (решта множини)))
      (так ні))))

(визначити ланцюг-підмножин-за-порівнянням?
  (функція (порівняти множини)
    (за-умовою
      ((хибне? (правильний-ланцюг-множин? множини))
       (перше (як-є ())))
      (так (ланцюг-підмножин-ядро? порівняти множини)))))

; У SRFI-1 для lset= порядок двох аргументів компаратора значущий.
(визначити правий-елемент-є-зліва-ядро?
  (функція (порівняти правий ліві)
    (за-умовою
      ((порожній? ліві) ні)
      ((порівняти (перше ліві) правий) так)
      (так
       (правий-елемент-є-зліва-ядро?
         порівняти правий (решта ліві))))))

; Зовнішня функція відхиляє неправильні списки до порівняння.
(визначити правий-елемент-є-зліва?
  (функція (порівняти правий ліві)
    (за-умовою
      ((хибне? (правильна-множина? ліві)) (перше (як-є ())))
      (так (правий-елемент-є-зліва-ядро? порівняти правий ліві)))))

(визначити праві-елементи-є-зліва-ядро?
  (функція (порівняти ліві праві)
    (за-умовою
      ((порожній? праві) так)
      ((правий-елемент-є-зліва-ядро? порівняти (перше праві) ліві)
       (праві-елементи-є-зліва-ядро?
         порівняти ліві (решта праві)))
      (так ні))))

; Зовнішня функція відхиляє неправильні списки до порівняння.
(визначити праві-елементи-є-зліва?
  (функція (порівняти ліві праві)
    (за-умовою
      ((хибне? (правильна-множина? ліві)) (перше (як-є ())))
      ((хибне? (правильна-множина? праві)) (перше (як-є ())))
      (так (праві-елементи-є-зліва-ядро? порівняти ліві праві)))))

(визначити множини-рівні-за-порівнянням-ядро?
  (функція (порівняти ліва права)
    (за-умовою
      ((підмножина-за-порівнянням-ядро? порівняти ліва права)
       (праві-елементи-є-зліва-ядро? порівняти ліва права))
      (так ні))))

; Зовнішня функція відхиляє неправильні списки до порівняння.
(визначити множини-рівні-за-порівнянням?
  (функція (порівняти ліва права)
    (за-умовою
      ((хибне? (правильна-множина? ліва)) (перше (як-є ())))
      ((хибне? (правильна-множина? права)) (перше (як-є ())))
      (так (множини-рівні-за-порівнянням-ядро? порівняти ліва права)))))

(визначити ланцюг-рівних-множин-ядро?
  (функція (порівняти множини)
    (за-умовою
      ((порожній? множини) так)
      ((порожній? (решта множини)) так)
      ((множини-рівні-за-порівнянням-ядро?
         порівняти (перше множини) (друге множини))
       (ланцюг-рівних-множин-ядро?
         порівняти (решта множини)))
      (так ні))))

(визначити ланцюг-рівних-множин-за-порівнянням?
  (функція (порівняти множини)
    (за-умовою
      ((хибне? (правильний-ланцюг-множин? множини))
       (перше (як-є ())))
      (так (ланцюг-рівних-множин-ядро? порівняти множини)))))

; Адаптація SRFI-1 lset-adjoin: нові кандидати — список, не variadic.
; Порядок додавання визначено явно: кожен новий елемент спереду.
; Початковий список лишається суфіксом, включно з початковими повторами.
; D3:000 є єдиним правильним кінцем множини. Якщо кандидати
; порожні або вже наявні, не дозволяти повернути початкову неправильну
; пару без перевірки хвоста. Повертаємо саме переданий початковий список.
; D1:ні у хвості викликає точну D3 помилку ПЕРШЕ, а не успіх.
; У D11 ADDJOIN також не приймаємо D1:ні за структурний кінець.

; Публічне підтвердження повної форми початкового списку.
; Повертає первісний об'єкт, якщо закінчується тільки D3 ().
(визначити підтвердити-список-додавання
  (функція (залишок початкові)
    (за-умовою
      ((атом? залишок)
       (за-умовою
         ((тотожне? залишок (як-є ())) початкові)
         (так (перше (як-є ())))))
      (так
       (підтвердити-список-додавання
         (решта залишок) початкові)))))

; Д11 LSET-ADJOIN: внутрішнє ядро отримує лише ДВА перевірені списки.
; Між кроками не повторюємо О(n) валідацію всього акумулятора.
(визначити додати-відсутні-за-порівнянням-ядро
  (функція (порівняти початкові кандидати)
    (за-умовою
      ((порожній? кандидати) початкові)
      ((правий-елемент-є-зліва-ядро?
         порівняти (перше кандидати) початкові)
       (додати-відсутні-за-порівнянням-ядро
         порівняти початкові (решта кандидати)))
      (так
       (додати-відсутні-за-порівнянням-ядро
         порівняти
         (сполучити (перше кандидати) початкові)
         (решта кандидати))))))

; Публічна функція не викликає компаратор, поки ОБИДВА списки
; не мають точного структурного D3 закінчення.
; Початковий список — суфікс результату, повтори не видаляються.
(визначити додати-відсутні-за-порівнянням
  (функція (порівняти початкові кандидати)
    (за-умовою
      ((хибне? (правильна-множина? кандидати))
       (перше (як-є ())))
      (так
       (додати-відсутні-за-порівнянням-ядро
         порівняти
         (підтвердити-список-додавання початкові початкові)
         кандидати)))))


; Живі SENS-свідки в тому самому файлі: D1-вердикт, не host assert.
; Вакуумний ланцюг і єдина правильна множина допустимі.
(за-умовою
  ((правильний-ланцюг-множин? (як-є ())) так)
  (так (перше (як-є ()))))
(за-умовою
  ((правильний-ланцюг-множин? (список (список ні))) так)
  (так (перше (як-є ()))))

; Сторонній D1 атом як ціла множина НЕ є порожнім списком.
(за-умовою
  ((хибне? (правильний-ланцюг-множин? (список ні))) так)
  (так (перше (як-є ()))))

; Крапковий хвіст усередині множини теж відхиляється до порівняння.
(за-умовою
  ((хибне?
     (правильний-ланцюг-множин?
       (список (сполучити так ні)))) так)
  (так (перше (як-є ()))))

; Після перевірки форми впорядковане включення лишається чинним.
(за-умовою
  ((ланцюг-підмножин-за-порівнянням?
     тотожне?
     (список (список ні) (список ні так))) так)
  (так (перше (як-є ()))))

; Рівність також зберігає порядок аргументів порівнювача.
(за-умовою
  ((ланцюг-рівних-множин-за-порівнянням?
     тотожне?
     (список (список ні) (список ні))) так)
  (так (перше (як-є ()))))
