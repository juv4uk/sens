; Узагальнене обернення власного списку довільної довжини.
; Закон Д3: обернення порожній = порожній, обернення (а . хс) накопичує а.
; Хвостова рекурсія та збереження вкладених пари-значень без мутацій.
(визначити обернути-у-накопичувач
  (функція (залишок накопичувач)
    (за-умовою
      ((атом? залишок) накопичувач)
      (так
       (обернути-у-накопичувач
         (решта залишок)
         (сполучити (перше залишок) накопичувач))))))

(визначити обернути-власний-список
  (функція (елементи)
    (обернути-у-накопичувач елементи (як-є ()))))

(визначити вхідна-четвірка
  (список (як-є атом?) (як-є тотожне?) (як-є решта) (як-є сполучити)))
(визначити обернена-четвірка
  (обернути-власний-список вхідна-четвірка))
(визначити відновлена-четвірка
  (обернути-власний-список обернена-четвірка))
(визначити обернений-вкладений
  (обернути-власний-список
    (список
      (сполучити (як-є атом?) (як-є решта))
      (як-є тотожне?))))

; Перевірка всіх позицій, порожній, одиничного елемента, вкладеної пари,
; подвійного обернення і хибного початкового порядку виконується СЕНС.
(за-умовою
  ((тотожне? (перше обернена-четвірка) (як-є сполучити))
   (за-умовою
     ((тотожне? (друге обернена-четвірка) (як-є решта))
      (за-умовою
        ((тотожне? (перше (решта-решти обернена-четвірка)) (як-є тотожне?))
         (за-умовою
           ((тотожне? (друге (решта-решти обернена-четвірка)) (як-є атом?))
            (за-умовою
              ((тотожне? (обернути-власний-список (як-є ())) (як-є ()))
               (за-умовою
                 ((тотожне? (перше (обернути-власний-список (список (як-є атом?)))) (як-є атом?))
                  (за-умовою
                    ((тотожне? (перше відновлена-четвірка) (як-є атом?))
                     (за-умовою
                       ((тотожне? (друге відновлена-четвірка) (як-є тотожне?))
                        (за-умовою
                          ((тотожне? (перше (решта-решти відновлена-четвірка)) (як-є решта))
                           (за-умовою
                             ((тотожне? (друге (решта-решти відновлена-четвірка)) (як-є сполучити))
                              (за-умовою
                                ((тотожне? (перше обернений-вкладений) (як-є тотожне?))
                                 (за-умовою
                                   ((хибне? (атом? (друге обернений-вкладений)))
                                    (за-умовою
                                      ((тотожне? (перше (друге обернений-вкладений)) (як-є атом?))
                                       (за-умовою
                                         ((хибне? (тотожне? (перше обернена-четвірка) (як-є атом?)))
                                          (атом? (як-є ())))
                                         (так (хибне? (атом? (як-є ()))))))
                                      (так (хибне? (атом? (як-є ()))))))
                                   (так (хибне? (атом? (як-є ()))))))
                                (так (хибне? (атом? (як-є ()))))))
                             (так (хибне? (атом? (як-є ()))))))
                          (так (хибне? (атом? (як-є ()))))))
                       (так (хибне? (атом? (як-є ()))))))
                    (так (хибне? (атом? (як-є ()))))))
                 (так (хибне? (атом? (як-є ()))))))
              (так (хибне? (атом? (як-є ()))))))
           (так (хибне? (атом? (як-є ()))))))
        (так (хибне? (атом? (як-є ()))))))
     (так (хибне? (атом? (як-є ()))))))
  (так (хибне? (атом? (як-є ())))))
