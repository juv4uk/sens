; Відокремлюємо найдовший початковий відрізок атомів від решти списку.
; Вкладена пара зупиняє поділ і лишається на початку решти.
; Порожній список є атомом і може належати до початкового відрізка.
; Обидві частини разом зберігають початковий порядок і вкладені значення.
; Обчислення належить СЕНС, а не зовнішньому обробнику.

(визначити додати-атом-до-розтину
 (функція (значення розтин)
  (список (сполучити значення (перше розтин)) (друге розтин))))

(визначити розділити-початкові-атоми
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (список (як-є ()) (як-є ())))
   ((атом? (перше елементи))
    (додати-атом-до-розтину
     (перше елементи)
     (розділити-початкові-атоми (решта елементи))))
   (так (список (як-є ()) елементи)))))

; Структурну рівність пар доводимо рекурсією, не порівнюємо пари як атоми.
(визначити тотожні-дерева-розтину?
 (функція (лівий правий)
  (за-умовою
   ((атом? лівий)
    (за-умовою
     ((атом? правий) (тотожне? лівий правий))
     (так ні)))
   ((атом? правий) ні)
   ((тотожні-дерева-розтину? (перше лівий) (перше правий))
    (тотожні-дерева-розтину? (решта лівий) (решта правий)))
   (так ні))))

; Помилковий закон повинен справді завершити виконання СЕНС помилкою.
(визначити підтвердити-розтин
 (функція (елементи очікуваний-початок очікувана-решта)
  (за-умовою
   ((тотожні-дерева-розтину?
     (перше (розділити-початкові-атоми елементи))
     очікуваний-початок)
    (за-умовою
     ((тотожні-дерева-розтину?
       (друге (розділити-початкові-атоми елементи))
       очікувана-решта)
      (атом? (як-є ())))
     (так (перше (як-є ())))))
   (так (перше (як-є ()))))))

