; Поворот кожної трійки атомів вліво: (а б в) стає (б в а).
; Залишок довжини один або два лишається незмінним. Три повороти
; відновлюють будь-який правильний скінченний список атомів.
; Семантика тільки чинних Д1, Д3, Д4 і Д5; Т5М не обирає значень.
(визначити обертати-кожну-трійку
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) елементи)
      ((атом? (решта-решти елементи)) елементи)
      (так
        (сполучити (друге елементи)
          (сполучити (третє елементи)
            (сполучити (перше елементи)
              (обертати-кожну-трійку (решта (решта-решти елементи))))))))))

(визначити початкові-шість
  (список (як-є атом?) (як-є решта) (як-є сполучити)
          (як-є тотожне?) (як-є порожній?) (як-є хибне?)))
(визначити один-поворот (обертати-кожну-трійку початкові-шість))
(визначити два-повороти (обертати-кожну-трійку один-поворот))
(визначити три-повороти (обертати-кожну-трійку два-повороти))

; Шість позицій результату, шість після обернення, довжина,
; порожня і неповні трійки, плюс негативне свідчення перестановки.
; При порушенні закону обчислюється недопустимий перше від ().
(за-умовою
  ((тотожне? (перше один-поворот) (як-є решта))
    (за-умовою
  ((тотожне? (перше (решта один-поворот)) (як-є сполучити))
    (за-умовою
  ((тотожне? (перше (решта (решта один-поворот))) (як-є атом?))
    (за-умовою
  ((тотожне? (перше (решта (решта (решта один-поворот)))) (як-є порожній?))
    (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта один-поворот))))) (як-є хибне?))
    (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта (решта один-поворот)))))) (як-є тотожне?))
    (за-умовою
  ((тотожне? (перше три-повороти) (як-є атом?))
    (за-умовою
  ((тотожне? (перше (решта три-повороти)) (як-є решта))
    (за-умовою
  ((тотожне? (перше (решта (решта три-повороти))) (як-є сполучити))
    (за-умовою
  ((тотожне? (перше (решта (решта (решта три-повороти)))) (як-є тотожне?))
    (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта три-повороти))))) (як-є порожній?))
    (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта (решта три-повороти)))))) (як-є хибне?))
    (за-умовою
  ((атом? (решта (решта (решта (решта (решта (решта один-поворот)))))))
    (за-умовою
  ((атом? (обертати-кожну-трійку (як-є ())))
    (за-умовою
  ((тотожне? (перше (обертати-кожну-трійку (список (як-є атом?)))) (як-є атом?))
    (за-умовою
  ((тотожне? (друге (обертати-кожну-трійку (список (як-є атом?) (як-є решта)))) (як-є решта))
    (за-умовою
  ((хибне? (тотожне? (перше один-поворот) (як-є атом?)))
    так)
