; Хвіст після першого вкладеного списку: жодного копіювання сполученням.
; Лише наявні закони СЕНС; перевірки виконує сам двійковий інтерпретатор.
(визначити хвіст-після-першого-списку
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (перше елементи))
        (хвіст-після-першого-списку (решта елементи)))
      (так (решта елементи)))))

; Порожній вхід та лише атоми дають порожній хвіст.
(за-умовою
  ((атом? (хвіст-після-першого-списку (як-є ()))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((атом? (хвіст-після-першого-списку
            (список (як-є атом?) (як-є решта)))) так)
  (так (перше (як-є ()))))

; Знайдений вкладений список пропускаємо без копії хвоста.
(за-умовою
  ((тотожне?
     (перше (хвіст-після-першого-списку
       (список (список (як-є атом?)) (як-є решта) (як-є сполучити))))
     (як-є решта)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне?
     (перше (хвіст-після-першого-списку
       (список (як-є атом?) (список (як-є решта)) (як-є сполучити))))
     (як-є сполучити)) так)
  (так (перше (як-є ()))))

; Негатив: пропущений початковий атом не повертається у хвості.
(за-умовою
  ((хибне?
     (тотожне?
       (перше (хвіст-після-першого-списку
         (список (як-є атом?) (список (як-є решта)) (як-є сполучити))))
       (як-є атом?))) так)
  (так (перше (як-є ()))))
(атом? (як-є ()))
