; Д3-Д4-Д5. Остання вкладена пара визначає початок суфікса.
; Повертаємо наявний хвіст без його копіювання, зберігаючи всі елементи.
; Порожній як елемент є атомом; список, що містить порожній, є складеним.
; Час лінійний, додаткових пар під час проходу немає.
(визначити суфікс-останньої-пари-стан
 (функція (залишок обраний)
  (за-умовою
   ((атом? залишок) обраний)
   ((атом? (перше залишок))
    (суфікс-останньої-пари-стан (решта залишок) обраний))
   (так
    (суфікс-останньої-пари-стан (решта залишок) залишок)))))

(визначити суфікс-від-останньої-пари
 (функція (елементи)
  (суфікс-останньої-пари-стан елементи (як-є ()))))

; Порожній вхід, лише атоми, атом порожній перед вкладеною парою.
(за-умовою
 ((порожній? (суфікс-від-останньої-пари (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (суфікс-від-останньої-пари
              (список (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (суфікс-від-останньої-пари
              (список (як-є ()) (як-є атом?)))) так)
 (так (перше (як-є ()))))

; Єдина пара залишається першим елементом результату.
(за-умовою
 ((тотожне?
   (перше (перше (суфікс-від-останньої-пари
                   (список (список (як-є атом?))))))
   (як-є атом?)) так)
 (так (перше (як-є ()))))

; Пара після префікса атомів, із збереженням суфікса.
(за-умовою
 ((тотожне?
   (перше (перше (суфікс-від-останньої-пари
     (список (як-є атом?) (як-є решта)
             (список (як-є сполучити)) (як-є тотожне?)))))
   (як-є сполучити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (друге (суфікс-від-останньої-пари
     (список (як-є атом?) (список (як-є решта))
             (як-є тотожне?))))
   (як-є тотожне?)) так)
 (так (перше (як-є ()))))

; З двох вкладених пар обирається лише остання.
(за-умовою
 ((тотожне?
   (перше (перше (суфікс-від-останньої-пари
     (список (список (як-є атом?)) (як-є решта)
             (список (як-є сполучити)) (як-є тотожне?)))))
   (як-є сполучити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (тотожне?
   (перше (перше (суфікс-від-останньої-пари
     (список (список (як-є атом?)) (список (як-є решта))))))
   (як-є атом?))) так)
 (так (перше (як-є ()))))

; Список з порожнім елементом — НЕ порожній список: (( )) != ().
; Перше від суфікса — вкладена пара, лише ПЕРШЕ її елемента є ().
(за-умовою
 ((порожній?
   (перше (перше (суфікс-від-останньої-пари
     (список (як-є атом?) (список (як-є ())) (як-є решта)))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній?
   (друге (суфікс-від-останньої-пари
     (список (список (як-є решта)) (як-є ()))))) так)
 (так (перше (як-є ()))))

; Атомарний вхід (у тому числі не порожній) не можна передавати в ПЕРШЕ.
; Обраний раніше суфікс зберігається і без подальшого складання пар.
(за-умовою
 ((порожній? (суфікс-від-останньої-пари (як-є атом?))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (перше (суфікс-останньої-пари-стан
     (як-є атом?) (список (як-є сполучити))))
   (як-є сполучити)) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
