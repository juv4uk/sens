; Обернення чотирьох різних Д3-елементів; двічі - вихідний список.
; Самостійна українська СЕНС-програма з позитивним, оберненим і негативним свідками.
(визначити обернути-четвірку
  (функція (елементи)
    (список
      (перше (решта (решта (решта елементи))))
      (перше (решта (решта елементи)))
      (перше (решта елементи))
      (перше елементи)
    )))
(визначити вхід-обернути-четвірку
  (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?)))
(визначити вихід-обернути-четвірку (обернути-четвірку вхід-обернути-четвірку))
(визначити обернення-обернути-четвірку (обернути-четвірку вихід-обернути-четвірку))

; Закон Д1: усі чотири позиції, обернення і негатив.
(за-умовою
  ((тотожне? (перше вихід-обернути-четвірку) (як-є тотожне?))
    (за-умовою
  ((тотожне? (перше (решта вихід-обернути-четвірку)) (як-є сполучити))
    (за-умовою
  ((тотожне? (перше (решта (решта вихід-обернути-четвірку))) (як-є решта))
    (за-умовою
  ((тотожне? (перше (решта (решта (решта вихід-обернути-четвірку)))) (як-є атом?))
    (за-умовою
  ((тотожне? (перше обернення-обернути-четвірку) (як-є атом?))
    (за-умовою
  ((тотожне? (перше (решта обернення-обернути-четвірку)) (як-є решта))
    (за-умовою
  ((тотожне? (перше (решта (решта обернення-обернути-четвірку))) (як-є сполучити))
    (за-умовою
  ((тотожне? (перше (решта (решта (решта обернення-обернути-четвірку)))) (як-є тотожне?))
    (за-умовою
  ((хибне? (тотожне? (перше вихід-обернути-четвірку) (як-є атом?)))
