; Справжній паліндром атомів довільної скінченної довжини на СЕНС і Д3-Д4.
; Два атомні кінці рівні дає перевіряємо середину, без зовнішнє ЕКУАЛ і чисел.
; Вхід: власний скінченний список АТОМІВ; порожній та один атом - істина.
; Всі позитивні та негативні випадки виконуються СЕНС і повертають Д1.

(визначити останній-атом-для-паліндрому
  (функція (елементи)
    (за-умовою
      ((порожній? (решта елементи)) (перше елементи))
      ((атом? (як-є ()))
       (останній-атом-для-паліндрому (решта елементи))))))

(визначити без-останнього-атома-для-паліндрому
  (функція (елементи)
    (за-умовою
      ((порожній? (решта елементи)) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (перше елементи)
         (без-останнього-атома-для-паліндрому (решта елементи)))))))

; Лінійний конкурсант: один розворот через акумулятор, далі одне
; попарне порівняння. Допоміжні публічні функції вище не вилучено.
; Для скінченного списку атомів О(н) часу, О(н) пам'яті; без зовнішнє семантісс.
(визначити обернути-атоми-для-паліндрому
  (функція (елементи накопичено)
    (за-умовою
      ((порожній? елементи) накопичено)
      (так (обернути-атоми-для-паліндрому
             (решта елементи)
             (сполучити (перше елементи) накопичено))))))

(визначити зіставити-атоми-для-паліндрому?
  (функція (ліві праві)
    (за-умовою
      ((порожній? ліві) (порожній? праві))
      ((порожній? праві) ні)
      ((тотожне? (перше ліві) (перше праві))
       (зіставити-атоми-для-паліндрому? (решта ліві) (решта праві)))
      (так ні))))

(визначити паліндром-атомів?
  (функція (елементи)
    (зіставити-атоми-для-паліндрому?
      елементи
      (обернути-атоми-для-паліндрому елементи (як-є ())))))

