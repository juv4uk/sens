; Справжній паліндром атомів довільної скінченної довжини на SENS/D3-D4.
; Два атомні кінці рівні -> перевіряємо середину, без host EQUAL і чисел.
; Вхід: власний скінченний список АТОМІВ; NIL та один атом — істина.
; Всі позитивні та негативні випадки виконуються SENS і повертають D1.

(визначити останній-атом-для-паліндрому
  (функція (елементи)
    (за-умовою
      ((порожній? (решта елементи)) (перше елементи))
      ((атом? (як-є ()))
       (останній-атом-для-паліндрому (решта елементи))))))

(визначити без-останнього-атома-для-паліндрому
  (функція (елементи)
    (за-умовою
      ((порожній? (решта елементи)) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (перше елементи)
         (без-останнього-атома-для-паліндрому (решта елементи)))))))

(визначити паліндром-атомів?
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (атом? (як-є ())))
      ((порожній? (решта елементи)) (атом? (як-є ())))
      ((тотожне? (перше елементи)
                 (останній-атом-для-паліндрому елементи))
       (паліндром-атомів?
         (без-останнього-атома-для-паліндрому (решта елементи))))
      ((атом? (як-є ())) (хибне? (атом? (як-є ())))))))

; Справжній набір позитивних і негативних D1-законів.
