                     (за-умовою
                       ((паліндром-атомів? (список (як-є решта) (як-є решта) (як-є решта) (як-є решта)))
                        (за-умовою
                          ((хибне? (паліндром-атомів? (список (як-є решта) (як-є атом?) (як-є решта) (як-є атом?))))
                           (за-умовою
                             ((хибне? (паліндром-атомів? (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є атом?) (як-є атом?))))
                              (за-умовою
                                ((хибне? (паліндром-атомів? (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є сполучити) (як-є атом?))))
                                 (за-умовою
                                   ((хибне? (паліндром-атомів? (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є решта) (як-є тотожне?))))
                                    (за-умовою
                                      ((хибне? (паліндром-атомів? (список (як-є атом?) (як-є решта) (як-є сполучити))))
                                       (за-умовою
