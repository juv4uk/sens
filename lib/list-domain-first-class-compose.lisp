; СЕНС: точні коди Д3 ПЕРШЕ і РЕШТА — справжні значення функцій.
; Повна українська проєкція: без старого байтового чи текстового диспетчера,
; зовнішнього обчислювача чи дубльованого визначення операцій.
; Отримане значення функції передається через параметр і викликається.
(визначити застосувати-два-коди
  (функція (внутрішній зовнішній дані)
    (зовнішній (внутрішній дані))))
; Повна перевірка композиції функцій-значень у самому обчислювачі СЕНС.
; Жодна числова константа не потрібна: ідентичність атома є даними Д7,
; а перше/решта/тотожне? у позиції функції — точні коди Д3.
(визначити довести-першокласну-композицію
  (функція (результат очікуване)
    (за-умовою
      ((тотожне? результат очікуване) так)
      (так (перше (як-є ()))))))

; f = ПЕРШЕ ◦ РЕШТА: одержуємо другий елемент за один складений виклик.
(довести-першокласну-композицію
  (застосувати-два-коди
    решта перше
    (список (як-є атом?) (як-є решта) (як-є сполучити)))
  (як-є решта))

; Ті самі коди, інший порядок: РЕШТА ◦ ПЕРШЕ дає порожній хвіст.
(за-умовою
  ((порожній?
    (застосувати-два-коди
      перше решта
      (список (список (як-є атом?)) (як-є решта))))
    так)
  (так (перше (як-є ()))))

; Незалежний прямий виклик Д3 — позитивний oracle без Python/JSON.
(довести-першокласну-композицію
  (застосувати-два-коди
    решта перше
    (список (як-є атом?) (як-є решта) (як-є сполучити)))
  (перше (решта
    (список (як-є атом?) (як-є решта) (як-є сполучити)))))

; Негатив: невірна перестановка кодів повинна бути виявлена.
(за-умовою
  ((хибне?
    (тотожне?
      (застосувати-два-коди
        решта перше
        (список (як-є атом?) (як-є решта) (як-є сполучити)))
      (як-є атом?))) так)
  (так (перше (як-є ()))))

; Першокласність включає функцію порівняння: код передається як аргумент.
(визначити викликати-порівняння-за-кодом
  (функція (дія ліве праве)
    (дія ліве праве)))
(за-умовою
  ((викликати-порівняння-за-кодом
     тотожне? (як-є атом?) (як-є атом?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((хибне?
     (викликати-порівняння-за-кодом
       тотожне? (як-є атом?) (як-є решта))) так)
  (так (перше (як-є ()))))

(атом? (як-є ()))
