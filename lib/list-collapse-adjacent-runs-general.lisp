(визначити усі-приклади-стиснення-істинні?
 (функція (приклади)
  (за-умовою
   ((порожній? приклади) так)
   ((списки-стиснення-однакові?
      (стиснути-суміжні-повтори (перше (перше приклади)))
      (друге (перше приклади)))
    (усі-приклади-стиснення-істинні? (решта приклади)))
   (так ні))))

; Негативний приклад: неправильний порядок не може бути прийнятим.
; Хибний позитивний або негативний закон викликає реальну помилку ПЕРШЕ від ().
(за-умовою
 ((усі-приклади-стиснення-істинні? приклади-стиснення)
  (за-умовою
   ((хибне?
     (списки-стиснення-однакові?
      (стиснути-суміжні-повтори
       (список (як-є атом?) (як-є атом?) (як-є решта)))
      (список (як-є решта) (як-є атом?))))
    (атом? (як-є ())))
   (так (перше (як-є ())))))
