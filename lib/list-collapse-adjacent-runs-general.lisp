; Д3 і Д5: стягнути кожну непорожню серію рівних сусідніх атомів до одного.
; Порядок різних атомів зберігається. Довільні віддалені повтори лишаються.
; Сам СЕНС виконує алгоритм і закони; Зіг відповідає тільки за фізичний Т5М.

(визначити стиснути-суміжні-повтори
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((порожній? (решта елементи)) елементи)
   ((тотожне? (перше елементи) (друге елементи))
    (стиснути-суміжні-повтори (решта елементи)))
   (так (сполучити (перше елементи)
                   (стиснути-суміжні-повтори (решта елементи)))))))

(визначити списки-стиснення-однакові?
 (функція (лівий правий)
  (за-умовою
   ((порожній? лівий) (порожній? правий))
   ((порожній? правий) ні)
   ((тотожне? (перше лівий) (перше правий))
    (списки-стиснення-однакові? (решта лівий) (решта правий)))
   (так ні))))

