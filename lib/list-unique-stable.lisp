; Усунути повтори у скінченному правильному списку атомів без зміни порядку.
; Семантика належить СЕНС: Д1 + композиція Д3 і Д4, Зіг лише переносить Т5М.
; Перше входження зберігається; повторні не потрапляють до результату.
(визначити вже-є-атом?
  (функція (шукане переглянуті)
    (за-умовою
      ((атом? переглянуті) ні)
      ((тотожне? шукане (перше переглянуті)) так)
      ((атом? (як-є ())) (вже-є-атом? шукане (решта переглянуті))))))

(визначити вибрати-неповторені
  (функція (залишок збережені)
    (за-умовою
      ((атом? залишок) збережені)
      ((вже-є-атом? (перше залишок) збережені)
       (вибрати-неповторені (решта залишок) збережені))
      ((атом? (як-є ()))
       (вибрати-неповторені
         (решта залишок)
         (приєднати збережені (список (перше залишок))))))))

(визначити унікальні-атоми
  (функція (елементи)
    (вибрати-неповторені елементи (як-є ()))))

(визначити вхідний-список
  (список (як-є атом?) (як-є решта) (як-є атом?)
          (як-є сполучити) (як-є решта) (як-є тотожне?)
          (як-є сполучити)))
(визначити унікальний-список (унікальні-атоми вхідний-список))

; Діючий СЕНС обчислює усі чотири позиції, межі, збереження першого,
; відсутність повторів і негативну відмінність від початкового порядку.
(за-умовою
  ((тотожне? (перше унікальний-список) (як-є атом?))
   (за-умовою
     ((тотожне? (друге унікальний-список) (як-є решта))
      (за-умовою
        ((тотожне? (перше (решта-решти унікальний-список)) (як-є сполучити))
         (за-умовою
           ((тотожне? (друге (решта-решти унікальний-список)) (як-є тотожне?))
            (за-умовою
              ((порожній? (решта (решта (решта (решта унікальний-список)))))
               (за-умовою
                 ((порожній? (унікальні-атоми (як-є ())))
                  (за-умовою
                    ((тотожне?
                       (перше (унікальні-атоми
                         (список (як-є атом?) (як-є атом?))))
                       (як-є атом?))
                     (за-умовою
                       ((порожній? (решта (унікальні-атоми
                         (список (як-є атом?) (як-є атом?)))))
                        (за-умовою
                          ((хибне? (тотожне? (друге унікальний-список) (як-є атом?)))
                           (атом? (як-є ())))
                          ((атом? (як-є ())) (перше (як-є ())))))
                       ((атом? (як-є ())) (перше (як-є ())))))
                    ((атом? (як-є ())) (перше (як-є ())))))
                 ((атом? (як-є ())) (перше (як-є ())))))
              ((атом? (як-є ())) (перше (як-є ())))))
           ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
