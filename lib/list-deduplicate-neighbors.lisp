; Видалення тільки сусідніх повторів атомів, без зміни порядку різних атомів.
; Мовна семантика - Д3 і Д5 у СНС, транспорт окремо опрацьовує Зіґ.
(визначити ущільнити-сусідні-атоми
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) елементи)
      ((тотожне? (перше елементи) (друге елементи))
       (ущільнити-сусідні-атоми (решта елементи)))
      ((атом? (як-є ()))
       (сполучити (перше елементи)
         (ущільнити-сусідні-атоми (решта елементи)))))))

(визначити вхід-ущільнення
  (список (як-є атом?) (як-є атом?) (як-є решта) (як-є решта) (як-є атом?) (як-є сполучити) (як-є сполучити) (як-є сполучити) (як-є решта)))
(визначити вихід-ущільнення
  (ущільнити-сусідні-атоми вхід-ущільнення))
(визначити чергування-ущільнення
  (ущільнити-сусідні-атоми (список (як-є атом?) (як-є решта) (як-є атом?))))
(визначити однакові-ущільнення
  (ущільнити-сусідні-атоми (список (як-є атом?) (як-є атом?) (як-є атом?))))

