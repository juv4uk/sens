; СЕНС: перенести перший елемент непорожнього списку в кінець.
; Це виконувана функція Д3/Д4, а не опис/реєстр і не host-симуляція.
; Вхід: непорожній власний список. Результат: циклічний зсув ліворуч.
(визначити перенести-перший-у-кінець
  (функція (елементи)
    (приєднати (решта елементи) (список (перше елементи)))))

; Живий результат 1: порядок двох залишкових елементів,
; перенесення початкового атома на останню позицію та негатив
; проти помилкового збереження першого атома на першій позиції.
(за-умовою
  ((тотожне?
     (перше (перенести-перший-у-кінець
               (список (як-є атом?) (як-є тотожне?) (як-є решта))))
     (як-є тотожне?))
   (за-умовою
     ((тотожне?
        (друге (перенести-перший-у-кінець
                  (список (як-є атом?) (як-є тотожне?) (як-є решта))))
        (як-є решта))
      (за-умовою
        ((тотожне?
           (перше (решта-решти
                     (перенести-перший-у-кінець
                       (список (як-є атом?) (як-є тотожне?) (як-є решта)))))
           (як-є атом?))
         (хибне?
           (тотожне?
             (перше (перенести-перший-у-кінець
                       (список (як-є атом?) (як-є тотожне?) (як-є решта))))
             (як-є атом?))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
