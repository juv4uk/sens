       (список (перше елементи)
               (перекривні-вікна-для-двох елементи))))))

(визначити зібрати-другі-вікон
  (функція (вікна)
    (за-умовою
      ((атом? вікна) (як-є ()))
      ((атом? (як-є ()))
       (сполучити (друге (перше вікна))
                  (зібрати-другі-вікон (решта вікна)))))))

(визначити відновити-зі-сусідів
  (функція (код)
    (за-умовою
      ((атом? код) (як-є ()))
      ((атом? (як-є ()))
       (сполучити (перше код) (зібрати-другі-вікон (друге код)))))))

(визначити початковий-список
  (список (як-є атом?) (як-є атом?) (як-є решта) (як-є сполучити) (як-є сполучити) (як-є за-умовою) (як-є атом?)))
