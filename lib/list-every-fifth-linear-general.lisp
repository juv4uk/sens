   (взяти-кожний-пятий
    (список (як-є атом?) (як-є решта) (як-є сполучити)
            (як-є функція)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше пяті-з-десяти) (як-є визначити)) так)
 (так (перше (як-є ()))))
(за-умовою
