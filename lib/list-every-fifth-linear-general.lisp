; СЕНС: кожний п'ятий елемент правильного списку (позиції 5, 10, 15...).
; Лінійний прохід, одна пара на п'ять елементів, без арифметики.
; Точні Д3–Д4 та українська проєкція; жодного SID8/Sens8.
(визначити взяти-кожний-пятий
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((порожній? (решта елементи)) (як-є ()))
   ((порожній? (решта (решта елементи))) (як-є ()))
   ((порожній? (решта (решта (решта елементи)))) (як-є ()))
   ((порожній? (решта (решта (решта (решта елементи))))) (як-є ()))
   (так
    (сполучити
     (перше (решта (решта (решта (решта елементи)))))
     (взяти-кожний-пятий
      (решта (решта (решта (решта (решта елементи)))))))))))

; Одна та дві п'ятірки; результат завжди зберігає вихідні атоми.
(визначити пяті-з-десяти
 (взяти-кожний-пятий
  (список (як-є атом?) (як-є решта) (як-є сполучити)
          (як-є функція) (як-є визначити)
          (як-є за-умовою) (як-є як-є) (як-є тотожне?)
          (як-є порожній?) (як-є хибне?))))

; Самодостатні виконувані свідки: помилка не приховується, а падає
; безпосередньо в СЕНС через ПЕРШЕ порожнього списку.
(за-умовою
 ((порожній? (взяти-кожний-пятий (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
