; Стабільний перетин мультимножин скінченних правильних списків атомів.
; Порядок лівого списку збережено; кратність дорівнює мінімуму кратностей.
; СЕНС Д3 і Д5 виконує, Д7 показує текст, Зіг переносить оборотний Т5М.
(визначити шукати-копію-для-перетину?
  (функція (шукане елементи)
    (за-умовою
      ((атом? елементи) (хибне? (атом? (як-є ()))))
      ((тотожне? шукане (перше елементи)) (атом? (як-є ())))
      ((атом? (як-є ()))
       (шукати-копію-для-перетину? шукане (решта елементи))))))
(визначити прибрати-копію-для-перетину
  (функція (шукане елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((тотожне? шукане (перше елементи)) (решта елементи))
      ((атом? (як-є ()))
       (сполучити (перше елементи)
         (прибрати-копію-для-перетину шукане (решта елементи)))))))
(визначити перетнути-мультимножини
  (функція (ліві праві)
    (за-умовою
      ((атом? ліві) (як-є ()))
      ((шукати-копію-для-перетину? (перше ліві) праві)
       (сполучити (перше ліві)
         (перетнути-мультимножини (решта ліві)
           (прибрати-копію-для-перетину (перше ліві) праві))))
      ((атом? (як-є ()))
       (перетнути-мультимножини (решта ліві) праві)))))
