; Друга частина мосту між контрольованим текстом та структурами знань.
; Модуль розуміння переводить список слів у твердження.
; Цей модуль виконує зворотну дію, повертаючи структуровані слова.
; Використовуються сталі структури й позиції елементів.
; Статистичного мовного аналізу немає.
; Пояснення факту обертає побудову факту чи відношення.
; Перетворення правильного речення в структуру та назад
; зберігає початковий порядок слів.
;
; Точні відповіді належать однобітному першому домену.
; Перевірки використовують спільний предикат правильного списку
; та ратифіковані селектори, кожен зі своєю доменною тотожністю.
;
; Пояснення походження обходить дерево доведення.
; Причини та поєднання складаються у словесний список.
; Пояснюється правило вузла, а не його мета.

; Форма списку перевіряється структурно, без числової довжини.
; Кожна гілка повертає точну відповідь першого домену.
; Порожність визначає ратифікований предикат четвертого домену.
; Порівняння атомів не застосовується до складених списків.
(визначити список-завершується-порожнім?
  (функція (значення)
    (за-умовою
      ((порожній? значення)
       (атом? (як-є ())))
      ((атом? значення)
       (атом? (як-є (()))))
      ((атом? (як-є ()))
       (список-завершується-порожнім? (решта значення))))))

; Точна кількість елементів перевіряється до доступу до хвостів.
; Неправильні форми відхиляються без небезпечного обходу.
(визначити список-із-рівно-двох-елементів?
  (функція (значення)
    (за-умовою
      ((хибне? (список-завершується-порожнім? значення))
       (атом? (як-є (()))))
      ((порожній? значення)
       (атом? (як-є (()))))
      ((атом? значення)
       (атом? (як-є (()))))
      ((порожній? (решта значення))
       (атом? (як-є (()))))
      ((порожній? (решта (решта значення)))
       (атом? (як-є ())))
      ((атом? (як-є ()))
       (атом? (як-є (())))))))

(визначити список-із-рівно-трьох-елементів?
  (функція (значення)
    (за-умовою
      ((хибне? (список-завершується-порожнім? значення))
       (атом? (як-є (()))))
      ((порожній? значення)
       (атом? (як-є (()))))
      ((атом? значення)
       (атом? (як-є (()))))
      ((порожній? (решта значення))
       (атом? (як-є (()))))
      ((порожній? (решта (решта значення)))
       (атом? (як-є (()))))
      ((порожній? (решта (решта (решта значення))))
       (атом? (як-є ())))
      ((атом? (як-є ()))
       (атом? (як-є (())))))))

(визначити пояснити-факт
  (функція (факт)
    (за-умовою
      ((список-із-рівно-двох-елементів? факт)
       (список (друге факт) (як-є is) (як-є a) (перше факт)))
      ((список-із-рівно-трьох-елементів? факт)
       (список (друге факт) (перше факт) (третє факт)))
      ((атом? (як-є ())) факт))))

(визначити походження-ціль (функція (запис-походження) (друге запис-походження)))
(визначити походження-джерело (функція (запис-походження) (друге (третє запис-походження))))
(визначити походження-правило (функція (запис-походження) (друге (четверте запис-походження))))
(визначити походження-похідний-з (функція (запис-походження) (друге (п'ятий запис-походження))))

(визначити пояснити-виведення
  (функція (виведення)
    (за-умовою
      ((атом? виведення) (як-є ()))
      ((атом? (решта виведення)) (пояснити-походження (перше виведення)))
      ((атом? (як-є ()))
       (приєднати (пояснити-походження (перше виведення))
         (сполучити (як-є and) (пояснити-виведення (решта виведення))))))))

(визначити пояснити-походження
  (функція (запис-походження)
    (за-умовою
      ((тотожне? (походження-джерело запис-походження) (як-є fact)) (пояснити-факт (походження-правило запис-походження)))
      ((атом? (як-є ()))
       (приєднати (пояснити-факт (походження-правило запис-походження))
         (сполучити (як-є because) (пояснити-виведення (походження-похідний-з запис-походження))))))))

; Пояснення відповіді зберігає справжню мету запиту
; разом із фактичними передумовами доведення.
; Умовний перехід для цілі — іменований SENS-виклик, не D5 value-call.
; Передумови не обчислюємо повторно і не підміняємо host-зв'язуванням.
(визначити пояснити-мету-з-передумовами
  (функція (мета виведення)
    (за-умовою
      ((атом? виведення) (пояснити-факт мета))
      ((атом? (як-є ()))
       (приєднати (пояснити-факт мета)
         (сполучити (як-є because) (пояснити-виведення виведення)))))))

(визначити пояснити-відповідь
  (функція (мета доказ)
    (пояснити-мету-з-передумовами
      мета
      (походження-похідний-з (побудувати-походження-вузла доказ)))))

; ----------------------------------------------------------------------
; Подання структурованих результатів міркування.
; ----------------------------------------------------------------------
; Безумовні умови використовують точну істину першого домену.
; Семантика належить бібліотеці станів результату.
; Ці функції перетворюють висновки на контрольовані слова.
; Вид результату зберігається явно.
; Невідомі, спірні, обмежені й недійсні висновки не змішуються.
; Структура списку перевіряється спільним предикатом.

; Пара полів підсумку обчислюється рівно один раз у SENS, без
; недопущеного застосування анонімної D5-функції як значення.
(визначити пояснити-результат-із-полів
  (функція (твердження результати)
    (за-умовою
      ((атом? результати)
       (список (як-є proved) твердження (як-є without-proof-result)))
      ((атом? (як-є ()))
       (приєднати
         (список (як-є proved))
         (пояснити-відповідь твердження (друге (перше результати))))))))

(визначити пояснити-результат-із-доказом
  (функція (підсумок)
    (пояснити-результат-із-полів (друге підсумок) (третє підсумок))))

(визначити пояснити-неприпустиму-структуру-результату
  (функція (підсумок)
    (список (як-є invalid) (як-є outcome-shape) підсумок)))

; Кількість полів результату визначають структурні предикати.

(визначити пояснити-підсумок
  (функція (підсумок)
    (за-умовою
      ((атом? підсумок) (пояснити-неприпустиму-структуру-результату підсумок))
      ((хибне? (результат-є-правильним-списком? підсумок))
       (пояснити-неприпустиму-структуру-результату підсумок))
      ; Фізична D7-мітка може бути списком гліфів, не атомом D3.
      ; Шість точних порівнянь нижче самі визначають закритий протокол;
      ; незнайома або неправильно вкладена голова доходить до invalid.
      ((внутрішня-рівність-версій (перше підсумок) (як-є proved))
       (за-умовою
         ((список-із-рівно-трьох-елементів? підсумок) (пояснити-результат-із-доказом підсумок))
         ((атом? (як-є ())) (пояснити-неприпустиму-структуру-результату підсумок))))
      ((внутрішня-рівність-версій (перше підсумок) (як-є unknown))
       (за-умовою
         ((список-із-рівно-двох-елементів? підсумок)
          (список
            (як-є unknown)
            (як-є because)
            (як-є no-proof-found-for)
            (друге підсумок)))
         ((атом? (як-є ())) (пояснити-неприпустиму-структуру-результату підсумок))))
      ((внутрішня-рівність-версій (перше підсумок) (як-є partial))
       (за-умовою
         ((список-із-рівно-трьох-елементів? підсумок)
          (список
            (як-є partial)
            (як-є value)
            (друге підсумок)
            (як-є bound)
            (третє підсумок)))
         ((атом? (як-є ())) (пояснити-неприпустиму-структуру-результату підсумок))))
      ((внутрішня-рівність-версій (перше підсумок) (як-є blocked))
       (за-умовою
         ((список-із-рівно-двох-елементів? підсумок)
          (список
            (як-є blocked)
            (як-є because)
            (друге підсумок)))
         ((атом? (як-є ())) (пояснити-неприпустиму-структуру-результату підсумок))))
      ((внутрішня-рівність-версій (перше підсумок) (як-є disputed))
       (за-умовою
         ((список-із-рівно-двох-елементів? підсумок)
          (список
            (як-є disputed)
            (як-є because)
            (як-є both-sides-have-evidence)
            (друге підсумок)))
         ((атом? (як-є ())) (пояснити-неприпустиму-структуру-результату підсумок))))
      ((внутрішня-рівність-версій (перше підсумок) (як-є invalid))
       (за-умовою
         ((список-із-рівно-трьох-елементів? підсумок)
          (список
            (як-є invalid)
            (як-є because)
            (друге підсумок)
            (як-є payload)
            (третє підсумок)))
         ((атом? (як-є ())) (пояснити-неприпустиму-структуру-результату підсумок))))
      ((атом? (як-є ()))
       (список (як-є invalid) (як-є outcome-tag) (перше підсумок))))))

; Основні українські замикання відповідають ратифікованим резидентам.
; Їхні адреси зберігаються в канонічних таблицях доменів.
; Дев'ятий домен: пояснення факту та підсумку — лише повна українська
; проєкція. Історичний англомовний DEFINE-псевдонім вилучено;
; цитовані протокольні значення залишаються даними.

; Десятий домен використовує безпосередньо українські визначення.
; Перевірку правильного списку вже визначено в четвертому ядрі.
; Не перевизначаємо її через сумісну англомовну назву.

; Первинні функції походження мають лише українські визначення;
; англійська колонка Д9 залишається історичною проєкцією, а не другою функцією.

; Два живих закони D1: правильна двійка і відмова для трійки.
; Помилка справжнього виконання доходить до ПЕРШЕ () без host-оракула.
(за-умовою
  ((список-із-рівно-двох-елементів? (як-є (а б)))
   (хибне? (список-із-рівно-двох-елементів? (як-є (а б в)))))
  (так (перше (як-є ()))))
