; СЕНС: найбільше точне число у скінченному правильному списку.
; Акумулятор явно переданий викликом, тому порожній вхід його зберігає.
; Д3-Д5 і математичні Д24+; без саморобного сід8 або хостової семантики.
; Один прохід і один рекурсивний виклик на елемент; вибір нового максимуму
; відбувається в акумуляторі. Жодного копіювання пар.
(визначити максимум-списку
 (функція (залишок най)
  (за-умовою
   ((атом? залишок) най)
   (так
    (максимум-списку
     (решта залишок)
     (за-умовою
      ((менше? най (перше залишок)) (перше залишок))
      (так най)))))))

; Усі закони виконує сам СЕНС. Хибний свідок викликає ПЕРШЕ від ().
(за-умовою
 ((тотожне? (максимум-списку (як-є ()) 7) 7) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (максимум-списку (список 3 1 4 1 5) 0) 5) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (максимум-списку (список 3 1 17 4 5) 0) 17) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (максимум-списку (список -7 -3 -12) -20) -3) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (максимум-списку (список 2 2 2) 2) 2) так)
 (так (перше (як-є ()))))
; Навіть атомарний або крапковий хвіст не викликає ПЕРШЕ від атома.
; Обробляємо тільки доступні пари; акумулятор залишається точним Д24+.
(за-умовою
 ((тотожне? (максимум-списку (як-є атом?) 7) 7) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (максимум-списку (сполучити 5 (як-є атом?)) 0) 5) так)
 (так (перше (як-є ()))))
; Негатив: не останній елемент і не початковий акумулятор.
(за-умовою
 ((хибне? (тотожне? (максимум-списку (список 3 1 4 1 5) 0) 4)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (тотожне? (максимум-списку (список -7 -3 -12) -20) -20)) так)
 (так (перше (як-є ()))))
(атом? (як-є ()))
