; СЕНС: найбільше точне число у скінченному правильному списку.
; Акумулятор явно переданий викликом, тому порожній вхід його зберігає.
; Д3-Д5 і математичні Д24+; без саморобного сід8 або хостової семантики.
; Один прохід і один рекурсивний виклик на елемент; вибір нового максимуму
; відбувається в акумуляторі. Жодного копіювання пар.
(визначити максимум-число-нуль (довжина (як-є ())))
(визначити максимум-число-один (довжина (як-є (а))))
(визначити максимум-число-два (довжина (як-є (а б))))
(визначити максимум-число-три (довжина (як-є (а б в))))
(визначити максимум-число-чотири (довжина (як-є (а б в г))))
(визначити максимум-число-п'ять (довжина (як-є (а б в г ґ))))
(визначити максимум-число-шість (довжина (як-є (а б в г ґ д))))
(визначити максимум-число-сім (довжина (як-є (а б в г ґ д е))))
(визначити максимум-число-вісім (довжина (як-є (а б в г ґ д е є))))
(визначити максимум-число-дев'ять (довжина (як-є (а б в г ґ д е є ж))))
(визначити максимум-число-десять (довжина (як-є (а б в г ґ д е є ж з))))
(визначити максимум-число-дванадцять (додати максимум-число-десять максимум-число-два))
(визначити максимум-число-сімнадцять (додати максимум-число-десять максимум-число-сім))
(визначити максимум-число-двадцять (помножити максимум-число-два максимум-число-десять))
(визначити максимум-число-мінус-три (відняти максимум-число-нуль максимум-число-три))
(визначити максимум-число-мінус-сім (відняти максимум-число-нуль максимум-число-сім))
(визначити максимум-число-мінус-дванадцять (відняти максимум-число-нуль максимум-число-дванадцять))
(визначити максимум-число-мінус-двадцять (відняти максимум-число-нуль максимум-число-двадцять))

(визначити максимум-списку
 (функція (залишок най)
  (за-умовою
   ((атом? залишок) най)
   (так
    (максимум-списку
     (решта залишок)
     (за-умовою
      ((менше? най (перше залишок)) (перше залишок))
      (так най)))))))

; Усі закони виконує сам СЕНС. Хибний свідок викликає ПЕРШЕ від ().
(за-умовою
 ((тотожне? (максимум-списку (як-є ()) максимум-число-сім) максимум-число-сім) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (максимум-списку (список максимум-число-три максимум-число-один максимум-число-чотири максимум-число-один максимум-число-п'ять) максимум-число-нуль) максимум-число-п'ять) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (максимум-списку (список максимум-число-три максимум-число-один максимум-число-сімнадцять максимум-число-чотири максимум-число-п'ять) максимум-число-нуль) максимум-число-сімнадцять) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (максимум-списку (список максимум-число-мінус-сім максимум-число-мінус-три максимум-число-мінус-дванадцять) максимум-число-мінус-двадцять) максимум-число-мінус-три) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (максимум-списку (список максимум-число-два максимум-число-два максимум-число-два) максимум-число-два) максимум-число-два) так)
 (так (перше (як-є ()))))
; Навіть атомарний або крапковий хвіст не викликає ПЕРШЕ від атома.
; Обробляємо тільки доступні пари; акумулятор залишається точним Д24+.
(за-умовою
 ((тотожне? (максимум-списку (як-є атом?) максимум-число-сім) максимум-число-сім) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (максимум-списку (сполучити максимум-число-п'ять (як-є атом?)) максимум-число-нуль) максимум-число-п'ять) так)
 (так (перше (як-є ()))))
; Негатив: не останній елемент і не початковий акумулятор.
(за-умовою
 ((хибне? (тотожне? (максимум-списку (список максимум-число-три максимум-число-один максимум-число-чотири максимум-число-один максимум-число-п'ять) максимум-число-нуль) максимум-число-чотири)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (тотожне? (максимум-списку (список максимум-число-мінус-сім максимум-число-мінус-три максимум-число-мінус-дванадцять) максимум-число-мінус-двадцять) максимум-число-мінус-двадцять)) так)
 (так (перше (як-є ()))))
(атом? (як-є ()))
