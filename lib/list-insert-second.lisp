; Вставити елемент другим у непорожній список, не змінюючи його решту.
; Закон Д3: перше(результат) = перше(вхід); друге(результат) = вставлене.
; Вилучення другого елемента повертає початковий список.
(визначити вставити-другим
  (функція (елементи вставлене)
    (сполучити (перше елементи)
      (сполучити вставлене (решта елементи)))))

(визначити початкова-трійка
  (список (як-є атом?) (як-є решта) (як-є тотожне?)))
(визначити четвірка-з-вставкою
  (вставити-другим початкова-трійка (як-є сполучити)))

; Нативний Д1: збережений перший, вставлений другий, незмінний
; третій і четвертий; негатив проти незміненого другого.
(за-умовою
  ((тотожне? (перше четвірка-з-вставкою) (як-є атом?))
   (за-умовою
     ((тотожне? (друге четвірка-з-вставкою) (як-є сполучити))
      (за-умовою
        ((тотожне?
           (перше (решта-решти четвірка-з-вставкою))
           (як-є решта))
         (за-умовою
           ((тотожне?
              (друге (решта-решти четвірка-з-вставкою))
              (як-є тотожне?))
            (хибне?
              (тотожне? (друге четвірка-з-вставкою) (як-є решта))))
           ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
