; Вставити елемент другим у непорожній список, не змінюючи його решту.
; Закон Д3: перше(результат) = перше(вхід); друге(результат) = вставлене.
; Вилучення другого елемента повертає початковий список.
(визначити вставити-другим
  (функція (елементи вставлене)
    (сполучити (перше елементи)
      (сполучити вставлене (решта елементи)))))

(визначити початкова-трійка
  (список (як-є атом?) (як-є решта) (як-є тотожне?)))
(визначити четвірка-з-вставкою
  (вставити-другим початкова-трійка (як-є сполучити)))

; Нативний Д1: збережений перший, вставлений другий, незмінний
; третій і четвертий; явний зворотний закон вилучення та негатив.
(за-умовою
  ((тотожне? (перше четвірка-з-вставкою) (як-є атом?))
   (за-умовою
     ((тотожне? (друге четвірка-з-вставкою) (як-є сполучити))
      (за-умовою
        ((тотожне?
           (перше (решта-решти четвірка-з-вставкою))
           (як-є решта))
         (за-умовою
           ((тотожне?
              (друге (решта-решти четвірка-з-вставкою))
              (як-є тотожне?))
            (за-умовою
              ((тотожне?
                 (друге
                   (сполучити
                     (перше четвірка-з-вставкою)
                     (решта-решти четвірка-з-вставкою)))
                 (друге початкова-трійка))
               (хибне?
                 (тотожне? (друге четвірка-з-вставкою) (як-є решта))))
              ((атом? (як-є ())) (перше (як-є ())))))
           ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))

; Обернений закон: вилучення вставленої комірки повертає
; попередню голову та точно той самий хвіст.
(визначити відновлена-трійка
  (сполучити (перше четвірка-з-вставкою) (решта-решти четвірка-з-вставкою)))
(за-умовою
  ((тотожне? (перше (решта відновлена-трійка))
              (перше (решта початкова-трійка)))
   (тотожне? (перше відновлена-трійка) (перше початкова-трійка)))
  ((атом? (як-є ())) (перше (як-є ()))))

; Зворотність на останньому елементі: після вилучення вставки
; третій елемент початкової трійки зберігає точну Д3 тотожність.
(за-умовою
  ((тотожне? (перше (решта-решти відновлена-трійка))
              (перше (решта-решти початкова-трійка)))
   (хибне? (тотожне? (друге четвірка-з-вставкою)
                     (друге початкова-трійка))))
  ((атом? (як-є ())) (перше (як-є ()))))
