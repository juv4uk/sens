; Д3 і Д4: переплітання (а б) і (в г) у (а в б г).
; Декомпозиція назад на дві вихідні пари без зміни їхніх елементів.
; Функції належать СЕНС, фізичний Т5М тільки переносить готові слова.
(визначити переплести-дві-пари
  (функція (ліва права)
    (список (перше ліва) (перше права) (друге ліва) (друге права))))

(визначити відновити-ліву-пару
  (функція (четвірка)
    (список (перше четвірка) (перше (решта-решти четвірка)))))

(визначити відновити-праву-пару
  (функція (четвірка)
    (список (друге четвірка) (друге (решта-решти четвірка)))))

(визначити початкова-ліва (список (як-є атом?) (як-є решта)))
(визначити початкова-права (список (як-є сполучити) (як-є тотожне?)))
(визначити переплетена-четвірка
  (переплести-дві-пари початкова-ліва початкова-права))
(визначити відновлена-ліва (відновити-ліву-пару переплетена-четвірка))
(визначити відновлена-права (відновити-праву-пару переплетена-четвірка))

; Чотири позиції, дві відновлені пари, два негативи, Д1=так.
(за-умовою
  ((тотожне? (перше переплетена-четвірка) (як-є атом?)) (за-умовою
  ((тотожне? (друге переплетена-четвірка) (як-є сполучити)) (за-умовою
  ((тотожне? (перше (решта-решти переплетена-четвірка)) (як-є решта)) (за-умовою
  ((тотожне? (друге (решта-решти переплетена-четвірка)) (як-є тотожне?)) (за-умовою
  ((тотожне? (перше відновлена-ліва) (як-є атом?)) (за-умовою
  ((тотожне? (друге відновлена-ліва) (як-є решта)) (за-умовою
  ((тотожне? (перше відновлена-права) (як-є сполучити)) (за-умовою
  ((тотожне? (друге відновлена-права) (як-є тотожне?)) (за-умовою
  ((хибне? (тотожне? (друге переплетена-четвірка) (як-є решта))) (за-умовою
