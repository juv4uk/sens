; порожній як елемент є атомом і завершує підрахунок.
; Лінійний прохід без хостового лічильника, Унісоде-обходів чи сід8.
(визначити довжина-початкових-пар-унарно
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((атом? (перше елементи)) (як-є ()))
   (так (сполучити (як-є ())
          (довжина-початкових-пар-унарно (решта елементи)))))))

(визначити однакова-унарна-довжина?
 (функція (ліве праве)
  (за-умовою
   ((порожній? ліве) (порожній? праве))
   ((порожній? праве) (хибне? (атом? (як-є ()))))
   (так (однакова-унарна-довжина? (решта ліве) (решта праве))))))

(визначити перевірити-початкові-пари
 (функція (елементи очікуване)
  (за-умовою
   ((однакова-унарна-довжина?
      (довжина-початкових-пар-унарно елементи) очікуване)
     (атом? (як-є ())))
   (так (перше (як-є ()))))))

