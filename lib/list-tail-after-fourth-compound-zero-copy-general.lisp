; СЕНС Д3 і Д5: повернути наявний хвіст ПІСЛЯ четвертого складеного
; елемента правильного списку. Жодного сполучити чи копії суфікса.
; О(н) за переглянутими елементами, О(1) за додатковими пари.
; Порожній () як елемент атомний; вкладений непорожній список - пара.

(визначити четверта-пара-лишилась-одна
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((атом? (перше елементи))
    (четверта-пара-лишилась-одна (решта елементи)))
   (так (решта елементи)))))

(визначити четверта-пара-лишилось-дві
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((атом? (перше елементи))
    (четверта-пара-лишилось-дві (решта елементи)))
   (так (четверта-пара-лишилась-одна (решта елементи))))))

(визначити четверта-пара-лишилось-три
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((атом? (перше елементи))
    (четверта-пара-лишилось-три (решта елементи)))
   (так (четверта-пара-лишилось-дві (решта елементи))))))

(визначити хвіст-після-четвертої-пари
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-четвертої-пари (решта елементи)))
   (так (четверта-пара-лишилось-три (решта елементи))))))

; Справжні закони виконує лише СЕНС. Якщо закон хибний - перше(порожній).
(за-умовою
 ((порожній? (хвіст-після-четвертої-пари (як-є ()))) так)
 (так (перше (як-є ()))))
; Чотирьох пар ще немає: повертається порожній.
(за-умовою
 ((порожній? (хвіст-після-четвертої-пари
   (список (як-є атом?) (список (як-є решта))
           (список (як-є функція)) (список (як-є сполучити))))) так)
 (так (перше (як-є ()))))
; Рівно чотири пари: суфікс порожній.
(за-умовою
 ((порожній? (хвіст-після-четвертої-пари
   (список (список (як-є атом?)) (список (як-є решта))
           (список (як-є функція)) (список (як-є сполучити))))) так)
 (так (перше (як-є ()))))
; П'ятий атом лишається першим у суфіксі.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-четвертої-пари
    (список (список (як-є атом?)) (список (як-є решта))
            (список (як-є функція)) (список (як-є сполучити))
            (як-є визначити))))
   (як-є визначити)) так)
 (так (перше (як-є ()))))
; Атоми між вкладеними парами не зараховуються до чотирьох.
(за-умовою
 ((тотожне?
   (перше (хвіст-після-четвертої-пари
    (список (список (як-є атом?)) (як-є ())
            (список (як-є решта)) (як-є атом?)
            (список (як-є функція)) (як-є сполучити)
            (список (як-є визначити)) (як-є решта))))
   (як-є решта)) так)
 (так (перше (як-є ()))))
; Суфікс починається зі складеного елемента - не сплющувати.
(за-умовою
 ((хибне?
   (атом? (перше (хвіст-після-четвертої-пари
    (список (список (як-є атом?)) (список (як-є решта))
            (список (як-є функція)) (список (як-є сполучити))
            (список (як-є визначити))))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
   (перше (перше (хвіст-після-четвертої-пари
    (список (список (як-є атом?)) (список (як-є решта))
            (список (як-є функція)) (список (як-є сполучити))
            (список (як-є визначити))))))
   (як-є визначити)) так)
 (так (перше (як-є ()))))
; Негативний свідок: початковий елемент не може зберегтися у хвості.
(за-умовою
 ((хибне?
   (тотожне?
    (перше (хвіст-після-четвертої-пари
     (список (як-є атом?) (список (як-є решта))
             (список (як-є функція)) (список (як-є сполучити))
             (список (як-є визначити)) (як-є решта))))
    (як-є атом?))) так)
 (так (перше (як-є ()))))
(атом? (як-є ()))
