; СЕНС: два квантори з коротким замиканням.
; Першокласний предикат — значення ратифікованого доменного коду,
; не D7-ім'я чи виклик іншого інтерпретатора.
; Для скінченного правильного списку кожний елемент перевіряємо
; не більш ніж один раз. Нових CONS-пар немає; O(n) у гіршому разі.
; Порожній список: ВСІ? = Д1:так, ІСНУЄ? = Д1:ні.

(визначити усі-за-першокласним-предикатом?
 (функція (умова елементи)
  (за-умовою
   ((порожній? елементи) так)
   ((умова (перше елементи))
    (усі-за-першокласним-предикатом?
     умова (решта елементи)))
   (так ні))))

(визначити існує-за-першокласним-предикатом?
 (функція (умова елементи)
  (за-умовою
   ((порожній? елементи) ні)
   ((умова (перше елементи)) так)
   (так
    (існує-за-першокласним-предикатом?
     умова (решта елементи))))))

; Д3 АТОМ? передається як точна першокласна функція.
; Порожній список: вакуумна загальність та відсутність свідка.
(за-умовою
 ((усі-за-першокласним-предикатом? атом? (як-є ())) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (існує-за-першокласним-предикатом? атом? (як-є ()))) так)
 (так (перше (як-є ()))))

; Всі три атоми: обидва квантори істинні.
(за-умовою
 ((усі-за-першокласним-предикатом?
   атом? (список (як-є атом?) (як-є решта) (як-є сполучити))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((існує-за-першокласним-предикатом?
   атом? (список (як-є атом?) (як-є решта) (як-є сполучити))) так)
 (так (перше (як-є ()))))

; Вкладена пара не є атомом: загальність хибна, існування істинне.
(за-умовою
 ((хибне?
   (усі-за-першокласним-предикатом?
    атом? (список (як-є атом?) (список (як-є решта))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((існує-за-першокласним-предикатом?
   атом? (список (список (як-є решта)) (як-є атом?))) так)
 (так (перше (як-є ()))))

; Лише складені пари: у Д3 немає жодного атомного свідка.
(за-умовою
 ((хибне?
   (існує-за-першокласним-предикатом?
    атом? (список (список (як-є атом?))
                  (список (як-є решта))))) так)
 (так (перше (як-є ()))))

; Інша першокласна функція: Д4 ПОРОЖНІЙ? відрізняє ()
; від інших атомів і від усіх непорожніх пар.
(за-умовою
 ((існує-за-першокласним-предикатом?
   порожній? (список (як-є атом?) (як-є ()) (як-є решта))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне?
   (усі-за-першокласним-предикатом?
    порожній? (список (як-є ()) (як-є атом?)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((усі-за-першокласним-предикатом?
   порожній? (список (як-є ()) (як-є ()))) так)
 (так (перше (як-є ()))))

; Коротке замикання: правий хвіст навмисно не є правильним списком.
; Перший атом дає існування; перша пара одразу спростовує загальність.
; Якщо алгоритм читає цей хвіст, SENS має відхилити його як пару.
(за-умовою
 ((існує-за-першокласним-предикатом?
   атом? (сполучити (як-є атом?) (як-є решта))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне?
   (усі-за-першокласним-предикатом?
    атом? (сполучити (список (як-є решта)) (як-є атом?)))) так)
 (так (перше (як-є ()))))

; Завершальний реальний SENS Д1:1, а не хостова підміна.
(атом? (як-є ()))
