; Конкурс щільності: перемежування трьох скінченних списків ротацією аргументів.
; Один лінійний прохід О(н); без довжини, додавання в кінець і проміжних списків.
; Порядок: л1 с1 п1 л2 с2 п2 ...; непарні хвости не губляться.
; Ротація трьох аргументів; коли лишається один список, повертаємо хвіст без копіювання.
; Семантика - власна рекурсія СЕНС Д3 і Д5. Д7 - клавіатурна проєкція,
; Зіг і Т5М - лише фізичний транспорт, не виконавець значення.

(визначити перемежувати-три-списки
 (функція (ліві середні праві)
  (за-умовою
   ((порожній? ліві)
    (за-умовою
     ((порожній? середні) праві)
     ((порожній? праві) середні)
     (так
      (перемежувати-три-списки середні праві ліві))))
   (так
    (сполучити (перше ліві)
     (перемежувати-три-списки
      середні праві (решта ліві)))))))

; Рекурсивна Д3 рівність довільних дерев, ніколи ЕК над парою.
(визначити дерева-перемежування-трьох-однакові?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((дерева-перемежування-трьох-однакові?
     (перше ліве) (перше праве))
    (дерева-перемежування-трьох-однакові?
     (решта ліве) (решта праве)))
   (так ні))))

; Хибний закон спричиняє справжню помилку перше(порожній) в СЕНС.
(визначити перевірити-перемежування-трьох
 (функція (ліві середні праві очікування)
  (за-умовою
   ((дерева-перемежування-трьох-однакові?
     (перемежувати-три-списки ліві середні праві)
     очікування)
    так)
   (так (перше (як-є ()))))))

