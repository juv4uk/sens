; Вилучити тільки останнє входження точного атома зі скінченного списку.
; Попередні входження зберігаються на своїх місцях.
; Усі перевірки виконує СЕНС. Транспорт Т5М не визначає семантику.

(визначити є-атом-у-списку?
 (функція (елементи шукане)
  (за-умовою
   ((порожній? елементи) ні)
   ((тотожне? (перше елементи) шукане) так)
   (так (є-атом-у-списку? (решта елементи) шукане)))))

(визначити вилучити-останній-збіг
 (функція (елементи шукане)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((тотожне? (перше елементи) шукане)
    (за-умовою
     ((є-атом-у-списку? (решта елементи) шукане)
      (сполучити (перше елементи)
       (вилучити-останній-збіг (решта елементи) шукане)))
     (так (решта елементи))))
   (так
    (сполучити (перше елементи)
     (вилучити-останній-збіг (решта елементи) шукане))))))

(визначити однакові-списки-послідовно?
 (функція (лівий правий)
  (за-умовою
   ((порожній? лівий) (порожній? правий))
   ((порожній? правий) ні)
   ((тотожне? (перше лівий) (перше правий))
    (однакові-списки-послідовно? (решта лівий) (решта правий)))
   (так ні))))

; Не маскуємо невірні закони успішним результатом.
; Хибний закон призводить до справжнього недопущеного ПЕРШЕ порожнього.
(визначити підтвердити-закон
 (функція (правда)
  (за-умовою
   (правда (атом? (як-є ())))
   (так (перше (як-є ()))))))

(підтвердити-закон
 (порожній?
  (вилучити-останній-збіг (як-є ()) (як-є атом?))))

(підтвердити-закон
 (порожній?
  (вилучити-останній-збіг (список (як-є атом?)) (як-є атом?))))

(підтвердити-закон
 (однакові-списки-послідовно?
  (вилучити-останній-збіг (список (як-є решта)) (як-є атом?))
  (список (як-є решта))))

(підтвердити-закон
 (однакові-списки-послідовно?
  (вилучити-останній-збіг
   (список (як-є атом?) (як-є решта) (як-є атом?))
   (як-є атом?))
  (список (як-є атом?) (як-є решта))))

(підтвердити-закон
 (однакові-списки-послідовно?
  (вилучити-останній-збіг
   (список (як-є атом?) (як-є решта) (як-є решта))
   (як-є решта))
  (список (як-є атом?) (як-є решта))))

(підтвердити-закон
 (однакові-списки-послідовно?
  (вилучити-останній-збіг
   (список (як-є атом?) (як-є атом?) (як-є атом?))
   (як-є атом?))
  (список (як-є атом?) (як-є атом?))))

(підтвердити-закон
 (однакові-списки-послідовно?
  (вилучити-останній-збіг
   (список (як-є атом?) (як-є решта) (як-є атом?)
           (як-є решта) (як-є атом?))
   (як-є атом?))
  (список (як-є атом?) (як-є решта) (як-є атом?) (як-є решта))))

(підтвердити-закон
 (однакові-списки-послідовно?
  (вилучити-останній-збіг
   (список (як-є атом?) (як-є решта) (як-є сполучити))
   (як-є за-умовою))
  (список (як-є атом?) (як-є решта) (як-є сполучити))))

(підтвердити-закон
 (є-атом-у-списку?
  (список (як-є решта) (як-є атом?) (як-є сполучити))
  (як-є атом?)))

(підтвердити-закон
 (хибне? (є-атом-у-списку? (як-є ()) (як-є атом?))))

(підтвердити-закон
 (хибне?
  (є-атом-у-списку?
   (список (як-є решта) (як-є сполучити)) (як-є атом?))))

; Негативні свідки: неправильний порядок і видалення першого входження.
(підтвердити-закон
 (хибне?
  (однакові-списки-послідовно?
   (вилучити-останній-збіг
    (список (як-є атом?) (як-є решта) (як-є атом?))
    (як-є атом?))
   (список (як-є решта) (як-є атом?)))))

(підтвердити-закон
 (хибне?
  (однакові-списки-послідовно?
   (вилучити-останній-збіг
    (список (як-є атом?) (як-є решта) (як-є атом?))
    (як-є атом?))
   (список (як-є атом?) (як-є атом?)))))

(атом? (як-є ()))
