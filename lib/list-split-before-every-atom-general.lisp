; Втратонезалежне розділення правильного списку атомів перед КОЖНИМ входженням.
; Кожен роздільник залишається першим атомом своєї наступної частини.
; Порожня частина на початку фіксує входження роздільника на першій позиції.
; Пара (розділити, зібрати) є оберненою для будь-якого скінченного списку.
; Точне обчислення виконує СЕНС Д3 і Д4, Зіґ переносить фізичні байти Т5М.

(визначити вставити-перед-кожним-атомом
  (функція (голова шукане готові-частини)
    (за-умовою
      ((тотожне? голова шукане)
       (сполучити (як-є ())
         (сполучити
           (сполучити голова (перше готові-частини))
           (решта готові-частини))))
      ((атом? (як-є ()))
       (сполучити
         (сполучити голова (перше готові-частини))
         (решта готові-частини))))))

(визначити розділити-перед-кожним
  (функція (елементи шукане)
    (за-умовою
      ((порожній? елементи) (список (як-є ())))
      ((атом? (як-є ()))
       (вставити-перед-кожним-атомом
         (перше елементи)
         шукане
         (розділити-перед-кожним (решта елементи) шукане))))))

(визначити долучити-частину-до-хвоста
  (функція (частина хвіст)
    (за-умовою
      ((порожній? частина) хвіст)
      ((атом? (як-є ()))
       (сполучити
         (перше частина)
         (долучити-частину-до-хвоста (решта частина) хвіст))))))

(визначити зібрати-всі-частини
  (функція (частини)
    (за-умовою
      ((порожній? частини) (як-є ()))
      ((атом? (як-є ()))
       (долучити-частину-до-хвоста
         (перше частини)
         (зібрати-всі-частини (решта частини)))))))

(визначити початкові-атоми-усіх-поділів
  (список (як-є атом?) (як-є решта) (як-є атом?)
          (як-є атом?) (як-є сполучити) (як-є атом?)))
(визначити усі-поділені-частини
  (розділити-перед-кожним початкові-атоми-усіх-поділів (як-є атом?)))
(визначити відновлені-атоми-усіх-поділів
  (зібрати-всі-частини усі-поділені-частини))

