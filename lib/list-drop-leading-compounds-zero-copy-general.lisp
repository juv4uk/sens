; СЕНС: повернути наявний хвіст списку, починаючи з першого атома.
; Складені елементи на початку пропускаються, порожній як елемент є атомом.
; Один прохід до першого атома, нуль нових сполучень, без копіювання хвоста.
; Порожній список і список лише зі складених елементів дають порожній результат.
; Закони виконуються самим СЕНС; Д7 лише людиночитана проєкція.

(визначити хвіст-від-першого-атома
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((атом? (перше елементи)) елементи)
   (так (хвіст-від-першого-атома (решта елементи))))))

; Позитивні свідки. Якщо закон хибний, СЕНС виконає перше від порожнього.
(за-умовою
 ((порожній? (хвіст-від-першого-атома (як-є ()))) так)
 (так (перше (як-є ()))))

(за-умовою
 ((порожній?
   (хвіст-від-першого-атома
    (список (список (як-є атом?)) (список (як-є решта))))) так)
 (так (перше (як-є ()))))

(за-умовою
 ((тотожне?
   (перше (хвіст-від-першого-атома (список (як-є атом?))))
   (як-є атом?)) так)
 (так (перше (як-є ()))))

(за-умовою
 ((тотожне?
   (перше (хвіст-від-першого-атома
    (список (список (як-є решта)) (як-є атом?) (як-є сполучити))))
   (як-є атом?)) так)
 (так (перше (як-є ()))))

(за-умовою
 ((тотожне?
   (друге (хвіст-від-першого-атома
    (список (список (як-є решта)) (як-є атом?) (як-є сполучити))))
   (як-є сполучити)) так)
 (так (перше (як-є ()))))

(за-умовою
 ((порожній?
   (решта-решти (хвіст-від-першого-атома
    (список (список (як-є решта)) (як-є атом?) (як-є сполучити))))) так)
 (так (перше (як-є ()))))

; Порожній елемент не можна плутати з відсутнім елементом.
(за-умовою
 ((порожній?
   (перше (хвіст-від-першого-атома
    (список (список (як-є атом?)) (як-є ()) (як-є решта))))) так)
 (так (перше (як-є ()))))

(за-умовою
 ((тотожне?
   (друге (хвіст-від-першого-атома
    (список (список (як-є атом?)) (як-є ()) (як-є решта))))
   (як-є решта)) так)
 (так (перше (як-є ()))))

(за-умовою
 ((порожній?
   (решта-решти (хвіст-від-першого-атома
    (список (список (як-є атом?)) (як-є ()) (як-є решта))))) так)
 (так (перше (як-є ()))))

; Перший атом на початку: результат не відкидає початкового елемента.
(за-умовою
 ((тотожне?
   (перше (хвіст-від-першого-атома
    (список (як-є сполучити) (список (як-є атом?)))))
   (як-є сполучити)) так)
 (так (перше (як-є ()))))

(за-умовою
 ((хибне?
   (атом? (друге (хвіст-від-першого-атома
    (список (як-є сполучити) (список (як-є атом?))))))) так)
 (так (перше (як-є ()))))

; Негативні свідки: не повертати складений початковий елемент.
(за-умовою
 ((хибне?
   (тотожне?
    (перше (хвіст-від-першого-атома
     (список (список (як-є атом?)) (як-є решта))))
    (як-є атом?))) так)
 (так (перше (як-є ()))))

(за-умовою
 ((хибне?
   (тотожне?
    (перше (хвіст-від-першого-атома
     (список (список (як-є решта)) (як-є атом?) (як-є сполучити))))
    (як-є сполучити))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
