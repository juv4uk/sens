; Усі розрізи скінченного списку атомів зберігають обидві частини.
; На вході н атомів, на виході н+1 пара (префікс суфікс).
; Доказ: кожну пару можна знову сполучити у початковий список.
; Семантику виконує СЕНС, Д7 є лише людською проєкцією.

(визначити дописати-розріз
  (функція (ліві праві)
    (за-умовою
      ((порожній? ліві) праві)
      ((атом? (як-є ()))
       (сполучити (перше ліві) (дописати-розріз (решта ліві) праві))))))

(визначити всі-розрізи-від
  (функція (ліві праві)
    (за-умовою
      ((порожній? праві) (список (список ліві праві)))
      ((атом? (як-є ()))
       (сполучити
         (список ліві праві)
         (всі-розрізи-від
           (дописати-розріз ліві (список (перше праві)))
           (решта праві)))))))

(визначити всі-розрізи
  (функція (елементи)
    (всі-розрізи-від (як-є ()) елементи)))

(визначити однакові-списки-атомів?
  (функція (ліві праві)
    (за-умовою
      ((порожній? ліві) (порожній? праві))
      ((порожній? праві) ні)
      ((тотожне? (перше ліві) (перше праві))
       (однакові-списки-атомів? (решта ліві) (решта праві)))
      ((атом? (як-є ())) ні))))

(визначити усі-розрізи-відновлюють?
  (функція (розрізи початкові)
    (за-умовою
      ((порожній? розрізи) так)
      ((однакові-списки-атомів?
         (дописати-розріз
           (перше (перше розрізи))
           (друге (перше розрізи)))
         початкові)
       (усі-розрізи-відновлюють? (решта розрізи) початкові))
      ((атом? (як-є ())) ні))))

(визначити вхід
  (список (як-є атом?) (як-є решта) (як-є сполучити)))
(визначити розрізи (всі-розрізи вхід))
(визначити нульові (всі-розрізи (як-є ())))
(визначити одинарні (всі-розрізи (список (як-є атом?))))
(визначити пошкоджені
  (список (список (список (як-є атом?)) (список (як-є сполучити)))))

; Справжні позитивні та негативні Д1 закони.
; Кожна хиба переходить до помилки ПЕРШЕ від порожнього списку.
(за-умовою
  ((усі-розрізи-відновлюють? розрізи вхід)
   (за-умовою
  ((усі-розрізи-відновлюють? нульові (як-є ()))
   (за-умовою
  ((усі-розрізи-відновлюють? одинарні (список (як-є атом?)))
   (за-умовою
  ((хибне? (усі-розрізи-відновлюють? пошкоджені вхід))
   (за-умовою
  ((порожній? (перше (перше розрізи)))
   (за-умовою
  ((однакові-списки-атомів? (друге (перше розрізи)) вхід)
   (за-умовою
  ((однакові-списки-атомів? (перше (друге розрізи)) (список (як-є атом?)))
   (за-умовою
  ((однакові-списки-атомів? (друге (друге розрізи)) (список (як-є решта) (як-є сполучити)))
   (за-умовою
  ((однакові-списки-атомів? (перше (третє розрізи)) (список (як-є атом?) (як-є решта)))
   (за-умовою
  ((однакові-списки-атомів? (друге (третє розрізи)) (список (як-є сполучити)))
   (за-умовою
  ((однакові-списки-атомів? (перше (перше (решта (решта (решта розрізи))))) вхід)
   (за-умовою
  ((порожній? (друге (перше (решта (решта (решта розрізи))))))
   (за-умовою
  ((порожній? (решта (решта (решта (решта розрізи)))))
   (за-умовою
  ((порожній? (перше (перше нульові)))
   (за-умовою
  ((порожній? (друге (перше нульові)))
   (за-умовою
  ((порожній? (решта нульові))
   (за-умовою
  ((порожній? (перше (перше одинарні)))
   (за-умовою
  ((однакові-списки-атомів? (друге (перше одинарні)) (список (як-є атом?)))
   (за-умовою
  ((однакові-списки-атомів? (перше (друге одинарні)) (список (як-є атом?)))
   (за-умовою
  ((порожній? (друге (друге одинарні)))
   (за-умовою
  ((порожній? (решта (решта одинарні)))
   (за-умовою
  ((хибне? (однакові-списки-атомів? (перше (друге розрізи)) (список (як-є решта))))
   (за-умовою
  ((хибне? (усі-розрізи-відновлюють? розрізи (список (як-є атом?) (як-є решта))))
   (за-умовою
  ((хибне? (усі-розрізи-відновлюють? (список (список (як-є ()) (список (як-є атом?)))) (як-є ())))
   (атом? (як-є ())))
