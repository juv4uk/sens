; Д6:111100 ANY — екзистенційний обхід Д3 перше/решта і Д4 NULL.
; Порожній список: Д1:NO; знайдений свідок: Д1:YES. FILTER не потрібен.
(визначити будь-яке?
  (функція (умова елементи)
    (за-умовою
      ((порожній? елементи) ні)
      ((умова (перше елементи)) так)
      (так (будь-яке? умова (решта елементи))))))

; Д6:111101 ALL — універсальний обхід, порожній список = Д1:YES.
; Відмова при першому Д1:НІ; без неявної істинності зовнішнього виконавця чи FILTER.
(визначити усі?
  (функція (умова елементи)
    (за-умовою
      ((порожній? елементи) так)
      ((умова (перше елементи)) (усі? умова (решта елементи)))
      (так ні))))


