; Д9:101100101 MAP-GET — значення асоціативної пари через решта.
(визначити мапа-отримати
  (функція (ключ мапа)
    (за-умовою
      ((порожній? (знайти-за-ключем ключ мапа)) (як-є ()))
      ((хибне? (порожній? (знайти-за-ключем ключ мапа)))
       (решта (знайти-за-ключем ключ мапа))))))

; Д9:101100010 MAP-CONTAINS?
(визначити мапа-містить?
  (функція (ключ мапа)
    (хибне? (порожній? (знайти-за-ключем ключ мапа)))))

; Д9:101001100 MAP->LIST — асоціативний список уже є списком.
(визначити мапа-список
  (функція (мапа) мапа))

