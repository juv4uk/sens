; Д5:11110 PAIRLIS — структурний закон, що належить самому Лісп.
; Точне доменне зв'язування задає українська поверхня,
; англійський запис залишається тільки сумісним посиланням.
; Для порожнього списку ключів повертаємо хвіст.
; Для непорожнього списку створюємо пари в початковому порядку.
(визначити спарувати
  (функція (ключі значення-аргументів хвіст)
    (за-умовою
      ; Тільки структурне D3:() завершує обидва списки.
      ((порожній? ключі)
       (за-умовою
         ((порожній? значення-аргументів) хвіст)
         (так (перше (як-є ())))))
      ; D1:ні та сторонній атом не є кінцем списку.
      ((атом? ключі) (перше ключі))
      ((порожній? значення-аргументів) (перше значення-аргументів))
      ((атом? значення-аргументів) (перше значення-аргументів))
      (так
       (сполучити
         (сполучити (перше ключі) (перше значення-аргументів))
         (спарувати (решта ключі) (решта значення-аргументів) хвіст))))))


(визначити нехай-послідовно
  (макрос
    (функція (привязки тіло)
      (за-умовою
        ((підтвердити-д6-привязки привязки)
         (за-умовою
           ((порожній? привязки) тіло)
           (так
            (сполучити
              (як-є нехай)
              (сполучити
                (сполучити (перше привязки) (як-є ()))
                (сполучити
                  (сполучити (як-є нехай-послідовно)
                            (сполучити (решта привязки)
                                       (сполучити тіло (як-є ()))))
                  (як-є ())))))))
        (так (перше (як-є ())))))))

; Тимчасове сумісне ім'я для наявних викликів під час переходу поверхні.

; Д6:001011 COMPOSE / Д6:101101 FLIP — похідні функції, виведені лише з Д4 lambda.
; Координати вже ратифіковані (бібліотека/domains/d6.лісп), механізм — ні
; (knowledge/d6-mechanism-ledger.json: mechanism_status=MISSING). Визначаємо їх
; мовою СЕНС через наявний Д4:0010 LAMBDA, без нових координат і без Rust.
; `скласти-функції f g` → (λ (x) (f (g x))) — права композиція.
(визначити скласти-функції
  (функція (функція-ф функція-г)
    (функція (аргумент-х)
      (функція-ф (функція-г аргумент-х)))))

; `поміняти-аргументи f` → (λ (a b) (f b a)) — зміна порядку двох аргументів.
(визначити поміняти-аргументи
  (функція (функція-ф)
    (функція (перший-аргумент другий-аргумент)
      (функція-ф другий-аргумент перший-аргумент))))

; Англійські псевдоніми вже визначених функцій Д6 не створюють нових законів.

; Д6:001101 — ACONS, приєднати пару ключ/значення до асоціацій.
; Лише два застосування Д3:111 CONS; це не допуск прямого виклику Д6.
(визначити додати-асоціацію
  (функція (ключ значення асоціації)
    (сполучити (сполучити ключ значення) асоціації)))



