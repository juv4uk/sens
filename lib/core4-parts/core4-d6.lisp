; core4 · блок «core4-d6» · похідний фрагмент канонічного SENS Core4
; похідні D5/D6: членство, асоціації та спискові закони
; Авторитетна точка входу: lib/core4.lisp; виконання й фізичний mint належать SENS/Zig/T5M.
(визначити значення-у-списку?-ядро
  (функція (елемент список-значень знайдено)
    (за-умовою
      ; D1:ні не є термінатором D3:(); відхилити атомний хвіст до empty-check.
      ((тотожне? список-значень ні) (перше список-значень))
      ((порожній? список-значень) знайдено)
      ((атом? список-значень) (перше список-значень))
      (знайдено
       (значення-у-списку?-ядро
         елемент (решта список-значень) так))
      ((однакові? елемент (перше список-значень))
       (значення-у-списку?-ядро
         елемент (решта список-значень) так))
      (так
       (значення-у-списку?-ядро
         елемент (решта список-значень) ні)))))

(визначити значення-у-списку?
  (функція (елемент список-значень)
    (значення-у-списку?-ядро елемент список-значень ні)))

; Д5:11100 ASSOC. Один структурний пошук через Д3 перше/решта.
; Д5:11100 ASSOC (saṃbandha): пошук першої пари з повним
; доказом форми D3-списку, а не рання відповідь до перевірки хвоста.
; Д1:ні позначає тільки факт знайденого; значення запису незмінне.
(визначити знайти-за-ключем-ядро
  (функція (ключ список-пар знайдено запис)
    (за-умовою
      ; D1:ні не є термінатором D3:(); не приховувати пошкоджений хвіст ASSOC.
      ((тотожне? список-пар ні) (перше список-пар))
      ((порожній? список-пар)
       (за-умовою
         (знайдено запис)
         (так (як-є ()))))
      ((атом? список-пар) (перше список-пар))
      ((порожній? (перше список-пар)) (перше (перше список-пар)))
      ((атом? (перше список-пар)) (перше (перше список-пар)))
      (знайдено
       (знайти-за-ключем-ядро
         ключ (решта список-пар) так запис))
      ((однакові? ключ (перше (перше список-пар)))
       (знайти-за-ключем-ядро
         ключ (решта список-пар) так (перше список-пар)))
      (так
       (знайти-за-ключем-ядро
         ключ (решта список-пар) ні запис)))))

(визначити знайти-за-ключем
  (функція (ключ список-пар)
    (знайти-за-ключем-ядро ключ список-пар ні (як-є ()))))

