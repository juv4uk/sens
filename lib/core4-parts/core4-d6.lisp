; Похідні функції списку асоціацій Д9 із
; research/d9-map-insert-store-batch-2026-10-17.лісп.
; Д9:101101110 MAP-INSERT — додаємо пару спереду та прибираємо старий ключ.
(визначити мапа-вставити
  (функція (ключ значення мапа)
    (сполучити
      (сполучити ключ (сполучити значення (як-є ())))
      (відсіяти
        (функція (пара) (хибне? (однакові? (перше пара) ключ)))
        мапа))))

