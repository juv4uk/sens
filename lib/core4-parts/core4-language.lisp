(визначити тотожність (функція (значення-аргументу) значення-аргументу))

; Десяткові числа людської проєкції T5M кодує як точні D12+.
; Корені — звичайні математичні значення, визначені мовою.
(визначити число-нуль 0)
(визначити число-один 1)

; Решта часто вживаних чисел визначається після реалізації довжини.

; Не вводимо загальний бінарний літерал із параметром ширини:
; ідентичність визначається точним доменом і його ратифікованими бітами.
; У виконуваному джерелі математичні значення мають іменовані D12+ проєкції.

; Д4:1110 список — чинний канонічний механізм СЕНС, а не
; локальна бібліотечна функція. Він утворює правильний список
; із усіх обчислених аргументів; повторне DEFINE ратифікованої
; незмінної тотожності до нього заборонене.
; Виклики (список ...) нижче використовують сам чинний Д4:1110.
; Сумісні англомовні назви залишаються псевдонімами тих самих Лісп-значень.

; Логічні та й або - мовні макроси з коротким замиканням.
; Перевірений аргумент має повертати точний однобітний результат.
; Числовий нуль не є порожнім списком чи істинністю стороннього виконавця.
; Кожна гілка умов має два поля: перевірка та результат.
; Останній аргумент повертається як значення без додаткової перевірки.
(визначити та
  (макрос
    (функція аргументи
      (за-умовою
        ((атом? аргументи) (як-є (атом? (як-є ()))))
        ((атом? (решта аргументи)) (перше аргументи))
        (так
         (список
           (як-є за-умовою)
           (список
             (перше аргументи)
             (сполучити (як-є та) (решта аргументи)))
           (список (як-є так) (як-є ні))))))))

(визначити або
  (макрос
    (функція аргументи
      (за-умовою
        ((атом? аргументи)
         (як-є (атом? (сполучити (як-є ()) (як-є ())))))
        ((атом? (решта аргументи)) (перше аргументи))
        (так
         (список
           (як-є за-умовою)
           (список (перше аргументи) (як-є так))
           (список
             (як-є так)
             (сполучити (як-є або) (решта аргументи)))))))))

; Історичні латинські назви макросів — тільки сумісні псевдоніми.

; Створення свіжого символу не означає автоматичну гігієну макроса.
; Звичайне розгортання макроса може захопити змінну з оточення.
; Історичний дослід гігієни макросів датовано 27 серпня 2026 року.
; Допущений годинник десятого домену разом із текстовими та
; символьними операціями утворює новий символ.
; Префікс обов'язковий; значення за замовчуванням поки не додаємо без
; реального потребуючого виклику.
(визначити створити-символ
  (функція (префікс)
    (текст-у-символ (рядок-додати префікс (значення-у-текст (монотонний-наносекунди))))))


; Допоміжний конструктор списку з двох значень.
; Він відмінний від Д8 "пара", що спарює дві послідовності.
(визначити створити-список-із-двох-значень
  (функція (лівий-аргумент правий-аргумент)
    (сполучити лівий-аргумент (сполучити правий-аргумент (як-є ())))))

