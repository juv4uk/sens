; Півоберт чотирьох Д3-елементів; два застосування відновлюють порядок.
; Самостійна українська СЕНС-програма з позитивним, оберненим і негативним свідками.
(визначити півоберт-четвірки
  (функція (елементи)
    (список
      (перше (решта (решта елементи)))
      (перше (решта (решта (решта елементи))))
      (перше елементи)
      (перше (решта елементи))
    )))
(визначити вхід-півоберт-четвірки
  (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?)))
(визначити вихід-півоберт-четвірки (півоберт-четвірки вхід-півоберт-четвірки))
(визначити обернення-півоберт-четвірки (півоберт-четвірки вихід-півоберт-четвірки))

; Закон Д1: усі чотири позиції, обернення і негатив.
(за-умовою
  ((тотожне? (перше вихід-півоберт-четвірки) (як-є сполучити))
    (за-умовою
  ((тотожне? (перше (решта вихід-півоберт-четвірки)) (як-є тотожне?))
    (за-умовою
  ((тотожне? (перше (решта (решта вихід-півоберт-четвірки))) (як-є атом?))
    (за-умовою
  ((тотожне? (перше (решта (решта (решта вихід-півоберт-четвірки)))) (як-є решта))
    (за-умовою
  ((тотожне? (перше обернення-півоберт-четвірки) (як-є атом?))
    (за-умовою
  ((тотожне? (перше (решта обернення-півоберт-четвірки)) (як-є решта))
    (за-умовою
  ((тотожне? (перше (решта (решта обернення-півоберт-четвірки))) (як-є сполучити))
    (за-умовою
  ((тотожне? (перше (решта (решта (решта обернення-півоберт-четвірки)))) (як-є тотожне?))
    (за-умовою
  ((хибне? (тотожне? (перше вихід-півоберт-четвірки) (як-є атом?)))
