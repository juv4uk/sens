; Д11: Схем СРФІ-1 УНФОЛД  і  УНФОЛД-РІГНТ (анаморпгісм, апоморпгісм).
; Стандарт: гттпс: і  і срфі.ссгемерс.орг і срфі-1 і срфі-1.гтмл
; Скінченне породження правильного списку: зупинка, вивід, наступний стан.
; Кожен саллбаск - справжнє лексичне замикання СЕНС; немає зовнішнє евал.
; Усі п'ять аргументів явні: жодного крапкового і необов'язкового
; параметра, автоперекодування або додаткової машинної команди Д11.
; Породжувальна функція не викликається після виконання умови зупинки.
; Кінець УНФОЛД створюється окремим замиканням від фінального стану.
; Кінець УНФОЛД-РІГНТ є явним значенням, ніколи не обчислюється наново.
; Завершальний хвіст — завжди правильний D3-список, не атом чи крапкова пара.

; D11: завершальний хвіст має бути правильним D3-списком.
; Точне D3:() є єдиним кінцем. Атом D1/D7 та крапкова пара
; мають завершитися справжнім D3 Type через ПЕРШЕ.
; Початкове значення повертаємо без копіювання та зміни порядку.
(визначити підтвердити-кінцевий-список-розгортання
  (функція (поточний початковий)
    (за-умовою
      ((порожній? поточний) початковий)
      ((атом? поточний) (перше поточний))
      (так
       (підтвердити-кінцевий-список-розгортання
         (решта поточний) початковий)))))

; Значення генератора обчислюється рівно один раз.
(визначити перевірити-кінцевий-список-розгортання
  (функція (хвіст)
    (підтвердити-кінцевий-список-розгортання хвіст хвіст)))

(визначити розгорнути-список-зі-стану
  (функція (завершити? створити-елемент наступний-стан стан створити-хвіст)
    (за-умовою
      ((завершити? стан)
       (перевірити-кінцевий-список-розгортання
         (створити-хвіст стан)))
      (так
       (сполучити
         (створити-елемент стан)
         (розгорнути-список-зі-стану
           завершити?
           створити-елемент
           наступний-стан
           (наступний-стан стан)
           створити-хвіст))))))

; UNFOLD-RIGHT: завершальний D3-хвіст надходить як готове значення.
; Структура має пріоритет над будь-яким користувацьким callback.
; Після перевірки один раз зберігаємо суфікс та не обходимо його знову.
; Зростання хвоста виконує SENS СПОЛУЧИТИ, не хостові структури.
(визначити розгорнути-список-праворуч-зі-стану-ядро
  (функція (завершити? створити-елемент наступний-стан стан кінцевий-хвіст)
    (за-умовою
      ((завершити? стан) кінцевий-хвіст)
      (так
       (розгорнути-список-праворуч-зі-стану-ядро
         завершити?
         створити-елемент
         наступний-стан
         (наступний-стан стан)
         (сполучити (створити-елемент стан) кінцевий-хвіст))))))

(визначити розгорнути-список-праворуч-зі-стану
  (функція (завершити? створити-елемент наступний-стан стан кінцевий-хвіст)
    (розгорнути-список-праворуч-зі-стану-ядро
      завершити?
      створити-елемент
      наступний-стан
      стан
      (перевірити-кінцевий-список-розгортання кінцевий-хвіст))))
