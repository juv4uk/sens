; D11: Scheme SRFI-1 UNFOLD / UNFOLD-RIGHT (anamorphism, apomorphism).
; Стандарт: https://srfi.schemers.org/srfi-1/srfi-1.html
; Скінченне породження правильного списку: зупинка, вивід, наступний стан.
; Кожен callback — справжнє лексичне замикання SENS; немає host eval.
; Усі п'ять аргументів явні: жодного крапкового/необов'язкового
; параметра, автоперекодування або додаткової машинної команди D11.
; Породжувальна функція не викликається після виконання умови зупинки.
; Кінець UNFOLD створюється окремим замиканням від фінального стану.
; Кінець UNFOLD-RIGHT є явним значенням, ніколи не обчислюється наново.

(визначити розгорнути-список-зі-стану
  (функція (завершити? створити-елемент наступний-стан стан створити-хвіст)
    (за-умовою
      ((завершити? стан) (створити-хвіст стан))
      ((атом? (як-є ()))
       (сполучити
         (створити-елемент стан)
         (розгорнути-список-зі-стану
           завершити?
           створити-елемент
           наступний-стан
           (наступний-стан стан)
           створити-хвіст))))))

(визначити розгорнути-список-праворуч-зі-стану
  (функція (завершити? створити-елемент наступний-стан стан кінцевий-хвіст)
    (за-умовою
      ((завершити? стан) кінцевий-хвіст)
      ((атом? (як-є ()))
       (розгорнути-список-праворуч-зі-стану
         завершити?
         створити-елемент
         наступний-стан
         (наступний-стан стан)
         (сполучити (створити-елемент стан) кінцевий-хвіст))))))
