; Д11: точний слід позицій для стабільного поділу.
; Чинні Д1/Д3/Д4/Д5, без нових функціональних opcode.
; Передумова: правильний скінченний список і чистий Д1-предикат.
; Результат: (відібрані відкинуті слід); маска: Д1 так або Д1 ні.
(визначити доповнити-розділ-слідом
  (функція (голова обрано? частини)
    (за-умовою
      (обрано?
       (список (сполучити голова (перше частини))
               (друге частини)
               (сполучити так (третє частини))))
      (так
       (список (перше частини)
               (сполучити голова (друге частини))
               (сполучити ні (третє частини)))))))

(визначити розділити-зі-слідом
  (функція (предикат елементи)
    (за-умовою
      ((порожній? елементи)
       (список (як-є ()) (як-є ()) (як-є ())))
      (так
       (доповнити-розділ-слідом
         (перше елементи)
         (предикат (перше елементи))
         (розділити-зі-слідом предикат (решта елементи)))))))

; Неправильна довжина частин або сліду — реальна помилка ПЕРШЕ.
(визначити відновити-за-слідом
  (функція (відібрані відкинуті слід)
    (за-умовою
      ((порожній? слід)
       (за-умовою
         ((порожній? відібрані)
          (за-умовою
            ((порожній? відкинуті) (як-є ()))
            (так (перше (як-є ())))))
         (так (перше (як-є ())))))
      ((перше слід)
       (сполучити
         (перше відібрані)
         (відновити-за-слідом (решта відібрані) відкинуті (решта слід))))
      (так
       (сполучити
         (перше відкинуті)
         (відновити-за-слідом відібрані (решта відкинуті) (решта слід)))))))

(визначити відновити-розділ
  (функція (частини)
    (відновити-за-слідом
      (перше частини) (друге частини) (третє частини))))

; Виконуваний позитив і контрприклад до старого закону APPEND.
(визначити початковий-розділ
  (список (як-є a) (як-є b) (як-є a) (як-є c) (як-є a)))
(визначити результат-розділу
  (розділити-зі-слідом
    (функція (елемент) (тотожне? елемент (як-є a)))
    початковий-розділ))

(за-умовою
  ((однакові? результат-розділу
     (список (як-є (a a a)) (як-є (b c))
       (список так ні так ні так))) так)
  (так (перше (як-є ()))))

(за-умовою
  ((однакові? (відновити-розділ результат-розділу)
              початковий-розділ) так)
  (так (перше (як-є ()))))

(за-умовою
  ((хибне? (однакові?
     (приєднати (перше результат-розділу) (друге результат-розділу))
     початковий-розділ)) так)
  (так (перше (як-є ()))))

; Порожній вхід і випадок, коли всі елементи відкинуті.
(за-умовою
  ((однакові? (відновити-розділ
     (розділити-зі-слідом (функція (елемент) так) (як-є ())))
     (як-є ())) так)
  (так (перше (як-є ()))))

(за-умовою
  ((однакові? (відновити-розділ
     (розділити-зі-слідом (функція (елемент) ні) (як-є (a b))))
     (як-є (a b))) так)
  (так (перше (як-є ()))))

(визначити розділ-бітів
  (розділити-зі-слідом
    (функція (біт) (хибне? біт)) (список ні так ні)))
; Д1 ні залишається значенням, а не маркером відсутності.
(за-умовою
  ((однакові? (перше розділ-бітів) (список ні ні)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((однакові? (відновити-розділ розділ-бітів) (список ні так ні)) так)
  (так (перше (як-є ()))))

; Кінцевий самовердикт Д1 так.
(атом? (як-є ()))
