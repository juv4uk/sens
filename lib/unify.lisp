; Уніфікація зіставляє структури та логічні змінні.
; Її використовують зворотне виведення та логічне програмування.
; Умовні форми мають два поля, а предикатні значення належать Д1.
; Кінцеві гілки використовують безпосередньо «так» і «ні» без штучних списків.
; Порожня підстановка є успішними даними, не логічною хибою.
; Ратифіковані функції викликаються через повну українську проєкцію.
; Перевірка входження перешкоджає утворенню циклічних структур.

(визначити уніфікація-рівні?
  (функція (ліве праве)
    (за-умовою
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (тотожне? ліве праве))
         (так ні)))
      ((атом? праве) ні)
      ((уніфікація-рівні? (перше ліве) (перше праве))
       (уніфікація-рівні? (решта ліве) (решта праве)))
      (так ні))))

(визначити логічна-змінна
  (функція (назва)
    (список (як-є var) назва)))

(визначити змінна?
  (функція (терм)
    (за-умовою
      ((атом? терм) ні)
      ((атом? (перше терм))
       (за-умовою
         ((тотожне? (перше терм) (як-є var)) так)
         (так ні)))
      (так ні))))

(визначити отримати-значення-з-підстановки
  (функція (змінна підстановки)
    (за-умовою
      ((порожній? підстановки) (як-є ()))
      ((уніфікація-рівні? змінна (перше (перше підстановки)))
       (решта (перше підстановки)))
      (так
       (отримати-значення-з-підстановки змінна (решта підстановки))))))

(визначити розширити-підстановку
  (функція (змінна терм підстановки)
    (сполучити (сполучити змінна терм) підстановки)))

(визначити пройти
  (функція (терм підстановки)
    (обійти-розв'язаний (розв'язати-один-раз терм підстановки) підстановки)))

(визначити розв'язати-один-раз
  (функція (терм підстановки)
    (за-умовою
      ((змінна? терм)
       (нехай ((знайдене (отримати-значення-з-підстановки терм підстановки)))
         (за-умовою
           ((порожній? знайдене) терм)
           (так знайдене))))
      (так терм))))

(визначити обійти-розв'язаний
  (функція (терм підстановки)
    (за-умовою
      ((змінна? терм)
       (нехай ((знайдене (отримати-значення-з-підстановки терм підстановки)))
         (за-умовою
           ((порожній? знайдене) терм)
           (так (обійти-розв'язаний знайдене підстановки)))))
      (так терм))))

(визначити уніфікувати
  (функція (ліве праве підстановки)
    (уніфікувати-обійдений (пройти ліве підстановки) (пройти праве підстановки) підстановки)))

(визначити підстановка-позначає-невдачу?
  (функція (підстановки)
    (за-умовою
      ((атом? підстановки) (тотожне? підстановки (як-є fail)))
      (так ні))))

(визначити уніфікувати-обійдений
  (функція (ліве праве підстановки)
    (за-умовою
      ((підстановка-позначає-невдачу? підстановки) (як-є fail))
      ((уніфікація-рівні? ліве праве) підстановки)
      ((змінна? ліве) (уніфікувати-змінна ліве праве підстановки))
      ((змінна? праве) (уніфікувати-змінна праве ліве підстановки))
      ((атом? ліве)
       (за-умовою
         ((атом? праве)
          (за-умовою ((тотожне? ліве праве) підстановки) (так (як-є fail))))
         (так (як-є fail))))
      ((атом? праве) (як-є fail))
      (так
       (нехай ((перша-уніфікація (уніфікувати (перше ліве) (перше праве) підстановки)))
         (за-умовою
           ((підстановка-позначає-невдачу? перша-уніфікація) (як-є fail))
           (так
            (уніфікувати (решта ліве) (решта праве) перша-уніфікація))))))))

(визначити входить-перевірити?
  (функція (змінна терм підстановки)
    (нехай ((розв'язаний (пройти терм підстановки)))
      (за-умовою
        ((уніфікація-рівні? змінна розв'язаний) так)
        ((змінна? розв'язаний) ні)
        ((атом? розв'язаний) ні)
        (так
         (за-умовою
           ((входить-перевірити? змінна (перше розв'язаний) підстановки) так)
           (так
            (входить-перевірити? змінна (решта розв'язаний) підстановки))))))))

(визначити уніфікувати-змінна
  (функція (змінна терм підстановки)
    (за-умовою
      ((входить-перевірити? змінна терм підстановки) (як-є fail))
      (так
       (розширити-підстановку змінна терм підстановки)))))

(визначити застосувати-підстановка
  (функція (терм підстановки)
    (застосувати-підстановку-обійдений (пройти терм підстановки) підстановки)))

(визначити застосувати-підстановку-обійдений
  (функція (терм підстановки)
    (за-умовою
      ((атом? терм) терм)
      ((змінна? терм) терм)
      (так
       (сполучити (застосувати-підстановка (перше терм) підстановки)
            (застосувати-підстановка (решта терм) підстановки))))))

(визначити потік-виконання-кон'юнкція
  (функція (умови стан спробувати-одну)
    (за-умовою
      ((атом? умови) (список стан))
      (так
       (потік-виконання-кон'юнкція-гілки
         (решта умови)
         спробувати-одну
         (спробувати-одну (перше умови) стан))))))

(визначити потік-виконання-кон'юнкція-гілки
  (функція (решта-умов спробувати-одну стани)
    (за-умовою
      ((атом? стани) (як-є ()))
      (так
       (приєднати (потік-виконання-кон'юнкція решта-умов (перше стани) спробувати-одну)
             (потік-виконання-кон'юнкція-гілки решта-умов спробувати-одну (решта стани)))))))
