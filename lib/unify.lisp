; Уніфікація зіставляє структури та логічні змінні.
; Її використовують зворотне виведення та логічне програмування.
; Умовні форми мають два поля, а предикатні значення належать Д1.
; Порожня підстановка є успішними даними, не логічною хибою.
; Ратифіковані функції викликаються через повну українську проєкцію.
; Перевірка входження перешкоджає утворенню циклічних структур.

(визначити unify-equal?
  (функція (ліве праве)
    (за-умовою
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (тотожне? ліве праве))
         ((атом? (як-є ())) (атом? (як-є (ні))))))
      ((атом? праве) (атом? (як-є (ні))))
      ((unify-equal? (перше ліве) (перше праве))
       (unify-equal? (решта ліве) (решта праве)))
      ((атом? (як-є ())) (атом? (як-є (ні)))))))

(визначити logic-var
  (функція (назва)
    (список (як-є var) назва)))

(визначити var?
  (функція (терм)
    (за-умовою
      ((атом? терм) (атом? (як-є (ні))))
      ((атом? (перше терм))
       (за-умовою
         ((тотожне? (перше терм) (як-є var)) (атом? (як-є ())))
         ((атом? (як-є ())) (атом? (як-є (ні))))))
      ((атом? (як-є ())) (атом? (як-є (ні)))))))

(визначити lookup-subst
  (функція (змінна підстановки)
    (за-умовою
      ((порожній? підстановки) (як-є ()))
      ((unify-equal? змінна (перше (перше підстановки)))
       (решта (перше підстановки)))
      ((атом? (як-є ()))
       (отримати-значення-з-підстановки змінна (решта підстановки))))))

(визначити extend-subst
  (функція (змінна терм підстановки)
    (сполучити (сполучити змінна терм) підстановки)))

(визначити walk
  (функція (терм підстановки)
    (обійти-розв'язаний (resolve-once терм підстановки) підстановки)))

(визначити resolve-once
  (функція (терм підстановки)
    (за-умовою
      ((змінна? терм)
       (нехай ((знайдене (отримати-значення-з-підстановки терм підстановки)))
         (за-умовою
           ((порожній? знайдене) терм)
           ((атом? (як-є ())) знайдене))))
      ((атом? (як-є ())) терм))))

(визначити walk-resolved
  (функція (терм підстановки)
    (за-умовою
      ((змінна? терм)
       (нехай ((знайдене (отримати-значення-з-підстановки терм підстановки)))
         (за-умовою
           ((порожній? знайдене) терм)
           ((атом? (як-є ())) (обійти-розв'язаний знайдене підстановки)))))
      ((атом? (як-є ())) терм))))

(визначити unify
  (функція (ліве праве підстановки)
    (уніфікувати-обійдений (пройти ліве підстановки) (пройти праве підстановки) підстановки)))

(визначити failed-subst?
  (функція (підстановки)
    (за-умовою
      ((атом? підстановки) (тотожне? підстановки (як-є fail)))
      (так ні))))

(визначити unify-walked
  (функція (ліве праве підстановки)
    (за-умовою
      ((підстановка-позначає-невдачу? підстановки) (як-є fail))
      ((unify-equal? ліве праве) підстановки)
      ((змінна? ліве) (уніфікувати-змінна ліве праве підстановки))
      ((змінна? праве) (уніфікувати-змінна праве ліве підстановки))
      ((атом? ліве)
       (за-умовою
         ((атом? праве)
          (за-умовою ((тотожне? ліве праве) підстановки) ((атом? (як-є ())) (як-є fail))))
         ((атом? (як-є ())) (як-є fail))))
      ((атом? праве) (як-є fail))
      ((атом? (як-є ()))
       (нехай ((car-b (уніфікувати (перше ліве) (перше праве) підстановки)))
         (за-умовою
           ((підстановка-позначає-невдачу? car-b) (як-є fail))
           ((атом? (як-є ()))
            (уніфікувати (решта ліве) (решта праве) car-b))))))))

(визначити occurs-check?
  (функція (змінна терм підстановки)
    (нехай ((resolved (пройти терм підстановки)))
      (за-умовою
        ((unify-equal? змінна resolved) (атом? (як-є ())))
        ((змінна? resolved) (атом? (як-є (ні))))
        ((атом? resolved) (атом? (як-є (ні))))
        ((атом? (як-є ()))
         (за-умовою
           ((входить-перевірити? змінна (перше resolved) підстановки) (атом? (як-є ())))
           ((атом? (як-є ()))
            (входить-перевірити? змінна (решта resolved) підстановки))))))))

(визначити occurs-check occurs-check?)

(визначити unify-var
  (функція (змінна терм підстановки)
    (за-умовою
      ((входить-перевірити? змінна терм підстановки) (як-є fail))
      ((атом? (як-є ()))
       (extend-subst змінна терм підстановки)))))

(визначити apply-subst
  (функція (терм підстановки)
    (apply-subst-walked (пройти терм підстановки) підстановки)))

(визначити apply-subst-walked
  (функція (терм підстановки)
    (за-умовою
      ((атом? терм) терм)
      ((змінна? терм) терм)
      ((атом? (як-є ()))
       (сполучити (застосувати-підстановка (перше терм) підстановки)
            (застосувати-підстановка (решта терм) підстановки))))))

(визначити thread-conjunction
  (функція (умови стан спробувати-одну)
    (за-умовою
      ((атом? умови) (список стан))
      ((атом? (як-є ()))
       (потік-виконання-кон'юнкція-гілки
         (решта умови)
         спробувати-одну
         (спробувати-одну (перше умови) стан))))))

(визначити thread-conjunction-branches
  (функція (решта-умов спробувати-одну стани)
    (за-умовою
      ((атом? стани) (як-є ()))
      ((атом? (як-є ()))
       (приєднати (потік-виконання-кон'юнкція решта-умов (перше стани) спробувати-одну)
             (потік-виконання-кон'юнкція-гілки решта-умов спробувати-одну (решта стани)))))))

; opt-in повна укр-поверхня: exact identity = lib/domains/d*.lisp; DEFINE-аліас, без нової диспетчеризації.
(визначити застосувати-підстановка apply-subst)
(визначити підстановка-позначає-невдачу? failed-subst?)
(визначити отримати-значення-з-підстановки lookup-subst)
(визначити входить-перевірити? occurs-check?)
(визначити потік-виконання-кон'юнкція thread-conjunction)
(визначити потік-виконання-кон'юнкція-гілки thread-conjunction-branches)
(визначити уніфікувати unify)
(визначити уніфікувати-змінна unify-var)
(визначити уніфікувати-обійдений unify-walked)
(визначити змінна? var?)
(визначити пройти walk)
(визначити обійти-розв'язаний walk-resolved)
