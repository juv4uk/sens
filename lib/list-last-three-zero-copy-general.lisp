; Останні три елементи правильного списку без копіювання жодної пари.
; Для короткого списку повертається сам вхід; для довгого - його точний хвіст.
; Один лінійний прохід тільки через решта; Д3 і Д5, без чисел і зовнішнє-семантики.
(визначити останні-три
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) елементи)
      ((порожній? (решта елементи)) елементи)
      ((порожній? (решта (решта елементи))) елементи)
      ((порожній? (решта (решта (решта елементи)))) елементи)
      (так (останні-три (решта елементи))))))

; Позитивні СЕНС-закони для довжин від нуля до шести.
(за-умовою
  ((порожній? (останні-три (як-є ()))) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (останні-три (список (як-є атом?))))
              (як-є атом?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (останні-три
    (список (як-є атом?) (як-є решта))))
    (як-є атом?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (останні-три
    (список (як-є атом?) (як-є решта) (як-є сполучити))))
    (як-є атом?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (останні-три
    (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є функція))))
    (як-є решта)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (останні-три
    (список (як-є атом?) (як-є решта) (як-є сполучити)
            (як-є функція) (як-є визначити))))
    (як-є сполучити)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (перше (останні-три
    (список (як-є атом?) (як-є решта) (як-є сполучити)
            (як-є функція) (як-є визначити) (як-є тотожне?))))
    (як-є функція)) так)
  (так (перше (як-є ()))))
; Хвіст має рівно три елементи і закінчується порожнім.
(за-умовою
  ((порожній? (решта (решта (решта (останні-три
    (список (як-є атом?) (як-є решта)
            (як-є сполучити) (як-є функція))))))) так)
  (так (перше (як-є ()))))
; Складений елемент не сплощується.
(за-умовою
  ((хибне? (атом? (перше (останні-три
    (список (як-є атом?) (як-є решта)
            (список (як-є сполучити)) (як-є функція)
            (як-є визначити)))))) так)
  (так (перше (як-є ()))))
; Негативний свідок: у четвірці голова суфікса не перша.
(за-умовою
  ((хибне? (тотожне? (перше (останні-три
    (список (як-є атом?) (як-є решта)
            (як-є сполучити) (як-є функція))))
    (як-є атом?))) так)
  (так (перше (як-є ()))))

(атом? (як-є ()))
