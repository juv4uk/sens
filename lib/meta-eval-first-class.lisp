; Першокласні функції: експериментальний метаобчислювач мовою СЕНС.
; Викличні голови ядра відповідають повній українській проєкції доменів від 1 до 10.
; Примітиви зберігаються у явному лексичному середовищі як значення.
; Локальне зв'язування затінює примітив без втручання зовнішнього виконавця.
; Замикання зберігає параметри, тіло та середовище визначення.
; Синтаксичні форми як-є, за-умовою і функція не є звичайними значеннями.
; Невідомий примітив і невикличне значення повертають окрему помилкову форму.
; Вихідні математичні операнди записуються людськими десятковими числами.
; Історичні восьмибітні коди та шари сумісності не застосовуються.

(визначити першокласний-примітив
  (функція (назва)
    (список (як-є примітив) назва)))

(визначити першокласне-початкове-середовище
  (список
    (сполучити (як-є атом?) (першокласний-примітив (як-є атом?)))
    (сполучити (як-є тотожне?)   (першокласний-примітив (як-є тотожне?)))
    (сполучити (як-є перше)  (першокласний-примітив (як-є перше)))
    (сполучити (як-є решта)  (першокласний-примітив (як-є решта)))
    (сполучити (як-є сполучити) (першокласний-примітив (як-є сполучити)))
    (сполучити (як-є додати)    (першокласний-примітив (як-є додати)))
    (сполучити (як-є відняти)    (першокласний-примітив (як-є відняти)))
    (сполучити (як-є помножити)    (першокласний-примітив (як-є помножити)))
    (сполучити (як-є частка)    (першокласний-примітив (як-є частка)))
    (сполучити (як-є менше?)    (першокласний-примітив (як-є менше?)))
    (сполучити (як-є однакові?)    (першокласний-примітив (як-є однакові?)))
    (сполучити (як-є більше?)    (першокласний-примітив (як-є більше?)))))

(визначити першокласне-знайти-в-середовищі
  (функція (назва оточення)
    (за-умовою
      ((атом? оточення) назва)
      ((тотожне? (перше (перше оточення)) назва) (решта (перше оточення)))
      ((атом? (як-є ())) (першокласне-знайти-в-середовищі назва (решта оточення))))))

; Д7-мітки — точні слова тексту, а не два атоми для Д3 ТОТОЖНЕ?.
; Д8 перетворює обидва написання на справжні символи перед атомною рівністю.
; Це чинний нативний маршрут REPL, не host-порівняння Unicode.
(визначити першокласні-мітки-рівні?
  (функція (ліва права)
    (тотожне?
      (текст-у-символ (значення-у-текст ліва))
      (текст-у-символ (значення-у-текст права)))))

(визначити першокласний-примітив?
  (функція (перевірюване-значення-мета)
    (за-умовою
      ((атом? перевірюване-значення-мета) (атом? (як-є (()))) )
      ((атом? (як-є ())) (першокласні-мітки-рівні? (перше перевірюване-значення-мета) (як-є примітив))))))

(визначити першокласне-замикання?
  (функція (перевірюване-значення-мета)
    (за-умовою
      ((атом? перевірюване-значення-мета) (атом? (як-є (()))) )
      ((атом? (як-є ())) (першокласні-мітки-рівні? (перше перевірюване-значення-мета) (як-є замикання))))))

(визначити першокласне-звязати-параметри
  (функція (параметри вхідні-аргументи-мета оточення)
    (за-умовою
      ((атом? параметри) оточення)
      ((атом? (як-є ()))
       (сполучити (сполучити (перше параметри) (перше вхідні-аргументи-мета))
            (першокласне-звязати-параметри (решта параметри) (решта вхідні-аргументи-мета) оточення))))))

(визначити першокласне-обчислити-список
  (функція (вирази оточення)
    (за-умовою
      ((атом? вирази) (як-є ()))
      ((атом? (як-є ()))
       (сполучити (першокласне-обчислити (перше вирази) оточення)
            (першокласне-обчислити-список (решта вирази) оточення))))))

(визначити першокласне-обчислити-тіло
  (функція (тіло оточення)
    (за-умовою
      ((атом? (решта тіло)) (першокласне-обчислити (перше тіло) оточення))
      ((атом? (як-є ()))
       (нехай-послідовно
         ((оцінено-попереднє (першокласне-обчислити (перше тіло) оточення)))
         (першокласне-обчислити-тіло (решта тіло) оточення))))))

(визначити першокласне-обчислити-умови
  (функція (умови оточення)
    (за-умовою
      ((атом? умови) (як-є ()))
      ((першокласне-обчислити (перше (перше умови)) оточення)
       (першокласне-обчислити (друге (перше умови)) оточення))
      ((атом? (як-є ())) (першокласне-обчислити-умови (решта умови) оточення)))))

; Порівняння сусідніх аргументів триває рекурсивно, доки не лишиться один аргумент.
(визначити першокласне-порівняти-послідовність
  (функція (оператор вхідні-аргументи-мета)
    (за-умовою
      ((атом? (решта вхідні-аргументи-мета)) (атом? (як-є ())))
      ((за-умовою
         ((тотожне? оператор (як-є менше?)) (менше? (перше вхідні-аргументи-мета) (друге вхідні-аргументи-мета)))
         ((тотожне? оператор (як-є однакові?)) (однакові? (перше вхідні-аргументи-мета) (друге вхідні-аргументи-мета)))
         ((тотожне? оператор (як-є більше?)) (більше? (перше вхідні-аргументи-мета) (друге вхідні-аргументи-мета)))
         ((атом? (як-є ())) (як-є ())))
       (першокласне-порівняти-послідовність оператор (решта вхідні-аргументи-мета)))
      ((атом? (як-є ())) (атом? (як-є (()))) ))))

; Похідне застосування ратифікованої частки до обчислених аргументів.
; Числовий закон та перевірка нульового дільника залишаються за п'ятим доменом.
(визначити першокласне-частка-двох
  (функція (вхідні-аргументи-мета)
    (частка (перше вхідні-аргументи-мета) (друге вхідні-аргументи-мета))))

(визначити першокласне-застосувати-примітив
  (функція (назва вхідні-аргументи-мета)
    (за-умовою
      ((тотожне? назва (як-є атом?)) (атом? (перше вхідні-аргументи-мета)))
      ((тотожне? назва (як-є тотожне?)) (тотожне? (перше вхідні-аргументи-мета) (друге вхідні-аргументи-мета)))
      ((тотожне? назва (як-є перше)) (перше (перше вхідні-аргументи-мета)))
      ((тотожне? назва (як-є решта)) (решта (перше вхідні-аргументи-мета)))
      ((тотожне? назва (як-є сполучити)) (сполучити (перше вхідні-аргументи-мета) (друге вхідні-аргументи-мета)))
      ((тотожне? назва (як-є додати)) (додати (перше вхідні-аргументи-мета) (друге вхідні-аргументи-мета)))
      ((тотожне? назва (як-є відняти)) (відняти (перше вхідні-аргументи-мета) (друге вхідні-аргументи-мета)))
      ((тотожне? назва (як-є помножити)) (помножити (перше вхідні-аргументи-мета) (друге вхідні-аргументи-мета)))
      ((тотожне? назва (як-є частка)) (першокласне-частка-двох вхідні-аргументи-мета))
      ((тотожне? назва (як-є менше?)) (першокласне-порівняти-послідовність (як-є менше?) вхідні-аргументи-мета))
      ((тотожне? назва (як-є однакові?)) (першокласне-порівняти-послідовність (як-є однакові?) вхідні-аргументи-мета))
      ((тотожне? назва (як-є більше?)) (першокласне-порівняти-послідовність (як-є більше?) вхідні-аргументи-мета))
      ((атом? (як-є ())) (список (як-є невідомий-примітив) назва)))))

(визначити першокласне-застосувати
  (функція (виклична-функція вхідні-аргументи-мета)
    (за-умовою
      ((першокласний-примітив? виклична-функція)
       (першокласне-застосувати-примітив (друге виклична-функція) вхідні-аргументи-мета))
      ((першокласне-замикання? виклична-функція)
       (першокласне-обчислити-тіло
         (третє виклична-функція)
         (першокласне-звязати-параметри
           (друге виклична-функція)
           вхідні-аргументи-мета
           (перше (решта (решта (решта виклична-функція)))))))
      ((атом? (як-є ())) (список (як-є не-викликається) виклична-функція)))))

(визначити першокласне-обчислити
  (функція (вираз оточення)
    (за-умовою
      ((атом? вираз) (першокласне-знайти-в-середовищі вираз оточення))
      ((атом? (перше вираз))
       (за-умовою
         ; Синтаксичні форми залишаються синтаксисом, а не звичайними значеннями.
         ((тотожне? (перше вираз) (як-є як-є)) (друге вираз))
         ((тотожне? (перше вираз) (як-є за-умовою)) (першокласне-обчислити-умови (решта вираз) оточення))
         ((тотожне? (перше вираз) (як-є функція))
          (список (як-є замикання) (друге вираз) (решта (решта вираз)) оточення))
         ; Кожна звичайна виклична голова спочатку шукається в лексичному середовищі.
         ; Локальне ім'я може затінювати однойменну примітивну операцію.
         ; Обчислювач не надає таким іменам особливого пріоритету.
         ((атом? (як-є ()))
          (першокласне-застосувати
            (першокласне-обчислити (перше вираз) оточення)
            (першокласне-обчислити-список (решта вираз) оточення)))))
      ((атом? (як-є ()))
       (першокласне-застосувати
         (першокласне-обчислити (перше вираз) оточення)
         (першокласне-обчислити-список (решта вираз) оточення))))))

; Відкритий експериментальний вхід отримує явне середовище примітивів.
; Лексичне розв'язування залишається всередині мови, а зовнішня машина
; відповідає тільки за збереження тотожності допущених механізмів.
(визначити обчислити-першокласні-функції
  (функція (вираз)
    (першокласне-обчислити вираз першокласне-початкове-середовище)))
