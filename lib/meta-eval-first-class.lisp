; Першокласні функції: експериментальний метаобчислювач мовою SENS.
; Точні викличні голови ядра — повна проєкція «укр» D1–D10.
; Примітиви зберігаються у явному лексичному середовищі як значення.
; Тому локальне зв'язування затінює початковий примітив без host-втручання.
; Замикання зберігає параметри, тіло та середовище визначення.
; Синтаксичні форми «як-є», «за-умовою», «функція» не є значеннями.
; Невідомий примітив і невикличне значення повертають окрему помилкову форму.
; Вихідні математичні операнди записуються людськими десятковими числами.
; Жодних SID8/Sens8, закодованих викличних голів або шарів сумісності.

(визначити першокласний-примітив
  (функція (назва)
    (список (як-є примітив) назва)))

(визначити першокласне-початкове-середовище
  (список
    (сполучити (як-є атом?) (першокласний-примітив (як-є атом?)))
    (сполучити (як-є тотожне?)   (першокласний-примітив (як-є тотожне?)))
    (сполучити (як-є перше)  (першокласний-примітив (як-є перше)))
    (сполучити (як-є решта)  (першокласний-примітив (як-є решта)))
    (сполучити (як-є сполучити) (першокласний-примітив (як-є сполучити)))
    (сполучити (як-є додати)    (першокласний-примітив (як-є додати)))
    (сполучити (як-є відняти)    (першокласний-примітив (як-є відняти)))
    (сполучити (як-є помножити)    (першокласний-примітив (як-є помножити)))
    (сполучити (як-є менше?)    (першокласний-примітив (як-є менше?)))
    (сполучити (як-є однакові?)    (першокласний-примітив (як-є однакові?)))
    (сполучити (як-є більше?)    (першокласний-примітив (як-є більше?)))))

(визначити першокласне-знайти-в-середовищі
  (функція (назва оточення)
    (за-умовою
      ((атом? оточення) назва)
      ((тотожне? (перше (перше оточення)) назва) (решта (перше оточення)))
      (так (першокласне-знайти-в-середовищі назва (решта оточення))))))

(визначити першокласний-примітив?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      (так (тотожне? (перше значення) (як-є примітив))))))

(визначити першокласне-замикання?
  (функція (значення)
    (за-умовою
      ((атом? значення) ні)
      (так (тотожне? (перше значення) (як-є замикання))))))

(визначити першокласне-звязати-параметри
  (функція (параметри аргументи оточення)
    (за-умовою
      ((атом? параметри) оточення)
      (так
       (сполучити (сполучити (перше параметри) (перше аргументи))
            (першокласне-звязати-параметри (решта параметри) (решта аргументи) оточення))))))

(визначити першокласне-обчислити-список
  (функція (вирази оточення)
    (за-умовою
      ((атом? вирази) (як-є ()))
      (так
       (сполучити (першокласне-обчислити (перше вирази) оточення)
            (першокласне-обчислити-список (решта вирази) оточення))))))

(визначити першокласне-обчислити-тіло
  (функція (тіло оточення)
    (за-умовою
      ((атом? (решта тіло)) (першокласне-обчислити (перше тіло) оточення))
      (так
       ((функція ()
          (першокласне-обчислити (перше тіло) оточення)
          (першокласне-обчислити-тіло (решта тіло) оточення)))))))

(визначити першокласне-обчислити-умови
  (функція (умови оточення)
    (за-умовою
      ((атом? умови) (як-є ()))
      ((першокласне-обчислити (перше (перше умови)) оточення)
       (першокласне-обчислити (друге (перше умови)) оточення))
      (так (першокласне-обчислити-умови (решта умови) оточення)))))

; Exact D1 chain: single remaining arg is true; pairwise op then recurse.
(визначити першокласне-порівняти-послідовність
  (функція (оператор аргументи)
    (за-умовою
      ((атом? (решта аргументи)) так)
      ((за-умовою
         ((тотожне? оператор (як-є менше?)) (менше? (перше аргументи) (друге аргументи)))
         ((тотожне? оператор (як-є однакові?)) (однакові? (перше аргументи) (друге аргументи)))
         ((тотожне? оператор (як-є більше?)) (більше? (перше аргументи) (друге аргументи)))
         (так (як-є ())))
       (першокласне-порівняти-послідовність оператор (решта аргументи)))
      (так ні))))

(визначити першокласне-застосувати-примітив
  (функція (назва аргументи)
    (за-умовою
      ((тотожне? назва (як-є атом?)) (атом? (перше аргументи)))
      ((тотожне? назва (як-є тотожне?)) (тотожне? (перше аргументи) (друге аргументи)))
      ((тотожне? назва (як-є перше)) (перше (перше аргументи)))
      ((тотожне? назва (як-є решта)) (решта (перше аргументи)))
      ((тотожне? назва (як-є сполучити)) (сполучити (перше аргументи) (друге аргументи)))
      ((тотожне? назва (як-є додати)) (додати (перше аргументи) (друге аргументи)))
      ((тотожне? назва (як-є відняти)) (відняти (перше аргументи) (друге аргументи)))
      ((тотожне? назва (як-є помножити)) (помножити (перше аргументи) (друге аргументи)))
      ((тотожне? назва (як-є менше?)) (першокласне-порівняти-послідовність (як-є менше?) аргументи))
      ((тотожне? назва (як-є однакові?)) (першокласне-порівняти-послідовність (як-є однакові?) аргументи))
      ((тотожне? назва (як-є більше?)) (першокласне-порівняти-послідовність (як-є більше?) аргументи))
      (так (список (як-є невідомий-примітив) назва)))))

(визначити першокласне-застосувати
  (функція (виклична-функція аргументи)
    (за-умовою
      ((першокласний-примітив? виклична-функція)
       (першокласне-застосувати-примітив (друге виклична-функція) аргументи))
      ((першокласне-замикання? виклична-функція)
       (першокласне-обчислити-тіло
         (третє виклична-функція)
         (першокласне-звязати-параметри
           (друге виклична-функція)
           аргументи
           (перше (решта (решта (решта виклична-функція)))))))
      (так (список (як-є не-викликається) виклична-функція)))))

(визначити першокласне-обчислити
  (функція (вираз оточення)
    (за-умовою
      ((атом? вираз) (першокласне-знайти-в-середовищі вираз оточення))
      ((атом? (перше вираз))
       (за-умовою
         ; Syntax-only forms remain syntax. They are intentionally not values.
         ((тотожне? (перше вираз) (як-є як-є)) (друге вираз))
         ((тотожне? (перше вираз) (як-є за-умовою)) (першокласне-обчислити-умови (решта вираз) оточення))
         ((тотожне? (перше вираз) (як-є функція))
          (список (як-є замикання) (друге вираз) (решта (решта вираз)) оточення))
         ; Every ordinary head is resolved through the environment first.
         ; This is the contract-2.1 step: a local `+`, `car`, etc. can shadow
         ; the root primitive binding without the evaluator special-casing its name.
         (так
          (першокласне-застосувати
            (першокласне-обчислити (перше вираз) оточення)
            (першокласне-обчислити-список (решта вираз) оточення)))))
      (так
       (першокласне-застосувати
         (першокласне-обчислити (перше вираз) оточення)
         (першокласне-обчислити-список (решта вираз) оточення))))))

; Public experimental entry point. The root primitive environment is explicit
; Lisp data, so a future host/runtime only has to preserve the primitive mechanism
; identities; lexical resolution itself is owned here.
(визначити обчислити-першокласні-функції
  (функція (вираз)
    (першокласне-обчислити вираз першокласне-початкове-середовище)))
