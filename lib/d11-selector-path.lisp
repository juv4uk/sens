; Д11 — виконувана SENS-композиція селекторів, БЕЗ нового opcode.
; Для ратифікованого батьківського p: p0(x)=p(перше x), p1(x)=p(решта x).
; Кроки зліва направо: ні — Д3 ПЕРШЕ, так — Д3 РЕШТА.
; Результат: (Д1-статус . значення/помилка). Навіть дані Д1:ні не є помилкою.
; Неправильний хвіст і спроба вибрати з атома відхиляються до CAR/CDR.

(визначити селектор-прохід-д11
  (функція (кроки дані)
    (за-умовою
      ((атом? кроки)
       (за-умовою
         ((тотожне? кроки (як-є ())) (сполучити так дані))
         (так (сполучити ні (як-є неправильний-шлях)))))
      ((атом? дані) (сполучити ні (як-є атом-замість-пари)))
      ((атом? (перше кроки))
       (за-умовою
         ((тотожне? (перше кроки) ні)
          (селектор-прохід-д11 (решта кроки) (перше дані)))
         ((тотожне? (перше кроки) так)
          (селектор-прохід-д11 (решта кроки) (решта дані)))
         (так (сполучити ні (як-є неправильний-крок)))))
      (так (сполучити ні (як-є неправильний-крок))))))

; Результат може бути підсписком: D8 структурна рівність,
; а D3 ТОТОЖНЕ? перевіряє лише атомарний Д1-статус.
(визначити селектор-успішний-д11?
  (функція (виконання очікуване)
    (за-умовою
      ((тотожне? (перше виконання) так)
       (однакові? (решта виконання) очікуване))
      (так ні))))
