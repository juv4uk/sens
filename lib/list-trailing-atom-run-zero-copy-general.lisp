; СЕНС: найдовший кінцевий суфікс атомних елементів правильного списку.
; Один прохід, O(n) часу, O(1) пам'яті: результат — наявний хвіст CONS.
; Порожній елемент () — атом. Вкладена непорожня пара перериває серію.
; Чинні Д3–Д5 визначають семантику; Д7 лише для людських назв.
; Не створювати нових пар у самому алгоритмі.

(визначити кінцеві-атоми-крок
 (функція (залишок початок)
  (за-умовою
   ((атом? залишок) початок)
   ((атом? (перше залишок))
    (за-умовою
     ((порожній? початок)
      (кінцеві-атоми-крок (решта залишок) залишок))
     (так
      (кінцеві-атоми-крок (решта залишок) початок))))
   (так
    (кінцеві-атоми-крок (решта залишок) (як-є ()))))))

(визначити суфікс-кінцевих-атомів
 (функція (елементи)
  (кінцеві-атоми-крок елементи (як-є ()))))

; Структурний оракул складається тільки з функцій самого СЕНС.
(визначити кінцеві-дерева-рівні?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((кінцеві-дерева-рівні? (перше ліве) (перше праве))
    (кінцеві-дерева-рівні? (решта ліве) (решта праве)))
   (так ні))))

(визначити довести-кінцеві-атоми
 (функція (вхід очікуване)
  (за-умовою
   ((кінцеві-дерева-рівні?
     (суфікс-кінцевих-атомів вхід) очікуване) так)
   (так (перше (як-є ()))))))

; Порожнє, лише атоми, лише пари, атом наприкінці.
(довести-кінцеві-атоми (як-є ()) (як-є ()))
(довести-кінцеві-атоми
 (список (як-є атом?) (як-є решта))
 (список (як-є атом?) (як-є решта)))
(довести-кінцеві-атоми
 (список (список (як-є атом?)) (список (як-є решта)))
 (як-є ()))
(довести-кінцеві-атоми
 (список (як-є атом?) (список (як-є решта)))
 (як-є ()))
(довести-кінцеві-атоми
 (список (список (як-є атом?)) (як-є решта))
 (список (як-є решта)))

; У середині є нова складена пара: стару серію не повертати.
(довести-кінцеві-атоми
 (список (як-є атом?) (як-є решта)
         (список (як-є сполучити)) (як-є тотожне?) (як-є функція))
 (список (як-є тотожне?) (як-є функція)))

; Порожній елемент рахуємо атомом, а не роздільником.
(довести-кінцеві-атоми
 (список (список (як-є решта)) (як-є ()) (як-є функція))
 (список (як-є ()) (як-є функція)))
(довести-кінцеві-атоми
 (список (як-є атом?) (як-є ()) (список (як-є решта)))
 (як-є ()))

; Негатив: префікс до складеної пари не має потрапити до результату.
(за-умовою
 ((хибне? (кінцеві-дерева-рівні?
   (суфікс-кінцевих-атомів
    (список (як-є атом?) (список (як-є решта)) (як-є функція)))
   (список (як-є атом?) (як-є функція)))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
