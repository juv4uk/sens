; СЕНС: точний доменний код є першокласним значенням-функцією.
; Дія передається як значення, а виклик здійснює сам СЕНС.
; Жоден старий байтовий код, старий універсальний код, сторонній обчислювач чи перетворення коду на рядок не потрібен.
(визначити викликати-доменний-код
 (функція (дія вхідні-дані)
  (дія вхідні-дані)))

; Двомісний виклик: ТОТОЖНЕ? та СПОЛУЧИТИ — ті самі
; першокласні доменні функції, без таблиці рядків та host-dispatch.
(визначити викликати-доменний-код-двомісно
 (функція (дія ліве праве)
  (дія ліве праве)))

; Позитивний та негативний точні Д1 результати переданого ТОТОЖНЕ?.
(за-умовою
 ((викликати-доменний-код-двомісно
   тотожне? (як-є атом?) (як-є атом?))
  так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне?
   (викликати-доменний-код-двомісно
    тотожне? (як-є атом?) (як-є решта)))
  так)
 (так (перше (як-є ()))))

; Інший Д3 код як значення: СПОЛУЧИТИ справді створює пару.
(за-умовою
 ((тотожне?
   (перше
    (викликати-доменний-код-двомісно
     сполучити (як-є атом?) (як-є решта)))
   (як-є атом?))
  так)
 (так (перше (як-є ()))))

; Д3 ПЕРШЕ: передана точна функція вибирає перший атом.
(за-умовою
 ((тотожне?
   (викликати-доменний-код перше (список (як-є атом?) (як-є решта)))
   (як-є атом?))
  так)
 (так (перше (як-є ()))))

; Інший Д3 код не підмінюється ПЕРШЕ; РЕШТА повертає пару.
(за-умовою
 ((хибне?
   (атом?
    (викликати-доменний-код решта
     (список (як-є атом?) (як-є решта)))))
  так)
 (так (перше (як-є ()))))

; Додатковий закон Д3: той самий переданий код функції
; не змінюється при іншій структурі аргументу.
(за-умовою
 ((тотожне?
   (викликати-доменний-код перше
    (список (як-є сполучити) (як-є решта)))
   (як-є сполучити))
  так)
 (так (перше (як-є ()))))

; Негативний свідок: код ПЕРШЕ не може повернути інший атом.
(за-умовою
 ((хибне?
   (тотожне?
    (викликати-доменний-код перше
     (список (як-є атом?) (як-є решта)))
    (як-є решта)))
  так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
