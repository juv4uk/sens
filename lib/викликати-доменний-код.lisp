; СЕНС: точний доменний код є першокласним значенням-функцією.
; Дія передається як значення, а виклик здійснює сам СЕНС.
; Жоден SID8, Sens8, Python/JSON-оракул чи перетворення коду на рядок не потрібен.
(визначити викликати-доменний-код
 (функція (дія вхідні-дані)
  (дія вхідні-дані)))

; Д3 ПЕРШЕ: передана точна функція вибирає перший атом.
(за-умовою
 ((тотожне?
   (викликати-доменний-код перше (список (як-є атом?) (як-є решта)))
   (як-є атом?))
  так)
 (так (перше (як-є ()))))

; Інший Д3 код не підмінюється ПЕРШЕ; РЕШТА повертає пару.
(за-умовою
 ((хибне?
   (атом?
    (викликати-доменний-код решта
     (список (як-є атом?) (як-є решта)))))
  так)
 (так (перше (як-є ()))))

; Додатковий закон Д3: той самий переданий код функції
; не змінюється при іншій структурі аргументу.
(за-умовою
 ((тотожне?
   (викликати-доменний-код перше
    (список (як-є сполучити) (як-є решта)))
   (як-є сполучити))
  так)
 (так (перше (як-є ()))))

; Негативний свідок: код ПЕРШЕ не може повернути інший атом.
(за-умовою
 ((хибне?
   (тотожне?
    (викликати-доменний-код перше
     (список (як-є атом?) (як-є решта)))
    (як-є решта)))
  так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
