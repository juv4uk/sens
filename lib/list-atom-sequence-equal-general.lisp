; Д1 результат структурної рівності двох правильних скінченних списків АТОМІВ.
; Д3 ЕК і тотожне? працює лише над відповідними атомами, а не над пари-парами.
; Обидві порожні основи, обидва напрямки відмінної довжини й відмінності
; на різних позиціях доводяться справжнім СЕНС, без зовнішнє екуал або джейсон.

(визначити тотожні-атомні-списки?
  (функція (ліві праві)
    (за-умовою
      ((порожній? ліві) (порожній? праві))
      ((порожній? праві) ні)
      ((тотожне? (перше ліві) (перше праві))
       (тотожні-атомні-списки? (решта ліві) (решта праві)))
      ((атом? (як-є ())) ні))))

(визначити початковий-список (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?) (як-є за-умовою)))
(визначити рівний-окремий (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?) (як-є за-умовою)))
(визначити інший-перший (список (як-є решта) (як-є решта) (як-є сполучити) (як-є тотожне?) (як-є за-умовою)))
(визначити інший-середній (список (як-є атом?) (як-є решта) (як-є атом?) (як-є тотожне?) (як-є за-умовою)))
(визначити інший-останній (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?) (як-є атом?)))

; Виконати Д1 трутг табле на 14 свідках: позитиви, негативи й рекурсія.
(за-умовою
  ((тотожні-атомні-списки? початковий-список рівний-окремий)
   (за-умовою
     ((тотожні-атомні-списки? початковий-список початковий-список)
      (за-умовою
        ((тотожні-атомні-списки? (як-є ()) (як-є ()))
         (за-умовою
           ((тотожні-атомні-списки? (список (як-є атом?)) (список (як-є атом?)))
            (за-умовою
              ((тотожні-атомні-списки? (решта початковий-список) (решта рівний-окремий))
               (за-умовою
                 ((хибне? (тотожні-атомні-списки? початковий-список (решта початковий-список)))
                  (за-умовою
                    ((хибне? (тотожні-атомні-списки? (решта початковий-список) початковий-список))
                     (за-умовою
                       ((хибне? (тотожні-атомні-списки? (як-є ()) початковий-список))
                        (за-умовою
                          ((хибне? (тотожні-атомні-списки? початковий-список (як-є ())))
                           (за-умовою
                             ((хибне? (тотожні-атомні-списки? (список (як-є атом?)) (список (як-є решта))))
                              (за-умовою
                                ((хибне? (тотожні-атомні-списки? початковий-список інший-перший))
                                 (за-умовою
                                   ((хибне? (тотожні-атомні-списки? початковий-список інший-середній))
                                    (за-умовою
                                      ((хибне? (тотожні-атомні-списки? початковий-список інший-останній))
                                       (за-умовою
                                         ((тотожні-атомні-списки? (решта (решта початковий-список)) (решта (решта рівний-окремий)))
                                          (атом? (як-є ())))
                                         ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                                      ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                                   ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                                ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                             ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                          ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                       ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                    ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                 ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
              ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
           ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
        ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
     ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
