; Конкурс СЕНС: стабільне вилучення повторів атомів без дописування в кінець.
; На кожний новий атом рівно один СПОЛУЧИТИ у зворотному накопичувачі;
; після обходу один лінійний розворот. Немає ПРИЄДНАТИ на кожному кроці,
; зайвої копії префікса, пітона або джейсона як виконавця семантики.
; Час пошуку повторів квадратичний час через точне ТОТОЖНЕ?, побудова лінійний час.

(визначити ощадно-побачено?
 (функція (шукане збережені)
  (за-умовою
   ((порожній? збережені) ні)
   ((тотожне? шукане (перше збережені)) так)
   (так (ощадно-побачено? шукане (решта збережені))))))

(визначити ощадно-зібрати-навпаки
 (функція (залишок зібрані)
  (за-умовою
   ((порожній? залишок) зібрані)
   ((ощадно-побачено? (перше залишок) зібрані)
    (ощадно-зібрати-навпаки (решта залишок) зібрані))
   (так
    (ощадно-зібрати-навпаки
     (решта залишок)
     (сполучити (перше залишок) зібрані))))))

(визначити ощадно-розгорнути
 (функція (залишок накопичені)
  (за-умовою
   ((порожній? залишок) накопичені)
   (так
    (ощадно-розгорнути
     (решта залишок)
     (сполучити (перше залишок) накопичені))))))

(визначити унікальні-атоми-ощадно
 (функція (елементи)
  (ощадно-розгорнути
   (ощадно-зібрати-навпаки елементи (як-є ()))
   (як-є ()))))

; Справжні СЕНС-свідки: порожній, один, усі повтори, порядок,
; повтори у хвості, різні атоми й негативний свідок перестановки.
; Хибний закон не перетворюється на успіх: ПЕРШЕ порожнього дає помилку.
(за-умовою
 ((порожній? (унікальні-атоми-ощадно (як-є ()))) так)
 (так (перше (як-є ()))))

(за-умовою
 ((тотожне? (перше (унікальні-атоми-ощадно
   (список (як-є атом?)))) (як-є атом?)) так)
 (так (перше (як-є ()))))

(за-умовою
 ((порожній? (решта (унікальні-атоми-ощадно
   (список (як-є атом?) (як-є атом?) (як-є атом?))))) так)
 (так (перше (як-є ()))))

(визначити ощадно-проба
 (унікальні-атоми-ощадно
  (список (як-є атом?) (як-є решта) (як-є атом?)
          (як-є сполучити) (як-є решта) (як-є тотожне?)
          (як-є сполучити))))

(за-умовою
 ((тотожне? (перше ощадно-проба) (як-є атом?)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (друге ощадно-проба) (як-є решта)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (третє ощадно-проба) (як-є сполучити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (четверте ощадно-проба) (як-є тотожне?)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта (решта (решта (решта ощадно-проба))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (тотожне? (перше ощадно-проба) (як-є решта))) так)
 (так (перше (як-є ()))))

; Результат програми - справжнє Д1:1, не рядковий 'успіх'.
(атом? (як-є ()))
