; СЕНС Д3-Д4: оборотне стискання СУСІДНІХ повторів із збереженням кожного.
; На відміну від незворотного видалення дублікатів, кожна група
; зберігає весь початковий підсписок: ((а а) (б) (а а а)) відповідає (а а б а а а).
; Жодного нового машинного коду операції, пітонового чи джейсонового оракула, унікод-носія.
(визначити взяти-перший-сусідній-ряд
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) елементи)
      ((тотожне? (перше елементи) (друге елементи))
       (сполучити (перше елементи)
                  (взяти-перший-сусідній-ряд (решта елементи))))
      (так (список (перше елементи))))))

(визначити пропустити-перший-сусідній-ряд
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) (як-є ()))
      ((тотожне? (перше елементи) (друге елементи))
       (пропустити-перший-сусідній-ряд (решта елементи)))
      (так (решта елементи)))))

; Агентська пропозиція №5939: один поділ на (поточний-ряд . решта).
; Кожна комірка читається в одному СЕНС-проході; для скінченних
; правильних списків атомів порядок зберігається без нового коду операції.
(визначити розділити-перший-сусідній-ряд
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (сполучити (як-є ()) (як-є ())))
      ((атом? (решта елементи))
       (сполучити (список (перше елементи)) (як-є ())))
      ((тотожне? (перше елементи) (друге елементи))
       ((функція (частини)
          (сполучити
            (сполучити (перше елементи) (перше частини))
            (решта частини)))
        (розділити-перший-сусідній-ряд (решта елементи))))
      (так
       (сполучити (список (перше елементи)) (решта елементи))))))

(визначити групувати-сусідні
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      (так
       ((функція (частини)
          (сполучити
            (перше частини)
            (групувати-сусідні (решта частини))))
        (розділити-перший-сусідній-ряд елементи))))))

(визначити приєднати-ряд-до-хвоста
  (функція (ряд хвіст)
    (за-умовою
      ((атом? ряд) хвіст)
      (так
       (сполучити (перше ряд) (приєднати-ряд-до-хвоста (решта ряд) хвіст))))))

(визначити розгорнути-сусідні-групи
  (функція (групи)
    (за-умовою
      ((атом? групи) (як-є ()))
      (так
       (приєднати-ряд-до-хвоста
         (перше групи)
         (розгорнути-сусідні-групи (решта групи)))))))

(визначити початкові-елементи
  (список (як-є атом?) (як-є атом?) (як-є решта) (як-є решта) (як-є тотожне?) (як-є сполучити) (як-є за-умовою) (як-є за-умовою) (як-є атом?)))
