; SENS D3/D4: оборотне стискання СУСІДНІХ повторів із збереженням кожного.
; На відміну від незворотного видалення дублікатів, кожна група
; зберігає весь початковий підсписок: ((а а) (б) (а а а)) ↔ (а а б а а а).
; Жодного нового машинного opcode, Python/JSON-оракула, Unicode-носія.
(визначити взяти-перший-сусідній-ряд
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (решта елементи)) елементи)
      ((тотожне? (перше елементи) (друге елементи))
       (сполучити (перше елементи)
                  (взяти-перший-сусідній-ряд (решта елементи))))
      ((атом? (як-є ())) (список (перше елементи))))))

(визначити пропустити-перший-сусідній-ряд
