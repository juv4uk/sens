; D11: строгий спільний суфікс скінченних списків атомів.
; Д1:так означає правильний nil-термінатор ОБОХ аргументів.
; Д1:ні повертає точний неприйнятий крапковий хвіст як дані.
; Джерела істини: lib/d11-list-terminator-evidence.lisp,
;                 lib/list-common-suffix-general.lisp.
; Не перевизначає жодного D6/D11 коду та не переносить логіку до Zig/Rust.
(визначити спільний-суфікс-перевірений
  (функція (лівий правий)
    ((функція (стан-лівого)
       (за-умовою
         ((хибне? (перше стан-лівого))
          (список ні (друге стан-лівого)))
         (так
          ((функція (стан-правого)
             (за-умовою
               ((хибне? (перше стан-правого))
                (список ні (друге стан-правого)))
               (так
                (список так
                  (спільний-суфікс-атомів лівий правий)))))
           (розрізнити-хвіст-списку правий)))))
     (розрізнити-хвіст-списку лівий))))

; Справжня SENS-функція, а не host-предикат. Викличний самовердикт.
(атом? (як-є ()))
