; СЕНС Д3 і Д5: остання частина списку за унарним лічильником.
; Швидкий вказівник відходить на довжину лічильника.
; Один перегляд без копіювання пар. Усі виклики українською.
; Нульовий лічильник дає порожнє, завеликий дає цілий вхід.

(визначити зсунути-швидкий-за-лічильником
 (функція (швидкий лічильник)
  (за-умовою
   ((порожній? лічильник) швидкий)
   ((порожній? швидкий) швидкий)
   (так (зсунути-швидкий-за-лічильником
         (решта швидкий) (решта лічильник))))))

(визначити наздогнати-останній-суфікс
 (функція (повільний швидкий)
  (за-умовою
   ((порожній? швидкий) повільний)
   (так (наздогнати-останній-суфікс
         (решта повільний) (решта швидкий))))))

(визначити останні-за-унарною-довжиною
 (функція (елементи лічильник)
  (наздогнати-останній-суфікс
   елементи
   (зсунути-швидкий-за-лічильником елементи лічильник))))

; Хибний закон викликає перше від порожнього списку.
(за-умовою
 ((порожній? (останні-за-унарною-довжиною (як-є ()) (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (останні-за-унарною-довжиною
               (список (як-є атом?) (як-є решта)) (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (останні-за-унарною-довжиною
               (як-є ()) (список (як-є атом?)))) так)
 (так (перше (як-є ()))))
; Один елемент, один запит: незмінений вихідний список.
(за-умовою
 ((тотожне?
    (перше (останні-за-унарною-довжиною
             (список (як-є атом?)) (список (як-є решта))))
    (як-є атом?)) так)
 (так (перше (як-є ()))))
; Запит довший за список також не втрачає перший елемент.
(за-умовою
 ((тотожне?
    (перше (останні-за-унарною-довжиною
             (список (як-є атом?))
             (список (як-є решта) (як-є функція))))
    (як-є атом?)) так)
 (так (перше (як-є ()))))
; Останній з чотирьох.
(за-умовою
 ((тотожне?
    (перше (останні-за-унарною-довжиною
             (список (як-є атом?) (як-є решта)
                     (як-є функція) (як-є сполучити))
             (список (як-є визначити))))
    (як-є сполучити)) так)
 (так (перше (як-є ()))))
; Два останні з чотирьох: жодного сплющення вкладеної пари.
(за-умовою
 ((хибне?
    (атом? (перше (останні-за-унарною-довжиною
                    (список (як-є атом?) (список (як-є функція))
                            (як-є сполучити))
                    (список (як-є решта) (як-є решта)))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне?
    (перше (перше (останні-за-унарною-довжиною
                   (список (як-є атом?) (список (як-є функція))
                           (як-є сполучити))
                   (список (як-є решта) (як-є решта)))))
    (як-є функція)) так)
 (так (перше (як-є ()))))
; Два останні з чотирьох не сплющують вкладеного списку.
(за-умовою
 ((хибне?
    (тотожне?
      (останні-за-унарною-довжиною (список (як-є атом?)) (як-є ()))
      (як-є атом?))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне?
    (тотожне?
      (перше (останні-за-унарною-довжиною
               (список (як-є атом?) (як-є решта) (як-є функція))
               (список (як-є визначити) (як-є визначити))))
      (як-є атом?))) так)
 (так (перше (як-є ()))))
(атом? (як-є ()))
