; Виключне АБО — похідна функція над двома точними відповідями Д1.
; Виведення лише з ратифікованих Д3 за-умовою та Д4 хибне?.
; Не створює нового резидента, не вживає машинних літералів або хост-логіки.
(визначити виключне-або-д1
  (функція (ліве праве)
    (за-умовою
      (ліве (хибне? праве))
      ((хибне? ліве) праве))))

; Усі чотири випадки виконує сам СЕНС, а не скрипт:
; ні⊕ні=ні, ні⊕так=так, так⊕ні=так, так⊕так=ні.
; Будь-яка хибна відповідь перетворює результат програми на Д1 «ні».
(за-умовою
  ((хибне? (виключне-або-д1 ні ні))
   (за-умовою
     ((виключне-або-д1 ні так)
      (за-умовою
        ((виключне-або-д1 так ні)
         (хибне? (виключне-або-д1 так так)))
        (так ні)))
     (так ні)))
  (так ні))
