; Д3-Д5: оборотне спарування спільного префікса двох скінченних списків.
; Обидва неспарені хвости, включно з відкритими атомними, зберігаються дослівно.
; Значення обчислює СЕНС; Д7 лише для письма, Зіг і Т5М лише для точних байтів.

(визначити спарити-спільну-частину
  (функція (ліві праві)
    (за-умовою
      ((атом? ліві) (як-є ()))
      ((атом? праві) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (список (перше ліві) (перше праві))
         (спарити-спільну-частину (решта ліві) (решта праві)))))))

(визначити лівий-неспарений-хвіст
  (функція (ліві праві)
    (за-умовою
      ((атом? праві) ліві)
      ((атом? ліві) (як-є ()))
      ((атом? (як-є ())) (лівий-неспарений-хвіст (решта ліві) (решта праві))))))

(визначити правий-неспарений-хвіст
  (функція (ліві праві)
    (за-умовою
      ((атом? ліві) праві)
      ((атом? праві) (як-є ()))
      ((атом? (як-є ())) (правий-неспарений-хвіст (решта ліві) (решта праві))))))

(визначити спарити-зі-збереженням-хвостів
  (функція (ліві праві)
    (список
      (спарити-спільну-частину ліві праві)
      (лівий-неспарений-хвіст ліві праві)
      (правий-неспарений-хвіст ліві праві))))

(визначити відновити-ліві-із-пар
  (функція (пари)
    (за-умовою
      ((атом? пари) (як-є ()))
      ((атом? (як-є ()))
       (сполучити (перше (перше пари))
                  (відновити-ліві-із-пар (решта пари)))))))

(визначити відновити-праві-із-пар
  (функція (пари)
    (за-умовою
      ((атом? пари) (як-є ()))
      ((атом? (як-є ()))
       (сполучити (друге (перше пари))
                  (відновити-праві-із-пар (решта пари)))))))

(визначити приєднати-список-до-хвоста
  (функція (початок хвіст)
    (за-умовою
      ((атом? початок) хвіст)
      ((атом? (як-є ()))
       (сполучити (перше початок)
                  (приєднати-список-до-хвоста (решта початок) хвіст))))))

(визначити відновити-два-списки-зі-хвостів
  (функція (збережено)
    (список
      (приєднати-список-до-хвоста
        (відновити-ліві-із-пар (перше збережено))
        (друге збережено))
      (приєднати-список-до-хвоста
        (відновити-праві-із-пар (перше збережено))
        (третє збережено)))))

(визначити довгі-ліві
  (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?)))
(визначити короткі-праві (список (як-є порожній?) (як-є хибне?)))
(визначити запис-із-лівим-хвостом
  (спарити-зі-збереженням-хвостів довгі-ліві короткі-праві))
(визначити повернені-довгі-ліві
  (відновити-два-списки-зі-хвостів запис-із-лівим-хвостом))

(визначити короткі-ліві (список (як-є як-є)))
(визначити довгі-праві
  (список (як-є атом?) (як-є решта) (як-є за-умовою)))
(визначити запис-із-правим-хвостом
  (спарити-зі-збереженням-хвостів короткі-ліві довгі-праві))
(визначити повернені-довгі-праві
  (відновити-два-списки-зі-хвостів запис-із-правим-хвостом))

; Точна оберненість навіть коли хвости завершуються атомом, а не ().
; Усі позитиви обчислює СЕНС, хибний закон викликає ПЕРШЕ ().
(визначити відновлені-два-атоми
  (відновити-два-списки-зі-хвостів
    (спарити-зі-збереженням-хвостів (як-є атом?) (як-є решта))))
(за-умовою
  ((тотожне? (перше відновлені-два-атоми) (як-є атом?)) так)
  (так (перше (як-є ()))))
(за-умовою
  ((тотожне? (друге відновлені-два-атоми) (як-є решта)) так)
  (так (перше (як-є ()))))

(визначити відновлена-відкрита-ліва
  (відновити-два-списки-зі-хвостів
    (спарити-зі-збереженням-хвостів
      (сполучити (як-є атом?) (як-є сполучити))
      (список (як-є решта)))))
(за-умовою
  ((тотожне? (решта (перше відновлена-відкрита-ліва))
              (як-є сполучити)) так)
  (так (перше (як-є ()))))

(визначити відновлена-відкрита-права
  (відновити-два-списки-зі-хвостів
    (спарити-зі-збереженням-хвостів
      (список (як-є атом?))
      (сполучити (як-є решта) (як-є тотожне?)))))
(за-умовою
  ((тотожне? (решта (друге відновлена-відкрита-права))
              (як-є тотожне?)) так)
  (так (перше (як-є ()))))

