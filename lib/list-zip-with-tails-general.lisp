; Д3–Д5: оборотне спарування спільного префікса двох скінченних списків.
; Обидва неспарені хвости зберігаються дослівно — ніщо не втрачається.
; Значення обчислює SENS; Д7 лише для письма, Zig/T5M лише для точних байтів.

(визначити спарити-спільну-частину
  (функція (ліві праві)
    (за-умовою
      ((порожній? ліві) (як-є ()))
      ((порожній? праві) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (список (перше ліві) (перше праві))
         (спарити-спільну-частину (решта ліві) (решта праві)))))))

(визначити лівий-неспарений-хвіст
  (функція (ліві праві)
    (за-умовою
      ((порожній? праві) ліві)
      ((порожній? ліві) (як-є ()))
      ((атом? (як-є ())) (лівий-неспарений-хвіст (решта ліві) (решта праві))))))

(визначити правий-неспарений-хвіст
  (функція (ліві праві)
    (за-умовою
      ((порожній? ліві) праві)
      ((порожній? праві) (як-є ()))
      ((атом? (як-є ())) (правий-неспарений-хвіст (решта ліві) (решта праві))))))

(визначити спарити-зі-збереженням-хвостів
  (функція (ліві праві)
    (список
      (спарити-спільну-частину ліві праві)
      (лівий-неспарений-хвіст ліві праві)
      (правий-неспарений-хвіст ліві праві))))

(визначити відновити-ліві-із-пар
  (функція (пари)
    (за-умовою
      ((порожній? пари) (як-є ()))
      ((атом? (як-є ()))
       (сполучити (перше (перше пари))
                  (відновити-ліві-із-пар (решта пари)))))))

(визначити відновити-праві-із-пар
  (функція (пари)
    (за-умовою
      ((порожній? пари) (як-є ()))
      ((атом? (як-є ()))
       (сполучити (друге (перше пари))
                  (відновити-праві-із-пар (решта пари)))))))

(визначити приєднати-список-до-хвоста
  (функція (початок хвіст)
    (за-умовою
      ((порожній? початок) хвіст)
      ((атом? (як-є ()))
       (сполучити (перше початок)
                  (приєднати-список-до-хвоста (решта початок) хвіст))))))

(визначити відновити-два-списки-зі-хвостів
  (функція (збережено)
    (список
      (приєднати-список-до-хвоста
        (відновити-ліві-із-пар (перше збережено))
        (друге збережено))
      (приєднати-список-до-хвоста
        (відновити-праві-із-пар (перше збережено))
        (третє збережено)))))

(визначити довгі-ліві
  (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є тотожне?)))
(визначити короткі-праві (список (як-є порожній?) (як-є хибне?)))
(визначити запис-із-лівим-хвостом
