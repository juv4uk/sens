; СЕНС: кожний шостий елемент правильного списку, позиції 6, 12, ...
; Один прохід по решта, одна пара на повну шістку, без арифметики чи сід8.
; Захист атомом до РЕШТА: на порожньому, атомарному та неповному хвості
; немає виклику РЕШТА від атома або ПЕРШЕ від порожнього списку.
; Вкладені дані передаються як ті самі СЕНС-об'єкти; Д7 лише для назв.
(визначити взяти-кожний-шостий
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (решта елементи)) (як-є ()))
   ((атом? (решта (решта елементи))) (як-є ()))
   ((атом? (решта (решта (решта елементи)))) (як-є ()))
   ((атом? (решта (решта (решта (решта елементи))))) (як-є ()))
   ((атом? (решта (решта (решта (решта (решта елементи)))))) (як-є ()))
   (так
    (сполучити
     (перше (решта (решта (решта (решта (решта елементи))))))
     (взяти-кожний-шостий (решта (решта (решта (решта (решта (решта елементи))))))))))))

; Нуль, п'ять, шість та дванадцять елементів, потім вкладена пара.
; Кожен свідок - живий Д1 закон у власному СЕНС, не зовнішнього ствердження.
(за-умовою
 ((порожній? (взяти-кожний-шостий (як-є ()))) так)
 (так (перше (як-є ()))))
; Атомарний вхід і неповна пара також завершуються в СЕНС, без аварії.
(за-умовою
 ((порожній? (взяти-кожний-шостий (як-є атом?))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (взяти-кожний-шостий
   (сполучити (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (взяти-кожний-шостий
   (список (як-є атом?) (як-є решта) (як-є сполучити)
           (як-є функція) (як-є визначити)))) так)
 (так (перше (як-є ()))))
(визначити шості-дванадцяти
 (взяти-кожний-шостий
  (список (як-є атом?) (як-є решта) (як-є сполучити)
          (як-є функція) (як-є визначити) (як-є за-умовою)
          (як-є тотожне?) (як-є порожній?) (як-є хибне?)
          (як-є як-є) (як-є список) (як-є застосувати))))
(за-умовою
 ((тотожне? (перше шості-дванадцяти) (як-є за-умовою)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (друге шості-дванадцяти) (як-є застосувати)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта (решта шості-дванадцяти))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (тотожне? (перше шості-дванадцяти) (як-є визначити))) так)
 (так (перше (як-є ()))))
(визначити шостий-вкладений
 (взяти-кожний-шостий
  (список (як-є атом?) (як-є решта) (як-є сполучити)
          (як-є функція) (як-є визначити)
          (список (як-є за-умовою) (як-є тотожне?)))))
(за-умовою
 ((тотожне? (перше (перше шостий-вкладений)) (як-є за-умовою)) так)
 (так (перше (як-є ()))))
(атом? (як-є ()))
