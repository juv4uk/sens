; D11: парна версія SRFI-1 MAP над двома правильними D3-списками.
; Це похідна SENS-композиція, НЕ нова координата D11.
; Зупиняється за коротшим списком, але ПЕРЕД callback перевіряє обидва
; повні D3-хребти. D1:ні, D3:() та D7-дані є допустимими елементами.
; Лише структурне D3:() завершує правильний список; інший хвіст має Type.

; D11-пропозиція: один повний доказ D3-структури без копіювання хребта.
(визначити підтвердити-список-для-парної-мапи
  (функція (поточний початковий)
    (за-умовою
      ((порожній? поточний) початковий)
      ((атом? поточний) (перше поточний))
      (так
       (підтвердити-список-для-парної-мапи
         (решта поточний) початковий)))))

; D11-пропозиція: рекурсія лише по вже перевірених структурах.
; Callback викликається рівно раз на кожну сформовану пару.
(визначити парно-відобразити-ядро
  (функція (дія лівий правий)
    (за-умовою
      ((порожній? лівий) (як-є ()))
      ((порожній? правий) (як-є ()))
      (так
       (сполучити
         (дія (перше лівий) (перше правий))
         (парно-відобразити-ядро
           дія (решта лівий) (решта правий)))))))

; D11-пропозиція: незалежні перевірки обох входів ДО першої дії.
; Навіть порожній інший вхід НЕ маскує неправильний D1-хвіст.
(визначити парно-відобразити
  (функція (дія лівий правий)
    (парно-відобразити-ядро
      дія
      (підтвердити-список-для-парної-мапи лівий лівий)
      (підтвердити-список-для-парної-мапи правий правий))))
