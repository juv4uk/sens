; Перебудувати хвіст пари без мутації чи зовнішньої семантики.
; Голова результату лишається головою початкової пари.
; Хвіст результату є новим хвостом.
(визначити замінити-хвіст-пари
  (функція (пара новий-хвіст)
    (сполучити (перше пара) новий-хвіст)))

(визначити початкова-пара-хвоста
  (сполучити (як-є атом?) (як-є решта)))
(визначити оновлена-пара-хвоста
  (замінити-хвіст-пари початкова-пара-хвоста (як-є тотожне?)))

; Результат: незмінна голова, новий хвіст і заперечення старого хвоста.
(за-умовою
  ((тотожне? (перше оновлена-пара-хвоста) (як-є атом?))
   (за-умовою
     ((тотожне? (решта оновлена-пара-хвоста) (як-є тотожне?))
      (хибне? (тотожне? (решта оновлена-пара-хвоста) (як-є решта))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
