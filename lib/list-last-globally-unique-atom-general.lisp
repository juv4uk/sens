; Останній атом із рівно одним входженням у ВСЬОМУ списку.
; Повтори не стають унікальними після відкидання лівої частини.
; Складені елементи, включно з (), не є атомними кандидатами.
; СЕНС Д3-Д5 виконує закон, Д7 є проєкцією, Зіг і Т5М пакує готові слова.

(визначити атом-рівно-раз-у-списку?
  (функція (шуканий елементи був)
    (за-умовою
      ((порожній? елементи) був)
      ((порожній? (перше елементи))
       (атом-рівно-раз-у-списку? шуканий (решта елементи) був))
      ((хибне? (атом? (перше елементи)))
       (атом-рівно-раз-у-списку? шуканий (решта елементи) був))
      ((тотожне? шуканий (перше елементи))
       (за-умовою
         (був ні)
         (так (атом-рівно-раз-у-списку? шуканий (решта елементи) так))))
      (так (атом-рівно-раз-у-списку? шуканий (решта елементи) був)))))

(визначити останній-глобально-одиночний-обхід
  (функція (залишок усі накопичений)
    (за-умовою
      ((порожній? залишок) накопичений)
      ((порожній? (перше залишок))
       (останній-глобально-одиночний-обхід (решта залишок) усі накопичений))
      ((хибне? (атом? (перше залишок)))
       (останній-глобально-одиночний-обхід (решта залишок) усі накопичений))
      ((атом-рівно-раз-у-списку? (перше залишок) усі ні)
       (останній-глобально-одиночний-обхід (решта залишок) усі (перше залишок)))
      (так (останній-глобально-одиночний-обхід (решта залишок) усі накопичений)))))

