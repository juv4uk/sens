; Обернути послідовність із трьох елементів без нових дій.
; Перший і останній елементи міняються місцями, середній лишається.
; Повторне обертання повертає початковий список.
(визначити обернути-трійку
  (функція (трійка)
    (список
      (перше (решта-решти трійка))
      (друге трійка)
      (перше трійка))))

; Свідки: порядок, середина, повторне обертання та заперечення.
(за-умовою
    ((тотожне? (перше (обернути-трійку (список (як-є атом?) (як-є тотожне?) (як-є решта)))) (як-є решта))
      (за-умовою
          ((тотожне? (друге (обернути-трійку (список (як-є атом?) (як-є тотожне?) (як-є решта)))) (як-є тотожне?))
            (за-умовою
                ((тотожне? (перше (решта-решти (обернути-трійку (список (як-є атом?) (як-є тотожне?) (як-є решта))))) (як-є атом?))
                  (за-умовою
                      ((тотожне? (перше (обернути-трійку (обернути-трійку (список (як-є атом?) (як-є тотожне?) (як-є решта))))) (як-є атом?))
                        (за-умовою
                            ((тотожне? (перше (решта-решти (обернути-трійку (обернути-трійку (список (як-є атом?) (як-є тотожне?) (як-є решта)))))) (як-є решта))
                              (за-умовою
                                  ((хибне? (тотожне? (перше (обернути-трійку (список (як-є атом?) (як-є тотожне?) (як-є решта)))) (як-є атом?)))
                                    (атом? (як-є ())))
                                  ((атом? (як-є ())) (перше (як-є ())))))
                            ((атом? (як-є ())) (перше (як-є ())))))
                      ((атом? (як-є ())) (перше (як-є ())))))
                ((атом? (як-є ())) (перше (як-є ())))))
          ((атом? (як-є ())) (перше (як-є ())))))
    ((атом? (як-є ())) (перше (як-є ()))))
