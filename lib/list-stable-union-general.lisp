; Стабільне об'єднання двох правильних скінченних списків точних атомів.
; Перші входження зберігаються у порядку: спочатку ліві, потім нові праві.
; Повтори не додаються. Семантика SENS D1/D3/D5, D7 — лише текст, Zig — T5M.
; Відсутні host EQUAL, Python, JSON, окремий опкод або примітив-множина.

(визначити належить-об'єднанню?
  (функція (шукане елементи)
    (за-умовою
      ((атом? елементи) (хибне? (атом? (як-є ()))))
      ((тотожне? шукане (перше елементи)) (атом? (як-є ())))
      ((атом? (як-є ()))
       (належить-об'єднанню? шукане (решта елементи))))))

(визначити приєднати-до-об'єднання
  (функція (початок кінець)
    (за-умовою
      ((атом? початок) кінець)
      ((атом? (як-є ()))
       (сполучити (перше початок)
         (приєднати-до-об'єднання (решта початок) кінець))))))

(визначити зберегти-унікальні-атоми
  (функція (залишок накопичені)
    (за-умовою
      ((атом? залишок) накопичені)
      ((належить-об'єднанню? (перше залишок) накопичені)
       (зберегти-унікальні-атоми (решта залишок) накопичені))
      ((атом? (як-є ()))
       (зберегти-унікальні-атоми
         (решта залишок)
         (приєднати-до-об'єднання накопичені (список (перше залишок))))))))

; Швидкий шлях: один D3 CONS на кожний новий атом, без повторного
; приєднання в кінець уже зібраного списку. Перевірка належності
; лишається точною D3 EQ; жодного host set/hash/registry.
(визначити зберегти-унікальні-обернено
  (функція (залишок накопичені-обернено)
    (за-умовою
      ((атом? залишок) накопичені-обернено)
      ((належить-об'єднанню? (перше залишок) накопичені-обернено)
       (зберегти-унікальні-обернено (решта залишок) накопичені-обернено))
      ((атом? (як-є ()))
       (зберегти-унікальні-обернено
         (решта залишок)
         (сполучити (перше залишок) накопичені-обернено))))))

(визначити розгорнути-обернене-об'єднання
  (функція (залишок накопичені)
    (за-умовою
      ((атом? залишок) накопичені)
      ((атом? (як-є ()))
       (розгорнути-обернене-об'єднання
         (решта залишок)
         (сполучити (перше залишок) накопичені))))))

; Два вхідні списки: одна зворотна акумуляція й одне відновлення.
; Публічні допоміжні API вище збережено, а не замінено бутафорією.
(визначити об'єднати-атоми-стало
  (функція (ліві праві)
    (розгорнути-обернене-об'єднання
      (зберегти-унікальні-обернено праві
        (зберегти-унікальні-обернено ліві (як-є ())))
      (як-є ()))))

(визначити ліві-атомні-дані (список (як-є атом?) (як-є решта) (як-є атом?) (як-є сполучити) (як-є решта) (як-є тотожне?)))
(визначити праві-атомні-дані (список (як-є сполучити) (як-є порожній?) (як-є хибне?) (як-є порожній?) (як-є атом?)))
(визначити результат-об'єднання (об'єднати-атоми-стало ліві-атомні-дані праві-атомні-дані))
(визначити лише-ліворуч (об'єднати-атоми-стало ліві-атомні-дані (як-є ())))
(визначити лише-праворуч (об'єднати-атоми-стало (як-є ()) праві-атомні-дані))
(визначити двічі-один (об'єднати-атоми-стало (список (як-є атом?)) (список (як-є атом?))))
(визначити різні-поодинці (об'єднати-атоми-стало (список (як-є атом?)) (список (як-є решта))))
(визначити повтори-праворуч (об'єднати-атоми-стало (як-є ()) (список (як-є решта) (як-є решта) (як-є решта))))
(визначити приєднані-три (приєднати-до-об'єднання (список (як-є атом?) (як-є решта)) (список (як-є сполучити))))

