; Порівняти новий одноразовий акумулятор зі старим публічним
; точним алгоритмом SENS. Обидва виконує лише SENS, без Python/JSON.
(визначити однакові-атомні-списки-об'єднання?
  (функція (ліві праві)
    (за-умовою
      ((порожній? ліві) (порожній? праві))
      ((порожній? праві) ні)
      ((тотожне? (перше ліві) (перше праві))
       (однакові-атомні-списки-об'єднання? (решта ліві) (решта праві)))
      (так ні))))

(визначити об'єднання-узгоджене-зі-старим?
  (функція (ліві праві)
    (однакові-атомні-списки-об'єднання?
      (об'єднати-атоми-стало ліві праві)
      (зберегти-унікальні-атоми праві
        (зберегти-унікальні-атоми ліві (як-є ()))))))

; Нові fail-closed свідки: перетин, повтори, порожні та порядок.
(за-умовою
  ((об'єднання-узгоджене-зі-старим? ліві-атомні-дані праві-атомні-дані)
   (атом? (як-є ())))
  (так (перше (як-є ()))))
(за-умовою
  ((об'єднання-узгоджене-зі-старим? (як-є ()) праві-атомні-дані)
   (атом? (як-є ())))
  (так (перше (як-є ()))))
(за-умовою
  ((об'єднання-узгоджене-зі-старим? ліві-атомні-дані (як-є ()))
   (атом? (як-є ())))
  (так (перше (як-є ()))))
(за-умовою
  ((об'єднання-узгоджене-зі-старим?
     (список (як-є атом?) (як-є атом?) (як-є решта))
     (список (як-є решта) (як-є атом?) (як-є сполучити)))
   (атом? (як-є ())))
  (так (перше (як-є ()))))
(за-умовою
  ((об'єднання-узгоджене-зі-старим? (як-є ()) (як-є ()))
   (атом? (як-є ())))
  (так (перше (як-є ()))))
; Негатив: тестовий компаратор не приймає неправильний порядок.
(за-умовою
  ((хибне?
     (однакові-атомні-списки-об'єднання?
       (список (як-є атом?) (як-є решта))
       (список (як-є решта) (як-є атом?))))
   (атом? (як-є ())))
  (так (перше (як-є ()))))
