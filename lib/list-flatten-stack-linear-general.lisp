; Конкурс оптимізації: сплющення вкладених правильних списків без АППЕНД.
; Кожен вузол розглядається один раз, результат перевертається один раз.
; Явний стек ще не оброблених хвостів, хвостова рекурсія Д3-Д5.
; На відміну від послідовних дописувань префікса, О(кількість вузлів).
; Порожні списки-елементи не дають атома; порядок і повтори зберігаються.
; Значення рахує СЕНС, Д7 - лише людська проєкція, Зіг і Т5М - транспорт.

(визначити обернути-накопичені-атоми
 (функція (залишок накопичені)
  (за-умовою
   ((порожній? залишок) накопичені)
   (так (обернути-накопичені-атоми
         (решта залишок)
         (сполучити (перше залишок) накопичені))))))

(визначити сплющити-стековий-обхід
 (функція (поточні стек накопичені)
  (за-умовою
   ((порожній? поточні)
    (за-умовою
     ((порожній? стек)
      (обернути-накопичені-атоми накопичені (як-є ())))
     (так (сплющити-стековий-обхід
           (перше стек) (решта стек) накопичені))))
   ((порожній? (перше поточні))
    (сплющити-стековий-обхід
     (решта поточні) стек накопичені))
   ((атом? (перше поточні))
    (сплющити-стековий-обхід
     (решта поточні) стек
     (сполучити (перше поточні) накопичені)))
   (так (сплющити-стековий-обхід
         (перше поточні)
         (сполучити (решта поточні) стек)
         накопичені)))))

(визначити сплющити-вкладені-стеково
