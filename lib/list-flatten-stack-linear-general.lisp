  (сплющити-стековий-обхід елементи (як-є ()) (як-є ()))))

(визначити рівні-списки-атомів-стеково?
 (функція (ліві праві)
  (за-умовою
   ((порожній? ліві) (порожній? праві))
   ((порожній? праві) ні)
   ((тотожне? (перше ліві) (перше праві))
    (рівні-списки-атомів-стеково? (решта ліві) (решта праві)))
   (так ні))))

