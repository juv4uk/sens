; Негативні свідки: перша трійка не повинна перемагати останню.
(за-умовою
 ((хибне? (тотожні-дерева-трійки?
   (хвіст-після-останньої-трійки
    (список (як-є атом?) (як-є атом?) (як-є атом?)
            (як-є решта) (як-є решта) (як-є решта) (як-є сполучити)))
   (список (як-є решта) (як-є решта) (як-є решта) (як-є сполучити))))
  (атом? (як-є ())))
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (тотожні-дерева-трійки?
   (хвіст-після-останньої-трійки
    (список (як-є атом?) (як-є решта) (як-є атом?)))
   (список (як-є атом?))))
  (атом? (як-є ())))
 (так (перше (як-є ()))))

(атом? (як-є ()))
