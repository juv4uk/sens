; СЕНС: хвіст після останньої трійки однакових сусідніх атомів.
; Один прохід скінченного списку атомів, без створення нових пар.
; Запам'ятовуємо вихідний хвіст, а не копіюємо префікси.
; Трійки можуть перекриватися: у чотирьох однакових атомах їх дві.
(визначити знайти-останню-трійку-далі
 (функція (залишок знайдений)
  (за-умовою
   ((атом? залишок) знайдений)
   ((атом? (решта залишок)) знайдений)
   ((атом? (решта (решта залишок))) знайдений)
   ; Д3 ТОТОЖНЕ? працює лише на атомах; пропустити складені елементи.
   ((хибне? (атом? (перше залишок)))
    (знайти-останню-трійку-далі (решта залишок) знайдений))
   ((хибне? (атом? (друге залишок)))
    (знайти-останню-трійку-далі (решта залишок) знайдений))
   ((хибне? (атом? (третє залишок)))
    (знайти-останню-трійку-далі (решта залишок) знайдений))
   ((тотожне? (перше залишок) (друге залишок))
    (за-умовою
     ((тотожне? (перше залишок) (третє залишок))
      (знайти-останню-трійку-далі
       (решта залишок) (решта (решта (решта залишок)))))
     (так (знайти-останню-трійку-далі (решта залишок) знайдений))))
   (так (знайти-останню-трійку-далі (решта залишок) знайдений)))))

(визначити хвіст-після-останньої-трійки
 (функція (елементи)
  (знайти-останню-трійку-далі елементи (як-є ()))))

; Структурну рівність обчислює сам СЕНС, без порівняння хостових рядків.
(визначити тотожні-дерева-трійки?
 (функція (лівий правий)
  (за-умовою
   ((атом? лівий)
    (за-умовою
     ((атом? правий) (тотожне? лівий правий))
     (так ні)))
   ((атом? правий) ні)
   ((тотожні-дерева-трійки? (перше лівий) (перше правий))
    (тотожні-дерева-трійки? (решта лівий) (решта правий)))
   (так ні))))

(визначити довести-останню-трійку
 (функція (вхід очікуване)
  (за-умовою
   ((тотожні-дерева-трійки?
     (хвіст-після-останньої-трійки вхід) очікуване)
    (атом? (як-є ())))
   (так (перше (як-є ()))))))

; Порожній, одиничний і короткий списки не містять трійки.
(довести-останню-трійку (як-є ()) (як-є ()))
