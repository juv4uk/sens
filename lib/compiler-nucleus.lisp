; Повне замикання компілятора для третього домену походить
; лише з ратифікованих структурних відношень.
; Двоїсті ролі обчислюються законом, а не зашитими координатами.
(визначити роль-компілятора-за-бітами-л1-л5
  (функція (початковий-код біти-координати закон-домену)
    (за-умовою
      ((бітові-послідовності-однакові? початковий-код біти-координати (біти-голови-остова-л5-компілятора закон-домену))
       (як-є selector-head))
      ((бітові-послідовності-однакові?
         початковий-код біти-координати
         (виключне-або-бітових-послідовностей-компілятора
           початковий-код
           (біти-голови-остова-л5-компілятора закон-домену)
           (компілятор-маска-виключного-або-закону закон-домену)))
       (як-є selector-tail))
      ((бітові-послідовності-однакові?
         початковий-код біти-координати
         (виключне-або-бітових-послідовностей-компілятора
           початковий-код
           (компілятор-порожні-біти-закону закон-домену)
           (компілятор-маска-виключного-або-закону закон-домену)))
       (як-є pair-construct))
      ((істина-компілятора початковий-код) ()))))

; Повний набір перетворень третього домену потрібний для самокомпіляції.
; Окремі назви зберігають чинний зовнішній інтерфейс трьох ролей.
(визначити роль-пониження-компілятора-за-бітами-л1-л5
  (функція (початковий-код біти-координати закон-домену)
    (за-умовою
      ((бітові-послідовності-однакові?
         початковий-код біти-координати
         (виключне-або-бітових-послідовностей-компілятора
           початковий-код
           (біти-умови-остова-л5-компілятора закон-домену)
           (компілятор-маска-виключного-або-закону закон-домену)))
       (як-є quote-form))
      ((бітові-послідовності-однакові? початковий-код біти-координати (біти-атома-остова-л5-компілятора закон-домену))
       (як-є atom-predicate))
      ((бітові-послідовності-однакові?
         початковий-код біти-координати
         (виключне-або-бітових-послідовностей-компілятора
           початковий-код
           (біти-голови-остова-л5-компілятора закон-домену)
           (компілятор-маска-виключного-або-закону закон-домену)))
       (як-є selector-tail))
      ((бітові-послідовності-однакові? початковий-код біти-координати (біти-голови-остова-л5-компілятора закон-домену))
       (як-є selector-head))
      ((бітові-послідовності-однакові?
         початковий-код біти-координати
         (виключне-або-бітових-послідовностей-компілятора
           початковий-код
           (біти-атома-остова-л5-компілятора закон-домену)
           (компілятор-маска-виключного-або-закону закон-домену)))
       (як-є atom-equality))
      ((бітові-послідовності-однакові? початковий-код біти-координати (біти-умови-остова-л5-компілятора закон-домену))
       (як-є cond-form))
      ((бітові-послідовності-однакові?
         початковий-код біти-координати
         (виключне-або-бітових-послідовностей-компілятора
           початковий-код
           (компілятор-порожні-біти-закону закон-домену)
           (компілятор-маска-виключного-або-закону закон-домену)))
       (як-є pair-construct))
      ((істина-компілятора початковий-код) ()))))

(визначити роль-компілятора-за-л1-л5
  (функція (розкласти-ідентичність ідентичність закон-домену)
    (за-умовою
      ((однакові?
         (компілятор-ширина-форми (розкласти-ідентичність ідентичність))
         (компілятор-ширина-закону закон-домену))
       (роль-компілятора-за-бітами-л1-л5
         ідентичність
         (компілятор-біти-форми (розкласти-ідентичність ідентичність))
         закон-домену))
      ((істина-компілятора ідентичність) ()))))


; Виведення початкових ролей четвертого домену з ратифікованого порядку.
; Структурний закон четвертого домену передається як:
; ширина, біти батьківського слова, впорядковані нащадки.
; Нащадки утворюють точну двоелементну структуру ратифікації.
; Самі дані не містять назв ролей компілятора.
; Перший і другий незвідні нащадки відповідають функції та визначенню.
; Початкове виконання користується композицією селекторів третього домену;
; ратифіковані селектори вищих доменів зберігають окремі тотожності.
; Поточний закон зниження ще не допускає прямих викликів п'ятого домену.
; Ширина є частиною тотожності, а не підставою для псевдоніма.
(визначити компілятор-ширина-закону-д4
  (функція (закон-домену)
    (перше закон-домену)))

(визначити компілятор-дочірні-елементи-закону-д4
  (функція (закон-домену)
