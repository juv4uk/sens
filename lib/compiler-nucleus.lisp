    (за-умовою
      ((бітові-послідовності-однакові? початковий-код біти-координати (компілятор-перший-дочірній-елемент-закону-д4 закон-домену))
       (як-є lambda-form))
      ((бітові-послідовності-однакові? початковий-код біти-координати (компілятор-другий-дочірній-елемент-закону-д4 закон-домену))
