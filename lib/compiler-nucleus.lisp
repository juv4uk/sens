; Виклик ролі охоплює все чинне ядро компілятора.
; Ширина обирає застосовний ратифікований структурний закон.
; Рівність упакованих байтів не надає жодному механізму семантичної влади.
(визначити роль-пониження-компілятора-за-л1-л5
  (функція (розкласти-ідентичність ідентичність закон-домену)
    (за-умовою
      ((однакові?
         (компілятор-ширина-форми (розкласти-ідентичність ідентичність))
         (компілятор-ширина-закону закон-домену))
       (роль-пониження-компілятора-за-бітами-л1-л5
         ідентичність
         (компілятор-біти-форми (розкласти-ідентичність ідентичність))
         закон-домену))
      ((істина-компілятора ідентичність) ()))))

(визначити роль-пониження-компілятора-за-законами
  (функція (розкласти-ідентичність ідентичність закон-д3 закон-д4)
    (за-умовою
      ((однакові?
         (компілятор-ширина-форми (розкласти-ідентичність ідентичність))
         (компілятор-ширина-закону закон-д3))
       (роль-пониження-компілятора-за-л1-л5 розкласти-ідентичність ідентичність закон-д3))
      ((однакові?
         (компілятор-ширина-форми (розкласти-ідентичність ідентичність))
         (компілятор-ширина-закону-д4 закон-д4))
       (компілятор-роль-основи-д4 розкласти-ідентичність ідентичність закон-д4))
      ((істина-компілятора ідентичність) ()))))


; Перехід виробничих запитів на мовний механізм.
; Ролі походять тільки із законів, виведених вище.
; Зовнішня межа передає закон і докази, але ролі не обирає.

; Порожня роль означає відсутність допуску цього значення.
; Не можна створювати неповний запит із порожньою роллю.
; Структурна порожнеча є окремим атомарним значенням;
; точну рівність із порожнечею перевіряємо до запиту.
(визначити запит-компілятора-за-роллю
  (функція (початковий-код ідентичність роль-виконання посилання-на-доказ походження)
    (за-умовою
      ((тотожне? роль-виконання ()) ())
      ((істина-компілятора початковий-код)
       (сполучити
         ідентичність
         (сполучити
           роль-виконання
           (сполучити
             посилання-на-доказ
             (сполучити походження ()))))))))

(визначити запит-компілятора-за-л1-л5
  (функція (розкласти-ідентичність ідентичність закон-домену посилання-на-доказ походження)
    (запит-компілятора-за-роллю
      ідентичність
      ідентичність
      (роль-компілятора-за-л1-л5 розкласти-ідентичність ідентичність закон-домену)
      посилання-на-доказ
      походження)))


; Обхід повної програми компілятором.
;
; Дані програми — джерельне дерево з ратифікованого формату.
; Точні доменні виклики подаються звичайними списками;
; їхня голова є точною доменною тотожністю.
; Механізм подання може повернути ширину й біти або порожнечу.
;
; Обхід сам обирає семантичний запит мовою СЕНС.
; Результат містить біт успіху та список запитів.
; Непідтриману точну форму не можна плутати з порожнім піддеревом.
; Подальше машинне зниження лишається поза програмою.

(визначити запит-компілятора-за-законами
  (функція (розкласти-ідентичність ідентичність закон-д3 закон-д4 доказ-д3 доказ-д4 походження)
    (за-умовою
      ((однакові?
         (компілятор-ширина-форми (розкласти-ідентичність ідентичність))
         (компілятор-ширина-закону закон-д3))
       (запит-компілятора-за-роллю
         ідентичність
         ідентичність
         (роль-пониження-компілятора-за-л1-л5 розкласти-ідентичність ідентичність закон-д3)
         доказ-д3
         походження))
      ((однакові?
         (компілятор-ширина-форми (розкласти-ідентичність ідентичність))
         (компілятор-ширина-закону-д4 закон-д4))
       (запит-компілятора-за-роллю
         ідентичність
         ідентичність
         (компілятор-роль-основи-д4 розкласти-ідентичність ідентичність закон-д4)
         доказ-д4
         походження))
      ((істина-компілятора ідентичність) ()))))

(визначити компілятор-створити-успішний-результат
  (функція (запити)
    (сполучити (істина-компілятора ()) запити)))

(визначити компілятор-створити-невдалий-результат
  (функція ()
    (сполучити (хиба-компілятора ()) ())))

(визначити компілятор-результат-успішний?
  (функція (результат)
    (перше результат)))

(визначити компілятор-запити-результату
  (функція (результат)
    (решта результат)))

; СЕНС · компіляторне приєднання з точним D3 структурним кінцем.
; Лише D3:() повертає правий список; D1:ні й довільний інший атомний
; хвіст ліворуч зобов'язані дати D3 ПЕРШЕ Type, а не частковий результат.
; Правий аргумент передається без копіювання та зміни.
(визначити компілятор-приєднати
  (функція (лівий правий)
    (за-умовою
      ((атом? лівий)
       (за-умовою
         ((тотожне? лівий (як-є ())) правий)
         (так (перше лівий))))
      ((істина-компілятора ())
       (сполучити
         (перше лівий)
         (компілятор-приєднати (решта лівий) правий))))))

(визначити об'єднати-результати-компілятора
  (функція (лівий правий)
    (за-умовою
      ((компілятор-результат-успішний? лівий)
       (за-умовою
         ((компілятор-результат-успішний? правий)
          (компілятор-створити-успішний-результат
            (компілятор-приєднати
              (компілятор-запити-результату лівий)
              (компілятор-запити-результату правий))))
         ((істина-компілятора ()) (компілятор-створити-невдалий-результат))))
      ((істина-компілятора ()) (компілятор-створити-невдалий-результат)))))

(визначити роль-запиту-компілятора
  (функція (запит)
    (перше (решта запит))))

; Джерельну форму перевіряємо лише після виведення ролі.
; Порядок перевірки: від ролі до арності, не від бітів до змісту.
; Аргументи є правильними списками даних програми.
; Кількість перевіряємо через атомарність хвоста,
; а не через операцію над уже обчисленою відповіддю.
(визначити рівно-один-аргумент-компілятора
  (функція (аргументи)
    (за-умовою
      ((атом? аргументи) (хиба-компілятора ()))
      ((кінець-списку-компілятора? (решта аргументи)) (істина-компілятора ()))
      ((істина-компілятора ()) (хиба-компілятора ())))))

(визначити рівно-два-аргументи-компілятора
  (функція (аргументи)
    (за-умовою
      ((атом? аргументи) (хиба-компілятора ()))
      ((атом? (решта аргументи)) (хиба-компілятора ()))
      ((кінець-списку-компілятора? (решта (решта аргументи))) (істина-компілятора ()))
      ((істина-компілятора ()) (хиба-компілятора ())))))

; Варіативний хвіст завершується тільки точною порожнечею.
; Атомарність відрізняє неправильний непорожній терм від порожнечі.
; Цю межу встановлює вже допущена мовна перевірка.
(визначити правильний-хвіст-компілятора?
  (функція (хвіст)
    (за-умовою
      ((кінець-списку-компілятора? хвіст) (істина-компілятора ()))
      ((атом? хвіст) (хиба-компілятора ()))
      ((атом? (як-є ())) (правильний-хвіст-компілятора? (решта хвіст))))))

; Функція має параметри й щонайменше одну форму тіла.
; Обидві обов'язкові комірки аргументів повинні бути парами.
; Решта має бути правильним списком, навіть якщо дані містять крапкові пари.
(визначити щонайменше-два-аргументи-компілятора
  (функція (аргументи)
    (за-умовою
      ((атом? аргументи) (хиба-компілятора ()))
      ((атом? (решта аргументи)) (хиба-компілятора ()))
      ((атом? (як-є ())) (правильний-хвіст-компілятора? (решта (решта аргументи)))))))

; Умовний вибір третього домену є непорожнім списком двопольових умов.
(визначити клаузи-умов-компілятора-чинні?
  (функція (клаузи)
    (за-умовою
      ((кінець-списку-компілятора? клаузи) (істина-компілятора ()))
      ((атом? клаузи) (хиба-компілятора ()))
      ((рівно-два-аргументи-компілятора (перше клаузи))
       (клаузи-умов-компілятора-чинні? (решта клаузи)))
      ((істина-компілятора ()) (хиба-компілятора ())))))

(визначити форма-ролі-компілятора-чинна?
  (функція (запит-компіляції аргументи-форми)
    (за-умовою
      ((атом? запит-компіляції) (хиба-компілятора ()))
      ((тотожне? (роль-запиту-компілятора запит-компіляції) (як-є quote-form))
       (рівно-один-аргумент-компілятора аргументи-форми))
      ((тотожне? (роль-запиту-компілятора запит-компіляції) (як-є atom-predicate))
       (рівно-один-аргумент-компілятора аргументи-форми))
      ((тотожне? (роль-запиту-компілятора запит-компіляції) (як-є selector-tail))
       (рівно-один-аргумент-компілятора аргументи-форми))
      ((тотожне? (роль-запиту-компілятора запит-компіляції) (як-є selector-head))
       (рівно-один-аргумент-компілятора аргументи-форми))
      ((тотожне? (роль-запиту-компілятора запит-компіляції) (як-є atom-equality))
       (рівно-два-аргументи-компілятора аргументи-форми))
      ((тотожне? (роль-запиту-компілятора запит-компіляції) (як-є pair-construct))
       (рівно-два-аргументи-компілятора аргументи-форми))
      ((тотожне? (роль-запиту-компілятора запит-компіляції) (як-є lambda-form))
       (щонайменше-два-аргументи-компілятора аргументи-форми))
      ((тотожне? (роль-запиту-компілятора запит-компіляції) (як-є define-form))
       (рівно-два-аргументи-компілятора аргументи-форми))
      ((тотожне? (роль-запиту-компілятора запит-компіляції) (як-є cond-form))
       (за-умовою
         ((атом? аргументи-форми) (хиба-компілятора ()))
         ((істина-компілятора ()) (клаузи-умов-компілятора-чинні? аргументи-форми))))
      ((істина-компілятора ()) (хиба-компілятора ())))))

; Правила обходу є семантикою, отже належать СЕНС.
; Цитований вираз, параметри функції та назва визначення є даними.
; Інші допущені форми рекурсивно обробляють кожний аргумент.
; Умовні пари третього домену містять вираз умови та результат.
; Вони не є викликами предиката першого домену.
; Кожну пару розгортаємо в умову, результат і решту умов.
; Це не створює нової координати чи викликуваного резидента.
(визначити компілятор-вирази-гілок-умови
  (функція (гілки-умов)
    (за-умовою
      ((атом? гілки-умов) ())
      ((рівно-два-аргументи-компілятора (перше гілки-умов))
       (сполучити
         (перше (перше гілки-умов))
         (сполучити
           (перше (решта (перше гілки-умов)))
           (компілятор-вирази-гілок-умови (решта гілки-умов)))))
      ((атом? (як-є ())) ()))))

(визначити дочірні-форми-домену-компілятора
  (функція (запит-компіляції аргументи-форми)
    (за-умовою
      ((атом? запит-компіляції) ())
      ((тотожне? (роль-запиту-компілятора запит-компіляції) (як-є quote-form)) ())
      ((тотожне? (роль-запиту-компілятора запит-компіляції) (як-є lambda-form))
       (решта аргументи-форми))
      ((тотожне? (роль-запиту-компілятора запит-компіляції) (як-є define-form))
       (решта аргументи-форми))
      ((тотожне? (роль-запиту-компілятора запит-компіляції) (як-є cond-form))
       (компілятор-вирази-гілок-умови аргументи-форми))
      ((істина-компілятора ()) аргументи-форми))))

(визначити результат-домену-компілятора
  (функція
    (запит-компіляції аргументи-форми результат-нащадків)
    (за-умовою
      ((атом? запит-компіляції) (компілятор-створити-невдалий-результат))
      ((форма-ролі-компілятора-чинна? запит-компіляції аргументи-форми)
       (за-умовою
         ((компілятор-результат-успішний? результат-нащадків)
          (компілятор-створити-успішний-результат
            (сполучити
              запит-компіляції
              (компілятор-запити-результату результат-нащадків))))
         ((істина-компілятора ()) (компілятор-створити-невдалий-результат))))
      ((істина-компілятора ()) (компілятор-створити-невдалий-результат)))))

; Обхід у хвостовій позиції обмежує стек вкладеністю виразів,
; а не кількістю сусідніх форм; запити накопичуються у зворотному порядку.
; Семантика вибору та відмови повністю належить мові СЕНС.
; D3: тільки точне () завершує правильний список.
; D1:ні чи будь-який інший атомний хвіст — справжня D3 ПЕРШЕ Type.
; Неправильна структура не повертає мовчки частковий результат.
(визначити компілятор-зворот-до
  (функція (елементи накопичувач)
    (за-умовою
      ((атом? елементи)
       (за-умовою
         ((тотожне? елементи (як-є ())) накопичувач)
         (так (перше елементи))))
      ((істина-компілятора ())
       (компілятор-зворот-до
         (решта елементи)
         (сполучити (перше елементи) накопичувач))))))

(визначити компілятор-продовжити-список-програми
  (функція
    (форма-або-порожнє розкласти-ідентичність результат-вузла решта-вузлів закон-д3 закон-д4 доказ-д3 доказ-д4 походження накопичувач)
    (за-умовою
      ((компілятор-результат-успішний? результат-вузла)
       (компілятор-список-програми-з-накопичувачем
         форма-або-порожнє
         розкласти-ідентичність
         решта-вузлів
         закон-д3
         закон-д4
         доказ-д3
         доказ-д4
         походження
         (компілятор-зворот-до
           (компілятор-запити-результату результат-вузла)
           накопичувач)))
      ((істина-компілятора ()) (компілятор-створити-невдалий-результат)))))

(визначити компілятор-список-програми-з-накопичувачем
  (функція
    (форма-або-порожнє розкласти-ідентичність вузли закон-д3 закон-д4 доказ-д3 доказ-д4 походження накопичувач)
    (за-умовою
      ((кінець-списку-компілятора? вузли)
       (компілятор-створити-успішний-результат (компілятор-зворот-до накопичувач ())))
      ((атом? вузли) (компілятор-створити-невдалий-результат))
      ((істина-компілятора ())
       (компілятор-продовжити-список-програми
         форма-або-порожнє
         розкласти-ідентичність
         (вузол-програми-компілятора
           форма-або-порожнє
           розкласти-ідентичність
           (перше вузли)
           закон-д3
           закон-д4
           доказ-д3
           доказ-д4
           походження)
         (решта вузли)
         закон-д3
         закон-д4
         доказ-д3
         доказ-д4
         походження
         накопичувач)))))

(визначити список-програми-компілятора
  (функція
    (форма-або-порожнє розкласти-ідентичність вузли закон-д3 закон-д4 доказ-д3 доказ-д4 походження)
    (компілятор-список-програми-з-накопичувачем
      форма-або-порожнє
      розкласти-ідентичність
      вузли
      закон-д3
      закон-д4
      доказ-д3
      доказ-д4
      походження
      ())))

(визначити вузол-програми-компілятора
  (функція
    (форма-або-порожнє розкласти-ідентичність вузол закон-д3 закон-д4 доказ-д3 доказ-д4 походження)
    (за-умовою
      ((атом? вузол) (компілятор-створити-успішний-результат ()))
      ((атом? (форма-або-порожнє (перше вузол)))
       (список-програми-компілятора
         форма-або-порожнє
         розкласти-ідентичність
         вузол
         закон-д3
         закон-д4
         доказ-д3
         доказ-д4
         походження))
      ((істина-компілятора ())
       (результат-домену-компілятора
         (запит-компілятора-за-законами
           розкласти-ідентичність
           (перше вузол)
           закон-д3
           закон-д4
           доказ-д3
           доказ-д4
           походження)
         (решта вузол)
         (список-програми-компілятора
           форма-або-порожнє
           розкласти-ідентичність
           (дочірні-форми-домену-компілятора
             (запит-компілятора-за-законами
               розкласти-ідентичність
               (перше вузол)
               закон-д3
               закон-д4
               доказ-д3
               доказ-д4
               походження)
             (решта вузол))
           закон-д3
           закон-д4
           доказ-д3
           доказ-д4
           походження))))))

(визначити скомпілювати-програму-компілятора
  (функція
    (форма-або-порожнє розкласти-ідентичність програма закон-д3 закон-д4 доказ-д3 доказ-д4 походження)
    (список-програми-компілятора
      форма-або-порожнє
      розкласти-ідентичність
      програма
      закон-д3
      закон-д4
      доказ-д3
      доказ-д4
      походження)))


; Побудова артефакту програми цілком.
;
; Зовнішня межа передає тільки механічні свідчення походження:
; точний відбиток байтів програми;
; точну закріплену редакцію СЕНС;
; точний відбиток джерела ядра компілятора;
; та один механізм обчислення відбитка.
;
; Сама мова вибирає послідовність семантичних запитів для відбитка
; і створює незалежний від машинного виконавця артефакт.
; Механізм відбитка не визначає тотожність, ролі чи політику виконання.
(визначити поле-артефакту-компілятора
  (функція (назва-поля значення-поля)
    (сполучити назва-поля (сполучити значення-поля ()))))

(визначити артефакт-компілятора-за-результатом
  (функція
    (відбиток ша256-пакованої-програми походження-артефакту результат-компіляції)
    (за-умовою
      ((компілятор-результат-успішний? результат-компіляції)
       (сполучити
         (як-є compiler-compilation-artifact-1)
         (сполучити
           (поле-артефакту-компілятора
             (як-є artifact-kind)
             (як-є whole-program))
           (сполучити
             (поле-артефакту-компілятора
               (як-є program-wire-sha256)
               ша256-пакованої-програми)
             (сполучити
               (поле-артефакту-компілятора
                 (як-є semantic-requests-sha256)
                 (відбиток (компілятор-запити-результату результат-компіляції)))
               (сполучити
                 (поле-артефакту-компілятора
                   (як-є authority-provenance)
                   походження-артефакту)
                 (сполучити
                   (поле-артефакту-компілятора
                     (як-є semantic-requests)
                     (компілятор-запити-результату результат-компіляції))
                   (сполучити
                     (поле-артефакту-компілятора
                       (як-є required-capabilities)
                       ())
                     (сполучити
                       (поле-артефакту-компілятора
                         (як-є artifact-status)
                         (як-є canonical-backend-neutral))
                       ())))))))))
      ((істина-компілятора ())
       (сполучити
         (як-є compiler-compilation-error-1)
         (сполучити
           (поле-артефакту-компілятора
             (як-є program-wire-sha256)
             ша256-пакованої-програми)
           (сполучити
             (поле-артефакту-компілятора
               (як-є error)
               (як-є compiler-program-rejected))
             ())))))))

(визначити скомпілювати-артефакт-програми-компілятора
  (функція
    (форма-або-порожнє розкласти-ідентичність відбиток програма закон-д3 закон-д4 доказ-д3 доказ-д4 походження-запиту походження-артефакту ша256-пакованої-програми)
    (артефакт-компілятора-за-результатом
      відбиток
      ша256-пакованої-програми
      походження-артефакту
      (скомпілювати-програму-компілятора
        форма-або-порожнє
        розкласти-ідентичність
        програма
        закон-д3
        закон-д4
        доказ-д3
        доказ-д4
        походження-запиту))))

; Кінцевий виклик-свідок: файл виконується при завантаженні, а не лише визначає.
(компілятор-результат-успішний? (компілятор-створити-успішний-результат (як-є ())))

