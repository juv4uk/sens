; guard.lisp — спільна форма інженерної поради для власника й агентів.
; Guard не є окремим reasoner-ом: він пакує спостережений стан, чинний
; контракт, різницю, вплив, пораду та докази у стабільне WSM-значення.
;
; Модуль захисту не створює окремого механізму міркування.
; Він збирає спостереження, контракт, різницю, вплив, пораду й докази
; у стале значення СЕНС. Адаптери Rust тільки спостерігають механізми;
; тлумачення належить самій мові.
;
; Результати предикатів використовують точну однобітну проєкцію,
; без підміни через ATOM або NOT. Умови мають рівно два поля.
; Ширина входить до ідентичності; кожен біт адреси є значущим.

(визначити захист-рішення?
  (функція (рішення)
    (за-умовою
      ((тотожне? рішення (як-є allow)) так)
      ((тотожне? рішення (як-є warn)) так)
      ((тотожне? рішення (як-є reject)) так)
      ((тотожне? рішення (як-є unknown)) так)
      (так ні))))

(визначити захист-доказ-стан?
  (функція (стан-доказу)
    (за-умовою
      ((тотожне? стан-доказу (як-є confirmed)) так)
      ((тотожне? стан-доказу (як-є partial)) так)
      ((тотожне? стан-доказу (як-є unresolved)) так)
      ((тотожне? стан-доказу (як-є broken)) так)
      (так ні))))

; Невідомий результат означає потребу в маршрутизації, а не глухий кут.
; Розрізняємо локальні знання, повноваження власника та зовнішнє дослідження.
; UNKNOWN — це стан маршрутизації, а не глухий кут. Маршрути розрізняють
; розподілене локальне знання, владу власника і зовнішнє дослідження.
(визначити захист-невідоме-маршрути
  (функція ()
    (як-є
      (((route ask-agent)
        (when ecosystem-local-or-component-owned)
        (action ask-responsible-live-agent)
        (verify commit-or-artifact-or-direct-source))
       ((route ask-owner)
        (when authority-choice-intent-license-or-destructive-scope)
        (action ask-owner-explicitly)
        (verify owner-decision-record))
       ((route research-web)
        (when external-current-or-primary-source-needed)
        (action search-authoritative-external-sources)
        (verify citations-and-access-date))))))

(визначити створити-захист-висновок
  (функція (рішення стан-свідчення предмет стан контракт різниця вплив порада докази)
    (за-умовою
      ((хибне? (захист-рішення? рішення))
       (список (як-є invalid-guard-decision) рішення))
      ((хибне? (захист-доказ-стан? стан-свідчення))
       (список (як-є invalid-evidence-status) стан-свідчення))
      (так
       (список
         (як-є guard-finding)
         (список (як-є schema) (як-є guard/1))
         (список (як-є decision) рішення)
         (список (як-є evidence-status) стан-свідчення)
         (список (як-є subject) предмет)
         (список (як-є state) стан)
         (список (як-є contract) контракт)
         (список (як-є difference) різниця)
         (список (як-є impact) вплив)
         (список (як-є guidance) порада)
         (список (як-є evidence) докази)
         (список
           (як-є unknown-routes)
           (за-умовою
             ((тотожне? рішення (як-є unknown)) (захист-невідоме-маршрути))
             (так (як-є ())))))))))

; Відсутність факту означає невизначеність, а не неявне відхилення.
; Відсутній факт означає UNKNOWN, а не неявну заборону.
(визначити захист-невідоме
  (функція (предмет відсутні-докази порада)
    (створити-захист-висновок
      (як-є unknown)
      (як-є unresolved)
      предмет
      (як-є not-observed)
      (як-є insufficient-evidence)
      відсутні-докази
      (як-є decision-not-earned)
      порада
      (як-є ()))))

; Оракул дає очікувану семантичну відповідь, спостерігач — фактичну.
; Модуль пояснює відношення між ними, не замінюючи жодного джерела.
; Oracle дає очікувану семантику, observer — фактичний стан, Guard пояснює
; їхнє співвідношення, не підміняючи жодне джерело.

; Структурний закон Guard належить двійковому SENS, не Rust і не W8.
; D3:010 ATOM, 101 EQ лише для атомів, 100 CAR, 011 CDR, 110 COND.
; Повертає рівно D1 PredicateBit; невідомий механізм не допускається.
(визначити сторожа--рівні?
  (функція (ліве праве)
    (за-умовою
      ((атом? ліве)
       (за-умовою
         ((атом? праве) (тотожне? ліве праве))
         (так ні)))
      ((атом? праве) ні)
      ((сторожа--рівні? (перше ліве) (перше праве))
       (сторожа--рівні? (решта ліве) (решта праве)))
      (так ні))))

(визначити захист-порівняти
  (функція (предмет очікуване спостережене докази)
    (за-умовою
      ((сторожа--рівні? очікуване спостережене)
       (створити-захист-висновок
         (як-є allow) (як-є confirmed) предмет спостережене очікуване
         (як-є ()) (як-є invariant-preserved) (як-є no-action) докази))
      (так
       (створити-захист-висновок
         (як-є warn) (як-є confirmed) предмет спостережене очікуване
         (список (як-є expected) очікуване (як-є observed) спостережене)
         (як-є contract-drift)
         (як-є reconcile-observation-with-contract)
         докази)))))

; Синхронізацію підтверджує фактичне завершення й записані розбіжності.
; Загальне заморожування комітів або адміністративний HOLD не потрібні.
; Синхронізація: спочатку фактичне виконання, потім запис змін.
; Незалежні коміти не заморожуються; невідоме повертає локальне WARN.
(визначити захист-синхронізувати-вікно
  (функція (стан-коміту стан-синхронізації стан-відхилень докази)
    (за-умовою
      ((хибне? (тотожне? стан-синхронізації (як-є completed)))
       (створити-захист-висновок
         (як-є warn) (як-є unresolved) (як-є ecosystem-sync)
         стан-синхронізації (як-є synchronization-completed)
         (список (як-є expected) (як-є completed) (як-є observed) стан-синхронізації)
         (як-є drift-cannot-yet-be-classified)
         (як-є complete-sync-and-preserve-logs)
         докази))
      ((хибне? (тотожне? стан-відхилень (як-є recorded)))
       (створити-захист-висновок
         (як-є warn) (як-є unresolved) (як-є ecosystem-sync)
         стан-відхилень (як-є drift-recorded)
         (список (як-є expected) (як-є recorded) (як-є observed) стан-відхилень)
         (як-є synchronization-result-has-no-drift-record)
         (як-є record-drift-and-continue)
         докази))
      (так
       (створити-захист-висновок
         (як-є allow) (як-є confirmed) (як-є ecosystem-sync)
         (список стан-коміту стан-синхронізації стан-відхилень)
         (як-є sync-record-and-continue)
         (як-є ())
         (як-є synchronization-boundary-observed)
         (як-є continue-independent-commits)
         докази)))))

; Reference records are ordinary data. The evolving ecosystem directory lives
; in knowledge/guard-reference.lisp; these accessors remain generic.
; Довідкові записи — звичайні дані. Змінний каталог екосистеми лежить у
; knowledge/guard-reference.lisp, а ці функції лишаються загальними.
; Запис поля шукається структурно в Lisp, без невизначеного host/lookup маршруту.
; Вихід — знайдена пара (ключ значення) або порожній список.
(визначити захист-знайти-запис
  (функція (ключ записи)
    (за-умовою
      ((порожній? записи) (як-є ()))
      (так
        ((функція (запис)
           (за-умовою
             ((атом? запис)
              (захист-знайти-запис ключ (решта записи)))
             ((сторожа--рівні? ключ (перше запис)) запис)
             (так (захист-знайти-запис ключ (решта записи)))))
         (перше записи))))))

(визначити захист-еталон-поле
  (функція (поле посилання)
    ((функція (запис)
       (за-умовою
         ((порожній? запис) (як-є ()))
         (так (друге запис))))
     (захист-знайти-запис поле (решта посилання)))))

; --- Власницька межа дозволених мов, 2026-10-16 ---
; Семантику визначає Lisp СЕНС, Zig обслуговує коди доменної драбини,
; а Rust споживає їх. Невідома мова або недозволена роль відхиляється.
(визначити захист-мова-дозволена?
  (функція (мова роль)
    (за-умовою
      ((тотожне? мова (як-є sens))
       (за-умовою ((тотожне? роль (як-є semantics)) так) (так ні)))
      ((тотожне? мова (як-є lisp))
       (за-умовою ((тотожне? роль (як-є semantics)) так) (так ні)))
      ((тотожне? мова (як-є zig))
       (за-умовою ((тотожне? роль (як-є domain-ladder)) так) (так ні)))
      ((тотожне? мова (як-є rust))
       (за-умовою ((тотожне? роль (як-є domain-consumer)) так) (так ні)))
      (так ні))))

(визначити захист-мовне-рішення
  (функція (мова роль)
    (за-умовою ((захист-мова-дозволена? мова роль) (як-є allow))
         (так (як-є reject)))))

; D9:000110011 GUARD-SYNC-WINDOW — українська поверхня SENS.
; Чинний закон guard-sync-window залишається джерелом семантики;
; це не запасний механізм хоста й не прямий машинний виклик D9.
(визначити guard-sync-window захист-синхронізувати-вікно)

; Історичні викличні поверхні Guard — ті самі closure, без дублювання.
(визначити guard-decision? захист-рішення?)
(визначити guard-evidence-status? захист-доказ-стан?)
(визначити guard-unknown-routes захист-невідоме-маршрути)
(визначити make-guard-finding створити-захист-висновок)

; Первинні українські реалізації Д9 оголошені вище, без повторних DEFINE.

; Українське ім'я перевірки мовної ролі — єдине первинне визначення.

; Історичні зовнішні назви прив'язані до тих самих українських функцій.
; Ці сумісні зв'язування не вводять нових законів і не дублюють виконання.
(визначити guard-unknown захист-невідоме)
(визначити guard-compare захист-порівняти)
(визначити guard-reference-field захист-еталон-поле)

; Сумісна назва посилається на вже визначену українську функцію.
(визначити guard-language-decision захист-мовне-рішення)
