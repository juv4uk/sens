; Розбити скінченний правильний список парної довжини на суміжні пари.
; Узагальнення Д3 і Д4 для довільної парної довжини, а не новий ресідент.
; Закон: розгрупувати(згрупувати(хс)) = хс; обидва порожні базиси.
; Джерело виконується СЕНС, точний фізичний носій карбує тільки Зіг і Т5М.

(визначити згрупувати-суміжні-пари
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (список (перше елементи) (друге елементи))
         (згрупувати-суміжні-пари (решта-решти елементи)))))))

(визначити розгрупувати-суміжні-пари
  (функція (пари)
    (за-умовою
      ((порожній? пари) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (перше (перше пари))
         (сполучити
           (друге (перше пари))
           (розгрупувати-суміжні-пари (решта пари))))))))

(визначити початкова-шістка
  (список (як-є атом?) (як-є сполучити) (як-є решта) (як-є тотожне?) (як-є порожній?) (як-є хибне?)))
(визначити згруповані-пари
  (згрупувати-суміжні-пари початкова-шістка))
(визначити відновлена-шістка
  (розгрупувати-суміжні-пари згруповані-пари))

; Шість відповідних елементів, три пари (ще шість позицій),
; обидві порожні основи, негативна перестановка. Фініш = Д1:1.
(за-умовою
  ((тотожне? (перше відновлена-шістка) (як-є атом?))
   (за-умовою
     ((тотожне? (перше (решта відновлена-шістка)) (як-є сполучити))
      (за-умовою
        ((тотожне? (перше (решта (решта відновлена-шістка))) (як-є решта))
         (за-умовою
           ((тотожне? (перше (решта (решта (решта відновлена-шістка)))) (як-є тотожне?))
            (за-умовою
              ((тотожне? (перше (решта (решта (решта (решта відновлена-шістка))))) (як-є порожній?))
               (за-умовою
                 ((тотожне? (перше (решта (решта (решта (решта (решта відновлена-шістка)))))) (як-є хибне?))
                  (за-умовою
                    ((тотожне? (перше (перше згруповані-пари)) (як-є атом?))
                     (за-умовою
                       ((тотожне? (перше (решта (перше згруповані-пари))) (як-є сполучити))
                        (за-умовою
                          ((тотожне? (перше (перше (решта згруповані-пари))) (як-є решта))
                           (за-умовою
                             ((тотожне? (перше (решта (перше (решта згруповані-пари)))) (як-є тотожне?))
                              (за-умовою
                                ((тотожне? (перше (перше (решта (решта згруповані-пари)))) (як-є порожній?))
                                 (за-умовою
                                   ((тотожне? (перше (решта (перше (решта (решта згруповані-пари))))) (як-є хибне?))
                                    (за-умовою
                                      ((порожній? (згрупувати-суміжні-пари (як-є ())))
                                       (за-умовою
                                         ((порожній? (розгрупувати-суміжні-пари (як-є ())))
                                          (за-умовою
                                            ((хибне? (тотожне? (перше відновлена-шістка) (як-є сполучити)))
                                             (атом? (як-є ())))
                                            ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                                         ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                                      ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                                   ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                                ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                             ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                          ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                       ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                    ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
                 ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
              ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
           ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
        ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
     ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
  ((атом? (як-є ())) (хибне? (атом? (як-є ())))))
