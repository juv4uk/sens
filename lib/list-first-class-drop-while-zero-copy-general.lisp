; СЕНС: відкинути початковий відрізок, доки першокласний предикат Д1 істинний.
; Вхід — правильний скінченний список; предикат — справжня функція домену.
; Один прохід, нуль СПОЛУЧИТИ: повертається вихідний суфікс без копіювання.
; Ніяких текстових диспетчерів Д7 або зовнішньої семантики.

(визначити відкинути-поки-доменний-предикат
  (функція (умова залишок)
    (за-умовою
      ((атом? залишок) (як-є ()))
      ((умова (перше залишок))
        (відкинути-поки-доменний-предикат умова (решта залишок)))
      (так залишок))))

; Порівнюємо дерева в самому СЕНС: ТОТОЖНЕ? ніколи не одержує пару.
(визначити дерева-після-предиката-рівні?
  (функція (ліве праве)
    (за-умовою
      ((атом? ліве)
        (за-умовою
          ((атом? праве) (тотожне? ліве праве))
          (так ні)))
      ((атом? праве) ні)
      ((дерева-після-предиката-рівні? (перше ліве) (перше праве))
        (дерева-після-предиката-рівні? (решта ліве) (решта праве)))
      (так ні))))

(визначити довести-пропуск-за-предикатом
  (функція (функція-ознака вхід очікуване)
    (за-умовою
      ((дерева-після-предиката-рівні?
         (відкинути-поки-доменний-предикат функція-ознака вхід)
         очікуване)
       так)
      (так (перше (як-є ()))))))

; Порожній список і всі атоми -> порожній вихід.
(довести-пропуск-за-предикатом атом? (як-є ()) (як-є ()))
(довести-пропуск-за-предикатом атом?
  (список (як-є атом?) (як-є решта) (як-є сполучити))
  (як-є ()))

; Перша складена пара зупиняє пропуск: повертаємо ВСЮ вихідну структуру.
(довести-пропуск-за-предикатом атом?
  (список (список (як-є атом?)) (як-є решта))
  (список (список (як-є атом?)) (як-є решта)))

; Два атоми перед складеною парою: ніяких нових пар у результаті.
(довести-пропуск-за-предикатом атом?
  (список (як-є атом?) (як-є решта)
          (список (як-є сполучити)) (як-є функція))
  (список (список (як-є сполучити)) (як-є функція)))

; Порожній вкладений список також є атомом Д3 і пропускається.
(довести-пропуск-за-предикатом атом?
  (список (як-є ()) (список (як-є решта)) (як-є функція))
  (список (список (як-є решта)) (як-є функція)))

; Інший першокласний доменний предикат: ПОРОЖНІЙ? відкидає лише ().
(довести-пропуск-за-предикатом порожній?
  (список (як-є ()) (як-є ()) (список (як-є атом?)))
  (список (список (як-є атом?))))

; Негатив: функція НЕ повертає останній атом замість першої пари.
(за-умовою
  ((хибне?
     (дерева-після-предиката-рівні?
       (відкинути-поки-доменний-предикат
         атом? (список (як-є атом?) (список (як-є решта))
                      (як-є сполучити)))
       (список (як-є сполучити))))
   так)
  (так (перше (як-є ()))))

; Справжній Д1-висновок виконуваного файла.
(атом? (як-є ()))
