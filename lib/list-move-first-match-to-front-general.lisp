(визначити перевірити-всі-перші-перенесення?
 (функція (приклади)
  (за-умовою
   ((порожній? приклади) так)
   ((рівні-атомні-списки-після-перенесення?
     (перенести-перший-збіг-на-початок
       (перше (перше приклади))
       (друге (перше приклади)))
     (третє (перше приклади)))
    (перевірити-всі-перші-перенесення? (решта приклади)))
   (так ні))))

; Незалежні негативні закони: перенесення не є видаленням,
; і воно не змінює відносний порядок інших атомів.
(визначити негативні-закони-першого-перенесення?
 (функція ()
  (за-умовою
   ((хибне? (рівні-атомні-списки-після-перенесення?
      (перенести-перший-збіг-на-початок
        (список (як-є решта) (як-є атом?) (як-є сполучити))
        (як-є атом?))
      (список (як-є атом?) (як-є сполучити))))
    (за-умовою
     ((хибне? (рівні-атомні-списки-після-перенесення?
       (перенести-перший-збіг-на-початок
        (список (як-є решта) (як-є атом?) (як-є сполучити))
        (як-є атом?))
       (список (як-є атом?) (як-є сполучити) (як-є решта))))
      так)
     (так ні)))
   (так ні))))

