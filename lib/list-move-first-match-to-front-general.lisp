; Стабільно перенести перше входження атома в початок правильного списку.
; Інші атоми зберігають відносний порядок; відсутній ключ не змінює список.
; Закони та виконання - власні Д1 і Д3 і Д5 СЕНС. Зіґ лише переносить біти.

(визначити підняти-перший-збіг-із-хвоста
 (функція (голова хвіст шукане)
  (за-умовою
   ((тотожне? (перше хвіст) шукане)
    (сполучити (перше хвіст)
      (сполучити голова (решта хвіст))))
   (так (сполучити голова хвіст)))))

(визначити перенести-перший-збіг-на-початок
 (функція (елементи шукане)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((тотожне? (перше елементи) шукане) елементи)
   ((порожній? (решта елементи)) елементи)
   (так (підняти-перший-збіг-із-хвоста
          (перше елементи)
          (перенести-перший-збіг-на-початок (решта елементи) шукане)
          шукане)))))

(визначити рівні-атомні-списки-після-перенесення?
 (функція (лівий правий)
  (за-умовою
   ((порожній? лівий) (порожній? правий))
   ((порожній? правий) ні)
   ((тотожне? (перше лівий) (перше правий))
    (рівні-атомні-списки-після-перенесення?
      (решта лівий) (решта правий)))
   (так ні))))

