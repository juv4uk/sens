; Незмінна мапа на основі списку пар.
; Ключі мапи порівнюються структурним законом D8 «однакові?».
; Вставлення замінює наявний ключ або додає запис до незмінної структури.
; Всі визначення використовують повну українську проєкцію.
; Внутрішні механізми та зовнішні сумісні назви не створюють нових законів.
; Історичні латинські псевдоніми залишаються у сумісному четвертому ядрі.
; Домени машинних функцій і їхні механізми залишаються незалежними.

(визначити мапа-порожній (функція () (як-є ())))

; Ключі мапи можуть бути D7-ланцюгами після фізичного READ.
; Структурна рівність працює по парі-рівень за парою-рівнем:
; D3 тотожне? застосовується лише тоді, коли ОБИДВА значення атомні.
(визначити внутрішня-мапа-ключі-структурно-однакові?
  (функція (ліве праве)
    (за-умовою
      ((атом? ліве)
       (за-умовою
         ((атом? праве)
          (за-умовою
            ((порожній? ліве) (порожній? праве))
            ((порожній? праве) ні)
            (так (тотожне? ліве праве))))
         (так ні)))
      ((атом? праве) ні)
      ((внутрішня-мапа-ключі-структурно-однакові?
         (перше ліве) (перше праве))
       (внутрішня-мапа-ключі-структурно-однакові?
         (решта ліве) (решта праве)))
      (так ні))))

; D9: правильний хребет мапи перевіряємо навіть після раннього збігу.
; D1:ні не є кінцевим D3:(); при помилковому атомі спрацьовує D3 Type.
(визначити внутрішня-мапа-перевірити-хвіст
  (функція (записи)
    (за-умовою
      ((порожній? записи) так)
      ((атом? записи) (перше записи))
      ((атом? (перше записи)) (перше (перше записи)))
      (так (внутрішня-мапа-перевірити-хвіст (решта записи))))))

(визначити мапа-вставити
  (функція (ключ значення записи)
    (за-умовою
      ((порожній? записи)
       (список (сполучити ключ значення)))
      ((внутрішня-мапа-ключі-структурно-однакові?
         ключ (перше (перше записи)))
       (за-умовою
         ((внутрішня-мапа-перевірити-хвіст (решта записи))
          (сполучити (сполучити ключ значення) (решта записи)))))
      ((атом? (як-є ()))
       (сполучити (перше записи)
            (внутрішня-мапа-вставити ключ значення (решта записи)))))))

(визначити мапа-отримати
  (функція (ключ записи)
    (за-умовою
      ((порожній? записи) (як-є ()))
      ((внутрішня-мапа-ключі-структурно-однакові?
         ключ (перше (перше записи)))
       (за-умовою
         ((внутрішня-мапа-перевірити-хвіст (решта записи))
          (список (решта (перше записи))))))
      ((атом? (як-є ()))
       (мапа-отримати ключ (решта записи))))))

(визначити мапа-містить?
  (функція (ключ записи)
    (хибне? (атом? (мапа-отримати ключ записи)))))

(визначити мапа-список
  (функція (записи) записи))

(визначити внутрішня-мапа-вставити мапа-вставити)
(визначити внутрішня-мапа-отримати мапа-отримати)
(визначити внутрішня-мапа-містить мапа-містить?)
(визначити внутрішня-мапа-список мапа-список)

(визначити внутрішня-мапа-порожній мапа-порожній)

; Кінцевий виклик-свідок: файл виконується при завантаженні, а не лише визначає.
(мапа-містить? (як-є ключ) (мапа-вставити (як-є ключ) (як-є значення) (мапа-порожній)))
