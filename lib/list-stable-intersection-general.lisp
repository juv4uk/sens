; Д3–Д5: стабільний перетин скінченних списків атомів із збереженням повторів.
; Точні доменні атоми й порядок керують семантикою; D7 — тільки людський запис.
; Список праворуч задає належність; повтори праворуч НЕ множать вихідні атоми.
; Ліва послідовність зберігає порядок і кратність кожного наявного атома.
; SENS виконує усі закони самостійно, Zig лише кодує обернений T5M носій.

(визначити належить-атом?
  (функція (елемент набір)
    (за-умовою
      ((атом? набір) (хибне? (атом? (як-є ()))))
      ((тотожне? елемент (перше набір)) (атом? (як-є ())))
      ((атом? (як-є ())) (належить-атом? елемент (решта набір))))))

(визначити сталий-перетин-атомів
  (функція (ліві праві)
    (за-умовою
      ((атом? ліві) (як-є ()))
      ; За порожнього правого набору не обходити лівий список.
      ((атом? праві) (як-є ()))
      ((належить-атом? (перше ліві) праві)
       (сполучити (перше ліві)
         (сталий-перетин-атомів (решта ліві) праві)))
      ((атом? (як-є ()))
       (сталий-перетин-атомів (решта ліві) праві)))))

(визначити ліві-атоми (список (як-є атом?) (як-є решта) (як-є атом?) (як-є сполучити) (як-є тотожне?) (як-є решта) (як-є хибне?)))
(визначити праві-атоми (список (як-є решта) (як-є атом?) (як-є хибне?)))
(визначити перетин-прикладу (сталий-перетин-атомів ліві-атоми праві-атоми))
(визначити перетин-усіх (сталий-перетин-атомів ліві-атоми ліві-атоми))
(визначити перетин-жодного
  (сталий-перетин-атомів ліві-атоми (список (як-є як-є) (як-є за-умовою))))
(визначити перетин-повторного-правого
  (сталий-перетин-атомів ліві-атоми (список (як-є решта) (як-є решта) (як-є атом?))))

