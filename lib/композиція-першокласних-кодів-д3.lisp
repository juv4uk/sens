; СЕНС: композиція двох першокласних точних доменних функцій.
; Коди Д3 є значеннями точного домену, а не байтовими літералами.
; Д7 потрібен тільки для клавіатурної української проєкції імен.
; Реальна семантика — виклик функцій у власному обчислювачі СЕНС.
(визначити скласти-два-коди
  (функція (зовнішня внутрішня вхід-список)
    (зовнішня (внутрішня вхід-список))))

; ПЕРШЕ після РЕШТА вибирає другий атом без копіювання списку.
(за-умовою
  ((тотожне?
     (скласти-два-коди перше решта
       (список (як-є атом?) (як-є решта) (як-є сполучити)))
     (як-є решта))
   так)
  (так (перше (як-є ()))))

; ПЕРШЕ після двох РЕШТА вибирає третій атом.
(за-умовою
  ((тотожне?
     (перше
       (скласти-два-коди решта решта
         (список (як-є атом?) (як-є решта) (як-є сполучити))))
     (як-є сполучити))
   так)
  (так (перше (як-є ()))))

; Негативний закон: друга позиція не повинна дорівнювати першій.
(за-умовою
  ((хибне?
     (тотожне?
       (скласти-два-коди перше решта
         (список (як-є атом?) (як-є решта) (як-є сполучити)))
       (як-є атом?)))
   так)
  (так (перше (як-є ()))))

; Кінцеве значення — справжня однобітна істина Д1.
(атом? (як-є ()))
