; Д3 і Д4: декартів добуток двох скінченних правильних списків точних атомів.
; Порядок: для кожного елемента ліворуч проходимо всі елементи праворуч.
; Пари є двоелементними списками; порожній аргумент дає порожній.
; Реальна семантика - СЕНС, фізичне кодування - Зіг і Т5М, текстова поверхня - Д7.
; Конкурс: проміжний перелік пар і його копія усунуті; лише один пари на вузол результату.

(визначити побудувати-пари-з-хвостом
  (функція (ліве праві готовий)
    (за-умовою
      ((атом? праві) готовий)
      (так
       (сполучити
         (список ліве (перше праві))
         (побудувати-пари-з-хвостом ліве (решта праві) готовий))))))

(визначити добуток-скінченних-списків
  (функція (ліві праві)
    (за-умовою
      ((атом? ліві) (як-є ()))
      ((атом? праві) (як-є ()))
      (так
       (побудувати-пари-з-хвостом
         (перше ліві) праві
         (добуток-скінченних-списків (решта ліві) праві))))))

(визначити декартовий-результат (добуток-скінченних-списків (список (як-є атом?) (як-є решта)) (список (як-є сполучити) (як-є тотожне?) (як-є порожній?))))
(визначити одноелементний-добуток (добуток-скінченних-списків (список (як-є за-умовою)) (список (як-є хибне?))))

