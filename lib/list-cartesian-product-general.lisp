; Д3/Д4: декартів добуток двох скінченних правильних списків точних атомів.
; Порядок: для кожного елемента ліворуч проходимо всі елементи праворуч.
; Пари є двоелементними списками; порожній аргумент дає NIL.
; Реальна семантика — SENS, фізичне кодування — Zig/T5M, текстова поверхня — D7.

(визначити приєднати-перелік
  (функція (початок кінець)
    (за-умовою
      ((атом? початок) кінець)
      ((атом? (як-є ()))
       (сполучити (перше початок)
         (приєднати-перелік (решта початок) кінець))))))

(визначити пари-для-атома
  (функція (ліве праві)
    (за-умовою
      ((атом? праві) (як-є ()))
      ((атом? (як-є ()))
       (сполучити (список ліве (перше праві))
         (пари-для-атома ліве (решта праві)))))))

(визначити добуток-скінченних-списків
  (функція (ліві праві)
    (за-умовою
      ((атом? ліві) (як-є ()))
      ((атом? праві) (як-є ()))
      ((атом? (як-є ()))
       (приєднати-перелік
         (пари-для-атома (перше ліві) праві)
         (добуток-скінченних-списків (решта ліві) праві))))))

(визначити декартовий-результат (добуток-скінченних-списків (список (як-є атом?) (як-є решта)) (список (як-є сполучити) (як-є тотожне?) (як-є порожній?))))
(визначити одноелементний-добуток (добуток-скінченних-списків (список (як-є за-умовою)) (список (як-є хибне?))))

