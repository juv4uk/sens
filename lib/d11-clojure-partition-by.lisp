; Д11: Кложур розбити-за - суміжні серії за ключем.
; Історичний закон: гттпс: і  і кложур.гітгуб.іо і кложур і брансг-мастер і кложур.соре-апі.гтмл
; СЕНС-профіль: правильні скінченні списки, чисте обчислення ключа,
; явний результат-список (не обіцяємо Кложур лазу сек або трансдусер).
; Механізм - чинні СЕНС Д1 і Д3 і Д5 + бібліотечний СРФІ-1 СПАН.
; Ключ першого елемента серії фіксується перед обходом, серія зупиняється
; на першому іншому ключі; зміна ключа АдаєБдаєА дає три окремі групи.
; Це не Д10 ПАРТІТІОН-ІФ і не фіксовані пари; нового код операції немає.

; Проміжна пара СПАН передається як значення до іменованої Д5 функції.
; Анонімна функція у викличній голові не потрібна: SENS лишається обчислювачем.
(визначити приєднати-суміжний-розділ
  (функція (наступна-дія ключ голова частини)
    (сполучити
      (сполучити голова (перше частини))
      (наступна-дія ключ (решта частини)))))

(визначити розділити-суміжні-за-ключем
  (функція (наступна-дія ключ елементи перший-ключ)
    (приєднати-суміжний-розділ
      наступна-дія ключ (перше елементи)
      (розділити-поки-умова
        (функція (поточний)
          (однакові? (ключ поточний) перший-ключ))
        (решта елементи)))))

(визначити групувати-суміжні-за-ключем
  (функція (ключ елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      (так
        (розділити-суміжні-за-ключем
          групувати-суміжні-за-ключем
          ключ елементи (ключ (перше елементи)))))))

; Кложур дедупе (1.7): тільки суміжні рівні структури.
; Відмінність від Д8 РЕМОВЕ-ДУПЛІСАТЕС і глобальної унікалізації:
; АдаєВдаєА лишає А на обох кінцях. СРФІ-1 СПАН відтинає поточну серію.
; Чинне джерело - скінченний еагер СЕНС, а не лазу сек і трансдусер.
; Рекурсивну функцію передаємо як першокласне значення,
; а розділ (префікс . решта) обчислюється лише один раз.
(визначити зберегти-елемент-після-серії
  (функція (наступна-дія голова частини)
    (сполучити голова (наступна-дія (решта частини)))))

(визначити прибрати-суміжні-повтори
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      (так
        (зберегти-елемент-після-серії
          прибрати-суміжні-повтори
          (перше елементи)
          (розділити-поки-умова
            (функція (наступний)
              (однакові? наступний (перше елементи)))
            (решта елементи)))))))
