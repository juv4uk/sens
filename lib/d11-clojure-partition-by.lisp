; D11: Clojure partition-by — суміжні серії за ключем.
; Історичний закон: https://clojure.github.io/clojure/branch-master/clojure.core-api.html
; SENS-профіль: правильні скінченні списки, чисте обчислення ключа,
; явний результат-список (не обіцяємо Clojure lazy seq або transducer).
; Механізм — чинні SENS D1/D3/D5 + бібліотечний SRFI-1 SPAN.
; Ключ першого елемента серії фіксується перед обходом, серія зупиняється
; на першому іншому ключі; зміна ключа А→Б→А дає три окремі групи.
; Це не D10 PARTITION-IF і не фіксовані пари; нового opcode немає.

(визначити групувати-суміжні-за-ключем
  (функція (ключ елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (як-є ()))
       ((функція (перший-ключ)
          ((функція (частини)
             (сполучити
               (сполучити (перше елементи) (перше частини))
               (групувати-суміжні-за-ключем ключ (решта частини))))
           (розділити-поки-умова
             (функція (поточний)
               (однакові? (ключ поточний) перший-ключ))
             (решта елементи))))
        (ключ (перше елементи)))))))

; Clojure dedupe (1.7): тільки суміжні рівні структури.
; Відмінність від D8 REMOVE-DUPLICATES і глобальної унікалізації:
; A→B→A лишає A на обох кінцях. SRFI-1 SPAN відтинає поточну серію.
; Чинне джерело — скінченний eager SENS, а не lazy seq/transducer.
(визначити прибрати-суміжні-повтори
  (функція (елементи)
    (за-умовою
      ((атом? елементи) (як-є ()))
      ((атом? (як-є ()))
       (сполучити
         (перше елементи)
         (прибрати-суміжні-повтори
           (решта
             (розділити-поки-умова
               (функція (наступний)
                 (однакові? наступний (перше елементи)))
               (решта елементи)))))))))
