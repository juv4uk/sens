; СЕНС: без копіювання повернути хвіст після четвертого атомного елемента.
; У вкладених парах атоми не рахуються, () рахується атомним елементом.
; Чотири стани, лінійний прохід, жодних числових лічильників або сід8.
; Д3 захищає кожний ПЕРШЕ і РЕШТА; семантику виконує СЕНС, не хост.

(визначити хвіст-після-одного-для-четвертого
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи)) (решта елементи))
   (так (хвіст-після-одного-для-четвертого (решта елементи))))))

(визначити хвіст-після-двох-для-четвертого
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-одного-для-четвертого (решта елементи)))
   (так (хвіст-після-двох-для-четвертого (решта елементи))))))

(визначити хвіст-після-трьох-для-четвертого
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-двох-для-четвертого (решта елементи)))
   (так (хвіст-після-трьох-для-четвертого (решта елементи))))))

(визначити хвіст-після-четвертого-атома
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((атом? (перше елементи))
    (хвіст-після-трьох-для-четвертого (решта елементи)))
   (так (хвіст-після-четвертого-атома (решта елементи))))))

; Нуль, один, три атоми та неправильний хвіст: немає четвертого.
(за-умовою
 ((порожній? (хвіст-після-четвертого-атома (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-четвертого-атома (як-є атом?))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній?
   (хвіст-після-четвертого-атома
    (сполучити (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній?
   (хвіст-після-четвертого-атома
    (список (як-є атом?) (як-є решта) (як-є сполучити)))) так)
 (так (перше (як-є ()))))

; Четвертий атом зникає, п'ятий і шостий зберігаються без копіювання.
(визначити четвертий-хвіст
 (хвіст-після-четвертого-атома
  (список (як-є атом?) (як-є решта) (як-є сполучити)
          (як-є функція) (як-є визначити) (як-є за-умовою))))
(за-умовою
 ((тотожне? (перше четвертий-хвіст) (як-є визначити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (друге четвертий-хвіст) (як-є за-умовою)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта (решта четвертий-хвіст))) так)
 (так (перше (як-є ()))))

; Негативний закон: перший атом не повинен повертатися у хвості.
(за-умовою
 ((хибне? (тотожне? (перше четвертий-хвіст) (як-є атом?))) так)
 (так (перше (як-є ()))))

; Вкладені пари не враховуються як атомні елементи.
(визначити четвертий-вкладений
 (хвіст-після-четвертого-атома
  (список (список (як-є атом?)) (як-є решта)
          (список (як-є визначити)) (як-є сполучити)
          (як-є функція) (як-є за-умовою) (як-є тотожне?))))
(за-умовою
 ((тотожне? (перше четвертий-вкладений) (як-є тотожне?)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта четвертий-вкладений)) так)
 (так (перше (як-є ()))))

; Остання форма повертає точну Д1-істину після всіх перевірок.
(атом? (як-є ()))
