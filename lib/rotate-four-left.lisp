; Точний зсув чотирьох елементів: a b c d -> b c d a.
; Лише ратифіковані Д3/Д4 операції, без текстових чи хостових кодів.
(визначити зсунути-четвірку-ліворуч
  (функція (елементи)
    (список
      (друге елементи)
      (перше (решта-решти елементи))
      (друге (решта-решти елементи))
      (перше елементи))))
(визначити четвірка-після-лівого-зсуву
  (зсунути-четвірку-ліворуч
    (список (як-є атом?) (як-є тотожне?) (як-є решта) (як-є сполучити))))
; П'ять позитивних D1 законів, включно з подвійним зсувом, і негатив проти незміненого порядку.
(визначити результат четвірка-після-лівого-зсуву)
(за-умовою
  ((тотожне? (перше результат) (як-є тотожне?))
   (за-умовою
     ((тотожне? (друге результат) (як-є решта))
      (за-умовою
        ((тотожне? (перше (решта-решти результат)) (як-є сполучити))
         (за-умовою
           ((тотожне? (друге (решта-решти результат)) (як-є атом?))
            (за-умовою
              ((тотожне? (перше (зсунути-четвірку-ліворуч результат)) (як-є решта))
               (хибне? (тотожне? (перше результат) (як-є атом?))))
              ((атом? (як-є ())) (перше (як-є ())))))
           ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
     ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
