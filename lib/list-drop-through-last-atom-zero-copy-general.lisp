; СЕНС Д3 і Д5: знайти незмінений хвіст після останнього атомного елемента.
; Один прохід, лінійний, нуль нових пар; результат є хвостом вихідного списку.
; Якщо атомів немає, повертається весь вихідний список; порожній теж атом.
; Джерело - українська проєкція, фізичні слова кодує СЕНС-Зіг-Т5М.

(визначити хвіст-після-останнього-атома-стан
 (функція (елементи останній-хвіст)
  (за-умовою
   ((атом? елементи) останній-хвіст)
   ((атом? (перше елементи))
    (хвіст-після-останнього-атома-стан
     (решта елементи) (решта елементи)))
   (так
    (хвіст-після-останнього-атома-стан
     (решта елементи) останній-хвіст)))))

(визначити хвіст-після-останнього-атома
 (функція (елементи)
  (хвіст-після-останнього-атома-стан елементи елементи)))

; Структуру порівнює сам СЕНС, не текстовий тест пітонів чи джейсонів.
(визначити рівні-дерева-після-останнього-атома?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((рівні-дерева-після-останнього-атома?
      (перше ліве) (перше праве))
    (рівні-дерева-після-останнього-атома?
      (решта ліве) (решта праве)))
   (так ні))))

; Кожен хибний закон реально падає у СЕНС через перше порожнього списку.
(визначити довести-хвіст-після-останнього-атома
 (функція (вхід очікуване)
  (за-умовою
   ((рівні-дерева-після-останнього-атома?
     (хвіст-після-останнього-атома вхід) очікуване)
    так)
   (так (перше (як-є ()))))))

; Неправильний хвіст не викликає ПЕРШЕ від атома.
; Без нового пари: самотній атом зберігає власний хвіст,
; атом у голові відкритої пари лишає її решта, а складена голова
; без атомного елемента зберігає початкову структуру.
(довести-хвіст-після-останнього-атома
 (як-є атом?) (як-є атом?))
(довести-хвіст-після-останнього-атома
 (сполучити (як-є атом?) (як-є решта)) (як-є решта))
(довести-хвіст-після-останнього-атома
 (сполучити (список (як-є атом?)) (як-є решта))
 (сполучити (список (як-є атом?)) (як-є решта)))

; Порожній, без атомів, один атом і останній атом у кінці.
(довести-хвіст-після-останнього-атома (як-є ()) (як-є ()))
(довести-хвіст-після-останнього-атома
 (список (список (як-є атом?)))
 (список (список (як-є атом?))))
(довести-хвіст-після-останнього-атома
 (список (як-є атом?)) (як-є ()))
(довести-хвіст-після-останнього-атома
 (список (як-є атом?) (як-є решта)) (як-є ()))

; Після останнього атома може залишатися кілька вкладених пар.
(довести-хвіст-після-останнього-атома
 (список (як-є атом?) (список (як-є решта)))
 (список (список (як-є решта))))
(довести-хвіст-після-останнього-атома
 (список (як-є атом?) (список (як-є решта))
         (як-є сполучити) (список (як-є тотожне?)))
 (список (список (як-є тотожне?))))
(довести-хвіст-після-останнього-атома
 (список (список (як-є атом?)) (як-є ())
         (список (як-є решта)))
 (список (список (як-є решта))))

; За відсутності атомів повертається початковий хвіст без копії.
(довести-хвіст-після-останнього-атома
 (список (список (як-є атом?)) (список (як-є решта)))
 (список (список (як-є атом?)) (список (як-є решта))))

; Порожній як елемент - атом, а вкладений порожній - складений елемент.
(довести-хвіст-після-останнього-атома
 (список (як-є атом?) (як-є ()) (як-є атом?))
 (як-є ()))
(довести-хвіст-після-останнього-атома
 (список (як-є ()) (список (як-є атом?))
         (як-є решта) (список (як-є сполучити)))
 (список (список (як-є сполучити))))

; Негатив: помилкове збереження складеного елемента перед останнім атомом.
(за-умовою
 ((хибне? (рівні-дерева-після-останнього-атома?
   (хвіст-після-останнього-атома
    (список (як-є атом?) (список (як-є решта))
            (як-є сполучити)))
   (список (список (як-є решта))))) так)
 (так (перше (як-є ()))))

(атом? (як-є ()))
