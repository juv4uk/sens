; СЕНС: префікс правильного списку до останнього складеного елемента включно.
; Якщо вкладених пар нема, результат порожній. Заключні атоми відкидаються.
; Один прохід Д3-Д5, без хостової семантики й без кодування вісімками.
; Не сплющувати вкладений елемент: він залишається незмінним значенням.
(визначити доповнити-префікс-якщо-є-пара
 (функція (елемент хвіст)
  (за-умовою
   ((порожній? хвіст) (як-є ()))
   (так (сполучити елемент хвіст)))))

(визначити префікс-до-останньої-пари
 (функція (елементи)
  (за-умовою
   ((атом? елементи) (як-є ()))
   ((хибне? (атом? (перше елементи)))
    (сполучити
     (перше елементи)
     (префікс-до-останньої-пари (решта елементи))))
   (так
    (доповнити-префікс-якщо-є-пара
     (перше елементи)
     (префікс-до-останньої-пари (решта елементи)))))))

; Граничні й негативні свідки проходять сам СЕНС. Помилка закону
; примусово викликає ПЕРШЕ від порожньої структури.
(за-умовою
 ((порожній? (префікс-до-останньої-пари (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (префікс-до-останньої-пари
               (список (як-є атом?) (як-є решта)))) так)
 (так (перше (як-є ()))))
(визначити проба-префікса
 (префікс-до-останньої-пари
  (список (як-є атом?) (як-є решта)
          (список (як-є сполучити) (як-є функція))
          (як-є визначити) (як-є за-умовою))))
(за-умовою
 ((тотожне? (перше проба-префікса) (як-є атом?)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (друге проба-префікса) (як-є решта)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (атом? (третє проба-префікса))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (перше (третє проба-префікса)) (як-є сполучити)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта (решта (решта проба-префікса)))) так)
 (так (перше (як-є ()))))

; Перша пара теж є останньою: атоми після неї не залишаються.
(визначити проба-однієї-пари
 (префікс-до-останньої-пари
  (список (список (як-є атом?)) (як-є решта) (як-є визначити))))
(за-умовою
 ((хибне? (атом? (перше проба-однієї-пари))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта проба-однієї-пари)) так)
 (так (перше (як-є ()))))

; Дві пари розділені атомом: атом між ними зберігається.
(визначити проба-двох-пар
 (префікс-до-останньої-пари
  (список (список (як-є атом?)) (як-є решта)
          (список (як-є сполучити)) (як-є визначити))))
(за-умовою
 ((тотожне? (друге проба-двох-пар) (як-є решта)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (атом? (третє проба-двох-пар))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта (решта (решта проба-двох-пар)))) так)
 (так (перше (як-є ()))))
; Негатив: третя складена пара не може зникнути разом із хвостом.
; Окремий закон вище перевіряє відсутність четвертого хвостового атома.
(за-умовою
 ((хибне? (порожній? (решта (решта проба-префікса)))) так)
 (так (перше (як-є ()))))
(атом? (як-є ()))
