; Д11: Scheme SRFI-1 list=, чисте порівняння скінченних списків.
; Джерело: https://srfi.schemers.org/srfi-1/srfi-1.html
; Перевіряються відповідні елементи, а не структурна тотожність без
; переданого порівнювача. Порівнювач повертає точний предикат Д1.
; Для множини списків звіряємо сусідів: перший з другим, другий з третім.
; Нуль та один список мають відповідь Д1 так без викликів порівнювача.
; Аргументи — правильні скінченні списки, без крапкових чи циклів.
; Жодного машинного примітива Д11, машинних чисел або host обчислення.

(визначити списки-рівні-за-порівнянням?
  (функція (порівняти лівий правий)
    (за-умовою
      ((порожній? лівий) (порожній? правий))
      ((порожній? правий) ні)
      ((порівняти (перше лівий) (перше правий))
       (списки-рівні-за-порівнянням?
         порівняти (решта лівий) (решта правий)))
      (так ні))))

(визначити усі-списки-рівні-за-порівнянням?
  (функція (порівняти списки)
    (за-умовою
      ((порожній? списки) так)
      ((порожній? (решта списки)) так)
      ((списки-рівні-за-порівнянням?
         порівняти (перше списки) (друге списки))
       (усі-списки-рівні-за-порівнянням?
         порівняти (решта списки)))
      (так ні))))

; Кінцевий виклик-свідок: файл виконується при завантаженні, а не лише визначає.
(списки-рівні-за-порівнянням? (функція (ліве праве) (тотожне? ліве праве)) (як-є ()) (як-є ()))
