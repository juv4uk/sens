; Д11: Scheme SRFI-1 list= — порівняння скінченних ПРАВИЛЬНИХ списків.
; Джерело: https://srfi.schemers.org/srfi-1/srfi-1.html
; D3/ D4 розмежовують (): єдиний правильний кінець списку, та інший
; атом: ПОМИЛКА ТИПУ, а не D1:ні як висновок про нерівність.
; Перевірку форми виконуємо один раз, перед законом порівняння.
; Порівнювач повертає тільки точний D1. Жодних нових D11-координат.
; Після перевірки правильного списку внутрішній обхід не повторює
; перевірку кожного хвоста і не створює квадратичний обхід.
;
; Список складається з D3-пар і завершується тільки D3:000.
(визначити правильний-список-для-рівності?
  (функція (елементи)
    (за-умовою
      ; Єдиний атомний кінець правильного списку — точний D3 ().
      ; Будь-який інший атомний хвіст є Type-помилкою, а не D1:ні.
      ((атом? елементи)
       (за-умовою
         ((тотожне? елементи (як-є ())) так)
         (так (перше елементи))))
      (так
       (правильний-список-для-рівності?
         (решта елементи))))))

; Список списків правильний лише тоді, коли правильні також усі його
; елементи. Один невалідний список не може бути «рівним самому собі».
(визначити правильні-списки-для-рівності?
  (функція (списки)
    (за-умовою
      ; Єдиний атомний кінець переліку — точний D3 ().
      ; Неправильний хвіст переліку також є Type, не значенням D1.
      ((атом? списки)
       (за-умовою
         ((тотожне? списки (як-є ())) так)
         (так (перше списки))))
      ; Кожен вкладений аргумент перевіряється до порівняння.
      ; Неправильний список сам піднімає D3 Type; не перетворюємо його на ні.
      ((хибне? (правильний-список-для-рівності? (перше списки)))
       (перше (як-є ())))
      (так
       (правильні-списки-для-рівності?
         (решта списки))))))

; Нижче: лише власне порівняння ПІСЛЯ валідації двох списків.
(визначити списки-рівні-ядро?
  (функція (порівняти лівий правий)
    (за-умовою
      ((порожній? лівий) (порожній? правий))
      ((порожній? правий) ні)
      ((порівняти (перше лівий) (перше правий))
       (списки-рівні-ядро?
         порівняти (решта лівий) (решта правий)))
      (так ні))))

(визначити списки-рівні-за-порівнянням?
  (функція (порівняти лівий правий)
    (за-умовою
      ((хибне? (правильний-список-для-рівності? лівий))
       (перше (як-є ())))
      ((хибне? (правильний-список-для-рівності? правий))
       (перше (як-є ())))
      (так
       (списки-рівні-ядро? порівняти лівий правий)))))

; Для N списків перевіряємо форму всіх N один раз.
; Потім порівнюємо сусідні пари, не викликаючи порівнювач за N<=1.
(визначити усі-списки-рівні-ядро?
  (функція (порівняти списки)
    (за-умовою
      ((порожній? списки) так)
      ((порожній? (решта списки)) так)
      ((списки-рівні-ядро?
         порівняти (перше списки) (друге списки))
       (усі-списки-рівні-ядро?
         порівняти (решта списки)))
      (так ні))))

(визначити усі-списки-рівні-за-порівнянням?
  (функція (порівняти списки)
    (за-умовою
      ((хибне? (правильні-списки-для-рівності? списки))
       (перше (як-є ())))
      (так
       (усі-списки-рівні-ядро? порівняти списки)))))
