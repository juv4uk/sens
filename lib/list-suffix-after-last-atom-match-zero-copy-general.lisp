(за-умовою
 ((хибне? (рівні-дерева-після-останнього?
   (суфікс-після-останнього-збігу
    (список (як-є атом?) (як-є решта) (як-є атом?) (як-є сполучити))
    (як-є атом?))
   (список (як-є решта) (як-є атом?) (як-є сполучити)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (рівні-дерева-після-останнього?
   (суфікс-після-останнього-збігу
    (список (список (як-є атом?)) (як-є решта)) (як-є атом?))
   (список (як-є решта)))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (рівні-дерева-після-останнього?
   (суфікс-після-останнього-збігу
    (список (як-є ()) (як-є решта)) (як-є ()))
   (як-є ()))) так)
 (так (перше (як-є ()))))

