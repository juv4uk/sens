 (список (як-є атом?)) (як-є атом?) (як-є ()))

; Правий збіг перемагає лівий, повтори та правий хвіст не губляться.
(довести-суфікс-після-останнього
 (список (як-є атом?) (як-є решта) (як-є атом?) (як-є сполучити))
 (як-є атом?) (список (як-є сполучити)))
(довести-суфікс-після-останнього
 (список (як-є атом?) (як-є атом?) (як-є решта))
 (як-є атом?) (список (як-є решта)))
(довести-суфікс-після-останнього
 (список (як-є атом?) (як-є решта) (як-є атом?)
         (як-є сполучити) (як-є атом?) (як-є тотожне?))
 (як-є атом?) (список (як-є тотожне?)))

