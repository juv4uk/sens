(довести-суфікс-після-останнього
 (список (список (як-є атом?)) (список (як-є решта)))
 (як-є атом?)
 (список (список (як-є атом?)) (список (як-є решта))))

; Порожній як елемент теж атом, тотожність порожнього з порожнім є справжнім збігом.
(довести-суфікс-після-останнього
 (список (як-є ()) (як-є атом?) (як-є ()) (як-є решта))
 (як-є ()) (список (як-є решта)))
(довести-суфікс-після-останнього
