; СЕНС Д3-Д5: повернути частину правильного списку ПІСЛЯ останнього збігу атома.
; За відсутності збігу лишити цілий початковий список; після збігу в кінці - порожній.
; Один прохід, лінійний, жодної нової пари: результат - наявний хвіст вхідного списку.
; Порівнюємо тотожністю тільки атоми, вкладені пари ніколи не розкладаємо.
(визначити суфікс-після-останнього-збігу-обхід
 (функція (елементи зразок останній-хвіст)
  (за-умовою
   ((атом? елементи) останній-хвіст)
   ((атом? (перше елементи))
    (за-умовою
     ((тотожне? (перше елементи) зразок)
      (суфікс-після-останнього-збігу-обхід
       (решта елементи) зразок (решта елементи)))
     (так
      (суфікс-після-останнього-збігу-обхід
       (решта елементи) зразок останній-хвіст))))
   (так
    (суфікс-після-останнього-збігу-обхід
     (решта елементи) зразок останній-хвіст)))))

(визначити суфікс-після-останнього-збігу
 (функція (елементи зразок)
  (суфікс-після-останнього-збігу-обхід елементи зразок елементи)))

; Незалежний структурний закон: атоми порівнює СЕНС, пари - рекурсія Д3.
(визначити рівні-дерева-після-останнього?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((рівні-дерева-після-останнього? (перше ліве) (перше праве))
    (рівні-дерева-після-останнього? (решта ліве) (решта праве)))
   (так ні))))

(визначити довести-суфікс-після-останнього
 (функція (вхід зразок очікуване)
  (за-умовою
   ((рівні-дерева-після-останнього?
     (суфікс-після-останнього-збігу вхід зразок) очікуване) так)
   (так (перше (як-є ()))))))

; Атомарний хвіст не є парою: зберігаємо безкопійний суфікс.
; СЕНС виконує обидва крайові закони, не Python/JSON.
(довести-суфікс-після-останнього
