; Д11: виконуваний свідок закону суфіксного розширення селекторів.
; Для ратифікованого батька p точні похідні мають семантику:
; p0(x) = p(перше(x)); p1(x) = p(решта(x)).
; Це бібліотечні композиції чинних D3/D4, а НЕ нові координати D11.
; Вони не стверджують, що всі 512 похідних машинно допущені.
; Передумова: відповідна гілка вузла — пара, на якій батько визначений.
; Атомний неправильний вхід не перетворюємо на мовчазний D1:ні:
; D3 ПЕРШЕ/РЕШТА мають відхилити недопущене застосування.

(визначити похідний-селектор-перше
  (функція (батько вузол)
    (батько (перше вузол))))

(визначити похідний-селектор-решта
  (функція (батько вузол)
    (батько (решта вузол))))

; Одна точна структура з різними атомами на двох гілках.
; p = Д4:1001 ДРУГЕ та p = Д3:100 ПЕРШЕ перевіряються як
; першокласні операції. Д3:101 ТОТОЖНЕ? застосовано лише до атомів.
(визначити дерево-для-похідних-селекторів
  (сполучити
    (список (як-є атом?) (як-є решта))
    (список (як-є сполучити) (як-є тотожне?))))

; Позитивні закони для обох суфіксів і двох батьків.
; Негативний закон доводить, що суфікси не можна переставити:
; РЕШТА та ТОТОЖНЕ? тут різні точні атомні тотожності.
; Єдина остання відповідь — D1; жодного текстового оракула.
(визначити перевірити-похідні-селектори
  (функція (вузол)
    (за-умовою
      ((тотожне?
         (похідний-селектор-перше друге вузол)
         (як-є решта))
       (за-умовою
         ((тотожне?
            (похідний-селектор-решта друге вузол)
            (як-є тотожне?))
          (за-умовою
            ((тотожне?
               (похідний-селектор-перше перше вузол)
               (як-є атом?))
             (за-умовою
               ((тотожне?
                  (похідний-селектор-решта перше вузол)
                  (як-є сполучити))
                (хибне?
                  (тотожне?
                    (похідний-селектор-перше друге вузол)
                    (похідний-селектор-решта друге вузол))))
               (так ні)))
            (так ні)))
         (так ні)))
      (так ні))))

(перевірити-похідні-селектори дерево-для-похідних-селекторів)
