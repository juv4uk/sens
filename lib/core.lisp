    (за-умовою
      ((атом? групи) (як-є ()))
      (так
       (нехай ((група (перше групи)))
         (за-умовою
           ((тотожне? семантична-адреса (перше група)) група)
           (так
            (my-postcore-peer-group семантична-адреса (решта групи)))))))))

