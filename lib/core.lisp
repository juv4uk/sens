; SENS — похідні визначення ядра. Повне джерело для актуальних доменів.
; Нормативні адреси визначаються ратифікованими таблицями D1–D10.
; Параметри функції можуть бути списком, крапковим списком або атомарним
; ім'ям для решти всіх аргументів — це доведена семантика замикання.
; Макроси створює ратифікована D5 форма «макрос».
; Математичні значення записуються людськими десятковими числами.

; Базові значення, макроси та селектори.

(визначити тотожність (функція (значення) значення))

(визначити порожній?
  (функція (значення)
    (за-умовою
      ((атом? значення) (тотожне? значення (як-є ())))
      (так ні))))

; D4:0100 NOT. Самодостатній Core: D1-значення не залежить від Core4.
(визначити хибне?
  (функція (відповідь)
    (за-умовою
      (відповідь ні)
      (так так))))

(визначити бінарний
  (функція (ширина)
    (список (як-є binary) ширина)))

(визначити binary бінарний)

(визначити список (функція аргументи аргументи))

(визначити list список)

(визначити та (макрос (функція аргументи (за-умовою ((порожній? аргументи) (як-є так)) ((порожній? (решта аргументи)) (перше аргументи)) (так (список (як-є за-умовою) (список (перше аргументи) (сполучити (як-є та) (решта аргументи))) (список (як-є так) (як-є ні))))))))

(визначити або (макрос (функція аргументи (за-умовою ((порожній? аргументи) (як-є ні)) ((порожній? (решта аргументи)) (перше аргументи)) (так (список (як-є за-умовою) (список (перше аргументи) (як-є так)) (список (як-є так) (сполучити (як-є або) (решта аргументи)))))))))

(визначити and та)

(визначити or або)

; Синоніми рядкових і предикатних поверхонь (D4/D9):
; зчепити ≡ рядок-додати; текст-* ≡ рядок-*; порожнє? ≡ порожній?.
; Потрібні REPL і джерельним профілям; не нові семантики.
(визначити зчепити рядок-додати)
(визначити текст-порожній? рядок-порожній?)
(визначити перший-символ-тексту рядок-перший)
(визначити решта-символів-тексту рядок-решта)
(визначити порожнє? порожній?)

(визначити створити-символ
  (функція (префікс)
    (текст-у-символ (рядок-додати префікс (значення-у-текст (монотонний-наносекунди))))))
