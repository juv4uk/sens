; Повна українська клавіатурна проєкція базового ядра.
; Значення та виклики визначаються чинними ратифікованими доменами.
; Історичні латинські псевдоніми залишаються у сумісному четвертому ядрі.
; Числа для математики мають людський десятковий запис.

; «ні» і «так» — безпосередні незмінні значення ратифікованого Д1.
; Вони вже визначені читачем SENS; повторне DEFINE порушує точну тотожність.
; Предикати Д3 повертають цей самий Д1 без текстових псевдонімів.

(визначити тотожність (функція (значення) значення))

(визначити порожній?
  (функція (значення)
    (за-умовою
      ((атом? значення) (тотожне? значення (як-є ())))
      ((атом? (як-є ())) (атом? (сполучити (як-є ()) (як-є ())))))))

; D1-предикат породжується перевіркою D3, а не незв'язаними
; текстовими так/ні. Пара не є атомом; порожнеча є атомом.
(визначити хибне?
  (функція (відповідь)
    (за-умовою
      (відповідь (атом? (сполучити (як-є ()) (як-є ()))))
      ((атом? (як-є ())) (атом? (як-є ()))))))

; Д4:1110 список є незмінним ратифікованим викликом.
; Не затінювати його локальною variadic-функцією в базовому ядрі.

(визначити друге
  (функція (значення-функції)
    (перше (решта значення-функції))))

; Складені селектори четвертого домену є похідними третього.
; Кожен має одну точну композицію, без нової адреси або механізму.
(визначити решта-першого
  (функція (значення)
    (решта (перше значення))))

(визначити решта-решти
  (функція (значення)
    (решта (решта значення))))

(визначити перше-першого
  (функція (значення)
    (перше (перше значення))))


; Складені селектори п'ятого домену: точні композиції третього.
; Кожна назва належить чинній повній проєкції укр Д5.
; Визначення не вводять нових кодів або машинних виконавців.
(визначити решта-двох-перших
  (функція (значення)
    (решта (перше (перше значення)))))

(визначити решта-після-першого
  (функція (значення)
    (решта (перше (решта значення)))))

(визначити решта-решти-першого
  (функція (значення)
    (решта (решта (перше значення)))))

(визначити решта-трьох
  (функція (значення)
    (решта (решта (решта значення)))))

(визначити перше-двох-перших
  (функція (значення)
    (перше (перше (перше значення)))))

(визначити перше-після-першого
  (функція (значення)
    (перше (перше (решта значення)))))

(визначити перше-решти-першого
  (функція (значення)
    (перше (решта (перше значення)))))

(визначити третє
  (функція (значення-функції)
    (перше (решта (решта значення-функції)))))

(визначити четверте
  (функція (значення-функції)
    (третє (решта значення-функції))))

; Десятий домен: умовний вибір має власну ратифіковану назву.
; Виконання залишається в третьому домені через умовні пари.
; Макрос зберігає коротке обчислення лише обраної гілки.
; Допускаються дві або три сирі форми, інша арність відхиляється.
; За відсутності альтернативи повертається хибне значення першого домену.
(визначити якщо
  (макрос
    (функція аргументи
      (за-умовою
        ((порожній? аргументи) (макрос))
        ((порожній? (решта аргументи)) (макрос))
        ((порожній? (решта (решта аргументи)))
         (список
           (як-є за-умовою)
           (список (перше аргументи) (друге аргументи))
           (список (як-є так) (як-є ні))))
        ((порожній? (решта (решта (решта аргументи))))
         (список
           (як-є за-умовою)
           (список (перше аргументи) (друге аргументи))
           (список (як-є так) (третє аргументи))))
        ((атом? (як-є ())) (макрос))))))

; Дев'ятий домен: п'ятий елемент правильного списку.
; Координата й повне ім'я ратифіковані в Д9, новий резидент не створюється.
; Коротший правильний список дає порожню структуру.
(визначити п'ятий
  (функція (значення)
    (за-умовою
      ((порожній? значення) (як-є ()))
      ((порожній? (решта значення)) (як-є ()))
      ((порожній? (решта (решта значення))) (як-є ()))
      ((порожній? (решта (решта (решта значення)))) (як-є ()))
      ((порожній? (решта (решта (решта (решта значення))))) (як-є ()))
      ((атом? (як-є ())) (перше (решта (решта (решта (решта значення)))))))))

(визначити та (макрос (функція аргументи (за-умовою ((порожній? аргументи) (як-є (атом? (як-є ())))) ((порожній? (решта аргументи)) (перше аргументи)) ((атом? (як-є ())) (список (як-є за-умовою) (список (перше аргументи) (сполучити (як-є та) (решта аргументи))) (список (як-є так) (як-є ні))))))))

(визначити або (макрос (функція аргументи (за-умовою ((порожній? аргументи) (як-є (атом? (сполучити (як-є ()) (як-є ()))))) ((порожній? (решта аргументи)) (перше аргументи)) ((атом? (як-є ())) (список (як-є за-умовою) (список (перше аргументи) (як-є так)) (список (як-є так) (сполучити (як-є або) (решта аргументи)))))))))

; Похідні текстові замикання посилаються на Д9 лише під час виклику.
; Повне ядро завантажується до бібліотеки рядків: рання прив'язка
; до ще невизначених D9-імен зривала справжній SENS bootstrap.
(визначити зчепити
  (функція (лівий правий) (рядок-додати лівий правий)))
(визначити текст-порожній?
  (функція (текст) (рядок-порожній? текст)))
(визначити перший-символ-тексту
  (функція (текст) (рядок-перший текст)))
(визначити решта-символів-тексту
  (функція (текст) (рядок-решта текст)))
(визначити порожнє? порожній?)

; Похідний макрос: те саме, що нехай (Д6), для джерельних профілів.
(визначити нехай-похідне
  (макрос (функція (зв'язування-функції тіло-розгортання)
    (список (як-є нехай) зв'язування-функції тіло-розгортання))))


(визначити створити-символ
  (функція (префікс)
    (текст-у-символ (рядок-додати префікс (значення-у-текст (монотонний-наносекунди))))))

; Похідні замикання шостого домену: складення, часткове застосування
; одного лівого аргументу та переставлення двох аргументів.
; Точні імена й координати вже ратифіковано у таблиці Д6.
; Ці визначення не допускають автоматично прямий виклик машинного слова Д6.
; Усі три закони використовують лексичні замикання четвертого домену.
(визначити скласти-функції
  (функція (зовнішня-функція внутрішня-функція)
    (функція (аргумент)
      (зовнішня-функція (внутрішня-функція аргумент)))))

(визначити частково-застосувати
  (функція (функція-двох-аргументів перший-аргумент)
    (функція (другий-аргумент)
      (функція-двох-аргументів перший-аргумент другий-аргумент))))

(визначити поміняти-аргументи
  (функція (функція-двох-аргументів)
    (функція (перший-аргумент другий-аргумент)
      (функція-двох-аргументів другий-аргумент перший-аргумент))))
