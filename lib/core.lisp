  (функція (джерело-форми відповідники привязки)
    (за-умовою
      ((атом? відповідники) (як-є ()))
      (так
       (нехай ((поточний-відповідник (перше відповідники)))
         (за-умовою
           ((тотожне? джерело-форми поточний-відповідник)
            (my-postcore-missing-peers джерело-форми (решта відповідники) привязки))
           (так
            (за-умовою
              ((тотожне? (my-postcore-binding-status поточний-відповідник привязки)
                         (як-є present))
               (my-postcore-missing-peers джерело-форми (решта відповідники) привязки))
              ((тотожне? (my-postcore-binding-status поточний-відповідник привязки)
                         (як-є absent))
               (сполучити поточний-відповідник
                 (my-postcore-missing-peers
                   джерело-форми (решта відповідники) привязки)))))))))))

