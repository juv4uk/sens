  (функція (поверхня привязки)
    (за-умовою
      ((атом? привязки) (як-є absent))
      (так
       (нехай ((поточна-привязка (перше привязки)))
         (за-умовою
           ((тотожне? (символ-у-текст поверхня) (перше поточна-привязка))
            (як-є present))
           (так
            (my-postcore-binding-status поверхня (решта привязки)))))))))

