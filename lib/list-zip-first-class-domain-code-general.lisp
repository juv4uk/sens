; Парне відображення двох списків першокласним доменним кодом.
; Дія - вже допущена функція СЕНС, а не назва в Д7 чи код SID8.
; Закінчуємо на коротшому списку; результат лишається впорядкованим.
; Жодної Unicode-конвертації, Python/JSON-семантики або копії префікса.
(визначити пари-за-доменним-кодом
  (функція (дія ліві праві)
    (за-умовою
      ((порожній? ліві) (як-є ()))
      ((порожній? праві) (як-є ()))
      (так
       (сполучити
         (дія (перше ліві) (перше праві))
         (пари-за-доменним-кодом
           дія (решта ліві) (решта праві)))))))

; Позитив: Д3 СПОЛУЧИТИ передається значенням і створює пару.
(за-умовою
  ((тотожне?
     (перше
       (перше
         (пари-за-доменним-кодом
           сполучити
           (список (як-є атом?) (як-є решта))
           (список (як-є перше) (як-є сполучити)))))
     (як-є атом?)) так)
  (так (перше (як-є ()))))

; Порожній лівий вхід не викликає функцію й не читає пару.
(за-умовою
  ((порожній?
     (пари-за-доменним-кодом
       сполучити (як-є ()) (список (як-є атом?)))) так)
  (так (перше (як-є ()))))

; На коротшому правому списку рівно один результат.
(за-умовою
  ((порожній?
     (решта
       (пари-за-доменним-кодом
         сполучити
         (список (як-є атом?) (як-є решта))
         (список (як-є перше))))) так)
  (так (перше (як-є ()))))

; Негатив: перший компонент результату НЕ другий вхід.
(за-умовою
  ((хибне?
     (тотожне?
       (перше
         (перше
           (пари-за-доменним-кодом
             сполучити
             (список (як-є атом?))
             (список (як-є перше)))))
       (як-є перше))) так)
  (так (перше (як-є ()))))

(атом? (як-є ()))
