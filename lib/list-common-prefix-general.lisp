; Найдовший спільний префікс двох правильних скінченних списків атомів.
; Д3 і Д4, без текстових машинних літералів та зовнішнє семантики.
; Закони: П((),у)=(); П(х,())=(); П(а::х,а::у)=а::П(х,у);
; якщо перші атоми різні, префікс порожній. Порядок незмінний.
(визначити спільний-префікс-атомів
  (функція (лівий правий)
    (за-умовою
      ((атом? лівий) (як-є ()))
      ((атом? правий) (як-є ()))
      ((тотожне? (перше лівий) (перше правий))
        (сполучити (перше лівий)
          (спільний-префікс-атомів (решта лівий) (решта правий))))
      ((атом? (як-є ())) (як-є ())))))

(визначити ліва-четвірка
  (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є порожній?)))
(визначити права-четвірка
  (список (як-є атом?) (як-є решта) (як-є тотожне?) (як-є хибне?)))
(визначити спільна-пара
  (спільний-префікс-атомів ліва-четвірка права-четвірка))
(визначити спільна-трійка
  (спільний-префікс-атомів
    (список (як-є атом?) (як-є решта) (як-є сполучити))
    (список (як-є атом?) (як-є решта) (як-є сполучити))))
(визначити спільний-один
  (спільний-префікс-атомів
    (список (як-є атом?) (як-є решта))
    (список (як-є атом?) (як-є тотожне?))))
(визначити розбіжні
  (спільний-префікс-атомів
    (список (як-є атом?) (як-є решта))
    (список (як-є сполучити) (як-є решта))))

; Справжній СЕНС перевіряє позиції, точну довжину, всі крайові
; випадки і негативи. Хибна умова виконує недопустимий перше порожній.
; Адресне виправлення: кожна гілка СОНД є окремою формою,
; без зайвої обгортки, яка трактувалась як виклик списку-даних.
(за-умовою
  ((тотожне? (перше спільна-пара) (як-є атом?))
    (за-умовою
    ((тотожне? (друге спільна-пара) (як-є решта))
      (за-умовою
      ((атом? (решта-решти спільна-пара))
        (за-умовою
        ((тотожне? (перше спільна-трійка) (як-є атом?))
          (за-умовою
          ((тотожне? (друге спільна-трійка) (як-є решта))
            (за-умовою
            ((тотожне? (перше (решта-решти спільна-трійка)) (як-є сполучити))
              (за-умовою
              ((атом? (решта (решта-решти спільна-трійка)))
                (за-умовою
                ((тотожне? (перше спільний-один) (як-є атом?))
                  (за-умовою
                  ((атом? (решта спільний-один))
                    (за-умовою
                    ((атом? розбіжні)
                      (за-умовою
                      ((атом? (спільний-префікс-атомів (як-є ()) ліва-четвірка))
                        (за-умовою
                        ((атом? (спільний-префікс-атомів ліва-четвірка (як-є ())))
                          (за-умовою
                          ((атом? (спільний-префікс-атомів (як-є ()) (як-є ())))
                            (за-умовою
                            ((хибне? (тотожне? (друге спільна-пара) (як-є тотожне?)))
                              (за-умовою
                              ((хибне? (тотожне? (перше спільна-пара) (як-є сполучити)))
                                (атом? (як-є ())))
                              ((атом? (як-є ())) (перше (як-є ())))))
                            ((атом? (як-є ())) (перше (як-є ())))))
                          ((атом? (як-є ())) (перше (як-є ())))))
                        ((атом? (як-є ())) (перше (як-є ())))))
                      ((атом? (як-є ())) (перше (як-є ())))))
                    ((атом? (як-є ())) (перше (як-є ())))))
                  ((атом? (як-є ())) (перше (як-є ())))))
                ((атом? (як-є ())) (перше (як-є ())))))
              ((атом? (як-є ())) (перше (як-є ())))))
            ((атом? (як-є ())) (перше (як-є ())))))
          ((атом? (як-є ())) (перше (як-є ())))))
        ((атом? (як-є ())) (перше (як-є ())))))
      ((атом? (як-є ())) (перше (як-є ())))))
    ((атом? (як-є ())) (перше (як-є ())))))
  ((атом? (як-є ())) (перше (як-є ()))))
