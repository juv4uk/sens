; СЕНС Д3-Д5: оборотний розріз списку атомів перед першим збігом.
; Лівий фрагмент не містить шуканого атома; правий починається з
; першого збігу й зберігає всі наступні повтори. За відсутності
; збігу ліворуч лишається весь список, праворуч - порожній.
; Жодного іншомовного обчислювача або нового доменного закону.

(визначити розділити-перед-першим-збігом
  (функція (елементи шуканий)
    (за-умовою
      ((атом? елементи) (список (як-є ()) (як-є ())))
      ((тотожне? (перше елементи) шуканий)
       (список (як-є ()) елементи))
      ((атом? (як-є ()))
       ((функція (частини)
          (список
            (сполучити (перше елементи) (перше частини))
            (друге частини)))
        (розділити-перед-першим-збігом (решта елементи) шуканий))))))

(визначити зібрати-фрагменти
  (функція (лівий правий)
    (за-умовою
      ((атом? лівий) правий)
      ((атом? (як-є ()))
       (сполучити (перше лівий)
         (зібрати-фрагменти (решта лівий) правий))))))

; Рівність структур доводиться рекурсією: Д3 ТОТОЖНЕ? - лише для атомів.
(визначити однакові-списки-атомів?
  (функція (лівий правий)
    (за-умовою
      ((атом? лівий) (порожній? правий))
      ((атом? правий) (хибне? (атом? (як-є ()))))
      ((хибне? (тотожне? (перше лівий) (перше правий)))
       (хибне? (атом? (як-є ()))))
      ((атом? (як-є ()))
       (однакові-списки-атомів? (решта лівий) (решта правий))))))

; Хибний Д1-свідок зупиняє саме виконання СЕНС, а не текстовий сканер.
(визначити перевірити-розріз
  (функція (відповідь)
    (за-умовою
      (відповідь (атом? (як-є ())))
      ((атом? (як-є ())) (перше (як-є ()))))))

(визначити послідовність-досліду
  (список (як-є атом?) (як-є решта) (як-є сполучити) (як-є решта) (як-є тотожне?)))
(визначити розріз-на-початку
  (розділити-перед-першим-збігом послідовність-досліду (як-є атом?)))
(визначити розріз-усередині
  (розділити-перед-першим-збігом послідовність-досліду (як-є сполучити)))
(визначити розріз-повторів
  (розділити-перед-першим-збігом послідовність-досліду (як-є решта)))
(визначити розріз-без-збігу
  (розділити-перед-першим-збігом послідовність-досліду (як-є за-умовою)))
(визначити розріз-порожнього
  (розділити-перед-першим-збігом (як-є ()) (як-є атом?)))

(перевірити-розріз (порожній? (перше розріз-порожнього)))
(перевірити-розріз (порожній? (друге розріз-порожнього)))
(перевірити-розріз (порожній? (перше розріз-на-початку)))
(перевірити-розріз
  (однакові-списки-атомів? (друге розріз-на-початку) послідовність-досліду))
(перевірити-розріз
  (однакові-списки-атомів? (перше розріз-усередині)
    (список (як-є атом?) (як-є решта))))
(перевірити-розріз
  (однакові-списки-атомів? (друге розріз-усередині)
    (список (як-є сполучити) (як-є решта) (як-є тотожне?))))
(перевірити-розріз
  (однакові-списки-атомів? (перше розріз-повторів)
    (список (як-є атом?))))
(перевірити-розріз
  (однакові-списки-атомів? (друге розріз-повторів)
    (список (як-є решта) (як-є сполучити) (як-є решта) (як-є тотожне?))))
(перевірити-розріз (порожній? (друге розріз-без-збігу)))
(перевірити-розріз
  (однакові-списки-атомів? (перше розріз-без-збігу) послідовність-досліду))
(перевірити-розріз
  (однакові-списки-атомів?
    (зібрати-фрагменти (перше розріз-на-початку) (друге розріз-на-початку))
    послідовність-досліду))
(перевірити-розріз
  (однакові-списки-атомів?
    (зібрати-фрагменти (перше розріз-усередині) (друге розріз-усередині))
    послідовність-досліду))
(перевірити-розріз
  (однакові-списки-атомів?
    (зібрати-фрагменти (перше розріз-повторів) (друге розріз-повторів))
    послідовність-досліду))
(перевірити-розріз
  (однакові-списки-атомів?
    (зібрати-фрагменти (перше розріз-без-збігу) (друге розріз-без-збігу))
    послідовність-досліду))
(перевірити-розріз
  (хибне? (однакові-списки-атомів?
    (друге розріз-усередині)
    (друге розріз-повторів))))
(перевірити-розріз
  (хибне? (однакові-списки-атомів?
    (перше розріз-усередині)
    (перше розріз-без-збігу))))
