  ((тотожне? (перше (решта (решта (решта з'єднана-п'ятірка)))) (як-є тотожне?)) (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта з'єднана-п'ятірка))))) (як-є порожній?)) (за-умовою
  ((тотожне? (перше об'єднання-зліва-порожнім) (як-є сполучити)) (за-умовою
  ((тотожне? (друге об'єднання-зліва-порожнім) (як-є тотожне?)) (за-умовою
  ((тотожне? (перше об'єднання-справа-порожнім) (як-є атом?)) (за-умовою
