; Приєднати два власні скінченні списки довільної довжини.
; Закон Д3: append((), ys)=ys; append((x . xs), ys)=(x . append(xs,ys)).
; SENS Lisp визначає рекурсію, Zig/T5M лише переносить точні слова.
(визначити приєднати-два-списки
  (функція (лівий правий)
    (за-умовою
      ((атом? лівий) правий)
      ((атом? (як-є ()))
       (сполучити (перше лівий)
         (приєднати-два-списки (решта лівий) правий))))))

(визначити ліва-пара (список (як-є атом?) (як-є решта)))
(визначити права-трійка (список (як-є сполучити) (як-є тотожне?) (як-є порожній?)))
(визначити з'єднана-п'ятірка (приєднати-два-списки ліва-пара права-трійка))
(визначити об'єднання-зліва-порожнім
  (приєднати-два-списки (як-є ()) права-трійка))
(визначити об'єднання-справа-порожнім
  (приєднати-два-списки ліва-пара (як-є ())))
(визначити вкладений-лівий
  (список (сполучити (як-є атом?) (як-є решта)) (як-є сполучити)))
(визначити вкладене-приєднання
  (приєднати-два-списки вкладений-лівий (список (як-є тотожне?))))
(визначити асоціативно-ліворуч
  (приєднати-два-списки (приєднати-два-списки ліва-пара права-трійка)
    (список (як-є за-умовою))))
(визначити асоціативно-праворуч
  (приєднати-два-списки ліва-пара
    (приєднати-два-списки права-трійка (список (як-є за-умовою)))))

