; Приєднати два власні скінченні списки довільної довжини.
; Закон Д3: аппенд((), ус)=ус; аппенд((х . хс), ус)=(х . аппенд(хс,ус)).
; СЕНС Лісп визначає рекурсію, Зіг і Т5М лише переносить точні слова.
(визначити приєднати-два-списки
  (функція (лівий правий)
    (за-умовою
      ; Завершення Д3:() ≠ довільний атом Д1 або Д7.
      ; Некоректний хвіст відхиляє СЕНС Д3 ПЕРШЕ як Type.
      ((атом? лівий)
       (за-умовою
         ((тотожне? лівий (як-є ())) правий)
         (так (перше лівий))))
      (так
       (сполучити (перше лівий)
         (приєднати-два-списки (решта лівий) правий))))))

(визначити ліва-пара (список (як-є атом?) (як-є решта)))
(визначити права-трійка (список (як-є сполучити) (як-є тотожне?) (як-є порожній?)))
(визначити з'єднана-п'ятірка (приєднати-два-списки ліва-пара права-трійка))
(визначити об'єднання-зліва-порожнім
  (приєднати-два-списки (як-є ()) права-трійка))
(визначити об'єднання-справа-порожнім
  (приєднати-два-списки ліва-пара (як-є ())))
(визначити вкладений-лівий
  (список (сполучити (як-є атом?) (як-є решта)) (як-є сполучити)))
(визначити вкладене-приєднання
  (приєднати-два-списки вкладений-лівий (список (як-є тотожне?))))
(визначити асоціативно-ліворуч
  (приєднати-два-списки (приєднати-два-списки ліва-пара права-трійка)
    (список (як-є за-умовою))))
(визначити асоціативно-праворуч
  (приєднати-два-списки ліва-пара
    (приєднати-два-списки права-трійка (список (як-є за-умовою)))))

(визначити приєднаний-одиночний
  (приєднати-два-списки (список (як-є атом?)) (список (як-є сполучити))))

; Усі свідки обчислює нативний СЕНС: 5 позицій, нульові межі,
; вкладене пари-значення, асоціативність, два негативні контролі.
(за-умовою
  ((тотожне? (перше з'єднана-п'ятірка) (як-є атом?)) (за-умовою
  ((тотожне? (перше (решта з'єднана-п'ятірка)) (як-є решта)) (за-умовою
  ((тотожне? (перше (решта (решта з'єднана-п'ятірка))) (як-є сполучити)) (за-умовою
  ((тотожне? (перше (решта (решта (решта з'єднана-п'ятірка)))) (як-є тотожне?)) (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта з'єднана-п'ятірка))))) (як-є порожній?)) (за-умовою
  ((тотожне? (перше об'єднання-зліва-порожнім) (як-є сполучити)) (за-умовою
  ((тотожне? (друге об'єднання-зліва-порожнім) (як-є тотожне?)) (за-умовою
  ((тотожне? (перше об'єднання-справа-порожнім) (як-є атом?)) (за-умовою
  ((тотожне? (друге об'єднання-справа-порожнім) (як-є решта)) (за-умовою
  ((тотожне? (перше (перше вкладене-приєднання)) (як-є атом?)) (за-умовою
  ((тотожне? (друге вкладене-приєднання) (як-є сполучити)) (за-умовою
  ((тотожне? (перше (решта-решти вкладене-приєднання)) (як-є тотожне?)) (за-умовою
  ((тотожне? (перше асоціативно-ліворуч) (перше асоціативно-праворуч)) (за-умовою
  ((тотожне? (перше (решта асоціативно-ліворуч)) (перше (решта асоціативно-праворуч))) (за-умовою
  ((тотожне? (перше (решта (решта асоціативно-ліворуч))) (перше (решта (решта асоціативно-праворуч)))) (за-умовою
  ((тотожне? (перше (решта (решта (решта асоціативно-ліворуч)))) (перше (решта (решта (решта асоціативно-праворуч))))) (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта асоціативно-ліворуч))))) (перше (решта (решта (решта (решта асоціативно-праворуч)))))) (за-умовою
  ((тотожне? (перше (решта (решта (решта (решта (решта асоціативно-ліворуч)))))) (перше (решта (решта (решта (решта (решта асоціативно-праворуч))))))) (за-умовою
  ((хибне? (тотожне? (перше з'єднана-п'ятірка) (як-є сполучити))) (за-умовою
  ((хибне? (тотожне? (друге з'єднана-п'ятірка) (як-є атом?)))
   (за-умовою
     ((тотожне? (перше приєднаний-одиночний) (як-є атом?))
      (за-умовою
        ((тотожне? (друге приєднаний-одиночний) (як-є сполучити))
         (атом? (решта (решта приєднаний-одиночний))))
        ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
     ((атом? (як-є ())) (хибне? (атом? (як-є ()))))))
