; Структурний кодек другого домену для порядку маркерів.
; Маркери початку, кінця, роздільника й крапки зберігають
; чинні цитовані значення протоколу. Вони не стають новими
; викликуваними функціями одинадцятого домену.
; Внутрішні зв'язування, параметри та виклики мають українські імена.
; Функції структурного кодека викладено окремими читабельними формами.
; Фізичне пакування байтів належить зовнішньому транспортові.
; Безумовна гілка використовує безпосереднє значення так першого домену,
; а не тотожність двох цитованих сторонніх символів.

(визначити початок-д2 (як-є d2-open))
(визначити кінець-д2 (як-є d2-close))
(визначити роздільник-д2 (як-є d2-sep))
(визначити крапка-д2 (як-є d2-dot))
(визначити порожнє-д2 (як-є ()))
(визначити кодек-д2-кодувати-вузол
  (функція (вузол продовження)
    (за-умовою
      ((атом? вузол)
       (сполучити вузол продовження))
      (так
       (сполучити
         початок-д2
         (кодек-д2-кодувати-послідовність
           вузол (сполучити кінець-д2 продовження)))))))
(визначити кодек-д2-кодувати-послідовність
  (функція (послідовність продовження)
    (за-умовою
      ((атом? послідовність)
       (за-умовою
         ((тотожне? послідовність порожнє-д2)
          продовження)
         (так
          (сполучити
            крапка-д2
            (кодек-д2-кодувати-вузол
              послідовність
              продовження)))))
      (так
       (кодек-д2-кодувати-вузол
         (перше послідовність)
         (за-умовою
           ((атом? (решта послідовність))
            (кодек-д2-кодувати-послідовність
              (решта послідовність)
              продовження))
           (так
            (сполучити
              роздільник-д2
              (кодек-д2-кодувати-послідовність
                (решта послідовність)
                продовження)))))))))
(визначити кодек-д2-розвернути-до
  (функція (вузол накопичувач)
    (за-умовою
      ((атом? вузол) накопичувач)
      (так
       (кодек-д2-розвернути-до
         (решта вузол)
         (сполучити (перше вузол) накопичувач))))))
(визначити кодек-д2-декодувати-вузол
  (функція (потік)
    (за-умовою
      ((тотожне? (перше потік) початок-д2)
       (кодек-д2-декодувати-послідовність (решта потік) ()))
      (так
       (сполучити (перше потік) (решта потік))))))
; Реальні D4 замикання замість недопущеного D5:00001 value-call.
; Вузол обчислюємо лише раз; зберігаємо порядок і D2 крапку.
; Хвіст декодується як (значення . (d2-close . решта-потоку)).
; Внутрішній d2-close належить поточній парі; без його споживання
; зовнішня крапкова пара обривається на закритті внутрішньої.
(визначити кодек-д2-зібрати-крапкову-пару
  (функція (зібрані декодоване)
    (сполучити
      (кодек-д2-додати-префікс
        (кодек-д2-розвернути-до зібрані ())
        (перше декодоване))
      (решта (решта декодоване)))))
(визначити кодек-д2-продовжити-послідовність
  (функція (зібрані декодоване)
    (кодек-д2-декодувати-послідовність
      (решта декодоване)
      (сполучити (перше декодоване) зібрані))))

(визначити кодек-д2-декодувати-послідовність
  (функція (потік зібрані)
    (за-умовою
      ((тотожне? (перше потік) кінець-д2)
       (сполучити
         (кодек-д2-розвернути-до зібрані ())
         (решта потік)))
      ((тотожне? (перше потік) роздільник-д2)
       (кодек-д2-декодувати-послідовність
         (решта потік)
         зібрані))
      ((тотожне? (перше потік) крапка-д2)
       (кодек-д2-зібрати-крапкову-пару
         зібрані
         (кодек-д2-декодувати-вузол (решта потік))))
      (так
       (кодек-д2-продовжити-послідовність
         зібрані
         (кодек-д2-декодувати-вузол потік))))))
(визначити кодек-д2-додати-префікс
  (функція (префікс продовження)
    (за-умовою
      ((атом? префікс) продовження)
      (так
       (сполучити
         (перше префікс)
         (кодек-д2-додати-префікс
           (решта префікс)
           продовження))))))
; Початкове декодоване значення відокремлюємо від решти потоку.
(визначити кодек-д2-перший-декодований
  (функція (потік)
    (перше (кодек-д2-декодувати-вузол потік))))
(визначити кодувати-структуру-д2
  (функція (вузол)
    (кодек-д2-кодувати-вузол вузол ())))

; Перевірка обертання залишає мовне значення без фізичного пакування.
(визначити перевірити-обертання-д2
  (функція (вузол)
    (кодек-д2-перший-декодований
      (кодек-д2-кодувати-вузол вузол ()))))
; Структурний кодек викликається українськими іменами; T5M пакує
; байти окремо й не визначає семантики другого домену.
