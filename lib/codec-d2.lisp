; codec-d2.lisp — компактний кодек (T5 D2-порядок). Однолітерні внутрішні імена.
; Маркери A/B/C/D = ратифіковані D11-проєкції d2-open/d2-close/d2-sep/d2-dot
; (lib/domains/d11.lisp), НЕ довільні імена. E = порожня структура ().
(визначити A (як-є d2-open))
(визначити B (як-є d2-close))
(визначити C (як-є d2-sep))
(визначити D (як-є d2-dot))
(визначити E (як-є ()))
(визначити F (функція (x y) (за-умовою ((атом? x) (сполучити x y)) ((тотожне? (як-є t) (як-є t)) (сполучити A (G x (сполучити B y)))))))
(визначити G (функція (s y) (за-умовою ((атом? s) (за-умовою ((тотожне? s E) y) ((тотожне? (як-є t) (як-є t)) (сполучити D (F s y))))) ((тотожне? (як-є t) (як-є t)) (F (перше s) (за-умовою ((атом? (решта s)) (G (решта s) y)) ((тотожне? (як-є t) (як-є t)) (сполучити C (G (решта s) y)))))))))
(визначити R (функція (x a) (за-умовою ((атом? x) a) ((тотожне? (як-є t) (як-є t)) (R (решта x) (сполучити (перше x) a))))))
(визначити Q (функція (t) (за-умовою ((тотожне? (перше t) A) (S (решта t) ())) ((тотожне? (як-є t) (як-є t)) (сполучити (перше t) (решта t))))))
(визначити S (функція (t e) (за-умовою ((тотожне? (перше t) B) (сполучити (R e ()) (решта t))) ((тотожне? (перше t) C) (S (решта t) e)) ((тотожне? (перше t) D) ((функція (d) (сполучити (U (R e ()) (перше d)) (решта d))) (Q (решта t)))) ((тотожне? (як-є t) (як-є t)) ((функція (d) (S (решта d) (сполучити (перше d) e))) (Q t))))))
(визначити U (функція (l y) (за-умовою ((атом? l) y) ((тотожне? (як-є t) (як-є t)) (сполучити (перше l) (U (решта l) y))))))
(визначити P (функція (t) (перше (Q t))))
(визначити t5-encode (функція (x) (F x ())))
(визначити t5-roundtrip (функція (x) (P (F x ()))))
