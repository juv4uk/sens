; СЕНС Д3 і Д5: відкинути тільки початкові атоми, тотожні атомному зразку.
; Перша відмінність або складений елемент зупиняє обхід: повертається
; первісний хвіст без копіювання пари. Час О(к), додаткових пар пари: 0.
; порожній є атомом, але складена пара з порожній - не атом.
(визначити хвіст-після-початкових-збігів
 (функція (елементи зразок)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((атом? (перше елементи))
    (за-умовою
     ((тотожне? (перше елементи) зразок)
      (хвіст-після-початкових-збігів (решта елементи) зразок))
     (так елементи)))
   (так елементи))))

; Кожний закон виконує СЕНС: при хибному законі виконується перше(порожній).
(за-умовою
 ((порожній? (хвіст-після-початкових-збігів (як-є ()) (як-є атом?))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (хвіст-після-початкових-збігів
   (список (як-є атом?) (як-є атом?)) (як-є атом?))) так)
 (так (перше (як-є ()))))

; Залишити весь хвіст, а не тільки перший елемент.
(за-умовою
 ((тотожне? (перше (хвіст-після-початкових-збігів
   (список (як-є атом?) (як-є решта) (як-є атом?)) (як-є атом?)))
  (як-є решта)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((тотожне? (друге (хвіст-після-початкових-збігів
   (список (як-є атом?) (як-є решта) (як-є атом?)) (як-є атом?)))
  (як-є атом?)) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (решта-решти (хвіст-після-початкових-збігів
   (список (як-є атом?) (як-є решта) (як-є атом?)) (як-є атом?)))) так)
 (так (перше (як-є ()))))

; Складені елементи не порівнювати з атомним зразком.
(за-умовою
 ((хибне? (атом? (перше (хвіст-після-початкових-збігів
   (список (список (як-є атом?)) (як-є атом?)) (як-є атом?))))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((хибне? (атом? (перше (хвіст-після-початкових-збігів
   (список (як-є атом?) (список (як-є атом?)) (як-є атом?))
   (як-є атом?))))) так)
 (так (перше (як-є ()))))

; порожній як елемент - атом: відкидати тільки при точному збігу.
(за-умовою
 ((порожній? (хвіст-після-початкових-збігів
   (список (як-є ()) (як-є ())) (як-є ()))) так)
 (так (перше (як-є ()))))
(за-умовою
 ((порожній? (перше (хвіст-після-початкових-збігів
   (список (як-є ()) (як-є атом?)) (як-є атом?)))) так)
 (так (перше (як-є ()))))

; Негативний оракул: не пропустити перший чужий атом.
(за-умовою
 ((хибне? (тотожне? (перше (хвіст-після-початкових-збігів
   (список (як-є атом?) (як-є решта) (як-є атом?)) (як-є атом?)))
   (як-є атом?))) так)
 (так (перше (як-є ()))))
(атом? (як-є ()))
