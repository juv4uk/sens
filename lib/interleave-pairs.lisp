                      ((тотожне? (друге (решта-решти (переплести-пари (список (як-є атом?) (як-є тотожне?)) (список (як-є решта) (як-є сполучити))))) (як-є сполучити))
                        (за-умовою
                            ((хибне? (тотожне? (друге (переплести-пари (список (як-є атом?) (як-є тотожне?)) (список (як-є решта) (як-є сполучити)))) (як-є тотожне?)))
                              (атом? (як-є ())))
