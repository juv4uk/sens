(визначити пропустити-край-атома
  (функція (елементи шукане)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((тотожне? (перше елементи) шукане)
       (пропустити-край-атома (решта елементи) шукане))
      ((атом? (як-є ())) елементи))))

