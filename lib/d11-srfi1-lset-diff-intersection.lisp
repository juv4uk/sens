; Д11 · сімейний закон різниці та перетину множин, Scheme SRFI-1.
; Джерело: https://srfi.schemers.org/srfi-1/srfi-1.html
; Це виконувана SENS-композиція, НЕ нова координата або opcode Д11.
; Передумови: скінченні правильні списки, чистий компаратор Atom×Atom→Д1.
; Зберігаємо порядок та кратність елементів лівого входу.
; Результат: (різниця перетин) — два правильні списки, не host-values.
; Д1 ні як елемент не плутається з порожнім списком ().
; Вживаємо чинні закони: будь-яке? Д6, функція Д4,
; порожній? Д4, за-умовою/перше/решта/сполучити Д3, список.
; Кожний елемент лівого входу потрапляє рівно до однієї частини.
; Частини формуємо єдиним проходом лівого списку без мутацій.

(визначити додати-в-ліву-різницю
  (функція (елемент частини)
    (список
      (сполучити елемент (перше частини))
      (друге частини))))

(визначити додати-в-лівий-перетин
  (функція (елемент частини)
    (список
      (перше частини)
      (сполучити елемент (друге частини)))))

(визначити різниця-та-перетин-за-порівнянням
  (функція (порівняти ліві праві)
    (за-умовою
      ((порожній? ліві)
       (список (як-є ()) (як-є ())))
      ((будь-яке?
         (функція (правий)
           (порівняти (перше ліві) правий))
         праві)
       (додати-в-лівий-перетин
         (перше ліві)
         (різниця-та-перетин-за-порівнянням
           порівняти (решта ліві) праві)))
      (так
       (додати-в-ліву-різницю
         (перше ліві)
         (різниця-та-перетин-за-порівнянням
           порівняти (решта ліві) праві))))))

; Позитив: порядок та дублікати лівого списку збережено.
(за-умовою
  ((однакові?
     (різниця-та-перетин-за-порівнянням
       тотожне?
       (як-є (а б а в))
       (як-є (б г)))
     (як-є ((а а в) (б))))
   так)
  (так (перше (як-є ()))))

; Порожній правий список — уся ліва частина є різницею.
(за-умовою
  ((однакові?
     (різниця-та-перетин-за-порівнянням
       тотожне? (як-є (а б)) (як-є ()))
     (як-є ((а б) ())))
   так)
  (так (перше (як-є ()))))

; Порожній лівий список — обидві частини порожні.
(за-умовою
  ((однакові?
     (різниця-та-перетин-за-порівнянням
       тотожне? (як-є ()) (як-є (а)))
     (як-є (() ())))
   так)
  (так (перше (як-є ()))))

; Д1 ні і структурне () — різні члени лівого списку.
(за-умовою
  ((однакові?
     (різниця-та-перетин-за-порівнянням
       тотожне?
       (список ні (як-є ()))
       (список ні))
     (список (список (як-є ())) (список ні)))
   так)
  (так (перше (як-є ()))))

; Негативний мутант: переставлені частини НЕ є рівним результатом.
(за-умовою
  ((хибне?
     (однакові?
       (різниця-та-перетин-за-порівнянням
         тотожне?
         (як-є (а б а в))
         (як-є (б г)))
       (як-є ((б) (а а в)))))
   так)
  (так (перше (як-є ()))))

; Остаточний вердикт виконуваного SENS-файла: точний Д1 так.
(атом? (як-є ()))
