; Д11 · сімейний закон різниці та перетину множин, Scheme SRFI-1.
; Джерело: https://srfi.schemers.org/srfi-1/srfi-1.html
; Це виконувана SENS-композиція, НЕ нова координата або opcode Д11.
; Передумови: скінченні правильні списки, чистий компаратор Atom×Atom→Д1.
; Перевіряємо обидва списки до порівняння: короткий збіг або порожній
; лівий вхід не має маскувати неправильний правий хвіст.
; Зберігаємо порядок та кратність елементів лівого входу.
; Результат: (різниця перетин) — два правильні списки, не host-values.
; Д1 ні як елемент не плутається з порожнім списком ().
; Вживаємо чинні закони: функція Д4,
; порожній? Д4, за-умовою/перше/решта/сполучити Д3, список.
; Кожний елемент лівого входу потрапляє рівно до однієї частини.
; Частини формуємо єдиним проходом лівого списку без мутацій.

(визначити додати-в-ліву-різницю
  (функція (елемент частини)
    (список
      (сполучити елемент (перше частини))
      (друге частини))))

(визначити додати-в-лівий-перетин
  (функція (елемент частини)
    (список
      (перше частини)
      (сполучити елемент (друге частини)))))

; Пошук на D3/D4 без D6:111100, який нині не має фізичного
; допуску виклику в цьому T5M-коридорі. Це приватна частина нового закону,
; не новий opcode і не повторна реєстрація вже відомих доменних функцій.
(визначити правильний-список-для-різниці?
  (функція (елементи)
    (за-умовою
      ((порожній? елементи) так)
      ((атом? елементи) ні)
      (так (правильний-список-для-різниці? (решта елементи))))))

(визначити знайти-належність-у-правій-частині?
  (функція (порівняти шуканий праві)
    (за-умовою
      ((порожній? праві) ні)
      ((порівняти шуканий (перше праві)) так)
      (так
       (знайти-належність-у-правій-частині?
         порівняти шуканий (решта праві))))))

(визначити різниця-та-перетин-ядро
  (функція (порівняти ліві праві)
    (за-умовою
      ((порожній? ліві)
       (список (як-є ()) (як-є ())))
      ((знайти-належність-у-правій-частині?
         порівняти (перше ліві) праві)
       (додати-в-лівий-перетин
         (перше ліві)
         (різниця-та-перетин-ядро
           порівняти (решта ліві) праві)))
      (так
       (додати-в-ліву-різницю
         (перше ліві)
         (різниця-та-перетин-ядро
           порівняти (решта ліві) праві))))))

(визначити різниця-та-перетин-за-порівнянням
  (функція (порівняти ліві праві)
    (за-умовою
      ((хибне? (правильний-список-для-різниці? ліві))
       (перше (як-є ())))
      ((хибне? (правильний-список-для-різниці? праві))
       (перше (як-є ())))
      (так (різниця-та-перетин-ядро порівняти ліві праві)))))

; Д11 SRFI-1 LSET-XOR: двомісна симетрична різниця без нового opcode.
; Використовує Д11 DIFF+INTERSECTION як один нормативний механізм.
; A xor B = (A без B) ++ (B без A); порядок лівих, потім правих.
; Обидві D3-структури перевіряємо до ПЕРШОГО порівняння.
; Два проходи XOR повторно використовують вже доведене ядро,
; не виконують чотири повних сканування структур списків.
; D1 ні як хвіст та D7 атом відхиляються D3 ПЕРШЕ Type.
; Чистий компаратор визначає еквівалентність і повертає точний D1.
; Арність цього профілю — рівно два списки; variadic не вигадуємо.
(визначити симетрична-різниця-множин-за-порівнянням
  (функція (порівняти ліва права)
    (за-умовою
      ((хибне? (правильний-список-для-різниці? ліва))
       (перше (як-є ())))
      ((хибне? (правильний-список-для-різниці? права))
       (перше (як-є ())))
      (так
       (приєднати
         (перше
           (різниця-та-перетин-ядро порівняти ліва права))
         (перше
           (різниця-та-перетин-ядро порівняти права ліва)))))))
