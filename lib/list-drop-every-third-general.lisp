(визначити дерева-прорідження-однакові?
 (функція (ліве праве)
  (за-умовою
   ((атом? ліве)
    (за-умовою
     ((атом? праве) (тотожне? ліве праве))
     (так ні)))
   ((атом? праве) ні)
   ((дерева-прорідження-однакові? (перше ліве) (перше праве))
    (дерева-прорідження-однакові? (решта ліве) (решта праве)))
   (так ні))))

