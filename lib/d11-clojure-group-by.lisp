; Д11: Кложур групувати-за - чиста адаптація до СЕНС.
; Історичне джерело: гттпс: і  і кложур.гітгуб.іо і кложур і брансг-мастер і кложур.соре-апі.гтмл
; Кложур повертає мапу ключ у вектор; тут СЕНС-проєкція:
; правильний список (ключ група), з порядком ключів за першою появою,
; а значень - за вихідною послідовністю.
; Це НЕ розбиття-по: несуміжні збіги ключа входять до однієї групи.
; Обчислювач, рівність і рекурсія належать СЕНС; Зіг - тільки носій.
; Ключова функція має бути чистою: при пошуку двох списків можливі
; повторні виклики; лінива-послідовність, трансдюсер та хеш-мапа не обіцяються.

; Закон D3/D4: тільки D3:000 завершує правильний список.
; Сторонній атом у головному або проміжному хвості має викликати
; явну помилку SENS, а не перетворюватися на порожню групу.
; D1:ні не є викличним значенням; використовуємо його тільки
; у негативній гілці. Позитивний шлях та порядок ключів незмінні.

; Внутрішній допоміжний закон: зберегти всі входження ключа.
(визначити вибрати-елементи-з-ключем
  (функція (функція-ключа шуканий елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((атом? елементи) (ні (як-є неправильний-список)))
      ((однакові? (функція-ключа (перше елементи)) шуканий)
       (сполучити
         (перше елементи)
         (вибрати-елементи-з-ключем функція-ключа шуканий (решта елементи))))
      ((атом? (як-є ()))
       (вибрати-елементи-з-ключем функція-ключа шуканий (решта елементи))))))

; Внутрішній допоміжний закон: зберегти всі інші ключі в їхньому порядку.
(визначити вилучити-елементи-з-ключем
  (функція (функція-ключа шуканий елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((атом? елементи) (ні (як-є неправильний-список)))
      ((однакові? (функція-ключа (перше елементи)) шуканий)
       (вилучити-елементи-з-ключем функція-ключа шуканий (решта елементи)))
      ((атом? (як-є ()))
       (сполучити
         (перше елементи)
         (вилучити-елементи-з-ключем функція-ключа шуканий (решта елементи)))))))

; Один поділ за ключем повертає (відібрані . решта).
; Іменовані Д5 помічники зберігають порядок і форму початкових пар:
; фізичному SENS reader не потрібні анонімні функції в голові виклику.
(визначити додати-до-відібраних-ключа
  (функція (голова частини)
    (сполучити
      (сполучити голова (перше частини))
      (решта частини))))

(визначити додати-до-інших-ключів
  (функція (голова частини)
    (сполучити
      (перше частини)
      (сполучити голова (решта частини)))))

(визначити розділити-елементи-за-ключем
  (функція (функція-ключа шуканий елементи)
    (за-умовою
      ((порожній? елементи) (сполучити (як-є ()) (як-є ())))
      ((атом? елементи) (ні (як-є неправильний-список)))
      ((однакові? (функція-ключа (перше елементи)) шуканий)
       (додати-до-відібраних-ключа
         (перше елементи)
         (розділити-елементи-за-ключем
           функція-ключа шуканий (решта елементи))))
      ((порожній? (як-є ()))
       (додати-до-інших-ключів
         (перше елементи)
         (розділити-елементи-за-ключем
           функція-ключа шуканий (решта елементи)))))))

; Зовнішній закон: кожний різний ключ з'являється рівно один раз;
; у кожної групи є щонайменше один вихідний елемент.
; Першокласна рекурсивна дія передається як значення доменного коду.
; Ділимо хвіст один раз; не повторюємо функцію-ключа для першого вузла.
(визначити зібрати-групу-із-розділу
  (функція (наступна-дія функція-ключа голова перший-ключ частини)
    (сполучити
      (список перший-ключ
        (сполучити голова (перше частини)))
      (наступна-дія функція-ключа (решта частини)))))

(визначити згрупувати-за-першим-ключем
  (функція (наступна-дія функція-ключа елементи перший-ключ)
    (зібрати-групу-із-розділу
      наступна-дія функція-ключа (перше елементи) перший-ключ
      (розділити-елементи-за-ключем
        функція-ключа перший-ключ (решта елементи)))))

(визначити згрупувати-елементи-за-ключем
  (функція (функція-ключа елементи)
    (за-умовою
      ((порожній? елементи) (як-є ()))
      ((атом? елементи) (ні (як-є неправильний-список)))
      ((порожній? (як-є ()))
        (згрупувати-за-першим-ключем
          згрупувати-елементи-за-ключем
          функція-ключа елементи
          (функція-ключа (перше елементи)))))))
