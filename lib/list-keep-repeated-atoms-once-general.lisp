; Два справжні закони кожного випадку: точний порядок результату і
; другий прохід порожній, бо вихід не має жодних повторених атомів.
(визначити усі-закони-повторених-атомів?
 (функція (приклади)
  (за-умовою
   ((порожній? приклади) так)
   ((списки-повторів-однакові?
     (залишити-повторені-атоми-один-раз (перше (перше приклади)))
     (друге (перше приклади)))
    (за-умовою
     ((порожній?
       (залишити-повторені-атоми-один-раз
        (залишити-повторені-атоми-один-раз (перше (перше приклади)))))
      (усі-закони-повторених-атомів? (решта приклади)))
     (так ні)))
   (так ні))))

; Негативні перевірки: самотній атом не є повтором, а не той порядок
; виходу не приймається. Провал дає справжня помилка СЕНС перше(порожній).
(за-умовою
 ((усі-закони-повторених-атомів? приклади-повторених-атомів)
  (за-умовою
   ((хибне?
     (списки-повторів-однакові?
      (залишити-повторені-атоми-один-раз
       (список (як-є атом?) (як-є решта) (як-є атом?) (як-є решта)))
      (список (як-є решта) (як-є атом?))))
    (за-умовою
     ((хибне?
       (атом-зустрічається-далі-для-повторів?
        (як-є сполучити) (список (як-є атом?) (як-є решта))))
      (атом? (як-є ())))
     (так (перше (як-є ())))))
   (так (перше (як-є ())))))
 (так (перше (як-є ()))))
