; Д3 і Д5: залишити рівно одне, ПЕРШЕ входження тільки тих атомів,
; що повторюються у вхідному списку. Порядок перших входжень не змінюємо.
; Закони та рекурсія виконуються самим СЕНС; Зіг пакує слова, Д7 - видимість.

(визначити атом-зустрічається-далі-для-повторів?
 (функція (шукане елементи)
  (за-умовою
   ((порожній? елементи) ні)
   ((хибне? (атом? (перше елементи)))
    (атом-зустрічається-далі-для-повторів? шукане (решта елементи)))
   ((тотожне? шукане (перше елементи)) так)
   (так (атом-зустрічається-далі-для-повторів? шукане (решта елементи))))))

(визначити вилучити-наступні-входження-повтору
 (функція (шукане елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((хибне? (атом? (перше елементи)))
    (сполучити (перше елементи)
     (вилучити-наступні-входження-повтору шукане (решта елементи))))
   ((тотожне? шукане (перше елементи))
    (вилучити-наступні-входження-повтору шукане (решта елементи)))
   (так (сполучити (перше елементи)
                   (вилучити-наступні-входження-повтору шукане (решта елементи)))))))

(визначити залишити-повторені-атоми-один-раз
 (функція (елементи)
  (за-умовою
   ((порожній? елементи) (як-є ()))
   ((хибне? (атом? (перше елементи)))
    (залишити-повторені-атоми-один-раз (решта елементи)))
   ((атом-зустрічається-далі-для-повторів? (перше елементи) (решта елементи))
    (сполучити
     (перше елементи)
     (залишити-повторені-атоми-один-раз
      (вилучити-наступні-входження-повтору
       (перше елементи) (решта елементи)))))
   (так (залишити-повторені-атоми-один-раз (решта елементи))))))

(визначити списки-повторів-однакові?
 (функція (ліві праві)
  (за-умовою
   ((порожній? ліві) (порожній? праві))
   ((порожній? праві) ні)
   ((хибне? (атом? (перше ліві))) ні)
   ((хибне? (атом? (перше праві))) ні)
   ((тотожне? (перше ліві) (перше праві))
    (списки-повторів-однакові? (решта ліві) (решта праві)))
   (так ні))))

