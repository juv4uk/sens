; Родинні знання для перевірки рекурсивного логічного виведення.
; На відміну від однокрокових прикладів фізики й астрономії,
; відношення ancestor містить базовий та рекурсивний випадки.
; Ідентифікатори клауз залишено без змін для сумісності запитів.
; Викличні голови мови записано ратифікованою українською проєкцією.

(визначити-модуль family (як-є (
  ; Факти: родинне дерево з трьома поколіннями.
  ((parent tom bob))
  ((parent tom liz))
  ((parent bob ann))
  ((parent bob pat))
  ((parent pat jim))

  ; Правило дідуся чи бабусі: один проміжний родич.
  ((grandparent (var x) (var y)) (parent (var x) (var z)) (parent (var z) (var y)))

  ; Базовий випадок предка: безпосередній батько чи мати.
  ((ancestor (var x) (var y)) (parent (var x) (var y)))

  ; Рекурсивний випадок: предок батька чи матері також є предком.
  ; Так отримуємо повний ланцюжок нащадків без фіксованої глибини.
  ((ancestor (var x) (var y)) (parent (var x) (var z)) (ancestor (var z) (var y)))
)))
