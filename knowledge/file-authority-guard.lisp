(визначити файлова-гвардія-рядок-коректний?
  (функція (рядок)
    (нехай ((шлях (файлова-гвардія-поле (як-є path) рядок)))
      (нехай ((issue (файлова-гвардія-поле (як-є owner-issue) рядок)))
        (нехай ((план (файлова-гвардія-поле (як-є migration_plan) рядок)))
          (та
            (файлова-гвардія-має-поле? (як-є path) рядок)
            (файлова-гвардія-має-поле? (як-є independence_status) рядок)
            (файлова-гвардія-має-поле? (як-є owner-issue) рядок)
            (файлова-гвардія-має-поле? (як-є migration_plan) рядок)
            (файлова-гвардія-канонічний-шлях? шлях)
            (рядок-префікс? "tools/" шлях)
            (файлова-гвардія-має-суфікс? шлях ".py")
            (однакові? (файлова-гвардія-поле (як-є independence_status) рядок) (як-є foreign))
            (рядок? issue)
            (рядок-префікс? "#" issue)
            (більше? (рядок-довжина issue) файлова-гвардія-число-один)
            (рядок? план)
            (більше? (рядок-довжина план) файлова-гвардія-число-сорок)
            (рядок-містить? "SENS" план)
            (рядок-містить? "T5" план)))))))

