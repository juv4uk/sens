(визначити файлова-гвардія-поле
  (функція (ключ рядки)
    (за-умовою
      ((атом? рядки) (structural-kind empty-list) ())
      ((атом? рядки) (structural-kind pair)
        (за-умовою
          ((тотожне? ключ (перше (перше рядки))) (решта (перше рядки)))
          (так (файлова-гвардія-поле ключ (решта рядки)))))
      ((атом? рядки) (structural-kind atom) ()))))

(визначити файлова-гвардія-заперечення
