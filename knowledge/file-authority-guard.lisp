      ((рядок-порожній? текст) файлова-гвардія-число-нуль)
      ((менше? (рядок-довжина текст) (рядок-довжина суфікс)) файлова-гвардія-число-нуль)
      ((однакові? (рядок-довжина текст) (рядок-довжина суфікс))
        (однакові? текст суфікс))
      (так (файлова-гвардія-має-суфікс? (рядок-решта текст) суфікс)))))

(визначити файлова-гвардія-канонічний-шлях?
