          (так (файлова-гвардія-облік-охоплює-відстежувані? (решта відстежувані) рядки))))
      ((атом? відстежувані) (structural-kind atom) файлова-гвардія-число-нуль))))

(визначити файлова-гвардія-політика-коректна?
  (функція (політика)
