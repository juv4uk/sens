    (та
      (рядок? шлях)
      (файлова-гвардія-заперечення (рядок-порожній? шлях))
      (файлова-гвардія-заперечення (рядок-префікс? "/" шлях))
      (файлова-гвардія-заперечення (рядок-містить? "\\" шлях))
      (файлова-гвардія-заперечення (рядок-містить? "//" шлях))
      (файлова-гвардія-заперечення (рядок-містить? "/../" шлях))
      (файлова-гвардія-заперечення (рядок-префікс? "../" шлях))
      (файлова-гвардія-заперечення (рядок-містить? "/./" шлях))
      (файлова-гвардія-заперечення (рядок-префікс? "./" шлях))
      (файлова-гвардія-заперечення (файлова-гвардія-має-суфікс? шлях "/.."))
      (файлова-гвардія-заперечення (файлова-гвардія-має-суфікс? шлях "/."))
      (файлова-гвардія-заперечення (однакові? шлях "."))
      (файлова-гвардія-заперечення (однакові? шлях "..")))))

