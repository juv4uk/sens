(визначити файлова-гвардія-перевірити-зміну-типу
  (функція (шляхи режими)
    (за-умовою
      ((атом? шляхи) (structural-kind empty-list) файлова-гвардія-число-один)
      ((атом? шляхи) (structural-kind pair)
        (нехай ((шлях (перше шляхи)))
          (за-умовою
            ((та (файлова-гвардія-режим-обовязковий? шлях) (файлова-гвардія-заперечення (файлова-гвардія-режим-допущений? шлях режими)))
              (файлова-гвардія-заборонити (як-є git-mode) (список шлях (файлова-гвардія-знайти-режим шлях режими))))
            (так (файлова-гвардія-перевірити-зміну-типу (решта шляхи) режими)))))
      ((атом? шляхи) (structural-kind atom)
        (файлова-гвардія-заборонити (як-є input) "typechanged-paths is not a proper list")))))

