  "width": 7,
  "capacity": 128,
  "occupancy": 128,
  "semantic_scope": "Text/Data W7 migration projection ONLY; not callable Core",
  "rules": {
    "coordinates": "ASCII numeric 0..127",
    "english": "ASCII 7-bit identity",
    "ukrainian": "keyboard-position bijection; 31 pairs + ґ,є pairs; apostrophe pinned to ASCII 39; all 128 coords bijective",
    "sanskrit": "Devanagari INSCRIPT-inspired physical keyboard, one Unicode scalar per coordinate, no SLP1; remove duplicate and multi-key shortcut aliases to achieve bijection",
    "mode": "Enclosing SENS text value selects mode; not embedded in each W7 cell",
    "format": "MSB-first densely packed, exact externally known bit length; bad frames reject",
    "unknown": "fail-closed; no lossy substitutes",
    "legacy": "v1 D7 sound map is historical and must be explicitly version-migrated",
    "limitation": "Unicode normalization, ligature shaping and additional Vedic glyphs outside profile may not be reversible; full Unicode not promised",
    "iast": "Human-only romanized IAST annotation at each exact W7 keyboard coordinate. ◌ marks dependent vowel/sign; ◌∅ marks virama; · is editorial danda; ŏ/ḻ/ṟ/ṉ/ẏ are explicitly extended romanization. Not a stand-alone IAST text codec and NOT an alias for the reversible Devanagari san/v2 machine profile. Do not infer new W7 bits, SENS meaning, or Sanskrit phoneme identity."
  },
