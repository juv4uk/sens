    "url": "https://www.mwillsey.com/papers/egg",
    "role": "implementation context only, not 1980 source"
  },
  "oracles": [
    "independent explicit relation fixed point",
    "independent union-find signature saturation",
    "live Microsoft Z3 EUF solver pinned 4.13.3.0"
  ],
  "falsifiers": [
    "given a=b infer F(a)=F(b), not F(a)=G(b)",
    "same-symbol same-argument terms equal even when no equations",
    "no stated equations never entail equality of two distinct constants",
    "entailed=false is not explicit disequality",
    "unknown node, forward/cyclic reference, inconsistent function arity BLOCK",
    "no rewriting or symbolic variable substitution is smuggled into congruence"
  ],
  "uses": [
    "Lisp symbolic trees and Advice Taker facts",
    "Panini grammar term graphs",
    "astronomy observation symbolic equation graphs",
    "radio and FPGA symbolic circuit verification",
    "chess and Prolog proof graph deduplication"
