; #604 свідок лише міграції. Це не влада покриття.
; Він фіксує останню 32-рядкову часткову проєкцію Rust і доводить, що кожна
; застаріла часткова пара зберігається в похідній 122-парній проєкції, що належить Lisp.

(encoder-coverage-legacy-parity-1
  (legacy-pair-count 32)
  (successor-pair-count 122)
  (legacy X86-BASE "ADD")
  (legacy X86-BASE "AND")
  (legacy X86-BASE "CMP")
  (legacy X86-BASE "DEC")
  (legacy X86-BASE "INC")
  (legacy X86-BASE "JB")
  (legacy X86-BASE "JBE")
  (legacy X86-BASE "JL")
  (legacy X86-BASE "JLE")
  (legacy X86-BASE "JMP")
  (legacy X86-BASE "JNB")
  (legacy X86-BASE "JNBE")
  (legacy X86-BASE "JNL")
  (legacy X86-BASE "JNLE")
  (legacy X86-BASE "JNO")
  (legacy X86-BASE "JNP")
  (legacy X86-BASE "JNS")
  (legacy X86-BASE "JNZ")
  (legacy X86-BASE "JO")
  (legacy X86-BASE "JP")
  (legacy X86-BASE "JS")
  (legacy X86-BASE "JZ")
  (legacy X86-BASE "MOV")
  (legacy X86-BASE "NEG")
  (legacy X86-BASE "NOT")
  (legacy X86-BASE "OR")
  (legacy X86-BASE "POP")
