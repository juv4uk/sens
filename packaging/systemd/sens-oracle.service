[Unit]
Description=sens semantic oracle :9999 (formerly my-lisp)
After=network.target

[Service]
WorkingDirectory=/home/agents/GitHub/sens
ExecStart=/home/agents/GitHub/sens/target/release/sens --tcp=9999 --protocol=sexpr
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
Alias=mylisp-oracle.service
