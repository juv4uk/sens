# Скопіюйте як ~/.config/swarm-node/<node-id>.env.
# Identity (node-id/data-dir) є даними; executable надходить лише з Guix profile.
GUIX_PROFILE=/home/agents/.guix-profiles/viveka
SWARM_PORT=9130
SWARM_PROJECT=ecosystem
SWARM_DATA_DIR=/home/agents/.swarm-node/wsl-viveka-1
SWARM_BIND=127.0.0.1
SWARM_BOOTSTRAP=100.113.68.50:9101
SWARM_TASKS_FILE=/home/agents/ecosystem/plans/tasks.lisp
SWARM_EXTRA_ARGS=
