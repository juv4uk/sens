# Скопіюйте як ~/.config/swarm-node/<node-id>.env і задайте один профіль
# для однієї identity. Не створюйте другий unit для того самого node-id.
# Copy to ~/.config/swarm-node/<node-id>.env. Keep exactly one unit per
# identity; aliases that start the same node-id/data-dir are invalid.
SWARM_PORT=9130
SWARM_PROJECT=ecosystem
SWARM_DATA_DIR=/home/agents/.swarm-node/wsl-viveka-1
SWARM_BIND=127.0.0.1
SWARM_BOOTSTRAP=100.113.68.50:9101
SWARM_TASKS_FILE=/home/agents/ecosystem/plans/tasks.lisp
